
// Synthetic checks execute the SAME f_step() that updates real chart zones.
f_assert(bool condition, string message) =>
    if not condition
        runtime.error("ZOI QA FAIL: " + message)
    1
f_testZone(int kind, int side) =>
    Zone.new(110.0, 100.0, 10.0, kind, side, "QA", 1, 10, 10, 60.0)
var table qaStatus = table.new(position.bottom_left, 1, 1)
if barstate.islastconfirmedhistory
    int passed = 0
    Zone demand = f_testZone(0, 1)
    [t0, b0, s0, h0, l0, x0, f0] = f_step(demand, 105, 120, 90, 95, 10, 10, false, 0.05, "Full fill", 50)
    passed += f_assert(demand.state == 0 and demand.tests == 0 and not t0 and not x0, "creation bar cannot retest or invalidate")
    [t1, b1, s1, h1, l1, x1, f1] = f_step(demand, 106, 114, 105, 112, 11, 11, false, 0.05, "Full fill", 50)
    passed += f_assert(t1 and b1 and demand.tests == 1 and demand.state == 0, "first support rejection")
    [t2, b2, s2, h2, l2, x2, f2] = f_step(demand, 109, 111, 105, 108, 12, 12, false, 0.05, "Full fill", 50)
    passed += f_assert(not t2 and not b2 and demand.tests == 1, "continuous contact is one episode")
    [t3, b3, s3, h3, l3, x3, f3] = f_step(demand, 112, 115, 111, 114, 13, 13, false, 0.05, "Full fill", 50)
    passed += f_assert(not t3 and not b3 and not demand.contact, "no duplicate rejection on departure")
    [t4, b4, s4, h4, l4, x4, f4] = f_step(demand, 110, 114, 109, 112, 14, 14, false, 0.05, "Full fill", 50)
    passed += f_assert(t4 and b4 and demand.tests == 2, "re-entry is a second test")
    [t5, b5, s5, h5, l5, x5, f5] = f_step(demand, 105, 113, 95, 97, 15, 15, false, 0.05, "Full fill", 50)
    passed += f_assert(x5 and not b5 and demand.state == 1 and demand.ended == 15, "invalidation precedes rejection")
    [t6, b6, s6, h6, l6, x6, f6] = f_step(demand, 105, 115, 90, 112, 16, 16, false, 0.05, "Full fill", 50)
    passed += f_assert(not t6 and not b6 and not x6 and demand.ended == 15, "resolved state is terminal")
    Zone closeMode = f_testZone(0, 1)
    [tc, bc, sc, hc, lc, xc, fc] = f_step(closeMode, 105, 115, 95, 112, 11, 11, false, 0.05, "Full fill", 50)
    passed += f_assert(closeMode.state == 0 and bc and not xc, "close mode permits wick excursion")
    Zone wickMode = f_testZone(0, 1)
    [tw, bw, sw, hw, lw, xw, fw] = f_step(wickMode, 105, 115, 95, 112, 11, 11, true, 0.05, "Full fill", 50)
    passed += f_assert(wickMode.state == 1 and xw and not bw, "wick mode rejects ambiguous same-bar bounce")
    Zone delayed = f_testZone(0, 1)
    [td, bd, sd, hd, ld, xd, fd] = f_step(delayed, 109, 111, 105, 108, 11, 11, false, 0.05, "Full fill", 50)
    [te, be, se, he, le, xe, fe] = f_step(delayed, 111, 115, 111, 114, 12, 12, false, 0.05, "Full fill", 50)
    passed += f_assert(td and not bd and be and delayed.tests == 1, "rejection can confirm on departure")
    Zone bsl = f_testZone(1, 1)
    [ta, ba, sa, ha, la, xa, fa] = f_step(bsl, 105, 110.4, 101, 106, 11, 11, false, 0.05, "Full fill", 50)
    passed += f_assert(bsl.state == 0 and not ha, "buffer suppresses marginal high breach")
    [tb, bb, sb, hb, lb, xb, fb] = f_step(bsl, 105, 110.5, 95, 99, 12, 12, false, 0.05, "Full fill", 50)
    passed += f_assert(bsl.state == 3 and hb and not lb and bsl.tests == 0, "high pool swept, not support tested")
    Zone accepted = f_testZone(4, 1)
    [tp, bp, sp, hp, lp, xp, fp] = f_step(accepted, 109, 113, 108, 112, 11, 11, false, 0.05, "Full fill", 50)
    passed += f_assert(accepted.state == 4 and not hp, "acceptance above is taken, not rejection")
    Zone ssl = f_testZone(1, -1)
    [tl, bl, sl, hl, ll, xl, fl] = f_step(ssl, 105, 115, 99.5, 111, 11, 11, false, 0.05, "Full fill", 50)
    passed += f_assert(ssl.state == 3 and ll and not hl, "low pool sweep symmetry")
    Zone gap = f_testZone(3, 1)
    [tg, bg, sg, hg, lg, xg, fg] = f_step(gap, 112, 115, 105, 112, 11, 11, false, 0.05, "Full fill", 50)
    passed += f_assert(gap.state == 0 and not fg and gap.tests == 1, "partial FVG survives full-fill mode")
    Zone midGap = f_testZone(3, 1)
    [tm, bm, sm, hm, lm, xm, fm] = f_step(midGap, 112, 115, 105, 112, 11, 11, false, 0.05, "Midpoint", 50)
    passed += f_assert(midGap.state == 2 and fm, "exact FVG midpoint resolves")
    Zone fullGap = f_testZone(3, 1)
    [tf, bf, sf, hf, lf, xf, ff] = f_step(fullGap, 112, 115, 100, 101, 11, 11, false, 0.05, "Full fill", 50)
    passed += f_assert(fullGap.state == 2 and ff and not xf, "exact distal FVG fill")
    Zone firstGap = f_testZone(3, 1)
    [tt, bt, st, ht, lt, xt, ft] = f_step(firstGap, 112, 115, 110, 112, 11, 11, false, 0.05, "First touch", 50)
    passed += f_assert(firstGap.state == 2 and ft, "exact proximal FVG touch")
    Zone brokenGap = f_testZone(3, 1)
    [tk, bk, sk, hk, lk, xk, fk] = f_step(brokenGap, 105, 115, 90, 95, 11, 11, false, 0.05, "Full fill", 50)
    passed += f_assert(brokenGap.state == 1 and xk and not fk, "broken FVG not reported as successful fill")
    Zone bearGap = f_testZone(3, -1)
    [ti, bi, si, hi, li, xi, fi] = f_step(bearGap, 98, 105, 95, 98, 11, 11, false, 0.05, "Midpoint", 50)
    passed += f_assert(bearGap.state == 2 and fi, "bearish FVG midpoint symmetry")
    Zone supply = f_testZone(0, -1)
    [ts, bs, ss, hs, ls, xs, fs] = f_step(supply, 105, 111, 95, 98, 11, 11, false, 0.05, "Full fill", 50)
    passed += f_assert(ss and ts and supply.state == 0, "supply rejection symmetry")
    Zone expired = f_testZone(0, 1)
    [tz, bz, sz, hz, lz, xz, fz] = f_step(expired, 125, 130, 120, 125, 60, 60, false, 0.05, "Full fill", 50)
    passed += f_assert(expired.state == 5 and expired.ended == 60 and not tz, "expiry occurs at exact TTL")
    passed += f_assert(timeframe.from_seconds(300 * 12) == "60", "5-minute chart auto context is 60 minutes")
    passed += f_assert(timeframe.from_seconds(900 * 12) == "180", "15-minute chart auto context is 180 minutes")
    passed += f_assert(timeframe.in_seconds(timeframe.from_seconds(int(math.min(timeframe.in_seconds("12M") * 12, timeframe.in_seconds("12M"))))) == timeframe.in_seconds("12M"), "auto timeframe clamps safely at 12M")
    array<float> priorities = array.from(100.0, 99.0, 98.0, 97.0, 30.0, 20.0)
    array<bool> roles = array.from(true, true, true, true, false, false)
    array<bool> balanced = f_select(priorities, roles, 4, true)
    passed += f_assert(balanced.get(0) and balanced.get(1) and not balanced.get(2) and not balanced.get(3) and balanced.get(4) and balanced.get(5), "liquidity cannot crowd out all reaction zones")
    array<bool> oneFamily = f_select(array.from(10.0, 9.0, 8.0), array.from(true, true, true), 3, true)
    passed += f_assert(oneFamily.get(0) and oneFamily.get(1) and oneFamily.get(2), "unused family budget is filled")
    passed += f_assert(priorities.get(0) == 100.0 and priorities.get(4) == 30.0, "display selection does not mutate evidence priorities")
    table.cell(qaStatus, 0, 0, "ZOI QA PASS: " + str.tostring(passed) + " assertions", text_color = color.white, bgcolor = color.green)
    log.info("ZOI QA PASS: {0} assertions", passed)
