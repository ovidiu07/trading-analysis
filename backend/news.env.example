# Server only. Official integrations do not require API keys.
NEWS_ENABLED=true
NEWS_REFRESH_CRON="0 */5 * * * *"
NEWS_OFFICIAL_DAILY_BUDGET=80
NEWS_BLS_DAILY_BUDGET=20
# Disabled until written commercial display/cache permission and a server token exist.
NEWS_MARKETAUX_AUTHORIZED=false
NEWS_MARKETAUX_API_TOKEN=
NEWS_MARKETAUX_DAILY_BUDGET=80
# Explicit verified provider entity mappings. Default empty; never infer a provider ticker/exchange.
# Verify each identity using Marketaux's documented /v1/entity/search and account access first.
# Illustrative schema only (not verified production coverage):
# [{"identity":"NASDAQ:AAPL","symbol":"AAPL","exchange":"<verified exchange>","country":"us","sector":"Technology"}]
NEWS_MARKETAUX_COMPANY_MAPPINGS=[]
# Fixed central company bounds: 8 active identities, 24h inactivity expiry,
# 6h refresh, 32 HTTP attempts/day including retries. Three topic feeds use 2h refresh.
# NEWS_MARKETAUX_AUTHORIZED must also cover shared caching and immutable historical retention.
# Tradays: public widget only; no backend endpoint, token or alert-enablement setting exists.
