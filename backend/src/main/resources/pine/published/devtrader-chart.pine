// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Devtrader - Chart Analysis", shorttitle="Devtrader Chart Analysis", overlay=true, max_bars_back=5000, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// --- Groups ---
G_SESS  = "Session Context"
G_SMC   = "Sweep Engine"
G_MS    = "Market Structure"
G_LIQ   = "Liquidity"
G_DASH  = "Trader Dashboard"
G_LVLS  = "Important Market Levels"
G_LEVEL_RENDER = "Level Rendering"
G_FVG   = "Fair Value Gaps"

// --- Constants ---
COLOR_BULL = #98cac2
COLOR_BEAR = #d3a3a7
COLOR_NEUT = #5b9cf6
HTF_STATE_BEAR_REV = -2
HTF_STATE_BEAR_CONT = -1
HTF_STATE_RANGE = 0
HTF_STATE_BULL_CONT = 1
HTF_STATE_BULL_REV = 2
STRUCT_STATUS_NONE = 0
STRUCT_STATUS_LOCAL_PIVOT_BEAR = 1
STRUCT_STATUS_LOCAL_PIVOT_BULL = 2
STRUCT_STATUS_FAILED_REJECTION_BEAR = 3
STRUCT_STATUS_FAILED_REJECTION_BULL = 4

// --- Types ---
type liq_pool
    string side          // "BSL" or "SSL"
    string poolType      // "EXTERNAL", "INTERNAL", "SESSION", "DEV_SESSION", "PERIOD", "HTF"
    string baseType      // "SWING", "SESSION", "DEV_SESSION", "PERIOD", "HTF"
    float  price
    int    sourceBar
    bool   isSwept
    string poolLabel
    string baseLabel
    int    touchCount
    int    clusterSize
    int    lastTouchBar
    int    lastRefreshBar
    int    pendingSweepBar
    float  pendingSweepExtreme
    int    pendingSweepExtremeBar
    float  pendingWickRatio
    int    takenBar
    int    lastFailureBar
    int    creationTime
    string sourceTF
    float  structuralRank
    int    timesTagged
    float  cleanlinessScore
    string sessionContext
    bool   isInducementCandidate
    string state         // "FRESH", "TAGGED", "SWEPT", "CONSUMED"
    int    derivedClusterCount
    float  derivedClusterCompactness
    int    derivedClusterSpanBars
    float  derivedClusterObviousness
    float  derivedClusterEdgePriority
    bool   derivedClusterPartialTagged
    float  derivedFreshnessScore
    float  derivedClusterStrength
    float  derivedExternalityScore

type liq_render_row
    string side
    float  price
    int    sourceBar
    bool   isMajor
    string primaryText
    float  priority
    int    mergedCount
    string state

type fvg_record
    float  max
    float  min
    bool   isBull
    int    sourceTime
    int    anchorTime
    int    sourceBarIndex
    int    createdBarIndex
    int    createdTime
    string sourceTf

// --- Inputs ---
asiaSession  = input.session("0000-0900:1234567", "Asia Session", group=G_SESS)
londonSess   = input.session("0700-1000:1234567", "London Session", group=G_SESS)
nySess       = input.session("1200-1500:1234567", "New York Session", group=G_SESS)
showDevelopingSessionLevels = input.bool(false, "Show Developing Session H/L", group=G_SESS, tooltip="Plots current session highs/lows as live references. These are informational only and are not treated as confirmed liquidity.")

showSMC      = input.bool(true, "Sweep & MSS Detection", group=G_SMC)
majorSweeps  = input.bool(true, "External Liquidity Only", group=G_SMC, tooltip="Only detect sweeps on external liquidity (major, session, or HTF levels). Ignores minor internal structure.")
wickThresh   = input.float(0.70, "Min. Rejection Efficiency", minval=0.4, maxval=3.0, step=0.05, group=G_SMC, tooltip="Minimum wick-to-body rejection efficiency required for a valid sweep reclaim.")
reclaimLvl   = input.float(0.15, "Reclaim Threshold %", minval=0.0, step=0.05, group=G_SMC, tooltip="How far back inside the level the price must close (relative to range). Higher = Stronger Reclaim.")
sweepMaxDepth = input.float(0.8, "Max Sweep Depth (ATR)", minval=0.1, step=0.1, group=G_SMC, tooltip="Limit how far price can pierce the level before it's considered a failed breakout attempt rather than a sweep.")
sweepMinPenetrationAtr = input.float(0.03, "Min Sweep Penetration (ATR)", minval=0.0, step=0.01, group=G_SMC, tooltip="Minimum raid depth required before the script treats a touch as a real sweep candidate.")
sweepReclaimBars = input.int(1, "Max Sweep Reclaim Delay", minval=1, maxval=3, group=G_SMC, tooltip="Maximum bars allowed between the initial raid and the reclaim. Keeps multi-bar sweeps coherent instead of drift-based.")
ageExpiry    = input.int(800, "Level Expiry (Bars)", minval=100, group=G_SMC, tooltip="Levels older than this are considered 'fragile/stale' for sweeps.")
kzBoost      = input.bool(true, "Session Priority Boost", group=G_SMC, tooltip="Increases sweep score if it occurs in London or New York session windows.")
volConfirm   = input.bool(true, "Require Volume Confirmation", group=G_SMC)
requireSweepCloseBackInside = input.bool(true, "Require Close Back Inside", group=G_SMC, tooltip="Hard gate: a sweep is invalid unless price closes back through the raided level.")
requireSweepSessionQualifier = input.bool(false, "Require Session Qualification", group=G_SMC, tooltip="Hard gate: only accept sweeps that happen in a logical session / killzone context.")
newsRangeAtrMult = input.float(2.2, "News Spike Range ATR", minval=1.0, step=0.1, group=G_SMC, tooltip="Bars larger than this ATR multiple are treated as news/displacement spikes in sweep classification.")
newsVolMult = input.float(1.8, "News Spike Volume Mult", minval=1.0, step=0.1, group=G_SMC, tooltip="Bars with both large range and this relative volume are treated as news/displacement spikes.")
dispMult     = input.float(1.4, "Disp. Multiplier", step=0.1, group=G_SMC)
swingLen     = input.int(3, "Swing Strength", minval=1, group=G_SMC)
breakoutLabelSize = input.string("Tiny", "Breakout Label Size", options=["Tiny", "Small", "Normal"], group=G_SMC)
sweepMssTimeoutBars = input.int(14, "Sweep To MSS Timeout (Bars)", minval=1, group=G_SMC, tooltip="Expire the active sweep narrative if no follow-through structure confirms within this many bars.")

msMajorSwingLen = input.int(50, "Major Swing Confirmation", minval=2, group=G_MS, tooltip="Right-confirmed major swing length used for the imported market-structure map. This is a delayed confirmation layer, not a predictive pivot.")
msInternalSwingLen = input.int(3, "Internal Swing Confirmation", minval=1, group=G_MS, tooltip="Smaller confirmed swings used only to refresh protected levels and continuation context.")
msConfirmationMode = input.string("Balanced", "Confirmation Mode", options=["Aggressive", "Balanced", "Conservative"], group=G_MS, tooltip="Aggressive keeps devtrader primary. Balanced upgrades only aligned narratives to top quality. Conservative waits for stronger market-structure confirmation before treating the sweep as aligned.")
showMsSwings = input.bool(true, "Show Swing Bullets", group=G_MS, tooltip="Plots confirmed swing bullets on the pivot bars like market-structure-sweeps. These are right-confirmed and appear only after the confirmation delay.")
msSwingMarkerSize = input.int(3, "MS Swing Marker Size", minval=1, maxval=8, group=G_MS)
msSwingHighColor = input.color(color.new(color.red, 0), "Swing High Bullet Color", group=G_MS)
msSwingLowColor = input.color(color.new(color.green, 0), "Swing Low Bullet Color", group=G_MS)
showMsProtectedLevels = input.bool(true, "Show Active Protected Level", group=G_MS)
showMsChochBos = input.bool(true, "Show CHoCH / BOS Levels", group=G_MS, tooltip="Draws CHoCH and BOS levels in the market-structure-sweeps style, including live extension levels on the last bar.")
showMsIdm = input.bool(true, "Show IDM / Reclaim", group=G_MS, tooltip="Shows the active inducement level and IDM reclaim events adapted from market-structure-sweeps.")
msBosRequiresInternalPullback = input.bool(true, "BOS Requires New Internal Pullback", group=G_MS, tooltip="Prevents BOS from printing on every incremental continuation break. Requires a fresh internal swing after the last CHoCH/BOS event, closer to market-structure-sweeps behavior.")
msBosDisplacementMult = input.float(0.85, "BOS Break Body Mult", minval=0.5, step=0.05, group=G_MS, tooltip="Minimum body expansion versus average body for BOS candles. Higher values make BOS prints tighter and less frequent.")
msMinStructureSpacingBars = input.int(2, "Min Bars Between MS Events", minval=1, maxval=10, group=G_MS, tooltip="Hard spacing gate for CHoCH/BOS prints. Default 2 prevents new structure labels from printing one candle after the last event.")
msBosMinRefAgeBars = input.int(2, "Min BOS Ref Age (Bars)", minval=1, maxval=20, group=G_MS, tooltip="Prevents BOS from printing against an external reference formed only one candle ago.")
msIdmTakeMode = input.string("wick_then_close", "MS IDM Take Mode", options=["wick", "close", "wick_then_close"], group=G_MS, tooltip="How inducement is considered taken before BOS can print.")
msIdmReclaimBars = input.int(2, "MS IDM Reclaim Bars", minval=1, maxval=5, group=G_MS, tooltip="Maximum bars allowed for an IDM wick sweep to reclaim the level.")
msIdmMaxScanDepth = input.int(24, "MS IDM Scan Depth", minval=8, maxval=50, group=G_MS, tooltip="PERF: caps deep IDM rescans to recent internal pivots only. Higher values preserve more history but increase runtime.")
msCompactStructureLabels = input.bool(true, "Use Compact Structure Labels", group=G_MS)
historicalEventRetention = input.int(80, "Historical Event Retention", minval=20, maxval=200, group=G_MS, tooltip="PERF: maximum number of historical CHoCH/BOS/IDM/shift drawings kept on chart. Older markers are deleted to reduce object pressure.")

liqPivotLen      = input.int(14, "Base Pivot Lookback", minval=1, group=G_LIQ)
autoLiqPivot     = input.bool(true, "Auto-Optimize Lookback", group=G_LIQ, tooltip="Adjusts the pivot lookback based on current ATR volatility. High volatility increases lookback to filter noise; low volatility decreases it to catch tighter pivots.")
liqRangeLookback = input.int(50, "Structural Range Lookback", minval=20, group=G_LIQ, tooltip="Range used to classify swing liquidity as external or internal.")
liqExtBoundaryPct = input.float(0.15, "External Boundary %", minval=0.05, maxval=0.40, step=0.01, group=G_LIQ, tooltip="A swing is external only when it sits near the active dealing-range boundary.")
liqMaxLevelsPerSide = input.int(2, "Active Levels Per Side", minval=1, maxval=5, group=G_LIQ, tooltip="Maximum number of liquidity levels shown above and below price in trader mode.")
showSweptLiquidity = input.bool(false, "Show Recent Swept Context", group=G_LIQ, tooltip="Keep at most one recent swept level per side when it still matters for the active narrative.")
liqContextAtr = input.float(1.5, "Swept Context Distance (ATR)", minval=0.5, step=0.25, group=G_LIQ, tooltip="Hide swept context levels that are too far away from current price.")
showLiquidityLabels = input.bool(true, "Show Liquidity Labels", group=G_LIQ)

showDash     = input.bool(true, "Show Trader Dashboard", group=G_DASH)
dashPos      = input.string("Bottom Right", "Position", options=["Top Right", "Bottom Right", "Top Left"], group=G_DASH)

showPDH  = input.bool(true, "PDH (Prev Day High)", group=G_LVLS)
showPDL  = input.bool(true, "PDL (Prev Day Low)", group=G_LVLS)
showPDC  = input.bool(false, "PDC (Prev Day Close)", group=G_LVLS)
showDO   = input.bool(true, "DO (Daily Open)", group=G_LVLS)
showPWH  = input.bool(false, "PWH (Prev Week High)", group=G_LVLS)
showPWL  = input.bool(false, "PWL (Prev Week Low)", group=G_LVLS)
showPMH  = input.bool(false, "PMH (Prev Month High)", group=G_LVLS)
showPML  = input.bool(false, "PML (Prev Month Low)", group=G_LVLS)
showNYMid = input.bool(false, "NY Midnight Open", group=G_LVLS)
reduceLabelClutter = input.bool(true, "Reduce Label Clutter", group=G_LVLS, tooltip="Always keeps Tier 1 labels visible, but trims weaker labels first when the right side gets crowded.")
maxVisibleRightLabels = input.int(10, "Max Visible Right Labels", minval=4, maxval=24, group=G_LVLS)
labelDistanceAtrLimit = input.float(8.0, "Label Distance Limit (ATR)", minval=1.0, step=0.5, group=G_LVLS, tooltip="When clutter reduction is enabled, hide weaker labels once they drift too far from current price.")
showTier3Labels = input.bool(true, "Show Tier 3 Labels", group=G_LVLS)
shiftOverlappingLabels = input.bool(true, "Shift Overlapping Labels", group=G_LVLS, tooltip="Moves only the right-side label into a nearby lane while keeping the actual level line at the true price.")
adaptiveLevelExtensions = input.bool(true, "Adaptive Level Extensions", group=G_LVLS, tooltip="Shortens lower-priority or far-away lines so the chart stays readable.")

levelRenderMode = input.string("Right-side Only", "Level Rendering Mode", options=["Full", "Compact", "Right-side Only"], group=G_LEVEL_RENDER)
rightSideLevelOffset = input.int(8, "Right-side Level Offset", minval=1, maxval=50, group=G_LEVEL_RENDER)
rightSideLevelLength = input.int(10, "Right-side Level Length", minval=2, maxval=60, group=G_LEVEL_RENDER)
compactLevelMaxLength = input.int(80, "Compact Level Max Length", minval=10, maxval=300, group=G_LEVEL_RENDER)
levelCompactLabels = input.bool(true, "Compact Level Labels", group=G_LEVEL_RENDER)
fadePassiveLevels = input.bool(true, "Fade Passive Levels", group=G_LEVEL_RENDER)
showHistoricalStructureLines = input.bool(false, "Show Historical Structure Lines", group=G_LEVEL_RENDER)
showOnlyNearbyReferenceLevels = input.bool(false, "Show Only Nearby Reference Levels", group=G_LEVEL_RENDER)
nearbyLevelWindowAtr = input.float(6.0, "Nearby Level Window ATR", minval=1.0, maxval=30.0, group=G_LEVEL_RENDER)

enableLuxFvgEngine = input.bool(true, "Enable Dev-Style FVG Engine", group=G_FVG)
fvgThresholdPercent = input.float(0.0, "Threshold %", minval=0.0, maxval=100.0, step=0.1, inline="fvgThreshold", group=G_FVG)
fvgThresholdAuto = input.bool(true, "Auto", inline="fvgThreshold", group=G_FVG)
fvgShowLastUnmitigated = input.int(0, "Unmitigated Levels", minval=0, group=G_FVG)
fvgShowMitigationLevels = input.bool(true, "Mitigation Levels", group=G_FVG)
fvgTimeframe = input.timeframe("", "Detection Timeframe", group=G_FVG)
fvgExtendBars = input.int(20, "Extend", minval=0, inline="fvgRender", group=G_FVG)
fvgDynamicMode = input.bool(false, "Dynamic", inline="fvgRender", group=G_FVG)
fvgUseTimeBasedObjects = input.bool(true, "Use Time-Based Objects", group=G_FVG, tooltip="Uses source timestamps for lines and box anchors. Recommended when detection runs on a higher timeframe.")
fvgMaxStoredRecords = input.int(80, "Max Stored Active FVGs", minval=10, maxval=250, group=G_FVG, tooltip="Caps active FVG storage so this large script stays within TradingView object limits.")
fvgBullColor = input.color(color.new(COLOR_BULL, 70), "Bullish FVG", group=G_FVG)
fvgBearColor = input.color(color.new(COLOR_BEAR, 70), "Bearish FVG", group=G_FVG)
fvgShowDashboard = input.bool(false, "Show FVG Dashboard", group=G_FVG)
fvgDashboardLocation = input.string("Bottom Left", "Dashboard Location", options=["Top Right", "Bottom Right", "Bottom Left"], group=G_FVG)
fvgDashboardTextSize = input.string("Small", "Dashboard Text Size", options=["Tiny", "Small", "Normal"], group=G_FVG)

// --- PERF Hot-Path Map ---
// 1. State maintenance: HTF context, liquidity pool upkeep, and structure state.
// 2. Candidate refresh: bounded IDM refresh and nearby liquidity prefiltering.
// 3. Sweep engine: actionable-candidate scoring, pending/breakout qualification, wait-state transitions.
// 4. Structure confirmation: internal/external shift follow-through after a sweep.
// 5. Rendering: last-bar-only active levels, right labels, and retained historical markers.
// 6. Dashboard: last-bar-only narrative text and table output.

// --- HTF Settings ---
G_HTF        = "HTF Context & Levels"
showHTF      = input.bool(false, "Show HTF Levels", group=G_HTF)
htf1Tf       = input.timeframe("60", "HTF 1 Timeframe", group=G_HTF)
htf1SwingLen = input.int(5, "HTF 1 Swing Strength", group=G_HTF)
htf2Tf       = input.timeframe("240", "HTF 2 Timeframe", group=G_HTF)
htf2SwingLen = input.int(5, "HTF 2 Swing Strength", group=G_HTF)
showHTFLiquidity = input.bool(true, "Inject HTF Liquidity Levels", group=G_HTF, tooltip="Publishes confirmed HTF dealing-range highs/lows into the lower-timeframe liquidity map so sweeps can interact with them.")
htfMinConfidence = input.int(60, "HTF Confidence Threshold", minval=40, maxval=90, group=G_HTF, tooltip="Minimum combined HTF confidence required before the script treats the context as strongly directional.")
htfDispBodyMult = input.float(1.15, "HTF Disp. Body Mult", minval=1.0, step=0.05, group=G_HTF, tooltip="Relative body expansion required on the latest confirmed HTF candle to count as meaningful displacement.")
htfLiquidityProxAtr = input.float(0.75, "HTF Liquidity Proximity (ATR)", minval=0.25, step=0.25, group=G_HTF, tooltip="Distance to confirmed HTF liquidity, measured in HTF ATR, used when scoring reversal-candidate and continuation states.")

// --- Calculations ---
// Liquidity pools keep historical source bars and later reuse them as drawing anchors.
// Reserve a deeper buffer so line/label rendering from old pools does not exceed Pine's inferred history.
max_bars_back(time, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)
isNewDay = ta.change(time("D")) != 0
isNewWeek = ta.change(time("W")) != 0
isNewMonth = ta.change(time("M")) != 0
avgVol   = ta.sma(volume, 20)
highVol  = volume > avgVol

[pdh, pdl, pdc, dO] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], open[0]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)

isNewDayNY = hour(time, "America/New_York") == 0 and minute(time, "America/New_York") == 0
var float nyMidnight = na
if isNewDayNY
    nyMidnight := open

inAsia   = not na(time(timeframe.period, asiaSession, "UTC"))
inLondon = not na(time(timeframe.period, londonSess, "UTC"))
inNY     = not na(time(timeframe.period, nySess, "UTC"))
inLondonSweepWindow = not na(time(timeframe.period, "0700-1100:1234567", "Europe/London"))
inNYSweepWindow = not na(time(timeframe.period, "0830-1100:1234567", "America/New_York"))
atrVal = ta.atr(14)
max_bars_back(atrVal, 1000)

// --- HTF Structure Logic ---
f_getHtfSwings(len) =>
    [ta.pivothigh(high, len, len), ta.pivotlow(low, len, len)]

f_getHtfPivotHighTime(len) =>
    not na(ta.pivothigh(high, len, len)) ? time[len] : na

f_getHtfPivotLowTime(len) =>
    not na(ta.pivotlow(low, len, len)) ? time[len] : na

f_getHtfPivotPayload(len) =>
    [ta.pivothigh(high, len, len), ta.pivotlow(low, len, len), f_getHtfPivotHighTime(len), f_getHtfPivotLowTime(len), time[1]]

f_getHtfCandlePayload() =>
    [open[1], high[1], low[1], close[1], ta.atr(14)[1], ta.sma(math.abs(close - open), 20)[1]]

f_htfStateName(int state) =>
    state == HTF_STATE_BULL_CONT ? "HTF bullish continuation" :
     state == HTF_STATE_BEAR_CONT ? "HTF bearish continuation" :
     state == HTF_STATE_BULL_REV ? "HTF bullish reversal candidate" :
     state == HTF_STATE_BEAR_REV ? "HTF bearish reversal candidate" :
     "HTF ranging"

f_htfDirectionalBias(int state, float confidence) =>
    state == HTF_STATE_BULL_CONT ? confidence :
     state == HTF_STATE_BULL_REV ? confidence * 0.65 :
     state == HTF_STATE_BEAR_CONT ? -confidence :
     state == HTF_STATE_BEAR_REV ? -confidence * 0.65 :
     0.0

f_htfRecentDisp(int dirBias, float refOpen, float refHigh, float refLow, float refClose, float refAtr, float refAvgBody) =>
    float refRange = refHigh - refLow
    float safeRange = refRange > 0 ? refRange : syminfo.mintick
    float body = math.abs(refClose - refOpen)
    float bodyPct = body / safeRange
    float closePos = (refClose - refLow) / safeRange
    bool bullDisp = refClose > refOpen and refAtr > 0 and ((body > refAvgBody * htfDispBodyMult and bodyPct >= 0.55) or (refRange >= refAtr * 1.05 and closePos >= 0.75))
    bool bearDisp = refClose < refOpen and refAtr > 0 and ((body > refAvgBody * htfDispBodyMult and bodyPct >= 0.55) or (refRange >= refAtr * 1.05 and closePos <= 0.25))
    bullDisp ? 1 : bearDisp ? -1 : dirBias

f_evalHtfContext(float phRaw, float plRaw, int phTime, int plTime, float confirmedOpen, float confirmedHigh, float confirmedLow, float confirmedClose, float confirmedAtr, float bodyAvg, float lastPH, float lastPL, float prevPH, float prevPL, int lastPHTime, int lastPLTime, float protectedHigh, float protectedLow, int structureDir, int dispBias, float contBoost, float revFreshBoost, float revBaseBoost) =>
    float outLastPH = lastPH
    float outLastPL = lastPL
    float outPrevPH = prevPH
    float outPrevPL = prevPL
    int outLastPHTime = lastPHTime
    int outLastPLTime = lastPLTime
    float outProtectedHigh = protectedHigh
    float outProtectedLow = protectedLow
    int outStructureDir = structureDir
    int outState = HTF_STATE_RANGE
    float outConfidence = 0.0
    float outPdPos = 0.5
    string outPdLabel = "EQ"
    int outDispBias = dispBias
    string outAction = "Range"
    bool outNearHighLiq = false
    bool outNearLowLiq = false

    if not na(phRaw) and (na(outLastPHTime) or phTime != outLastPHTime)
        outPrevPH := outLastPH
        outLastPH := phRaw
        outLastPHTime := phTime
    if not na(plRaw) and (na(outLastPLTime) or plTime != outLastPLTime)
        outPrevPL := outLastPL
        outLastPL := plRaw
        outLastPLTime := plTime

    float rangeHigh = nz(outLastPH, confirmedHigh)
    float rangeLow = nz(outLastPL, confirmedLow)
    float atrRef = not na(confirmedAtr) and confirmedAtr > 0 ? confirmedAtr : atrVal > 0 ? atrVal : syminfo.mintick * 20
    float breakTol = math.max(atrRef * 0.08, syminfo.mintick * 8)
    int prevDir = outStructureDir
    bool bullSequence = not na(outPrevPH) and not na(outPrevPL) and not na(outLastPH) and not na(outLastPL) and outLastPH > outPrevPH and outLastPL > outPrevPL
    bool bearSequence = not na(outPrevPH) and not na(outPrevPL) and not na(outLastPH) and not na(outLastPL) and outLastPH < outPrevPH and outLastPL < outPrevPL
    float pdSpan = math.max(rangeHigh - rangeLow, syminfo.mintick * 20)
    outPdPos := math.max(0.0, math.min(1.0, (confirmedClose - rangeLow) / pdSpan))
    outPdLabel := outPdPos <= 0.35 ? "Discount" : outPdPos >= 0.65 ? "Premium" : "EQ"
    outDispBias := f_htfRecentDisp(dispBias, confirmedOpen, confirmedHigh, confirmedLow, confirmedClose, confirmedAtr, bodyAvg)
    outNearHighLiq := atrRef > 0 and not na(rangeHigh) and math.abs(confirmedClose - rangeHigh) / atrRef <= htfLiquidityProxAtr
    outNearLowLiq := atrRef > 0 and not na(rangeLow) and math.abs(confirmedClose - rangeLow) / atrRef <= htfLiquidityProxAtr
    float activeProtHigh = nz(outProtectedHigh, nz(outLastPH, rangeHigh))
    float activeProtLow = nz(outProtectedLow, nz(outLastPL, rangeLow))
    bool bullCloseConfirm = not na(outPrevPH) and confirmedClose > (outPrevPH + breakTol * 0.25)
    bool bearCloseConfirm = not na(outPrevPL) and confirmedClose < (outPrevPL - breakTol * 0.25)
    bool bullProtectedBreak = prevDir == -1 and not na(activeProtHigh) and confirmedClose > (activeProtHigh + breakTol * 0.25)
    bool bearProtectedBreak = prevDir == 1 and not na(activeProtLow) and confirmedClose < (activeProtLow - breakTol * 0.25)
    int nextDir = prevDir
    string nextAction = "Range"
    float nextProtHigh = activeProtHigh
    float nextProtLow = activeProtLow

    if prevDir == 1
        if bearProtectedBreak
            nextDir := -1
            nextAction := "Reversal"
            nextProtHigh := nz(outLastPH, rangeHigh)
            nextProtLow := nz(outLastPL, rangeLow)
        else if bullSequence and bullCloseConfirm
            nextDir := 1
            nextAction := "Continuation"
            nextProtLow := nz(outLastPL, activeProtLow)
            nextProtHigh := nz(outLastPH, rangeHigh)
        else
            nextDir := 1
            nextAction := "Holding"
            nextProtLow := activeProtLow
            nextProtHigh := nz(outLastPH, activeProtHigh)
    else if prevDir == -1
        if bullProtectedBreak
            nextDir := 1
            nextAction := "Reversal"
            nextProtLow := nz(outLastPL, rangeLow)
            nextProtHigh := nz(outLastPH, rangeHigh)
        else if bearSequence and bearCloseConfirm
            nextDir := -1
            nextAction := "Continuation"
            nextProtHigh := nz(outLastPH, activeProtHigh)
            nextProtLow := nz(outLastPL, rangeLow)
        else
            nextDir := -1
            nextAction := "Holding"
            nextProtHigh := activeProtHigh
            nextProtLow := nz(outLastPL, activeProtLow)
    else
        if bullSequence and bullCloseConfirm
            nextDir := 1
            nextAction := "Initiation"
            nextProtLow := nz(outLastPL, rangeLow)
            nextProtHigh := nz(outLastPH, rangeHigh)
        else if bearSequence and bearCloseConfirm
            nextDir := -1
            nextAction := "Initiation"
            nextProtHigh := nz(outLastPH, rangeHigh)
            nextProtLow := nz(outLastPL, rangeLow)
        else
            nextDir := HTF_STATE_RANGE
            nextAction := "Range"
            nextProtHigh := nz(outLastPH, rangeHigh)
            nextProtLow := nz(outLastPL, rangeLow)

    bool justBullReversal = nextDir == 1 and prevDir == -1 and nextAction == "Reversal"
    bool justBearReversal = nextDir == -1 and prevDir == 1 and nextAction == "Reversal"
    outAction := nextAction
    outProtectedHigh := nextProtHigh
    outProtectedLow := nextProtLow

    if nextDir == 1
        outState := justBullReversal ? HTF_STATE_BULL_REV : outDispBias == -1 and outPdPos >= 0.60 and outNearHighLiq ? HTF_STATE_BEAR_REV : HTF_STATE_BULL_CONT
    else if nextDir == -1
        outState := justBearReversal ? HTF_STATE_BEAR_REV : outDispBias == 1 and outPdPos <= 0.40 and outNearLowLiq ? HTF_STATE_BULL_REV : HTF_STATE_BEAR_CONT
    else
        outState := outDispBias == 1 and outPdPos <= 0.35 and outNearLowLiq ? HTF_STATE_BULL_REV : outDispBias == -1 and outPdPos >= 0.65 and outNearHighLiq ? HTF_STATE_BEAR_REV : HTF_STATE_RANGE

    float nextConfidence = 18.0
    if outState == HTF_STATE_BULL_CONT
        nextConfidence += contBoost
        nextConfidence += nextAction == "Continuation" ? 12.0 : nextAction == "Holding" ? 8.0 : nextAction == "Initiation" ? 6.0 : 4.0
        nextConfidence += outPdPos <= 0.35 ? 16.0 : outPdPos <= 0.55 ? 10.0 : 4.0
        nextConfidence += outDispBias == 1 ? 16.0 : outDispBias == 0 ? 5.0 : -8.0
        nextConfidence += outNearLowLiq ? 10.0 : outNearHighLiq ? 2.0 : 6.0
        nextConfidence += bullCloseConfirm ? 10.0 : 4.0
    else if outState == HTF_STATE_BEAR_CONT
        nextConfidence += contBoost
        nextConfidence += nextAction == "Continuation" ? 12.0 : nextAction == "Holding" ? 8.0 : nextAction == "Initiation" ? 6.0 : 4.0
        nextConfidence += outPdPos >= 0.65 ? 16.0 : outPdPos >= 0.45 ? 10.0 : 4.0
        nextConfidence += outDispBias == -1 ? 16.0 : outDispBias == 0 ? 5.0 : -8.0
        nextConfidence += outNearHighLiq ? 10.0 : outNearLowLiq ? 2.0 : 6.0
        nextConfidence += bearCloseConfirm ? 10.0 : 4.0
    else if outState == HTF_STATE_BULL_REV
        nextConfidence += justBullReversal ? revFreshBoost : revBaseBoost
        nextConfidence += outPdPos <= 0.35 ? 14.0 : outPdPos <= 0.50 ? 10.0 : 6.0
        nextConfidence += outDispBias == 1 ? 18.0 : 4.0
        nextConfidence += outNearLowLiq ? 14.0 : 2.0
        nextConfidence += (bullProtectedBreak or bullCloseConfirm) ? 12.0 : nextDir == -1 ? 8.0 : 4.0
        nextConfidence += nextDir == 1 ? 8.0 : 4.0
    else if outState == HTF_STATE_BEAR_REV
        nextConfidence += justBearReversal ? revFreshBoost : revBaseBoost
        nextConfidence += outPdPos >= 0.65 ? 14.0 : outPdPos >= 0.50 ? 10.0 : 6.0
        nextConfidence += outDispBias == -1 ? 18.0 : 4.0
        nextConfidence += outNearHighLiq ? 14.0 : 2.0
        nextConfidence += (bearProtectedBreak or bearCloseConfirm) ? 12.0 : nextDir == 1 ? 8.0 : 4.0
        nextConfidence += nextDir == -1 ? 8.0 : 4.0
    else
        nextConfidence += 10.0
        nextConfidence += math.abs(outPdPos - 0.5) <= 0.12 ? 10.0 : 4.0
        nextConfidence += outDispBias == 0 ? 8.0 : 3.0
        nextConfidence += (outNearHighLiq or outNearLowLiq) ? 6.0 : 2.0
        nextConfidence += prevDir == HTF_STATE_RANGE ? 6.0 : 2.0

    outStructureDir := nextDir
    outConfidence := math.max(0.0, math.min(100.0, nextConfidence))
    [outLastPH, outLastPL, outPrevPH, outPrevPL, outLastPHTime, outLastPLTime, outProtectedHigh, outProtectedLow, outStructureDir, outState, outConfidence, outPdPos, outPdLabel, outDispBias, outAction, outNearHighLiq, outNearLowLiq]

// PERF: consolidate HTF fetches with tuples instead of many single-value security calls.
[htf1PHRaw, htf1PLRaw, htf1PHTime, htf1PLTime, htf1ConfirmedBarTime] = request.security(syminfo.tickerid, htf1Tf, f_getHtfPivotPayload(htf1SwingLen), lookahead=barmerge.lookahead_off)
[htf2PHRaw, htf2PLRaw, htf2PHTime, htf2PLTime, htf2ConfirmedBarTime] = request.security(syminfo.tickerid, htf2Tf, f_getHtfPivotPayload(htf2SwingLen), lookahead=barmerge.lookahead_off)
[htf1ConfirmedOpen, htf1ConfirmedHigh, htf1ConfirmedLow, htf1ConfirmedClose, htf1ConfirmedAtr, htf1BodyAvg] = request.security(syminfo.tickerid, htf1Tf, f_getHtfCandlePayload(), lookahead=barmerge.lookahead_off)
[htf2ConfirmedOpen, htf2ConfirmedHigh, htf2ConfirmedLow, htf2ConfirmedClose, htf2ConfirmedAtr, htf2BodyAvg] = request.security(syminfo.tickerid, htf2Tf, f_getHtfCandlePayload(), lookahead=barmerge.lookahead_off)

var float lastHtf1PH = na
var float lastHtf1PL = na
var float lastHtf2PH = na
var float lastHtf2PL = na
var float prevHtf1PH = na
var float prevHtf1PL = na
var float prevHtf2PH = na
var float prevHtf2PL = na
var int lastHtf1PHTime = na
var int lastHtf1PLTime = na
var int lastHtf2PHTime = na
var int lastHtf2PLTime = na
var float htf1ProtectedHigh = na
var float htf1ProtectedLow = na
var float htf2ProtectedHigh = na
var float htf2ProtectedLow = na
var int htf1StructureDir = HTF_STATE_RANGE
var int htf2StructureDir = HTF_STATE_RANGE
var int htf1State = HTF_STATE_RANGE
var int htf2State = HTF_STATE_RANGE
var float htf1Confidence = 0.0
var float htf2Confidence = 0.0
var float htf1PdPos = 0.5
var float htf2PdPos = 0.5
var string htf1PdLabel = "EQ"
var string htf2PdLabel = "EQ"
var int htf1DispBias = 0
var int htf2DispBias = 0
var string htf1Action = "Range"
var string htf2Action = "Range"
var bool htf1NearHighLiq = false
var bool htf1NearLowLiq = false
var bool htf2NearHighLiq = false
var bool htf2NearLowLiq = false

bool newHtf1ConfirmedBar = ta.change(htf1ConfirmedBarTime) != 0
bool newHtf2ConfirmedBar = ta.change(htf2ConfirmedBarTime) != 0

if barstate.isfirst or newHtf1ConfirmedBar
    [_h1PH, _h1PL, _p1PH, _p1PL, _h1PHT, _h1PLT, _h1ProH, _h1ProL, _h1Dir, _h1St, _h1Conf, _h1Pd, _h1PdL, _h1Disp, _h1Act, _h1NrH, _h1NrL] = f_evalHtfContext(htf1PHRaw, htf1PLRaw, htf1PHTime, htf1PLTime, htf1ConfirmedOpen, htf1ConfirmedHigh, htf1ConfirmedLow, htf1ConfirmedClose, htf1ConfirmedAtr, htf1BodyAvg, lastHtf1PH, lastHtf1PL, prevHtf1PH, prevHtf1PL, lastHtf1PHTime, lastHtf1PLTime, htf1ProtectedHigh, htf1ProtectedLow, htf1StructureDir, htf1DispBias, 24.0, 22.0, 14.0)
    lastHtf1PH := _h1PH
    lastHtf1PL := _h1PL
    prevHtf1PH := _p1PH
    prevHtf1PL := _p1PL
    lastHtf1PHTime := _h1PHT
    lastHtf1PLTime := _h1PLT
    htf1ProtectedHigh := _h1ProH
    htf1ProtectedLow := _h1ProL
    htf1StructureDir := _h1Dir
    htf1State := _h1St
    htf1Confidence := _h1Conf
    htf1PdPos := _h1Pd
    htf1PdLabel := _h1PdL
    htf1DispBias := _h1Disp
    htf1Action := _h1Act
    htf1NearHighLiq := _h1NrH
    htf1NearLowLiq := _h1NrL

if barstate.isfirst or newHtf2ConfirmedBar
    [_h2PH, _h2PL, _p2PH, _p2PL, _h2PHT, _h2PLT, _h2ProH, _h2ProL, _h2Dir, _h2St, _h2Conf, _h2Pd, _h2PdL, _h2Disp, _h2Act, _h2NrH, _h2NrL] = f_evalHtfContext(htf2PHRaw, htf2PLRaw, htf2PHTime, htf2PLTime, htf2ConfirmedOpen, htf2ConfirmedHigh, htf2ConfirmedLow, htf2ConfirmedClose, htf2ConfirmedAtr, htf2BodyAvg, lastHtf2PH, lastHtf2PL, prevHtf2PH, prevHtf2PL, lastHtf2PHTime, lastHtf2PLTime, htf2ProtectedHigh, htf2ProtectedLow, htf2StructureDir, htf2DispBias, 26.0, 23.0, 15.0)
    lastHtf2PH := _h2PH
    lastHtf2PL := _h2PL
    prevHtf2PH := _p2PH
    prevHtf2PL := _p2PL
    lastHtf2PHTime := _h2PHT
    lastHtf2PLTime := _h2PLT
    htf2ProtectedHigh := _h2ProH
    htf2ProtectedLow := _h2ProL
    htf2StructureDir := _h2Dir
    htf2State := _h2St
    htf2Confidence := _h2Conf
    htf2PdPos := _h2Pd
    htf2PdLabel := _h2PdL
    htf2DispBias := _h2Disp
    htf2Action := _h2Act
    htf2NearHighLiq := _h2NrH
    htf2NearLowLiq := _h2NrL

float htf1DirectionalBias = f_htfDirectionalBias(htf1State, htf1Confidence)
float htf2DirectionalBias = f_htfDirectionalBias(htf2State, htf2Confidence)
float htfCompositeBias = htf1DirectionalBias * 0.75 + htf2DirectionalBias
bool htfLongStrong = htfCompositeBias >= htfMinConfidence
bool htfShortStrong = htfCompositeBias <= -htfMinConfidence

var float asiaH = na
var float asiaL = na
var int asiaStartBar = na
if inAsia and not inAsia[1]
    asiaH := high
    asiaL := low
    asiaStartBar := bar_index
else if inAsia
    asiaH := math.max(high, nz(asiaH, high))
    asiaL := math.min(low, nz(asiaL, low))

var float londonH = na
var float londonL = na
var int londonStartBar = na
if inLondon and not inLondon[1]
    londonH := high
    londonL := low
    londonStartBar := bar_index
else if inLondon
    londonH := math.max(high, nz(londonH, high))
    londonL := math.min(low, nz(londonL, low))

var float nySessH = na
var float nySessL = na
var int nySessStartBar = na
if inNY and not inNY[1]
    nySessH := high
    nySessL := low
    nySessStartBar := bar_index
else if inNY
    nySessH := math.max(high, nz(nySessH, high))
    nySessL := math.min(low, nz(nySessL, low))

var bool pdhConsumed = false
var bool pdlConsumed = false
var bool pwhConsumed = false
var bool pwlConsumed = false
var bool pmhConsumed = false
var bool pmlConsumed = false

if isNewDay
    pdhConsumed := false
    pdlConsumed := false
if isNewWeek
    pwhConsumed := false
    pwlConsumed := false
if isNewMonth
    pmhConsumed := false
    pmlConsumed := false

if not na(pdh) and high >= pdh
    pdhConsumed := true
if not na(pdl) and low <= pdl
    pdlConsumed := true
if not na(pwh) and high >= pwh
    pwhConsumed := true
if not na(pwl) and low <= pwl
    pwlConsumed := true
if not na(pmh) and high >= pmh
    pmhConsumed := true
if not na(pml) and low <= pml
    pmlConsumed := true

f_breakoutLabelSize() =>
    breakoutLabelSize == "Tiny" ? size.tiny : breakoutLabelSize == "Small" ? size.small : size.normal

f_canvasBrightness(color canvasColor) =>
    color.r(canvasColor) * 0.299 + color.g(canvasColor) * 0.587 + color.b(canvasColor) * 0.114

f_isDarkCanvas() =>
    f_canvasBrightness(chart.bg_color) < 140

f_defaultLevelColor() =>
    f_isDarkCanvas() ? color.white : color.black

f_themeLevelColor() =>
    f_defaultLevelColor()

f_themeLevelTextColor() =>
    f_themeLevelColor()

f_themeTextColor() =>
    f_themeLevelTextColor()

f_themePanelColor() =>
    f_isDarkCanvas() ? color.new(#111827, 8) : color.new(#f3f4f6, 8)

f_levelLineColor(int tier) =>
    tier == 1 ? f_defaultLevelColor() : tier == 2 ? color.new(f_defaultLevelColor(), 18) : color.new(f_defaultLevelColor(), 38)

f_levelLineCoords(int sourceBar, float price, string renderMode, int rightOffset, int rightLength, int compactMaxLength) =>
    int safeSourceBar = na(sourceBar) ? bar_index : sourceBar
    int x1 = safeSourceBar
    int x2 = bar_index
    if renderMode == "Compact"
        x1 := math.max(safeSourceBar, bar_index - compactMaxLength)
        x2 := bar_index + rightOffset
    else if renderMode == "Right-side Only"
        x1 := bar_index + rightOffset
        x2 := bar_index + rightOffset + rightLength
    [x1, x2]

f_levelDisplayColor(color baseColor, bool passive, bool fadePassive) =>
    passive and fadePassive ? color.new(baseColor, 78) : baseColor

f_compactLevelText(string levelName, float price) =>
    levelName + " " + str.tostring(price, format.mintick)

f_nearbyReferenceAllowed(float price) =>
    not showOnlyNearbyReferenceLevels or na(price) or (atrVal > 0 and math.abs(price - close) <= atrVal * nearbyLevelWindowAtr)

f_isPassiveReferenceLabel(string txt) =>
    string labelTxt = txt
    labelTxt == "PDH" or labelTxt == "PDL" or labelTxt == "PDC" or labelTxt == "DO" or labelTxt == "PWH" or labelTxt == "PWL" or labelTxt == "PMH" or labelTxt == "PML" or labelTxt == "NY Mid" or str.startswith(labelTxt, "NY ") or str.startswith(labelTxt, "Prev NY") or str.startswith(labelTxt, "London ") or str.startswith(labelTxt, "Prev London") or str.startswith(labelTxt, "Asia ") or str.startswith(labelTxt, "Prev Asia") or str.startswith(labelTxt, "Dev ") or str.startswith(labelTxt, "HTF")

f_liquidityLineColor(string side, int tier, bool isMajor, string state) =>
    color base = side == "BSL" ? COLOR_BEAR : COLOR_BULL
    int alpha = state == "SWEPT" ? 26 : tier == 1 ? 10 : tier == 2 ? 24 : 40
    if not isMajor
        alpha += 10
    if alpha > 82
        alpha := 82
    color.new(base, alpha)

f_structureLineColor(string structureType, int bias) =>
    structureType == "BOS" ? (bias == 1 ? color.new(COLOR_BULL, 0) : color.new(COLOR_BEAR, 0)) :
     structureType == "CHOCH" ? color.new(COLOR_NEUT, 0) :
     structureType == "IDM" ? (bias == 1 ? color.new(COLOR_BULL, 18) : color.new(COLOR_BEAR, 18)) :
     color.new(f_defaultLevelColor(), 12)

f_structureLabelBg(string structureType, int bias) =>
    structureType == "BOS" ? color.new(bias == 1 ? COLOR_BULL : COLOR_BEAR, 84) :
     structureType == "CHOCH" ? color.new(COLOR_NEUT, 84) :
     structureType == "IDM" ? color.new(bias == 1 ? COLOR_BULL : COLOR_BEAR, 88) :
     color.new(chart.bg_color, 12)

var array<float> levelLabelSlots = array.new_float(0)
var array<float> rightLabelPrices = array.new_float(0)
var array<int> rightLabelXs = array.new_int(0)
var array<int> rightLabelTiers = array.new_int(0)
var array<string> rightLabelTexts = array.new_string(0)
var array<label> rightLabelPool = array.new_label(0)

f_compactLevelName(string txt) =>
    string out = txt
    if txt == "NY Midnight" or txt == "NY Midnight Open"
        out := "NY Mid"
    else if txt == "Daily Open"
        out := "DO"
    out

f_levelTier(string txt) =>
    string labelTxt = f_compactLevelName(txt)
    int tier = 3
    if labelTxt == "PDH" or labelTxt == "PDL"
        tier := 1
    else if str.startswith(labelTxt, "HTF1") or str.startswith(labelTxt, "HTF2")
        tier := str.contains(labelTxt, "Obj") or str.contains(labelTxt, "Prot") ? 1 : 2
    else if str.startswith(labelTxt, "Ext ")
        tier := 1
    else if labelTxt == "DO" or labelTxt == "NY Mid" or labelTxt == "PWH" or labelTxt == "PWL"
        tier := 2
    else if labelTxt == "PMH" or labelTxt == "PML" or labelTxt == "PDC"
        tier := 3
    else if str.startswith(labelTxt, "London ") or str.startswith(labelTxt, "NY ") or str.startswith(labelTxt, "Asia ") or str.startswith(labelTxt, "Prev London") or str.startswith(labelTxt, "Prev NY") or str.startswith(labelTxt, "Prev Asia")
        tier := 2
    else if str.startswith(labelTxt, "Dev ")
        tier := 3
    else if str.startswith(labelTxt, "Int ")
        tier := 3
    tier

f_levelLeftSpanBars(float val, int tier, bool subdued) =>
    int baseBars = tier == 1 ? 140 : tier == 2 ? 96 : 58
    float distAtr = atrVal > 0 ? math.abs(val - close) / atrVal : 0.0
    if reduceLabelClutter and distAtr > labelDistanceAtrLimit
        baseBars := int(math.round(baseBars * 0.65))
    if subdued
        baseBars := int(math.round(baseBars * 0.80))
    math.max(baseBars, 18)

f_rightLabelMergeTolerance(float price) =>
    float atrBased = nz(atrVal, price * 0.001) * 0.015
    math.max(syminfo.mintick * 6, math.min(atrBased, price * 0.00020))

f_rightLabelFindIdx(float price) =>
    int idx = -1
    float tol = f_rightLabelMergeTolerance(price)
    if array.size(rightLabelPrices) > 0
        for i = 0 to array.size(rightLabelPrices) - 1
            if math.abs(array.get(rightLabelPrices, i) - price) <= tol
                idx := i
                break
    idx

f_rightLabelTierCount(int tierFilter) =>
    int count = 0
    if array.size(rightLabelTiers) > 0
        for i = 0 to array.size(rightLabelTiers) - 1
            if array.get(rightLabelTiers, i) == tierFilter
                count += 1
    count

f_levelShouldShowLabel(float val, int tier) =>
    bool tierAllowed = tier < 3 or showTier3Labels
    bool showLabel = false
    if not tierAllowed
        showLabel := false
    else if f_rightLabelFindIdx(val) >= 0
        showLabel := true
    else if not reduceLabelClutter
        showLabel := true
    else
        int visibleCount = array.size(rightLabelPrices)
        int tier2Count = f_rightLabelTierCount(2)
        int tier3Count = f_rightLabelTierCount(3)
        int tier2Budget = math.max(2, maxVisibleRightLabels / 2)
        int tier3Budget = math.max(1, maxVisibleRightLabels / 4)
        bool tooFar = atrVal > 0 ? math.abs(val - close) / atrVal > labelDistanceAtrLimit : false
        showLabel := tier == 1 ? true : visibleCount >= maxVisibleRightLabels ? false : tier == 2 ? (not tooFar or tier2Count < tier2Budget) : (not tooFar and tier3Count < tier3Budget)
    showLabel

f_resolveLevelLabelY(float basePrice) =>
    float step = math.max(syminfo.mintick * 16, nz(atrVal, syminfo.mintick * 20) * 0.09)
    float resolvedY = basePrice
    int shiftDir = 0
    if shiftOverlappingLabels
        bool allocated = false
        for attempt = 0 to 12
            int lane = attempt == 0 ? 0 : int(math.ceil(float(attempt) / 2.0))
            int dir = attempt == 0 ? 0 : attempt % 2 == 1 ? 1 : -1
            float candidateY = basePrice + step * float(lane * dir)
            bool slotAvailable = true
            if array.size(levelLabelSlots) > 0
                for i = 0 to array.size(levelLabelSlots) - 1
                    if math.abs(array.get(levelLabelSlots, i) - candidateY) < step * 0.90
                        slotAvailable := false
                        break
            if slotAvailable
                resolvedY := candidateY
                shiftDir := dir
                array.push(levelLabelSlots, candidateY)
                allocated := true
                break
        if not allocated
            resolvedY := basePrice + step * 6.0
            shiftDir := 1
            array.push(levelLabelSlots, resolvedY)
    else
        array.push(levelLabelSlots, basePrice)
    [resolvedY, shiftDir]

f_registerRightLabel(float price, int x, string txt, int tier) =>
    int idx = f_rightLabelFindIdx(price)
    if idx >= 0
        string existingText = array.get(rightLabelTexts, idx)
        string priceText = str.tostring(price, format.mintick)
        string priceSuffix = " " + priceText
        int existingTrimLen = str.length(existingText) - str.length(priceSuffix)
        int candidateTrimLen = str.length(txt) - str.length(priceSuffix)
        bool existingHasPriceSuffix = false
        bool candidateHasPriceSuffix = false
        if existingTrimLen >= 0
            existingHasPriceSuffix := str.substring(existingText, existingTrimLen, str.length(existingText)) == priceSuffix
        if candidateTrimLen >= 0
            candidateHasPriceSuffix := str.substring(txt, candidateTrimLen, str.length(txt)) == priceSuffix
        bool canMergePrice = levelCompactLabels and existingHasPriceSuffix and candidateHasPriceSuffix
        if canMergePrice
            string existingName = str.substring(existingText, 0, existingTrimLen)
            string candidateName = str.substring(txt, 0, candidateTrimLen)
            string wrappedNames = " / " + existingName + " / "
            string candidateWrapped = " / " + candidateName + " / "
            if not str.contains(wrappedNames, candidateWrapped)
                array.set(rightLabelTexts, idx, existingName + " / " + candidateName + priceSuffix)
        else
            string wrappedText = " | " + existingText + " | "
            string candidateText = " | " + txt + " | "
            if not str.contains(wrappedText, candidateText)
                array.set(rightLabelTexts, idx, existingText + " | " + txt)
        array.set(rightLabelXs, idx, math.max(array.get(rightLabelXs, idx), x))
        array.set(rightLabelTiers, idx, math.min(array.get(rightLabelTiers, idx), tier))
    else
        array.push(rightLabelPrices, price)
        array.push(rightLabelXs, x)
        array.push(rightLabelTiers, tier)
        array.push(rightLabelTexts, txt)
    true

f_renderRightLabels() =>
    array.clear(levelLabelSlots)
    int labelCount = array.size(rightLabelPrices)
    while array.size(rightLabelPool) < labelCount
        array.push(rightLabelPool, label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.tiny))
    if labelCount > 0
        for i = 0 to labelCount - 1
            float labelPrice = array.get(rightLabelPrices, i)
            int labelX = array.get(rightLabelXs, i)
            int labelTier = array.get(rightLabelTiers, i)
            string labelText = array.get(rightLabelTexts, i)
            [labelY, shiftDir] = f_resolveLevelLabelY(labelPrice)
            label lb = array.get(rightLabelPool, i)
            label.set_xy(lb, labelX, labelY)
            label.set_text(lb, labelText)
            label.set_textcolor(lb, f_themeLevelTextColor())
            label.set_color(lb, color.new(chart.bg_color, labelTier == 1 ? 18 : labelTier == 2 ? 28 : 40))
            label.set_style(lb, shiftDir > 0 ? label.style_label_lower_left : shiftDir < 0 ? label.style_label_upper_left : label.style_label_left)
            label.set_size(lb, size.tiny)
    if array.size(rightLabelPool) > labelCount
        for i = labelCount to array.size(rightLabelPool) - 1
            label lb = array.get(rightLabelPool, i)
            label.set_y(lb, na)
            label.set_text(lb, "")
    true

plot(showHTF and levelRenderMode == "Full" ? lastHtf1PH : na, "HTF 1 Range High", f_levelLineColor(2), 1, plot.style_linebr)
plot(showHTF and levelRenderMode == "Full" ? lastHtf1PL : na, "HTF 1 Range Low", f_levelLineColor(2), 1, plot.style_linebr)
plot(showHTF and levelRenderMode == "Full" ? lastHtf2PH : na, "HTF 2 Range High", f_levelLineColor(1), 2, plot.style_linebr)
plot(showHTF and levelRenderMode == "Full" ? lastHtf2PL : na, "HTF 2 Range Low", f_levelLineColor(1), 2, plot.style_linebr)

f_updateLevel(bool show, float val, string txt, line l) =>
    string compactText = f_compactLevelName(txt)
    int tier = f_levelTier(compactText)
    bool isPassiveReference = f_isPassiveReferenceLabel(compactText)
    bool nearbyOk = not isPassiveReference or f_nearbyReferenceAllowed(val)
    if show and not na(val) and nearbyOk
        int leftSpan = adaptiveLevelExtensions ? f_levelLeftSpanBars(val, tier, false) : 50
        int legacyRightOffset = adaptiveLevelExtensions ? (tier == 1 ? 9 : tier == 2 ? 7 : 5) : 10
        int sourceBar = compactText == "DO" ? math.max(bar_index - 1, 0) : math.max(bar_index - leftSpan, 0)
        [levelLeft, levelRight] = f_levelLineCoords(sourceBar, val, levelRenderMode, rightSideLevelOffset, rightSideLevelLength, compactLevelMaxLength)
        int labelX = levelRenderMode == "Full" ? bar_index + legacyRightOffset : levelRight
        line.set_xy1(l, levelLeft, val)
        line.set_xy2(l, levelRight, val)
        line.set_color(l, f_levelDisplayColor(f_levelLineColor(tier), true, fadePassiveLevels))
        line.set_width(l, levelRenderMode == "Full" and tier <= 2 ? 2 : 1)
        line.set_style(l, tier == 3 ? line.style_dotted : line.style_solid)
        if f_levelShouldShowLabel(val, tier)
            string labelText = levelCompactLabels ? f_compactLevelText(compactText, val) : compactText + " " + str.tostring(val, format.mintick)
            f_registerRightLabel(val, labelX, labelText, tier)
    else
        line.set_y1(l, na)
        line.set_y2(l, na)
    true

var line lnPDH = line.new(na, na, na, na)
var line lnPDL = line.new(na, na, na, na)
var line lnPDC = line.new(na, na, na, na)
var line lnDO = line.new(na, na, na, na)
var line lnPWH = line.new(na, na, na, na)
var line lnPWL = line.new(na, na, na, na)
var line lnPMH = line.new(na, na, na, na)
var line lnPML = line.new(na, na, na, na)
var line lnNYMid = line.new(na, na, na, na)
var line lnHTF1High = line.new(na, na, na, na)
var line lnHTF1Low = line.new(na, na, na, na)
var line lnHTF2High = line.new(na, na, na, na)
var line lnHTF2Low = line.new(na, na, na, na)

if barstate.islast
    array.clear(rightLabelPrices)
    array.clear(rightLabelXs)
    array.clear(rightLabelTiers)
    array.clear(rightLabelTexts)
    f_updateLevel(showPDH and not pdhConsumed, pdh, "PDH", lnPDH)
    f_updateLevel(showPDL and not pdlConsumed, pdl, "PDL", lnPDL)
    f_updateLevel(showPWH and not pwhConsumed, pwh, "PWH", lnPWH)
    f_updateLevel(showPWL and not pwlConsumed, pwl, "PWL", lnPWL)
    f_updateLevel(showDO, dO, "DO", lnDO)
    f_updateLevel(showNYMid, nyMidnight, "NY Midnight", lnNYMid)
    f_updateLevel(showPDC, pdc, "PDC", lnPDC)
    f_updateLevel(showPMH and not pmhConsumed, pmh, "PMH", lnPMH)
    f_updateLevel(showPML and not pmlConsumed, pml, "PML", lnPML)
    f_updateLevel(showHTF and levelRenderMode != "Full", lastHtf1PH, "HTF1 Range High", lnHTF1High)
    f_updateLevel(showHTF and levelRenderMode != "Full", lastHtf1PL, "HTF1 Range Low", lnHTF1Low)
    f_updateLevel(showHTF and levelRenderMode != "Full", lastHtf2PH, "HTF2 Range High", lnHTF2High)
    f_updateLevel(showHTF and levelRenderMode != "Full", lastHtf2PL, "HTF2 Range Low", lnHTF2Low)

// --- Fair Value Gap Engine ---
// Reference attribution preserved per the original CC BY-NC-SA 4.0 licensing.
f_fvgSolidColor(color clr) =>
    color.rgb(color.r(clr), color.g(clr), color.b(clr))

f_fvgDashPosition(string loc) =>
    loc == "Bottom Left" ? position.bottom_left : loc == "Top Right" ? position.top_right : position.bottom_right

f_fvgDashTextSize(string sizeText) =>
    sizeText == "Tiny" ? size.tiny : sizeText == "Small" ? size.small : size.normal

f_fvgThreshold() =>
    fvgThresholdAuto ? (bar_index > 0 ? ta.cum((high - low) / low) / bar_index : 0.0) : fvgThresholdPercent / 100.0

f_fvgDetectPayload() =>
    float threshold = f_fvgThreshold()
    bool bullFvg = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > threshold
    bool bearFvg = high < low[2] and close[1] < low[2] and (low[2] - high) / high > threshold
    float recordMax = bullFvg ? low : bearFvg ? low[2] : na
    float recordMin = bullFvg ? high[2] : bearFvg ? high : na
    [bullFvg, bearFvg, recordMax, recordMin, time, time[2], bar_index]

float fvgChartTfMs = math.max(float(timeframe.in_seconds(timeframe.period)), 60.0) * 1000.0
string fvgDetectionTf = fvgTimeframe == "" ? timeframe.period : fvgTimeframe

var float fvgDynamicBullUpper = na
var float fvgDynamicBullLower = na
var float fvgDynamicBearUpper = na
var float fvgDynamicBearLower = na
var int fvgBullCount = 0
var int fvgBearCount = 0
var int fvgBullMitigatedCount = 0
var int fvgBearMitigatedCount = 0
var int fvgLastDetectedSourceTime = na

var array<fvg_record> fvgActiveRecords = array.new<fvg_record>(0)
var array<fvg_record> fvgMitigatedThisBarRecords = array.new<fvg_record>(0)
var array<box> fvgStaticBoxes = array.new_box(0)
var array<line> fvgUnmitigatedLines = array.new_line(0)
var array<line> fvgMitigationLines = array.new_line(0)

f_fvgCreateBox(fvg_record rec) =>
    color zoneColor = rec.isBull ? fvgBullColor : fvgBearColor
    if fvgUseTimeBasedObjects
        int rightTime = rec.createdTime + int(math.round(fvgChartTfMs * fvgExtendBars))
        box.new(rec.anchorTime, rec.max, rightTime, rec.min, xloc=xloc.bar_time, border_color=na, bgcolor=zoneColor)
    else
        box.new(math.max(rec.createdBarIndex - 2, 0), rec.max, rec.createdBarIndex + fvgExtendBars, rec.min, xloc=xloc.bar_index, border_color=na, bgcolor=zoneColor)

f_fvgCreateLevelLine(fvg_record rec, float level, color levelColor, bool dashed) =>
    if fvgUseTimeBasedObjects
        line.new(rec.sourceTime, level, time, level, xloc=xloc.bar_time, color=levelColor, style=dashed ? line.style_dashed : line.style_solid)
    else
        line.new(rec.createdBarIndex, level, bar_index, level, xloc=xloc.bar_index, color=levelColor, style=dashed ? line.style_dashed : line.style_solid)

f_fvgTrimActiveRecords() =>
    while array.size(fvgActiveRecords) > fvgMaxStoredRecords
        array.pop(fvgActiveRecords)
        if not fvgDynamicMode and array.size(fvgStaticBoxes) > array.size(fvgActiveRecords)
            box staleBox = array.pop(fvgStaticBoxes)
            box.delete(staleBox)
    true

f_fvgIsPriceInside(bool wantBull, float priceToTest) =>
    bool inside = false
    int recordCount = array.size(fvgActiveRecords)
    if recordCount > 0
        for i = 0 to recordCount - 1
            fvg_record rec = array.get(fvgActiveRecords, i)
            if rec.isBull == wantBull and priceToTest <= rec.max and priceToTest >= rec.min
                inside := true
                break
    inside

f_fvgNearestDirectional(bool wantBull, bool wantAbove, float anchorPrice) =>
    bool found = false
    float nearestLower = na
    float nearestUpper = na
    int nearestTime = na
    float bestDist = na
    int recordCount = array.size(fvgActiveRecords)
    if recordCount > 0
        for i = 0 to recordCount - 1
            fvg_record rec = array.get(fvgActiveRecords, i)
            float lower = rec.min
            float upper = rec.max
            bool directional = wantAbove ? lower >= anchorPrice : upper <= anchorPrice
            float dist = wantAbove ? lower - anchorPrice : anchorPrice - upper
            if rec.isBull == wantBull and directional and (not found or dist < bestDist)
                found := true
                bestDist := dist
                nearestLower := lower
                nearestUpper := upper
                nearestTime := rec.sourceTime
    [found, nearestLower, nearestUpper, nearestTime]

f_fvgMitigatedText(int mitigatedCount, int totalCount) =>
    str.tostring(totalCount > 0 ? float(mitigatedCount) / float(totalCount) : 0.0, format.percent)

[fvgBullRaw, fvgBearRaw, fvgMaxRaw, fvgMinRaw, fvgSourceTimeRaw, fvgAnchorTimeRaw, fvgSourceBarIndexRaw] = request.security(syminfo.tickerid, fvgDetectionTf, f_fvgDetectPayload(), lookahead=barmerge.lookahead_off)

bool fvgBullNewThisBar = false
bool fvgBearNewThisBar = false
bool fvgBullMitigatedThisBar = false
bool fvgBearMitigatedThisBar = false

if barstate.isnew
    array.clear(fvgMitigatedThisBarRecords)

if enableLuxFvgEngine
    bool fvgNewSignal = (fvgBullRaw or fvgBearRaw) and not na(fvgSourceTimeRaw) and (na(fvgLastDetectedSourceTime) or fvgSourceTimeRaw != fvgLastDetectedSourceTime)

    if fvgBullRaw and fvgNewSignal
        fvg_record newBullRecord = fvg_record.new(fvgMaxRaw, fvgMinRaw, true, fvgSourceTimeRaw, fvgAnchorTimeRaw, fvgSourceBarIndexRaw, bar_index, time, fvgDetectionTf)
        if fvgDynamicMode
            fvgDynamicBullUpper := newBullRecord.max
            fvgDynamicBullLower := newBullRecord.min
        else
            array.unshift(fvgStaticBoxes, f_fvgCreateBox(newBullRecord))
        array.unshift(fvgActiveRecords, newBullRecord)
        fvgBullCount += 1
        fvgBullNewThisBar := true
        fvgLastDetectedSourceTime := fvgSourceTimeRaw
        f_fvgTrimActiveRecords()
    else if fvgDynamicMode
        fvgDynamicBullUpper := math.max(math.min(close, fvgDynamicBullUpper), fvgDynamicBullLower)

    if fvgBearRaw and fvgNewSignal
        fvg_record newBearRecord = fvg_record.new(fvgMaxRaw, fvgMinRaw, false, fvgSourceTimeRaw, fvgAnchorTimeRaw, fvgSourceBarIndexRaw, bar_index, time, fvgDetectionTf)
        if fvgDynamicMode
            fvgDynamicBearUpper := newBearRecord.max
            fvgDynamicBearLower := newBearRecord.min
        else
            array.unshift(fvgStaticBoxes, f_fvgCreateBox(newBearRecord))
        array.unshift(fvgActiveRecords, newBearRecord)
        fvgBearCount += 1
        fvgBearNewThisBar := true
        fvgLastDetectedSourceTime := fvgSourceTimeRaw
        f_fvgTrimActiveRecords()
    else if fvgDynamicMode
        fvgDynamicBearLower := math.min(math.max(close, fvgDynamicBearLower), fvgDynamicBearUpper)

if enableLuxFvgEngine and array.size(fvgActiveRecords) > 0
    for i = array.size(fvgActiveRecords) - 1 to 0
        fvg_record rec = array.get(fvgActiveRecords, i)
        bool mitigated = rec.isBull ? close < rec.min : close > rec.max
        if mitigated
            if fvgShowMitigationLevels
                array.unshift(fvgMitigatedThisBarRecords, rec)
            if not fvgDynamicMode and array.size(fvgStaticBoxes) > i
                box activeBox = array.remove(fvgStaticBoxes, i)
                box.delete(activeBox)
            array.remove(fvgActiveRecords, i)
            if rec.isBull
                fvgBullMitigatedCount += 1
                fvgBullMitigatedThisBar := true
            else
                fvgBearMitigatedCount += 1
                fvgBearMitigatedThisBar := true

int fvgActiveBullCount = 0
int fvgActiveBearCount = 0
float fvgNearestBullLower = na
float fvgNearestBullUpper = na
float fvgNearestBearLower = na
float fvgNearestBearUpper = na
float fvgNearestBullDist = na
float fvgNearestBearDist = na
int fvgMostRecentBullSourceTime = na
int fvgMostRecentBearSourceTime = na

if array.size(fvgActiveRecords) > 0
    for i = 0 to array.size(fvgActiveRecords) - 1
        fvg_record rec = array.get(fvgActiveRecords, i)
        float lower = rec.min
        float upper = rec.max
        float distanceToZone = math.abs(((upper + lower) / 2.0) - close)
        if rec.isBull
            fvgActiveBullCount += 1
            if na(fvgMostRecentBullSourceTime)
                fvgMostRecentBullSourceTime := rec.sourceTime
            if na(fvgNearestBullDist) or distanceToZone < fvgNearestBullDist
                fvgNearestBullDist := distanceToZone
                fvgNearestBullLower := lower
                fvgNearestBullUpper := upper
        else
            fvgActiveBearCount += 1
            if na(fvgMostRecentBearSourceTime)
                fvgMostRecentBearSourceTime := rec.sourceTime
            if na(fvgNearestBearDist) or distanceToZone < fvgNearestBearDist
                fvgNearestBearDist := distanceToZone
                fvgNearestBearLower := lower
                fvgNearestBearUpper := upper

bool fvgPriceInsideBull = enableLuxFvgEngine and f_fvgIsPriceInside(true, close)
bool fvgPriceInsideBear = enableLuxFvgEngine and f_fvgIsPriceInside(false, close)
[fvgBullBelowFound, fvgBullBelowLower, fvgBullBelowUpper, fvgBullBelowSourceTime] = f_fvgNearestDirectional(true, false, close)
[fvgBearAboveFound, fvgBearAboveLower, fvgBearAboveUpper, fvgBearAboveSourceTime] = f_fvgNearestDirectional(false, true, close)
float fvgLongConfluenceScoreHook = not enableLuxFvgEngine ? 0.0 : fvgPriceInsideBull ? 1.0 : fvgBullBelowFound ? 0.5 : 0.0
float fvgShortConfluenceScoreHook = not enableLuxFvgEngine ? 0.0 : fvgPriceInsideBear ? 1.0 : fvgBearAboveFound ? 0.5 : 0.0

if barstate.islast
    if array.size(fvgMitigationLines) > 0
        for i = 0 to array.size(fvgMitigationLines) - 1
            line mitigatedLine = array.get(fvgMitigationLines, i)
            line.delete(mitigatedLine)
        array.clear(fvgMitigationLines)

    if enableLuxFvgEngine and fvgShowMitigationLevels and array.size(fvgMitigatedThisBarRecords) > 0
        for i = 0 to array.size(fvgMitigatedThisBarRecords) - 1
            fvg_record rec = array.get(fvgMitigatedThisBarRecords, i)
            float mitigationLevel = rec.isBull ? rec.min : rec.max
            color mitigationColor = rec.isBull ? fvgBullColor : fvgBearColor
            array.push(fvgMitigationLines, f_fvgCreateLevelLine(rec, mitigationLevel, mitigationColor, true))

    if array.size(fvgUnmitigatedLines) > 0
        for i = 0 to array.size(fvgUnmitigatedLines) - 1
            line activeLine = array.get(fvgUnmitigatedLines, i)
            line.delete(activeLine)
        array.clear(fvgUnmitigatedLines)

    if enableLuxFvgEngine and fvgShowLastUnmitigated > 0 and array.size(fvgActiveRecords) > 0
        int unmitigatedCount = math.min(fvgShowLastUnmitigated, array.size(fvgActiveRecords))
        for i = 0 to unmitigatedCount - 1
            fvg_record rec = array.get(fvgActiveRecords, i)
            float activeLevel = rec.isBull ? rec.min : rec.max
            color activeColor = rec.isBull ? fvgBullColor : fvgBearColor
            array.push(fvgUnmitigatedLines, f_fvgCreateLevelLine(rec, activeLevel, activeColor, false))

// --- State Maintenance: Advanced Liquidity Engine ---
var liq_pools = array.new<liq_pool>(0)
var liq_render_lines = array.new_line(0)
var bool liqClusterDirty = true
var array<int> liq_nearbyPoolIdxs = array.new_int(0)
var array<int> liq_sweepCandidateIdxs = array.new_int(0)

// Volatility-Based Auto Optimization
volScale = atrVal / nz(ta.sma(atrVal, 200), atrVal)
dynLen = autoLiqPivot ? math.max(5, math.min(40, math.round(liqPivotLen * volScale))) : liqPivotLen
float chartTfSec = math.max(float(timeframe.in_seconds(timeframe.period)), 60.0)
float liqRangeHigh = ta.highest(high, liqRangeLookback)
float liqRangeLow = ta.lowest(low, liqRangeLookback)
float liqRangeSpan = math.max(liqRangeHigh - liqRangeLow, syminfo.mintick * 20)
float liqExtThreshold = liqRangeSpan * liqExtBoundaryPct

f_liqCurrentSessionContext() =>
    inLondon ? "London" : inNY ? "New York" : inAsia ? "Asia" : "Off Session"

f_liqIsDevelopingSession(liq_pool pool) =>
    pool.baseType == "DEV_SESSION"

f_liqIsEventEligible(liq_pool pool) =>
    not f_liqIsDevelopingSession(pool)

f_liqIsExternal(string poolType) =>
    poolType == "EXTERNAL" or poolType == "SESSION" or poolType == "PERIOD" or poolType == "HTF"

f_liqClusterTolerance(float price) =>
    math.max(syminfo.mintick * 4, math.min(atrVal * 0.10, price * 0.0025))

f_liqTouchTolerance(float price) =>
    math.max(syminfo.mintick * 2, math.min(atrVal * 0.04, price * 0.0010))

f_liqSourceSeconds(liq_pool pool) =>
    pool.baseType == "PERIOD" ? (pool.sourceTF == "M" ? 2592000.0 : pool.sourceTF == "W" ? 604800.0 : 86400.0) : pool.baseType == "HTF" ? (pool.sourceTF == htf2Tf ? math.max(float(timeframe.in_seconds(htf2Tf)), chartTfSec * 24.0) : math.max(float(timeframe.in_seconds(htf1Tf)), chartTfSec * 8.0)) : (pool.baseType == "SESSION" or pool.baseType == "DEV_SESSION") ? 21600.0 : chartTfSec

f_liqAgeUnits(liq_pool pool) =>
    float ageSec = math.max(float(time - pool.creationTime) / 1000.0, 0.0)
    float sourceSec = math.max(f_liqSourceSeconds(pool), 60.0)
    float eventPenalty = math.max(pool.timesTagged - 1, 0) * 0.35 + (pool.isSwept ? 0.75 : 0.0) + (pool.state == "CONSUMED" ? 0.75 : pool.state == "SWEPT" ? 0.35 : 0.0)
    ageSec / sourceSec + eventPenalty

f_liqExpiryUnits(liq_pool pool) =>
    float baseUnits = pool.poolType == "PERIOD" ? (pool.sourceTF == "M" ? 10.0 : pool.sourceTF == "W" ? 6.0 : 3.0) : pool.poolType == "HTF" ? (pool.sourceTF == htf2Tf ? 8.0 : 6.0) : pool.poolType == "SESSION" ? 2.0 : pool.poolType == "DEV_SESSION" ? 0.75 : pool.poolType == "EXTERNAL" ? 5.0 : 2.5
    float scale = math.max(ageExpiry / 400.0, 0.5)
    baseUnits * scale

f_liqIsExpired(liq_pool pool) =>
    f_liqAgeUnits(pool) > f_liqExpiryUnits(pool)

f_liqClamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

f_liqNearValue(float left, float right, float tol) =>
    not na(left) and not na(right) and math.abs(left - right) <= tol

f_liqClusterMetrics(liq_pool pool) =>
    [pool.derivedClusterCount, pool.derivedClusterCompactness, pool.derivedClusterSpanBars, pool.derivedClusterObviousness, pool.derivedClusterEdgePriority, pool.derivedClusterPartialTagged]

f_liqCalculatedCleanliness(liq_pool pool) =>
    float score = 72.0
    score += math.min(pool.clusterSize - 1, 3) * 7.0
    score -= math.max(pool.timesTagged - 1, 0) * 8.0
    score -= math.max(f_liqAgeUnits(pool) - 1.0, 0.0) * 6.0
    score -= pool.poolType == "INTERNAL" ? 8.0 : 0.0
    score -= pool.state == "CONSUMED" ? 30.0 : pool.state == "SWEPT" ? 12.0 : pool.state == "TAGGED" ? 5.0 : 0.0
    math.max(0.0, math.min(100.0, score))

f_liqFreshnessScore(liq_pool pool) =>
    pool.derivedFreshnessScore

f_liqClusterStrength(liq_pool pool) =>
    pool.derivedClusterStrength

f_liqExternalityScore(liq_pool pool) =>
    pool.derivedExternalityScore

f_liqPoolIsExternal(liq_pool pool) =>
    f_liqExternalityScore(pool) >= 50.0

f_liqRebuildClusterMetrics() =>
    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            pool = liq_pools.get(i)
            int clusterCount = 0
            float clusterMin = pool.price
            float clusterMax = pool.price
            int earliestBar = pool.sourceBar
            int latestBar = pool.sourceBar
            int taggedNodes = 0
            int sweptNodes = 0
            float tol = f_liqClusterTolerance(pool.price)
            float edgeTol = math.max(f_liqTouchTolerance(pool.price), syminfo.mintick * 4)
            for j = 0 to liq_pools.size() - 1
                p_c = liq_pools.get(j)
                bool sameSide = p_c.side == pool.side
                bool sameNarrativeLevel = math.abs(p_c.price - pool.price) <= tol
                bool eligible = sameSide and p_c.state != "CONSUMED" and f_liqIsEventEligible(p_c) and sameNarrativeLevel
                if eligible
                    int nodeCount = p_c.baseType == "SWING" ? math.max(p_c.clusterSize, 1) : 1
                    clusterCount += nodeCount
                    clusterMin := math.min(clusterMin, p_c.price)
                    clusterMax := math.max(clusterMax, p_c.price)
                    earliestBar := na(earliestBar) ? p_c.sourceBar : math.min(earliestBar, p_c.sourceBar)
                    latestBar := na(latestBar) ? p_c.sourceBar : math.max(latestBar, p_c.sourceBar)
                    if p_c.timesTagged > 0 or p_c.state == "TAGGED"
                        taggedNodes += 1
                    if p_c.state == "SWEPT" or p_c.isSwept
                        sweptNodes += 1
            clusterCount := math.max(clusterCount, 1)
            float priceSpan = clusterMax - clusterMin
            int spanBars = na(earliestBar) or na(latestBar) ? 0 : math.max(latestBar - earliestBar, 0)
            float compactness = clusterCount <= 1 ? 0.0 : f_liqClamp(1.0 - priceSpan / math.max(tol * 1.35, syminfo.mintick * 6), 0.0, 1.0) * 100.0
            float obviousness = clusterCount <= 1 ? 0.0 : f_liqClamp(24.0 + float(clusterCount - 1) * 11.0 + compactness * 0.34 + math.min(float(spanBars), 60.0) * 0.18 - float(taggedNodes) * 4.0 - float(sweptNodes) * 6.0, 0.0, 100.0)
            float edgePriority = 50.0
            if clusterCount > 1
                if pool.side == "BSL"
                    edgePriority := pool.price >= (clusterMax - edgeTol) ? 100.0 : f_liqClamp(30.0 + ((pool.price - clusterMin) / math.max(priceSpan, edgeTol)) * 70.0, 0.0, 100.0)
                else
                    edgePriority := pool.price <= (clusterMin + edgeTol) ? 100.0 : f_liqClamp(30.0 + ((clusterMax - pool.price) / math.max(priceSpan, edgeTol)) * 70.0, 0.0, 100.0)
            bool partiallyTagged = taggedNodes > 0 and taggedNodes < clusterCount
            pool.derivedClusterCount := clusterCount
            pool.derivedClusterCompactness := compactness
            pool.derivedClusterSpanBars := spanBars
            pool.derivedClusterObviousness := obviousness
            pool.derivedClusterEdgePriority := edgePriority
            pool.derivedClusterPartialTagged := partiallyTagged
    true

f_liqRefreshDerivedScores() =>
    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            pool = liq_pools.get(i)
            int clusterCount = pool.derivedClusterCount
            float clusterCompactness = pool.derivedClusterCompactness
            float clusterObviousness = pool.derivedClusterObviousness
            float clusterEdgePriority = pool.derivedClusterEdgePriority
            bool partiallyTagged = pool.derivedClusterPartialTagged
            int spanBars = pool.derivedClusterSpanBars
            float ageUnits = f_liqAgeUnits(pool)
            float agePenalty = ageUnits * (pool.baseType == "PERIOD" or pool.baseType == "HTF" ? 5.5 : pool.baseType == "SESSION" ? 7.0 : 11.0)
            float retagPenalty = math.max(pool.timesTagged - 1, 0) * 8.0
            float statePenalty = pool.state == "CONSUMED" ? 42.0 : pool.state == "SWEPT" ? 24.0 : pool.state == "TAGGED" ? 8.0 : 0.0
            float failurePenalty = not na(pool.lastFailureBar) and (bar_index - pool.lastFailureBar) <= 50 ? 12.0 : 0.0
            float freshness = 86.0
            freshness += (pool.baseType == "PERIOD" or pool.baseType == "HTF" ? 8.0 : 0.0)
            freshness += math.max(pool.structuralRank - 60.0, 0.0) * 0.18
            freshness += math.min(clusterCount - 1, 4) * 3.0
            freshness += clusterObviousness * 0.06 + clusterCompactness * 0.04
            freshness -= agePenalty + retagPenalty + statePenalty + failurePenalty
            freshness -= partiallyTagged ? 4.0 : 0.0
            pool.derivedFreshnessScore := f_liqClamp(freshness, 0.0, 100.0)

            float clusterStrength = clusterCount <= 1 ? 0.0 : 18.0 + math.min(clusterCount - 1, 5) * 12.0 + clusterCompactness * 0.30 + clusterObviousness * 0.32 + clusterEdgePriority * 0.18 - (partiallyTagged ? 8.0 : 0.0) - math.min(float(spanBars), 120.0) * 0.05
            pool.derivedClusterStrength := f_liqClamp(clusterStrength, 0.0, 100.0)

            float pos = liqRangeSpan > 0 ? (pool.price - liqRangeLow) / liqRangeSpan : 0.5
            float tol = math.max(f_liqTouchTolerance(pool.price) * 1.75, syminfo.mintick * 8)
            bool isRangeBoundaryExternal = pool.side == "BSL" ? pos >= 0.78 : pos <= 0.22
            bool isSessionExternal = pool.baseType == "SESSION"
            bool isPeriodExternal = pool.baseType == "PERIOD"
            bool isHtfExternal = pool.baseType == "HTF"
            bool isClusterExternal = clusterCount > 1 and clusterObviousness >= 56.0 and clusterEdgePriority >= 60.0
            bool isVisualMajorExternal = pool.baseType == "SWING" and (pool.structuralRank >= 78.0 or math.max(bar_index - pool.sourceBar, 0) >= dynLen * 2)
            bool nearPeriodLevel = (pool.side == "BSL" and (f_liqNearValue(pool.price, pdh, tol) or f_liqNearValue(pool.price, pwh, tol) or f_liqNearValue(pool.price, pmh, tol))) or (pool.side == "SSL" and (f_liqNearValue(pool.price, pdl, tol) or f_liqNearValue(pool.price, pwl, tol) or f_liqNearValue(pool.price, pml, tol)))
            bool nearHtfLevel = (pool.side == "BSL" and (f_liqNearValue(pool.price, lastHtf1PH, tol) or f_liqNearValue(pool.price, lastHtf2PH, tol))) or (pool.side == "SSL" and (f_liqNearValue(pool.price, lastHtf1PL, tol) or f_liqNearValue(pool.price, lastHtf2PL, tol)))
            float externality = 0.0
            externality += pool.poolType == "EXTERNAL" ? 18.0 : 0.0
            externality += isRangeBoundaryExternal ? 16.0 : 0.0
            externality += isSessionExternal ? 18.0 : 0.0
            externality += isPeriodExternal ? 30.0 : nearPeriodLevel ? 16.0 : 0.0
            externality += isHtfExternal ? 32.0 : nearHtfLevel ? 18.0 : 0.0
            externality += isClusterExternal ? 14.0 + clusterObviousness * 0.08 : 0.0
            externality += isVisualMajorExternal ? 12.0 : 0.0
            externality += pool.structuralRank >= 90.0 ? 8.0 : pool.structuralRank >= 80.0 ? 4.0 : 0.0
            pool.derivedExternalityScore := f_liqClamp(externality, 0.0, 100.0)
    true

f_liqSessionRelevanceScore(liq_pool pool) =>
    float score = pool.baseType == "PERIOD" or pool.baseType == "HTF" ? 66.0 : 46.0
    if inLondonSweepWindow
        score := pool.sessionContext == "Asia" ? 94.0 : pool.sessionContext == "London" ? 76.0 : pool.sessionContext == "New York" ? 52.0 : score
    else if inNYSweepWindow
        score := pool.sessionContext == "London" ? 94.0 : pool.sessionContext == "Asia" ? 80.0 : pool.sessionContext == "New York" ? 62.0 : score
    else if inAsia
        score := pool.sessionContext == "New York" ? 78.0 : pool.sessionContext == "Asia" ? 54.0 : 42.0
    else if inLondon or inNY
        score := pool.sessionContext == f_liqCurrentSessionContext() ? 68.0 : 56.0
    score += pool.baseType == "DEV_SESSION" ? -18.0 : 0.0
    f_liqClamp(score, 0.0, 100.0)

f_liqHtfConfluenceScore(liq_pool pool, float narrativeBias) =>
    float score = pool.baseType == "HTF" ? 86.0 : pool.baseType == "PERIOD" ? 72.0 : 50.0
    float directionalBias = pool.side == "SSL" ? narrativeBias : -narrativeBias
    score += f_liqClamp(directionalBias * 0.18, -14.0, 14.0)
    score += pool.side == "BSL" and (f_liqNearValue(pool.price, lastHtf1PH, f_liqTouchTolerance(pool.price) * 1.75) or f_liqNearValue(pool.price, lastHtf2PH, f_liqTouchTolerance(pool.price) * 1.75)) ? 10.0 : 0.0
    score += pool.side == "SSL" and (f_liqNearValue(pool.price, lastHtf1PL, f_liqTouchTolerance(pool.price) * 1.75) or f_liqNearValue(pool.price, lastHtf2PL, f_liqTouchTolerance(pool.price) * 1.75)) ? 10.0 : 0.0
    f_liqClamp(score, 0.0, 100.0)

f_liqNarrativeRelevanceScore(liq_pool pool, float narrativeBias) =>
    float directionalBias = pool.side == "SSL" ? narrativeBias : -narrativeBias
    float score = 50.0 + directionalBias * 0.70
    score += math.abs(narrativeBias) < 10.0 and f_liqPoolIsExternal(pool) ? 6.0 : 0.0
    score += pool.baseType == "DEV_SESSION" ? -12.0 : 0.0
    f_liqClamp(score, 0.0, 100.0)

f_liqInducementScore(liq_pool pool, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    float tol = math.max(f_liqClusterTolerance(pool.price), atrVal * 0.12)
    bool structureAligned = currentStructureBias == 1 ? pool.side == "SSL" : currentStructureBias == -1 ? pool.side == "BSL" : false
    bool nearIdm = structureAligned and f_liqNearValue(pool.price, currentIdmLevel, tol)
    bool isTrueInducement = nearIdm and currentIdmState == 1
    bool isWeakInducement = (nearIdm or pool.isInducementCandidate) and currentIdmState != 2 and not isTrueInducement
    bool isStaleInducement = (nearIdm or pool.isInducementCandidate) and currentIdmState == 2
    isTrueInducement ? 26.0 : isWeakInducement ? 12.0 : isStaleInducement ? -14.0 : pool.isInducementCandidate ? 4.0 : 0.0

f_liqProximityScore(liq_pool pool, float anchorPrice) =>
    float score = 50.0
    if not na(anchorPrice) and atrVal > 0
        float distAtr = math.abs(pool.price - anchorPrice) / atrVal
        score := distAtr <= 0.35 ? 96.0 : distAtr <= 0.75 ? 84.0 : distAtr <= 1.50 ? 70.0 : distAtr <= 3.00 ? 54.0 : distAtr <= 5.00 ? 36.0 : 18.0
    f_liqClamp(score, 0.0, 100.0)

f_liqUsabilityScore(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    float freshness = f_liqFreshnessScore(pool)
    float proximity = f_liqProximityScore(pool, anchorPrice)
    float externality = f_liqExternalityScore(pool)
    float narrative = f_liqNarrativeRelevanceScore(pool, narrativeBias)
    float inducement = f_liqInducementScore(pool, currentStructureBias, currentIdmLevel, currentIdmState)
    float score = freshness * 0.42 + proximity * 0.18 + pool.cleanlinessScore * 0.14 + externality * 0.10 + narrative * 0.10 + f_liqSessionRelevanceScore(pool) * 0.06
    score += inducement * 0.45
    score += pool.state == "TAGGED" and pool.timesTagged >= 3 ? -10.0 : 0.0
    score += pool.state == "SWEPT" and not na(pool.lastFailureBar) and (bar_index - pool.lastFailureBar) <= 30 ? -12.0 : 0.0
    f_liqClamp(score, 0.0, 100.0)

f_liqContextScores(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    float externality = f_liqExternalityScore(pool)
    float clusterStrength = f_liqClusterStrength(pool)
    float freshness = f_liqFreshnessScore(pool)
    float usability = f_liqUsabilityScore(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
    float sessionScore = f_liqSessionRelevanceScore(pool)
    float htfScore = f_liqHtfConfluenceScore(pool, narrativeBias)
    float inducement = f_liqInducementScore(pool, currentStructureBias, currentIdmLevel, currentIdmState)
    float proximity = f_liqProximityScore(pool, anchorPrice)
    float narrative = f_liqNarrativeRelevanceScore(pool, narrativeBias)
    float importance = pool.structuralRank * 0.25 + freshness * 0.18 + usability * 0.16 + externality * 0.16 + clusterStrength * 0.10 + sessionScore * 0.06 + htfScore * 0.05 + pool.cleanlinessScore * 0.04
    importance += inducement * 0.30
    importance := f_liqClamp(importance, 0.0, 100.0)
    float actionability = importance * 0.44 + proximity * 0.20 + usability * 0.16 + narrative * 0.10 + externality * 0.05 + sessionScore * 0.05
    actionability += math.max(inducement, 0.0) * 0.30
    actionability += pool.baseType == "DEV_SESSION" ? -14.0 : 0.0
    actionability += pool.state == "SWEPT" or pool.state == "CONSUMED" ? -18.0 : 0.0
    actionability := f_liqClamp(actionability, 0.0, 100.0)
    int tierId = actionability >= 70.0 and importance >= 62.0 ? 3 : importance >= 56.0 or externality >= 60.0 or clusterStrength >= 66.0 ? 2 : 1
    [importance, actionability, tierId]

f_liqImportanceScore(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    [importance, _, _] = f_liqContextScores(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
    importance

f_liqActionabilityScore(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    [_, actionability, _] = f_liqContextScores(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
    actionability

f_liqTierId(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    [_, _, tierId] = f_liqContextScores(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
    tierId

f_liqIsInformational(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    f_liqTierId(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState) == 1

f_liqIsImportant(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    f_liqTierId(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState) >= 2

f_liqIsActionable(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    f_liqTierId(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState) == 3

f_liqReasonFlags(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    float externality = f_liqExternalityScore(pool)
    float clusterStrength = f_liqClusterStrength(pool)
    float inducementScore = f_liqInducementScore(pool, currentStructureBias, currentIdmLevel, currentIdmState)
    int tierId = f_liqTierId(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
    string flags = tierId == 3 ? "ACTIONABLE" : tierId == 2 ? "IMPORTANT" : "INFO"
    if externality >= 60.0
        flags += "|EXT"
    if clusterStrength >= 60.0
        flags += "|" + (pool.side == "BSL" ? "EQH" : "EQL")
    if inducementScore >= 12.0
        flags += "|IDM"
    if pool.baseType == "HTF"
        flags += "|HTF"
    else if pool.baseType == "PERIOD"
        flags += "|PD"
    flags

f_liqRetentionScore(liq_pool pool) =>
    pool.structuralRank + f_liqFreshnessScore(pool) * 0.44 + pool.cleanlinessScore * 0.18 + f_liqExternalityScore(pool) * 0.20 + f_liqClusterStrength(pool) * 0.18

f_liqCompactBaseLabel(liq_pool pool) =>
    string txt = pool.baseLabel
    if pool.baseType == "SWING"
        string eqPrefix = pool.clusterSize > 1 ? "EQ " : ""
        txt := pool.poolType == "EXTERNAL" ? eqPrefix + (pool.side == "BSL" ? "Ext BSL" : "Ext SSL") : eqPrefix + (pool.side == "BSL" ? "Int BSL" : "Int SSL")
    else if pool.baseLabel == "HTF1 HIGH"
        txt := htf1StructureDir == 1 ? "HTF1 Obj High" : htf1StructureDir == -1 ? "HTF1 Prot High" : "HTF1 Range High"
    else if pool.baseLabel == "HTF1 LOW"
        txt := htf1StructureDir == 1 ? "HTF1 Prot Low" : htf1StructureDir == -1 ? "HTF1 Obj Low" : "HTF1 Range Low"
    else if pool.baseLabel == "HTF2 HIGH"
        txt := htf2StructureDir == 1 ? "HTF2 Obj High" : htf2StructureDir == -1 ? "HTF2 Prot High" : "HTF2 Range High"
    else if pool.baseLabel == "HTF2 LOW"
        txt := htf2StructureDir == 1 ? "HTF2 Prot Low" : htf2StructureDir == -1 ? "HTF2 Obj Low" : "HTF2 Range Low"
    else if pool.baseLabel == "DEV LONDON H"
        txt := "Dev London H"
    else if pool.baseLabel == "DEV LONDON L"
        txt := "Dev London L"
    else if pool.baseLabel == "DEV NY H"
        txt := "Dev NY H"
    else if pool.baseLabel == "DEV NY L"
        txt := "Dev NY L"
    else if pool.baseLabel == "DEV ASIA H"
        txt := "Dev Asia H"
    else if pool.baseLabel == "DEV ASIA L"
        txt := "Dev Asia L"
    else if pool.baseLabel == "LONDON H"
        txt := inLondon ? "Prev London H" : "London H"
    else if pool.baseLabel == "LONDON L"
        txt := inLondon ? "Prev London L" : "London L"
    else if pool.baseLabel == "NY H"
        txt := inNY ? "Prev NY H" : "NY H"
    else if pool.baseLabel == "NY L"
        txt := inNY ? "Prev NY L" : "NY L"
    else if pool.baseLabel == "ASIA H"
        txt := inAsia ? "Prev Asia H" : "Asia H"
    else if pool.baseLabel == "ASIA L"
        txt := inAsia ? "Prev Asia L" : "Asia L"
    txt

f_liqDashboardLabel(liq_pool pool, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    [clusterCount, clusterCompactnessDash, clusterSpanBarsDash, clusterObviousness, clusterEdgePriorityDash, clusterPartialDash] = f_liqClusterMetrics(pool)
    bool eqCluster = clusterCount > 1 and clusterObviousness >= 54.0
    bool external = f_liqPoolIsExternal(pool)
    float inducementScore = f_liqInducementScore(pool, currentStructureBias, currentIdmLevel, currentIdmState)
    string eqTag = pool.side == "BSL" ? "EQH" : "EQL"
    string base = f_liqCompactBaseLabel(pool)
    if pool.baseType == "SWING"
        if inducementScore >= 20.0 and not external
            base := "IDM " + pool.side
        else if eqCluster
            base := external ? "EQ ext " + pool.side + " x" + str.tostring(clusterCount) : eqTag + " x" + str.tostring(clusterCount)
        else if external
            base := pool.side == "BSL" ? "Ext BSL" : "Ext SSL"
        else if inducementScore >= 10.0
            base := "IDM " + pool.side
        else
            base := pool.side == "BSL" ? "Int BSL" : "Int SSL"
    else if eqCluster and not str.contains(base, "EQ")
        base += " + " + eqTag + (clusterCount > 2 ? " x" + str.tostring(clusterCount) : "")
    base

f_liqDisplayLabel(liq_pool pool) =>
    f_liqCompactBaseLabel(pool)

f_liqHasDedicatedOverlay(liq_pool pool) =>
    (pool.baseLabel == "PDH" and showPDH) or
     (pool.baseLabel == "PDL" and showPDL) or
     (pool.baseLabel == "PWH" and showPWH) or
     (pool.baseLabel == "PWL" and showPWL) or
     (pool.baseLabel == "PMH" and showPMH) or
     (pool.baseLabel == "PML" and showPML)

f_newLiqPool(string side, string poolType, string baseType, float price, int sourceBar, int creationTime, string label, string baseLabel, string sourceTF, float structuralRank, string sessionContext, float cleanlinessScore, bool isInducementCandidate) =>
    liq_pool.new(side, poolType, baseType, price, sourceBar, false, label, baseLabel, 0, 1, int(na), sourceBar, int(na), na, int(na), na, int(na), int(na), creationTime, sourceTF, structuralRank, 0, cleanlinessScore, sessionContext, isInducementCandidate, "FRESH", 1, 0.0, 0, 0.0, 50.0, false, 0.0, 0.0, 0.0)

f_htfLiqRank(string tf, float conf) =>
    float baseRank = tf == htf2Tf ? 90.0 : 84.0
    float ceiling = tf == htf2Tf ? 98.0 : 94.0
    math.min(ceiling, baseRank + conf * 0.12)

f_htfLiqCleanliness(float conf) =>
    math.min(100.0, 76.0 + conf * 0.18)

f_liqRemoveNamedPool(string label) =>
    bool clusterChanged = false
    if liq_pools.size() > 0
        for i = liq_pools.size() - 1 to 0
            pool = liq_pools.get(i)
            if pool.baseLabel == label
                liq_pools.remove(i)
                clusterChanged := true
    clusterChanged

f_liqUpsertNamedPool(string side, string poolType, string baseType, float price, int sourceBar, string label, string sourceTF, float structuralRank, string sessionContext, float cleanlinessScore, bool isInducementCandidate, bool preserveState) =>
    bool clusterChanged = false
    if not na(price)
        int existingIdx = na
        if liq_pools.size() > 0
            for i = 0 to liq_pools.size() - 1
                pool = liq_pools.get(i)
                if pool.baseLabel == label
                    existingIdx := i
                    break
        if preserveState and not na(existingIdx)
            pool = liq_pools.get(existingIdx)
            bool sameNarrativeLevel = math.abs(pool.price - price) <= f_liqClusterTolerance(price)
            if sameNarrativeLevel
                bool levelChanged = math.abs(pool.price - price) > syminfo.mintick * 0.5 or pool.sourceBar != sourceBar or pool.side != side
                pool.side := side
                pool.poolType := poolType
                pool.baseType := baseType
                pool.price := price
                pool.sourceBar := sourceBar
                pool.poolLabel := label
                pool.baseLabel := label
                pool.sourceTF := sourceTF
                pool.structuralRank := structuralRank
                pool.sessionContext := sessionContext
                pool.cleanlinessScore := cleanlinessScore
                pool.isInducementCandidate := isInducementCandidate
                if levelChanged
                    clusterChanged := true
            else
                liq_pools.remove(existingIdx)
                liq_pools.push(f_newLiqPool(side, poolType, baseType, price, sourceBar, time, label, label, sourceTF, structuralRank, sessionContext, cleanlinessScore, isInducementCandidate))
                clusterChanged := true
        else
            clusterChanged := f_liqRemoveNamedPool(label) or clusterChanged
            liq_pools.push(f_newLiqPool(side, poolType, baseType, price, sourceBar, time, label, label, sourceTF, structuralRank, sessionContext, cleanlinessScore, isInducementCandidate))
            clusterChanged := true
    clusterChanged

f_liqUpsertSwingPool(string side, float price, int sourceBar, float seedRank, bool externalSeed) =>
    bool clusterChanged = false
    if not na(price)
        bool merged = false
        int bestIdx = na
        float bestDist = 10e10
        float tol = f_liqClusterTolerance(price)
        if liq_pools.size() > 0
            for i = 0 to liq_pools.size() - 1
                pool = liq_pools.get(i)
                if pool.baseType == "SWING" and pool.side == side and pool.state != "CONSUMED"
                    dist = math.abs(pool.price - price)
                    if dist <= tol and dist < bestDist
                        bestIdx := i
                        bestDist := dist
        if not na(bestIdx)
            pool = liq_pools.get(bestIdx)
            float prevPrice = pool.price
            int prevClusterSize = pool.clusterSize
            pool.price := side == "BSL" ? math.max(pool.price, price) : math.min(pool.price, price)
            pool.clusterSize += 1
            pool.lastRefreshBar := sourceBar
            if externalSeed and pool.poolType != "EXTERNAL"
                pool.poolType := "EXTERNAL"
                pool.poolLabel := "EXTERNAL " + side
            pool.structuralRank := math.max(pool.structuralRank, seedRank)
            pool.sessionContext := f_liqCurrentSessionContext()
            pool.cleanlinessScore := math.min(pool.cleanlinessScore + 6.0, 100.0)
            if math.abs(prevPrice - pool.price) > syminfo.mintick * 0.5 or prevClusterSize != pool.clusterSize
                clusterChanged := true
            merged := true
        if not merged
            string startingType = externalSeed ? "EXTERNAL" : "INTERNAL"
            string startingLabel = startingType + " " + side
            liq_pools.push(f_newLiqPool(side, startingType, "SWING", price, sourceBar, time, startingLabel, "SWING " + side, timeframe.period, seedRank, f_liqCurrentSessionContext(), 72.0, false))
            clusterChanged := true
    clusterChanged

majPH = ta.pivothigh(high, dynLen * 2, dynLen * 2)
majPL = ta.pivotlow(low, dynLen * 2, dynLen * 2)
minPH = ta.pivothigh(high, dynLen, dynLen)
minPL = ta.pivotlow(low, dynLen, dynLen)

if barstate.isconfirmed
    if not na(majPH)
        int majorHighBar = bar_index - dynLen * 2
        bool majorHighExternal = majPH >= (liqRangeHigh - liqExtThreshold)
        liqClusterDirty := f_liqUpsertSwingPool("BSL", majPH, majorHighBar, majorHighExternal ? 82.0 : 60.0, majorHighExternal) or liqClusterDirty
    if not na(majPL)
        int majorLowBar = bar_index - dynLen * 2
        bool majorLowExternal = majPL <= (liqRangeLow + liqExtThreshold)
        liqClusterDirty := f_liqUpsertSwingPool("SSL", majPL, majorLowBar, majorLowExternal ? 82.0 : 60.0, majorLowExternal) or liqClusterDirty
    if not na(minPH) and na(majPH)
        int minorHighBar = bar_index - dynLen
        bool minorHighExternal = minPH >= (liqRangeHigh - liqExtThreshold)
        liqClusterDirty := f_liqUpsertSwingPool("BSL", minPH, minorHighBar, minorHighExternal ? 72.0 : 42.0, minorHighExternal) or liqClusterDirty
    if not na(minPL) and na(majPL)
        int minorLowBar = bar_index - dynLen
        bool minorLowExternal = minPL <= (liqRangeLow + liqExtThreshold)
        liqClusterDirty := f_liqUpsertSwingPool("SSL", minPL, minorLowBar, minorLowExternal ? 72.0 : 42.0, minorLowExternal) or liqClusterDirty

if showDevelopingSessionLevels and inAsia and not na(asiaH) and not na(asiaL)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "DEV_SESSION", "DEV_SESSION", asiaH, nz(asiaStartBar, bar_index), "DEV ASIA H", timeframe.period, 52.0, "Asia", 66.0, false, true) or liqClusterDirty
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "DEV_SESSION", "DEV_SESSION", asiaL, nz(asiaStartBar, bar_index), "DEV ASIA L", timeframe.period, 52.0, "Asia", 66.0, false, true) or liqClusterDirty
else
    liqClusterDirty := f_liqRemoveNamedPool("DEV ASIA H") or liqClusterDirty
    liqClusterDirty := f_liqRemoveNamedPool("DEV ASIA L") or liqClusterDirty

if showDevelopingSessionLevels and inLondon and not na(londonH) and not na(londonL)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "DEV_SESSION", "DEV_SESSION", londonH, nz(londonStartBar, bar_index), "DEV LONDON H", timeframe.period, 56.0, "London", 68.0, false, true) or liqClusterDirty
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "DEV_SESSION", "DEV_SESSION", londonL, nz(londonStartBar, bar_index), "DEV LONDON L", timeframe.period, 56.0, "London", 68.0, false, true) or liqClusterDirty
else
    liqClusterDirty := f_liqRemoveNamedPool("DEV LONDON H") or liqClusterDirty
    liqClusterDirty := f_liqRemoveNamedPool("DEV LONDON L") or liqClusterDirty

if showDevelopingSessionLevels and inNY and not na(nySessH) and not na(nySessL)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "DEV_SESSION", "DEV_SESSION", nySessH, nz(nySessStartBar, bar_index), "DEV NY H", timeframe.period, 58.0, "New York", 70.0, false, true) or liqClusterDirty
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "DEV_SESSION", "DEV_SESSION", nySessL, nz(nySessStartBar, bar_index), "DEV NY L", timeframe.period, 58.0, "New York", 70.0, false, true) or liqClusterDirty
else
    liqClusterDirty := f_liqRemoveNamedPool("DEV NY H") or liqClusterDirty
    liqClusterDirty := f_liqRemoveNamedPool("DEV NY L") or liqClusterDirty

if not inAsia and inAsia[1] and not na(asiaH) and not na(asiaL)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "SESSION", "SESSION", asiaH, bar_index - 1, "ASIA H", timeframe.period, 68.0, "Asia", 78.0, false, false) or liqClusterDirty
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "SESSION", "SESSION", asiaL, bar_index - 1, "ASIA L", timeframe.period, 68.0, "Asia", 78.0, false, false) or liqClusterDirty
if not inLondon and inLondon[1] and not na(londonH) and not na(londonL)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "SESSION", "SESSION", londonH, bar_index - 1, "LONDON H", timeframe.period, 74.0, "London", 82.0, false, false) or liqClusterDirty
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "SESSION", "SESSION", londonL, bar_index - 1, "LONDON L", timeframe.period, 74.0, "London", 82.0, false, false) or liqClusterDirty
if not inNY and inNY[1] and not na(nySessH) and not na(nySessL)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "SESSION", "SESSION", nySessH, bar_index - 1, "NY H", timeframe.period, 78.0, "New York", 84.0, false, false) or liqClusterDirty
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "SESSION", "SESSION", nySessL, bar_index - 1, "NY L", timeframe.period, 78.0, "New York", 84.0, false, false) or liqClusterDirty
if isNewDay and not na(pdh) and not na(pdl)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "PERIOD", "PERIOD", pdh, bar_index, "PDH", "D", 86.0, "Prev Day", 84.0, false, false) or liqClusterDirty
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "PERIOD", "PERIOD", pdl, bar_index, "PDL", "D", 86.0, "Prev Day", 84.0, false, false) or liqClusterDirty
if isNewWeek and not na(pwh) and not na(pwl)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "PERIOD", "PERIOD", pwh, bar_index, "PWH", "W", 92.0, "Prev Week", 88.0, false, false) or liqClusterDirty
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "PERIOD", "PERIOD", pwl, bar_index, "PWL", "W", 92.0, "Prev Week", 88.0, false, false) or liqClusterDirty
if isNewMonth and not na(pmh) and not na(pml)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "PERIOD", "PERIOD", pmh, bar_index, "PMH", "M", 98.0, "Prev Month", 92.0, false, false) or liqClusterDirty
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "PERIOD", "PERIOD", pml, bar_index, "PML", "M", 98.0, "Prev Month", 92.0, false, false) or liqClusterDirty

if showHTFLiquidity and not na(lastHtf1PH)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "HTF", "HTF", lastHtf1PH, bar_index, "HTF1 HIGH", htf1Tf, f_htfLiqRank(htf1Tf, htf1Confidence), f_htfStateName(htf1State), f_htfLiqCleanliness(htf1Confidence), false, true) or liqClusterDirty
else
    liqClusterDirty := f_liqRemoveNamedPool("HTF1 HIGH") or liqClusterDirty
if showHTFLiquidity and not na(lastHtf1PL)
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "HTF", "HTF", lastHtf1PL, bar_index, "HTF1 LOW", htf1Tf, f_htfLiqRank(htf1Tf, htf1Confidence), f_htfStateName(htf1State), f_htfLiqCleanliness(htf1Confidence), false, true) or liqClusterDirty
else
    liqClusterDirty := f_liqRemoveNamedPool("HTF1 LOW") or liqClusterDirty
if showHTFLiquidity and not na(lastHtf2PH)
    liqClusterDirty := f_liqUpsertNamedPool("BSL", "HTF", "HTF", lastHtf2PH, bar_index, "HTF2 HIGH", htf2Tf, f_htfLiqRank(htf2Tf, htf2Confidence), f_htfStateName(htf2State), f_htfLiqCleanliness(htf2Confidence), false, true) or liqClusterDirty
else
    liqClusterDirty := f_liqRemoveNamedPool("HTF2 HIGH") or liqClusterDirty
if showHTFLiquidity and not na(lastHtf2PL)
    liqClusterDirty := f_liqUpsertNamedPool("SSL", "HTF", "HTF", lastHtf2PL, bar_index, "HTF2 LOW", htf2Tf, f_htfLiqRank(htf2Tf, htf2Confidence), f_htfStateName(htf2State), f_htfLiqCleanliness(htf2Confidence), false, true) or liqClusterDirty
else
    liqClusterDirty := f_liqRemoveNamedPool("HTF2 LOW") or liqClusterDirty

if liq_pools.size() > 0
    for i = 0 to liq_pools.size() - 1
        pool = liq_pools.get(i)
        if pool.baseType == "SWING"
            bool eqCluster = pool.clusterSize > 1
            bool externalClass = pool.poolType == "EXTERNAL"
            pool.poolType := externalClass ? "EXTERNAL" : "INTERNAL"
            pool.poolLabel := (externalClass ? "EXTERNAL " : "INTERNAL ") + pool.side
            pool.structuralRank := externalClass ? math.max(pool.structuralRank, eqCluster ? 84.0 : 72.0) : math.min(pool.structuralRank + (eqCluster ? 4.0 : 0.0), 64.0)
            if liqRangeSpan > 0
                float relPos = (pool.price - liqRangeLow) / liqRangeSpan
                pool.isInducementCandidate := pool.poolType == "INTERNAL" and ((pool.side == "BSL" and relPos > 0.55 and relPos < 0.95) or (pool.side == "SSL" and relPos < 0.45 and relPos > 0.05))
        else if pool.baseType == "SESSION"
            pool.poolType := "SESSION"
            pool.poolLabel := pool.baseLabel
            pool.structuralRank := str.contains(pool.baseLabel, "NY") ? 78.0 : str.contains(pool.baseLabel, "LONDON") ? 74.0 : 68.0
            pool.isInducementCandidate := false
        else if pool.baseType == "DEV_SESSION"
            pool.poolType := "DEV_SESSION"
            pool.poolLabel := pool.baseLabel
            pool.structuralRank := str.contains(pool.baseLabel, "DEV NY") ? 58.0 : str.contains(pool.baseLabel, "DEV LONDON") ? 56.0 : 52.0
            pool.isInducementCandidate := false
        else if pool.baseType == "PERIOD"
            pool.poolType := "PERIOD"
            pool.poolLabel := pool.baseLabel
            pool.structuralRank := pool.sourceTF == "M" ? 98.0 : pool.sourceTF == "W" ? 92.0 : 86.0
            pool.isInducementCandidate := false
        else if pool.baseType == "HTF"
            pool.poolType := "HTF"
            pool.poolLabel := pool.baseLabel
            pool.structuralRank := f_htfLiqRank(pool.sourceTF, pool.sourceTF == htf2Tf ? htf2Confidence : htf1Confidence)
            pool.isInducementCandidate := false
        pool.cleanlinessScore := f_liqCalculatedCleanliness(pool)

    for i = 0 to liq_pools.size() - 1
        pool = liq_pools.get(i)
        string prevState = pool.state
        int prevTagged = pool.timesTagged
        bool prevIsSwept = pool.isSwept
        if f_liqIsDevelopingSession(pool)
            pool.isSwept := false
            pool.state := "FRESH"
            pool.lastRefreshBar := bar_index
            pool.pendingSweepBar := int(na)
            pool.pendingSweepExtreme := na
            pool.pendingSweepExtremeBar := int(na)
            pool.pendingWickRatio := na
            pool.lastTouchBar := int(na)
            pool.takenBar := int(na)
            pool.timesTagged := 0
            pool.touchCount := 0
        else
            touchTol = f_liqTouchTolerance(pool.price)
            isTouch = (pool.side == "BSL" and high >= pool.price - touchTol and high <= pool.price) or (pool.side == "SSL" and low <= pool.price + touchTol and low >= pool.price)
            isTaken = (pool.side == "BSL" and high >= pool.price) or (pool.side == "SSL" and low <= pool.price)
            closeInside = (pool.side == "BSL" and close < pool.price) or (pool.side == "SSL" and close > pool.price)
            closeOutside = (pool.side == "BSL" and close > pool.price) or (pool.side == "SSL" and close < pool.price)
            acceptedOutside = closeOutside and ((pool.side == "BSL" and (close - pool.price) >= touchTol) or (pool.side == "SSL" and (pool.price - close) >= touchTol))
            if (isTouch or isTaken) and (na(pool.lastTouchBar) or pool.lastTouchBar != bar_index)
                pool.timesTagged += 1
                pool.touchCount := pool.timesTagged
                pool.lastTouchBar := bar_index
                pool.lastRefreshBar := bar_index
            if isTaken and na(pool.takenBar)
                pool.takenBar := bar_index
            if isTaken
                pool.state := closeInside ? "SWEPT" : acceptedOutside ? "CONSUMED" : "TAGGED"
            else if isTouch and pool.state == "FRESH"
                pool.state := "TAGGED"
        pool.cleanlinessScore := f_liqCalculatedCleanliness(pool)
        if prevTagged != pool.timesTagged or prevState != pool.state or prevIsSwept != pool.isSwept
            liqClusterDirty := true

if liqClusterDirty
    // PERF: cached cluster refresh only when pool membership/state changed.
    f_liqRebuildClusterMetrics()
    liqClusterDirty := false
// PERF: keep freshness/externality current without forcing a full cluster rebuild every bar.
f_liqRefreshDerivedScores()

while liq_pools.size() > 80
    int dropIdx = 0
    float dropScore = f_liqRetentionScore(liq_pools.get(0))
    for i = 1 to liq_pools.size() - 1
        score = f_liqRetentionScore(liq_pools.get(i))
        if score < dropScore
            dropIdx := i
            dropScore := score
    liq_pools.remove(dropIdx)
    liqClusterDirty := true

if liqClusterDirty
    // PERF: bounded retention can change cluster composition, so refresh once after trimming.
    f_liqRebuildClusterMetrics()
    liqClusterDirty := false
    f_liqRefreshDerivedScores()

if barstate.islast
    if liq_render_lines.size() > 0
        for i = liq_render_lines.size() - 1 to 0
            line.delete(liq_render_lines.get(i))
        array.clear(liq_render_lines)

    renderRows = array.new<liq_render_row>(0)
    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            p = liq_pools.get(i)
            float pDistAtr = atrVal > 0 ? math.abs(p.price - close) / atrVal : 999.0
            bool pActiveState = p.state == "FRESH" or p.state == "TAGGED"
            bool pDevSession = p.poolType == "DEV_SESSION" and showDevelopingSessionLevels
            [pImportance, pActionability, pTierId] = f_liqContextScores(p, close, htfCompositeBias, 0, na, 4)
            bool pImportant = pTierId >= 2 or f_liqPoolIsExternal(p)
            bool pInternalActionable = pTierId == 3 and pDistAtr <= 1.25
            bool pRenderable = p.state != "CONSUMED" and ((pActiveState and (pImportant or pInternalActionable or pDevSession)) or (showSweptLiquidity and p.state == "SWEPT" and (bar_index - nz(p.lastRefreshBar, p.sourceBar)) <= sweepMssTimeoutBars and pDistAtr <= liqContextAtr and pImportance >= 50.0))
            bool pPassiveReference = p.baseType == "PERIOD" or p.baseType == "SESSION" or p.baseType == "DEV_SESSION" or p.baseType == "HTF"
            bool pNearbyAllowed = not pPassiveReference or p.state == "SWEPT" or f_nearbyReferenceAllowed(p.price)
            if pRenderable and pNearbyAllowed and not f_liqHasDedicatedOverlay(p)
                int rowIdx = na
                mergeTol = math.max(syminfo.mintick * 8, math.min(atrVal * 0.02, p.price * 0.0004))
                rowPriority = pImportance * 0.52 + pActionability * 0.33 + f_liqFreshnessScore(p) * 0.15
                rowPriority += math.max(0.0, 16.0 - pDistAtr * 4.0)
                rowPriority += p.poolType == "DEV_SESSION" ? -12.0 : 0.0
                rowPriority += p.state == "TAGGED" ? 5.0 : p.state == "SWEPT" ? -8.0 : 0.0
                if renderRows.size() > 0
                    for j = 0 to renderRows.size() - 1
                        row = renderRows.get(j)
                        if row.side == p.side and math.abs(row.price - p.price) <= mergeTol
                            rowIdx := j
                            break
                if na(rowIdx)
                    array.push(renderRows, liq_render_row.new(p.side, p.price, p.sourceBar, f_liqPoolIsExternal(p), f_liqDisplayLabel(p), rowPriority, 1, p.state))
                else
                    row = renderRows.get(rowIdx)
                    row.sourceBar := math.min(row.sourceBar, p.sourceBar)
                    row.isMajor := row.isMajor or f_liqPoolIsExternal(p)
                    row.mergedCount += 1
                    if rowPriority > row.priority
                        row.priority := rowPriority
                        row.price := p.price
                        row.primaryText := f_liqDisplayLabel(p)
                        row.state := p.state

    if renderRows.size() > 1
        for i = 0 to renderRows.size() - 2
            for j = i + 1 to renderRows.size() - 1
                r1 = renderRows.get(i)
                r2 = renderRows.get(j)
                if r1.priority < r2.priority
                    renderRows.set(i, r2)
                    renderRows.set(j, r1)

    selectedRows = array.new<liq_render_row>(0)
    int selectedBSL = 0
    int selectedSSL = 0
    int selectedSweptBSL = 0
    int selectedSweptSSL = 0
    if renderRows.size() > 0
        for i = 0 to renderRows.size() - 1
            row = renderRows.get(i)
            bool isSweptRow = row.state == "SWEPT"
            bool sideHasRoom = row.side == "BSL" ? selectedBSL < liqMaxLevelsPerSide : selectedSSL < liqMaxLevelsPerSide
            bool sweptHasRoom = not isSweptRow or (row.side == "BSL" ? selectedSweptBSL == 0 : selectedSweptSSL == 0)
            if sideHasRoom and sweptHasRoom
                array.push(selectedRows, row)
                if row.side == "BSL"
                    selectedBSL += 1
                    if isSweptRow
                        selectedSweptBSL += 1
                else
                    selectedSSL += 1
                    if isSweptRow
                        selectedSweptSSL += 1

    if selectedRows.size() > 1
        for i = 0 to selectedRows.size() - 2
            for j = i + 1 to selectedRows.size() - 1
                r1 = selectedRows.get(i)
                r2 = selectedRows.get(j)
                int r1Tier = f_levelTier(r1.primaryText)
                int r2Tier = f_levelTier(r2.primaryText)
                bool sameTier = r2Tier == r1Tier
                bool higherTier = r2Tier < r1Tier
                bool sameTierHigherPriority = sameTier and r2.priority > r1.priority
                bool sameTierSamePriorityHigherPrice = sameTier and math.abs(r2.priority - r1.priority) <= 0.01 and r2.price > r1.price
                if higherTier or sameTierHigherPriority or sameTierSamePriorityHigherPrice
                    selectedRows.set(i, r2)
                    selectedRows.set(j, r1)

    if selectedRows.size() > 0
        for i = 0 to selectedRows.size() - 1
            row = selectedRows.get(i)
            string displayText = f_compactLevelName(row.primaryText)
            int tier = f_levelTier(displayText)
            if row.state == "SWEPT"
                tier := 1
            else if row.isMajor and tier > 2
                tier := 2
            color clr = f_liquidityLineColor(row.side, tier, row.isMajor, row.state)
            lineStyle = row.state == "CONSUMED" ? line.style_dotted : row.state == "SWEPT" ? line.style_dashed : tier == 3 ? line.style_dotted : row.isMajor ? line.style_solid : line.style_dashed
            int anchorBar = na(row.sourceBar) ? bar_index : row.sourceBar
            int legacyRightOffset = adaptiveLevelExtensions ? (tier == 1 ? 9 : tier == 2 ? 7 : 5) : 10
            int legacyLeftBar = adaptiveLevelExtensions ? math.max(math.max(anchorBar, bar_index - f_levelLeftSpanBars(row.price, tier, row.state == "SWEPT")), 0) : math.max(math.max(anchorBar, bar_index - math.max(liqRangeLookback * 8, 800)), 0)
            int renderSourceBar = levelRenderMode == "Full" ? legacyLeftBar : anchorBar
            [renderLeftBar, renderRightBar] = f_levelLineCoords(renderSourceBar, row.price, levelRenderMode, rightSideLevelOffset, rightSideLevelLength, compactLevelMaxLength)
            int renderLabelBar = levelRenderMode == "Full" ? bar_index + legacyRightOffset : renderRightBar
            bool passiveReference = f_isPassiveReferenceLabel(displayText) and row.state != "SWEPT"
            color renderColor = f_levelDisplayColor(clr, passiveReference, fadePassiveLevels)
            int renderWidth = row.state == "SWEPT" ? 2 : levelRenderMode == "Full" and tier <= 2 ? 2 : 1
            array.push(liq_render_lines, line.new(renderLeftBar, row.price, renderRightBar, row.price, color=renderColor, style=lineStyle, width=renderWidth))
            if showLiquidityLabels and f_levelShouldShowLabel(row.price, tier)
                string rowLabelText = levelCompactLabels ? f_compactLevelText(displayText, row.price) : displayText + " " + str.tostring(row.price, format.mintick)
                f_registerRightLabel(row.price, renderLabelBar, rowLabelText, tier)

f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

f_liqRangePos(float price) =>
    liqRangeSpan > 0 ? (price - liqRangeLow) / liqRangeSpan : 0.5

f_sweepLiquidityScore(liq_pool pool, float anchorPrice, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    float importance = f_liqImportanceScore(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
    float actionability = f_liqActionabilityScore(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
    float externality = f_liqExternalityScore(pool)
    float clusterStrength = f_liqClusterStrength(pool)
    f_clamp(importance * 0.32 + actionability * 0.28 + externality * 0.22 + clusterStrength * 0.18, 4.0, 26.0)

f_sweepSessionIsLogical(liq_pool pool) =>
    if pool.baseType == "SESSION"
        if pool.sessionContext == "Asia"
            inLondonSweepWindow or inNYSweepWindow
        else if pool.sessionContext == "London"
            inNYSweepWindow or inAsia
        else if pool.sessionContext == "New York"
            inAsia or inLondonSweepWindow
        else
            inLondonSweepWindow or inNYSweepWindow
    else
        inLondonSweepWindow or inNYSweepWindow or inAsia or inLondon or inNY

f_sweepSessionScore(liq_pool pool) =>
    float score = 0.0
    if inLondonSweepWindow
        score += pool.sessionContext == "Asia" ? 16.0 : pool.sessionContext == "New York" ? 6.0 : 10.0
    else if inNYSweepWindow
        score += pool.sessionContext == "London" ? 16.0 : pool.sessionContext == "Asia" ? 12.0 : 10.0
    else if inAsia
        score += pool.sessionContext == "New York" ? 12.0 : 4.0
    score

f_sweepPdScore(bool isBSLPool, float refPrice) =>
    float pos = f_liqRangePos(refPrice)
    if isBSLPool
        pos >= 0.80 ? 14.0 : pos >= 0.65 ? 10.0 : pos >= 0.55 ? 5.0 : -8.0
    else
        pos <= 0.20 ? 14.0 : pos <= 0.35 ? 10.0 : pos <= 0.45 ? 5.0 : -8.0

f_sweepPenetrationScore(float depthAtr) =>
    depthAtr < 0.02 ? 4.0 : depthAtr <= 0.12 ? 18.0 : depthAtr <= (sweepMaxDepth * 0.55) ? 26.0 : depthAtr <= sweepMaxDepth ? 20.0 : depthAtr <= (sweepMaxDepth * 1.25) ? 2.0 : -18.0

f_sweepTimeScore(int barsBeyondPool) =>
    barsBeyondPool <= 0 ? 16.0 : barsBeyondPool == 1 ? 10.0 : barsBeyondPool == 2 ? 2.0 : -16.0

f_msMajorSwings() =>
    var int ms_os = 0
    var int ms_topBar = na
    var int ms_btmBar = na
    int len = msMajorSwingLen
    float upper = ta.highest(len)
    float lower = ta.lowest(len)
    ms_os := high[len] > upper ? 0 : low[len] < lower ? 1 : nz(ms_os[1], 0)
    float swingHigh = ms_os == 0 and nz(ms_os[1], 0) != 0 ? high[len] : na
    ms_topBar := ms_os == 0 and nz(ms_os[1], 0) != 0 ? bar_index[len] : nz(ms_topBar[1])
    float swingLow = ms_os == 1 and nz(ms_os[1], 0) != 1 ? low[len] : na
    ms_btmBar := ms_os == 1 and nz(ms_os[1], 0) != 1 ? bar_index[len] : nz(ms_btmBar[1])
    [swingHigh, ms_topBar, swingLow, ms_btmBar]

f_msInternalSwings() =>
    var int ms_os = 0
    var int ms_topBar = na
    var int ms_btmBar = na
    int len = msInternalSwingLen
    float upper = ta.highest(len)
    float lower = ta.lowest(len)
    ms_os := high[len] > upper ? 0 : low[len] < lower ? 1 : nz(ms_os[1], 0)
    float swingHigh = ms_os == 0 and nz(ms_os[1], 0) != 0 ? high[len] : na
    ms_topBar := ms_os == 0 and nz(ms_os[1], 0) != 0 ? bar_index[len] : nz(ms_topBar[1])
    float swingLow = ms_os == 1 and nz(ms_os[1], 0) != 1 ? low[len] : na
    ms_btmBar := ms_os == 1 and nz(ms_os[1], 0) != 1 ? bar_index[len] : nz(ms_btmBar[1])
    [swingHigh, ms_topBar, swingLow, ms_btmBar]

f_msEventLabel(string baseText, bool aligned) =>
    aligned ? baseText + "+" : baseText

f_msPushInternalPivot(array<float> valArr, array<int> barArr, array<float> atrArr, array<int> volArr, float pivotVal, int pivotBar, float pivotAtr, bool volOk, int maxItems) =>
    if not na(pivotVal) and not na(pivotBar)
        bool isDuplicate = array.size(barArr) > 0 and array.get(barArr, array.size(barArr) - 1) == pivotBar
        if not isDuplicate
            array.push(valArr, pivotVal)
            array.push(barArr, pivotBar)
            array.push(atrArr, pivotAtr)
            array.push(volArr, volOk ? 1 : 0)
            while array.size(valArr) > maxItems
                array.shift(valArr)
                array.shift(barArr)
                array.shift(atrArr)
                array.shift(volArr)
    true

f_msLatestInternalBar(array<int> barArr) =>
    int arrSize = array.size(barArr)
    arrSize > 0 ? array.get(barArr, arrSize - 1) : na

f_msFindPriorPivotLevel(array<float> valArr, array<int> barArr, int beforeBar, int maxScanDepth) =>
    float foundLevel = na
    int arrSize = array.size(barArr)
    if not na(beforeBar) and arrSize > 0
        int startIdx = math.max(arrSize - maxScanDepth, 0)
        for i = arrSize - 1 to startIdx
            int pivotBar = array.get(barArr, i)
            if pivotBar < beforeBar
                foundLevel := array.get(valArr, i)
                break
    foundLevel

f_msIdmCandidateStillValid(int bias, float candidateLevel, int candidateBar, float protectedLevel, int protectedBar, float externalLevel) =>
    bool valid = bias != 0 and not na(candidateLevel) and not na(candidateBar) and not na(protectedLevel) and not na(externalLevel)
    if valid
        float legRange = bias == 1 ? externalLevel - protectedLevel : protectedLevel - externalLevel
        float distFromProtected = bias == 1 ? candidateLevel - protectedLevel : protectedLevel - candidateLevel
        float distToExternal = bias == 1 ? externalLevel - candidateLevel : candidateLevel - externalLevel
        float legPosition = legRange > syminfo.mintick ? distFromProtected / legRange : na
        int candidateAge = bar_index - candidateBar
        valid := legRange > syminfo.mintick and candidateAge <= 90 and candidateBar > nz(protectedBar, -1) and distFromProtected > 0 and distToExternal > 0 and not na(legPosition) and legPosition > 0.10 and legPosition < 0.85
    valid

f_msSelectIdmCandidate(int bias, float protectedLevel, int protectedBar, float externalLevel, array<float> candidateVals, array<int> candidateBars, array<float> candidateAtr, array<int> candidateVolOk, array<float> oppositeVals, array<int> oppositeBars, int maxScanDepth) =>
    float selectedLevel = na
    int selectedBar = na
    float selectedScore = na
    float selectedAtr = na
    int selectedAge = na
    float legRange = bias == 1 ? externalLevel - protectedLevel : protectedLevel - externalLevel
    int candidateCount = array.size(candidateVals)
    if bias != 0 and legRange > syminfo.mintick and candidateCount > 0
        int startIdx = math.max(candidateCount - maxScanDepth, 0)
        for i = candidateCount - 1 to startIdx
            float candidateLevel = array.get(candidateVals, i)
            int candidateBar = array.get(candidateBars, i)
            int candidateAge = bar_index - candidateBar
            if candidateAge > 90
                break
            float candidateAtrVal = math.max(array.get(candidateAtr, i), syminfo.mintick)
            float distFromProtected = bias == 1 ? candidateLevel - protectedLevel : protectedLevel - candidateLevel
            float distToExternal = bias == 1 ? externalLevel - candidateLevel : candidateLevel - externalLevel
            float legPosition = distFromProtected / legRange
            bool insideLeg = candidateBar > nz(protectedBar, -1) and distFromProtected > 0 and distToExternal > 0
            bool spacingOk = distFromProtected >= candidateAtrVal * 0.45 and distToExternal >= candidateAtrVal * 0.35 and legPosition > 0.10 and legPosition < 0.85
            if insideLeg and spacingOk
                float prevOppLevel = f_msFindPriorPivotLevel(oppositeVals, oppositeBars, candidateBar, maxScanDepth)
                float retraceSize = bias == 1 ? prevOppLevel - candidateLevel : candidateLevel - prevOppLevel
                bool retraceOk = not na(retraceSize) and retraceSize >= math.max(candidateAtrVal * 0.35, legRange * 0.18)
                float impulseAway = bias == 1 ? externalLevel - candidateLevel : candidateLevel - externalLevel
                bool impulseOk = impulseAway >= candidateAtrVal * 1.0
                if retraceOk and impulseOk
                    bool bosConfirmed = bias == 1 ? (not na(prevOppLevel) and externalLevel > prevOppLevel + candidateAtrVal * 0.15) : (not na(prevOppLevel) and externalLevel < prevOppLevel - candidateAtrVal * 0.15)
                    float recencyScore = 25.0 * f_clamp(1.0 - float(candidateAge) / 90.0, 0.0, 1.0)
                    float departureScore = 25.0 * f_clamp(impulseAway / math.max(candidateAtrVal * 2.0, syminfo.mintick), 0.0, 1.0)
                    float retraceScore = 20.0 * f_clamp(retraceSize / math.max(math.max(candidateAtrVal * 0.70, legRange * 0.36), syminfo.mintick), 0.0, 1.0)
                    float positionScore = 15.0 * (1.0 - f_clamp(math.abs(legPosition - 0.5) / 0.5, 0.0, 1.0))
                    float spacingScore = 10.0 * f_clamp(math.min(distFromProtected, distToExternal) / (candidateAtrVal * 2.0), 0.0, 1.0)
                    float contextScore = array.get(candidateVolOk, i) == 1 ? 6.0 : 0.0
                    float bosScore = bosConfirmed ? 10.0 : 0.0
                    float candidateScore = recencyScore + departureScore + retraceScore + positionScore + spacingScore + contextScore + bosScore
                    if na(selectedScore) or candidateScore > selectedScore or (math.abs(candidateScore - selectedScore) < 0.001 and candidateBar > selectedBar)
                        selectedLevel := candidateLevel
                        selectedBar := candidateBar
                        selectedScore := candidateScore
                        selectedAtr := candidateAtrVal
                        selectedAge := candidateAge
    [selectedLevel, selectedBar, selectedScore, selectedAtr, selectedAge]

f_unifiedSweepGrade(float baseScore, bool reclaimOk, bool volumeOk, bool sessionOk, bool msConfirmed, string mode) =>
    string grade = "Invalid"
    if reclaimOk and baseScore >= 50.0
        bool aGrade = baseScore >= 74.0 and volumeOk and sessionOk and (mode == "Aggressive" ? true : msConfirmed)
        bool bGrade = baseScore >= 62.0 and (mode == "Conservative" ? msConfirmed : true)
        grade := aGrade ? "A" : bGrade ? "B" : "C"
    grade

f_unifiedSweepNarrative(string side, string grade, bool msConfirmed, bool msConflict) =>
    string dir = side == "BSL" ? "Bearish" : "Bullish"
    grade == "Invalid" ? "Waiting for reclaim" :
     msConfirmed ? dir + " sweep validated (Grade " + grade + ")" :
     msConflict ? dir + " sweep valid but broader structure disagrees" :
     dir + " sweep valid; broader structure still pending"

f_resetWaitState() =>
    [false, int(na), int(na), float(na), float(na), float(na), false, false, false, "", float(na)]

f_resetStructureRefs() =>
    [float(na), int(na), float(na), int(na), false, false, false]

f_startWaitState(float level, float tol, float baseScore, bool volumeOk, bool sessionOk, bool reclaimOk, string poolLabel, float stopAnchor) =>
    [true, bar_index, time, level, tol, baseScore, volumeOk, sessionOk, reclaimOk, poolLabel, stopAnchor]

f_resetWaitAdvanced() =>
    ["", int(na), ""]

f_startWaitAdvanced(string tier, int timeoutBars) =>
    [tier, timeoutBars, ""]

// --- SMC & SD Stats ---
