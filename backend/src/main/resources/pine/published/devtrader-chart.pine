f_hideLine(line l) =>
    line.set_xy1(l, na, na)
    line.set_xy2(l, na, na)
    line.set_color(l, na)
    true

f_trackHistoricalLine(line l) =>
    if not na(l)
        array.push(historicalEventLines, l)
        while array.size(historicalEventLines) > historicalEventRetention
            line stale = array.shift(historicalEventLines)
            line.delete(stale)
    l

f_trackHistoricalLabel(label lb) =>
    if not na(lb)
        array.push(historicalEventLabels, lb)
        while array.size(historicalEventLabels) > historicalEventRetention
            label stale = array.shift(historicalEventLabels)
            label.delete(stale)
    lb

f_pushStructurePivot(array<float> priceArr, array<int> barArr, float pivotPrice, int pivotBar, int maxItems) =>
    if not na(pivotPrice) and not na(pivotBar)
        int arrSize = array.size(barArr)
        bool isDuplicate = arrSize > 0 and array.get(barArr, arrSize - 1) == pivotBar
        if not isDuplicate
            array.push(priceArr, pivotPrice)
            array.push(barArr, pivotBar)
            while array.size(priceArr) > maxItems
                array.shift(priceArr)
                array.shift(barArr)
    true

f_getLatestPivotBefore(array<float> priceArr, array<int> barArr, int refBar) =>
    float foundPrice = na
    int foundBar = na
    if not na(refBar) and array.size(barArr) > 0
        for i = array.size(barArr) - 1 to 0
            int pivotBar = array.get(barArr, i)
            if pivotBar <= refBar
                foundPrice := array.get(priceArr, i)
                foundBar := pivotBar
                break
    [foundPrice, foundBar]

f_structureBaseStatus(int trend) =>
    trend == 1 ? "Bullish (Protected)" : trend == -1 ? "Bearish (Protected)" : "Neutral"

f_modeProfile(string mode) =>
    int timeoutBars = sweepMssTimeoutBars
    if mode == "Aggressive"
        timeoutBars := math.max(timeoutBars, 24)
    else if mode == "Conservative"
        timeoutBars := math.min(timeoutBars, 12)
    timeoutBars

f_modeTierTimeout(string mode, string tier) =>
    tier == "MAJOR" ? (mode == "Aggressive" ? 24 : mode == "Conservative" ? 12 : 18) :
     tier == "MINOR" ? (mode == "Aggressive" ? 12 : mode == "Conservative" ? 0 : 8) :
     (mode == "Aggressive" ? 24 : mode == "Conservative" ? 12 : 18)

f_modeRejectionGraceBars(string mode) =>
    mode == "Aggressive" ? 1 : mode == "Conservative" ? 3 : 2

f_modeRankFloor(string mode) =>
    mode == "Aggressive" ? 30.0 : mode == "Conservative" ? 60.0 : 45.0

f_modeSweepAlignmentAtr(string mode) =>
    mode == "Aggressive" ? 1.00 : mode == "Conservative" ? 0.45 : 0.65

f_isMajorSweepLocation(liq_pool pool) =>
    pool.baseType == "HTF" or pool.baseType == "PERIOD" or pool.baseType == "SESSION" or f_liqPoolIsExternal(pool)

f_resolveWaitStopAnchor(string side, float sweepLevel, float sweepExtreme) =>
    float atrFallback = math.max(nz(atrVal, syminfo.mintick * 20), syminfo.mintick * 10)
    float candleExtreme = side == "BSL" ? high : low
    float levelFallback = side == "BSL" ? nz(sweepLevel, high) + atrFallback * 0.5 : nz(sweepLevel, low) - atrFallback * 0.5
    not na(sweepExtreme) ? sweepExtreme : not na(candleExtreme) ? candleExtreme : levelFallback

// Repaint-safe pivot usage: only pivots with `swingLen` bars confirmed after the pivot bar are eligible.
f_isConfirmedPivot(int pivotBar) =>
    not na(pivotBar) and (bar_index - pivotBar) > swingLen

// Repaint-safe pivot usage: the helper only scans confirmed bullets already stored in the pivot arrays.
f_findNearestConfirmedPivot(array<float> minorPrices, array<int> minorBars, array<float> majorPrices, array<int> majorBars, float refPrice) =>
    float foundPrice = na
    int foundBar = na
    string foundTier = ""
    float bestDist = 10e10
    if not na(refPrice)
        if array.size(minorBars) > 0
            for i = array.size(minorBars) - 1 to 0
                int pivotBar = array.get(minorBars, i)
                float pivotPrice = array.get(minorPrices, i)
                if f_isConfirmedPivot(pivotBar)
                    float dist = math.abs(pivotPrice - refPrice)
                    if dist < bestDist
                        bestDist := dist
                        foundPrice := pivotPrice
                        foundBar := pivotBar
                        foundTier := "MINOR"
        if array.size(majorBars) > 0
            for i = array.size(majorBars) - 1 to 0
                int pivotBar = array.get(majorBars, i)
                float pivotPrice = array.get(majorPrices, i)
                if f_isConfirmedPivot(pivotBar)
                    float dist = math.abs(pivotPrice - refPrice)
                    if dist < bestDist
                        bestDist := dist
                        foundPrice := pivotPrice
                        foundBar := pivotBar
                        foundTier := "MAJOR"
    [foundPrice, foundBar, foundTier]

f_dealingRangeQualified(bool isBullSetup, string mode) =>
    if mode == "Aggressive"
        true
    else
        bool rangeReady = not na(majSwh) and not na(majSwl) and majSwh > majSwl
        if rangeReady
            float dealingMid = (majSwh + majSwl) * 0.5
            isBullSetup ? close <= dealingMid : close >= dealingMid
        else
            true

f_qualifySweep(liq_pool pool, string side, float sweepPrice, bool rejectionOk, bool displacementOk, bool sessionOk) =>
    bool isBullSetup = side == "SSL"
    float nearestPivot = na
    int nearestPivotBar = na
    string nearestPivotTier = ""
    if side == "BSL"
        [nearestPivot, nearestPivotBar, nearestPivotTier] = f_findNearestConfirmedPivot(minorHighPivotPrices, minorHighPivotBars, majorHighPivotPrices, majorHighPivotBars, sweepPrice)
    else
        [nearestPivot, nearestPivotBar, nearestPivotTier] = f_findNearestConfirmedPivot(minorLowPivotPrices, minorLowPivotBars, majorLowPivotPrices, majorLowPivotBars, sweepPrice)
    float atrRef = math.max(nz(atrVal, syminfo.mintick * 20), syminfo.mintick * 10)
    float swingTol = math.max(f_liqTouchTolerance(sweepPrice) * 1.5, atrRef * f_modeSweepAlignmentAtr(msConfirmationMode))
    float latestMinorSwing = side == "BSL" ? lSwh : lSwl
    float latestMajorSwing = side == "BSL" ? majSwh : majSwl
    bool directSwingPool = pool.baseType == "SWING"
    bool pivotAligned = not na(nearestPivot) and math.abs(sweepPrice - nearestPivot) <= swingTol
    bool latestMinorAligned = not na(latestMinorSwing) and math.abs(sweepPrice - latestMinorSwing) <= swingTol
    bool latestMajorAligned = not na(latestMajorSwing) and math.abs(sweepPrice - latestMajorSwing) <= swingTol * 1.2
    bool swingRelevant = directSwingPool or pivotAligned or latestMinorAligned or latestMajorAligned
    bool external = f_liqPoolIsExternal(pool)
    float importance = f_liqImportanceScore(pool, close, htfCompositeBias, ms_structureBias, ms_idmLevel, ms_idmState)
    float actionability = f_liqActionabilityScore(pool, close, htfCompositeBias, ms_structureBias, ms_idmLevel, ms_idmState)
    float clusterStrength = f_liqClusterStrength(pool)
    float rankFloor = f_modeRankFloor(msConfirmationMode)
    bool freshnessOk = not pool.isSwept and pool.state != "CONSUMED"
    bool majorRankOk = pool.structuralRank >= rankFloor or importance >= 66.0
    bool minorRankOk = pool.structuralRank >= (msConfirmationMode == "Aggressive" ? 20.0 : msConfirmationMode == "Conservative" ? rankFloor : 30.0) or actionability >= 58.0
    bool locationMajor = f_isMajorSweepLocation(pool)
    bool insideKillzone = inLondonSweepWindow or inNYSweepWindow
    bool dealingRangeOk = f_dealingRangeQualified(isBullSetup, msConfirmationMode)
    bool highStructuralRank = pool.structuralRank >= math.max(rankFloor, 60.0) or clusterStrength >= 64.0
    bool majorQualified = swingRelevant and external and rejectionOk and freshnessOk and majorRankOk and actionability >= 60.0 and (insideKillzone or displacementOk or sessionOk) and locationMajor and dealingRangeOk
    bool minorQualifiedBase = swingRelevant and rejectionOk and freshnessOk and minorRankOk and dealingRangeOk and (external or highStructuralRank or directSwingPool or importance >= 60.0)
    bool internalAllowed = external or msConfirmationMode == "Aggressive"
    bool minorQualified = internalAllowed and minorQualifiedBase
    if msConfirmationMode == "Balanced"
        minorQualified := minorQualified and displacementOk
    else if msConfirmationMode == "Conservative"
        minorQualified := false
    [majorQualified ? "MAJOR" : minorQualified ? "MINOR" : "NOISE", nearestPivot, nearestPivotBar, nearestPivotTier]

f_evalRejectionTier(string side, float sweepLevel, float stopAnchor, int waitStartBar, bool initialReclaimOk, string priorTier) =>
    string tier = priorTier
    if not na(sweepLevel) and not na(waitStartBar)
        int graceBars = f_modeRejectionGraceBars(msConfirmationMode)
        int ageBars = bar_index - waitStartBar
        float barRange = high - low
        float safeRange = barRange > 0 ? barRange : syminfo.mintick
        float body = math.abs(close - open)
        float upperWick = high - math.max(open, close)
        float lowerWick = math.min(open, close) - low
        float wickBodyRatio = side == "BSL" ? upperWick / math.max(body, syminfo.mintick) : lowerWick / math.max(body, syminfo.mintick)
        float reclaimDist = side == "BSL" ? sweepLevel - close : close - sweepLevel
        bool closeBackInside = side == "BSL" ? close < sweepLevel : close > sweepLevel
        bool closeOutside = side == "BSL" ? close > sweepLevel : close < sweepLevel
        bool strongReclaim = closeBackInside and reclaimDist >= reclaimLvl * safeRange and wickBodyRatio >= wickThresh
        bool partialReclaim = closeBackInside and reclaimDist >= math.max(reclaimLvl * safeRange * 0.35, syminfo.mintick) and wickBodyRatio >= wickThresh * 0.55
        bool newExtremeWithoutReclaim = side == "BSL" ? high > nz(stopAnchor, sweepLevel) and close >= sweepLevel : low < nz(stopAnchor, sweepLevel) and close <= sweepLevel
        if tier == "CONFIRMED"
            tier := "CONFIRMED"
        else if strongReclaim or (initialReclaimOk and ageBars <= graceBars)
            tier := "CONFIRMED"
        else if partialReclaim and ageBars <= graceBars
            tier := "WEAK"
        else if (closeOutside and ageBars > graceBars) or (newExtremeWithoutReclaim and ageBars >= graceBars)
            tier := "FAILED"
        else if ageBars <= graceBars
            tier := partialReclaim ? "WEAK" : tier
        else if tier == ""
            tier := "FAILED"
    tier

int modeSweepTimeoutBars = f_modeProfile(msConfirmationMode)

f_resolveBearStructureRefs(int narrativeRefBar, int sweepBar, float protectedLowRef, int protectedLowRefBar) =>
    int primaryBar = na(narrativeRefBar) ? sweepBar : narrativeRefBar
    int fallbackBar = na(sweepBar) ? primaryBar : sweepBar
    [minorRef, minorRefBar] = f_getLatestPivotBefore(minorLowPivotPrices, minorLowPivotBars, primaryBar)
    if na(minorRef)
        [minorRef, minorRefBar] = f_getLatestPivotBefore(minorLowPivotPrices, minorLowPivotBars, fallbackBar)
    [majorRef, majorRefBar] = f_getLatestPivotBefore(majorLowPivotPrices, majorLowPivotBars, primaryBar)
    if na(majorRef)
        [majorRef, majorRefBar] = f_getLatestPivotBefore(majorLowPivotPrices, majorLowPivotBars, fallbackBar)
    int protectedLimitBar = math.max(primaryBar, fallbackBar)
    if not na(protectedLowRef) and not na(protectedLowRefBar) and protectedLowRefBar <= protectedLimitBar
        if na(majorRefBar) or protectedLowRefBar >= majorRefBar
            majorRef := protectedLowRef
            majorRefBar := protectedLowRefBar
    [minorRef, minorRefBar, majorRef, majorRefBar]

f_resolveBullStructureRefs(int narrativeRefBar, int sweepBar, float protectedHighRef, int protectedHighRefBar) =>
    int primaryBar = na(narrativeRefBar) ? sweepBar : narrativeRefBar
    int fallbackBar = na(sweepBar) ? primaryBar : sweepBar
    [minorRef, minorRefBar] = f_getLatestPivotBefore(minorHighPivotPrices, minorHighPivotBars, primaryBar)
    if na(minorRef)
        [minorRef, minorRefBar] = f_getLatestPivotBefore(minorHighPivotPrices, minorHighPivotBars, fallbackBar)
    [majorRef, majorRefBar] = f_getLatestPivotBefore(majorHighPivotPrices, majorHighPivotBars, primaryBar)
    if na(majorRef)
        [majorRef, majorRefBar] = f_getLatestPivotBefore(majorHighPivotPrices, majorHighPivotBars, fallbackBar)
    int protectedLimitBar = math.max(primaryBar, fallbackBar)
    if not na(protectedHighRef) and not na(protectedHighRefBar) and protectedHighRefBar <= protectedLimitBar
        if na(majorRefBar) or protectedHighRefBar >= majorRefBar
            majorRef := protectedHighRef
            majorRefBar := protectedHighRefBar
    [minorRef, minorRefBar, majorRef, majorRefBar]

avgBody = ta.sma(math.abs(close - open), 20)
disp    = math.abs(close - open) > (avgBody * dispMult)

swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)
majH = ta.pivothigh(high, swingLen * 3, swingLen * 3)
majL = ta.pivotlow(low, swingLen * 3, swingLen * 3)

if not na(swH)
    lSwh := swH
    lSwhBar := bar_index - swingLen
    f_pushStructurePivot(minorHighPivotPrices, minorHighPivotBars, lSwh, lSwhBar, 80)
if not na(swL)
    lSwl := swL
    lSwlBar := bar_index - swingLen
    f_pushStructurePivot(minorLowPivotPrices, minorLowPivotBars, lSwl, lSwlBar, 80)
if not na(majH)
    majSwh := majH
    majSwhBar := bar_index - swingLen * 3
    f_pushStructurePivot(majorHighPivotPrices, majorHighPivotBars, majSwh, majSwhBar, 50)
    protectedHigh := majSwh
    protectedHighBar := majSwhBar
    if not na(majSwl) and majSwlBar < majSwhBar
        protectedLow := majSwl
        protectedLowBar := majSwlBar
if not na(majL)
    majSwl := majL
    majSwlBar := bar_index - swingLen * 3
    f_pushStructurePivot(majorLowPivotPrices, majorLowPivotBars, majSwl, majSwlBar, 50)
    protectedLow := majSwl
    protectedLowBar := majSwlBar
    if not na(majSwh) and majSwhBar < majSwlBar
        protectedHigh := majSwh
        protectedHighBar := majSwhBar

// --- Unified Market-Structure Module ---
[msMajorSwingHigh, msMajorSwingHighBar, msMajorSwingLow, msMajorSwingLowBar] = f_msMajorSwings()
[msInternalSwingHigh, msInternalSwingHighBar, msInternalSwingLow, msInternalSwingLowBar] = f_msInternalSwings()

float msInternalRangeBase = ta.sma(high - low, 20)
float msBullChochLevel = ms_lastSwingHigh
int msBullChochBar = ms_lastSwingHighBar
float msBearChochLevel = ms_lastSwingLow
int msBearChochBar = ms_lastSwingLowBar

if not na(msMajorSwingHigh)
    ms_lastSwingHigh := msMajorSwingHigh
    ms_lastSwingHighBar := msMajorSwingHighBar
    ms_topCrossed := false
if not na(msMajorSwingLow)
    ms_lastSwingLow := msMajorSwingLow
    ms_lastSwingLowBar := msMajorSwingLowBar
    ms_btmCrossed := false

if not na(msInternalSwingHigh)
    ms_lastInternalHigh := msInternalSwingHigh
    ms_lastInternalHighBar := msInternalSwingHighBar
    float msHighPivotAtr = math.max(nz(atrVal[msInternalSwingLen], atrVal), syminfo.mintick)
    float msHighPivotRange = nz(high[msInternalSwingLen] - low[msInternalSwingLen], high - low)
    float msHighRangeBase = math.max(nz(msInternalRangeBase[msInternalSwingLen], msHighPivotRange), syminfo.mintick)
    bool msHighVolOk = msHighPivotRange >= msHighRangeBase * 1.15
    float msPrevInternalLow = f_msFindPriorPivotLevel(ms_internalLowVals, ms_internalLowBars, msInternalSwingHighBar, msIdmMaxScanDepth)
    float msHighRetrace = not na(msPrevInternalLow) ? msInternalSwingHigh - msPrevInternalLow : na
    bool msHighDistinct = array.size(ms_internalHighBars) == 0 or msInternalSwingHighBar > array.get(ms_internalHighBars, array.size(ms_internalHighBars) - 1)
    bool msHighMeaningful = (na(msHighRetrace) or msHighRetrace >= msHighPivotAtr * 0.35) and msHighDistinct
    if msHighMeaningful
        f_msPushInternalPivot(ms_internalHighVals, ms_internalHighBars, ms_internalHighAtr, ms_internalHighVolOk, msInternalSwingHigh, msInternalSwingHighBar, msHighPivotAtr, msHighVolOk, 40)
        ms_idmCacheDirty := true
if not na(msInternalSwingLow)
    ms_lastInternalLow := msInternalSwingLow
    ms_lastInternalLowBar := msInternalSwingLowBar
    float msLowPivotAtr = math.max(nz(atrVal[msInternalSwingLen], atrVal), syminfo.mintick)
    float msLowPivotRange = nz(high[msInternalSwingLen] - low[msInternalSwingLen], high - low)
    float msLowRangeBase = math.max(nz(msInternalRangeBase[msInternalSwingLen], msLowPivotRange), syminfo.mintick)
    bool msLowVolOk = msLowPivotRange >= msLowRangeBase * 1.15
    float msPrevInternalHigh = f_msFindPriorPivotLevel(ms_internalHighVals, ms_internalHighBars, msInternalSwingLowBar, msIdmMaxScanDepth)
    float msLowRetrace = not na(msPrevInternalHigh) ? msPrevInternalHigh - msInternalSwingLow : na
    bool msLowDistinct = array.size(ms_internalLowBars) == 0 or msInternalSwingLowBar > array.get(ms_internalLowBars, array.size(ms_internalLowBars) - 1)
    bool msLowMeaningful = (na(msLowRetrace) or msLowRetrace >= msLowPivotAtr * 0.35) and msLowDistinct
    if msLowMeaningful
        f_msPushInternalPivot(ms_internalLowVals, ms_internalLowBars, ms_internalLowAtr, ms_internalLowVolOk, msInternalSwingLow, msInternalSwingLowBar, msLowPivotAtr, msLowVolOk, 40)
        ms_idmCacheDirty := true

float msBreakTol = math.max(atrVal * 0.03, syminfo.mintick * 4)
float msIdmTouchTolerance = math.max(syminfo.mintick, atrVal * 0.02)
float msBosRange = high - low
float msBosSafeRange = msBosRange > 0 ? msBosRange : syminfo.mintick
float msBosBody = math.abs(close - open)
bool msBullBosImpulse = close > open and msBosBody > avgBody * msBosDisplacementMult and ((high - close) / msBosSafeRange) <= 0.35
bool msBearBosImpulse = close < open and msBosBody > avgBody * msBosDisplacementMult and ((close - low) / msBosSafeRange) <= 0.35
bool msBullConfluenceAligned = not htfShortStrong and (htfCompositeBias >= 0 or close >= dO)
bool msBearConfluenceAligned = not htfLongStrong and (htfCompositeBias <= 0 or close <= dO)
bool msStructureSpacingOk = na(ms_lastStructureEventBar) or (bar_index - ms_lastStructureEventBar) >= msMinStructureSpacingBars
bool ms_bullChochEvent = false
bool ms_bearChochEvent = false
bool ms_bullBosEvent = false
bool ms_bearBosEvent = false
string msBullChochLabel = "CHoCH"
string msBearChochLabel = "CHoCH"
string msBullBosLabel = "BOS"
string msBearBosLabel = "BOS"

bool msBullBreakCandidate = not na(ms_lastSwingHigh) and close > (ms_lastSwingHigh + msBreakTol) and not ms_topCrossed
bool msBearBreakCandidate = not na(ms_lastSwingLow) and close < (ms_lastSwingLow - msBreakTol) and not ms_btmCrossed
if msBullBreakCandidate
    ms_topCrossed := true
if msBearBreakCandidate
    ms_btmCrossed := true

bool msBullBiasChange = msStructureSpacingOk and msBullBreakCandidate and ms_structureBias != 1
bool msBearBiasChange = msStructureSpacingOk and msBearBreakCandidate and ms_structureBias != -1
ms_bullChochEvent := msBullBiasChange
ms_bearChochEvent := msBearBiasChange

if ms_bullChochEvent
    ms_structureBias := 1
    ms_btmCrossed := false
    ms_protectedLow := ms_lastSwingLow
    ms_protectedLowBar := ms_lastSwingLowBar
    ms_externalLow := ms_protectedLow
    ms_externalLowBar := ms_protectedLowBar
    ms_externalHigh := high
    ms_externalHighBar := bar_index
    ms_idmTaken := false
    ms_idmLevel := na
    ms_idmBar := na
    ms_idmScore := na
    ms_idmAtr := na
    ms_idmState := 4
    ms_idmStrong := false
    ms_idmPendingSweep := false
    ms_idmPendingBar := na
    ms_idmPendingExtreme := na
    ms_idmTakeTag := ""
    ms_idmCacheDirty := true
    msBullChochLabel := f_msEventLabel("CHoCH", msBullConfluenceAligned and msBullBosImpulse)
    ms_lastBullChochBar := bar_index
    ms_recentBullEventBar := bar_index
    ms_lastStructureEventBar := bar_index

if ms_bearChochEvent
    ms_structureBias := -1
    ms_topCrossed := false
    ms_protectedHigh := ms_lastSwingHigh
    ms_protectedHighBar := ms_lastSwingHighBar
    ms_externalHigh := ms_protectedHigh
    ms_externalHighBar := ms_protectedHighBar
    ms_externalLow := low
    ms_externalLowBar := bar_index
    ms_idmTaken := false
    ms_idmLevel := na
    ms_idmBar := na
    ms_idmScore := na
    ms_idmAtr := na
    ms_idmState := 4
    ms_idmStrong := false
    ms_idmPendingSweep := false
    ms_idmPendingBar := na
    ms_idmPendingExtreme := na
    ms_idmTakeTag := ""
    ms_idmCacheDirty := true
    msBearChochLabel := f_msEventLabel("CHoCH", msBearConfluenceAligned and msBearBosImpulse)
    ms_lastBearChochBar := bar_index
    ms_recentBearEventBar := bar_index
    ms_lastStructureEventBar := bar_index

bool ms_bullProtectedIntact = na(ms_protectedLow) or close >= (ms_protectedLow - msBreakTol)
bool ms_bearProtectedIntact = na(ms_protectedHigh) or close <= (ms_protectedHigh + msBreakTol)

// --- Candidate Refresh: Bounded IDM Selection ---
float msPrevIdmLevel = ms_idmLevel
int msPrevIdmBar = ms_idmBar
float msCurrentProtectedLevel = ms_structureBias == 1 ? ms_protectedLow : ms_structureBias == -1 ? ms_protectedHigh : na
int msCurrentProtectedBar = ms_structureBias == 1 ? ms_protectedLowBar : ms_structureBias == -1 ? ms_protectedHighBar : na
float msCurrentExternalLevel = ms_structureBias == 1 ? ms_externalHigh : ms_structureBias == -1 ? ms_externalLow : na
int msLatestBiasPivotBar = ms_structureBias == 1 ? f_msLatestInternalBar(ms_internalLowBars) : ms_structureBias == -1 ? f_msLatestInternalBar(ms_internalHighBars) : na
bool msProtectedChanged = msCurrentProtectedBar != ms_idmCacheProtectedBar or na(msCurrentProtectedLevel) != na(ms_idmCacheProtectedLevel) or (not na(msCurrentProtectedLevel) and not na(ms_idmCacheProtectedLevel) and math.abs(msCurrentProtectedLevel - ms_idmCacheProtectedLevel) > syminfo.mintick * 0.5)
bool msExternalChanged = na(msCurrentExternalLevel) != na(ms_idmCacheExternalLevel) or (not na(msCurrentExternalLevel) and not na(ms_idmCacheExternalLevel) and math.abs(msCurrentExternalLevel - ms_idmCacheExternalLevel) >= math.max(atrVal * 0.35, syminfo.mintick * 8))
bool msIdmCandidateValid = f_msIdmCandidateStillValid(ms_structureBias, ms_idmLevel, ms_idmBar, msCurrentProtectedLevel, msCurrentProtectedBar, msCurrentExternalLevel)
bool msHadCachedIdm = not na(ms_idmLevel) and not na(ms_idmBar)
bool msIdmRefreshNeeded = not ms_idmTaken and ms_structureBias != 0 and (ms_idmCacheDirty or (msHadCachedIdm and not msIdmCandidateValid) or ms_structureBias != ms_idmCacheBias or msProtectedChanged or msExternalChanged or msLatestBiasPivotBar != ms_idmCachePivotBar)
if msIdmRefreshNeeded
    float msSelectedLevel = na
    int msSelectedBar = na
    float msSelectedScore = na
    float msSelectedAtr = na
    int msSelectedAge = na
    if ms_structureBias == 1 and ms_bullProtectedIntact and not na(ms_protectedLow) and not na(ms_externalHigh)
        [msSelectedLevel, msSelectedBar, msSelectedScore, msSelectedAtr, msSelectedAge] = f_msSelectIdmCandidate(1, ms_protectedLow, ms_protectedLowBar, ms_externalHigh, ms_internalLowVals, ms_internalLowBars, ms_internalLowAtr, ms_internalLowVolOk, ms_internalHighVals, ms_internalHighBars, msIdmMaxScanDepth)
    else if ms_structureBias == -1 and ms_bearProtectedIntact and not na(ms_protectedHigh) and not na(ms_externalLow)
        [msSelectedLevel, msSelectedBar, msSelectedScore, msSelectedAtr, msSelectedAge] = f_msSelectIdmCandidate(-1, ms_protectedHigh, ms_protectedHighBar, ms_externalLow, ms_internalHighVals, ms_internalHighBars, ms_internalHighAtr, ms_internalHighVolOk, ms_internalLowVals, ms_internalLowBars, msIdmMaxScanDepth)
    if not na(msSelectedLevel)
        ms_idmLevel := msSelectedLevel
        ms_idmBar := msSelectedBar
        ms_idmScore := msSelectedScore
        ms_idmAtr := msSelectedAtr
        float msAdvanceAtr = ms_structureBias == 1 ? (ms_externalHigh - msSelectedLevel) / math.max(msSelectedAtr, syminfo.mintick) : (msSelectedLevel - ms_externalLow) / math.max(msSelectedAtr, syminfo.mintick)
        bool msIdmStale = msSelectedAge > 35 or msAdvanceAtr > 3.0
        ms_idmState := msIdmStale ? 2 : 1
        ms_idmStrong := msSelectedScore >= 68.0 and not msIdmStale
    else
        ms_idmLevel := na
        ms_idmBar := na
        ms_idmScore := na
        ms_idmAtr := na
        ms_idmState := 4
        ms_idmStrong := false
    ms_idmCacheDirty := false
    ms_idmCacheBias := ms_structureBias
    ms_idmCacheProtectedLevel := msCurrentProtectedLevel
    ms_idmCacheProtectedBar := msCurrentProtectedBar
    ms_idmCacheExternalLevel := msCurrentExternalLevel
    ms_idmCachePivotBar := msLatestBiasPivotBar
    bool msIdmChanged = ms_idmBar != msPrevIdmBar or na(ms_idmLevel) != na(msPrevIdmLevel) or (not na(ms_idmLevel) and not na(msPrevIdmLevel) and math.abs(ms_idmLevel - msPrevIdmLevel) > syminfo.mintick * 0.5)
    if msIdmChanged
        ms_idmPendingSweep := false
        ms_idmPendingBar := na
        ms_idmPendingExtreme := na
        ms_idmTakeTag := ""
else if not ms_idmTaken and not na(ms_idmLevel)
    float msAdvanceAtr = ms_structureBias == 1 ? (ms_externalHigh - ms_idmLevel) / math.max(nz(ms_idmAtr, atrVal), syminfo.mintick) : (ms_idmLevel - ms_externalLow) / math.max(nz(ms_idmAtr, atrVal), syminfo.mintick)
    bool msIdmStale = (bar_index - ms_idmBar) > 35 or msAdvanceAtr > 3.0
    ms_idmState := msIdmStale ? 2 : 1
    ms_idmStrong := nz(ms_idmScore, 0.0) >= 68.0 and not msIdmStale
else if ms_idmTaken
    ms_idmState := 3

bool ms_idmTakeEvent = false
string ms_idmTakeEventLabel = ""
if not ms_idmTaken and not na(ms_idmLevel)
    if ms_structureBias == 1
        bool bullWickSweep = low < ms_idmLevel - msIdmTouchTolerance
        bool bullCloseThrough = close < ms_idmLevel - msIdmTouchTolerance
        bool bullReclaim = close > ms_idmLevel + msIdmTouchTolerance
        if msIdmTakeMode == "wick"
            if bullWickSweep
                ms_idmTakeEvent := true
                ms_idmTakeEventLabel := "IDM Sweep"
        else if msIdmTakeMode == "close"
            if bullCloseThrough
                ms_idmTakeEvent := true
                ms_idmTakeEventLabel := "IDM Close"
        else
            if bullWickSweep
                ms_idmPendingSweep := true
                ms_idmPendingBar := bar_index
                ms_idmPendingExtreme := na(ms_idmPendingExtreme) ? low : math.min(ms_idmPendingExtreme, low)
            if ms_idmPendingSweep and bullReclaim
                ms_idmTakeEvent := true
                ms_idmTakeEventLabel := "IDM Reclaim"
            else if ms_idmPendingSweep and bar_index - ms_idmPendingBar > msIdmReclaimBars
                ms_idmPendingSweep := false
                ms_idmPendingBar := na
                ms_idmPendingExtreme := na
    else if ms_structureBias == -1
        bool bearWickSweep = high > ms_idmLevel + msIdmTouchTolerance
        bool bearCloseThrough = close > ms_idmLevel + msIdmTouchTolerance
        bool bearReclaim = close < ms_idmLevel - msIdmTouchTolerance
        if msIdmTakeMode == "wick"
            if bearWickSweep
                ms_idmTakeEvent := true
                ms_idmTakeEventLabel := "IDM Sweep"
        else if msIdmTakeMode == "close"
            if bearCloseThrough
                ms_idmTakeEvent := true
                ms_idmTakeEventLabel := "IDM Close"
        else
            if bearWickSweep
                ms_idmPendingSweep := true
                ms_idmPendingBar := bar_index
                ms_idmPendingExtreme := na(ms_idmPendingExtreme) ? high : math.max(ms_idmPendingExtreme, high)
            if ms_idmPendingSweep and bearReclaim
                ms_idmTakeEvent := true
                ms_idmTakeEventLabel := "IDM Reclaim"
            else if ms_idmPendingSweep and bar_index - ms_idmPendingBar > msIdmReclaimBars
                ms_idmPendingSweep := false
                ms_idmPendingBar := na
                ms_idmPendingExtreme := na

if ms_idmTakeEvent
    ms_idmTaken := true
    ms_idmState := 3
    ms_idmTakeTag := ms_idmTakeEventLabel
    ms_idmPendingSweep := false
    ms_idmPendingBar := na
    ms_idmPendingExtreme := na
    if showMsIdm
        color msIdmEventColor = f_structureLineColor("IDM", ms_structureBias)
        f_trackHistoricalLine(line.new(ms_idmBar, ms_idmLevel, bar_index, ms_idmLevel, color=msIdmEventColor, style=line.style_dotted, width=1))
        f_trackHistoricalLabel(label.new(bar_index, ms_idmLevel, ms_idmTakeEventLabel, color=f_structureLabelBg("IDM", ms_structureBias), style=ms_structureBias == 1 ? label.style_label_up : label.style_label_down, textcolor=f_themeTextColor(), size=size.tiny))

float msBosHighRef = ms_externalHigh
float msBosLowRef = ms_externalLow
int msBosHighRefBar = ms_externalHighBar
int msBosLowRefBar = ms_externalLowBar
bool ms_bullBosPullbackReady = not msBosRequiresInternalPullback or ms_idmTaken or (not na(ms_idmBar) and ms_idmBar > nz(ms_lastStructureEventBar, -1))
bool ms_bearBosPullbackReady = not msBosRequiresInternalPullback or ms_idmTaken or (not na(ms_idmBar) and ms_idmBar > nz(ms_lastStructureEventBar, -1))

if msStructureSpacingOk and ms_structureBias == 1 and not ms_bullChochEvent and ms_idmTaken and ms_bullBosPullbackReady and not na(msBosHighRef) and not na(msBosHighRefBar) and (bar_index - msBosHighRefBar) >= msBosMinRefAgeBars and close > (msBosHighRef + msBreakTol) and ms_bullProtectedIntact and msBullBosImpulse
    ms_bullBosEvent := true
    msBullBosLabel := f_msEventLabel("BOS", msBullConfluenceAligned and ms_idmStrong)
    ms_protectedLow := ms_idmLevel
    ms_protectedLowBar := ms_idmBar
    ms_externalLow := ms_protectedLow
    ms_externalLowBar := ms_protectedLowBar
    ms_lastBullBosBar := bar_index
    ms_recentBullEventBar := bar_index
    ms_lastStructureEventBar := bar_index
    ms_idmTaken := false
    ms_idmLevel := na
    ms_idmBar := na
    ms_idmScore := na
    ms_idmAtr := na
    ms_idmState := 4
    ms_idmStrong := false
    ms_idmTakeTag := ""
    ms_idmCacheDirty := true

if msStructureSpacingOk and ms_structureBias == -1 and not ms_bearChochEvent and ms_idmTaken and ms_bearBosPullbackReady and not na(msBosLowRef) and not na(msBosLowRefBar) and (bar_index - msBosLowRefBar) >= msBosMinRefAgeBars and close < (msBosLowRef - msBreakTol) and ms_bearProtectedIntact and msBearBosImpulse
    ms_bearBosEvent := true
    msBearBosLabel := f_msEventLabel("BOS", msBearConfluenceAligned and ms_idmStrong)
    ms_protectedHigh := ms_idmLevel
    ms_protectedHighBar := ms_idmBar
    ms_externalHigh := ms_protectedHigh
    ms_externalHighBar := ms_protectedHighBar
    ms_lastBearBosBar := bar_index
    ms_recentBearEventBar := bar_index
    ms_lastStructureEventBar := bar_index
    ms_idmTaken := false
    ms_idmLevel := na
    ms_idmBar := na
    ms_idmScore := na
    ms_idmAtr := na
    ms_idmState := 4
    ms_idmStrong := false
    ms_idmTakeTag := ""
    ms_idmCacheDirty := true

if ms_structureBias == 1
    float nextMsHigh = na(ms_externalHigh) ? high : math.max(ms_externalHigh, high)
    bool refreshedMsHigh = na(ms_externalHigh) or nextMsHigh > ms_externalHigh
    ms_externalHigh := nextMsHigh
    ms_externalHighBar := refreshedMsHigh ? bar_index : ms_externalHighBar
    ms_externalLow := ms_protectedLow
    ms_externalLowBar := ms_protectedLowBar
else if ms_structureBias == -1
    float nextMsLow = na(ms_externalLow) ? low : math.min(ms_externalLow, low)
    bool refreshedMsLow = na(ms_externalLow) or nextMsLow < ms_externalLow
    ms_externalLow := nextMsLow
    ms_externalLowBar := refreshedMsLow ? bar_index : ms_externalLowBar
    ms_externalHigh := ms_protectedHigh
    ms_externalHighBar := ms_protectedHighBar

if showMsChochBos
    if ms_bullChochEvent
        if showHistoricalStructureLines
            f_trackHistoricalLine(line.new(msBullChochBar, msBullChochLevel, bar_index, msBullChochLevel, color=f_structureLineColor("CHOCH", 1), style=line.style_dashed, width=2))
            f_trackHistoricalLabel(label.new(int(math.avg(bar_index, msBullChochBar)), msBullChochLevel, msBullChochLabel, color=f_structureLabelBg("CHOCH", 1), style=label.style_label_down, textcolor=f_themeTextColor(), size=size.tiny))
        else
            f_trackHistoricalLabel(label.new(bar_index, msBullChochLevel, msBullChochLabel, color=f_structureLabelBg("CHOCH", 1), style=label.style_label_down, textcolor=f_themeTextColor(), size=size.tiny))
    if ms_bearChochEvent
        if showHistoricalStructureLines
            f_trackHistoricalLine(line.new(msBearChochBar, msBearChochLevel, bar_index, msBearChochLevel, color=f_structureLineColor("CHOCH", -1), style=line.style_dashed, width=2))
            f_trackHistoricalLabel(label.new(int(math.avg(bar_index, msBearChochBar)), msBearChochLevel, msBearChochLabel, color=f_structureLabelBg("CHOCH", -1), style=label.style_label_up, textcolor=f_themeTextColor(), size=size.tiny))
        else
            f_trackHistoricalLabel(label.new(bar_index, msBearChochLevel, msBearChochLabel, color=f_structureLabelBg("CHOCH", -1), style=label.style_label_up, textcolor=f_themeTextColor(), size=size.tiny))
    if ms_bullBosEvent
        if showHistoricalStructureLines
            f_trackHistoricalLine(line.new(msBosHighRefBar, msBosHighRef, bar_index, msBosHighRef, color=f_structureLineColor("BOS", 1), width=2))
            f_trackHistoricalLabel(label.new(int(math.avg(bar_index, msBosHighRefBar)), msBosHighRef, msBullBosLabel, color=f_structureLabelBg("BOS", 1), style=label.style_label_down, textcolor=f_themeTextColor(), size=size.tiny))
        else
            f_trackHistoricalLabel(label.new(bar_index, msBosHighRef, msBullBosLabel, color=f_structureLabelBg("BOS", 1), style=label.style_label_down, textcolor=f_themeTextColor(), size=size.tiny))
    if ms_bearBosEvent
        if showHistoricalStructureLines
            f_trackHistoricalLine(line.new(msBosLowRefBar, msBosLowRef, bar_index, msBosLowRef, color=f_structureLineColor("BOS", -1), width=2))
            f_trackHistoricalLabel(label.new(int(math.avg(bar_index, msBosLowRefBar)), msBosLowRef, msBearBosLabel, color=f_structureLabelBg("BOS", -1), style=label.style_label_up, textcolor=f_themeTextColor(), size=size.tiny))
        else
            f_trackHistoricalLabel(label.new(bar_index, msBosLowRef, msBearBosLabel, color=f_structureLabelBg("BOS", -1), style=label.style_label_up, textcolor=f_themeTextColor(), size=size.tiny))

if barstate.islast
    if showMsChochBos and ms_structureBias == 1
        if not na(ms_lastSwingLow)
            [bullChochLeft, bullChochRight] = f_levelLineCoords(ms_lastSwingLowBar, ms_lastSwingLow, levelRenderMode, rightSideLevelOffset, rightSideLevelLength, compactLevelMaxLength)
            int bullChochLabelX = levelRenderMode == "Full" ? bar_index + 10 : bullChochRight
            line.set_xy1(ms_extChoch, bullChochLeft, ms_lastSwingLow)
            line.set_xy2(ms_extChoch, bullChochRight, ms_lastSwingLow)
            line.set_color(ms_extChoch, color.new(f_structureLineColor("CHOCH", 1), fadePassiveLevels ? 38 : 14))
            line.set_width(ms_extChoch, levelRenderMode == "Full" ? 2 : 1)
            string bullChochText = levelCompactLabels ? f_compactLevelText("CHoCH", ms_lastSwingLow) : "CHoCH"
            f_registerRightLabel(ms_lastSwingLow, bullChochLabelX, bullChochText, 2)
        else
            f_hideLine(ms_extChoch)
        if not na(msBosHighRef)
            [bullBosLeft, bullBosRight] = f_levelLineCoords(msBosHighRefBar, msBosHighRef, levelRenderMode, rightSideLevelOffset, rightSideLevelLength, compactLevelMaxLength)
            int bullBosLabelX = levelRenderMode == "Full" ? bar_index + 10 : bullBosRight
            line.set_xy1(ms_extBos, bullBosLeft, msBosHighRef)
            line.set_xy2(ms_extBos, bullBosRight, msBosHighRef)
            line.set_color(ms_extBos, color.new(f_structureLineColor("BOS", 1), fadePassiveLevels ? 24 : 0))
            line.set_width(ms_extBos, 2)
            string bullBosText = levelCompactLabels ? f_compactLevelText("BOS", msBosHighRef) : "BOS"
            f_registerRightLabel(msBosHighRef, bullBosLabelX, bullBosText, 2)
        else
            f_hideLine(ms_extBos)
    else if showMsChochBos and ms_structureBias == -1
        if not na(ms_lastSwingHigh)
            [bearChochLeft, bearChochRight] = f_levelLineCoords(ms_lastSwingHighBar, ms_lastSwingHigh, levelRenderMode, rightSideLevelOffset, rightSideLevelLength, compactLevelMaxLength)
            int bearChochLabelX = levelRenderMode == "Full" ? bar_index + 10 : bearChochRight
            line.set_xy1(ms_extChoch, bearChochLeft, ms_lastSwingHigh)
            line.set_xy2(ms_extChoch, bearChochRight, ms_lastSwingHigh)
            line.set_color(ms_extChoch, color.new(f_structureLineColor("CHOCH", -1), fadePassiveLevels ? 38 : 14))
            line.set_width(ms_extChoch, levelRenderMode == "Full" ? 2 : 1)
            string bearChochText = levelCompactLabels ? f_compactLevelText("CHoCH", ms_lastSwingHigh) : "CHoCH"
            f_registerRightLabel(ms_lastSwingHigh, bearChochLabelX, bearChochText, 2)
        else
            f_hideLine(ms_extChoch)
        if not na(msBosLowRef)
            [bearBosLeft, bearBosRight] = f_levelLineCoords(msBosLowRefBar, msBosLowRef, levelRenderMode, rightSideLevelOffset, rightSideLevelLength, compactLevelMaxLength)
            int bearBosLabelX = levelRenderMode == "Full" ? bar_index + 10 : bearBosRight
            line.set_xy1(ms_extBos, bearBosLeft, msBosLowRef)
            line.set_xy2(ms_extBos, bearBosRight, msBosLowRef)
            line.set_color(ms_extBos, color.new(f_structureLineColor("BOS", -1), fadePassiveLevels ? 24 : 0))
            line.set_width(ms_extBos, 2)
            string bearBosText = levelCompactLabels ? f_compactLevelText("BOS", msBosLowRef) : "BOS"
            f_registerRightLabel(msBosLowRef, bearBosLabelX, bearBosText, 2)
        else
            f_hideLine(ms_extBos)
    else
        f_hideLine(ms_extChoch)
        f_hideLine(ms_extBos)

    float msActiveProtectedPrice = ms_structureBias == 1 ? ms_protectedLow : ms_structureBias == -1 ? ms_protectedHigh : na
    int msActiveProtectedBar = ms_structureBias == 1 ? ms_protectedLowBar : ms_structureBias == -1 ? ms_protectedHighBar : na
    if showMsProtectedLevels and not na(msActiveProtectedPrice) and not na(msActiveProtectedBar)
        [activeProtectedLeft, activeProtectedRight] = f_levelLineCoords(msActiveProtectedBar, msActiveProtectedPrice, levelRenderMode, rightSideLevelOffset, rightSideLevelLength, compactLevelMaxLength)
        int activeProtectedLabelX = levelRenderMode == "Full" ? bar_index + 12 : activeProtectedRight
        string activeProtectedText = ms_structureBias == 1 ? "Prot Low" : "Prot High"
        color activeProtectedColor = f_structureLineColor("PROTECTED", ms_structureBias)
        line.set_xy1(ms_activeProtected, activeProtectedLeft, msActiveProtectedPrice)
        line.set_xy2(ms_activeProtected, activeProtectedRight, msActiveProtectedPrice)
        line.set_color(ms_activeProtected, color.new(activeProtectedColor, fadePassiveLevels ? 16 : 0))
        line.set_width(ms_activeProtected, 2)
        line.set_style(ms_activeProtected, line.style_dashed)
        string activeProtectedLabel = levelCompactLabels ? f_compactLevelText(activeProtectedText, msActiveProtectedPrice) : activeProtectedText
        f_registerRightLabel(msActiveProtectedPrice, activeProtectedLabelX, activeProtectedLabel, 1)
    else
        f_hideLine(ms_activeProtected)

    if showMsIdm and not ms_idmTaken and not na(ms_idmLevel) and ms_idmState != 4
        color activeIdmColor = f_structureLineColor("IDM", ms_structureBias)
        string activeIdmText = ms_idmPendingSweep ? "IDM Swept" : ms_idmState == 2 ? "IDM Stale" : ms_idmStrong ? "IDM Strong" : "IDM"
        [activeIdmLeft, activeIdmRight] = f_levelLineCoords(ms_idmBar, ms_idmLevel, levelRenderMode, rightSideLevelOffset, rightSideLevelLength, compactLevelMaxLength)
        int activeIdmLabelX = levelRenderMode == "Full" ? bar_index + 12 : activeIdmRight
        line.set_xy1(ms_extIdm, activeIdmLeft, ms_idmLevel)
        line.set_xy2(ms_extIdm, activeIdmRight, ms_idmLevel)
        line.set_color(ms_extIdm, color.new(activeIdmColor, fadePassiveLevels and not ms_idmStrong ? 34 : 12))
        line.set_width(ms_extIdm, ms_idmStrong ? 2 : 1)
        line.set_style(ms_extIdm, line.style_dotted)
        string activeIdmLabel = levelCompactLabels ? f_compactLevelText(activeIdmText, ms_idmLevel) : activeIdmText
        f_registerRightLabel(ms_idmLevel, activeIdmLabelX, activeIdmLabel, 2)
    else
        f_hideLine(ms_extIdm)

f_liqBuildSweepCandidateIndexes(float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState, int confirmBars, float relevanceWindowAtr) =>
    array.clear(liq_nearbyPoolIdxs)
    array.clear(liq_sweepCandidateIdxs)
    float proximityWindow = atrVal > 0 ? atrVal * relevanceWindowAtr : syminfo.mintick * 200.0
    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            p = liq_pools.get(i)
            bool eventEligible = f_liqIsEventEligible(p)
            bool activeState = p.state != "CONSUMED"
            bool expired = f_liqIsExpired(p)
            bool raidNow = p.side == "BSL" ? high >= p.price : low <= p.price
            bool hadPending = not na(p.pendingSweepBar)
            int pendingAge = hadPending ? bar_index - p.pendingSweepBar : na
            bool pendingActive = hadPending and pendingAge <= confirmBars
            bool pendingExpired = hadPending and not pendingActive
            bool nearbyPrice = math.abs(p.price - close) <= proximityWindow
            bool proximityEligible = raidNow or pendingActive or pendingExpired or nearbyPrice
            if not p.isSwept and eventEligible and activeState and not expired and proximityEligible
                array.push(liq_nearbyPoolIdxs, i)
                if not majorSweeps
                    array.push(liq_sweepCandidateIdxs, i)
                else
                    [importance, actionability, _] = f_liqContextScores(p, close, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
                    bool candidateAllowed = f_liqPoolIsExternal(p) or importance >= 68.0 or actionability >= 72.0
                    if candidateAllowed
                        array.push(liq_sweepCandidateIdxs, i)
    true

f_liqResolveNearbyCluster(int seedIdx, int confirmBars, float clusterTol, float edgeTol) =>
    liq_pool seed = liq_pools.get(seedIdx)
    bool isBSLPool = seed.side == "BSL"
    float clusterEdgePrice = seed.price
    float clusterEdgeRank = f_liqRetentionScore(seed)
    int clusterEdgeIdx = seedIdx
    int sweptClusterCount = 0
    float clusterSumPrice = 0.0
    int clusterEligibleCount = 0
    if array.size(liq_nearbyPoolIdxs) > 0
        for i = 0 to array.size(liq_nearbyPoolIdxs) - 1
            int clusterIdx = array.get(liq_nearbyPoolIdxs, i)
            p_c = liq_pools.get(clusterIdx)
            bool sameCluster = p_c.side == seed.side and math.abs(p_c.price - seed.price) <= clusterTol
            if sameCluster
                bool cPending = not na(p_c.pendingSweepBar) and (bar_index - p_c.pendingSweepBar) <= confirmBars
                bool cHadPending = not na(p_c.pendingSweepBar)
                bool cExpiredPending = cHadPending and not cPending
                bool cRaided = p_c.side == "BSL" ? high >= p_c.price : low <= p_c.price
                bool cEligible = p_c.state != "CONSUMED" or cPending or cExpiredPending or cRaided
                if not p_c.isSwept and cEligible and f_liqIsEventEligible(p_c)
                    clusterEligibleCount += 1
                    clusterSumPrice += p_c.price
                    float cRank = f_liqRetentionScore(p_c)
                    bool moreExtreme = isBSLPool ? p_c.price > (clusterEdgePrice + edgeTol) : p_c.price < (clusterEdgePrice - edgeTol)
                    bool sameExtreme = math.abs(p_c.price - clusterEdgePrice) <= edgeTol
                    if moreExtreme or (sameExtreme and cRank > clusterEdgeRank)
                        clusterEdgePrice := p_c.price
                        clusterEdgeIdx := clusterIdx
                        clusterEdgeRank := cRank
                    if cRaided or cPending or cExpiredPending
                        sweptClusterCount += 1
    float clusterMeanPrice = clusterEligibleCount > 0 ? clusterSumPrice / clusterEligibleCount : seed.price
    [clusterEdgePrice, clusterEdgeIdx, clusterMeanPrice, sweptClusterCount, clusterEligibleCount]

// --- Sweep Engine: High-Fidelity Qualification ---
bool swpBSL = false
bool swpSSL = false
float sweepGrade = 0.0
float sweepExtreme = na
float bestSweepPrice = na
float bestSweepTol = na
string bestSweepSide = ""
int bestSweepIdx = na
int bestSweepSourceBar = na
string bestSweepBaseType = ""
bool bestSweepVolumeOk = false
bool bestSweepSessionOk = false
bool bestSweepReclaimOk = false
string bestSweepPoolLabel = ""
string bestSweepTier = "NOISE"
float bestSweepPivotPrice = na
int bestSweepPivotBar = na
string bestSweepPivotTier = ""
float bestSweepStopAnchor = na
int sweepLabelBar = na
int sweepConfirmBars = sweepReclaimBars
float maxBreakoutDepth = atrVal * (sweepMaxDepth * 1.25)
float breakoutGrade = 0.0
float bestBreakoutPrice = na
float bestBreakoutTol = na
string bestBreakoutSide = ""
int bestBreakoutIdx = na
float minSweepGrade = majorSweeps ? 58.0 : 46.0
float minBreakoutGrade = majorSweeps ? 52.0 : 40.0
float sweepNarrativeBias = htfCompositeBias + (structureTrend == 1 ? 10.0 : structureTrend == -1 ? -10.0 : 0.0) + (ms_structureBias == 1 ? 10.0 : ms_structureBias == -1 ? -10.0 : 0.0)
float sweepCandidateWindowAtr = math.max(liqContextAtr, sweepMaxDepth * 2.0 + 0.75)
if showSMC
    // PERF: prefilter nearby pools before any heavy sweep scoring.
    f_liqBuildSweepCandidateIndexes(sweepNarrativeBias, ms_structureBias, ms_idmLevel, ms_idmState, sweepConfirmBars, sweepCandidateWindowAtr)
else
    array.clear(liq_nearbyPoolIdxs)
    array.clear(liq_sweepCandidateIdxs)

if showSMC and array.size(liq_sweepCandidateIdxs) > 0
    for candidatePos = 0 to array.size(liq_sweepCandidateIdxs) - 1
        int candidateIdx = array.get(liq_sweepCandidateIdxs, candidatePos)
        p_s = liq_pools.get(candidateIdx)
        bool candidateLive = not p_s.isSwept and p_s.state != "CONSUMED" and not f_liqIsExpired(p_s) and f_liqIsEventEligible(p_s)
        if candidateLive
            bool isBSLPool = p_s.side == "BSL"
            float clusterTol = f_liqClusterTolerance(p_s.price)
            float edgeTol = f_liqTouchTolerance(p_s.price)
            bool raidNow = isBSLPool ? high >= p_s.price : low <= p_s.price
            bool hadPending = not na(p_s.pendingSweepBar)
            int pendingAge = hadPending ? bar_index - p_s.pendingSweepBar : na
            bool pendingActive = hadPending and pendingAge <= sweepConfirmBars
            bool pendingExpired = hadPending and not pendingActive
            if raidNow or pendingActive or pendingExpired
                bool closeInsideNow = isBSLPool ? close < p_s.price : close > p_s.price
                bool closeOutsideNow = isBSLPool ? close > p_s.price : close < p_s.price
                float raidExtremeNow = isBSLPool ? high : low
                float candleRange = high - low
                float safeRange = candleRange > 0 ? candleRange : syminfo.mintick
                float body = math.abs(close - open)
                float upperWick = high - math.max(open, close)
                float lowerWick = math.min(open, close) - low
                float wickBeyondBody = isBSLPool ? upperWick : lowerWick
                float wickBodyRatio = wickBeyondBody / math.max(body, syminfo.mintick)
                bool newsBar = atrVal > 0 and candleRange >= atrVal * newsRangeAtrMult and volume >= nz(avgVol, volume) * newsVolMult

                float combinedExtreme = pendingActive ? nz(p_s.pendingSweepExtreme, p_s.price) : p_s.price
                int combinedExtremeBar = pendingActive ? nz(p_s.pendingSweepExtremeBar, p_s.pendingSweepBar) : bar_index
                float combinedWick = pendingActive ? nz(p_s.pendingWickRatio, 0.0) : 0.0
                if raidNow
                    float priorExtreme = pendingActive ? nz(p_s.pendingSweepExtreme, p_s.price) : p_s.price
                    combinedExtreme := isBSLPool ? math.max(combinedExtreme, raidExtremeNow) : math.min(combinedExtreme, raidExtremeNow)
                    bool moreExtremeNow = isBSLPool ? raidExtremeNow >= priorExtreme : raidExtremeNow <= priorExtreme
                    if moreExtremeNow
                        combinedExtremeBar := bar_index
                    combinedWick := math.max(combinedWick, wickBodyRatio)

                float effectiveDepth = isBSLPool ? math.max(combinedExtreme - p_s.price, 0) : math.max(p_s.price - combinedExtreme, 0)
                float depthAtr = atrVal > 0 ? effectiveDepth / atrVal : 0.0
                [clusterEdgePrice, clusterEdgeIdx, clusterMeanPrice, sweptClusterCount, clusterEligibleCount] = f_liqResolveNearbyCluster(candidateIdx, sweepConfirmBars, clusterTol, edgeTol)
                bool atClusterEdge = isBSLPool ? combinedExtreme >= (clusterEdgePrice - edgeTol) : combinedExtreme <= (clusterEdgePrice + edgeTol)
                clusterRep = liq_pools.get(clusterEdgeIdx)
                float breakoutAcceptance = isBSLPool ? math.max(close - clusterEdgePrice, 0) : math.max(clusterEdgePrice - close, 0)
                bool breakoutAcceptanceValid = breakoutAcceptance >= math.max(edgeTol, atrVal * 0.03)
                int barsBeyondPool = pendingActive ? pendingAge : 0
                if hadPending and closeOutsideNow
                    barsBeyondPool += 1
                float reclaimToEdge = isBSLPool ? math.max(clusterEdgePrice - close, 0) : math.max(close - clusterEdgePrice, 0)
                float reclaimToMean = isBSLPool ? math.max(clusterMeanPrice - close, 0) : math.max(close - clusterMeanPrice, 0)
                bool clusterMeanRecovered = isBSLPool ? close <= (clusterMeanPrice + edgeTol * 0.15) : close >= (clusterMeanPrice - edgeTol * 0.15)
                float reclaimNorm = closeInsideNow ? math.max(reclaimToEdge, clusterMeanRecovered ? reclaimToMean : 0.0) / math.max(effectiveDepth, edgeTol) : 0.0
                bool orderlyReclaim = closeInsideNow and reclaimNorm >= reclaimLvl and combinedWick >= wickThresh
                bool lowQualityRetap = clusterRep.timesTagged >= 4 or (clusterRep.state == "TAGGED" and clusterRep.timesTagged >= 3)
                bool grindThrough = (pendingExpired and closeOutsideNow) or barsBeyondPool > sweepConfirmBars or (closeOutsideNow and body / safeRange < 0.35 and effectiveDepth > edgeTol)
                bool disorderlyNews = newsBar and not orderlyReclaim
                bool depthValid = effectiveDepth <= (atrVal * sweepMaxDepth)
                bool penetrationGateOk = depthAtr >= sweepMinPenetrationAtr
                bool reclaimGateOk = reclaimNorm >= reclaimLvl
                bool wickGateOk = combinedWick >= wickThresh
                bool volumeGateOk = not volConfirm or highVol
                bool sessionLogical = f_sweepSessionIsLogical(clusterRep)
                bool sessionGateOk = not requireSweepSessionQualifier or sessionLogical
                bool closeBackInsideOk = not requireSweepCloseBackInside or closeInsideNow
                bool confirmNow = (raidNow or pendingActive) and closeBackInsideOk
                bool breakoutDispNow = (isBSLPool ? close > open : close < open) and body > (avgBody * dispMult)
                float clusterExternality = f_liqExternalityScore(clusterRep)
                [clusterImportance, clusterActionability, _] = f_liqContextScores(clusterRep, close, sweepNarrativeBias, ms_structureBias, ms_idmLevel, ms_idmState)
                float clusterStrengthScore = f_liqClusterStrength(clusterRep)
                bool breakoutMeaningful = clusterExternality >= 56.0 or clusterImportance >= 62.0 or clusterActionability >= 66.0 or clusterRep.timesTagged > 0 or clusterStrengthScore >= 60.0 or sweptClusterCount > 1
                bool continuationBreak = closeOutsideNow and atClusterEdge and breakoutAcceptanceValid and breakoutMeaningful and ((hadPending and pendingExpired) or (effectiveDepth > maxBreakoutDepth) or breakoutDispNow)
                bool coherentWindow = not pendingExpired or continuationBreak
                bool clusterSweepValid = confirmNow and atClusterEdge and depthValid and penetrationGateOk and reclaimGateOk and wickGateOk and volumeGateOk and sessionGateOk and coherentWindow and not lowQualityRetap and not grindThrough and not disorderlyNews

                float penetrationScore = f_sweepPenetrationScore(depthAtr)
                float timeScore = f_sweepTimeScore(barsBeyondPool)
                float closeScore = closeInsideNow ? (clusterMeanRecovered ? 18.0 : 10.0) : -20.0
                float rejectionScore = f_clamp(combinedWick, 0.0, 3.0) * 6.0
                float pdScore = f_sweepPdScore(isBSLPool, clusterEdgePrice)
                float sessionScore = kzBoost ? f_sweepSessionScore(clusterRep) : 0.0
                float liquidityScore = f_sweepLiquidityScore(clusterRep, close, sweepNarrativeBias, ms_structureBias, ms_idmLevel, ms_idmState)
                float htfSweepNarrativeBias = isBSLPool ? -htfCompositeBias : htfCompositeBias
                float htfAlignmentScore = math.max(-14.0, math.min(14.0, htfSweepNarrativeBias * 0.12))
                float volumeScore = highVol ? 4.0 : 0.0
                float retapPenalty = lowQualityRetap ? -18.0 : math.max(clusterRep.timesTagged - 1, 0) * -4.0
                float coherencePenalty = coherentWindow ? 0.0 : -22.0
                float rawSweepScore = penetrationScore + timeScore + closeScore + rejectionScore + pdScore + sessionScore + liquidityScore + htfAlignmentScore + volumeScore + retapPenalty + coherencePenalty
                rawSweepScore += clusterExternality * 0.08 + clusterStrengthScore * 0.06
                rawSweepScore += sessionLogical ? 0.0 : -10.0
                rawSweepScore += disorderlyNews ? -18.0 : 0.0
                rawSweepScore := f_clamp(rawSweepScore, 0.0, 100.0)

                string candidateSweepClass = ""
                if clusterSweepValid
                    if newsBar and orderlyReclaim and clusterMeanRecovered
                        candidateSweepClass := "NEWS DISPLACEMENT RAID"
                    else if depthAtr < 0.06 or rawSweepScore < (minSweepGrade - 8.0)
                        candidateSweepClass := "MINOR PROBE"
                    else if depthAtr > (sweepMaxDepth * 0.55) or reclaimNorm > 1.10 or sweptClusterCount > 1
                        candidateSweepClass := "AGGRESSIVE STOP RUN"
                    else
                        candidateSweepClass := "CLEAN SWEEP"

                float breakoutScore = 0.0
                if continuationBreak and not lowQualityRetap and not disorderlyNews
                    float htfBreakoutBias = isBSLPool ? htfCompositeBias : -htfCompositeBias
                    float htfBreakoutScore = math.max(-12.0, math.min(12.0, htfBreakoutBias * 0.10))
                    breakoutScore := liquidityScore + sessionScore + htfBreakoutScore + (breakoutDispNow ? 18.0 : 8.0) + math.min(math.max(body / safeRange, 0.0), 1.0) * 12.0 + math.min(depthAtr, 1.5) * 10.0 + (pendingExpired ? 10.0 : 0.0)
                    breakoutScore += sessionLogical ? 0.0 : -6.0
                    breakoutScore += clusterRep.timesTagged >= 3 ? -6.0 : 0.0
                    breakoutScore := f_clamp(breakoutScore, 0.0, 100.0)

                if clusterSweepValid and candidateSweepClass != "MINOR PROBE"
                    if rawSweepScore >= minSweepGrade and rawSweepScore > sweepGrade
                        sweepGrade := rawSweepScore
                        sweepExtreme := combinedExtreme
                        bestSweepPrice := clusterEdgePrice
                        bestSweepTol := clusterTol
                        bestSweepSide := p_s.side
                        bestSweepIdx := clusterEdgeIdx
                        bestSweepSourceBar := clusterRep.sourceBar
                        bestSweepBaseType := clusterRep.baseType
                        bestSweepVolumeOk := volumeGateOk
                        bestSweepSessionOk := sessionGateOk
                        bestSweepReclaimOk := reclaimGateOk and wickGateOk and closeBackInsideOk
                        bestSweepPoolLabel := f_liqDashboardLabel(clusterRep, ms_structureBias, ms_idmLevel, ms_idmState)
                        sweepLabelBar := combinedExtremeBar
                else if continuationBreak
                    if breakoutScore >= minBreakoutGrade and breakoutScore > breakoutGrade
                        breakoutGrade := breakoutScore
                        bestBreakoutPrice := clusterEdgePrice
                        bestBreakoutTol := clusterTol
                        bestBreakoutSide := p_s.side
                        bestBreakoutIdx := clusterEdgeIdx
                    else
                        p_s.isSwept := true
                        p_s.state := "CONSUMED"
                        p_s.pendingSweepBar := int(na)
                        p_s.pendingSweepExtreme := na
                        p_s.pendingSweepExtremeBar := int(na)
                        p_s.pendingWickRatio := na
                        p_s.lastFailureBar := bar_index
                        p_s.lastRefreshBar := bar_index
                        liqClusterDirty := true
                else if raidNow or pendingActive
                    bool pendingAllowed = not lowQualityRetap and not disorderlyNews and barsBeyondPool <= sweepConfirmBars and effectiveDepth <= math.max(atrVal * sweepMaxDepth, edgeTol)
                    if pendingAllowed
                        p_s.pendingSweepBar := na(p_s.pendingSweepBar) ? bar_index : p_s.pendingSweepBar
                        p_s.pendingSweepExtreme := combinedExtreme
                        p_s.pendingSweepExtremeBar := combinedExtremeBar
                        p_s.pendingWickRatio := combinedWick
                    else if raidNow and (effectiveDepth > maxBreakoutDepth or grindThrough)
                        p_s.isSwept := true
                        p_s.state := "CONSUMED"
                        p_s.pendingSweepBar := int(na)
                        p_s.pendingSweepExtreme := na
                        p_s.pendingSweepExtremeBar := int(na)
                        p_s.pendingWickRatio := na
                        p_s.lastRefreshBar := bar_index
                        liqClusterDirty := true

if not na(bestSweepIdx)
    bestSweepPool = liq_pools.get(bestSweepIdx)
    bool sweepDispPotential = bestSweepSide == "BSL" ? (close < open and disp) : (close > open and disp)
    [bestSweepTier, bestSweepPivotPrice, bestSweepPivotBar, bestSweepPivotTier] = f_qualifySweep(bestSweepPool, bestSweepSide, bestSweepPrice, bestSweepReclaimOk, sweepDispPotential, bestSweepSessionOk)
    bestSweepStopAnchor := f_resolveWaitStopAnchor(bestSweepSide, bestSweepPrice, sweepExtreme)
    int narrativeRefBar = bestSweepBaseType == "SWING" ? bestSweepSourceBar : nz(sweepLabelBar, bar_index)
    int sweepContextBar = nz(sweepLabelBar, bar_index)
    float resolvedProtectedLow = na(ms_protectedLow) ? protectedLow : ms_protectedLow
    int resolvedProtectedLowBar = na(ms_protectedLowBar) ? protectedLowBar : ms_protectedLowBar
    float resolvedProtectedHigh = na(ms_protectedHigh) ? protectedHigh : ms_protectedHigh
    int resolvedProtectedHighBar = na(ms_protectedHighBar) ? protectedHighBar : ms_protectedHighBar
    if bestSweepSide == "BSL" and bestSweepTier != "NOISE"
        swpBSL := true
        [resolvedInternalS, resolvedInternalBarS, resolvedExternalS, resolvedExternalBarS] = f_resolveBearStructureRefs(narrativeRefBar, sweepContextBar, resolvedProtectedLow, resolvedProtectedLowBar)
        internalRefS := resolvedInternalS
        internalRefBarS := resolvedInternalBarS
        externalRefS := resolvedExternalS
        externalRefBarS := resolvedExternalBarS
        trendAtSweepS := structureTrend
        internalShiftDoneS := false
        externalShiftDoneS := false
        localPivotDoneS := false
    else if bestSweepSide == "SSL" and bestSweepTier != "NOISE"
        swpSSL := true
        [resolvedInternalL, resolvedInternalBarL, resolvedExternalL, resolvedExternalBarL] = f_resolveBullStructureRefs(narrativeRefBar, sweepContextBar, resolvedProtectedHigh, resolvedProtectedHighBar)
        internalRefL := resolvedInternalL
        internalRefBarL := resolvedInternalBarL
        externalRefL := resolvedExternalL
        externalRefBarL := resolvedExternalBarL
        trendAtSweepL := structureTrend
        internalShiftDoneL := false
        externalShiftDoneL := false
        localPivotDoneL := false

    if array.size(liq_nearbyPoolIdxs) > 0
        for i = 0 to array.size(liq_nearbyPoolIdxs) - 1
            int clusterIdx = array.get(liq_nearbyPoolIdxs, i)
            p_m = liq_pools.get(clusterIdx)
            mPending = not na(p_m.pendingSweepBar) and (bar_index - p_m.pendingSweepBar) <= sweepConfirmBars
            mRaided = p_m.side == "BSL" ? high >= p_m.price : low <= p_m.price
            sameCluster = f_liqIsEventEligible(p_m) and not p_m.isSwept and p_m.side == bestSweepSide and math.abs(p_m.price - bestSweepPrice) <= bestSweepTol
            if sameCluster and (mRaided or mPending)
                p_m.isSwept := true
                p_m.state := "SWEPT"
                p_m.pendingSweepBar := int(na)
                p_m.pendingSweepExtreme := na
                p_m.pendingSweepExtremeBar := int(na)
                p_m.pendingWickRatio := na
                p_m.lastRefreshBar := bar_index
                liqClusterDirty := true

if not na(bestBreakoutIdx)
    if array.size(liq_nearbyPoolIdxs) > 0
        for i = 0 to array.size(liq_nearbyPoolIdxs) - 1
            int clusterIdx = array.get(liq_nearbyPoolIdxs, i)
            p_b = liq_pools.get(clusterIdx)
            sameCluster = f_liqIsEventEligible(p_b) and not p_b.isSwept and p_b.side == bestBreakoutSide and math.abs(p_b.price - bestBreakoutPrice) <= bestBreakoutTol
            if sameCluster
                p_b.isSwept := true
                p_b.state := "CONSUMED"
                p_b.pendingSweepBar := int(na)
                p_b.pendingSweepExtreme := na
                p_b.pendingSweepExtremeBar := int(na)
                p_b.pendingWickRatio := na
                p_b.lastFailureBar := bar_index
                p_b.lastRefreshBar := bar_index
                liqClusterDirty := true
    if bestBreakoutSide == "BSL" and waitS and not na(waitSweepLevelS) and math.abs(bestBreakoutPrice - waitSweepLevelS) <= math.max(bestBreakoutTol, nz(waitSweepTolS, bestBreakoutTol))
        [waitS, waitStartBarS, waitStartTimeS, waitSweepLevelS, waitSweepTolS, waitSweepBaseScoreS, waitSweepVolumeOkS, waitSweepSessionOkS, waitSweepReclaimOkS, waitSweepPoolLabelS, waitStopAnchorS] = f_resetWaitState()
        [waitTierS, waitTimeoutBarsS, waitRejectionTierS] = f_resetWaitAdvanced()
        [internalRefS, internalRefBarS, externalRefS, externalRefBarS, internalShiftDoneS, externalShiftDoneS, localPivotDoneS] = f_resetStructureRefs()
        sExtH := na
        structureStatus := f_structureBaseStatus(structureTrend)
        structureStatusCode := STRUCT_STATUS_NONE
    if bestBreakoutSide == "SSL" and waitL and not na(waitSweepLevelL) and math.abs(bestBreakoutPrice - waitSweepLevelL) <= math.max(bestBreakoutTol, nz(waitSweepTolL, bestBreakoutTol))
        [waitL, waitStartBarL, waitStartTimeL, waitSweepLevelL, waitSweepTolL, waitSweepBaseScoreL, waitSweepVolumeOkL, waitSweepSessionOkL, waitSweepReclaimOkL, waitSweepPoolLabelL, waitStopAnchorL] = f_resetWaitState()
        [waitTierL, waitTimeoutBarsL, waitRejectionTierL] = f_resetWaitAdvanced()
        [internalRefL, internalRefBarL, externalRefL, externalRefBarL, internalShiftDoneL, externalShiftDoneL, localPivotDoneL] = f_resetStructureRefs()
        sExtL := na
        structureStatus := f_structureBaseStatus(structureTrend)
        structureStatusCode := STRUCT_STATUS_NONE

if liqClusterDirty
    // PERF: only refresh cluster metadata again when the sweep engine actually mutated pool states.
    f_liqRebuildClusterMetrics()
    liqClusterDirty := false
    f_liqRefreshDerivedScores()

bearSweep = showSMC and swpBSL
bullSweep = showSMC and swpSSL
if bearSweep and not waitS
    [waitS, waitStartBarS, waitStartTimeS, waitSweepLevelS, waitSweepTolS, waitSweepBaseScoreS, waitSweepVolumeOkS, waitSweepSessionOkS, waitSweepReclaimOkS, waitSweepPoolLabelS, waitStopAnchorS] = f_startWaitState(bestSweepPrice, bestSweepTol, sweepGrade, bestSweepVolumeOk, bestSweepSessionOk, bestSweepReclaimOk, bestSweepPoolLabel, bestSweepStopAnchor)
    [waitTierS, waitTimeoutBarsS, waitRejectionTierS] = f_startWaitAdvanced(bestSweepTier, f_modeTierTimeout(msConfirmationMode, bestSweepTier))
    [waitL, waitStartBarL, waitStartTimeL, waitSweepLevelL, waitSweepTolL, waitSweepBaseScoreL, waitSweepVolumeOkL, waitSweepSessionOkL, waitSweepReclaimOkL, waitSweepPoolLabelL, waitStopAnchorL] = f_resetWaitState()
    [waitTierL, waitTimeoutBarsL, waitRejectionTierL] = f_resetWaitAdvanced()
    [internalRefL, internalRefBarL, externalRefL, externalRefBarL, internalShiftDoneL, externalShiftDoneL, localPivotDoneL] = f_resetStructureRefs()
    sExtH := waitStopAnchorS
    lastSweepTerminalEvent := ""
    lastSweepTerminalBar := na
    structureStatus := "Bearish " + bestSweepTier + " sweep qualified; awaiting rejection and structure shift"
    structureStatusCode := STRUCT_STATUS_NONE
if bullSweep and not waitL
    [waitL, waitStartBarL, waitStartTimeL, waitSweepLevelL, waitSweepTolL, waitSweepBaseScoreL, waitSweepVolumeOkL, waitSweepSessionOkL, waitSweepReclaimOkL, waitSweepPoolLabelL, waitStopAnchorL] = f_startWaitState(bestSweepPrice, bestSweepTol, sweepGrade, bestSweepVolumeOk, bestSweepSessionOk, bestSweepReclaimOk, bestSweepPoolLabel, bestSweepStopAnchor)
    [waitTierL, waitTimeoutBarsL, waitRejectionTierL] = f_startWaitAdvanced(bestSweepTier, f_modeTierTimeout(msConfirmationMode, bestSweepTier))
    [waitS, waitStartBarS, waitStartTimeS, waitSweepLevelS, waitSweepTolS, waitSweepBaseScoreS, waitSweepVolumeOkS, waitSweepSessionOkS, waitSweepReclaimOkS, waitSweepPoolLabelS, waitStopAnchorS] = f_resetWaitState()
    [waitTierS, waitTimeoutBarsS, waitRejectionTierS] = f_resetWaitAdvanced()
    [internalRefS, internalRefBarS, externalRefS, externalRefBarS, internalShiftDoneS, externalShiftDoneS, localPivotDoneS] = f_resetStructureRefs()
    sExtL := waitStopAnchorL
    lastSweepTerminalEvent := ""
    lastSweepTerminalBar := na
    structureStatus := "Bullish " + bestSweepTier + " sweep qualified; awaiting rejection and structure shift"
    structureStatusCode := STRUCT_STATUS_NONE

bearRaidRange = high - low
bearRaidSafeRange = bearRaidRange > 0 ? bearRaidRange : 1.0
bearRaidReclaim = nz(waitSweepLevelS, high) - close
bearRaidWick = (high - close) / bearRaidSafeRange
bool bearRaidUpgrade = waitS and not internalShiftDoneS and not na(waitSweepLevelS) and high >= waitSweepLevelS and high > nz(sExtH, waitSweepLevelS) and close < waitSweepLevelS and math.max(high - waitSweepLevelS, 0) <= (atrVal * sweepMaxDepth) and (bearRaidReclaim / bearRaidSafeRange) >= reclaimLvl and bearRaidWick >= wickThresh
if bearRaidUpgrade
    waitStopAnchorS := na(waitStopAnchorS) ? high : math.max(waitStopAnchorS, high)
    sExtH := waitStopAnchorS
    waitStartBarS := bar_index
    waitStartTimeS := time
    waitRejectionTierS := ""

bullRaidRange = high - low
bullRaidSafeRange = bullRaidRange > 0 ? bullRaidRange : 1.0
bullRaidReclaim = close - nz(waitSweepLevelL, low)
bullRaidWick = (close - low) / bullRaidSafeRange
bool bullRaidUpgrade = waitL and not internalShiftDoneL and not na(waitSweepLevelL) and low <= waitSweepLevelL and low < nz(sExtL, waitSweepLevelL) and close > waitSweepLevelL and math.max(waitSweepLevelL - low, 0) <= (atrVal * sweepMaxDepth) and (bullRaidReclaim / bullRaidSafeRange) >= reclaimLvl and bullRaidWick >= wickThresh
if bullRaidUpgrade
    waitStopAnchorL := na(waitStopAnchorL) ? low : math.min(waitStopAnchorL, low)
    sExtL := waitStopAnchorL
    waitStartBarL := bar_index
    waitStartTimeL := time
    waitRejectionTierL := ""

if waitS
    waitRejectionTierS := f_evalRejectionTier("BSL", waitSweepLevelS, waitStopAnchorS, waitStartBarS, waitSweepReclaimOkS, waitRejectionTierS)
if waitL
    waitRejectionTierL := f_evalRejectionTier("SSL", waitSweepLevelL, waitStopAnchorL, waitStartBarL, waitSweepReclaimOkL, waitRejectionTierL)

if waitS and waitRejectionTierS == "FAILED"
    lastSweepTerminalEvent := "Bearish sweep failed | reclaim lost"
    lastSweepTerminalBar := bar_index
    [waitS, waitStartBarS, waitStartTimeS, waitSweepLevelS, waitSweepTolS, waitSweepBaseScoreS, waitSweepVolumeOkS, waitSweepSessionOkS, waitSweepReclaimOkS, waitSweepPoolLabelS, waitStopAnchorS] = f_resetWaitState()
    [waitTierS, waitTimeoutBarsS, waitRejectionTierS] = f_resetWaitAdvanced()
    [internalRefS, internalRefBarS, externalRefS, externalRefBarS, internalShiftDoneS, externalShiftDoneS, localPivotDoneS] = f_resetStructureRefs()
    sExtH := na
    structureStatus := "Bearish qualified sweep failed rejection"
    structureStatusCode := STRUCT_STATUS_FAILED_REJECTION_BEAR

if waitL and waitRejectionTierL == "FAILED"
    lastSweepTerminalEvent := "Bullish sweep failed | reclaim lost"
    lastSweepTerminalBar := bar_index
    [waitL, waitStartBarL, waitStartTimeL, waitSweepLevelL, waitSweepTolL, waitSweepBaseScoreL, waitSweepVolumeOkL, waitSweepSessionOkL, waitSweepReclaimOkL, waitSweepPoolLabelL, waitStopAnchorL] = f_resetWaitState()
    [waitTierL, waitTimeoutBarsL, waitRejectionTierL] = f_resetWaitAdvanced()
    [internalRefL, internalRefBarL, externalRefL, externalRefBarL, internalShiftDoneL, externalShiftDoneL, localPivotDoneL] = f_resetStructureRefs()
    sExtL := na
    structureStatus := "Bullish qualified sweep failed rejection"
    structureStatusCode := STRUCT_STATUS_FAILED_REJECTION_BULL

int shortWaitLimit = na(waitTimeoutBarsS) ? modeSweepTimeoutBars : waitTimeoutBarsS
int longWaitLimit = na(waitTimeoutBarsL) ? modeSweepTimeoutBars : waitTimeoutBarsL
bool sweepWaitExpiredS = waitS and not na(waitStartBarS) and shortWaitLimit > 0 and (bar_index - waitStartBarS) > shortWaitLimit
bool sweepWaitExpiredL = waitL and not na(waitStartBarL) and longWaitLimit > 0 and (bar_index - waitStartBarL) > longWaitLimit
if sweepWaitExpiredS
    lastSweepTerminalEvent := "Bearish sweep expired"
    lastSweepTerminalBar := bar_index
    [waitS, waitStartBarS, waitStartTimeS, waitSweepLevelS, waitSweepTolS, waitSweepBaseScoreS, waitSweepVolumeOkS, waitSweepSessionOkS, waitSweepReclaimOkS, waitSweepPoolLabelS, waitStopAnchorS] = f_resetWaitState()
    [waitTierS, waitTimeoutBarsS, waitRejectionTierS] = f_resetWaitAdvanced()
    [internalRefS, internalRefBarS, externalRefS, externalRefBarS, internalShiftDoneS, externalShiftDoneS, localPivotDoneS] = f_resetStructureRefs()
    sExtH := na
    structureStatus := f_structureBaseStatus(structureTrend)
    structureStatusCode := STRUCT_STATUS_NONE
if sweepWaitExpiredL
    lastSweepTerminalEvent := "Bullish sweep expired"
    lastSweepTerminalBar := bar_index
    [waitL, waitStartBarL, waitStartTimeL, waitSweepLevelL, waitSweepTolL, waitSweepBaseScoreL, waitSweepVolumeOkL, waitSweepSessionOkL, waitSweepReclaimOkL, waitSweepPoolLabelL, waitStopAnchorL] = f_resetWaitState()
    [waitTierL, waitTimeoutBarsL, waitRejectionTierL] = f_resetWaitAdvanced()
    [internalRefL, internalRefBarL, externalRefL, externalRefBarL, internalShiftDoneL, externalShiftDoneL, localPivotDoneL] = f_resetStructureRefs()
    sExtL := na
    structureStatus := f_structureBaseStatus(structureTrend)
    structureStatusCode := STRUCT_STATUS_NONE

bool ms_bearChochSinceSweep = waitS and not na(ms_lastBearChochBar) and ms_lastBearChochBar >= nz(waitStartBarS, bar_index + 1)
bool ms_bullChochSinceSweep = waitL and not na(ms_lastBullChochBar) and ms_lastBullChochBar >= nz(waitStartBarL, bar_index + 1)
bool ms_bearBosSinceSweep = waitS and not na(ms_lastBearBosBar) and ms_lastBearBosBar >= nz(waitStartBarS, bar_index + 1)
bool ms_bullBosSinceSweep = waitL and not na(ms_lastBullBosBar) and ms_lastBullBosBar >= nz(waitStartBarL, bar_index + 1)
bool msOpposingProtectedLevelBrokenS = waitS and not na(ms_protectedLow) and close < (ms_protectedLow - msBreakTol)
bool msOpposingProtectedLevelBrokenL = waitL and not na(ms_protectedHigh) and close > (ms_protectedHigh + msBreakTol)
bool msContinuationConfirmedS = ms_bearBosSinceSweep
bool msContinuationConfirmedL = ms_bullBosSinceSweep
bool msPostSweepStructureConfirmedS = waitS and (ms_bearChochSinceSweep or msContinuationConfirmedS or msOpposingProtectedLevelBrokenS)
bool msPostSweepStructureConfirmedL = waitL and (ms_bullChochSinceSweep or msContinuationConfirmedL or msOpposingProtectedLevelBrokenL)
bool msSweepContextConflictS = waitS and ms_structureBias == 1 and not msPostSweepStructureConfirmedS
bool msSweepContextConflictL = waitL and ms_structureBias == -1 and not msPostSweepStructureConfirmedL
string activeShortSweepGrade = waitS ? f_unifiedSweepGrade(waitSweepBaseScoreS, waitSweepReclaimOkS, waitSweepVolumeOkS, waitSweepSessionOkS, msPostSweepStructureConfirmedS, msConfirmationMode) : ""
string activeLongSweepGrade = waitL ? f_unifiedSweepGrade(waitSweepBaseScoreL, waitSweepReclaimOkL, waitSweepVolumeOkL, waitSweepSessionOkL, msPostSweepStructureConfirmedL, msConfirmationMode) : ""

// --- Structure Confirmation ---
float structureRange = high - low
float structureSafeRange = structureRange > 0 ? structureRange : 1.0
float bodyEff = math.abs(close - open) / structureSafeRange
bool bearImbalanceCreated = high < low[2]
bool bullImbalanceCreated = low > high[2]
bool bearObviousRepricing = atrVal > 0 and structureRange >= atrVal * 0.85 and bodyEff > 0.62
bool bullObviousRepricing = atrVal > 0 and structureRange >= atrVal * 0.85 and bodyEff > 0.62
bool bearStructureImpulse = showSMC and close < open and disp and ((close - low) / structureSafeRange) <= 0.25 and (bearImbalanceCreated or bearObviousRepricing)
bool bullStructureImpulse = showSMC and close > open and disp and ((high - close) / structureSafeRange) <= 0.25 and (bullImbalanceCreated or bullObviousRepricing)
float internalBreakTolS = not na(internalRefS) ? math.max(f_liqTouchTolerance(internalRefS) * 0.35, atrVal * 0.05) : atrVal * 0.05
float internalBreakTolL = not na(internalRefL) ? math.max(f_liqTouchTolerance(internalRefL) * 0.35, atrVal * 0.05) : atrVal * 0.05
float externalBreakTolS = not na(externalRefS) ? math.max(f_liqTouchTolerance(externalRefS) * 0.35, atrVal * 0.05) : atrVal * 0.05
float externalBreakTolL = not na(externalRefL) ? math.max(f_liqTouchTolerance(externalRefL) * 0.35, atrVal * 0.05) : atrVal * 0.05

bool localPivotBreakS = showSMC and waitS and not internalShiftDoneS and not na(lSwl) and not na(internalRefS) and not na(lSwlBar) and lSwlBar > nz(waitStartBarS, -1) and lSwl > internalRefS and close < (lSwl - internalBreakTolS) and close >= (internalRefS - internalBreakTolS) and bearStructureImpulse
bool localPivotBreakL = showSMC and waitL and not internalShiftDoneL and not na(lSwh) and not na(internalRefL) and not na(lSwhBar) and lSwhBar > nz(waitStartBarL, -1) and lSwh < internalRefL and close > (lSwh + internalBreakTolL) and close <= (internalRefL + internalBreakTolL) and bullStructureImpulse

bool internalBreakS = showSMC and waitS and not internalShiftDoneS and not na(internalRefS) and close < (internalRefS - internalBreakTolS) and bearStructureImpulse
bool internalBreakL = showSMC and waitL and not internalShiftDoneL and not na(internalRefL) and close > (internalRefL + internalBreakTolL) and bullStructureImpulse

bool externalBreakS = showSMC and waitS and (internalShiftDoneS or internalBreakS) and not externalShiftDoneS and not na(externalRefS) and close < (externalRefS - externalBreakTolS) and bearStructureImpulse
bool externalBreakL = showSMC and waitL and (internalShiftDoneL or internalBreakL) and not externalShiftDoneL and not na(externalRefL) and close > (externalRefL + externalBreakTolL) and bullStructureImpulse

if localPivotBreakS and not localPivotDoneS
    localPivotDoneS := true
    structureStatus := "Bearish local pivot break"
    structureStatusCode := STRUCT_STATUS_LOCAL_PIVOT_BEAR
if localPivotBreakL and not localPivotDoneL
    localPivotDoneL := true
    structureStatus := "Bullish local pivot break"
    structureStatusCode := STRUCT_STATUS_LOCAL_PIVOT_BULL

if internalBreakS
    internalShiftDoneS := true
    bool shortInternalAligned = ms_bearChochSinceSweep or msPostSweepStructureConfirmedS
    structureStatus := shortInternalAligned ? "Bearish internal shift + CHoCH" : msSweepContextConflictS ? "Bearish internal shift; broader structure disagrees" : "Bearish internal shift only"
    structureStatusCode := STRUCT_STATUS_NONE
    if not externalBreakS
        string shortInternalLabel = shortInternalAligned ? (msCompactStructureLabels ? "INT + CHOCH ↘" : "INTERNAL SHIFT + CHoCH ↘") : msSweepContextConflictS ? (msCompactStructureLabels ? "INT | MS ? ↘" : "INTERNAL SHIFT | MS UNCONFIRMED ↘") : "INTERNAL SHIFT ↘"
        f_trackHistoricalLabel(label.new(bar_index, high, shortInternalLabel, color=f_themePanelColor(), textcolor=f_themeTextColor(), style=label.style_label_down, size=f_breakoutLabelSize()))
if internalBreakL
    internalShiftDoneL := true
    bool longInternalAligned = ms_bullChochSinceSweep or msPostSweepStructureConfirmedL
    structureStatus := longInternalAligned ? "Bullish internal shift + CHoCH" : msSweepContextConflictL ? "Bullish internal shift; broader structure disagrees" : "Bullish internal shift only"
    structureStatusCode := STRUCT_STATUS_NONE
    if not externalBreakL
        string longInternalLabel = longInternalAligned ? (msCompactStructureLabels ? "INT + CHOCH ↗" : "INTERNAL SHIFT + CHoCH ↗") : msSweepContextConflictL ? (msCompactStructureLabels ? "INT | MS ? ↗" : "INTERNAL SHIFT | MS UNCONFIRMED ↗") : "INTERNAL SHIFT ↗"
        f_trackHistoricalLabel(label.new(bar_index, low, longInternalLabel, color=f_themePanelColor(), textcolor=f_themeTextColor(), style=label.style_label_up, size=f_breakoutLabelSize()))

if externalBreakS
    externalShiftDoneS := true
    structureTrend := -1
    bool shortExternalAligned = msContinuationConfirmedS or msOpposingProtectedLevelBrokenS or msPostSweepStructureConfirmedS
    structureStatus := shortExternalAligned ? "Bearish external shift + BOS" : "Bearish external shift; market-structure unconfirmed"
    structureStatusCode := STRUCT_STATUS_NONE
    string shortExternalLabel = shortExternalAligned ? (msCompactStructureLabels ? "EXT + BOS ↘" : (trendAtSweepS == -1 ? "CONTINUATION SHIFT + BOS ↘" : "EXTERNAL SHIFT + BOS ↘")) : (msCompactStructureLabels ? "EXT | MS ? ↘" : "EXTERNAL SHIFT | MS UNCONFIRMED ↘")
    f_trackHistoricalLabel(label.new(bar_index, high, shortExternalLabel, color=f_themePanelColor(), textcolor=f_themeTextColor(), style=label.style_label_down, size=f_breakoutLabelSize()))
if externalBreakL
    externalShiftDoneL := true
    structureTrend := 1
    bool longExternalAligned = msContinuationConfirmedL or msOpposingProtectedLevelBrokenL or msPostSweepStructureConfirmedL
    structureStatus := longExternalAligned ? "Bullish external shift + BOS" : "Bullish external shift; market-structure unconfirmed"
    structureStatusCode := STRUCT_STATUS_NONE
    string longExternalLabel = longExternalAligned ? (msCompactStructureLabels ? "EXT + BOS ↗" : (trendAtSweepL == 1 ? "CONTINUATION SHIFT + BOS ↗" : "EXTERNAL SHIFT + BOS ↗")) : (msCompactStructureLabels ? "EXT | MS ? ↗" : "EXTERNAL SHIFT | MS UNCONFIRMED ↗")
    f_trackHistoricalLabel(label.new(bar_index, low, longExternalLabel, color=f_themePanelColor(), textcolor=f_themeTextColor(), style=label.style_label_up, size=f_breakoutLabelSize()))

f_bestDirectionalLiquidity(float anchorPrice, bool wantAbove, string liqSide, float maxWindowAtr, float narrativeBias, int currentStructureBias, float currentIdmLevel, int currentIdmState) =>
    bool found = false
    float bestPrice = na
    string bestLabel = ""
    float bestDist = na
    float bestImportance = na
    float bestActionability = na
    string bestReasonFlags = ""
    string bestTier = ""
    float bestScore = -10e10
    if not na(anchorPrice) and atrVal > 0 and liq_pools.size() > 0
        float anchorTol = math.max(f_liqTouchTolerance(anchorPrice) * 0.35, syminfo.mintick * 5)
        for i = 0 to liq_pools.size() - 1
            pool = liq_pools.get(i)
            bool meaningful = f_liqIsEventEligible(pool) and not pool.isSwept and pool.state != "CONSUMED"
            if meaningful and pool.side == liqSide
                float dist = wantAbove ? pool.price - anchorPrice : anchorPrice - pool.price
                bool directional = dist > anchorTol and dist <= atrVal * maxWindowAtr
                if directional
                    [importance, actionability, tierId] = f_liqContextScores(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
                    bool candidateAllowed = tierId >= 2 or actionability >= 52.0 or f_liqPoolIsExternal(pool)
                    if candidateAllowed
                        float freshness = f_liqFreshnessScore(pool)
                        float externality = f_liqExternalityScore(pool)
                        float clusterStrength = f_liqClusterStrength(pool)
                        float score = actionability * 0.46 + importance * 0.34 + freshness * 0.08 + externality * 0.07 + clusterStrength * 0.05
                        score += tierId == 3 ? 10.0 : tierId == 2 ? 4.0 : 0.0
                        score += pool.baseType == "DEV_SESSION" ? -10.0 : 0.0
                        bool betterScore = score > bestScore + 0.01
                        bool tieBetterDistance = math.abs(score - bestScore) <= 0.01 and (na(bestDist) or dist < bestDist)
                        if betterScore or tieBetterDistance
                            bestScore := score
                            bestDist := dist
                            bestPrice := pool.price
                            bestLabel := f_liqDashboardLabel(pool, currentStructureBias, currentIdmLevel, currentIdmState)
                            bestImportance := importance
                            bestActionability := actionability
                            bestReasonFlags := f_liqReasonFlags(pool, anchorPrice, narrativeBias, currentStructureBias, currentIdmLevel, currentIdmState)
                            bestTier := tierId == 3 ? "ACTIONABLE" : tierId == 2 ? "IMPORTANT" : "INFORMATIONAL"
                            found := true
    [found, bestPrice, bestLabel, bestDist, bestImportance, bestActionability, bestReasonFlags, bestTier]

f_dashRow(table t, int row, string leftTxt, string rightTxt, color rightColor, color cellBg, color cellText) =>
    table.cell(t, 0, row, leftTxt, text_color=cellText, bgcolor=cellBg, text_size=size.small)
    table.cell(t, 1, row, rightTxt, text_color=rightColor, bgcolor=cellBg, text_size=size.small)

f_dashBiasBucket(float combinedBias) =>
    combinedBias >= 28.0 ? "Strong Bull" : combinedBias >= 12.0 ? "Bull Lean" : combinedBias <= -28.0 ? "Strong Bear" : combinedBias <= -12.0 ? "Bear Lean" : "Mixed"

f_dashSweepTierText(string tier) =>
    tier == "MAJOR" ? "major" : tier == "MINOR" ? "minor" : "qualified"

f_dashSweepQualityBucket(string grade, float baseScore, string rejectionTier, bool msConfirmed) =>
    grade == "A" or (msConfirmed and baseScore >= 72.0) ? "Strong" : grade == "B" or rejectionTier == "CONFIRMED" or baseScore >= 60.0 ? "Moderate" : "Weak"

f_dashMsBaseText() =>
    ms_structureBias == 1 ? (ms_bullBosEvent or msContinuationConfirmedL ? "Bullish BOS confirmed" : ms_idmTaken ? "Bullish IDM taken | BOS pending" : not na(ms_idmLevel) and ms_idmState == 2 ? "Bullish IDM stale" : not na(ms_idmLevel) and ms_idmStrong ? "Bullish IDM strong" : not na(ms_idmLevel) and ms_idmState == 1 ? "Bullish IDM active" : ms_bullProtectedIntact ? "Bullish protected low intact" : "Bullish protected low at risk") : ms_structureBias == -1 ? (ms_bearBosEvent or msContinuationConfirmedS ? "Bearish BOS confirmed" : ms_idmTaken ? "Bearish IDM taken | BOS pending" : not na(ms_idmLevel) and ms_idmState == 2 ? "Bearish IDM stale" : not na(ms_idmLevel) and ms_idmStrong ? "Bearish IDM strong" : not na(ms_idmLevel) and ms_idmState == 1 ? "Bearish IDM active" : ms_bearProtectedIntact ? "Bearish protected high intact" : "Bearish protected high at risk") : "Neutral"

f_dashPendingRaid(float narrativeBias) =>
    bool found = false
    string side = ""
    string raidLabel = ""
    float bestScore = -10e10
    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            pool = liq_pools.get(i)
            bool pending = not na(pool.pendingSweepBar) and (bar_index - pool.pendingSweepBar) <= sweepConfirmBars
            if pending and not f_liqIsExpired(pool) and f_liqIsEventEligible(pool) and pool.state != "CONSUMED"
                [importance, actionability, _] = f_liqContextScores(pool, close, narrativeBias, ms_structureBias, ms_idmLevel, ms_idmState)
                float candidateScore = actionability * 0.55 + importance * 0.35 + ((bar_index - pool.pendingSweepBar) <= 1 ? 8.0 : 0.0)
                if candidateScore > bestScore
                    bestScore := candidateScore
                    side := pool.side
                    raidLabel := f_liqDashboardLabel(pool, ms_structureBias, ms_idmLevel, ms_idmState)
                    found := true
    [found, side, raidLabel]

f_resolveSweepDashboardState(int currentStructureStatusCode, float narrativeBias) =>
    int stage = 0
    string eventText = "No active event"
    string quality = ""
    if waitS or waitL
        bool shortSide = waitS
        string dir = shortSide ? "Bearish" : "Bullish"
        string tierTxt = f_dashSweepTierText(shortSide ? waitTierS : waitTierL)
        string rejectionTier = shortSide ? waitRejectionTierS : waitRejectionTierL
        float baseScore = shortSide ? waitSweepBaseScoreS : waitSweepBaseScoreL
        string grade = shortSide ? activeShortSweepGrade : activeLongSweepGrade
        bool msConfirmed = shortSide ? msPostSweepStructureConfirmedS : msPostSweepStructureConfirmedL
        quality := f_dashSweepQualityBucket(grade, baseScore, rejectionTier, msConfirmed)
        if shortSide
            if msContinuationConfirmedS or externalShiftDoneS
                stage := 90
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | BOS"
            else if ms_bearChochSinceSweep
                stage := 80
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | CHoCH"
            else if msOpposingProtectedLevelBrokenS
                stage := 76
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | protected low lost"
            else if internalShiftDoneS
                stage := 70
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | internal shift"
            else if rejectionTier == "CONFIRMED"
                stage := 60
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | reclaim held"
            else if rejectionTier == "WEAK"
                stage := 50
                eventText := dir + " " + tierTxt + " sweep | Weak | weak reclaim"
            else
                stage := 40
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | reclaim pending"
        else
            if msContinuationConfirmedL or externalShiftDoneL
                stage := 90
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | BOS"
            else if ms_bullChochSinceSweep
                stage := 80
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | CHoCH"
            else if msOpposingProtectedLevelBrokenL
                stage := 76
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | protected high lost"
            else if internalShiftDoneL
                stage := 70
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | internal shift"
            else if rejectionTier == "CONFIRMED"
                stage := 60
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | reclaim held"
            else if rejectionTier == "WEAK"
                stage := 50
                eventText := dir + " " + tierTxt + " sweep | Weak | weak reclaim"
            else
                stage := 40
                eventText := dir + " " + tierTxt + " sweep | " + quality + " | reclaim pending"
    else
        if not na(bestBreakoutIdx)
            liq_pool breakoutPool = liq_pools.get(bestBreakoutIdx)
            string breakoutDir = bestBreakoutSide == "BSL" ? "Bullish" : "Bearish"
            stage := 30
            eventText := breakoutDir + " breakout | " + f_liqDashboardLabel(breakoutPool, ms_structureBias, ms_idmLevel, ms_idmState)
        else
            [pendingFound, pendingSide, pendingLabel] = f_dashPendingRaid(narrativeBias)
            if pendingFound
                string pendingDir = pendingSide == "BSL" ? "Bearish" : "Bullish"
                stage := 20
                eventText := pendingDir + " raid | reclaim pending | " + pendingLabel
            else if not na(lastSweepTerminalBar) and (bar_index - lastSweepTerminalBar) <= 2
                stage := 12
                eventText := lastSweepTerminalEvent
            else if currentStructureStatusCode == STRUCT_STATUS_FAILED_REJECTION_BEAR or currentStructureStatusCode == STRUCT_STATUS_FAILED_REJECTION_BULL
                stage := 10
                eventText := currentStructureStatusCode == STRUCT_STATUS_FAILED_REJECTION_BEAR ? "Bearish sweep failed | reclaim lost" : "Bullish sweep failed | reclaim lost"
    [stage, eventText]

f_dashBiasText(float combinedBias) =>
    string htfBiasText = htfLongStrong ? "HTF bull" : htfShortStrong ? "HTF bear" : math.abs(htfCompositeBias) >= 20 ? (htfCompositeBias > 0 ? "HTF bull lean" : "HTF bear lean") : "HTF mixed"
    string msIntegrityText = ms_structureBias == 1 ? (ms_bullProtectedIntact ? "Prot low intact" : "Prot low at risk") : ms_structureBias == -1 ? (ms_bearProtectedIntact ? "Prot high intact" : "Prot high at risk") : "MS neutral"
    f_dashBiasBucket(combinedBias) + " | " + htfBiasText + " | " + msIntegrityText

f_dashLiquidityText(bool shortCounterFound, float shortCounterPrice, string shortCounterLabel, bool longCounterFound, float longCounterPrice, string longCounterLabel, float narrativeBias) =>
    string bslText = shortCounterFound ? shortCounterLabel + " " + str.tostring(shortCounterPrice, format.mintick) : ""
    string sslText = longCounterFound ? longCounterLabel + " " + str.tostring(longCounterPrice, format.mintick) : ""
    string chosenShort = waitS and waitSweepPoolLabelS != "" and not na(waitSweepLevelS) ? waitSweepPoolLabelS + " " + str.tostring(waitSweepLevelS, format.mintick) : ""
    string chosenLong = waitL and waitSweepPoolLabelL != "" and not na(waitSweepLevelL) ? waitSweepPoolLabelL + " " + str.tostring(waitSweepLevelL, format.mintick) : ""
    if chosenShort != ""
        sslText != "" ? "Short @ " + chosenShort + " | SSL " + sslText : "Short @ " + chosenShort
    else if chosenLong != ""
        bslText != "" ? "Long @ " + chosenLong + " | BSL " + bslText : "Long @ " + chosenLong
    else if narrativeBias >= 15.0 and sslText != "" and bslText != ""
        "Focus SSL " + sslText + " | BSL " + bslText
    else if narrativeBias <= -15.0 and bslText != "" and sslText != ""
        "Focus BSL " + bslText + " | SSL " + sslText
    else if bslText != "" and sslText != ""
        "BSL " + bslText + " | SSL " + sslText
    else if bslText != ""
        "BSL " + bslText
    else if sslText != ""
        "SSL " + sslText
    else
        "No nearby liquidity"

f_dashStructureText(int eventStage, int currentStructureStatusCode) =>
    if waitS
        eventStage >= 90 ? "Bearish BOS confirmed" : eventStage >= 80 ? "Bearish CHoCH | BOS pending" : eventStage >= 70 ? "Bearish shift | CHoCH pending" : waitRejectionTierS == "CONFIRMED" ? "Bearish reclaim held" : waitRejectionTierS == "WEAK" ? "Bearish reclaim weak" : "Bearish sweep active"
    else if waitL
        eventStage >= 90 ? "Bullish BOS confirmed" : eventStage >= 80 ? "Bullish CHoCH | BOS pending" : eventStage >= 70 ? "Bullish shift | CHoCH pending" : waitRejectionTierL == "CONFIRMED" ? "Bullish reclaim held" : waitRejectionTierL == "WEAK" ? "Bullish reclaim weak" : "Bullish sweep active"
    else if currentStructureStatusCode == STRUCT_STATUS_LOCAL_PIVOT_BEAR or currentStructureStatusCode == STRUCT_STATUS_LOCAL_PIVOT_BULL
        structureStatus
    else
        f_dashMsBaseText()

f_dashTimingText() =>
    string activeSetup = waitL ? "Long live" : waitS ? "Short live" : "Watch"
    if inLondonSweepWindow
        "LDN sweep | " + activeSetup
    else if inNYSweepWindow
        "NY sweep | " + activeSetup
    else if inLondon
        "LDN | " + activeSetup
    else if inNY
        "NY | " + activeSetup
    else if inAsia
        "Asia | " + activeSetup
    else
        waitL or waitS ? "Core | " + activeSetup : "Core"

f_dashTraderRead(int eventStage, float narrativeBias, int currentStructureStatusCode) =>
    if waitS
        eventStage >= 90 ? "Short bias. Use premium retrace or continuation; invalid above the sweep." : eventStage >= 80 ? "Bearish CHoCH confirmed. Need BOS lower or premium retest." : eventStage >= 70 ? "Bearish reclaim held. Need CHoCH or BOS lower." : waitRejectionTierS == "CONFIRMED" ? "Bearish reclaim held. Wait internal shift or CHoCH lower." : waitRejectionTierS == "WEAK" ? "Bearish reclaim is weak. Wait a cleaner hold or shift." : "Bearish liquidity tagged. Need reclaim below the sweep."
    else if waitL
        eventStage >= 90 ? "Long bias. Use discount retrace or continuation; invalid below the sweep." : eventStage >= 80 ? "Bullish CHoCH confirmed. Need BOS higher or discount retest." : eventStage >= 70 ? "Bullish reclaim held. Need CHoCH or BOS higher." : waitRejectionTierL == "CONFIRMED" ? "Bullish reclaim held. Wait internal shift or CHoCH higher." : waitRejectionTierL == "WEAK" ? "Bullish reclaim is weak. Wait a cleaner hold or shift." : "Bullish liquidity tagged. Need reclaim above the sweep."
    else if not na(bestBreakoutIdx)
        bestBreakoutSide == "BSL" ? "Bullish continuation. Favor pullback holds, not fades." : "Bearish continuation. Favor pullback holds, not fades."
    else if currentStructureStatusCode == STRUCT_STATUS_FAILED_REJECTION_BEAR or currentStructureStatusCode == STRUCT_STATUS_FAILED_REJECTION_BULL
        "Last sweep failed. Stand aside until fresh liquidity forms."
    else if narrativeBias >= 25.0
        "Bias favors longs. Let discount SSL or IDM interaction lead."
    else if narrativeBias <= -25.0
        "Bias favors shorts. Let premium BSL or IDM interaction lead."
    else
        "Mixed context. Let above and below liquidity resolve first."

// --- Rendering ---
if barstate.islast
    f_renderRightLabels()

// --- Dashboard ---
if showDash and barstate.islast
    pos_tbl = (dashPos == "Top Right") ? position.top_right : (dashPos == "Top Left") ? position.top_left : position.bottom_right
    color dashBorder = color.new(chart.fg_color, 78)
    var table tb = table.new(pos_tbl, 2, 7, bgcolor=chart.bg_color, border_color=dashBorder, border_width=1)
    table.clear(tb, 0, 0, 1, 6)

    color dashHeaderBg = chart.bg_color
    color dashHeaderText = f_themeTextColor()
    color dashCellBg = chart.bg_color
    color dashCellText = f_themeTextColor()
    // PERF: heavy dashboard text and directional-liquidity scans run only on the last bar.
    float dashboardNarrativeBias = htfCompositeBias + (structureTrend == 1 ? 12.0 : structureTrend == -1 ? -12.0 : 0.0) + (ms_structureBias == 1 ? 10.0 : ms_structureBias == -1 ? -10.0 : 0.0)
    float narrativeLiquidityWindowAtr = math.max(liqContextAtr * 2.0, 6.0)
    [shortCounterFound, shortCounterPrice, shortCounterLabel, shortCounterDist, shortCounterImportance, shortCounterActionability, shortCounterReasons, shortCounterTier] = f_bestDirectionalLiquidity(close, true, "BSL", narrativeLiquidityWindowAtr, dashboardNarrativeBias, ms_structureBias, ms_idmLevel, ms_idmState)
    [longCounterFound, longCounterPrice, longCounterLabel, longCounterDist, longCounterImportance, longCounterActionability, longCounterReasons, longCounterTier] = f_bestDirectionalLiquidity(close, false, "SSL", narrativeLiquidityWindowAtr, dashboardNarrativeBias, ms_structureBias, ms_idmLevel, ms_idmState)
    [dashEventStage, dashEventText] = f_resolveSweepDashboardState(structureStatusCode, dashboardNarrativeBias)
    string biasText = f_dashBiasText(dashboardNarrativeBias)
    string liquidityContextText = f_dashLiquidityText(shortCounterFound, shortCounterPrice, shortCounterLabel, longCounterFound, longCounterPrice, longCounterLabel, dashboardNarrativeBias)
    string structureText = f_dashStructureText(dashEventStage, structureStatusCode)
    string timingText = f_dashTimingText()
    string traderRead = f_dashTraderRead(dashEventStage, dashboardNarrativeBias, structureStatusCode)

    table.cell(tb, 0, 0, "CONTEXT", bgcolor=dashHeaderBg, text_color=dashHeaderText, text_size=size.small)
    table.cell(tb, 1, 0, "STATUS", bgcolor=dashHeaderBg, text_color=dashHeaderText, text_size=size.small)

    f_dashRow(tb, 1, "Bias", biasText, dashCellText, dashCellBg, dashCellText)
    f_dashRow(tb, 2, "Liquidity", liquidityContextText, dashCellText, dashCellBg, dashCellText)
    f_dashRow(tb, 3, "Event", dashEventText, dashCellText, dashCellBg, dashCellText)
    f_dashRow(tb, 4, "Structure", structureText, dashCellText, dashCellBg, dashCellText)
    f_dashRow(tb, 5, "Timing", timingText, dashCellText, dashCellBg, dashCellText)
    f_dashRow(tb, 6, "Read", traderRead, dashCellText, dashCellBg, dashCellText)

var table fvgDashTable = table.new(f_fvgDashPosition(fvgDashboardLocation), 3, 3, bgcolor=chart.bg_color, border_color=color.new(chart.fg_color, 78), border_width=1, frame_color=color.new(chart.fg_color, 78), frame_width=1)
if fvgShowDashboard and barstate.islast
    fvgDashSize = f_fvgDashTextSize(fvgDashboardTextSize)
    color fvgDashText = f_themeTextColor()
    color fvgBullText = f_fvgSolidColor(fvgBullColor)
    color fvgBearText = f_fvgSolidColor(fvgBearColor)
    table.clear(fvgDashTable, 0, 0, 2, 2)
    table.cell(fvgDashTable, 1, 0, "Bullish", text_color=fvgBullText, bgcolor=chart.bg_color, text_size=fvgDashSize)
    table.cell(fvgDashTable, 2, 0, "Bearish", text_color=fvgBearText, bgcolor=chart.bg_color, text_size=fvgDashSize)
    table.cell(fvgDashTable, 0, 1, "Count", text_color=fvgDashText, bgcolor=chart.bg_color, text_size=fvgDashSize)
    table.cell(fvgDashTable, 0, 2, "Mitigated", text_color=fvgDashText, bgcolor=chart.bg_color, text_size=fvgDashSize)
    table.cell(fvgDashTable, 1, 1, str.tostring(fvgBullCount), text_color=fvgBullText, bgcolor=chart.bg_color, text_size=fvgDashSize)
    table.cell(fvgDashTable, 2, 1, str.tostring(fvgBearCount), text_color=fvgBearText, bgcolor=chart.bg_color, text_size=fvgDashSize)
    table.cell(fvgDashTable, 1, 2, f_fvgMitigatedText(fvgBullMitigatedCount, fvgBullCount), text_color=fvgBullText, bgcolor=chart.bg_color, text_size=fvgDashSize)
    table.cell(fvgDashTable, 2, 2, f_fvgMitigatedText(fvgBearMitigatedCount, fvgBearCount), text_color=fvgBearText, bgcolor=chart.bg_color, text_size=fvgDashSize)

fvgDynamicBullUpperPlot = plot(enableLuxFvgEngine and fvgDynamicMode ? fvgDynamicBullUpper : na, "FVG Dynamic Bull Upper", color=na)
fvgDynamicBullLowerPlot = plot(enableLuxFvgEngine and fvgDynamicMode ? fvgDynamicBullLower : na, "FVG Dynamic Bull Lower", color=na)
fill(fvgDynamicBullUpperPlot, fvgDynamicBullLowerPlot, color=enableLuxFvgEngine and fvgDynamicMode ? fvgBullColor : na, title="Bullish FVG Fill")

fvgDynamicBearUpperPlot = plot(enableLuxFvgEngine and fvgDynamicMode ? fvgDynamicBearUpper : na, "FVG Dynamic Bear Upper", color=na)
fvgDynamicBearLowerPlot = plot(enableLuxFvgEngine and fvgDynamicMode ? fvgDynamicBearLower : na, "FVG Dynamic Bear Lower", color=na)
fill(fvgDynamicBearUpperPlot, fvgDynamicBearLowerPlot, color=enableLuxFvgEngine and fvgDynamicMode ? fvgBearColor : na, title="Bearish FVG Fill")

plot(showMsSwings ? msMajorSwingHigh : na, "MS Swing High", msSwingHighColor, msSwingMarkerSize, plot.style_circles, offset=-msMajorSwingLen)
plot(showMsSwings ? msMajorSwingLow : na, "MS Swing Low", msSwingLowColor, msSwingMarkerSize, plot.style_circles, offset=-msMajorSwingLen)

bool validSweepConfirmedAlert = bearSweep or bullSweep
bool msConfirmedAfterSweepAlert = (waitS and ((ms_bearChochSinceSweep and ms_lastBearChochBar == bar_index) or (msContinuationConfirmedS and ms_lastBearBosBar == bar_index) or (msOpposingProtectedLevelBrokenS and not msOpposingProtectedLevelBrokenS[1]))) or (waitL and ((ms_bullChochSinceSweep and ms_lastBullChochBar == bar_index) or (msContinuationConfirmedL and ms_lastBullBosBar == bar_index) or (msOpposingProtectedLevelBrokenL and not msOpposingProtectedLevelBrokenL[1])))

alertcondition(validSweepConfirmedAlert, "Unified Sweep Confirmed", "A unified sweep was validated with hard reclaim gates in devtrader.")
alertcondition(msConfirmedAfterSweepAlert, "MS Confirmation After Sweep", "Market structure confirmed the active sweep narrative with CHoCH, BOS, or protected-level damage.")
alertcondition(fvgBullNewThisBar, "Bullish FVG Detected", "Bullish FVG detected")
alertcondition(fvgBearNewThisBar, "Bearish FVG Detected", "Bearish FVG detected")
alertcondition(fvgBullMitigatedThisBar, "Bullish FVG Mitigated", "Bullish FVG mitigated")
alertcondition(fvgBearMitigatedThisBar, "Bearish FVG Mitigated", "Bearish FVG mitigated")
