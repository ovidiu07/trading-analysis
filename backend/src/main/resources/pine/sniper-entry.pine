// ── Adaptive Engine ──────────────────────────────────────────
profileMode     = input.string("AUTO", "Profile Mode", options = ["AUTO", "MANUAL"], group = grpAdaptive,
     tooltip = "AUTO: score threshold adapts based on recent win rate. MANUAL: uses fixed threshold.")
