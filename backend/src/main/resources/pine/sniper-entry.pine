//@version=6
indicator("SMC Clean Signals v6 [TradeJAudit]", "SMC v6", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 2000)

// ============================================================================
//  EURUSD SMC EXECUTION ENGINE VNEXT
//  Ground-up rebuild focused on:
//  - broker-session correct daily levels
//  - session-aware intraday liquidity
//  - explicit setup lifecycle state
//  - contextual MSS / displacement / zone selection
//  - low-clutter execution UX
// ============================================================================

// ============================================================================
//  1. CONSTANTS / ENUMS / TYPES
// ============================================================================
int DIR_NONE = 0
int DIR_BULL = 1
int DIR_BEAR = -1

int STATE_IDLE = 0
int STATE_CANDIDATE = 1
int STATE_ARMED = 2
int STATE_TRIGGERED = 3
int STATE_INVALIDATED = 4
int STATE_COMPLETED = 5

int STRAT_S1 = 1
int STRAT_S2 = 2
int STRAT_S3 = 3
int STRAT_S4 = 4
int STRAT_S5 = 5

int ZONE_NONE = 0
int ZONE_FVG = 1
int ZONE_OB = 2

int MAX_PASSIVE_FVG = 8
int MAX_PASSIVE_OB = 6
int MAX_DRAW_OBJECTS = 32

type SessionState
    string key
    string label
    bool enabled
    bool active
    bool started
    bool ended
    bool completedToday
    bool startedToday
    float liveHigh
    float liveLow
    int liveStartBar
    float drawHigh
    float drawLow
    int drawStartBar
    float prevHigh
    float prevLow
    int prevEndBar
    color baseColor

type LiquidityHit
    bool found
    int direction
    int priority
    string category
    string label
    float price
    float extreme
    int refBar
    string context

type StructureBreak
    bool found
    int direction
    float level
    int sourceBar
    int breakBar
    int score

type ZoneCandidate
    bool found
    int zoneType
    int direction
    float high
    float low
    int createdBar
    int score
    string label

type TradePlanState
    float entryPrice
    string entryModel
    float stopPrice
    string stopModel
    float tp1
    float tp2
    float runnerTarget
    string targetModel
    float invalidationPrice

type SetupState
    int strategyId
    string strategyLabel
    int direction
    int state
    string liquidityType
    string liquidityLabel
    float liquidityPrice
    int sweepBar
    float sweepExtreme
    float mssWatchLevel
    int mssWatchBar
    float mssLevel
    int mssBar
    int displacementScore
    int displacementBar
    int zoneType
    float zoneHigh
    float zoneLow
    int zoneBar
    float entryPrice
    string entryModel
    float stopPrice
    string stopModel
    float tp1
    float tp2
    float runnerTarget
    string targetModel
    int triggerBar
    float invalidationPrice
    string invalidationReason
    string waitingReason
    string explanation
    string confluenceSummary
    string contextLabel
    int expiryBar

type SetupUpdateResult
    SetupState setup
    bool startedThisBar
    bool publicSweepThisBar
    bool mssThisBar
    bool armedThisBar
    bool triggeredThisBar

stateText(int state) =>
    state == STATE_CANDIDATE ? "candidate" :
     state == STATE_ARMED ? "armed" :
     state == STATE_TRIGGERED ? "triggered" :
     state == STATE_INVALIDATED ? "invalidated" :
     state == STATE_COMPLETED ? "completed" : "idle"

dirText(int direction) =>
    direction == DIR_BULL ? "bullish" :
     direction == DIR_BEAR ? "bearish" : "neutral"

zoneText(int zoneType) =>
    zoneType == ZONE_FVG ? "FVG" :
     zoneType == ZONE_OB ? "Order Block" : "None"

strategyCode(int strategyId) =>
    strategyId == STRAT_S1 ? "S1" :
     strategyId == STRAT_S2 ? "S2" :
     strategyId == STRAT_S3 ? "S3" :
     strategyId == STRAT_S4 ? "S4" :
     strategyId == STRAT_S5 ? "S5" : "S?"

strategyLabel(int strategyId) =>
    strategyId == STRAT_S1 ? "Liquidity Raid -> MSS -> Zone" :
     strategyId == STRAT_S2 ? "Silver Bullet" :
     strategyId == STRAT_S3 ? "PO3 / AMD" :
     strategyId == STRAT_S4 ? "Judas Swing" :
     strategyId == STRAT_S5 ? "SMT Reversal" : "Unknown"

newSession(string key, string label, color baseColor) =>
    SessionState.new(key, label, true, false, false, false, false, false, na, na, na, na, na, na, na, na, na, baseColor)

newLiquidityHit() =>
    LiquidityHit.new(false, DIR_NONE, -1, "", "", na, na, na, "")

newStructureBreak() =>
    StructureBreak.new(false, DIR_NONE, na, na, na, 0)

newZoneCandidate() =>
    ZoneCandidate.new(false, ZONE_NONE, DIR_NONE, na, na, na, 0, "")

newTradePlan() =>
    TradePlanState.new(na, "", na, "", na, na, na, "", na)

newSetup(int strategyId) =>
    SetupState.new(
         strategyId, strategyLabel(strategyId), DIR_NONE, STATE_IDLE,
         "", "", na, na, na, na, na, na, na, 0, na,
         ZONE_NONE, na, na, na, na, "", na, "", na, na, na, "",
         na, na, "", "", "", "", "", na)

newSetupUpdateResult(SetupState setupRef) =>
    SetupUpdateResult.new(setupRef, false, false, false, false, false)

// ============================================================================
//  2. INPUTS
// ============================================================================
grpFoundation = "1. Foundation"
grpSessions = "2. Sessions"
grpLiquidity = "3. Liquidity Map"
grpStructure = "4. Structure / Displacement"
grpZones = "5. Zone Engine"
grpStrategies = "6. Strategy Engines"
grpExecution = "7. Execution Model"
grpDisplay = "8. Display"
grpPerformance = "9. Performance"
grpWebhook = "10. TradingView Webhook"
grpDebug = "11. QA / Debug"
grpDashSize = "8A. Dashboard Sizing"
grpHistTrades = "8B. Historical Trade Display"
grpClrDashboard = "8C. Dashboard Colors"
grpClrSessions = "8D. Session Colors"
grpClrTrades = "8E. Trade / Projection Colors"
grpClrZones = "8F. Zone / Marker Colors"
grpClrQa = "11B. QA Colors"

marketProfile = input.string("Forex ICT", "Market Profile", options = ["Forex ICT", "US Indices", "Crypto 24/7", "Custom"], group = grpFoundation, tooltip = "Selects the asset class profile which tunes sweep buffers, FVG thresholds, and risk limits. Forex ICT is optimized for EUR/USD and major pairs; US Indices widens tolerances for higher volatility; Crypto 24/7 adjusts for round-the-clock markets.")
profilePreset = input.string("Auto", "Execution Profile", options = ["Auto", "Scalping 1m-3m", "Intraday 5m-15m", "Swing Intraday 30m-60m"], group = grpFoundation, tooltip = "Controls pivot lengths, displacement thresholds, and stage windows. Auto detects from chart timeframe. Override manually if your timeframe doesn't match the preset ranges.")
useHtfBias = input.bool(true, "Require HTF Bias Alignment", group = grpFoundation, tooltip = "When enabled, setups must align with the higher-timeframe EMA trend direction. Disabling allows counter-trend entries but increases noise.")
htfBiasTf = input.timeframe("240", "HTF Bias Timeframe", group = grpFoundation, tooltip = "The higher timeframe used to determine trend bias via 20/50 EMA alignment. Default 4H works well for 5m-15m execution charts. Use Daily for swing setups.")
requireExecutionTfGate = input.bool(true, "Enforce Max Execution Timeframe", group = grpFoundation, tooltip = "Prevents the indicator from generating signals on timeframes above the configured maximum. Keeps execution precise on lower timeframes.")
maxExecutionTfMinutes = input.int(60, "Max Execution TF (minutes)", minval = 1, maxval = 240, group = grpFoundation, tooltip = "Maximum chart timeframe in minutes that allows trade signals. Set higher for swing trading approaches, lower for pure scalping.")
executionMode = input.string("Confirmed Close", "Execution Mode", options = ["Confirmed Close", "Aggressive Intrabar"], group = grpFoundation, tooltip = "Confirmed Close waits for the bar to close before confirming MSS breaks and triggers, reducing false signals. Aggressive Intrabar reacts immediately but may trigger on wicks that reverse.")
timeBasis = input.string("Auto", "Session Time Basis", options = ["Auto", "UTC", "New York (ICT)", "Local-per-session", "Custom"], group = grpFoundation, tooltip = "Controls which timezone is used for session window calculations. Auto selects New York for Forex/Indices and UTC for Crypto. ICT traders should use New York.")
customTz = input.string("Etc/UTC", "Custom IANA Timezone", group = grpFoundation, active = timeBasis == "Custom", tooltip = "Enter a valid IANA timezone string (e.g. America/Chicago, Europe/London) when Time Basis is set to Custom.")

londonEnabled = input.bool(true, "London Session", group = grpSessions, tooltip = "Enables London session tracking for liquidity sweeps, session high/low levels, and kill zone awareness. Core session for ICT models.")
londonSession = input.session("0700-1100", "London Active Range", group = grpSessions, tooltip = "The active kill zone hours for the London session in local session timezone. Default covers the primary London liquidity window.")
newYorkEnabled = input.bool(true, "New York Session", group = grpSessions, tooltip = "Enables New York session tracking. The NY kill zone and London-NY overlap are high-probability windows for ICT setups.")
newYorkSession = input.session("1300-1700", "New York Active Range", group = grpSessions, tooltip = "Active kill zone hours for the New York session. Adjust if trading different NY sub-sessions or if your broker offset differs.")
tokyoEnabled = input.bool(true, "Tokyo Session", group = grpSessions, tooltip = "Enables Tokyo session tracking. Useful for Asian range definition and as a liquidity pool reference for London sweeps.")
tokyoSession = input.session("0000-0600", "Tokyo Active Range", group = grpSessions, tooltip = "Active hours for the Tokyo session in local session timezone.")
sydneyEnabled = input.bool(false, "Sydney Session", group = grpSessions, tooltip = "Enables Sydney session tracking. Usually disabled for Forex ICT models but useful for AUD pairs or Crypto.")
sydneySession = input.session("2200-0200", "Sydney Active Range", group = grpSessions, tooltip = "Active hours for the Sydney session in local session timezone.")
asiaRangeSession = input.session("0000-0700", "Asia Range Session", group = grpSessions, tooltip = "Defines the consolidation range that London and Judas setups reference for liquidity sweeps. Covers the overnight Asian accumulation period.")
silverBulletLondon = input.session("0800-0900", "Silver Bullet London", group = grpSessions, tooltip = "ICT Silver Bullet window during London session. FVG entries within this window qualify for S2 Silver Bullet setups.")
silverBulletNyAm = input.session("1500-1600", "Silver Bullet NY AM", group = grpSessions, tooltip = "ICT Silver Bullet window during New York AM session. One of the highest-probability intraday FVG windows.")
silverBulletNyPm = input.session("1900-2000", "Silver Bullet NY PM", group = grpSessions, tooltip = "ICT Silver Bullet window during New York PM session. Lower volume but can produce clean setups in trending conditions.")
judasSession = input.session("0500-1000", "Judas Window", group = grpSessions, tooltip = "The window during which Judas Swing false moves are detected. Covers the pre-London to early-London manipulation period.")
po3AccumulationSession = input.session("0000-0700", "PO3 Accumulation", group = grpSessions, tooltip = "Power of Three accumulation phase. Price builds a range during this period that is later swept in the manipulation phase.")
po3ManipulationSession = input.session("0700-1000", "PO3 Manipulation", group = grpSessions, tooltip = "Power of Three manipulation phase. The false move that sweeps accumulation range liquidity before reversing.")
po3DistributionSession = input.session("1300-1800", "PO3 Distribution", group = grpSessions, tooltip = "Power of Three distribution phase. The true directional move after manipulation, where S3 triggers are expected.")
sessionDisplayMode = input.string("Current Active Day", "Session Display", options = ["Active Only", "Active + Completed Today", "Current Active Day"], group = grpSessions, tooltip = "Controls which session high/low levels remain visible. Active Only shows only the current session; Current Active Day keeps all today's sessions visible for reference.")
showSessionBackground = input.bool(false, "Show Active Session Background", group = grpSessions, tooltip = "Tints the chart background during active session windows. Useful for visually identifying which session you are in.")

showPdhl = input.bool(true, "Show Previous Day High/Low", group = grpLiquidity, tooltip = "Draws horizontal lines at the previous day's high and low. These are primary liquidity targets for ICT-style sweeps.")
showSessionLevels = input.bool(true, "Show Session High/Low", group = grpLiquidity, tooltip = "Draws session high/low lines for visible sessions. These intraday levels serve as secondary liquidity targets.")
showEqualHighLow = input.bool(false, "Show Equal Highs/Lows", group = grpLiquidity, tooltip = "Detects and marks double tops/bottoms that represent resting liquidity. Enable to see EQH/EQL levels as potential sweep targets.")
useDailyOpen = input.bool(true, "Track Daily Open", group = grpLiquidity, tooltip = "Tracks the daily open price as a potential liquidity reference. Sweeps of the daily open can initiate setup candidates.")
equalToleranceAtr = input.float(0.08, "Equal High/Low Tolerance (ATR)", minval = 0.01, maxval = 0.50, step = 0.01, group = grpLiquidity, tooltip = "Maximum distance between two pivot highs/lows to be considered equal, as a fraction of ATR. Increase for volatile instruments; decrease for tight precision.")
equalMaxBarsApart = input.int(45, "Equal High/Low Max Separation Bars", minval = 5, maxval = 150, group = grpLiquidity, tooltip = "Maximum bar distance between two pivot points to qualify as equal highs/lows. Larger values find wider double tops/bottoms.")

manualInternalPivot = input.int(3, "Manual Internal Pivot Length", minval = 2, maxval = 8, group = grpStructure, tooltip = "Pivot lookback length for internal (short-term) swing detection. Lower values find more pivots with more noise; higher values find fewer but stronger swings. Only used when Execution Profile is not Auto.")
manualExternalPivot = input.int(8, "Manual External Pivot Length", minval = 4, maxval = 20, group = grpStructure, tooltip = "Pivot lookback for external (higher-timeframe) swing detection used in dealing range and bias calculation. Only used when Execution Profile is not Auto.")
manualDisplacementScore = input.int(62, "Manual Displacement Score", minval = 40, maxval = 90, group = grpStructure, tooltip = "Minimum displacement quality score (0-100) required for MSS confirmation. Higher values demand stronger impulsive candles, reducing signals but improving quality. Only used when Execution Profile is not Auto.")
manualStageWindow = input.int(18, "Manual Stage Window Bars", minval = 5, maxval = 80, group = grpStructure, tooltip = "Number of bars a setup remains valid from sweep to expiry. Shorter windows keep setups fresh; longer windows allow more time for zones to form. Only used when Execution Profile is not Auto.")
manualSweepBufferAtr = input.float(0.03, "Manual Sweep Buffer (ATR)", minval = 0.01, maxval = 0.20, step = 0.01, group = grpStructure, tooltip = "Minimum distance beyond a liquidity level that price must penetrate to count as a sweep, as ATR fraction. Increase to require deeper sweeps; decrease for more sensitive detection. Only used when Execution Profile is not Auto.")
requirePremiumDiscount = input.bool(true, "Use Premium / Discount Filter", group = grpStructure, tooltip = "Requires bullish entries in discount (below dealing range midpoint) and bearish entries in premium. Disabling removes this structural filter and allows entries anywhere in the range.")
useVolumeConfluence = input.bool(false, "Use Volume Confluence", group = grpStructure, tooltip = "Adds a volume component to the displacement score. Bars with volume above 1.25x the 20-bar average receive a bonus. Enable on instruments with reliable volume data.")
minimumBreakDistanceAtr = input.float(0.08, "Minimum MSS Break Distance (ATR)", minval = 0.01, maxval = 0.40, step = 0.01, group = grpStructure, tooltip = "Minimum distance the close must exceed the swing level to confirm a Market Structure Shift, as ATR fraction. Filters out marginal breaks that may be noise.")

enableFvg = input.bool(true, "Enable Fair Value Gaps", group = grpZones, tooltip = "Enables detection and storage of Fair Value Gaps (3-candle imbalances). FVGs are the primary entry zone type for most ICT setups.")
enableOb = input.bool(true, "Enable Order Blocks", group = grpZones, tooltip = "Enables detection of Order Blocks (last opposing candle before displacement). OBs serve as secondary entry zones when no qualifying FVG is found.")
zoneSelectionMode = input.string("FVG then OB", "Zone Selection", options = ["FVG then OB", "OB then FVG", "Best Quality"], group = grpZones, tooltip = "Priority order when both FVG and OB are available. FVG then OB prefers imbalance-based entries; Best Quality picks whichever has the higher score.")
experimentalStandaloneFvg = input.bool(false, "Experimental Standalone FVG", group = grpZones, tooltip = "Allows standalone FVG mitigation entries without requiring a prior liquidity sweep or MSS. More setups but lower conviction — treat as experimental.")
fvgEntryMode = input.string("CE Midpoint", "FVG Entry Model", options = ["CE Midpoint", "Proximal Edge"], group = grpZones, tooltip = "Where within the FVG the entry price is set. CE Midpoint (consequent encroachment) targets the middle for better fills; Proximal Edge enters at the nearest boundary for tighter risk.")
triggerModel = input.string("Zone Touch", "Trigger Model", options = ["Zone Touch", "Confirmation Close"], group = grpExecution, tooltip = "How the trade triggers when price reaches the zone. Zone Touch fires on any wick into the zone; Confirmation Close requires price to close through the zone with directional confirmation.")
minFvgAtr = input.float(0.15, "Min FVG Size (ATR)", minval = 0.05, maxval = 0.60, step = 0.01, group = grpZones, tooltip = "Minimum Fair Value Gap size as a fraction of ATR. Increase to ignore small, noisy gaps and focus on strong displacement zones; decrease for more setups at the cost of quality.")
fvgExpiryBars = input.int(50, "FVG Expiry Bars", minval = 10, maxval = 200, group = grpZones, tooltip = "Number of bars before an unfilled FVG expires and is removed. Shorter values keep only fresh zones; longer values allow older zones to remain as targets.")
obLookbackBars = input.int(6, "OB Origin Lookback Bars", minval = 2, maxval = 12, group = grpZones, tooltip = "How many bars back to search for the origin candle of an Order Block after displacement. Larger values find OBs further from the break; smaller values keep them proximal.")
obExpiryBars = input.int(80, "OB Expiry Bars", minval = 10, maxval = 200, group = grpZones, tooltip = "Number of bars before an unmitigated Order Block expires. OBs tend to remain relevant longer than FVGs, so this is typically set higher.")
maxActiveFvg = input.int(5, "Max Active FVGs Per Side", minval = 1, maxval = 8, group = grpZones, tooltip = "Maximum number of active FVGs tracked per direction. When exceeded, the oldest FVG is dropped. Higher values use more memory but retain more zone history.")
maxActiveOb = input.int(4, "Max Active OBs Per Side", minval = 1, maxval = 6, group = grpZones, tooltip = "Maximum number of active Order Blocks tracked per direction. When exceeded, the oldest OB is dropped.")
showPassiveZones = input.bool(false, "Show Passive Historical Zones", group = grpZones, tooltip = "Draws boxes for tracked FVGs and OBs that are not part of the active setup. Useful for seeing the full zone landscape on the chart.")
passiveZoneLimit = input.int(2, "Passive Zone Limit Per Type/Side", minval = 1, maxval = 4, group = grpZones, active = showPassiveZones, tooltip = "Maximum number of passive zones drawn per type (FVG/OB) per side (bull/bear). Keeps the chart uncluttered when passive zones are enabled.")

enableS1 = input.bool(true, "S1 Liquidity Raid -> MSS -> Zone", group = grpStrategies, tooltip = "The flagship ICT setup: liquidity sweep followed by Market Structure Shift into an FVG/OB retracement entry. Highest conviction when aligned with HTF bias.")
enableS2 = input.bool(true, "S2 Silver Bullet", group = grpStrategies, tooltip = "ICT Silver Bullet model: time-window constrained FVG entries during specific kill zone hours. Requires sweep + MSS within the Silver Bullet window.")
enableS3 = input.bool(false, "S3 PO3 / AMD (Experimental)", group = grpStrategies, tooltip = "Power of Three / Accumulation-Manipulation-Distribution model. Detects overnight range buildup, manipulation sweep, and distribution entry. Experimental — enable with caution.")
enableS4 = input.bool(false, "S4 Judas Swing (Experimental)", group = grpStrategies, tooltip = "Judas Swing model: detects false breakouts around session opens (Asia range, Daily Open, or London pre-range) that reverse sharply. Experimental — enable with caution.")
enableS5 = input.bool(false, "S5 SMT Reversal", group = grpStrategies, tooltip = "Smart Money Technique divergence reversal: confirms setups when the comparison symbol fails to make a corresponding new high/low, signaling institutional divergence.")
strategyPriority = input.string("S1,S2,S3,S4,S5", "Strategy Priority Order", group = grpStrategies, tooltip = "Comma-separated priority ranking when multiple strategies trigger simultaneously. The leftmost strategy wins ties. Reorder to prefer your highest-conviction model.")
judasAnchor = input.string("Asia Range", "Judas Anchor", options = ["Asia Range", "Daily Open", "London Pre-Range"], group = grpStrategies, tooltip = "The reference level for Judas Swing false move detection. Asia Range is the classic ICT anchor; Daily Open works for indices; London Pre-Range for early European sessions.")
smtSymbol = input.symbol("", "SMT Comparison Symbol", group = grpStrategies, active = enableS5, tooltip = "The correlated instrument to compare for SMT divergence. For EUR/USD, use GBP/USD or DXY. Leave empty to disable S5.")
smtCorrelation = input.string("Positive", "SMT Correlation", options = ["Positive", "Negative"], group = grpStrategies, active = enableS5, tooltip = "Whether the comparison symbol is positively correlated (e.g. EUR/USD vs GBP/USD) or negatively correlated (e.g. EUR/USD vs DXY). Affects divergence detection logic.")
smtPivotLength = input.int(3, "SMT Pivot Length", minval = 2, maxval = 8, group = grpStrategies, active = enableS5, tooltip = "Pivot lookback length for the SMT comparison symbol's swing detection. Should match or be close to the internal pivot length for consistent divergence comparison.")

entryModel = input.string("Auto", "Entry Model", options = ["Auto", "FVG Only", "OB Only", "Confirmation Close"], group = grpExecution, tooltip = "Controls which zone types are accepted for entries. Auto uses the zone selection mode; FVG Only or OB Only restrict to a single zone type; Confirmation Close requires a directional close through the zone.")
stopModel = input.string("Hybrid Buffer", "Stop Model", options = ["Beyond Sweep Extreme", "Beyond Zone Boundary", "Hybrid Buffer"], group = grpExecution, tooltip = "Where the stop-loss is placed. Beyond Sweep Extreme uses the sweep wick; Beyond Zone Boundary uses the zone edge; Hybrid Buffer takes the more protective of both. Hybrid is recommended for most setups.")
targetModel = input.string("Partials + Runner", "Target Model", options = ["Fixed RR", "Opposing Liquidity", "Partials + Runner"], group = grpExecution, tooltip = "How take-profit targets are calculated. Fixed RR uses a simple risk multiple; Opposing Liquidity targets the nearest opposing level; Partials + Runner takes partial profit at TP1 and lets a runner target TP2 or opposing liquidity.")
fixedRr = input.float(2.5, "Fixed RR", minval = 1.0, maxval = 10.0, step = 0.1, group = grpExecution, tooltip = "Risk-to-reward ratio for Fixed RR target model, or fallback when opposing liquidity is not found. 2.5R is a balanced default for intraday setups.")
partialR1 = input.float(1.5, "Partial TP1 (R)", minval = 0.5, maxval = 5.0, step = 0.1, group = grpExecution, active = targetModel == "Partials + Runner", tooltip = "First partial take-profit level as a risk multiple. Taking partials at 1.5R locks in profit and reduces psychological pressure on the runner.")
runnerR2 = input.float(3.0, "Runner TP2 (R)", minval = 1.0, maxval = 10.0, step = 0.1, group = grpExecution, active = targetModel == "Partials + Runner", tooltip = "Runner target level as a risk multiple. Used as the final target unless opposing liquidity provides a closer or better target.")
partialClosePct = input.float(50.0, "Partial Close %", minval = 10.0, maxval = 90.0, step = 5.0, group = grpExecution, active = targetModel == "Partials + Runner", tooltip = "Percentage of position closed at TP1. Higher values lock in more profit early but leave a smaller runner. 50% is balanced; 70%+ is conservative.")
moveRunnerToBe = input.bool(true, "Move Runner To BE After TP1", group = grpExecution, active = targetModel == "Partials + Runner", tooltip = "After TP1 is hit, moves the stop-loss to breakeven for the remaining runner position. Eliminates downside risk on the runner but may get stopped out on shallow pullbacks.")
riskBufferAtr = input.float(0.12, "Risk Buffer (ATR)", minval = 0.01, maxval = 0.50, step = 0.01, group = grpExecution, tooltip = "Extra padding added beyond the stop-loss placement level, as ATR fraction. Protects against stop hunts on tight stops. Increase for volatile pairs; decrease for precision scalping.")
maxRiskAtr = input.float(1.75, "Max Allowed Risk (ATR)", minval = 0.50, maxval = 4.00, step = 0.05, group = grpExecution, tooltip = "Maximum allowed distance between entry and stop-loss as ATR multiple. Setups with wider risk are rejected. Increase for swing setups; keep tight for scalps.")
useTimeStop = input.bool(false, "Use Time Stop", group = grpExecution, tooltip = "Enables a time-based stop that closes the trade if neither TP nor SL is hit within the specified number of bars. Useful for preventing stale trades from lingering.")
timeStopBars = input.int(24, "Time Stop (bars)", minval = 4, maxval = 240, group = grpExecution, active = useTimeStop, tooltip = "Number of bars after entry before the time stop triggers. On 5m chart, 24 bars = 2 hours. Adjust based on your expected trade duration and timeframe.")

showDashboard = input.bool(true, "Show Dashboard", group = grpDisplay, tooltip = "Shows the information dashboard table on the chart. Disable to reduce visual clutter when you only need chart-level signals.")
showExplanation = input.bool(true, "Show Plain-English Explanation", group = grpDisplay, tooltip = "Adds a row to the dashboard with a plain-English description of the current setup state, including sweep source, MSS level, zone type, and entry plan.")
showSelectedLiquidity = input.bool(true, "Show Setup Liquidity / MSS Lines", group = grpDisplay, tooltip = "Draws lines on the chart showing the swept liquidity level and the MSS break level for the active setup. Helps visualize the narrative flow of the trade.")
showProjectedZone = input.bool(true, "Show Setup Projections", group = grpDisplay, tooltip = "Draws projected risk/reward boxes and zone fill for armed and triggered setups. Shows where the trade plans to enter, stop, and target.")
showTradeLevels = input.bool(true, "Show Triggered Trade Levels", group = grpDisplay, tooltip = "Draws entry, stop, TP1, and TP2 lines on the chart when a trade is triggered or active. Essential for monitoring live trade levels.")
showStepMarkers = input.bool(true, "Show Step Markers", group = grpDisplay, tooltip = "Shows numbered markers at each setup lifecycle step: 1=sweep, 2=MSS, 3=armed, 4=triggered. Useful for understanding when and where each step occurred.")
showPassiveZoneLabels = input.bool(false, "Show Passive Zone Labels", group = grpDisplay, active = showPassiveZones, tooltip = "Adds text labels to passive zone boxes identifying them as Bull/Bear FVG or OB. Disable for cleaner charts when zone colors are sufficient.")
dashboardPosition = input.string("Bottom Right", "Dashboard Position", options = ["Bottom Right", "Bottom Left", "Top Right"], group = grpDisplay, tooltip = "Controls where the dashboard table appears on the chart. Bottom Right is default; move to Top Right if it overlaps with price action.")

minClosedTradesForWinRate = input.int(10, "Min Closed Trades For Win Rate", minval = 1, maxval = 100, group = grpPerformance, tooltip = "Minimum number of decisive (non-ambiguous) closed trades before win rate is displayed. Prevents misleading statistics from small sample sizes.")
trackExperimentalInStats = input.bool(false, "Include Experimental Signals In Stats", group = grpPerformance, active = experimentalStandaloneFvg, tooltip = "When enabled, experimental standalone FVG trades are included in the performance statistics. Disable to keep stats pure for core strategy signals only.")
showPerformanceRows = input.bool(true, "Show Performance Rows", group = grpPerformance, tooltip = "Shows win rate, expectancy, net R, and other performance metrics in the dashboard. Disable to reduce dashboard size when you only need setup information.")

emitOpenAlerts = input.bool(true, "Emit SIGNAL_OPEN Alerts", group = grpWebhook, tooltip = "Fires a TradingView alert with JSON payload when a trade is triggered. Required for webhook integration with your backend or automation system.")
emitCloseAlerts = input.bool(false, "Emit SIGNAL_CLOSE Alerts", group = grpWebhook, tooltip = "Fires a TradingView alert with JSON payload when a tracked trade closes (SL, TP, or time stop). Enable for full trade lifecycle tracking via webhooks.")
webhookToken = input.string("", "Webhook Auth Token", group = grpWebhook, tooltip = "Authentication token included in webhook JSON payloads. Set this to match your backend webhook receiver for request validation. Leave empty if not using webhooks.")
webhookSource = input.string("TRADEJAUDIT_PINE_V2", "Webhook Source Tag", group = grpWebhook, tooltip = "Source identifier string included in webhook payloads. Used to distinguish signals from different indicator instances or versions in your backend.")

qaDailyDebug = input.bool(false, "QA: Show Previous Daily Bar Debug", group = grpDebug, tooltip = "Shows a debug label and dashboard row with the previous daily bar timestamp, PDH, and PDL values. Use to verify daily level accuracy across broker feeds.")
qaSessionDebug = input.bool(false, "QA: Show Session Debug Label", group = grpDebug, tooltip = "Shows a debug label with current session state, previous session highs/lows, and Asia range values. Use to verify session detection and timezone calculations.")
qaExplainReasons = input.bool(true, "QA: Keep Waiting / Invalidation Reasons", group = grpDebug, tooltip = "Preserves detailed waiting and invalidation reason text in the dashboard. Disable to simplify display when you are confident in the setup logic.")

// --- 8A. Dashboard Sizing ---
dashboardSizePreset = input.string("Normal", "Dashboard Size", options = ["Small", "Normal", "Large"], group = grpDashSize, tooltip = "Controls the overall dashboard footprint. Small reduces rows and uses smaller text for compact screens. Normal is the default layout. Large increases readability with bigger text.")
dashboardShowExtendedRows = input.bool(true, "Show Extended Rows", group = grpDashSize, tooltip = "When disabled in Normal/Large mode, hides confluence, displacement detail, and explanation rows to reduce dashboard height. Always hidden in Small mode.")

// --- 8B. Historical Trade Display ---
showClosedTradesOnChart = input.bool(true, "Show Closed Trades On Chart", group = grpHistTrades, tooltip = "Draws visual history of recently closed trades showing entry, stop, target zones, and result labels. Lets you see past trade execution quality at a glance.")
closedTradeRenderLimit = input.int(10, "Closed Trade Render Limit", minval = 1, maxval = 30, group = grpHistTrades, tooltip = "Maximum number of recent closed trades to render on the chart. Higher values show more history but use more drawing objects. Keep low on busy charts.")
showClosedTradeLabels = input.bool(true, "Show Closed Trade Labels", group = grpHistTrades, tooltip = "Adds a compact result label to each closed trade showing strategy, direction, R-multiple, and close reason.")
showClosedTradeTp1 = input.bool(true, "Show Closed Trade TP1 Line", group = grpHistTrades, tooltip = "Draws the TP1 level on closed trades when it differs from the final target. Useful for seeing where partials were taken.")
closedTradeLabelMode = input.string("Compact", "Closed Trade Label Mode", options = ["Compact", "Detailed"], group = grpHistTrades, tooltip = "Compact shows strategy code, result, and R-multiple. Detailed adds entry/SL/TP prices and close reason text.")

// --- 8C. Dashboard Colors ---
clrDashBg = input.color(color.rgb(8, 11, 24), "Dashboard Background", group = grpClrDashboard, tooltip = "Background color for the main dashboard table body.")
clrDashHeaderBg = input.color(color.rgb(14, 19, 44), "Dashboard Header Background", group = grpClrDashboard, tooltip = "Background color for the dashboard title/header row.")
clrDashLabelText = input.color(color.new(color.white, 20), "Dashboard Label Text", group = grpClrDashboard, tooltip = "Text color for left-column row labels in the dashboard.")
clrDashValueText = input.color(color.white, "Dashboard Value Text", group = grpClrDashboard, tooltip = "Default text color for right-column values in the dashboard.")
clrDashBullText = input.color(#00c27a, "Dashboard Bullish Text", group = grpClrDashboard, tooltip = "Text color used for bullish-aligned values in the dashboard (HTF bias, win rate, positive R).")
clrDashBearText = input.color(#ff4d6d, "Dashboard Bearish Text", group = grpClrDashboard, tooltip = "Text color used for bearish-aligned values in the dashboard (bearish bias, negative R).")
clrDashNeutralText = input.color(color.gray, "Dashboard Neutral Text", group = grpClrDashboard, tooltip = "Text color for neutral or inactive dashboard values.")
clrDashWarningText = input.color(color.orange, "Dashboard Warning Text", group = grpClrDashboard, tooltip = "Text color for warning-level dashboard values (moderate win rate, transitional regime).")

// --- 8D. Session Colors ---
clrSessionLondon = input.color(#38bdf8, "London Session", group = grpClrSessions, tooltip = "Base color for London session high/low levels and background tint.")
clrSessionNewYork = input.color(#10b981, "New York Session", group = grpClrSessions, tooltip = "Base color for New York session high/low levels and background tint.")
clrSessionTokyo = input.color(#8b5cf6, "Tokyo Session", group = grpClrSessions, tooltip = "Base color for Tokyo session high/low levels and background tint.")
clrSessionSydney = input.color(#ec4899, "Sydney Session", group = grpClrSessions, tooltip = "Base color for Sydney session high/low levels and background tint.")
clrSessionOverlap = input.color(color.orange, "Session Overlap", group = grpClrSessions, tooltip = "Color used when London and New York sessions overlap.")

// --- 8E. Trade / Projection Colors ---
clrBull = input.color(#00c27a, "Bullish Bias", group = grpClrTrades, tooltip = "Primary color for bullish direction indicators, projection borders, and bias display.")
clrBear = input.color(#ff4d6d, "Bearish Bias", group = grpClrTrades, tooltip = "Primary color for bearish direction indicators, projection borders, and bias display.")
clrEntryLine = input.color(color.white, "Entry Line", group = grpClrTrades, tooltip = "Color for the entry price level line on active and projected trades.")
clrStopLine = input.color(#ff4d6d, "Stop-Loss Line", group = grpClrTrades, tooltip = "Color for the stop-loss price level line on active and projected trades.")
clrTp1Line = input.color(#00c27a, "TP1 Line", group = grpClrTrades, tooltip = "Color for the first take-profit level line.")
clrTp2Line = input.color(color.new(#00c27a, 20), "TP2 / Runner Line", group = grpClrTrades, tooltip = "Color for the second take-profit / runner target level line.")
clrRewardBox = input.color(#10b981, "Reward Zone Fill", group = grpClrTrades, tooltip = "Fill color for the reward (entry-to-target) projection box.")
clrRiskBox = input.color(#ff4d6d, "Risk Zone Fill", group = grpClrTrades, tooltip = "Fill color for the risk (entry-to-stop) projection box.")
clrMssLine = input.color(color.white, "MSS Level Line", group = grpClrTrades, tooltip = "Color for the Market Structure Shift level line drawn during setup projection.")
clrPdhl = input.color(#f59e0b, "PDH / PDL Lines", group = grpClrTrades, tooltip = "Color for Previous Day High and Previous Day Low level lines.")
clrHistoryWin = input.color(#10b981, "Closed Trade Win", group = grpClrTrades, tooltip = "Color for closed trades that ended in profit (reward box and label).")
clrHistoryLoss = input.color(#ef4444, "Closed Trade Loss", group = grpClrTrades, tooltip = "Color for closed trades that ended in a loss (risk box and label).")
clrHistoryAmbiguous = input.color(#f59e0b, "Closed Trade Ambiguous", group = grpClrTrades, tooltip = "Color for closed trades with ambiguous outcomes (simultaneous TP/SL bar).")

// --- 8F. Zone / Marker Colors ---
clrFvgBull = input.color(#4f46e5, "FVG Bullish", group = grpClrZones, tooltip = "Fill and border color for bullish Fair Value Gap zones.")
clrFvgBear = input.color(#fb7185, "FVG Bearish", group = grpClrZones, tooltip = "Fill and border color for bearish Fair Value Gap zones.")
clrObBull = input.color(#10b981, "OB Bullish", group = grpClrZones, tooltip = "Fill and border color for bullish Order Block zones.")
clrObBear = input.color(#ef4444, "OB Bearish", group = grpClrZones, tooltip = "Fill and border color for bearish Order Block zones.")
clrEqHigh = input.color(#fb7185, "Equal Highs", group = grpClrZones, tooltip = "Color for Equal Highs (EQH) level lines.")
clrEqLow = input.color(#34d399, "Equal Lows", group = grpClrZones, tooltip = "Color for Equal Lows (EQL) level lines.")
clrSweepBull = input.color(#00c27a, "Sweep Marker Bullish", group = grpClrZones, tooltip = "Color for bullish liquidity sweep step markers on the chart.")
clrSweepBear = input.color(#ff4d6d, "Sweep Marker Bearish", group = grpClrZones, tooltip = "Color for bearish liquidity sweep step markers on the chart.")
clrExperimentalBull = input.color(#4f46e5, "Experimental Bull FVG", group = grpClrZones, tooltip = "Color for experimental standalone bullish FVG trigger markers.")
clrExperimentalBear = input.color(#fb7185, "Experimental Bear FVG", group = grpClrZones, tooltip = "Color for experimental standalone bearish FVG trigger markers.")

// --- 11B. QA Colors ---
clrQaLabel = input.color(color.yellow, "QA Label Text", group = grpClrQa, tooltip = "Text color for QA/debug labels and dashboard rows.")
clrQaBg = input.color(color.rgb(30, 20, 60), "QA Label Background", group = grpClrQa, tooltip = "Background color for QA/debug labels.")


// ============================================================================
//  3. FOUNDATION HELPERS
// ============================================================================
clamp(float value, float low, float high) =>
    math.max(low, math.min(high, value))

safeRange(float h, float l) =>
    math.max(h - l, syminfo.mintick)

colorWithOpacity(color baseColor, int opacity) =>
    color.new(baseColor, int(clamp(opacity, 0, 100)))

isTrackedSession(string sessionKey) =>
    sessionKey == "LDN" or sessionKey == "NY" or sessionKey == "TKY"

tzForSession(string localTz) =>
    string effectiveBasis = timeBasis == "Auto" ? (marketProfile == "Crypto 24/7" ? "UTC" : "New York (ICT)") : timeBasis
    effectiveBasis == "UTC" ? "Etc/UTC" :
     effectiveBasis == "New York (ICT)" ? "America/New_York" :
     effectiveBasis == "Local-per-session" ? localTz : customTz

globalTz() =>
    string effectiveBasis = timeBasis == "Auto" ? (marketProfile == "Crypto 24/7" ? "UTC" : "New York (ICT)") : timeBasis
    effectiveBasis == "UTC" ? "Etc/UTC" :
     effectiveBasis == "New York (ICT)" ? "America/New_York" :
     effectiveBasis == "Custom" ? customTz : "America/New_York"

qualityLabel(int score) =>
    score >= 78 ? "A" :
     score >= 68 ? "B" :
     score >= 58 ? "C" : "Weak"

sanitizeSymbol(string value) =>
    str.replace_all(str.replace_all(str.replace_all(value, ":", "_"), ".", "_"), "/", "_")

normalizeTimeframeId(string tf) =>
    tf == "1H" ? "60" : tf == "4H" ? "240" : tf == "1D" ? "D" : tf

buildExternalTradeId(string setupType, string direction, int signalTime) =>
    "tv-" + sanitizeSymbol(syminfo.tickerid) + "-" + normalizeTimeframeId(timeframe.period) + "-" + str.tostring(signalTime) + "-" + str.lower(direction) + "-" + str.lower(setupType)

jsonStr(string value) =>
    "\"" + value + "\""

jsonNum(float value) =>
    na(value) ? "null" : str.tostring(value)

profileIsScalp() =>
    timeframe.in_seconds() / 60.0 <= 3

profileIsSwingIntraday() =>
    timeframe.in_seconds() / 60.0 >= 30

// Series values used by several modules.
chartTfMinutes = timeframe.in_seconds() / 60.0
execTfOk = not requireExecutionTfGate or chartTfMinutes <= maxExecutionTfMinutes
confirmedMode = executionMode == "Confirmed Close"
barConfirmedOk = not confirmedMode or barstate.isconfirmed

string tzLondon = tzForSession("Europe/London")
string tzNewYork = tzForSession("America/New_York")
string tzTokyo = tzForSession("Asia/Tokyo")
string tzSydney = tzForSession("Australia/Sydney")
string tzMain = globalTz()

resolvedMinFvgAtr = marketProfile == "US Indices" ? math.max(minFvgAtr, 0.18) :
     marketProfile == "Crypto 24/7" ? math.max(minFvgAtr, 0.16) : minFvgAtr
resolvedMaxRiskAtr = marketProfile == "US Indices" ? maxRiskAtr * 1.15 :
     marketProfile == "Crypto 24/7" ? maxRiskAtr * 1.20 : maxRiskAtr

profileInternalPivot = profilePreset == "Scalping 1m-3m" ? 2 :
     profilePreset == "Intraday 5m-15m" ? 3 :
     profilePreset == "Swing Intraday 30m-60m" ? 4 :
     profileIsScalp() ? 2 : profileIsSwingIntraday() ? 4 : 3

profileExternalPivot = profilePreset == "Scalping 1m-3m" ? 6 :
     profilePreset == "Intraday 5m-15m" ? 8 :
     profilePreset == "Swing Intraday 30m-60m" ? 10 :
     profileIsScalp() ? 6 : profileIsSwingIntraday() ? 10 : 8

profileDispScore = profilePreset == "Scalping 1m-3m" ? 58 :
     profilePreset == "Intraday 5m-15m" ? 62 :
     profilePreset == "Swing Intraday 30m-60m" ? 66 :
     profileIsScalp() ? 58 : profileIsSwingIntraday() ? 66 : 62

profileStageWindow = profilePreset == "Scalping 1m-3m" ? 24 :
     profilePreset == "Intraday 5m-15m" ? 18 :
     profilePreset == "Swing Intraday 30m-60m" ? 12 :
     profileIsScalp() ? 24 : profileIsSwingIntraday() ? 12 : 18

profileSweepBuffer = profilePreset == "Scalping 1m-3m" ? 0.025 :
     profilePreset == "Intraday 5m-15m" ? 0.030 :
     profilePreset == "Swing Intraday 30m-60m" ? 0.040 :
     profileIsScalp() ? 0.025 : profileIsSwingIntraday() ? 0.040 : 0.030

internalPivotLen = profilePreset == "Auto" ? profileInternalPivot : manualInternalPivot
externalPivotLen = profilePreset == "Auto" ? profileExternalPivot : manualExternalPivot
displacementMinScore = profilePreset == "Auto" ? profileDispScore : manualDisplacementScore
stageWindowBars = profilePreset == "Auto" ? profileStageWindow : manualStageWindow
sweepBufferAtr = profilePreset == "Auto" ? profileSweepBuffer : manualSweepBufferAtr
resolvedSweepBufferAtr = marketProfile == "US Indices" ? sweepBufferAtr * 1.10 :
     marketProfile == "Crypto 24/7" ? sweepBufferAtr * 1.15 : sweepBufferAtr

atr14 = ta.atr(14)
avgRange20 = ta.sma(high - low, 20)
avgBody20 = ta.sma(math.abs(close - open), 20)
avgVolume20 = ta.sma(volume, 20)
barRange = safeRange(high, low)
bodySize = math.abs(close - open)
bodyRatio = bodySize / barRange
bullCloseLocation = (close - low) / barRange
bearCloseLocation = (high - close) / barRange
bullCandle = close > open
bearCandle = close < open
sweepBuffer = math.max(syminfo.mintick * 3.0, atr14 * resolvedSweepBufferAtr)

// ============================================================================
//  4. TIME / SESSION FOUNDATION
// ============================================================================
isInSession(string sessionSpec, string tzId) =>
    not na(time(timeframe.period, sessionSpec, tzId))

sessionDayChanged = ta.change(time("D", "", tzMain)) != 0

inLondon = londonEnabled and isInSession(londonSession, tzLondon)
inNewYork = newYorkEnabled and isInSession(newYorkSession, tzNewYork)
inTokyo = tokyoEnabled and isInSession(tokyoSession, tzTokyo)
inSydney = sydneyEnabled and isInSession(sydneySession, tzSydney)
inAsiaRange = isInSession(asiaRangeSession, tzMain)
inSbLondon = isInSession(silverBulletLondon, tzLondon)
inSbNyAm = isInSession(silverBulletNyAm, tzNewYork)
inSbNyPm = isInSession(silverBulletNyPm, tzNewYork)
inSilverBullet = inSbLondon or inSbNyAm or inSbNyPm
inJudas = isInSession(judasSession, tzMain)
inPo3Accum = isInSession(po3AccumulationSession, tzMain)
inPo3Manip = isInSession(po3ManipulationSession, tzMain)
inPo3Dist = isInSession(po3DistributionSession, tzMain)
inOverlap = inLondon and inNewYork

activeSessionText = inOverlap ? "London + New York" :
     inLondon ? "London" :
     inNewYork ? "New York" :
     inTokyo ? "Tokyo" :
     inSydney ? "Sydney" : "Off Session"

activeSessionColor = inOverlap ? color.new(clrSessionOverlap, 0) :
     inLondon ? color.new(clrSessionLondon, 0) :
     inNewYork ? color.new(clrSessionNewYork, 0) :
     inTokyo ? color.new(clrSessionTokyo, 0) :
     inSydney ? color.new(clrSessionSydney, 0) : color.new(color.gray, 0)

sessionBgColor = showSessionBackground ? (inOverlap ? color.new(clrSessionOverlap, 90) :
     inLondon ? color.new(clrSessionLondon, 94) :
     inNewYork ? color.new(clrSessionNewYork, 94) :
     inTokyo ? color.new(clrSessionTokyo, 94) :
     inSydney ? color.new(clrSessionSydney, 94) : na) : na
bgcolor(sessionBgColor)

updateSession(SessionState sessionRef, bool enabled, bool activeNow, bool resetDay) =>
    SessionState nextSession = sessionRef
    bool wasActive = nextSession.active
    nextSession.enabled := enabled
    nextSession.started := enabled and activeNow and not wasActive
    nextSession.ended := enabled and not activeNow and wasActive
    if resetDay
        nextSession.completedToday := false
        nextSession.startedToday := false
        nextSession.liveHigh := na
        nextSession.liveLow := na
        nextSession.liveStartBar := na
        nextSession.drawHigh := na
        nextSession.drawLow := na
        nextSession.drawStartBar := na
    if nextSession.started
        nextSession.startedToday := true
        nextSession.liveHigh := high
        nextSession.liveLow := low
        nextSession.liveStartBar := bar_index
    else if enabled and activeNow
        nextSession.liveHigh := math.max(nz(nextSession.liveHigh, high), high)
        nextSession.liveLow := math.min(nz(nextSession.liveLow, low), low)
    if enabled and (activeNow or nextSession.ended)
        nextSession.drawHigh := nextSession.liveHigh
        nextSession.drawLow := nextSession.liveLow
        nextSession.drawStartBar := nz(nextSession.liveStartBar, bar_index)
    if nextSession.ended
        nextSession.prevHigh := nextSession.liveHigh
        nextSession.prevLow := nextSession.liveLow
        nextSession.prevEndBar := bar_index
        nextSession.completedToday := true
    nextSession.active := enabled and activeNow
    nextSession

sessionVisible(SessionState sessionRef) =>
    not sessionRef.enabled ? false :
     sessionDisplayMode == "Active Only" ? sessionRef.active :
     sessionDisplayMode == "Active + Completed Today" ? (sessionRef.active or sessionRef.completedToday) :
     (isTrackedSession(sessionRef.key) and (sessionRef.active or sessionRef.startedToday))

var SessionState londonState = newSession("LDN", "London", color.new(clrSessionLondon, 0))
var SessionState newYorkState = newSession("NY", "New York", color.new(clrSessionNewYork, 0))
var SessionState tokyoState = newSession("TKY", "Tokyo", color.new(clrSessionTokyo, 0))
var SessionState sydneyState = newSession("SYD", "Sydney", color.new(clrSessionSydney, 0))

londonState := updateSession(londonState, londonEnabled, inLondon, sessionDayChanged)
newYorkState := updateSession(newYorkState, newYorkEnabled, inNewYork, sessionDayChanged)
tokyoState := updateSession(tokyoState, tokyoEnabled, inTokyo, sessionDayChanged)
sydneyState := updateSession(sydneyState, sydneyEnabled, inSydney, sessionDayChanged)

// ============================================================================
//  5. TRUE DAILY LEVELS / HTF FOUNDATION
// ============================================================================
[pdh, pdl, prevDailyTime, currentDailyOpen] = request.security(
     syminfo.tickerid, "D",
     [high[1], low[1], time[1], open],
     lookahead = barmerge.lookahead_off)

[htfClose, htfEmaFast, htfEmaSlow, htfAtr] = request.security(
     syminfo.tickerid, htfBiasTf,
     [close, ta.ema(close, 20), ta.ema(close, 50), ta.atr(14)],
     lookahead = barmerge.lookahead_off)

htfBull = htfClose > htfEmaFast and htfEmaFast >= htfEmaSlow
htfBear = htfClose < htfEmaFast and htfEmaFast <= htfEmaSlow
htfBiasText = htfBull ? "Bullish" : htfBear ? "Bearish" : "Neutral"
htfBiasQuality = math.abs(htfClose - htfEmaFast) / math.max(htfAtr, syminfo.mintick)
htfBiasStrong = htfBiasQuality >= 0.25
htfBullOk = not useHtfBias or htfBull
htfBearOk = not useHtfBias or htfBear

// ============================================================================
//  6. STRUCTURE / DEALING RANGE / LIQUIDITY MAP
// ============================================================================
internalPivotHigh = ta.pivothigh(high, internalPivotLen, internalPivotLen)
internalPivotLow = ta.pivotlow(low, internalPivotLen, internalPivotLen)
externalPivotHigh = ta.pivothigh(high, externalPivotLen, externalPivotLen)
externalPivotLow = ta.pivotlow(low, externalPivotLen, externalPivotLen)

var float lastInternalHigh = na
var int lastInternalHighBar = na
var float prevInternalHigh = na
var int prevInternalHighBar = na
var float lastInternalLow = na
var int lastInternalLowBar = na
var float prevInternalLow = na
var int prevInternalLowBar = na

if not na(internalPivotHigh)
    prevInternalHigh := lastInternalHigh
    prevInternalHighBar := lastInternalHighBar
    lastInternalHigh := internalPivotHigh
    lastInternalHighBar := bar_index - internalPivotLen

if not na(internalPivotLow)
    prevInternalLow := lastInternalLow
    prevInternalLowBar := lastInternalLowBar
    lastInternalLow := internalPivotLow
    lastInternalLowBar := bar_index - internalPivotLen

var float lastExternalHigh = na
var int lastExternalHighBar = na
var float prevExternalHigh = na
var int prevExternalHighBar = na
var float lastExternalLow = na
var int lastExternalLowBar = na
var float prevExternalLow = na
var int prevExternalLowBar = na

if not na(externalPivotHigh)
    prevExternalHigh := lastExternalHigh
    prevExternalHighBar := lastExternalHighBar
    lastExternalHigh := externalPivotHigh
    lastExternalHighBar := bar_index - externalPivotLen

if not na(externalPivotLow)
    prevExternalLow := lastExternalLow
    prevExternalLowBar := lastExternalLowBar
    lastExternalLow := externalPivotLow
    lastExternalLowBar := bar_index - externalPivotLen

externalBiasText = not na(lastExternalHigh) and not na(prevExternalHigh) and not na(lastExternalLow) and not na(prevExternalLow) ?
     (lastExternalHigh > prevExternalHigh and lastExternalLow > prevExternalLow ? "Bullish" :
     lastExternalHigh < prevExternalHigh and lastExternalLow < prevExternalLow ? "Bearish" : "Mixed") :
     "Mixed"

dealingRangeHigh = math.max(nz(lastExternalHigh, high), nz(pdh, high))
dealingRangeLow = math.min(nz(lastExternalLow, low), nz(pdl, low))
dealingRangeMid = (dealingRangeHigh + dealingRangeLow) / 2.0
inDiscount = close <= dealingRangeMid
inPremium = close >= dealingRangeMid
premiumDiscountText = close > dealingRangeMid ? "Premium" : close < dealingRangeMid ? "Discount" : "Mid"

var float asiaRangeHigh = na
var float asiaRangeLow = na
var int asiaRangeStartBar = na
var float londonPreHigh = na
var float londonPreLow = na

if sessionDayChanged
    asiaRangeHigh := na
    asiaRangeLow := na
    asiaRangeStartBar := na
    londonPreHigh := na
    londonPreLow := na

if inAsiaRange
    if not inAsiaRange[1]
        asiaRangeHigh := high
        asiaRangeLow := low
        asiaRangeStartBar := bar_index
    else
        asiaRangeHigh := math.max(nz(asiaRangeHigh, high), high)
        asiaRangeLow := math.min(nz(asiaRangeLow, low), low)

if londonEnabled and not inLondon and (hour(time, tzLondon) < 7)
    londonPreHigh := math.max(nz(londonPreHigh, high), high)
    londonPreLow := math.min(nz(londonPreLow, low), low)

equalTolerance = atr14 * equalToleranceAtr
var float equalHighLevel = na
var int equalHighBar = na
var float equalLowLevel = na
var int equalLowBar = na

if not na(internalPivotHigh) and not na(prevInternalHigh)
    eqHighBarsApart = (bar_index - internalPivotLen) - nz(prevInternalHighBar, bar_index)
    if math.abs(internalPivotHigh - prevInternalHigh) <= equalTolerance and eqHighBarsApart <= equalMaxBarsApart
        equalHighLevel := (internalPivotHigh + prevInternalHigh) / 2.0
        equalHighBar := bar_index - internalPivotLen

if not na(internalPivotLow) and not na(prevInternalLow)
    eqLowBarsApart = (bar_index - internalPivotLen) - nz(prevInternalLowBar, bar_index)
    if math.abs(internalPivotLow - prevInternalLow) <= equalTolerance and eqLowBarsApart <= equalMaxBarsApart
        equalLowLevel := (internalPivotLow + prevInternalLow) / 2.0
        equalLowBar := bar_index - internalPivotLen

considerLiquidityHit(LiquidityHit bestHit, bool condition, int direction, int priority, string category, string label, float price, float extreme, int refBar, string context) =>
    LiquidityHit nextHit = bestHit
    if condition and (not bestHit.found or priority > bestHit.priority)
        nextHit := LiquidityHit.new(true, direction, priority, category, label, price, extreme, refBar, context)
    nextHit

isPublicLiquidityCategory(string category) =>
    category == "PDH" or category == "PDL" or
     category == "ASIA_HIGH" or category == "ASIA_LOW" or
     category == "PREV_LDN_HIGH" or category == "PREV_LDN_LOW" or
     category == "PREV_NY_HIGH" or category == "PREV_NY_LOW" or
     category == "PREV_TKY_HIGH" or category == "PREV_TKY_LOW" or
     category == "EQH" or category == "EQL"

isPublicLiquidityHit(LiquidityHit hitRef) =>
    hitRef.found and isPublicLiquidityCategory(hitRef.category)

bullSweepReclaim = close > open and bullCloseLocation >= 0.55
bearSweepReclaim = close < open and bearCloseLocation >= 0.55

LiquidityHit bullLiquidityHit = newLiquidityHit()
LiquidityHit bearLiquidityHit = newLiquidityHit()

bullLiquidityHit := considerLiquidityHit(bullLiquidityHit, not na(pdl) and low < pdl - sweepBuffer and close > pdl and bullSweepReclaim, DIR_BULL, 100, "PDL", "Previous Day Low", pdl, low, bar_index, "daily")
bullLiquidityHit := considerLiquidityHit(bullLiquidityHit, not na(asiaRangeLow) and low < asiaRangeLow - sweepBuffer and close > asiaRangeLow and bullSweepReclaim, DIR_BULL, 96, "ASIA_LOW", "Asia Low", asiaRangeLow, low, nz(asiaRangeStartBar, bar_index), "asia")
bullLiquidityHit := considerLiquidityHit(bullLiquidityHit, not na(londonState.prevLow) and low < londonState.prevLow - sweepBuffer and close > londonState.prevLow and bullSweepReclaim, DIR_BULL, 94, "PREV_LDN_LOW", "Prev London Low", londonState.prevLow, low, nz(londonState.prevEndBar, bar_index), "session")
bullLiquidityHit := considerLiquidityHit(bullLiquidityHit, not na(newYorkState.prevLow) and low < newYorkState.prevLow - sweepBuffer and close > newYorkState.prevLow and bullSweepReclaim, DIR_BULL, 93, "PREV_NY_LOW", "Prev New York Low", newYorkState.prevLow, low, nz(newYorkState.prevEndBar, bar_index), "session")
bullLiquidityHit := considerLiquidityHit(bullLiquidityHit, not na(tokyoState.prevLow) and low < tokyoState.prevLow - sweepBuffer and close > tokyoState.prevLow and bullSweepReclaim, DIR_BULL, 92, "PREV_TKY_LOW", "Prev Tokyo Low", tokyoState.prevLow, low, nz(tokyoState.prevEndBar, bar_index), "session")
bullLiquidityHit := considerLiquidityHit(bullLiquidityHit, not na(equalLowLevel) and low < equalLowLevel - sweepBuffer and close > equalLowLevel and bullSweepReclaim, DIR_BULL, 88, "EQL", "Equal Lows", equalLowLevel, low, nz(equalLowBar, bar_index), "equal")
bullLiquidityHit := considerLiquidityHit(bullLiquidityHit, useDailyOpen and not na(currentDailyOpen) and low < currentDailyOpen - sweepBuffer and close > currentDailyOpen and bullSweepReclaim, DIR_BULL, 72, "DAILY_OPEN", "Daily Open", currentDailyOpen, low, bar_index, "daily")
bullLiquidityHit := considerLiquidityHit(bullLiquidityHit, not na(lastExternalLow) and low < lastExternalLow - sweepBuffer and close > lastExternalLow and bullSweepReclaim, DIR_BULL, 70, "EXT_LOW", "External Swing Low", lastExternalLow, low, nz(lastExternalLowBar, bar_index), "swing")

bearLiquidityHit := considerLiquidityHit(bearLiquidityHit, not na(pdh) and high > pdh + sweepBuffer and close < pdh and bearSweepReclaim, DIR_BEAR, 100, "PDH", "Previous Day High", pdh, high, bar_index, "daily")
bearLiquidityHit := considerLiquidityHit(bearLiquidityHit, not na(asiaRangeHigh) and high > asiaRangeHigh + sweepBuffer and close < asiaRangeHigh and bearSweepReclaim, DIR_BEAR, 96, "ASIA_HIGH", "Asia High", asiaRangeHigh, high, nz(asiaRangeStartBar, bar_index), "asia")
bearLiquidityHit := considerLiquidityHit(bearLiquidityHit, not na(londonState.prevHigh) and high > londonState.prevHigh + sweepBuffer and close < londonState.prevHigh and bearSweepReclaim, DIR_BEAR, 94, "PREV_LDN_HIGH", "Prev London High", londonState.prevHigh, high, nz(londonState.prevEndBar, bar_index), "session")
bearLiquidityHit := considerLiquidityHit(bearLiquidityHit, not na(newYorkState.prevHigh) and high > newYorkState.prevHigh + sweepBuffer and close < newYorkState.prevHigh and bearSweepReclaim, DIR_BEAR, 93, "PREV_NY_HIGH", "Prev New York High", newYorkState.prevHigh, high, nz(newYorkState.prevEndBar, bar_index), "session")
bearLiquidityHit := considerLiquidityHit(bearLiquidityHit, not na(tokyoState.prevHigh) and high > tokyoState.prevHigh + sweepBuffer and close < tokyoState.prevHigh and bearSweepReclaim, DIR_BEAR, 92, "PREV_TKY_HIGH", "Prev Tokyo High", tokyoState.prevHigh, high, nz(tokyoState.prevEndBar, bar_index), "session")
bearLiquidityHit := considerLiquidityHit(bearLiquidityHit, not na(equalHighLevel) and high > equalHighLevel + sweepBuffer and close < equalHighLevel and bearSweepReclaim, DIR_BEAR, 88, "EQH", "Equal Highs", equalHighLevel, high, nz(equalHighBar, bar_index), "equal")
bearLiquidityHit := considerLiquidityHit(bearLiquidityHit, useDailyOpen and not na(currentDailyOpen) and high > currentDailyOpen + sweepBuffer and close < currentDailyOpen and bearSweepReclaim, DIR_BEAR, 72, "DAILY_OPEN", "Daily Open", currentDailyOpen, high, bar_index, "daily")
bearLiquidityHit := considerLiquidityHit(bearLiquidityHit, not na(lastExternalHigh) and high > lastExternalHigh + sweepBuffer and close < lastExternalHigh and bearSweepReclaim, DIR_BEAR, 70, "EXT_HIGH", "External Swing High", lastExternalHigh, high, nz(lastExternalHighBar, bar_index), "swing")

// ============================================================================
//  7. DISPLACEMENT / MSS ENGINE
// ============================================================================
impulseDominance(int direction, int length) =>
    float totalBody = 0.0
    float totalRange = 0.0
    for i = 0 to length - 1
        float dirBody = direction == DIR_BULL ? math.max(close[i] - open[i], 0.0) : math.max(open[i] - close[i], 0.0)
        totalBody += dirBody
        totalRange += safeRange(high[i], low[i])
    totalBody / math.max(totalRange, syminfo.mintick)

impulseDominanceAt(int direction, int length, int offset) =>
    float totalBody = 0.0
    float totalRange = 0.0
    for i = 0 to length - 1
        int idx = offset + i
        float dirBody = direction == DIR_BULL ? math.max(close[idx] - open[idx], 0.0) : math.max(open[idx] - close[idx], 0.0)
        totalBody += dirBody
        totalRange += safeRange(high[idx], low[idx])
    totalBody / math.max(totalRange, syminfo.mintick)

displacementScoreAt(int direction, int offset) =>
    float rangeValue = safeRange(high[offset], low[offset])
    float directionalBody = direction == DIR_BULL ? math.max(close[offset] - open[offset], 0.0) : math.max(open[offset] - close[offset], 0.0)
    float bodyDom = directionalBody / rangeValue
    float closeEdge = direction == DIR_BULL ? (close[offset] - low[offset]) / rangeValue : (high[offset] - close[offset]) / rangeValue
    float rangeExpansion = rangeValue / math.max(nz(avgRange20[offset], rangeValue), syminfo.mintick)
    float bodyExpansion = directionalBody / math.max(nz(avgBody20[offset], directionalBody), syminfo.mintick)
    float impulse2 = impulseDominanceAt(direction, 2, offset)
    float score = clamp(bodyDom / 0.70, 0.0, 1.0) * 30.0 +
         clamp(closeEdge / 0.80, 0.0, 1.0) * 25.0 +
         clamp(rangeExpansion / 1.60, 0.0, 1.0) * 20.0 +
         clamp(bodyExpansion / 1.80, 0.0, 1.0) * 15.0 +
         clamp(impulse2 / 0.65, 0.0, 1.0) * 10.0
    if useVolumeConfluence and not na(avgVolume20[offset]) and avgVolume20[offset] > 0
        score += volume[offset] > avgVolume20[offset] * 1.25 ? 5.0 : 0.0
    int(math.round(math.min(score, 100.0)))

bullDisplacementScore = displacementScoreAt(DIR_BULL, 0)
bearDisplacementScore = displacementScoreAt(DIR_BEAR, 0)
bullDisplacementStrong = bullCandle and bullDisplacementScore >= displacementMinScore
bearDisplacementStrong = bearCandle and bearDisplacementScore >= displacementMinScore

StructureBreak genericBullBreak = newStructureBreak()
StructureBreak genericBearBreak = newStructureBreak()

genericBullBreak := not na(lastInternalHigh) and close > lastInternalHigh + atr14 * minimumBreakDistanceAtr and close[1] <= lastInternalHigh and bullDisplacementStrong ?
     StructureBreak.new(true, DIR_BULL, lastInternalHigh, nz(lastInternalHighBar, bar_index), bar_index, bullDisplacementScore) :
     genericBullBreak

genericBearBreak := not na(lastInternalLow) and close < lastInternalLow - atr14 * minimumBreakDistanceAtr and close[1] >= lastInternalLow and bearDisplacementStrong ?
     StructureBreak.new(true, DIR_BEAR, lastInternalLow, nz(lastInternalLowBar, bar_index), bar_index, bearDisplacementScore) :
     genericBearBreak

// ============================================================================
//  8. ZONE ENGINE (FVG + OB STORAGE)
// ============================================================================
var float[] bullFvgHigh = array.new_float()
var float[] bullFvgLow = array.new_float()
var int[] bullFvgBar = array.new_int()
var int[] bullFvgScore = array.new_int()
var bool[] bullFvgTouched = array.new_bool()

var float[] bearFvgHigh = array.new_float()
var float[] bearFvgLow = array.new_float()
var int[] bearFvgBar = array.new_int()
var int[] bearFvgScore = array.new_int()
var bool[] bearFvgTouched = array.new_bool()

var float[] bullObHigh = array.new_float()
var float[] bullObLow = array.new_float()
var int[] bullObBar = array.new_int()
var int[] bullObScore = array.new_int()

var float[] bearObHigh = array.new_float()
var float[] bearObLow = array.new_float()
var int[] bearObBar = array.new_int()
var int[] bearObScore = array.new_int()

registerBullFvg(float zoneHigh, float zoneLow, int score) =>
    array.push(bullFvgHigh, zoneHigh)
    array.push(bullFvgLow, zoneLow)
    array.push(bullFvgBar, bar_index)
    array.push(bullFvgScore, score)
    array.push(bullFvgTouched, false)
    while array.size(bullFvgHigh) > maxActiveFvg
        array.shift(bullFvgHigh)
        array.shift(bullFvgLow)
        array.shift(bullFvgBar)
        array.shift(bullFvgScore)
        array.shift(bullFvgTouched)

registerBearFvg(float zoneHigh, float zoneLow, int score) =>
    array.push(bearFvgHigh, zoneHigh)
    array.push(bearFvgLow, zoneLow)
    array.push(bearFvgBar, bar_index)
    array.push(bearFvgScore, score)
    array.push(bearFvgTouched, false)
    while array.size(bearFvgHigh) > maxActiveFvg
        array.shift(bearFvgHigh)
        array.shift(bearFvgLow)
        array.shift(bearFvgBar)
        array.shift(bearFvgScore)
        array.shift(bearFvgTouched)

registerBullOb(float zoneHigh, float zoneLow, int score) =>
    array.push(bullObHigh, zoneHigh)
    array.push(bullObLow, zoneLow)
    array.push(bullObBar, bar_index)
    array.push(bullObScore, score)
    while array.size(bullObHigh) > maxActiveOb
        array.shift(bullObHigh)
        array.shift(bullObLow)
        array.shift(bullObBar)
        array.shift(bullObScore)

registerBearOb(float zoneHigh, float zoneLow, int score) =>
    array.push(bearObHigh, zoneHigh)
    array.push(bearObLow, zoneLow)
    array.push(bearObBar, bar_index)
    array.push(bearObScore, score)
    while array.size(bearObHigh) > maxActiveOb
        array.shift(bearObHigh)
        array.shift(bearObLow)
        array.shift(bearObBar)
        array.shift(bearObScore)

if enableFvg and bar_index >= 2
    bullGapSize = low - high[2]
    bearGapSize = low[2] - high
    bullFvgOk = low > high[2] and bullGapSize >= atr14 * resolvedMinFvgAtr and displacementScoreAt(DIR_BULL, 1) >= displacementMinScore - 6
    bearFvgOk = high < low[2] and bearGapSize >= atr14 * resolvedMinFvgAtr and displacementScoreAt(DIR_BEAR, 1) >= displacementMinScore - 6
    if bullFvgOk
        registerBullFvg(low, high[2], displacementScoreAt(DIR_BULL, 1) + int(math.round((bullGapSize / atr14) * 12.0)))
    if bearFvgOk
        registerBearFvg(low[2], high, displacementScoreAt(DIR_BEAR, 1) + int(math.round((bearGapSize / atr14) * 12.0)))

findBullOb() =>
    float bestHigh = na
    float bestLow = na
    int bestScore = 0
    for i = 1 to obLookbackBars
        bool oppositeCandle = close[i] < open[i]
        if oppositeCandle
            float zoneHigh = math.max(open[i], close[i])
            float zoneLow = low[i]
            float departure = (high - zoneHigh) / math.max(atr14, syminfo.mintick)
            float efficiency = (close - zoneHigh) / math.max(high - low, syminfo.mintick)
            int score = int(math.round(clamp(departure / 1.5, 0.0, 1.0) * 45.0 + clamp(efficiency / 0.8, 0.0, 1.0) * 30.0 + clamp((obLookbackBars - i + 1.0) / obLookbackBars, 0.0, 1.0) * 25.0))
            if score > bestScore
                bestHigh := zoneHigh
                bestLow := zoneLow
                bestScore := score
    [bestHigh, bestLow, bestScore]

findBearOb() =>
    float bestHigh = na
    float bestLow = na
    int bestScore = 0
    for i = 1 to obLookbackBars
        bool oppositeCandle = close[i] > open[i]
        if oppositeCandle
            float zoneHigh = high[i]
            float zoneLow = math.min(open[i], close[i])
            float departure = (zoneLow - low) / math.max(atr14, syminfo.mintick)
            float efficiency = (zoneLow - close) / math.max(high - low, syminfo.mintick)
            int score = int(math.round(clamp(departure / 1.5, 0.0, 1.0) * 45.0 + clamp(efficiency / 0.8, 0.0, 1.0) * 30.0 + clamp((obLookbackBars - i + 1.0) / obLookbackBars, 0.0, 1.0) * 25.0))
            if score > bestScore
                bestHigh := zoneHigh
                bestLow := zoneLow
                bestScore := score
    [bestHigh, bestLow, bestScore]

if enableOb and genericBullBreak.found and bullDisplacementStrong
    [newBullObHigh, newBullObLow, newBullObScore] = findBullOb()
    if not na(newBullObHigh)
        registerBullOb(newBullObHigh, newBullObLow, newBullObScore + bullDisplacementScore)

if enableOb and genericBearBreak.found and bearDisplacementStrong
    [newBearObHigh, newBearObLow, newBearObScore] = findBearOb()
    if not na(newBearObHigh)
        registerBearOb(newBearObHigh, newBearObLow, newBearObScore + bearDisplacementScore)

pruneBullFvgs() =>
    int idx = array.size(bullFvgHigh) - 1
    while idx >= 0
        float zoneHigh = array.get(bullFvgHigh, idx)
        float zoneLow = array.get(bullFvgLow, idx)
        int createdBar = array.get(bullFvgBar, idx)
        bool fullyFilled = low <= zoneLow
        bool expired = bar_index - createdBar > fvgExpiryBars
        if fullyFilled or expired
            array.remove(bullFvgHigh, idx)
            array.remove(bullFvgLow, idx)
            array.remove(bullFvgBar, idx)
            array.remove(bullFvgScore, idx)
            array.remove(bullFvgTouched, idx)
        idx -= 1

pruneBearFvgs() =>
    int idx = array.size(bearFvgHigh) - 1
    while idx >= 0
        float zoneHigh = array.get(bearFvgHigh, idx)
        int createdBar = array.get(bearFvgBar, idx)
        bool fullyFilled = high >= zoneHigh
        bool expired = bar_index - createdBar > fvgExpiryBars
        if fullyFilled or expired
            array.remove(bearFvgHigh, idx)
            array.remove(bearFvgLow, idx)
            array.remove(bearFvgBar, idx)
            array.remove(bearFvgScore, idx)
            array.remove(bearFvgTouched, idx)
        idx -= 1

pruneBullObs() =>
    int idx = array.size(bullObHigh) - 1
    while idx >= 0
        float zoneLow = array.get(bullObLow, idx)
        int createdBar = array.get(bullObBar, idx)
        bool mitigated = close < zoneLow
        bool expired = bar_index - createdBar > obExpiryBars
        if mitigated or expired
            array.remove(bullObHigh, idx)
            array.remove(bullObLow, idx)
            array.remove(bullObBar, idx)
            array.remove(bullObScore, idx)
        idx -= 1

pruneBearObs() =>
    int idx = array.size(bearObHigh) - 1
    while idx >= 0
        float zoneHigh = array.get(bearObHigh, idx)
        int createdBar = array.get(bearObBar, idx)
        bool mitigated = close > zoneHigh
        bool expired = bar_index - createdBar > obExpiryBars
        if mitigated or expired
            array.remove(bearObHigh, idx)
            array.remove(bearObLow, idx)
            array.remove(bearObBar, idx)
            array.remove(bearObScore, idx)
        idx -= 1

pruneBullFvgs()
pruneBearFvgs()
pruneBullObs()
pruneBearObs()

selectBullFvg(int afterBar) =>
    ZoneCandidate bestZone = newZoneCandidate()
    int idx = array.size(bullFvgHigh) - 1
    while idx >= 0
        int createdBar = array.get(bullFvgBar, idx)
        if createdBar >= afterBar
            int score = array.get(bullFvgScore, idx)
            if not bestZone.found or score > bestZone.score
                bestZone := ZoneCandidate.new(true, ZONE_FVG, DIR_BULL, array.get(bullFvgHigh, idx), array.get(bullFvgLow, idx), createdBar, score, "Bull FVG")
        idx -= 1
    bestZone

selectBearFvg(int afterBar) =>
    ZoneCandidate bestZone = newZoneCandidate()
    int idx = array.size(bearFvgHigh) - 1
    while idx >= 0
        int createdBar = array.get(bearFvgBar, idx)
        if createdBar >= afterBar
            int score = array.get(bearFvgScore, idx)
            if not bestZone.found or score > bestZone.score
                bestZone := ZoneCandidate.new(true, ZONE_FVG, DIR_BEAR, array.get(bearFvgHigh, idx), array.get(bearFvgLow, idx), createdBar, score, "Bear FVG")
        idx -= 1
    bestZone

selectBullOb(int afterBar) =>
    ZoneCandidate bestZone = newZoneCandidate()
    int idx = array.size(bullObHigh) - 1
    while idx >= 0
        int createdBar = array.get(bullObBar, idx)
        if createdBar >= afterBar
            int score = array.get(bullObScore, idx)
            if not bestZone.found or score > bestZone.score
                bestZone := ZoneCandidate.new(true, ZONE_OB, DIR_BULL, array.get(bullObHigh, idx), array.get(bullObLow, idx), createdBar, score, "Bull OB")
        idx -= 1
    bestZone

selectBearOb(int afterBar) =>
    ZoneCandidate bestZone = newZoneCandidate()
    int idx = array.size(bearObHigh) - 1
    while idx >= 0
        int createdBar = array.get(bearObBar, idx)
        if createdBar >= afterBar
            int score = array.get(bearObScore, idx)
            if not bestZone.found or score > bestZone.score
                bestZone := ZoneCandidate.new(true, ZONE_OB, DIR_BEAR, array.get(bearObHigh, idx), array.get(bearObLow, idx), createdBar, score, "Bear OB")
        idx -= 1
    bestZone

chooseZone(int direction, int afterBar) =>
    ZoneCandidate fvgZone = direction == DIR_BULL ? selectBullFvg(afterBar) : selectBearFvg(afterBar)
    ZoneCandidate obZone = direction == DIR_BULL ? selectBullOb(afterBar) : selectBearOb(afterBar)
    ZoneCandidate selected = newZoneCandidate()
    if zoneSelectionMode == "FVG then OB"
        selected := fvgZone.found ? fvgZone : obZone
    else if zoneSelectionMode == "OB then FVG"
        selected := obZone.found ? obZone : fvgZone
    else
        selected := fvgZone.found and obZone.found ? (fvgZone.score >= obZone.score ? fvgZone : obZone) : (fvgZone.found ? fvgZone : obZone)
    if entryModel == "FVG Only" and selected.zoneType != ZONE_FVG
        selected := newZoneCandidate()
    if entryModel == "OB Only" and selected.zoneType != ZONE_OB
        selected := newZoneCandidate()
    selected

// ============================================================================
//  9. EXECUTION / TARGET HELPERS
// ============================================================================
opposingLiquidityTarget(int direction, float entryPrice) =>
    float target = na
    if direction == DIR_BULL
        if not na(equalHighLevel) and equalHighLevel > entryPrice
            target := equalHighLevel
        if not na(newYorkState.drawHigh) and newYorkState.drawHigh > entryPrice and (na(target) or newYorkState.drawHigh < target)
            target := newYorkState.drawHigh
        if not na(londonState.drawHigh) and londonState.drawHigh > entryPrice and (na(target) or londonState.drawHigh < target)
            target := londonState.drawHigh
        if not na(pdh) and pdh > entryPrice and (na(target) or pdh < target)
            target := pdh
        if not na(lastExternalHigh) and lastExternalHigh > entryPrice and (na(target) or lastExternalHigh < target)
            target := lastExternalHigh
    if direction == DIR_BEAR
        if not na(equalLowLevel) and equalLowLevel < entryPrice
            target := equalLowLevel
        if not na(newYorkState.drawLow) and newYorkState.drawLow < entryPrice and (na(target) or newYorkState.drawLow > target)
            target := newYorkState.drawLow
        if not na(londonState.drawLow) and londonState.drawLow < entryPrice and (na(target) or londonState.drawLow > target)
            target := londonState.drawLow
        if not na(pdl) and pdl < entryPrice and (na(target) or pdl > target)
            target := pdl
        if not na(lastExternalLow) and lastExternalLow < entryPrice and (na(target) or lastExternalLow > target)
            target := lastExternalLow
    target

entryPriceForZone(int direction, ZoneCandidate zoneRef) =>
    float entryPrice = na
    string planLabel = ""
    if zoneRef.zoneType == ZONE_FVG
        float midpoint = (zoneRef.high + zoneRef.low) / 2.0
        bool useCe = fvgEntryMode == "CE Midpoint"
        entryPrice := useCe ? midpoint : (direction == DIR_BULL ? zoneRef.high : zoneRef.low)
        planLabel := useCe ? "FVG CE" : "FVG Prox"
    else if zoneRef.zoneType == ZONE_OB
        entryPrice := direction == DIR_BULL ? zoneRef.high : zoneRef.low
        planLabel := "OB Touch"
    [entryPrice, planLabel]

buildTradePlan(int direction, ZoneCandidate zoneRef, float sweepExtreme, string liquidityLabel) =>
    [entryPrice, entryLabel] = entryPriceForZone(direction, zoneRef)
    float stopPrice = na
    if stopModel == "Beyond Sweep Extreme"
        stopPrice := direction == DIR_BULL ? sweepExtreme - atr14 * riskBufferAtr : sweepExtreme + atr14 * riskBufferAtr
    else if stopModel == "Beyond Zone Boundary"
        stopPrice := direction == DIR_BULL ? zoneRef.low - atr14 * riskBufferAtr : zoneRef.high + atr14 * riskBufferAtr
    else
        float structureStop = direction == DIR_BULL ? sweepExtreme - atr14 * riskBufferAtr : sweepExtreme + atr14 * riskBufferAtr
        float zoneStop = direction == DIR_BULL ? zoneRef.low - atr14 * riskBufferAtr : zoneRef.high + atr14 * riskBufferAtr
        stopPrice := direction == DIR_BULL ? math.min(structureStop, zoneStop) : math.max(structureStop, zoneStop)
    float risk = math.abs(entryPrice - stopPrice)
    float tp1 = na
    float tp2 = na
    float runner = na
    string targetLabel = targetModel
    if targetModel == "Fixed RR"
        tp1 := direction == DIR_BULL ? entryPrice + risk * fixedRr : entryPrice - risk * fixedRr
        tp2 := tp1
        runner := tp1
    else if targetModel == "Opposing Liquidity"
        float liqTarget = opposingLiquidityTarget(direction, entryPrice)
        tp1 := na(liqTarget) ? (direction == DIR_BULL ? entryPrice + risk * fixedRr : entryPrice - risk * fixedRr) : liqTarget
        tp2 := tp1
        runner := tp1
        targetLabel := na(liqTarget) ? "Opposing Liquidity (fallback RR)" : "Opposing Liquidity"
    else
        tp1 := direction == DIR_BULL ? entryPrice + risk * partialR1 : entryPrice - risk * partialR1
        tp2 := direction == DIR_BULL ? entryPrice + risk * runnerR2 : entryPrice - risk * runnerR2
        float liqTarget = opposingLiquidityTarget(direction, entryPrice)
        runner := na(liqTarget) ? tp2 : liqTarget
        targetLabel := "Partials + Runner"
    TradePlanState.new(entryPrice, entryLabel, stopPrice, stopModel, tp1, tp2, runner, targetLabel, stopPrice)

riskWithinLimit(TradePlanState planRef) =>
    not na(planRef.entryPrice) and not na(planRef.stopPrice) and math.abs(planRef.entryPrice - planRef.stopPrice) <= atr14 * resolvedMaxRiskAtr

premiumDiscountAllows(int direction) =>
    not requirePremiumDiscount or (direction == DIR_BULL ? inDiscount : inPremium)

triggerCondition(int direction, SetupState setupRef) =>
    bool zoneTouch = direction == DIR_BULL ? low <= setupRef.zoneHigh and high >= setupRef.zoneLow : high >= setupRef.zoneLow and low <= setupRef.zoneHigh
    bool confirmClose = direction == DIR_BULL ? close > setupRef.zoneHigh and close > open : close < setupRef.zoneLow and close < open
    triggerModel == "Confirmation Close" ? (zoneTouch and confirmClose) : zoneTouch

setupIsLive(SetupState setupRef) =>
    setupRef.state == STATE_CANDIDATE or setupRef.state == STATE_ARMED or setupRef.state == STATE_TRIGGERED

setupCanStart(SetupState setupRef) =>
    setupRef.state == STATE_IDLE or setupRef.state == STATE_INVALIDATED or setupRef.state == STATE_COMPLETED

resetSetup(SetupState setupRef) =>
    newSetup(setupRef.strategyId)

// ============================================================================
//  10. STRATEGY STATE MACHINES
// ============================================================================
var SetupState s1Setup = newSetup(STRAT_S1)
var SetupState s2Setup = newSetup(STRAT_S2)
var SetupState s3Setup = newSetup(STRAT_S3)
var SetupState s4Setup = newSetup(STRAT_S4)
var SetupState s5Setup = newSetup(STRAT_S5)
var int s2WindowStartBar = na

var float po3AccumHigh = na
var float po3AccumLow = na
var bool po3AccumReady = false
var LiquidityHit po3ManipHit = newLiquidityHit()

if sessionDayChanged
    po3AccumHigh := na
    po3AccumLow := na
    po3AccumReady := false
    po3ManipHit := newLiquidityHit()

if inPo3Accum
    if not inPo3Accum[1]
        po3AccumHigh := high
        po3AccumLow := low
    else
        po3AccumHigh := math.max(nz(po3AccumHigh, high), high)
        po3AccumLow := math.min(nz(po3AccumLow, low), low)
    po3AccumReady := true

if po3AccumReady and inPo3Manip
    if not po3ManipHit.found and not na(po3AccumHigh) and high > po3AccumHigh + sweepBuffer and close < po3AccumHigh and bearSweepReclaim
        po3ManipHit := LiquidityHit.new(true, DIR_BEAR, 95, "PO3_MANIP_HIGH", "PO3 Manipulation High", po3AccumHigh, high, bar_index, "po3")
    if not po3ManipHit.found and not na(po3AccumLow) and low < po3AccumLow - sweepBuffer and close > po3AccumLow and bullSweepReclaim
        po3ManipHit := LiquidityHit.new(true, DIR_BULL, 95, "PO3_MANIP_LOW", "PO3 Manipulation Low", po3AccumLow, low, bar_index, "po3")

judasAnchorLabel = judasAnchor == "Asia Range" ? "Asia Range" : judasAnchor == "Daily Open" ? "Daily Open" : "London Pre-Range"
judasAnchorHigh = judasAnchor == "Asia Range" ? asiaRangeHigh : judasAnchor == "Daily Open" ? currentDailyOpen : londonPreHigh
judasAnchorLow = judasAnchor == "Asia Range" ? asiaRangeLow : judasAnchor == "Daily Open" ? currentDailyOpen : londonPreLow

LiquidityHit judasHit = newLiquidityHit()
judasHit := considerLiquidityHit(judasHit, enableS4 and inJudas and not na(judasAnchorHigh) and high > judasAnchorHigh + sweepBuffer and close < judasAnchorHigh and bearSweepReclaim, DIR_BEAR, 100, "JUDAS_HIGH", judasAnchorLabel + " High", judasAnchorHigh, high, bar_index, "judas")
judasHit := considerLiquidityHit(judasHit, enableS4 and inJudas and not na(judasAnchorLow) and low < judasAnchorLow - sweepBuffer and close > judasAnchorLow and bullSweepReclaim, DIR_BULL, 100, "JUDAS_LOW", judasAnchorLabel + " Low", judasAnchorLow, low, bar_index, "judas")

bool s1CandidateThisBar = false
bool s1PublicSweepThisBar = false
bool s1MssThisBar = false
bool s1ArmedThisBar = false
bool s1TriggeredThisBar = false
bool s2CandidateThisBar = false
bool s2PublicSweepThisBar = false
bool s2MssThisBar = false
bool s2ArmedThisBar = false
bool s2TriggeredThisBar = false
bool s3CandidateThisBar = false
bool s3PublicSweepThisBar = false
bool s3MssThisBar = false
bool s3ArmedThisBar = false
bool s3TriggeredThisBar = false
bool s4CandidateThisBar = false
bool s4PublicSweepThisBar = false
bool s4MssThisBar = false
bool s4ArmedThisBar = false
bool s4TriggeredThisBar = false
bool s5CandidateThisBar = false
bool s5PublicSweepThisBar = false
bool s5MssThisBar = false
bool s5ArmedThisBar = false
bool s5TriggeredThisBar = false

startSetup(SetupState setupRef, LiquidityHit hitRef, string waitingReason, string explanation, string contextLabel) =>
    SetupState nextSetup = setupRef
    nextSetup.direction := hitRef.direction
    nextSetup.state := STATE_CANDIDATE
    nextSetup.liquidityType := hitRef.category
    nextSetup.liquidityLabel := hitRef.label
    nextSetup.liquidityPrice := hitRef.price
    nextSetup.sweepBar := bar_index
    nextSetup.sweepExtreme := hitRef.extreme
    nextSetup.mssWatchLevel := hitRef.direction == DIR_BULL ? high : low
    nextSetup.mssWatchBar := bar_index
    nextSetup.waitingReason := waitingReason
    nextSetup.explanation := explanation
    nextSetup.contextLabel := contextLabel
    nextSetup.expiryBar := bar_index + stageWindowBars
    nextSetup.zoneType := ZONE_NONE
    nextSetup.zoneHigh := na
    nextSetup.zoneLow := na
    nextSetup.zoneBar := na
    nextSetup.entryPrice := na
    nextSetup.entryModel := ""
    nextSetup.stopPrice := na
    nextSetup.stopModel := ""
    nextSetup.tp1 := na
    nextSetup.tp2 := na
    nextSetup.runnerTarget := na
    nextSetup.targetModel := ""
    nextSetup.triggerBar := na
    nextSetup.invalidationPrice := na
    nextSetup.invalidationReason := ""
    nextSetup.confluenceSummary := "Liquidity swept: " + hitRef.label
    nextSetup

updateSetupWatchLevel(SetupState setupRef) =>
    SetupState nextSetup = setupRef
    if nextSetup.state == STATE_CANDIDATE
        if nextSetup.direction == DIR_BULL and not na(internalPivotHigh) and (bar_index - internalPivotLen) > nextSetup.sweepBar
            nextSetup.mssWatchLevel := internalPivotHigh
            nextSetup.mssWatchBar := bar_index - internalPivotLen
        if nextSetup.direction == DIR_BEAR and not na(internalPivotLow) and (bar_index - internalPivotLen) > nextSetup.sweepBar
            nextSetup.mssWatchLevel := internalPivotLow
            nextSetup.mssWatchBar := bar_index - internalPivotLen
    nextSetup

tryPromoteToArmed(SetupState setupRef, string waitingIfNoZone, int zoneAfterBar) =>
    SetupUpdateResult result = newSetupUpdateResult(setupRef)
    SetupState nextSetup = result.setup
    if nextSetup.state == STATE_CANDIDATE and not na(nextSetup.mssWatchLevel)
        bool breakValid = nextSetup.direction == DIR_BULL ?
             close > nextSetup.mssWatchLevel + atr14 * minimumBreakDistanceAtr and bullDisplacementStrong :
             close < nextSetup.mssWatchLevel - atr14 * minimumBreakDistanceAtr and bearDisplacementStrong
        int breakScore = nextSetup.direction == DIR_BULL ? bullDisplacementScore : bearDisplacementScore
        if breakValid and barConfirmedOk and na(nextSetup.mssBar)
            nextSetup.mssLevel := nextSetup.mssWatchLevel
            nextSetup.mssBar := bar_index
            nextSetup.displacementScore := breakScore
            nextSetup.displacementBar := bar_index
            nextSetup.waitingReason := waitingIfNoZone
            nextSetup.explanation := nextSetup.strategyLabel + ": displacement confirmed after " + nextSetup.liquidityLabel + " sweep"
            result.mssThisBar := true
        if not na(nextSetup.mssBar)
            int effectiveAfterBar = zoneAfterBar >= 0 ? zoneAfterBar : nextSetup.mssBar - 1
            ZoneCandidate zoneRef = chooseZone(nextSetup.direction, effectiveAfterBar)
            if zoneRef.found
                TradePlanState planRef = buildTradePlan(nextSetup.direction, zoneRef, nextSetup.sweepExtreme, nextSetup.liquidityLabel)
                bool directionBiasOk = nextSetup.direction == DIR_BULL ? htfBullOk : htfBearOk
                bool riskOk = riskWithinLimit(planRef)
                bool dealingRangeOk = premiumDiscountAllows(nextSetup.direction)
                if execTfOk and directionBiasOk and dealingRangeOk and riskOk
                    nextSetup.state := STATE_ARMED
                    nextSetup.zoneType := zoneRef.zoneType
                    nextSetup.zoneHigh := zoneRef.high
                    nextSetup.zoneLow := zoneRef.low
                    nextSetup.zoneBar := zoneRef.createdBar
                    nextSetup.entryPrice := planRef.entryPrice
                    nextSetup.entryModel := entryModel == "Confirmation Close" ? "Confirmation Close" : planRef.entryModel
                    nextSetup.stopPrice := planRef.stopPrice
                    nextSetup.stopModel := planRef.stopModel
                    nextSetup.tp1 := planRef.tp1
                    nextSetup.tp2 := planRef.tp2
                    nextSetup.runnerTarget := planRef.runnerTarget
                    nextSetup.targetModel := planRef.targetModel
                    nextSetup.invalidationPrice := planRef.invalidationPrice
                    nextSetup.waitingReason := "Waiting for retrace into " + zoneText(zoneRef.zoneType)
                    nextSetup.explanation := nextSetup.strategyLabel + ": swept " + nextSetup.liquidityLabel + ", broke " + str.tostring(nextSetup.mssLevel, format.mintick) + ", armed on " + zoneText(zoneRef.zoneType)
                    nextSetup.confluenceSummary := "Disp " + qualityLabel(nextSetup.displacementScore) + " | " + premiumDiscountText + " | HTF " + htfBiasText
                    nextSetup.expiryBar := bar_index + stageWindowBars
                    result.armedThisBar := true
                else
                    nextSetup.waitingReason := not execTfOk ? "Execution timeframe gated" :
                         not directionBiasOk ? "HTF bias misaligned" :
                         not dealingRangeOk ? "Premium/discount filter failed" : "Risk too large"
            else if nextSetup.state == STATE_CANDIDATE
                nextSetup.waitingReason := waitingIfNoZone
    result.setup := nextSetup
    result

updateArmedOrTriggered(SetupState setupRef) =>
    SetupUpdateResult result = newSetupUpdateResult(setupRef)
    SetupState nextSetup = result.setup
    if nextSetup.state == STATE_ARMED
        bool invalidated = nextSetup.direction == DIR_BULL ? low < nextSetup.sweepExtreme - sweepBuffer : high > nextSetup.sweepExtreme + sweepBuffer
        bool expired = bar_index > nextSetup.expiryBar
        bool zoneInvalidated = nextSetup.direction == DIR_BULL ? low < nextSetup.zoneLow - sweepBuffer : high > nextSetup.zoneHigh + sweepBuffer
        if invalidated or zoneInvalidated or expired
            nextSetup.state := STATE_INVALIDATED
            nextSetup.invalidationReason := invalidated ? "Sweep extreme failed" : zoneInvalidated ? "Zone invalidated" : "Setup expired"
        else if triggerCondition(nextSetup.direction, nextSetup) and barConfirmedOk
            nextSetup.state := STATE_TRIGGERED
            nextSetup.triggerBar := bar_index
            nextSetup.waitingReason := ""
            nextSetup.explanation := nextSetup.strategyLabel + ": triggered from " + zoneText(nextSetup.zoneType) + " after " + nextSetup.liquidityLabel + " sweep"
            result.triggeredThisBar := true
    if setupIsLive(nextSetup) and bar_index > nextSetup.expiryBar and nextSetup.state != STATE_TRIGGERED
        nextSetup.state := STATE_INVALIDATED
        nextSetup.invalidationReason := "Setup expired"
    result.setup := nextSetup
    result

replaceOrStart(SetupState setupRef, LiquidityHit hitRef, string waitingReason, string explanation, string contextLabel) =>
    SetupUpdateResult result = newSetupUpdateResult(setupRef)
    SetupState nextSetup = result.setup
    if hitRef.found
        bool fresh = setupCanStart(nextSetup)
        bool oppositeNarrative = setupIsLive(nextSetup) and nextSetup.direction != hitRef.direction
        if fresh or oppositeNarrative
            if oppositeNarrative
                nextSetup.state := STATE_INVALIDATED
                nextSetup.invalidationReason := "Opposite liquidity sweep took priority"
            nextSetup := startSetup(nextSetup, hitRef, waitingReason, explanation, contextLabel)
            result.startedThisBar := true
            result.publicSweepThisBar := isPublicLiquidityHit(hitRef)
    result.setup := nextSetup
    result

// S1 flagship
if enableS1
    bool s1BullStarted = false
    bool s1BullPublic = false
    bool s1BearStarted = false
    bool s1BearPublic = false
    SetupUpdateResult s1BullStart = replaceOrStart(s1Setup, bullLiquidityHit, "Waiting for bullish MSS", "Flagship S1 candidate after " + bullLiquidityHit.label + " sweep", activeSessionText)
    s1Setup := s1BullStart.setup
    s1BullStarted := s1BullStart.startedThisBar
    s1BullPublic := s1BullStart.publicSweepThisBar
    SetupUpdateResult s1BearStart = replaceOrStart(s1Setup, bearLiquidityHit, "Waiting for bearish MSS", "Flagship S1 candidate after " + bearLiquidityHit.label + " sweep", activeSessionText)
    s1Setup := s1BearStart.setup
    s1BearStarted := s1BearStart.startedThisBar
    s1BearPublic := s1BearStart.publicSweepThisBar
    s1CandidateThisBar := s1BullStarted or s1BearStarted
    s1PublicSweepThisBar := s1BullPublic or s1BearPublic
    s1Setup := updateSetupWatchLevel(s1Setup)
    SetupUpdateResult s1Promote = tryPromoteToArmed(s1Setup, "Waiting for displacement-backed FVG / OB", -1)
    s1Setup := s1Promote.setup
    s1MssThisBar := s1Promote.mssThisBar
    s1ArmedThisBar := s1Promote.armedThisBar
    SetupUpdateResult s1Trigger = updateArmedOrTriggered(s1Setup)
    s1Setup := s1Trigger.setup
    s1TriggeredThisBar := s1Trigger.triggeredThisBar
else
    s1Setup := resetSetup(s1Setup)

// S2 Silver Bullet
if inSilverBullet and not inSilverBullet[1]
    s2WindowStartBar := bar_index
if not inSilverBullet
    s2WindowStartBar := na

if enableS2
    LiquidityHit sbBullHit = inSilverBullet ? bullLiquidityHit : newLiquidityHit()
    LiquidityHit sbBearHit = inSilverBullet ? bearLiquidityHit : newLiquidityHit()
    bool s2BullStarted = false
    bool s2BullPublic = false
    bool s2BearStarted = false
    bool s2BearPublic = false
    SetupUpdateResult s2BullStart = replaceOrStart(s2Setup, sbBullHit, "Silver Bullet: waiting for MSS", "Silver Bullet candidate after liquidity interaction", activeSessionText)
    s2Setup := s2BullStart.setup
    s2BullStarted := s2BullStart.startedThisBar
    s2BullPublic := s2BullStart.publicSweepThisBar
    SetupUpdateResult s2BearStart = replaceOrStart(s2Setup, sbBearHit, "Silver Bullet: waiting for MSS", "Silver Bullet candidate after liquidity interaction", activeSessionText)
    s2Setup := s2BearStart.setup
    s2BearStarted := s2BearStart.startedThisBar
    s2BearPublic := s2BearStart.publicSweepThisBar
    s2CandidateThisBar := s2BullStarted or s2BearStarted
    s2PublicSweepThisBar := s2BullPublic or s2BearPublic
    s2Setup := updateSetupWatchLevel(s2Setup)
    SetupUpdateResult s2Promote = tryPromoteToArmed(s2Setup, "Silver Bullet: waiting for qualifying zone", nz(s2WindowStartBar, bar_index))
    s2Setup := s2Promote.setup
    s2MssThisBar := s2Promote.mssThisBar
    s2ArmedThisBar := s2Promote.armedThisBar
    if s2Setup.state != STATE_IDLE and s2Setup.state != STATE_COMPLETED and not inSilverBullet and bar_index > nz(s2Setup.sweepBar, bar_index)
        s2Setup.state := STATE_INVALIDATED
        s2Setup.invalidationReason := "Silver Bullet window closed"
    else
        SetupUpdateResult s2Trigger = updateArmedOrTriggered(s2Setup)
        s2Setup := s2Trigger.setup
        s2TriggeredThisBar := s2Trigger.triggeredThisBar
else
    s2Setup := resetSetup(s2Setup)

// S3 PO3 / AMD
if enableS3
    SetupUpdateResult s3Start = replaceOrStart(s3Setup, inPo3Manip ? po3ManipHit : newLiquidityHit(), "PO3: waiting for reversal MSS", "PO3 candidate after manipulation sweep", activeSessionText)
    s3Setup := s3Start.setup
    s3CandidateThisBar := s3Start.startedThisBar
    s3PublicSweepThisBar := s3Start.publicSweepThisBar
    s3Setup := updateSetupWatchLevel(s3Setup)
    SetupUpdateResult s3Promote = tryPromoteToArmed(s3Setup, "PO3: waiting for distribution zone", -1)
    s3Setup := s3Promote.setup
    s3MssThisBar := s3Promote.mssThisBar
    s3ArmedThisBar := s3Promote.armedThisBar
    if s3Setup.state == STATE_ARMED and not inPo3Dist
        s3Setup.waitingReason := "Waiting for distribution session trigger"
        bool s3Invalidated = s3Setup.direction == DIR_BULL ? low < s3Setup.sweepExtreme - sweepBuffer : high > s3Setup.sweepExtreme + sweepBuffer
        bool s3Expired = bar_index > s3Setup.expiryBar
        bool s3ZoneInvalid = s3Setup.direction == DIR_BULL ? low < s3Setup.zoneLow - sweepBuffer : high > s3Setup.zoneHigh + sweepBuffer
        if s3Invalidated or s3Expired or s3ZoneInvalid
            s3Setup.state := STATE_INVALIDATED
            s3Setup.invalidationReason := s3Invalidated ? "PO3 sweep extreme failed" : s3ZoneInvalid ? "PO3 zone invalidated" : "PO3 setup expired"
    else
        SetupUpdateResult s3Trigger = updateArmedOrTriggered(s3Setup)
        s3Setup := s3Trigger.setup
        s3TriggeredThisBar := s3Trigger.triggeredThisBar
else
    s3Setup := resetSetup(s3Setup)

// S4 Judas
if enableS4
    SetupUpdateResult s4Start = replaceOrStart(s4Setup, judasHit, "Judas: waiting for reversal MSS", "Judas candidate from " + judasAnchorLabel + " manipulation sweep", "Judas")
    s4Setup := s4Start.setup
    s4CandidateThisBar := s4Start.startedThisBar
    s4PublicSweepThisBar := s4Start.publicSweepThisBar
    s4Setup := updateSetupWatchLevel(s4Setup)
    SetupUpdateResult s4Promote = tryPromoteToArmed(s4Setup, "Judas: waiting for displacement FVG / OB", -1)
    s4Setup := s4Promote.setup
    s4MssThisBar := s4Promote.mssThisBar
    s4ArmedThisBar := s4Promote.armedThisBar
    SetupUpdateResult s4Trigger = updateArmedOrTriggered(s4Setup)
    s4Setup := s4Trigger.setup
    s4TriggeredThisBar := s4Trigger.triggeredThisBar
else
    s4Setup := resetSetup(s4Setup)

// S5 SMT divergence confluence path
var float smtLastHigh = na
var float smtPrevHigh = na
var float smtLastLow = na
var float smtPrevLow = na
var bool smtBullDivergence = false
var bool smtBearDivergence = false

if enableS5 and str.length(smtSymbol) > 0
    [smtHighSeries, smtLowSeries] = request.security(smtSymbol, timeframe.period, [high, low], lookahead = barmerge.lookahead_off)
    smtPivotHigh = ta.pivothigh(smtHighSeries, smtPivotLength, smtPivotLength)
    smtPivotLow = ta.pivotlow(smtLowSeries, smtPivotLength, smtPivotLength)
    if not na(smtPivotHigh)
        smtPrevHigh := smtLastHigh
        smtLastHigh := smtPivotHigh
    if not na(smtPivotLow)
        smtPrevLow := smtLastLow
        smtLastLow := smtPivotLow
    smtBullDivergence := not na(lastInternalLow) and not na(prevInternalLow) and not na(smtLastLow) and not na(smtPrevLow) and lastInternalLow < prevInternalLow and (smtCorrelation == "Positive" ? smtLastLow > smtPrevLow : smtLastLow < smtPrevLow)
    smtBearDivergence := not na(lastInternalHigh) and not na(prevInternalHigh) and not na(smtLastHigh) and not na(smtPrevHigh) and lastInternalHigh > prevInternalHigh and (smtCorrelation == "Positive" ? smtLastHigh < smtPrevHigh : smtLastHigh > smtPrevHigh)
else
    smtBullDivergence := false
    smtBearDivergence := false

if enableS5 and str.length(smtSymbol) > 0
    LiquidityHit smtBullHit = smtBullDivergence ? bullLiquidityHit : newLiquidityHit()
    LiquidityHit smtBearHit = smtBearDivergence ? bearLiquidityHit : newLiquidityHit()
    bool s5BullStarted = false
    bool s5BullPublic = false
    bool s5BearStarted = false
    bool s5BearPublic = false
    SetupUpdateResult s5BullStart = replaceOrStart(s5Setup, smtBullHit, "SMT: waiting for MSS", "SMT bullish divergence plus liquidity sweep", "SMT")
    s5Setup := s5BullStart.setup
    s5BullStarted := s5BullStart.startedThisBar
    s5BullPublic := s5BullStart.publicSweepThisBar
    SetupUpdateResult s5BearStart = replaceOrStart(s5Setup, smtBearHit, "SMT: waiting for MSS", "SMT bearish divergence plus liquidity sweep", "SMT")
    s5Setup := s5BearStart.setup
    s5BearStarted := s5BearStart.startedThisBar
    s5BearPublic := s5BearStart.publicSweepThisBar
    s5CandidateThisBar := s5BullStarted or s5BearStarted
    s5PublicSweepThisBar := s5BullPublic or s5BearPublic
    s5Setup := updateSetupWatchLevel(s5Setup)
    SetupUpdateResult s5Promote = tryPromoteToArmed(s5Setup, "SMT: waiting for displacement zone", -1)
    s5Setup := s5Promote.setup
    s5MssThisBar := s5Promote.mssThisBar
    s5ArmedThisBar := s5Promote.armedThisBar
    SetupUpdateResult s5Trigger = updateArmedOrTriggered(s5Setup)
    s5Setup := s5Trigger.setup
    s5TriggeredThisBar := s5Trigger.triggeredThisBar
else
    s5Setup := resetSetup(s5Setup)

// ============================================================================
//  11. STRATEGY PRIORITY / ACTIVE PLAN SELECTION
// ============================================================================
setupPriorityScore(SetupState setupRef) =>
    int stateWeight = setupRef.state == STATE_TRIGGERED ? 300 :
         setupRef.state == STATE_ARMED ? 200 :
         setupRef.state == STATE_CANDIDATE ? 100 : 0
    stateWeight == 0 ? 0 : stateWeight + nz(setupRef.displacementScore, 0)

strategyPriorityRank(int strategyId) =>
    int pos = str.pos(strategyPriority, strategyCode(strategyId))
    na(pos) ? 999 : pos

pickBetterSetup(SetupState leftRef, SetupState rightRef) =>
    int leftScore = setupPriorityScore(leftRef)
    int rightScore = setupPriorityScore(rightRef)
    if rightScore > leftScore
        rightRef
    else if rightScore == leftScore and strategyPriorityRank(rightRef.strategyId) < strategyPriorityRank(leftRef.strategyId)
        rightRef
    else if rightScore == leftScore and strategyPriorityRank(rightRef.strategyId) == strategyPriorityRank(leftRef.strategyId) and nz(rightRef.displacementScore, 0) > nz(leftRef.displacementScore, 0)
        rightRef
    else
        leftRef

SetupState selectedSetup = newSetup(0)
selectedSetup := pickBetterSetup(selectedSetup, s1Setup)
selectedSetup := pickBetterSetup(selectedSetup, s2Setup)
selectedSetup := pickBetterSetup(selectedSetup, s3Setup)
selectedSetup := pickBetterSetup(selectedSetup, s4Setup)
selectedSetup := pickBetterSetup(selectedSetup, s5Setup)

hasSelectedSetup = selectedSetup.strategyId > 0 and selectedSetup.state != STATE_IDLE

selectedStateText = hasSelectedSetup ? str.upper(stateText(selectedSetup.state)) : "IDLE"
selectedDirectionText = hasSelectedSetup ? str.upper(dirText(selectedSetup.direction)) : "NEUTRAL"
selectedBiasColor = selectedSetup.direction == DIR_BULL ? color.new(clrBull, 0) : selectedSetup.direction == DIR_BEAR ? color.new(clrBear, 0) : clrDashNeutralText

SetupState displayS1Setup = s1Setup
SetupState displayS2Setup = s2Setup
SetupState displayS3Setup = s3Setup
SetupState displayS4Setup = s4Setup
SetupState displayS5Setup = s5Setup

// ============================================================================
//  12. TRADE TRACKING / ALERTS / EXPERIMENTAL SIGNALS
// ============================================================================
tradeSetupType(int strategyId) =>
    strategyId == STRAT_S1 ? "RAID_MSS_ZONE" :
     strategyId == STRAT_S2 ? "SILVER_BULLET" :
     strategyId == STRAT_S3 ? "PO3_AMD" :
     strategyId == STRAT_S4 ? "JUDAS_SWING" :
     strategyId == STRAT_S5 ? "SMT_REVERSAL" : "FVG_MITIGATION"

tradeDirectionTag(int direction) =>
    direction == DIR_BULL ? "LONG" : "SHORT"

tradeSessionCode() =>
    inOverlap ? "OVERLAP" :
     inLondon ? "LONDON" :
     inNewYork ? "NY" :
     inTokyo ? "TOKYO" :
     inSydney ? "SYDNEY" :
     marketProfile == "Crypto 24/7" ? "CRYPTO" : "OTHER"

atrMean50 = ta.sma(atr14, 50)
atrRatio = atr14 / math.max(atrMean50, syminfo.mintick)
regimeName = externalBiasText == "Bullish" and htfBull ? "TREND_BULL" :
     externalBiasText == "Bearish" and htfBear ? "TREND_BEAR" :
     atrRatio <= 0.90 ? "RANGE_COMPRESSION" :
     atrRatio >= 1.15 ? "VOL_EXPANSION" : "TRANSITION"

buildPayload(string setupType, string dir, float entryPrice, float stopPrice, float takeProfitPrice, int score, string eventType) =>
    "{" +
     "\"schemaVersion\":\"2.0\"," +
     "\"eventType\":" + jsonStr(eventType) + "," +
     "\"symbol\":" + jsonStr(syminfo.tickerid) + "," +
     "\"timeframe\":" + jsonStr(normalizeTimeframeId(timeframe.period)) + "," +
     "\"timestamp\":" + str.tostring(time_close) + "," +
     "\"setupType\":" + jsonStr(setupType) + "," +
     "\"direction\":" + jsonStr(dir) + "," +
     "\"entry\":" + jsonNum(entryPrice) + "," +
     "\"stopLoss\":" + jsonNum(stopPrice) + "," +
     "\"takeProfit\":" + jsonNum(takeProfitPrice) + "," +
     "\"confluenceScore\":" + str.tostring(score) + "," +
     "\"regime\":" + jsonStr(regimeName) + "," +
     "\"htfBias\":" + jsonStr(htfBiasText) + "," +
     "\"session\":" + jsonStr(tradeSessionCode()) + "," +
     "\"features\":{" +
         "\"atr\":" + jsonNum(atr14) + "," +
         "\"atrRatio\":" + jsonNum(atrRatio) + "," +
         "\"externalBias\":" + jsonStr(externalBiasText) +
     "}," +
     "\"authToken\":" + jsonStr(webhookToken) +
     "}"

finalizeTriggeredSetup(SetupState setupRef, bool selectedForTrade) =>
    SetupState nextSetup = setupRef
    if nextSetup.state == STATE_TRIGGERED and nextSetup.triggerBar == bar_index
        if selectedForTrade
            nextSetup.state := STATE_COMPLETED
            nextSetup.waitingReason := "Trade registered"
            nextSetup.invalidationReason := ""
        else
            nextSetup.state := STATE_INVALIDATED
            nextSetup.invalidationReason := "Lower-priority setup suppressed"
    nextSetup

var string[] liveTradeId = array.new_string()
var int[] liveTradeStrategy = array.new_int()
var string[] liveTradeSetup = array.new_string()
var int[] liveTradeDirection = array.new_int()
var float[] liveTradeEntry = array.new_float()
var float[] liveTradeStop = array.new_float()
var float[] liveTradeDynamicStop = array.new_float()
var float[] liveTradeTp1 = array.new_float()
var float[] liveTradeTp2 = array.new_float()
var float[] liveTradeRunner = array.new_float()
var float[] liveTradeRisk = array.new_float()
var float[] liveTradeRealizedR = array.new_float()
var int[] liveTradeEntryBar = array.new_int()
var int[] liveTradeTriggerBar = array.new_int()
var int[] liveTradeQuality = array.new_int()
var bool[] liveTradePartialTaken = array.new_bool()
var bool[] liveTradeMovedBe = array.new_bool()
var bool[] liveTradeExperimental = array.new_bool()

// Closed-trade visual history storage
var int[] closedTradeStrategy = array.new_int()
var string[] closedTradeSetup = array.new_string()
var int[] closedTradeDirection = array.new_int()
var float[] closedTradeEntry = array.new_float()
var float[] closedTradeInitialStop = array.new_float()
var float[] closedTradeFinalStop = array.new_float()
var float[] closedTradeTp1 = array.new_float()
var float[] closedTradeTp2 = array.new_float()
var float[] closedTradeRunner = array.new_float()
var int[] closedTradeEntryBar = array.new_int()
var int[] closedTradeTriggerBar = array.new_int()
var int[] closedTradeCloseBar = array.new_int()
var float[] closedTradeClosePrice = array.new_float()
var string[] closedTradeCloseReason = array.new_string()
var float[] closedTradeR = array.new_float()
var bool[] closedTradeAmbiguous = array.new_bool()
var bool[] closedTradeWon = array.new_bool()
var bool[] closedTradePartialTaken = array.new_bool()

var int totalClosedTrades = 0
var int decisiveClosedTrades = 0
var int totalWins = 0
var int totalLosses = 0
var int totalAmbiguous = 0
var float totalNetR = 0.0
var float totalPositiveR = 0.0
var float totalNegativeR = 0.0
var string lastCloseReason = "NONE"
var float lastClosedR = na
var string openAlertPayload = ""
var string closeAlertPayload = ""

openAlertPayload := ""
closeAlertPayload := ""

var bool experimentalBullSignal = false
var bool experimentalBearSignal = false
var ZoneCandidate experimentalBullZone = newZoneCandidate()
var ZoneCandidate experimentalBearZone = newZoneCandidate()
var TradePlanState experimentalBullPlan = newTradePlan()
var TradePlanState experimentalBearPlan = newTradePlan()
var int experimentalBullScore = 0
var int experimentalBearScore = 0

experimentalBullSignal := false
experimentalBearSignal := false
experimentalBullZone := newZoneCandidate()
experimentalBearZone := newZoneCandidate()
experimentalBullPlan := newTradePlan()
experimentalBearPlan := newTradePlan()
experimentalBullScore := 0
experimentalBearScore := 0

if experimentalStandaloneFvg and not hasSelectedSetup and barConfirmedOk
    experimentalBullZone := selectBullFvg(bar_index - stageWindowBars)
    experimentalBearZone := selectBearFvg(bar_index - stageWindowBars)
    if experimentalBullZone.found and low <= experimentalBullZone.high and high >= experimentalBullZone.low and bullCandle and bullCloseLocation >= 0.55 and htfBullOk and premiumDiscountAllows(DIR_BULL)
        experimentalBullPlan := buildTradePlan(DIR_BULL, experimentalBullZone, experimentalBullZone.low, experimentalBullZone.label)
        if riskWithinLimit(experimentalBullPlan)
            experimentalBullSignal := true
            experimentalBullScore := experimentalBullZone.score
    if experimentalBearZone.found and high >= experimentalBearZone.low and low <= experimentalBearZone.high and bearCandle and bearCloseLocation >= 0.55 and htfBearOk and premiumDiscountAllows(DIR_BEAR)
        experimentalBearPlan := buildTradePlan(DIR_BEAR, experimentalBearZone, experimentalBearZone.high, experimentalBearZone.label)
        if riskWithinLimit(experimentalBearPlan)
            experimentalBearSignal := true
            experimentalBearScore := experimentalBearZone.score

selectedTriggeredTrade = hasSelectedSetup and selectedSetup.state == STATE_TRIGGERED and selectedSetup.triggerBar == bar_index
experimentalTriggeredTrade = experimentalBullSignal or experimentalBearSignal

if selectedTriggeredTrade
    float selectedRisk = math.abs(selectedSetup.entryPrice - selectedSetup.stopPrice)
    if selectedRisk > syminfo.mintick
        string selectedDir = tradeDirectionTag(selectedSetup.direction)
        string selectedSetupType = tradeSetupType(selectedSetup.strategyId)
        string tradeId = buildExternalTradeId(selectedSetupType, selectedDir, int(time_close))
        array.push(liveTradeId, tradeId)
        array.push(liveTradeStrategy, selectedSetup.strategyId)
        array.push(liveTradeSetup, selectedSetupType)
        array.push(liveTradeDirection, selectedSetup.direction)
        array.push(liveTradeEntry, selectedSetup.entryPrice)
        array.push(liveTradeStop, selectedSetup.stopPrice)
        array.push(liveTradeDynamicStop, selectedSetup.stopPrice)
        array.push(liveTradeTp1, selectedSetup.tp1)
        array.push(liveTradeTp2, selectedSetup.tp2)
        array.push(liveTradeRunner, nz(selectedSetup.runnerTarget, selectedSetup.tp2))
        array.push(liveTradeRisk, selectedRisk)
        array.push(liveTradeRealizedR, 0.0)
        array.push(liveTradeEntryBar, bar_index)
        array.push(liveTradeTriggerBar, selectedSetup.triggerBar)
        array.push(liveTradeQuality, nz(selectedSetup.displacementScore, 0))
        array.push(liveTradePartialTaken, false)
        array.push(liveTradeMovedBe, false)
        array.push(liveTradeExperimental, false)
        if emitOpenAlerts
            openAlertPayload := buildPayload(selectedSetupType, selectedDir, selectedSetup.entryPrice, selectedSetup.stopPrice, nz(selectedSetup.runnerTarget, selectedSetup.tp2), nz(selectedSetup.displacementScore, 0), "SIGNAL_OPEN")

if experimentalTriggeredTrade
    ZoneCandidate xpZone = experimentalBullSignal ? experimentalBullZone : experimentalBearZone
    TradePlanState xpPlan = experimentalBullSignal ? experimentalBullPlan : experimentalBearPlan
    int xpDir = experimentalBullSignal ? DIR_BULL : DIR_BEAR
    int xpScore = experimentalBullSignal ? experimentalBullScore : experimentalBearScore
    float xpRisk = math.abs(xpPlan.entryPrice - xpPlan.stopPrice)
    if xpRisk > syminfo.mintick
        string xpDirText = tradeDirectionTag(xpDir)
        string xpSetupType = "FVG_MITIGATION"
        string xpTradeId = buildExternalTradeId(xpSetupType, xpDirText, int(time_close))
        array.push(liveTradeId, xpTradeId)
        array.push(liveTradeStrategy, 0)
        array.push(liveTradeSetup, xpSetupType)
        array.push(liveTradeDirection, xpDir)
        array.push(liveTradeEntry, xpPlan.entryPrice)
        array.push(liveTradeStop, xpPlan.stopPrice)
        array.push(liveTradeDynamicStop, xpPlan.stopPrice)
        array.push(liveTradeTp1, xpPlan.tp1)
        array.push(liveTradeTp2, xpPlan.tp2)
        array.push(liveTradeRunner, nz(xpPlan.runnerTarget, xpPlan.tp2))
        array.push(liveTradeRisk, xpRisk)
        array.push(liveTradeRealizedR, 0.0)
        array.push(liveTradeEntryBar, bar_index)
        array.push(liveTradeTriggerBar, bar_index)
        array.push(liveTradeQuality, xpScore)
        array.push(liveTradePartialTaken, false)
        array.push(liveTradeMovedBe, false)
        array.push(liveTradeExperimental, true)
        if emitOpenAlerts and openAlertPayload == ""
            openAlertPayload := buildPayload(xpSetupType, xpDirText, xpPlan.entryPrice, xpPlan.stopPrice, nz(xpPlan.runnerTarget, xpPlan.tp2), xpScore, "SIGNAL_OPEN")

if array.size(liveTradeId) > 0
    int tradeIdx = array.size(liveTradeId) - 1
    while tradeIdx >= 0
        int entryBar = array.get(liveTradeEntryBar, tradeIdx)
        if bar_index > entryBar
            int dir = array.get(liveTradeDirection, tradeIdx)
            float entryPrice = array.get(liveTradeEntry, tradeIdx)
            float riskValue = array.get(liveTradeRisk, tradeIdx)
            float activeStop = array.get(liveTradeDynamicStop, tradeIdx)
            float tp1Price = array.get(liveTradeTp1, tradeIdx)
            float tp2Price = array.get(liveTradeTp2, tradeIdx)
            float runnerPrice = array.get(liveTradeRunner, tradeIdx)
            bool partialTaken = array.get(liveTradePartialTaken, tradeIdx)
            bool movedBe = array.get(liveTradeMovedBe, tradeIdx)
            float realizedR = array.get(liveTradeRealizedR, tradeIdx)
            bool stopHit = dir == DIR_BULL ? low <= activeStop : high >= activeStop
            bool tp1Hit = not partialTaken and not na(tp1Price) and (dir == DIR_BULL ? high >= tp1Price : low <= tp1Price)
            bool finalTargetHit = dir == DIR_BULL ? high >= nz(runnerPrice, tp2Price) : low <= nz(runnerPrice, tp2Price)
            bool timeStopHit = useTimeStop and (bar_index - entryBar) >= timeStopBars
            float finalTargetR = math.abs(nz(runnerPrice, tp2Price) - entryPrice) / math.max(riskValue, syminfo.mintick)
            bool closeTrade = false
            bool ambiguousTrade = false
            float closeTradeR = realizedR
            string closeReason = ""

            if not partialTaken and targetModel == "Partials + Runner"
                if tp1Hit and stopHit
                    ambiguousTrade := true
                    closeTrade := true
                    closeTradeR := 0.0
                    closeReason := "AMBIGUOUS_TP1_SL"
                else if tp1Hit
                    realizedR += (partialClosePct / 100.0) * partialR1
                    array.set(liveTradeRealizedR, tradeIdx, realizedR)
                    array.set(liveTradePartialTaken, tradeIdx, true)
                    partialTaken := true
                    if moveRunnerToBe
                        array.set(liveTradeDynamicStop, tradeIdx, entryPrice)
                        array.set(liveTradeMovedBe, tradeIdx, true)
                        movedBe := true
                    stopHit := dir == DIR_BULL ? low <= array.get(liveTradeDynamicStop, tradeIdx) : high >= array.get(liveTradeDynamicStop, tradeIdx)
                    finalTargetHit := dir == DIR_BULL ? high >= nz(runnerPrice, tp2Price) : low <= nz(runnerPrice, tp2Price)

            if not closeTrade
                if finalTargetHit and stopHit
                    ambiguousTrade := true
                    closeTrade := true
                    closeTradeR := realizedR
                    closeReason := "AMBIGUOUS_FINAL"
                else if finalTargetHit
                    closeTrade := true
                    float runnerPortion = targetModel == "Partials + Runner" ? (1.0 - partialClosePct / 100.0) : 1.0
                    closeTradeR := realizedR + runnerPortion * finalTargetR
                    closeReason := partialTaken ? "TP2" : "TP"
                else if stopHit
                    closeTrade := true
                    float remainingLoss = partialTaken ? (movedBe ? 0.0 : -(1.0 - partialClosePct / 100.0)) : -1.0
                    closeTradeR := realizedR + remainingLoss
                    closeReason := partialTaken and movedBe ? "BE" : "SL"
                else if timeStopHit
                    closeTrade := true
                    float openR = dir == DIR_BULL ? (close - entryPrice) / math.max(riskValue, syminfo.mintick) : (entryPrice - close) / math.max(riskValue, syminfo.mintick)
                    float runnerPortion = partialTaken ? (1.0 - partialClosePct / 100.0) : 1.0
                    closeTradeR := realizedR + runnerPortion * openR
                    closeReason := "TIME_STOP"

            if closeTrade
                bool countInStats = not array.get(liveTradeExperimental, tradeIdx) or trackExperimentalInStats
                if countInStats
                    totalClosedTrades += 1
                    totalNetR += closeTradeR
                    if ambiguousTrade
                        totalAmbiguous += 1
                    else if closeTradeR > 0
                        totalWins += 1
                        decisiveClosedTrades += 1
                        totalPositiveR += closeTradeR
                    else if closeTradeR < 0
                        totalLosses += 1
                        decisiveClosedTrades += 1
                        totalNegativeR += closeTradeR
                    else
                        totalAmbiguous += 1
                lastCloseReason := closeReason
                lastClosedR := closeTradeR
                if emitCloseAlerts and closeAlertPayload == ""
                    closeAlertPayload := buildPayload(array.get(liveTradeSetup, tradeIdx), tradeDirectionTag(dir), entryPrice, array.get(liveTradeStop, tradeIdx), close, array.get(liveTradeQuality, tradeIdx), "SIGNAL_CLOSE")
                // Store closed trade for visual history
                array.push(closedTradeStrategy, array.get(liveTradeStrategy, tradeIdx))
                array.push(closedTradeSetup, array.get(liveTradeSetup, tradeIdx))
                array.push(closedTradeDirection, dir)
                array.push(closedTradeEntry, entryPrice)
                array.push(closedTradeInitialStop, array.get(liveTradeStop, tradeIdx))
                array.push(closedTradeFinalStop, array.get(liveTradeDynamicStop, tradeIdx))
                array.push(closedTradeTp1, tp1Price)
                array.push(closedTradeTp2, tp2Price)
                array.push(closedTradeRunner, runnerPrice)
                array.push(closedTradeEntryBar, entryBar)
                array.push(closedTradeTriggerBar, array.get(liveTradeTriggerBar, tradeIdx))
                array.push(closedTradeCloseBar, bar_index)
                array.push(closedTradeClosePrice, close)
                array.push(closedTradeCloseReason, closeReason)
                array.push(closedTradeR, closeTradeR)
                array.push(closedTradeAmbiguous, ambiguousTrade)
                array.push(closedTradeWon, not ambiguousTrade and closeTradeR > 0)
                array.push(closedTradePartialTaken, partialTaken)
                // Trim to render limit
                while array.size(closedTradeStrategy) > closedTradeRenderLimit
                    array.shift(closedTradeStrategy)
                    array.shift(closedTradeSetup)
                    array.shift(closedTradeDirection)
                    array.shift(closedTradeEntry)
                    array.shift(closedTradeInitialStop)
                    array.shift(closedTradeFinalStop)
                    array.shift(closedTradeTp1)
                    array.shift(closedTradeTp2)
                    array.shift(closedTradeRunner)
                    array.shift(closedTradeEntryBar)
                    array.shift(closedTradeTriggerBar)
                    array.shift(closedTradeCloseBar)
                    array.shift(closedTradeClosePrice)
                    array.shift(closedTradeCloseReason)
                    array.shift(closedTradeR)
                    array.shift(closedTradeAmbiguous)
                    array.shift(closedTradeWon)
                    array.shift(closedTradePartialTaken)
                array.remove(liveTradeId, tradeIdx)
                array.remove(liveTradeStrategy, tradeIdx)
                array.remove(liveTradeSetup, tradeIdx)
                array.remove(liveTradeDirection, tradeIdx)
                array.remove(liveTradeEntry, tradeIdx)
                array.remove(liveTradeStop, tradeIdx)
                array.remove(liveTradeDynamicStop, tradeIdx)
                array.remove(liveTradeTp1, tradeIdx)
                array.remove(liveTradeTp2, tradeIdx)
                array.remove(liveTradeRunner, tradeIdx)
                array.remove(liveTradeRisk, tradeIdx)
                array.remove(liveTradeRealizedR, tradeIdx)
                array.remove(liveTradeEntryBar, tradeIdx)
                array.remove(liveTradeTriggerBar, tradeIdx)
                array.remove(liveTradeQuality, tradeIdx)
                array.remove(liveTradePartialTaken, tradeIdx)
                array.remove(liveTradeMovedBe, tradeIdx)
                array.remove(liveTradeExperimental, tradeIdx)
        tradeIdx -= 1

if openAlertPayload != "" and emitOpenAlerts
    alert(openAlertPayload, alert.freq_once_per_bar_close)

if closeAlertPayload != "" and emitCloseAlerts
    alert(closeAlertPayload, alert.freq_once_per_bar_close)

alertcondition(selectedTriggeredTrade, "Strategy Signal Open", "SMC Clean Signals strategy trigger")
alertcondition(experimentalTriggeredTrade, "Experimental FVG Open", "SMC Clean Signals experimental FVG trigger")
alertcondition(selectedTriggeredTrade or experimentalTriggeredTrade, "Any Signal Open", "SMC Clean Signals trigger")
alertcondition(closeAlertPayload != "", "Tracked Trade Close", "SMC Clean Signals tracked trade close")

s1Setup := finalizeTriggeredSetup(s1Setup, selectedTriggeredTrade and selectedSetup.strategyId == STRAT_S1)
s2Setup := finalizeTriggeredSetup(s2Setup, selectedTriggeredTrade and selectedSetup.strategyId == STRAT_S2)
s3Setup := finalizeTriggeredSetup(s3Setup, selectedTriggeredTrade and selectedSetup.strategyId == STRAT_S3)
s4Setup := finalizeTriggeredSetup(s4Setup, selectedTriggeredTrade and selectedSetup.strategyId == STRAT_S4)
s5Setup := finalizeTriggeredSetup(s5Setup, selectedTriggeredTrade and selectedSetup.strategyId == STRAT_S5)

hasActiveTrade = array.size(liveTradeId) > 0
activeTradeIdx = array.size(liveTradeId) - 1
activeTradeEntry = hasActiveTrade ? array.get(liveTradeEntry, activeTradeIdx) : na
activeTradeStop = hasActiveTrade ? array.get(liveTradeDynamicStop, activeTradeIdx) : na
activeTradeTp1 = hasActiveTrade ? array.get(liveTradeTp1, activeTradeIdx) : na
activeTradeTp2 = hasActiveTrade ? array.get(liveTradeRunner, activeTradeIdx) : na
activeTradeDirection = hasActiveTrade ? array.get(liveTradeDirection, activeTradeIdx) : DIR_NONE
activeTradeStrategy = hasActiveTrade ? array.get(liveTradeStrategy, activeTradeIdx) : 0
activeTradeEntryBar = hasActiveTrade ? array.get(liveTradeEntryBar, activeTradeIdx) : na
activeTradeSetup = hasActiveTrade ? array.get(liveTradeSetup, activeTradeIdx) : ""
avgClosedR = totalClosedTrades > 0 ? totalNetR / totalClosedTrades : na
avgWinR = totalWins > 0 ? totalPositiveR / totalWins : na
avgLossR = totalLosses > 0 ? totalNegativeR / totalLosses : na
winRate = decisiveClosedTrades >= minClosedTradesForWinRate and decisiveClosedTrades > 0 ? totalWins * 100.0 / decisiveClosedTrades : na

// ============================================================================
//  13. DRAWING HELPERS
// ============================================================================
var line[] drawLines = array.new_line()
var label[] drawLabels = array.new_label()
var box[] drawBoxes = array.new_box()

clearLines() =>
    while array.size(drawLines) > 0
        line.delete(array.shift(drawLines))

clearLabels() =>
    while array.size(drawLabels) > 0
        label.delete(array.shift(drawLabels))

clearBoxes() =>
    while array.size(drawBoxes) > 0
        box.delete(array.shift(drawBoxes))

safeHistoryBar(int candidateBar) =>
    int(math.max(0, math.max(candidateBar, bar_index - 1990)))

addLevel(int x1, float y, string labelText, color lineColor, bool isHigh) =>
    int startBar = safeHistoryBar(x1)
    line levelLine = line.new(startBar, y, bar_index, y, xloc = xloc.bar_index, extend = extend.right, color = lineColor, width = 1, style = line.style_dashed)
    array.push(drawLines, levelLine)
    if str.length(labelText) > 0
        label levelLabel = label.new(bar_index, y, labelText, xloc = xloc.bar_index,
             style = isHigh ? label.style_label_lower_left : label.style_label_upper_left,
             color = color.new(color.rgb(15, 21, 41), 10), textcolor = lineColor, size = size.tiny)
        array.push(drawLabels, levelLabel)

addZoneBox(int leftBar, float zoneHigh, float zoneLow, color fillColor, color borderColor, string labelText, int textColorOpacity) =>
    int startBar = safeHistoryBar(leftBar)
    box zoneBox = box.new(startBar, zoneHigh, bar_index + 1, zoneLow,
         xloc = xloc.bar_index, bgcolor = fillColor, border_color = borderColor, border_width = 1)
    array.push(drawBoxes, zoneBox)
    if str.length(labelText) > 0
        label zoneLabel = label.new(bar_index, zoneHigh, labelText, xloc = xloc.bar_index,
             style = label.style_label_lower_left, color = color.new(color.rgb(15, 21, 41), 0), textcolor = color.new(borderColor, textColorOpacity), size = size.tiny)
        array.push(drawLabels, zoneLabel)

addSpanBox(int leftBar, int rightBar, float topPrice, float bottomPrice, color fillColor, color borderColor) =>
    int startBar = safeHistoryBar(leftBar)
    int endBar = math.max(startBar + 1, rightBar)
    box projectionBox = box.new(startBar, math.max(topPrice, bottomPrice), endBar, math.min(topPrice, bottomPrice),
         xloc = xloc.bar_index, bgcolor = fillColor, border_color = borderColor, border_width = 1)
    array.push(drawBoxes, projectionBox)

drawSessionLevel(SessionState sessionRef) =>
    if showSessionLevels and sessionVisible(sessionRef) and not na(sessionRef.drawHigh)
        bool currentlyActive = sessionRef.active
        color tone = currentlyActive ? sessionRef.baseColor : color.new(sessionRef.baseColor, 45)
        addLevel(nz(sessionRef.drawStartBar, bar_index), sessionRef.drawHigh, sessionRef.key + " H", tone, true)
        addLevel(nz(sessionRef.drawStartBar, bar_index), sessionRef.drawLow, sessionRef.key + " L", tone, false)

setupPrimaryTarget(SetupState setupRef) =>
    not na(setupRef.runnerTarget) ? setupRef.runnerTarget :
     not na(setupRef.tp2) ? setupRef.tp2 : setupRef.tp1

drawSetupProjection(SetupState setupRef, bool isSelected) =>
    bool showSetup = setupRef.strategyId > 0 and (setupRef.state == STATE_ARMED or setupRef.state == STATE_TRIGGERED)
    if showSetup
        color biasBase = setupRef.direction == DIR_BULL ? color.new(clrBull, 0) : color.new(clrBear, 0)
        int fade = isSelected ? 0 : 48
        if showSelectedLiquidity and not na(setupRef.liquidityPrice)
            addLevel(nz(setupRef.sweepBar, bar_index), setupRef.liquidityPrice, isSelected ? strategyCode(setupRef.strategyId) + " " + setupRef.liquidityLabel : "", color.new(biasBase, fade), setupRef.direction == DIR_BEAR)
        if showSelectedLiquidity and not na(setupRef.mssLevel)
            addLevel(nz(setupRef.mssBar, bar_index), setupRef.mssLevel, isSelected ? "MSS" : "", color.new(color.white, isSelected ? 0 : 55), setupRef.direction == DIR_BULL)
        if showProjectedZone and not na(setupRef.zoneHigh) and not na(setupRef.zoneLow)
            color zoneBorder = color.new(biasBase, isSelected ? 0 : 45)
            color zoneFill = color.new(biasBase, setupRef.state == STATE_TRIGGERED ? (isSelected ? 83 : 92) : (isSelected ? 90 : 95))
            addZoneBox(nz(setupRef.zoneBar, bar_index), setupRef.zoneHigh, setupRef.zoneLow, zoneFill, zoneBorder, isSelected ? strategyCode(setupRef.strategyId) + " " + zoneText(setupRef.zoneType) : "", isSelected ? 0 : 70)
            float targetPrice = setupPrimaryTarget(setupRef)
            if not na(setupRef.entryPrice) and not na(setupRef.stopPrice) and not na(targetPrice)
                int projectionLeft = nz(setupRef.sweepBar, nz(setupRef.zoneBar, bar_index))
                int projectionRight = setupRef.state == STATE_ARMED ? math.max(bar_index + 1, nz(setupRef.expiryBar, bar_index + 1)) : bar_index + 1
                addSpanBox(projectionLeft, projectionRight, setupRef.direction == DIR_BULL ? targetPrice : setupRef.entryPrice, setupRef.direction == DIR_BULL ? setupRef.entryPrice : targetPrice, color.new(clrRewardBox, isSelected ? 82 : 92), color.new(clrRewardBox, isSelected ? 5 : 55))
                addSpanBox(projectionLeft, projectionRight, setupRef.direction == DIR_BULL ? setupRef.entryPrice : setupRef.stopPrice, setupRef.direction == DIR_BULL ? setupRef.stopPrice : setupRef.entryPrice, color.new(clrRiskBox, isSelected ? 84 : 93), color.new(clrRiskBox, isSelected ? 5 : 55))
                bool labelProjectionLevels = isSelected and (not hasActiveTrade or activeTradeStrategy != setupRef.strategyId or setupRef.state == STATE_ARMED)
                if labelProjectionLevels
                    addLevel(projectionLeft, setupRef.entryPrice, "Entry", color.new(clrEntryLine, 0), setupRef.direction == DIR_BEAR)
                    addLevel(projectionLeft, setupRef.stopPrice, "Stop", color.new(clrStopLine, 0), setupRef.direction == DIR_BULL)
                    addLevel(projectionLeft, targetPrice, "Target", color.new(clrTp1Line, 0), setupRef.direction == DIR_BEAR)


// --- Historical Trade Drawing Helpers ---
addHistoricalTradeLevel(int x1, int x2, float y, color lineColor) =>
    int startBar = safeHistoryBar(x1)
    int endBar = math.max(startBar + 1, x2)
    line levelLine = line.new(startBar, y, endBar, y, xloc = xloc.bar_index, color = lineColor, width = 1, style = line.style_dotted)
    array.push(drawLines, levelLine)

addHistoricalTradeBox(int x1, int x2, float topPrice, float bottomPrice, color fillColor, color borderColor) =>
    int startBar = safeHistoryBar(x1)
    int endBar = math.max(startBar + 1, x2)
    box tradeBox = box.new(startBar, math.max(topPrice, bottomPrice), endBar, math.min(topPrice, bottomPrice),
         xloc = xloc.bar_index, bgcolor = fillColor, border_color = borderColor, border_width = 1)
    array.push(drawBoxes, tradeBox)

buildClosedTradeLabel(int idx) =>
    int strat = array.get(closedTradeStrategy, idx)
    int dir = array.get(closedTradeDirection, idx)
    float rVal = array.get(closedTradeR, idx)
    bool won = array.get(closedTradeWon, idx)
    bool ambig = array.get(closedTradeAmbiguous, idx)
    string reason = array.get(closedTradeCloseReason, idx)
    string dirTag = dir == DIR_BULL ? "L" : "S"
    string resultTag = ambig ? "AMB" : won ? "WIN" : "LOSS"
    string rText = str.tostring(rVal, "#.0") + "R"
    if closedTradeLabelMode == "Detailed"
        float entry = array.get(closedTradeEntry, idx)
        float sl = array.get(closedTradeInitialStop, idx)
        float tp = nz(array.get(closedTradeRunner, idx), array.get(closedTradeTp2, idx))
        strategyCode(strat) + " " + dirTag + " | " + resultTag + " " + rText + "\n" +
             "E:" + str.tostring(entry, format.mintick) + " SL:" + str.tostring(sl, format.mintick) + "\n" +
             "TP:" + str.tostring(tp, format.mintick) + " | " + reason
    else
        strategyCode(strat) + " " + dirTag + " " + resultTag + " " + rText + " [" + reason + "]"

drawClosedTrade(int idx) =>
    int dir = array.get(closedTradeDirection, idx)
    float entry = array.get(closedTradeEntry, idx)
    float initialStop = array.get(closedTradeInitialStop, idx)
    float tp1Price = array.get(closedTradeTp1, idx)
    float runner = nz(array.get(closedTradeRunner, idx), array.get(closedTradeTp2, idx))
    int entryBar = array.get(closedTradeEntryBar, idx)
    int closeBar = nz(array.get(closedTradeCloseBar, idx), bar_index)
    bool won = array.get(closedTradeWon, idx)
    bool ambig = array.get(closedTradeAmbiguous, idx)
    float finalTarget = not na(runner) ? runner : tp1Price
    color resultColor = ambig ? clrHistoryAmbiguous : won ? clrHistoryWin : clrHistoryLoss
    // Entry level
    addHistoricalTradeLevel(entryBar, closeBar, entry, color.new(clrEntryLine, 40))
    // Stop level
    addHistoricalTradeLevel(entryBar, closeBar, initialStop, color.new(clrStopLine, 50))
    // Final target level
    if not na(finalTarget)
        addHistoricalTradeLevel(entryBar, closeBar, finalTarget, color.new(resultColor, 40))
    // TP1 level if different
    if showClosedTradeTp1 and not na(tp1Price) and not na(finalTarget) and math.abs(tp1Price - finalTarget) > syminfo.mintick * 5
        addHistoricalTradeLevel(entryBar, closeBar, tp1Price, color.new(clrTp1Line, 60))
    // Risk box (entry to stop)
    if dir == DIR_BULL
        addHistoricalTradeBox(entryBar, closeBar, entry, initialStop, color.new(clrRiskBox, 92), color.new(resultColor, 60))
    else
        addHistoricalTradeBox(entryBar, closeBar, initialStop, entry, color.new(clrRiskBox, 92), color.new(resultColor, 60))
    // Reward box (entry to target)
    if not na(finalTarget)
        if dir == DIR_BULL
            addHistoricalTradeBox(entryBar, closeBar, finalTarget, entry, color.new(clrRewardBox, 92), color.new(resultColor, 60))
        else
            addHistoricalTradeBox(entryBar, closeBar, entry, finalTarget, color.new(clrRewardBox, 92), color.new(resultColor, 60))
    // Result label
    if showClosedTradeLabels
        string labelTxt = buildClosedTradeLabel(idx)
        int safeLabelBar = safeHistoryBar(closeBar)
        label resultLabel = label.new(safeLabelBar, dir == DIR_BULL ? (not na(finalTarget) ? finalTarget : entry) : (not na(initialStop) ? initialStop : entry),
             labelTxt, xloc = xloc.bar_index,
             style = dir == DIR_BULL ? label.style_label_lower_left : label.style_label_upper_left,
             color = color.new(resultColor, 15), textcolor = color.white, size = size.tiny)
        array.push(drawLabels, resultLabel)

drawClosedTrades() =>
    if showClosedTradesOnChart
        int count = array.size(closedTradeStrategy)
        int startIdx = math.max(0, count - closedTradeRenderLimit)
        int oldestAllowed = bar_index - 1990
        for idx = startIdx to count - 1
            if idx >= 0 and idx < count
                int cBar = array.get(closedTradeCloseBar, idx)
                if cBar >= oldestAllowed
                    drawClosedTrade(idx)

// ============================================================================
//  13. CHART VISUALS
// ============================================================================
clearLines()
clearLabels()
clearBoxes()

if showPdhl
    if not na(pdh)
        addLevel(bar_index - 20, pdh, "PDH", color.new(clrPdhl, 0), true)
    if not na(pdl)
        addLevel(bar_index - 20, pdl, "PDL", color.new(clrPdhl, 0), false)

drawSessionLevel(londonState)
drawSessionLevel(newYorkState)
drawSessionLevel(tokyoState)

if showEqualHighLow
    if not na(equalHighLevel)
        addLevel(nz(equalHighBar, bar_index), equalHighLevel, "EQH", color.new(clrEqHigh, 0), true)
    if not na(equalLowLevel)
        addLevel(nz(equalLowBar, bar_index), equalLowLevel, "EQL", color.new(clrEqLow, 0), false)

drawSetupProjection(displayS1Setup, hasSelectedSetup and selectedSetup.strategyId == STRAT_S1)
drawSetupProjection(displayS2Setup, hasSelectedSetup and selectedSetup.strategyId == STRAT_S2)
drawSetupProjection(displayS3Setup, hasSelectedSetup and selectedSetup.strategyId == STRAT_S3)
drawSetupProjection(displayS4Setup, hasSelectedSetup and selectedSetup.strategyId == STRAT_S4)
drawSetupProjection(displayS5Setup, hasSelectedSetup and selectedSetup.strategyId == STRAT_S5)

// Draw historical closed trades
drawClosedTrades()

if showTradeLevels and hasActiveTrade
    addLevel(nz(activeTradeEntryBar, bar_index), activeTradeEntry, "Entry", color.new(clrEntryLine, 0), activeTradeDirection == DIR_BEAR)
    addLevel(nz(activeTradeEntryBar, bar_index), activeTradeStop, "Stop", color.new(clrStopLine, 0), activeTradeDirection == DIR_BULL)
    if not na(activeTradeTp1)
        addLevel(nz(activeTradeEntryBar, bar_index), activeTradeTp1, "TP1", color.new(clrTp1Line, 0), activeTradeDirection == DIR_BEAR)
    if not na(activeTradeTp2) and activeTradeTp2 != activeTradeTp1
        addLevel(nz(activeTradeEntryBar, bar_index), activeTradeTp2, "TP2", color.new(clrTp2Line, 0), activeTradeDirection == DIR_BEAR)
else if hasSelectedSetup and showTradeLevels and selectedSetup.state == STATE_TRIGGERED
    addLevel(nz(selectedSetup.triggerBar, bar_index), selectedSetup.entryPrice, "Entry", color.new(clrEntryLine, 0), selectedSetup.direction == DIR_BEAR)
    addLevel(nz(selectedSetup.triggerBar, bar_index), selectedSetup.stopPrice, "Stop", color.new(clrStopLine, 0), selectedSetup.direction == DIR_BULL)
    if not na(selectedSetup.tp1)
        addLevel(nz(selectedSetup.triggerBar, bar_index), selectedSetup.tp1, "TP1", color.new(clrTp1Line, 0), selectedSetup.direction == DIR_BEAR)
    if not na(selectedSetup.tp2) and selectedSetup.tp2 != selectedSetup.tp1
        addLevel(nz(selectedSetup.triggerBar, bar_index), selectedSetup.tp2, "TP2", color.new(clrTp2Line, 0), selectedSetup.direction == DIR_BEAR)

if showPassiveZones and enableFvg
    if array.size(bullFvgHigh) > 0
        int bullFvgDraw = math.max(array.size(bullFvgHigh) - passiveZoneLimit, 0)
        for idx = bullFvgDraw to array.size(bullFvgHigh) - 1
            if idx >= 0 and idx < array.size(bullFvgHigh)
                addZoneBox(array.get(bullFvgBar, idx), array.get(bullFvgHigh, idx), array.get(bullFvgLow, idx), color.new(clrFvgBull, 93), color.new(clrFvgBull, 35), showPassiveZoneLabels ? "Bull FVG" : "", 50)
    if array.size(bearFvgHigh) > 0
        int bearFvgDraw = math.max(array.size(bearFvgHigh) - passiveZoneLimit, 0)
        for idx = bearFvgDraw to array.size(bearFvgHigh) - 1
            if idx >= 0 and idx < array.size(bearFvgHigh)
                addZoneBox(array.get(bearFvgBar, idx), array.get(bearFvgHigh, idx), array.get(bearFvgLow, idx), color.new(clrFvgBear, 93), color.new(clrFvgBear, 35), showPassiveZoneLabels ? "Bear FVG" : "", 50)
if showPassiveZones and enableOb
    if array.size(bullObHigh) > 0
        int bullObDraw = math.max(array.size(bullObHigh) - passiveZoneLimit, 0)
        for idx = bullObDraw to array.size(bullObHigh) - 1
            if idx >= 0 and idx < array.size(bullObHigh)
                addZoneBox(array.get(bullObBar, idx), array.get(bullObHigh, idx), array.get(bullObLow, idx), color.new(clrObBull, 92), color.new(clrObBull, 45), showPassiveZoneLabels ? "Bull OB" : "", 55)
    if array.size(bearObHigh) > 0
        int bearObDraw = math.max(array.size(bearObHigh) - passiveZoneLimit, 0)
        for idx = bearObDraw to array.size(bearObHigh) - 1
            if idx >= 0 and idx < array.size(bearObHigh)
                addZoneBox(array.get(bearObBar, idx), array.get(bearObHigh, idx), array.get(bearObLow, idx), color.new(clrObBear, 92), color.new(clrObBear, 45), showPassiveZoneLabels ? "Bear OB" : "", 55)

bool bullSweepMarker = (s1PublicSweepThisBar and displayS1Setup.direction == DIR_BULL) or (s2PublicSweepThisBar and displayS2Setup.direction == DIR_BULL) or (s3PublicSweepThisBar and displayS3Setup.direction == DIR_BULL) or (s4PublicSweepThisBar and displayS4Setup.direction == DIR_BULL) or (s5PublicSweepThisBar and displayS5Setup.direction == DIR_BULL)
bool bearSweepMarker = (s1PublicSweepThisBar and displayS1Setup.direction == DIR_BEAR) or (s2PublicSweepThisBar and displayS2Setup.direction == DIR_BEAR) or (s3PublicSweepThisBar and displayS3Setup.direction == DIR_BEAR) or (s4PublicSweepThisBar and displayS4Setup.direction == DIR_BEAR) or (s5PublicSweepThisBar and displayS5Setup.direction == DIR_BEAR)
bool bullMssMarker = (s1MssThisBar and displayS1Setup.direction == DIR_BULL) or (s2MssThisBar and displayS2Setup.direction == DIR_BULL) or (s3MssThisBar and displayS3Setup.direction == DIR_BULL) or (s4MssThisBar and displayS4Setup.direction == DIR_BULL) or (s5MssThisBar and displayS5Setup.direction == DIR_BULL)
bool bearMssMarker = (s1MssThisBar and displayS1Setup.direction == DIR_BEAR) or (s2MssThisBar and displayS2Setup.direction == DIR_BEAR) or (s3MssThisBar and displayS3Setup.direction == DIR_BEAR) or (s4MssThisBar and displayS4Setup.direction == DIR_BEAR) or (s5MssThisBar and displayS5Setup.direction == DIR_BEAR)
bool bullArmedMarker = (s1ArmedThisBar and displayS1Setup.direction == DIR_BULL) or (s2ArmedThisBar and displayS2Setup.direction == DIR_BULL) or (s3ArmedThisBar and displayS3Setup.direction == DIR_BULL) or (s4ArmedThisBar and displayS4Setup.direction == DIR_BULL) or (s5ArmedThisBar and displayS5Setup.direction == DIR_BULL)
bool bearArmedMarker = (s1ArmedThisBar and displayS1Setup.direction == DIR_BEAR) or (s2ArmedThisBar and displayS2Setup.direction == DIR_BEAR) or (s3ArmedThisBar and displayS3Setup.direction == DIR_BEAR) or (s4ArmedThisBar and displayS4Setup.direction == DIR_BEAR) or (s5ArmedThisBar and displayS5Setup.direction == DIR_BEAR)
bool bullTriggeredMarker = (s1TriggeredThisBar and displayS1Setup.direction == DIR_BULL) or (s2TriggeredThisBar and displayS2Setup.direction == DIR_BULL) or (s3TriggeredThisBar and displayS3Setup.direction == DIR_BULL) or (s4TriggeredThisBar and displayS4Setup.direction == DIR_BULL) or (s5TriggeredThisBar and displayS5Setup.direction == DIR_BULL)
bool bearTriggeredMarker = (s1TriggeredThisBar and displayS1Setup.direction == DIR_BEAR) or (s2TriggeredThisBar and displayS2Setup.direction == DIR_BEAR) or (s3TriggeredThisBar and displayS3Setup.direction == DIR_BEAR) or (s4TriggeredThisBar and displayS4Setup.direction == DIR_BEAR) or (s5TriggeredThisBar and displayS5Setup.direction == DIR_BEAR)

// Lifecycle markers
plotshape(showStepMarkers and bullSweepMarker, title = "Bull Sweep", style = shape.xcross, location = location.belowbar, color = color.new(clrSweepBull, 0), size = size.tiny)
plotshape(showStepMarkers and bearSweepMarker, title = "Bear Sweep", style = shape.xcross, location = location.abovebar, color = color.new(clrSweepBear, 0), size = size.tiny)
plotshape(showStepMarkers and bullMssMarker, title = "Bull MSS", text = "2", style = shape.labelup, location = location.belowbar, color = color.new(color.white, 0), textcolor = color.black, size = size.tiny)
plotshape(showStepMarkers and bearMssMarker, title = "Bear MSS", text = "2", style = shape.labeldown, location = location.abovebar, color = color.new(color.white, 0), textcolor = color.black, size = size.tiny)
plotshape(showStepMarkers and bullArmedMarker, title = "Bull Zone Formed", text = "3", style = shape.square, location = location.belowbar, color = color.new(clrSweepBull, 0), textcolor = color.white, size = size.tiny)
plotshape(showStepMarkers and bearArmedMarker, title = "Bear Zone Formed", text = "3", style = shape.square, location = location.abovebar, color = color.new(clrSweepBear, 0), textcolor = color.white, size = size.tiny)
plotshape(showStepMarkers and bullTriggeredMarker, title = "Bull Triggered", text = "4", style = shape.diamond, location = location.belowbar, color = color.new(clrSweepBull, 0), textcolor = color.white, size = size.tiny)
plotshape(showStepMarkers and bearTriggeredMarker, title = "Bear Triggered", text = "4", style = shape.diamond, location = location.abovebar, color = color.new(clrSweepBear, 0), textcolor = color.white, size = size.tiny)
plotshape(showStepMarkers and experimentalBullSignal, title = "Experimental Bull FVG", text = "X", style = shape.circle, location = location.belowbar, color = color.new(clrExperimentalBull, 0), textcolor = color.white, size = size.tiny)
plotshape(showStepMarkers and experimentalBearSignal, title = "Experimental Bear FVG", text = "X", style = shape.circle, location = location.abovebar, color = color.new(clrExperimentalBear, 0), textcolor = color.white, size = size.tiny)

// ============================================================================
//  14. DASHBOARD / EXPLANATION PANEL
// ============================================================================
dashboardPos = dashboardPosition == "Bottom Left" ? position.bottom_left :
     dashboardPosition == "Top Right" ? position.top_right : position.bottom_right

buildWaitingText(SetupState setupRef) =>
    setupRef.state == STATE_INVALIDATED ? setupRef.invalidationReason :
     setupRef.state == STATE_COMPLETED ? "Trade registered" :
     qaExplainReasons ? setupRef.waitingReason : ""

buildExplanation(SetupState setupRef) =>
    if (setupRef.strategyId == 0 or setupRef.state == STATE_IDLE) and hasActiveTrade
        "Live trade: " + activeTradeSetup + "\n" +
         "Direction: " + tradeDirectionTag(activeTradeDirection) + "\n" +
         "Entry: " + str.tostring(activeTradeEntry, format.mintick) + "\n" +
         "Stop: " + str.tostring(activeTradeStop, format.mintick) + "\n" +
         "Target: " + str.tostring(activeTradeTp2, format.mintick)
    else if setupRef.strategyId == 0 or setupRef.state == STATE_IDLE
        "No active setup"
    else
        string explanationText = strategyCode(setupRef.strategyId) + " " + setupRef.strategyLabel + "\n"
        explanationText += "Sweep: " + setupRef.liquidityLabel
        if not na(setupRef.liquidityPrice)
            explanationText += " @ " + str.tostring(setupRef.liquidityPrice, format.mintick)
        explanationText += "\n"
        explanationText += not na(setupRef.mssLevel) ? "MSS: " + str.tostring(setupRef.mssLevel, format.mintick) + "\n" : "MSS: waiting\n"
        if setupRef.state == STATE_ARMED or setupRef.state == STATE_TRIGGERED or setupRef.state == STATE_COMPLETED
            explanationText += "Zone: " + zoneText(setupRef.zoneType) + " " + str.tostring(setupRef.zoneLow, format.mintick) + " - " + str.tostring(setupRef.zoneHigh, format.mintick) + "\n"
            explanationText += "Entry: " + setupRef.entryModel + " @ " + str.tostring(setupRef.entryPrice, format.mintick) + "\n"
            explanationText += "Invalidation: " + str.tostring(setupRef.stopPrice, format.mintick)
        else
            explanationText += "Why waiting: " + buildWaitingText(setupRef)
        explanationText

var table dashboard = na

// Dashboard size helpers
dashboardIsSmall = dashboardSizePreset == "Small"
dashboardIsLarge = dashboardSizePreset == "Large"
dashboardTxtSize = dashboardIsSmall ? size.tiny : dashboardIsLarge ? size.normal : size.small
dashboardShowPerf = showPerformanceRows and not dashboardIsSmall
dashboardShowExplain = showExplanation and not dashboardIsSmall
dashboardShowExtended = dashboardShowExtendedRows and not dashboardIsSmall
dashboardShowConfl = dashboardShowExtended
dashboardShowDisp = dashboardShowExtended
dashboardShowContext = not dashboardIsSmall
dashboardShowQa = qaDailyDebug and not dashboardIsSmall

addDashRow(table tbl, int rowNum, string labelStr, string valueStr, color lblClr, color valClr) =>
    table.cell(tbl, 0, rowNum, labelStr, text_color = lblClr, text_size = dashboardTxtSize)
    table.cell(tbl, 1, rowNum, valueStr, text_color = valClr, text_size = dashboardTxtSize)

if barstate.islast
    if not na(dashboard)
        table.delete(dashboard)
    if showDashboard
        // Count rows needed
        int estRows = 9
        if dashboardShowContext
            estRows += 1
        if dashboardShowDisp
            estRows += 1
        if dashboardShowConfl
            estRows += 1
        if not dashboardIsSmall
            estRows += 2
        if dashboardShowPerf
            estRows += 6
        estRows += 1
        if dashboardShowQa
            estRows += 1
        if dashboardShowExplain
            estRows += 1
        dashboard := table.new(dashboardPos, 2, estRows,
             bgcolor = color.new(clrDashBg, 0), border_color = color.new(color.white, 80), border_width = 1)
        int row = 0
        // Header
        string headerTitle = dashboardIsSmall ? "SMC v6" : "SMC Clean Signals v6"
        string headerVal = dashboardIsSmall ? "" : webhookSource
        table.cell(dashboard, 0, row, headerTitle, text_color = clrDashValueText, bgcolor = color.new(clrDashHeaderBg, 0), text_size = dashboardTxtSize)
        table.cell(dashboard, 1, row, headerVal, text_color = clrDashValueText, bgcolor = color.new(clrDashHeaderBg, 0), text_size = dashboardTxtSize)
        row += 1
        // Profile
        addDashRow(dashboard, row, "Profile", dashboardIsSmall ? profilePreset : marketProfile + " | " + profilePreset, clrDashLabelText, clrDashValueText)
        row += 1
        // HTF Bias
        color htfColor = htfBull ? color.new(clrDashBullText, 0) : htfBear ? color.new(clrDashBearText, 0) : clrDashNeutralText
        addDashRow(dashboard, row, "HTF Bias", htfBiasText + (dashboardIsSmall ? "" : (htfBiasStrong ? " strong" : " soft")), clrDashLabelText, htfColor)
        row += 1
        // External Context (skip in small)
        if dashboardShowContext
            addDashRow(dashboard, row, "Context", externalBiasText + " | " + premiumDiscountText + " | " + regimeName, clrDashLabelText, clrDashValueText)
            row += 1
        // Session
        addDashRow(dashboard, row, "Session", activeSessionText, clrDashLabelText, activeSessionColor)
        row += 1
        // Strategy
        string stratVal = hasSelectedSetup ? strategyCode(selectedSetup.strategyId) + " " + (dashboardIsSmall ? "" : selectedSetup.strategyLabel) : (hasActiveTrade ? activeTradeSetup + (dashboardIsSmall ? "" : " (live)") : "None")
        addDashRow(dashboard, row, "Strategy", stratVal, clrDashLabelText, hasSelectedSetup ? selectedBiasColor : clrDashValueText)
        row += 1
        // State
        string stateVal = hasSelectedSetup ? selectedStateText + " | " + selectedDirectionText : (hasActiveTrade ? "LIVE | " + tradeDirectionTag(activeTradeDirection) : selectedStateText)
        addDashRow(dashboard, row, "State", stateVal, clrDashLabelText, hasSelectedSetup ? selectedBiasColor : clrDashValueText)
        row += 1
        // Entry / Stop
        string esVal = hasSelectedSetup and selectedSetup.state >= STATE_ARMED ? str.tostring(selectedSetup.entryPrice, format.mintick) + " / " + str.tostring(selectedSetup.stopPrice, format.mintick) : hasActiveTrade ? str.tostring(activeTradeEntry, format.mintick) + " / " + str.tostring(activeTradeStop, format.mintick) : "Pending"
        addDashRow(dashboard, row, "Entry/Stop", esVal, clrDashLabelText, clrDashValueText)
        row += 1
        // Target
        if not dashboardIsSmall
            addDashRow(dashboard, row, "Target", hasSelectedSetup and selectedSetup.state >= STATE_ARMED ? selectedSetup.targetModel : (hasActiveTrade ? activeTradeSetup : "Pending"), clrDashLabelText, clrDashValueText)
            row += 1
        // Liquidity + MSS (skip in small)
        if not dashboardIsSmall
            addDashRow(dashboard, row, "Liquidity", hasSelectedSetup ? selectedSetup.liquidityLabel : "None", clrDashLabelText, clrDashValueText)
            row += 1
        // Displacement (extended only)
        if dashboardShowDisp
            string dispVal = hasSelectedSetup and selectedSetup.displacementScore > 0 ? qualityLabel(selectedSetup.displacementScore) + " (" + str.tostring(selectedSetup.displacementScore) + ")" : "Waiting"
            addDashRow(dashboard, row, "Displacement", dispVal, clrDashLabelText, clrDashValueText)
            row += 1
        // Confluence (extended only)
        if dashboardShowConfl
            addDashRow(dashboard, row, "Confluence", hasSelectedSetup ? selectedSetup.confluenceSummary : "Waiting", clrDashLabelText, clrDashValueText)
            row += 1
        // Live Trades
        addDashRow(dashboard, row, "Live", str.tostring(array.size(liveTradeId)) + " active", clrDashLabelText, hasActiveTrade ? color.new(clrDashBullText, 0) : clrDashNeutralText)
        row += 1
        // Performance rows
        if dashboardShowPerf
            wrText = na(winRate) ? "N/A" + (dashboardIsSmall ? "" : " until " + str.tostring(minClosedTradesForWinRate)) : str.tostring(winRate, "#.0") + "%"
            expText = totalClosedTrades > 0 ? str.tostring(avgClosedR, "#.00") + "R" : "N/A"
            avgWinLossText = (totalWins > 0 ? str.tostring(avgWinR, "#.00") : "N/A") + " / " + (totalLosses > 0 ? str.tostring(avgLossR, "#.00") : "N/A")
            addDashRow(dashboard, row, "Closed", str.tostring(totalClosedTrades) + " (" + str.tostring(totalAmbiguous) + " amb)", clrDashLabelText, clrDashValueText)
            row += 1
            color wrColor = na(winRate) ? clrDashNeutralText : winRate >= 55 ? color.new(clrDashBullText, 0) : winRate >= 45 ? color.new(clrDashWarningText, 0) : color.new(clrDashBearText, 0)
            addDashRow(dashboard, row, "WR", wrText, clrDashLabelText, wrColor)
            row += 1
            addDashRow(dashboard, row, "Expect", expText, clrDashLabelText, totalClosedTrades > 0 and avgClosedR >= 0 ? color.new(clrDashBullText, 0) : color.new(clrDashBearText, 0))
            row += 1
            addDashRow(dashboard, row, "Avg W/L", avgWinLossText, clrDashLabelText, clrDashValueText)
            row += 1
            addDashRow(dashboard, row, "Net R", str.tostring(totalNetR, "#.00") + "R", clrDashLabelText, totalNetR >= 0 ? color.new(clrDashBullText, 0) : color.new(clrDashBearText, 0))
            row += 1
            addDashRow(dashboard, row, "Last", lastCloseReason + " | " + (na(lastClosedR) ? "N/A" : str.tostring(lastClosedR, "#.00") + "R"), clrDashLabelText, clrDashValueText)
            row += 1
        // Why Waiting
        string waitLabel = hasSelectedSetup and selectedSetup.strategyId == STRAT_S4 ? "Judas" : "Waiting"
        string waitVal = hasSelectedSetup and selectedSetup.strategyId == STRAT_S4 ? judasAnchorLabel + " | " + selectedSetup.liquidityLabel : (hasSelectedSetup ? buildWaitingText(selectedSetup) : (hasActiveTrade ? "Managing trade" : "Idle"))
        addDashRow(dashboard, row, waitLabel, waitVal, clrDashLabelText, clrDashValueText)
        row += 1
        // QA row
        if dashboardShowQa
            prevDailyTimeText = not na(prevDailyTime) ? str.format_time(prevDailyTime, "yyyy-MM-dd HH:mm", "Etc/UTC") : "n/a"
            addDashRow(dashboard, row, "QA", prevDailyTimeText + " | " + str.tostring(pdh, format.mintick) + " / " + str.tostring(pdl, format.mintick), clrQaLabel, clrQaLabel)
            row += 1
        // Explain row
        if dashboardShowExplain
            addDashRow(dashboard, row, "Explain", buildExplanation(selectedSetup), clrDashLabelText, clrDashValueText)

// ============================================================================
//  15. QA LABELS
// ============================================================================
var label dailyQaLabel = na
var label sessionQaLabel = na

if barstate.islast
    if not na(dailyQaLabel)
        label.delete(dailyQaLabel)
        dailyQaLabel := na
    if qaDailyDebug
        dailyQaText = "Prev D bar\n" +
             "time: " + (not na(prevDailyTime) ? str.format_time(prevDailyTime, "yyyy-MM-dd HH:mm", "Etc/UTC") : "n/a") + "\n" +
             "high: " + str.tostring(pdh, format.mintick) + "\n" +
             "low:  " + str.tostring(pdl, format.mintick)
        dailyQaLabel := label.new(bar_index + 2, high, dailyQaText, style = label.style_label_left, color = color.new(clrQaBg, 0), textcolor = clrQaLabel, size = size.tiny)

    if not na(sessionQaLabel)
        label.delete(sessionQaLabel)
        sessionQaLabel := na
    if qaSessionDebug
        sessionQaText = "Session debug\n" +
             "active: " + activeSessionText + "\n" +
             "LDN prev: " + str.tostring(londonState.prevHigh, format.mintick) + " / " + str.tostring(londonState.prevLow, format.mintick) + "\n" +
             "NY prev: " + str.tostring(newYorkState.prevHigh, format.mintick) + " / " + str.tostring(newYorkState.prevLow, format.mintick) + "\n" +
             "Asia: " + str.tostring(asiaRangeHigh, format.mintick) + " / " + str.tostring(asiaRangeLow, format.mintick)
        sessionQaLabel := label.new(bar_index + 2, low, sessionQaText, style = label.style_label_left, color = color.new(clrDashBg, 0), textcolor = clrDashValueText, size = size.tiny)
