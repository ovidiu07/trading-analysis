// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("SMC Clean Signals v6 [TradeJAudit]", "SMC v6", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 500)

// ═══════════════════════════════════════════════════════════════
//  CHANGELOG (v6.2 – Lifecycle / UX Refactor)
// ═══════════════════════════════════════════════════════════════
// 1. Signal labels refactored with Full / Compact / X-Number
//    modes, configurable size, and lower-obstruction anchoring.
// 2. Late signal printing fixed by separating armed execution
//    planning from the actual trigger that touches the zone.
// 3. Dashboard now supports an optional plain-English strategy
//    description row controlled by "Describe strategy?".
// 4. Setup lifecycle expanded into Candidate / Armed / Triggered
//    states with projected entry, stop, and targets before entry.
// 5. Projected plans and triggered trades now render as distinct
//    visual layers so pending context cannot masquerade as fills.
// ═══════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════
//  CHANGELOG (v6.1 – Chart Clarity & Execution Refactor)
// ═══════════════════════════════════════════════════════════════
// 1. Current-day session-only: session H/L levels drawn only for
//    the current trading day; prior-day lines/labels cleared on
//    day rollover using the configured Time Basis timezone.
// 2. Confluence dashboard: "Score / Threshold" replaced with
//    human-readable confluence labels (Excellent/Strong/Good/
//    Moderate/Weak/Very Weak) plus numeric detail.
// 3. Order block lifecycle: bull/bear OBs visually distinct;
//    mitigated OBs automatically deleted; expired OBs pruned.
//    Bull OB = green/teal, Bear OB = red/pink.
// 4. TP/SL trigger timing: trade boxes appear only when price
//    enters the execution zone (state 2 → candidate); pending
//    zones shown as subtle dashed boxes until triggered.
// 5. Default color/style preservation: London, New York, Tokyo,
//    Sydney, PDH/PDL colors and line styles unchanged.
// ═══════════════════════════════════════════════════════════════
//  CHANGELOG (v6 Display/Execution Refactor – prior)
// ═══════════════════════════════════════════════════════════════
// 1. Display bug fixed: sweep markers, PDH/PDL, EQH/EQL, session H/L,
//    execution zone, dashboard, FVG zones, and OB zones now clear separately.
// 2. Dashboard simplified: removed Regime, Exec Mode, Priority, and Time Basis.
// 3. Entry-zone refactor: execution visuals anchor to entryPriceLogic and
//    entryBarIndex instead of drifting to the signal candle midpoint.
// 4. PDH/PDL and session H/L line system rebuilt with labels, colors,
//    independent draw/clear modules, and stale-object cleanup.
// 5. Dead inputs fixed or removed: partial1Pct is now modeled in trade
//    tracking and dependent inputs use active= where Pine allows it.
// ═══════════════════════════════════════════════════════════════
//  QA CHECKLIST
// ═══════════════════════════════════════════════════════════════
// A) Display toggle tests:
//    - Toggle Show Sweep Confirmation Markers on/off. Only sweep guides move.
//    - Toggle Show PDH/PDL Lines on/off. Only PDH/PDL lines and labels move.
//    - Toggle Show Equal Highs/Lows on/off. Only EQH/EQL lines and labels move.
//    - Toggle Show Session H/L Lines on/off. Only session H/L lines and labels move.
//    - Toggle Show Execution Zone on/off. Only trade/entry visuals move.
//    - Toggle Show Dashboard on/off. Table fully disappears with no stale shell.
// B) Current-day session test:
//    - Open chart spanning multiple days.
//    - Confirm only today's session H/L lines are visible.
//    - In replay: move into a new day; confirm previous day lines are deleted.
// C) Confluence dashboard test:
//    - Trigger setups with varying confluence scores.
//    - Confirm dashboard shows: "Confluence: Strong (6 vs 3 min)" format.
//    - Confirm label changes: Weak / Moderate / Good / Strong / Excellent.
// D) Order block test:
//    - Generate bullish OBs (green) and bearish OBs (red/pink).
//    - Confirm both are visually distinguishable.
//    - Confirm once mitigated (price closes through), they disappear.
//    - Confirm expired OBs (>obExpBars) are pruned.
// E) Execution / TP-SL test:
//    - Find setup where execution zone is visible but not yet touched.
//    - Confirm TP/SL box is NOT shown yet (only pending zone box).
//    - Once price enters execution zone, confirm TP/SL appears.
// F) Default color / style test:
//    - Reset inputs to defaults.
//    - Confirm London/NY/Tokyo/Sydney/PDH/PDL colors match defaults.
//    - Confirm level line style matches default (Dashed).
// ═══════════════════════════════════════════════════════════════
//  IMPLEMENTATION NOTES
// ═══════════════════════════════════════════════════════════════
// entryPriceLogic: fvgUseCE ? (fvgHi+fvgLo)/2 : proximal edge of FVG.
//   Never falls back to close. Standalone FVG uses close (rejection entry).
// entryBarIndex: bar_index on the bar where all conditions become true.
// executionMode: "Confirmed Close" requires barstate.isconfirmed.
//   "Intrabar (Aggressive)" fires immediately (may repaint on live bar).
//   Historical bars are identical (isconfirmed always true historically).
// timeBasis: "UTC" → all time() calls use Etc/UTC with UTC-expressed hours.
//   "New York (ICT)" → America/New_York. "Local-per-session" → native IANA.
//   "Custom" → user-provided customTz string.
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
//  SETTINGS
// ═══════════════════════════════════════════════════════════════
grpGeneral  = "① General"
grpSessions = "② Sessions & Kill Zones"
grpStrat    = "③ Strategy Toggles"
grpConf     = "④ Confluence & Detection"
grpFvg      = "⑤ FVG Settings"
grpOB       = "⑥ Order Block Settings"
grpSMT      = "⑦ SMT / Correlation"
grpRisk     = "⑧ Risk Management"
grpScore    = "⑨ Confluence Scoring"
grpDisplay  = "⑩ Display"
grpAdaptive = "⑪ Adaptive Engine"
grpWebhook  = "⑫ TradingView Webhook"
int LEVEL_ANCHOR_LIMIT = 1500

// ── General ──────────────────────────────────────────────────
htfTf           = input.timeframe("240", "HTF Bias Timeframe", group = grpGeneral)
htfEmaLen       = input.int(50, "HTF EMA Period", minval = 10, maxval = 200, group = grpGeneral)
useHtfBias      = input.bool(true, "Require HTF Bias Alignment", group = grpGeneral)
executionTfMax  = input.int(15, "Max Execution TF (minutes)", options = [1, 3, 5, 15, 30, 60], group = grpGeneral,
     tooltip = "Signals only fire when chart TF <= this value.")
requireTfCheck  = input.bool(true, "Enforce Max Execution TF", group = grpGeneral)
executionMode   = input.string("Confirmed Close", "Execution Mode", options = ["Confirmed Close", "Intrabar (Aggressive)"], group = grpGeneral,
     tooltip = "Confirmed Close: signal on bar close (no repaint). Intrabar: fires immediately (may repaint live bar). Historical identical.")
showDebug       = input.bool(false, "Show Debug Labels", group = grpGeneral,
     tooltip = "Prints signal-bar diagnostics: entry price, bar index, strategy, zone type, conditions.")
qaMode          = input.bool(false, "QA Mode (Last-Bar Table)", group = grpGeneral,
     tooltip = "Shows compact QA panel on last bar with session states, strategy states, and toggle status.")

// ── Sessions ─────────────────────────────────────────────────
useSessions     = input.bool(true, "Enable Session Filter", group = grpSessions)
timeBasis       = input.string("UTC", "Time Basis", options = ["UTC", "New York (ICT)", "Local-per-session", "Custom"], group = grpSessions,
     tooltip = "UTC: all sessions evaluated in UTC (default). New York: America/New_York. Local: each session in native TZ. Custom: your IANA string.")
customTz        = input.string("Etc/UTC", "Custom Timezone (IANA)", group = grpSessions, active = timeBasis == "Custom",
     tooltip = "Used only when Time Basis = Custom. Example: Europe/Berlin, Asia/Singapore.")
londonEn        = input.bool(true, "London Session", group = grpSessions)
londonSess      = input.session("0700-1600", "London Hours", group = grpSessions,
     tooltip = "Default is UTC. Adjust if using a different Time Basis.")
newyorkEn       = input.bool(true, "New York Session", group = grpSessions)
newyorkSess     = input.session("1300-2200", "New York Hours", group = grpSessions,
     tooltip = "Default is UTC.")
tokyoEn         = input.bool(false, "Tokyo Session", group = grpSessions)
tokyoSess       = input.session("0000-0900", "Tokyo Hours", group = grpSessions,
     tooltip = "Default is UTC.")
sydneyEn        = input.bool(false, "Sydney Session", group = grpSessions)
sydneySess      = input.session("2200-0700", "Sydney Hours", group = grpSessions,
     tooltip = "Default is UTC.")
overlapEn       = input.bool(true, "London-NY Overlap Highlight", group = grpSessions)
excludeLunch    = input.bool(false, "Exclude Lunch Window", group = grpSessions)
lunchSess       = input.session("1700-1800", "Lunch Hours", group = grpSessions,
     tooltip = "Default is UTC (NY lunch).")
showSessionBg   = input.bool(true, "Show Session Background", group = grpSessions)

// ── Kill Zones ─────────────────────────────────────────────────
londonKzSess    = input.session("0700-1000", "London Kill Zone", group = grpSessions,
     tooltip = "Default is UTC.")
nyAmKzSess      = input.session("1330-1600", "NY AM Kill Zone", group = grpSessions,
     tooltip = "Default is UTC.")
nyPmKzSess      = input.session("1830-2000", "NY PM Kill Zone", group = grpSessions,
     tooltip = "Default is UTC.")

// ── Silver Bullet Windows ───────────────────────────────────
sbLondonSess    = input.session("0800-0900", "SB London Window", group = grpSessions,
     tooltip = "Default is UTC.")
sbNyAmSess      = input.session("1500-1600", "SB NY AM Window", group = grpSessions,
     tooltip = "Default is UTC.")
sbNyPmSess      = input.session("1900-2000", "SB NY PM Window", group = grpSessions,
     tooltip = "Default is UTC.")

// ── Judas Window ─────────────────────────────────────────────
judasSess       = input.session("0500-1000", "Judas Window", group = grpSessions,
     tooltip = "Default is UTC.")

// ── PO3 / AMD Session Windows ────────────────────────────────
po3AccumSess    = input.session("0000-0700", "PO3 Accumulation (Asia)", group = grpSessions,
     tooltip = "Default is UTC.")
po3ManipSess    = input.session("0700-1000", "PO3 Manipulation (London)", group = grpSessions,
     tooltip = "Default is UTC.")
po3DistSess     = input.session("1300-2000", "PO3 Distribution (NY)", group = grpSessions,
     tooltip = "Default is UTC.")

// ── Strategy Toggles ─────────────────────────────────────────
strat1En        = input.bool(true, "S1: Liquidity Raid → MSS → FVG", group = grpStrat)
strat2En        = input.bool(true, "S2: ICT Silver Bullet", group = grpStrat)
strat3En        = input.bool(false, "S3: Power of Three (PO3/AMD)", group = grpStrat)
strat4En        = input.bool(false, "S4: Judas Swing", group = grpStrat)
strat5En        = input.bool(false, "S5: SMT Divergence Reversal", group = grpStrat)
stratPriority   = input.string("S1,S2,S3,S4,S5", "Strategy Priority Order", group = grpStrat,
     tooltip = "Comma-separated. First valid candidate wins. E.g. S2,S1,S3,S4,S5.")
suppressBars    = input.int(5, "Suppress Signals (bars)", minval = 0, maxval = 20, group = grpStrat)

// ── Confluence & Detection ───────────────────────────────────
pivotLen        = input.int(5, "Pivot Lookback Length", minval = 2, maxval = 30, group = grpConf)
useLiqPools     = input.bool(true, "Use Liquidity Pools (master toggle)", group = grpConf,
     tooltip = "Master toggle for all liquidity raid detection. When off, no sweeps are detected.")
useEqlHL        = input.bool(true, "Use Equal Highs/Lows", group = grpConf)
eqlTolMode      = input.string("atr", "EQL Tolerance Mode", options = ["ticks", "atr"], group = grpConf)
eqlTolValue     = input.float(0.10, "EQL Tolerance Value", minval = 0.01, maxval = 1.0, step = 0.01, group = grpConf)
eqlMaxBars      = input.int(50, "EQL Max Bars Apart", minval = 5, maxval = 200, group = grpConf)
usePDHL         = input.bool(true, "Use Previous Day High/Low", group = grpConf)
useSessionHL    = input.bool(true, "Use Session High/Low", group = grpConf)
usePremDisc     = input.bool(true, "Use Premium/Discount Zones", group = grpConf)
useDispFilter   = input.bool(true, "Use Displacement Filter", group = grpConf)
dispMetric      = input.string("atr", "Displacement Metric", options = ["atr", "stdev"], group = grpConf)
dispThreshold   = input.float(1.5, "Displacement Threshold", minval = 0.5, maxval = 5.0, step = 0.1, group = grpConf)
useMSS          = input.bool(true, "Use MSS (Market Structure Shift)", group = grpConf)
mssPivotLen     = input.int(3, "MSS Pivot Length", minval = 1, maxval = 15, group = grpConf)
useVolSpike     = input.bool(false, "Use Volume Spike Filter", group = grpConf)
volLookback     = input.int(20, "Volume Lookback", minval = 5, maxval = 100, group = grpConf)
volMultiple     = input.float(1.5, "Volume Spike Multiple", minval = 1.0, maxval = 5.0, step = 0.1, group = grpConf)
useRsiFilter    = input.bool(false, "Use RSI Filter (optional)", group = grpConf)
rsiLen          = input.int(14, "RSI Length", minval = 5, maxval = 50, group = grpConf)
rsiOB           = input.float(70.0, "RSI Overbought", group = grpConf)
rsiOS           = input.float(30.0, "RSI Oversold", group = grpConf)

// ── FVG Settings ─────────────────────────────────────────────
useFvg          = input.bool(true, "Enable FVG Detection", group = grpFvg)
fvgUseCE        = input.bool(true, "Use FVG CE (Midpoint) for Entry", group = grpFvg,
     tooltip = "ON: entry at (fvgHi+fvgLo)/2. OFF: entry at FVG proximal edge.")
minFvgSizeAtr   = input.float(0.20, "Min FVG Size (ATR)", minval = 0.05, maxval = 2.0, step = 0.05, group = grpFvg)
fvgBodyMin      = input.float(0.50, "Min FVG Candle Body %", minval = 0.20, maxval = 0.90, step = 0.05, group = grpFvg)
maxActiveFvg    = input.int(6, "Max Active FVG Zones", minval = 1, maxval = 10, group = grpFvg)
fvgExpBars      = input.int(80, "FVG Zone Expiry (bars)", minval = 10, maxval = 300, group = grpFvg)
showFvgZones    = input.bool(true, "Show FVG Zones", group = grpFvg, active = useFvg)

// ── Order Block Settings ─────────────────────────────────────
useOB           = input.bool(true, "Enable Order Block Detection", group = grpOB)
obDef           = input.string("lastOpp", "OB Definition", options = ["lastOpp", "swingOB"], group = grpOB,
     tooltip = "lastOpp = last opposite candle before displacement. swingOB = pivot-based OB at swept swing.")
obSearchBars    = input.int(6, "OB Search Bars", minval = 2, maxval = 15, group = grpOB)
showOBZones     = input.bool(true, "Show OB Zones", group = grpOB, active = useOB,
     tooltip = "Draw order block boxes on chart when detected alongside displacement.")
obExpBars       = input.int(100, "OB Zone Expiry (bars)", minval = 10, maxval = 300, group = grpOB, active = useOB,
     tooltip = "Order block zones are removed after this many bars if not mitigated.")

// ── SMT / Correlation ────────────────────────────────────────
smtEn           = input.bool(false, "Enable SMT Divergence", group = grpSMT)
smtSymbolB      = input.symbol("CME_MINI:NQ1!", "SMT Comparison Symbol", group = grpSMT)
smtCorr         = input.string("positive", "Correlation Type", options = ["positive", "negative"], group = grpSMT)
smtPivotLen     = input.int(3, "SMT Pivot Length", minval = 1, maxval = 15, group = grpSMT)
smtMaxBars      = input.int(10, "SMT Max Bars Apart", minval = 3, maxval = 30, group = grpSMT)

// ── Risk ────────────────────────────────────────────────────
riskMode        = input.string("multiRR", "Risk Mode", options = ["fixedRR", "multiRR", "structure"], group = grpRisk,
     tooltip = "fixedRR: single TP at rrRatio. multiRR: TP1 at t1R, TP2 at t2R. structure: TP at nearest structural level.")
rrRatio         = input.float(2.5, "Risk:Reward Ratio (fixedRR)", minval = 0.5, maxval = 10.0, step = 0.1, group = grpRisk)
stopMode        = input.string("structure", "Stop Mode", options = ["structure", "atr", "fvgBoundary"], group = grpRisk)
stopAtrLen      = input.int(14, "Stop ATR Length", minval = 5, maxval = 50, group = grpRisk)
stopAtrMult     = input.float(1.0, "Stop ATR Multiplier", minval = 0.2, maxval = 3.0, step = 0.1, group = grpRisk)
stopBuf         = input.float(0.20, "Stop Buffer (ATR fraction)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpRisk)
t1R             = input.float(1.5, "Target 1 (R-multiple)", minval = 0.5, maxval = 5.0, step = 0.1, group = grpRisk)
t2R             = input.float(3.0, "Target 2 (R-multiple)", minval = 1.0, maxval = 10.0, step = 0.1, group = grpRisk)
partial1Pct     = input.float(50.0, "Partial 1 % (at TP1)", minval = 10, maxval = 90, group = grpRisk, active = riskMode == "multiRR",
     tooltip = "Percentage of position closed at TP1. Remainder runs to TP2.")
moveToBEatR     = input.float(1.0, "Move to BE at R", minval = 0.5, maxval = 3.0, step = 0.1, group = grpRisk,
     tooltip = "After price reaches this R-multiple, SL moves to breakeven.")
useTimeStop     = input.bool(false, "Use Time Stop", group = grpRisk)
timeStopMins    = input.int(120, "Time Stop (minutes after entry)", minval = 15, maxval = 480, group = grpRisk, active = useTimeStop)
cancelBars      = input.int(20, "Cancel Pending Entry After N Bars", minval = 5, maxval = 60, group = grpRisk)
maxRiskAtr      = input.float(2.0, "Max Allowed Risk (ATR)", minval = 0.5, maxval = 5.0, step = 0.1, group = grpRisk)
tradeExtBars    = input.int(40, "Trade Box Width (bars)", minval = 10, maxval = 150, group = grpRisk)

// ── Confluence Scoring ──────────────────────────────────────
useScoring      = input.bool(true, "Enable Confluence Scoring", group = grpScore)
scoreThreshold  = input.int(5, "Minimum Score Threshold", minval = 1, maxval = 15, group = grpScore)
wLiquidity      = input.int(2, "Weight: Liquidity", minval = 0, maxval = 5, group = grpScore)
wMSS            = input.int(2, "Weight: MSS/Displacement", minval = 0, maxval = 5, group = grpScore)
wFVG            = input.int(2, "Weight: FVG", minval = 0, maxval = 5, group = grpScore)
wOB             = input.int(1, "Weight: Order Block", minval = 0, maxval = 5, group = grpScore)
wSession        = input.int(1, "Weight: Session/Kill Zone", minval = 0, maxval = 5, group = grpScore)
wSMT            = input.int(2, "Weight: SMT Divergence", minval = 0, maxval = 5, group = grpScore)

// ── Display ──────────────────────────────────────────────────
showDash        = input.bool(true, "Show Dashboard", group = grpDisplay)
showSweepMarks  = input.bool(true, "Show Sweep Confirmation Markers", group = grpDisplay)
showPDHL        = input.bool(true, "Show PDH/PDL Lines", group = grpDisplay)
showEqlHL       = input.bool(true, "Show Equal Highs/Lows", group = grpDisplay)
showSessionHL   = input.bool(true, "Show Session H/L Lines", group = grpDisplay)
showLevelLabels = input.bool(true, "Show Level Labels", group = grpDisplay, active = showPDHL or showEqlHL or showSessionHL)
extendLevelLinesRight = input.bool(true, "Extend Level Lines Right", group = grpDisplay, active = showPDHL or showEqlHL or showSessionHL)
bullCol         = input.color(color.new(#00c27a, 0), "Bull Color", group = grpDisplay)
bearCol         = input.color(color.new(#ff3d5a, 0), "Bear Color", group = grpDisplay)
pdhLevelCol     = input.color(color.new(#f59e0b, 0), "PDH/PDL Color", group = grpDisplay, active = showPDHL)
eqhLevelCol     = input.color(color.new(#fb7185, 0), "EQH Color", group = grpDisplay, active = showEqlHL)
eqlLevelCol     = input.color(color.new(#34d399, 0), "EQL Color", group = grpDisplay, active = showEqlHL)
ldnLevelCol     = input.color(color.new(#38bdf8, 0), "London H/L Color", group = grpDisplay, active = showSessionHL)
nyLevelCol      = input.color(color.new(#10b981, 0), "New York H/L Color", group = grpDisplay, active = showSessionHL)
tkyLevelCol     = input.color(color.new(#8b5cf6, 0), "Tokyo H/L Color", group = grpDisplay, active = showSessionHL)
sydLevelCol     = input.color(color.new(#ec4899, 0), "Sydney H/L Color", group = grpDisplay, active = showSessionHL)
levelTextCol    = input.color(color.white, "Level Label Text", group = grpDisplay, active = showLevelLabels)
levelLabelBgCol = input.color(color.new(color.rgb(12, 18, 33), 15), "Level Label Background", group = grpDisplay, active = showLevelLabels)
levelLineStyleInput = input.string("Dashed", "Level Line Style", options = ["Solid", "Dashed", "Dotted"], group = grpDisplay,
     active = showPDHL or showEqlHL or showSessionHL)
levelLineWidth  = input.int(1, "Level Line Width", minval = 1, maxval = 4, group = grpDisplay, active = showPDHL or showEqlHL or showSessionHL)
pdhLabelText    = input.string("PDH", "PDH Label", group = grpDisplay, active = showPDHL and showLevelLabels)
pdlLabelText    = input.string("PDL", "PDL Label", group = grpDisplay, active = showPDHL and showLevelLabels)
fvgCol          = input.color(color.new(#a78bfa, 0), "FVG Zone Color", group = grpDisplay)
smtCol          = input.color(color.new(#f59e0b, 0), "SMT Color", group = grpDisplay)
sessionCol      = input.color(color.new(#3b82f6, 90), "Session BG Color", group = grpDisplay,
     tooltip = "Base colour for session backgrounds. Overlap/individual sessions derive from this.")
showExecZone    = input.bool(true, "Show Execution Zone", group = grpDisplay,
     tooltip = "Highlights the FVG zone used for entry and the swept liquidity level.")
execZoneCol     = input.color(color.new(#00e5ff, 0), "Execution Zone Color", group = grpDisplay)
signalLabelMode = input.string("Compact", "Signal Label Mode", options = ["Full", "Compact", "X-Number"], group = grpDisplay)
signalLabelSize = input.string("Tiny", "Signal Label Size", options = ["Tiny", "Small", "Normal"], group = grpDisplay)
showSignalDirectionColor = input.bool(true, "Color Signal Labels By Direction", group = grpDisplay)
describeStrategy = input.bool(false, "Describe strategy?", group = grpDisplay, active = showDash)
strategyDescriptionMode = input.string("Active Only", "Strategy Description Mode", options = ["Active Only", "Enabled Strategies"], group = grpDisplay,
     active = showDash and describeStrategy)
showProjectedTradePlan = input.bool(true, "Show Projected Trade Plan", group = grpDisplay, active = showExecZone)
projectedPlanStyle = input.string("Dashed", "Projected Plan Style", options = ["Dashed", "Light Fill", "Minimal"], group = grpDisplay,
     active = showExecZone and showProjectedTradePlan)
showPendingSetupMarker = input.bool(true, "Show Pending Setup Marker", group = grpDisplay, active = showExecZone or showDash)
showCandidateState = input.bool(true, "Show Candidate State", group = grpDisplay, active = showPendingSetupMarker or showDash)
showArmedState = input.bool(true, "Show Armed State", group = grpDisplay, active = showProjectedTradePlan or showPendingSetupMarker or showDash)
showTriggeredState = input.bool(true, "Show Triggered State", group = grpDisplay, active = showDash)
maxDrawnTrades  = input.int(5, "Max Trade Drawings", minval = 1, maxval = 15, group = grpDisplay,
     tooltip = "Max trade box sets on chart. Oldest deleted when exceeded.")

// ── Adaptive Engine ──────────────────────────────────────────
profileMode     = input.string("AUTO", "Profile Mode", options = ["AUTO", "MANUAL"], group = grpAdaptive,
     tooltip = "AUTO: score threshold adapts based on recent win rate. MANUAL: uses fixed threshold.")
manualConfThreshold = input.int(68, "Manual Confidence Threshold", minval = 40, maxval = 95, group = grpAdaptive, active = profileMode == "MANUAL",
     tooltip = "In MANUAL mode, maps to effective score threshold: threshold = floor(value / 10).")
adaptiveWindow  = input.int(40, "Adaptive Memory Window (trades)", minval = 12, maxval = 120, group = grpAdaptive, active = profileMode == "AUTO",
     tooltip = "Number of recent trades used to compute adaptive win rate.")
adaptiveMaxShift = input.int(8, "Max Confidence Shift", minval = 2, maxval = 16, group = grpAdaptive, active = profileMode == "AUTO",
     tooltip = "Max adjustment to score threshold in AUTO mode based on recent performance.")
cooldownLossTrig = input.int(2, "Cooldown After N Losses", minval = 2, maxval = 5, group = grpAdaptive, active = profileMode == "AUTO",
     tooltip = "After this many consecutive losses, suppress signals for cooldownBase bars.")
cooldownBase    = input.int(12, "Cooldown Base (bars)", minval = 3, maxval = 60, group = grpAdaptive, active = profileMode == "AUTO")
maxTrackedSigs  = input.int(36, "Max Tracked Signals", minval = 8, maxval = 64, group = grpAdaptive)

// ── Webhook ──────────────────────────────────────────────────
emitOpenAlerts  = input.bool(true, "Emit SIGNAL_OPEN Alerts", group = grpWebhook)
emitCloseAlerts = input.bool(false, "Emit SIGNAL_CLOSE Alerts", group = grpWebhook,
     tooltip = "Emits alert when tracked trade hits SL or TP.")
webhookToken    = input.string("", "Webhook Auth Token", group = grpWebhook)
webhookSource   = input.string("TRADEJAUDIT_PINE_V2", "Webhook Source Tag", group = grpWebhook)

// ═══════════════════════════════════════════════════════════════
//  TYPES
// ═══════════════════════════════════════════════════════════════
type RegimeState
    string name
    string volatilityState
    float atrRatio
    float adxValue

// ═══════════════════════════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════════════════════════
clamp(v, lo, hi) => math.max(lo, math.min(hi, v))

levelLineStyle() =>
    levelLineStyleInput == "Solid" ? line.style_solid :
     levelLineStyleInput == "Dotted" ? line.style_dotted :
     line.style_dashed

clearLineArray(line[] refs) =>
    while array.size(refs) > 0
        ln = array.shift(refs)
        if not na(ln)
            line.delete(ln)

clearLabelArray(label[] refs) =>
    while array.size(refs) > 0
        lb = array.shift(refs)
        if not na(lb)
            label.delete(lb)

clearBoxArray(box[] refs) =>
    while array.size(refs) > 0
        bx = array.shift(refs)
        if not na(bx)
            box.delete(bx)

trimLineArray(line[] refs, maxSize) =>
    while array.size(refs) > maxSize
        ln = array.shift(refs)
        if not na(ln)
            line.delete(ln)

trimLabelArray(label[] refs, maxSize) =>
    while array.size(refs) > maxSize
        lb = array.shift(refs)
        if not na(lb)
            label.delete(lb)

trimBoxArray(box[] refs, maxSize) =>
    while array.size(refs) > maxSize
        bx = array.shift(refs)
        if not na(bx)
            box.delete(bx)

levelLabelStyle(isHigh) =>
    isHigh ? label.style_label_lower_left : label.style_label_upper_left

drawLevelObject(line[] lineRefs, label[] labelRefs, int x1, float level, string txt, color levelColor, bool isHigh) =>
    if not na(level)
        minX = math.max(0, bar_index - (LEVEL_ANCHOR_LIMIT - 1))
        rawX = nz(x1, bar_index - 100)
        xLeft = math.max(minX, rawX)
        ln = line.new(xLeft, level, bar_index, level, xloc = xloc.bar_index,
             extend = extendLevelLinesRight ? extend.right : extend.none,
             color = levelColor, style = levelLineStyle(), width = levelLineWidth)
        array.push(lineRefs, ln)
        if showLevelLabels
            lbl = label.new(bar_index, level, txt, xloc = xloc.bar_index,
                 style = levelLabelStyle(isHigh), textcolor = levelTextCol,
                 color = levelLabelBgCol, size = size.tiny)
            array.push(labelRefs, lbl)

trackSessionLevels(bool active, bool started, bool ended, float liveHigh, float liveLow, int liveStartBar, float drawHigh, float drawLow, int drawStartBar) =>
    float nextLiveHigh = liveHigh
    float nextLiveLow = liveLow
    int nextLiveStartBar = liveStartBar
    float nextDrawHigh = drawHigh
    float nextDrawLow = drawLow
    int nextDrawStartBar = drawStartBar
    if started
        nextLiveHigh := high
        nextLiveLow := low
        nextLiveStartBar := bar_index
    else if active
        nextLiveHigh := math.max(nz(nextLiveHigh, high), high)
        nextLiveLow := math.min(nz(nextLiveLow, low), low)
    if active or ended
        nextDrawHigh := nextLiveHigh
        nextDrawLow := nextLiveLow
        nextDrawStartBar := nz(nextLiveStartBar, bar_index)
    [nextLiveHigh, nextLiveLow, nextLiveStartBar, nextDrawHigh, nextDrawLow, nextDrawStartBar]

gradeColor(score) =>
    score >= 8 ? color.new(#00c27a, 0) :
     score >= 5 ? color.new(#f5a623, 0) :
     color.new(#9b9b9b, 0)

// ── Confluence quality mapping ──────────────────────────────────
// Maps score as % of max possible score to qualitative label.
// Deterministic mapping that adapts to configured weight values.
//   >= 80% = Excellent   >= 60% = Strong    >= 45% = Good
//   >= 30% = Moderate    >= 15% = Weak      <  15% = Very Weak
getConfluenceLabel(int score) =>
    int maxScore = wLiquidity + wMSS + wFVG + wOB + wSession + wSMT
    float pct = maxScore > 0 ? score * 100.0 / maxScore : 0.0
    pct >= 80 ? "Excellent" : pct >= 60 ? "Strong" : pct >= 45 ? "Good" : pct >= 30 ? "Moderate" : pct >= 15 ? "Weak" : "Very Weak"

stratLabel(idx) =>
    idx == 1 ? "RAID→MSS→FVG" :
     idx == 2 ? "SILVER_BULLET" :
     idx == 3 ? "PO3_AMD" :
     idx == 4 ? "JUDAS_SWING" :
     idx == 5 ? "SMT_REVERSAL" : "UNKNOWN"

stratShortCode(idx) =>
    idx == 1 ? "RAID_MSS_FVG" :
     idx == 2 ? "SILVER_BULLET" :
     idx == 3 ? "PO3_AMD" :
     idx == 4 ? "JUDAS_SWING" :
     idx == 5 ? "SMT_REVERSAL" : "UNKNOWN"

strategyDescription(idx) =>
    idx == 1 ? "S1: Sweep liquidity, wait for MSS, then enter the FVG retrace." :
     idx == 2 ? "S2: Silver Bullet FVG setup inside the Silver Bullet window." :
     idx == 3 ? "S3: PO3 setup, accumulation then manipulation, then reversal expansion." :
     idx == 4 ? "S4: Judas swing, session sweep first, then reversal confirmation." :
     idx == 5 ? "S5: SMT divergence reversal after correlated liquidity disagreement." : "–"

entryPlanLabel(entrySrc, zoneType) =>
    entrySrc == "FVG_CE" ? "FVG CE" :
     entrySrc == "FVG_TOUCH" ? "FVG touch" :
     zoneType == "STANDALONE_FVG" ? "FVG rejection" :
     zoneType == "OB" ? "OB touch" : "Execution zone retest"

signalLabelSizeValue() =>
    signalLabelSize == "Normal" ? size.normal :
     signalLabelSize == "Small" ? size.small : size.tiny

signalAnchorPrice(bool isBull, float fallbackPrice, float zoneHi, float zoneLo) =>
    not na(fallbackPrice) ? fallbackPrice :
     isBull ? nz(zoneLo, low) : nz(zoneHi, high)

signalText(int stratIdx, bool isBull, int score) =>
    // Compact label rendering keeps the execution bar readable while still exposing strategy identity.
    signalLabelMode == "X-Number" ? "X" + str.tostring(stratIdx) :
     signalLabelMode == "Compact" ? (isBull ? "B-S" : "S-S") + str.tostring(stratIdx) :
     (isBull ? "BUY " : "SELL ") + "S" + str.tostring(stratIdx) + " " + stratShortCode(stratIdx) + " [" + str.tostring(score) + "]"

pendingMarkerText(string setupState, int stratIdx) =>
    setupState == "ARMED" ? "A" + str.tostring(stratIdx) :
     setupState == "CANDIDATE" ? "C" + str.tostring(stratIdx) :
     "P" + str.tostring(stratIdx)

projectedPlanBorderStyle() =>
    projectedPlanStyle == "Minimal" ? line.style_dotted : line.style_dashed

projectedPlanFillOpacity() =>
    projectedPlanStyle == "Light Fill" ? 84 :
     projectedPlanStyle == "Minimal" ? 94 : 90

projectedPlanBorderOpacity() =>
    projectedPlanStyle == "Light Fill" ? 55 :
     projectedPlanStyle == "Minimal" ? 68 : 46

executionZoneTouched(bool isBull, float plannedEntryPrice, float zoneHi, float zoneLo, string entrySrc) =>
    // Planned entry / execution zone logic stays tied to the true zone touch, never to a later expanded close.
    if na(zoneHi) or na(zoneLo)
        false
    else if entrySrc == "FVG_CE" and not na(plannedEntryPrice)
        high >= plannedEntryPrice and low <= plannedEntryPrice
    else
        high >= zoneLo and low <= zoneHi

enabledStrategySummary() =>
    string txt = ""
    if strat1En
        txt += (txt != "" ? "\n" : "") + "S1: Raid + MSS + FVG retrace"
    if strat2En
        txt += (txt != "" ? "\n" : "") + "S2: Silver Bullet FVG window"
    if strat3En
        txt += (txt != "" ? "\n" : "") + "S3: PO3 manipulation reversal"
    if strat4En
        txt += (txt != "" ? "\n" : "") + "S4: Judas sweep reversal"
    if strat5En
        txt += (txt != "" ? "\n" : "") + "S5: SMT divergence reversal"
    txt != "" ? txt : "No strategies enabled"

sanitizeSymbol(s) =>
    str.replace_all(str.replace_all(str.replace_all(s, ":", "_"), ".", "_"), "/", "_")

normalizeTimeframeId(tf) =>
    tf == "1H" ? "60" : tf == "4H" ? "240" : tf == "1D" ? "D" : tf

buildExternalTradeId(setupType, direction, signalTime) =>
    "tv-" + sanitizeSymbol(syminfo.tickerid) + "-" + normalizeTimeframeId(timeframe.period) + "-" + str.tostring(signalTime) + "-" + str.lower(direction) + "-" + str.lower(setupType)

jsonStr(v) => "\"" + v + "\""
jsonNum(v) => na(v) ? "null" : str.tostring(v)

// Execution mode helper
requireConfirmed = executionMode == "Confirmed Close"
barConfirmedOk = not requireConfirmed or barstate.isconfirmed
max_bars_back(time, LEVEL_ANCHOR_LIMIT)

// ═══════════════════════════════════════════════════════════════
//  1. CORE INDICATORS
// ═══════════════════════════════════════════════════════════════
atr14         = ta.atr(14)
atrMean       = ta.sma(atr14, 50)
bodySize      = math.abs(close - open)
candleRange   = math.max(high - low, syminfo.mintick)
bodyPct       = bodySize / candleRange
bullCandle    = close > open
bearCandle    = close < open
trendEma      = ta.ema(close, 34)
emaSlope      = (trendEma - trendEma[8]) / math.max(atrMean, syminfo.mintick)
stdevClose    = ta.stdev(close, 20)
rsiValue      = ta.rsi(close, rsiLen)

[_, _, adxVal] = ta.dmi(14, 14)

bbBasis       = ta.sma(close, 20)
bbDev         = ta.stdev(close, 20) * 2.0
bbWidth       = (bbDev * 2.0) / math.max(math.abs(bbBasis), syminfo.mintick)
bbWidthMean   = ta.sma(bbWidth, 50)
bbWidthRatio  = bbWidth / math.max(bbWidthMean, syminfo.mintick)

// Regime detection
calcRegime() =>
    atrRat = atr14 / math.max(atrMean, syminfo.mintick)
    trendReady = adxVal >= 23 and math.abs(emaSlope) >= 0.22
    volExp = atrRat >= 1.20 or bbWidthRatio >= 1.15
    volComp = atrRat <= 0.85 and bbWidthRatio <= 0.92
    regName = trendReady and not volExp ? "TREND" :
         volComp ? "VOL_COMPRESS" :
         volExp ? "VOL_EXPAND" : "RANGE"
    volState = atrRat >= 1.15 ? "EXPANDING" : atrRat <= 0.90 ? "COMPRESSING" : "BALANCED"
    RegimeState.new(regName, volState, atrRat, adxVal)

regime = calcRegime()

// TF check
chartTfMins = timeframe.in_seconds() / 60
tfOk = not requireTfCheck or chartTfMins <= executionTfMax

// ═══════════════════════════════════════════════════════════════
//  2. SESSION ENGINE (timezone-aware, UTC-first)
// ═══════════════════════════════════════════════════════════════
// IANA timezone constants
string TZ_LONDON = "Europe/London"
string TZ_NY     = "America/New_York"
string TZ_TOKYO  = "Asia/Tokyo"
string TZ_SYDNEY = "Australia/Sydney"
string TZ_UTC    = "Etc/UTC"

// Resolve timezone per session based on timeBasis
tzForSession(string localTz) =>
    timeBasis == "UTC" ? TZ_UTC :
     timeBasis == "New York (ICT)" ? TZ_NY :
     timeBasis == "Local-per-session" ? localTz :
     customTz  // Custom mode

// Resolve global timezone (for Judas midnight, PO3, daily boundaries)
tzGlobal() =>
    timeBasis == "UTC" ? TZ_UTC :
     timeBasis == "New York (ICT)" ? TZ_NY :
     timeBasis == "Custom" ? customTz :
     TZ_NY  // Local-per-session: use NY for global anchors

string tzLondon = tzForSession(TZ_LONDON)
string tzNy     = tzForSession(TZ_NY)
string tzTokyo  = tzForSession(TZ_TOKYO)
string tzSydney = tzForSession(TZ_SYDNEY)
string tzMain   = tzGlobal()

// Each session interpreted in its resolved timezone (DST-safe via IANA)
inLondon    = londonEn  and not na(time(timeframe.period, londonSess, tzLondon))
inNewYork   = newyorkEn and not na(time(timeframe.period, newyorkSess, tzNy))
inTokyo     = tokyoEn   and not na(time(timeframe.period, tokyoSess, tzTokyo))
inSydney    = sydneyEn  and not na(time(timeframe.period, sydneySess, tzSydney))

// Overlap = true intersection of London AND NY (DST-safe, no separate session string)
inOverlap   = overlapEn and inLondon and inNewYork
inLunch     = excludeLunch and not na(time(timeframe.period, lunchSess, tzNy))

inAnySession = not useSessions or (inLondon or inNewYork or inTokyo or inSydney)
inSessionFinal = inAnySession and not inLunch

// Kill zones — use resolved timezone
inLondonKz  = not na(time(timeframe.period, londonKzSess, tzLondon))
inNyAmKz    = not na(time(timeframe.period, nyAmKzSess, tzNy))
inNyPmKz    = not na(time(timeframe.period, nyPmKzSess, tzNy))
inAnyKz     = inLondonKz or inNyAmKz or inNyPmKz

// Silver Bullet — use resolved timezone
inSbLondon  = not na(time(timeframe.period, sbLondonSess, tzLondon))
inSbNyAm    = not na(time(timeframe.period, sbNyAmSess, tzNy))
inSbNyPm    = not na(time(timeframe.period, sbNyPmSess, tzNy))
inAnySB     = inSbLondon or inSbNyAm or inSbNyPm

// Judas + PO3: use global timezone (follows timeBasis)
inJudas     = not na(time(timeframe.period, judasSess, tzMain))
inPo3Accum  = not na(time(timeframe.period, po3AccumSess, tzMain))
inPo3Manip  = not na(time(timeframe.period, po3ManipSess, tzMain))
inPo3Dist   = not na(time(timeframe.period, po3DistSess, tzMain))

// Session background — uses sessionCol input
sessionBgColor = showSessionBg ? (inOverlap ? color.new(#f59e0b, 92) :
     inLondon ? sessionCol :
     inNewYork ? color.new(#10b981, 96) :
     inTokyo ? color.new(#8b5cf6, 96) :
     inSydney ? color.new(#ec4899, 96) : na) : na
bgcolor(sessionBgColor, title = "Session BG")

// ═══════════════════════════════════════════════════════════════
//  3. HTF BIAS
// ═══════════════════════════════════════════════════════════════
[htfClose, htfEma, htfAtr] = request.security(
     syminfo.tickerid, htfTf,
     [close, ta.ema(close, htfEmaLen), ta.atr(14)],
     lookahead = barmerge.lookahead_off)

htfBull    = htfClose > htfEma
htfBear    = htfClose < htfEma
htfGap     = math.abs(htfClose - htfEma) / math.max(htfAtr, syminfo.mintick)
htfStrong  = htfGap >= 0.40
htfBias    = htfBull ? "BULLISH" : htfBear ? "BEARISH" : "NEUTRAL"
htfBullOk  = not useHtfBias or htfBull
htfBearOk  = not useHtfBias or htfBear

plot(htfEma, "HTF EMA", color = htfBull ? color.new(bullCol, 45) : color.new(bearCol, 45), linewidth = 2)

// ═══════════════════════════════════════════════════════════════
//  4. PIVOT DETECTION (swing highs/lows)
// ═══════════════════════════════════════════════════════════════
pivotH = ta.pivothigh(high, pivotLen, pivotLen)
pivotL = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSwH = na, var float lastSwL = na
var int lastSwHBar = na, var int lastSwLBar = na
var float prevSwH = na, var float prevSwL = na
var int prevSwHBar = na, var int prevSwLBar = na

if not na(pivotH)
    prevSwH    := lastSwH
    prevSwHBar := lastSwHBar
    lastSwH    := pivotH
    lastSwHBar := bar_index - pivotLen
if not na(pivotL)
    prevSwL    := lastSwL
    prevSwLBar := lastSwLBar
    lastSwL    := pivotL
    lastSwLBar := bar_index - pivotLen

bsl = lastSwH  // Buy-Side Liquidity
ssl = lastSwL  // Sell-Side Liquidity

// MSS-specific shorter pivots
mssPivH = ta.pivothigh(high, mssPivotLen, mssPivotLen)
mssPivL = ta.pivotlow(low, mssPivotLen, mssPivotLen)
var float mssLastH = na, var float mssLastL = na
var int mssLastHBar = na, var int mssLastLBar = na

if not na(mssPivH)
    mssLastH    := mssPivH
    mssLastHBar := bar_index - mssPivotLen
if not na(mssPivL)
    mssLastL    := mssPivL
    mssLastLBar := bar_index - mssPivotLen

// ═══════════════════════════════════════════════════════════════
//  5. LIQUIDITY LEVELS
// ═══════════════════════════════════════════════════════════════

var line[] pdhlLines = array.new_line(0)
var label[] pdhlLabels = array.new_label(0)
var line[] sessionLevelLines = array.new_line(0)
var label[] sessionLevelLabels = array.new_label(0)
var line[] eqlLevelLines = array.new_line(0)
var label[] eqlLevelLabels = array.new_label(0)

clearPDHPDL() =>
    clearLineArray(pdhlLines)
    clearLabelArray(pdhlLabels)

clearSessionHL() =>
    clearLineArray(sessionLevelLines)
    clearLabelArray(sessionLevelLabels)

clearEqhEql() =>
    clearLineArray(eqlLevelLines)
    clearLabelArray(eqlLevelLabels)

// ── Previous Day High/Low (uses global timezone for day boundary) ──
var float pdh = na, var float pdl = na
var float curDayH = na, var float curDayL = na
var int pdhlStartBar = na
newDay = ta.change(time("D", "", tzMain)) != 0
if newDay
    pdh := curDayH
    pdl := curDayL
    pdhlStartBar := bar_index
    curDayH := high
    curDayL := low
else
    curDayH := math.max(nz(curDayH, high), high)
    curDayL := math.min(nz(curDayL, low), low)
if na(pdhlStartBar)
    pdhlStartBar := bar_index

// ── Session High/Low tracking ────────────────────────────────
var float sessH = na, var float sessL = na
var float prevSessH = na, var float prevSessL = na

bool londonStart  = inLondon  and not inLondon[1]
bool londonEnd    = not inLondon and inLondon[1]
bool nyStart      = inNewYork and not inNewYork[1]
bool nyEnd        = not inNewYork and inNewYork[1]
bool tokyoStart   = inTokyo   and not inTokyo[1]
bool tokyoEnd     = not inTokyo and inTokyo[1]
bool sydneyStart  = inSydney  and not inSydney[1]
bool sydneyEnd    = not inSydney and inSydney[1]
sessionStart = londonStart or nyStart or tokyoStart or sydneyStart

if sessionStart
    prevSessH := sessH
    prevSessL := sessL
    sessH := high
    sessL := low
else if inLondon or inNewYork or inTokyo or inSydney
    sessH := math.max(nz(sessH, high), high)
    sessL := math.min(nz(sessL, low), low)

// ── Per-session H/L tracking variables (all sessions declared first) ──
var float ldnLiveHigh = na, var float ldnLiveLow = na
var int ldnLiveStartBar = na
var float ldnDrawHigh = na, var float ldnDrawLow = na
var int ldnDrawStartBar = na

var float nyLiveHigh = na, var float nyLiveLow = na
var int nyLiveStartBar = na
var float nyDrawHigh = na, var float nyDrawLow = na
var int nyDrawStartBar = na

var float tkyLiveHigh = na, var float tkyLiveLow = na
var int tkyLiveStartBar = na
var float tkyDrawHigh = na, var float tkyDrawLow = na
var int tkyDrawStartBar = na

var float sydLiveHigh = na, var float sydLiveLow = na
var int sydLiveStartBar = na
var float sydDrawHigh = na, var float sydDrawLow = na
var int sydDrawStartBar = na

// ── Current-day session reset ───────────────────────────────────
// Session H/L are displayed ONLY for the current trading day.
// On new day boundary (per timeBasis timezone), all session live/draw
// vars reset so prior-day levels disappear from the chart.
// Sessions active across midnight restart tracking from the new day bar.
if newDay
    ldnLiveHigh := na, ldnLiveLow := na, ldnLiveStartBar := na
    ldnDrawHigh := na, ldnDrawLow := na, ldnDrawStartBar := na
    nyLiveHigh  := na, nyLiveLow  := na, nyLiveStartBar  := na
    nyDrawHigh  := na, nyDrawLow  := na, nyDrawStartBar  := na
    tkyLiveHigh := na, tkyLiveLow := na, tkyLiveStartBar := na
    tkyDrawHigh := na, tkyDrawLow := na, tkyDrawStartBar := na
    sydLiveHigh := na, sydLiveLow := na, sydLiveStartBar := na
    sydDrawHigh := na, sydDrawLow := na, sydDrawStartBar := na

// ── Track session levels (after day reset so new-day starts fresh) ──
[ldnLiveHighNext, ldnLiveLowNext, ldnLiveStartBarNext, ldnDrawHighNext, ldnDrawLowNext, ldnDrawStartBarNext] = trackSessionLevels(
     inLondon, londonStart, londonEnd, ldnLiveHigh, ldnLiveLow, ldnLiveStartBar, ldnDrawHigh, ldnDrawLow, ldnDrawStartBar)
ldnLiveHigh := ldnLiveHighNext
ldnLiveLow := ldnLiveLowNext
ldnLiveStartBar := ldnLiveStartBarNext
ldnDrawHigh := ldnDrawHighNext
ldnDrawLow := ldnDrawLowNext
ldnDrawStartBar := ldnDrawStartBarNext

[nyLiveHighNext, nyLiveLowNext, nyLiveStartBarNext, nyDrawHighNext, nyDrawLowNext, nyDrawStartBarNext] = trackSessionLevels(
     inNewYork, nyStart, nyEnd, nyLiveHigh, nyLiveLow, nyLiveStartBar, nyDrawHigh, nyDrawLow, nyDrawStartBar)
nyLiveHigh := nyLiveHighNext
nyLiveLow := nyLiveLowNext
nyLiveStartBar := nyLiveStartBarNext
nyDrawHigh := nyDrawHighNext
nyDrawLow := nyDrawLowNext
nyDrawStartBar := nyDrawStartBarNext

[tkyLiveHighNext, tkyLiveLowNext, tkyLiveStartBarNext, tkyDrawHighNext, tkyDrawLowNext, tkyDrawStartBarNext] = trackSessionLevels(
     inTokyo, tokyoStart, tokyoEnd, tkyLiveHigh, tkyLiveLow, tkyLiveStartBar, tkyDrawHigh, tkyDrawLow, tkyDrawStartBar)
tkyLiveHigh := tkyLiveHighNext
tkyLiveLow := tkyLiveLowNext
tkyLiveStartBar := tkyLiveStartBarNext
tkyDrawHigh := tkyDrawHighNext
tkyDrawLow := tkyDrawLowNext
tkyDrawStartBar := tkyDrawStartBarNext

[sydLiveHighNext, sydLiveLowNext, sydLiveStartBarNext, sydDrawHighNext, sydDrawLowNext, sydDrawStartBarNext] = trackSessionLevels(
     inSydney, sydneyStart, sydneyEnd, sydLiveHigh, sydLiveLow, sydLiveStartBar, sydDrawHigh, sydDrawLow, sydDrawStartBar)
sydLiveHigh := sydLiveHighNext
sydLiveLow := sydLiveLowNext
sydLiveStartBar := sydLiveStartBarNext
sydDrawHigh := sydDrawHighNext
sydDrawLow := sydDrawLowNext
sydDrawStartBar := sydDrawStartBarNext

// ── Equal Highs/Lows Detection ───────────────────────────────
eqlTol = eqlTolMode == "atr" ? atr14 * eqlTolValue : eqlTolValue * syminfo.mintick

var float eqhLevel = na, var int eqhBar = na
var float eqlLevel = na, var int eqlBar = na

if useEqlHL and not na(pivotH) and not na(prevSwH)
    barsApart = not na(prevSwHBar) ? (bar_index - pivotLen) - prevSwHBar : 9999
    if math.abs(pivotH - prevSwH) <= eqlTol and barsApart <= eqlMaxBars
        eqhLevel := (pivotH + prevSwH) / 2.0
        eqhBar   := bar_index

if useEqlHL and not na(pivotL) and not na(prevSwL)
    barsApart = not na(prevSwLBar) ? (bar_index - pivotLen) - prevSwLBar : 9999
    if math.abs(pivotL - prevSwL) <= eqlTol and barsApart <= eqlMaxBars
        eqlLevel := (pivotL + prevSwL) / 2.0
        eqlBar   := bar_index

drawPDHPDL() =>
    clearPDHPDL()
    if showPDHL and usePDHL
        levelStart = nz(pdhlStartBar, bar_index - 150)
        if not na(pdh)
            drawLevelObject(pdhlLines, pdhlLabels, levelStart, pdh, pdhLabelText, pdhLevelCol, true)
        if not na(pdl)
            drawLevelObject(pdhlLines, pdhlLabels, levelStart, pdl, pdlLabelText, pdhLevelCol, false)

drawSessionHL() =>
    clearSessionHL()
    if showSessionHL and useSessionHL
        if londonEn and not na(ldnDrawHigh)
            drawLevelObject(sessionLevelLines, sessionLevelLabels, nz(ldnDrawStartBar, bar_index - 80), ldnDrawHigh, "LDN H", ldnLevelCol, true)
            drawLevelObject(sessionLevelLines, sessionLevelLabels, nz(ldnDrawStartBar, bar_index - 80), ldnDrawLow, "LDN L", ldnLevelCol, false)
        if newyorkEn and not na(nyDrawHigh)
            drawLevelObject(sessionLevelLines, sessionLevelLabels, nz(nyDrawStartBar, bar_index - 80), nyDrawHigh, "NY H", nyLevelCol, true)
            drawLevelObject(sessionLevelLines, sessionLevelLabels, nz(nyDrawStartBar, bar_index - 80), nyDrawLow, "NY L", nyLevelCol, false)
        if tokyoEn and not na(tkyDrawHigh)
            drawLevelObject(sessionLevelLines, sessionLevelLabels, nz(tkyDrawStartBar, bar_index - 80), tkyDrawHigh, "TKY H", tkyLevelCol, true)
            drawLevelObject(sessionLevelLines, sessionLevelLabels, nz(tkyDrawStartBar, bar_index - 80), tkyDrawLow, "TKY L", tkyLevelCol, false)
        if sydneyEn and not na(sydDrawHigh)
            drawLevelObject(sessionLevelLines, sessionLevelLabels, nz(sydDrawStartBar, bar_index - 80), sydDrawHigh, "SYD H", sydLevelCol, true)
            drawLevelObject(sessionLevelLines, sessionLevelLabels, nz(sydDrawStartBar, bar_index - 80), sydDrawLow, "SYD L", sydLevelCol, false)

drawEqhEql() =>
    clearEqhEql()
    if showEqlHL and useEqlHL
        if not na(eqhLevel)
            drawLevelObject(eqlLevelLines, eqlLevelLabels, nz(eqhBar, bar_index - 80), eqhLevel, "EQH", eqhLevelCol, true)
        if not na(eqlLevel)
            drawLevelObject(eqlLevelLines, eqlLevelLabels, nz(eqlBar, bar_index - 80), eqlLevel, "EQL", eqlLevelCol, false)

// ── Premium / Discount Zones ─────────────────────────────────
dealingRangeH = math.max(nz(lastSwH, high), nz(pdh, high))
dealingRangeL = math.min(nz(lastSwL, low), nz(pdl, low))
dealingMid    = (dealingRangeH + dealingRangeL) / 2.0
inPremium     = close > dealingMid
inDiscount    = close < dealingMid
premDiscOk(isBull) => not usePremDisc or (isBull ? inDiscount : inPremium)

// ═══════════════════════════════════════════════════════════════
//  6. FVG DETECTION (3-candle rule)
// ═══════════════════════════════════════════════════════════════
bullFvgRaw = bar_index >= 2 and low > high[2]
bearFvgRaw = bar_index >= 2 and high < low[2]

bullFvgSize = bullFvgRaw ? low - high[2] : 0.0
bearFvgSize = bearFvgRaw ? low[2] - high : 0.0

bullFvgValid = useFvg and bullFvgRaw and bullFvgSize >= atr14 * minFvgSizeAtr
bearFvgValid = useFvg and bearFvgRaw and bearFvgSize >= atr14 * minFvgSizeAtr

// Displacement-quality FVG: the middle candle (candle[1]) must be strong
bullFvgDisp = bullFvgValid and bullCandle[1] and (math.abs(close[1] - open[1]) / math.max(high[1] - low[1], syminfo.mintick)) >= fvgBodyMin
bearFvgDisp = bearFvgValid and bearCandle[1] and (math.abs(close[1] - open[1]) / math.max(high[1] - low[1], syminfo.mintick)) >= fvgBodyMin

// Store latest FVG for strategy use
var float lastBullFvgHi = na, var float lastBullFvgLo = na, var int lastBullFvgBar = na
var float lastBearFvgHi = na, var float lastBearFvgLo = na, var int lastBearFvgBar = na

if bullFvgDisp
    lastBullFvgHi  := low       // proximal
    lastBullFvgLo  := high[2]   // distal
    lastBullFvgBar := bar_index

if bearFvgDisp
    lastBearFvgHi  := low[2]    // distal
    lastBearFvgLo  := high      // proximal
    lastBearFvgBar := bar_index

bullFvgCE = not na(lastBullFvgHi) ? (lastBullFvgHi + lastBullFvgLo) / 2.0 : na
bearFvgCE = not na(lastBearFvgHi) ? (lastBearFvgHi + lastBearFvgLo) / 2.0 : na

// ── Active FVG zone storage (for standalone mitigation signals) ──
var float[] sfHi = array.new_float(0), var float[] sfLo = array.new_float(0)
var float[] sfSize = array.new_float(0), var int[] sfBar = array.new_int(0)
var box[] sfBox = array.new_box(0), var bool[] sfTouched = array.new_bool(0)

var float[] bfHi = array.new_float(0), var float[] bfLo = array.new_float(0)
var float[] bfSize = array.new_float(0), var int[] bfBar = array.new_int(0)
var box[] bfBox = array.new_box(0), var bool[] bfTouched = array.new_bool(0)

syncFvgBoxes(float[] hiArr, float[] loArr, int[] barArr, box[] boxArr) =>
    if array.size(hiArr) > 0
        for i = 0 to array.size(hiArr) - 1
            b = array.get(boxArr, i)
            if useFvg and showFvgZones
                if na(b)
                    newBox = box.new(array.get(barArr, i) - 2, array.get(hiArr, i), bar_index, array.get(loArr, i),
                         bgcolor = color.new(fvgCol, 88), border_color = color.new(fvgCol, 45), border_width = 1)
                    array.set(boxArr, i, newBox)
                    b := newBox
                if not na(b)
                    box.set_right(b, bar_index)
            else if not na(b)
                box.delete(b)
                array.set(boxArr, i, na)

// Register bear FVGs
if bearFvgDisp and (not useHtfBias or htfBear) and array.size(sfHi) < maxActiveFvg
    fHi = low[2]
    fLo = high
    box newBox = na
    if showFvgZones
        newBox := box.new(bar_index - 2, fHi, bar_index, fLo,
             bgcolor = color.new(fvgCol, 88), border_color = color.new(fvgCol, 45), border_width = 1)
    array.push(sfHi, fHi), array.push(sfLo, fLo), array.push(sfSize, fHi - fLo)
    array.push(sfBar, bar_index), array.push(sfBox, newBox), array.push(sfTouched, false)

// Register bull FVGs
if bullFvgDisp and (not useHtfBias or htfBull) and array.size(bfHi) < maxActiveFvg
    fHi = low
    fLo = high[2]
    box newBox = na
    if showFvgZones
        newBox := box.new(bar_index - 2, fHi, bar_index, fLo,
             bgcolor = color.new(fvgCol, 88), border_color = color.new(fvgCol, 45), border_width = 1)
    array.push(bfHi, fHi), array.push(bfLo, fLo), array.push(bfSize, fHi - fLo)
    array.push(bfBar, bar_index), array.push(bfBox, newBox), array.push(bfTouched, false)

syncFvgBoxes(sfHi, sfLo, sfBar, sfBox)
syncFvgBoxes(bfHi, bfLo, bfBar, bfBox)

// ═══════════════════════════════════════════════════════════════
//  7. DISPLACEMENT DETECTION
// ═══════════════════════════════════════════════════════════════
dispRef = dispMetric == "atr" ? atr14 * dispThreshold : stdevClose * dispThreshold
bullDisplace = bullCandle and bodySize >= dispRef and bodyPct >= 0.55
bearDisplace = bearCandle and bodySize >= dispRef and bodyPct >= 0.55

bullDisplaceOk = not useDispFilter or bullDisplace
bearDisplaceOk = not useDispFilter or bearDisplace

// Volume spike
volAvg = ta.sma(volume, volLookback)
volSpikeOk = not useVolSpike or (volume >= volAvg * volMultiple)

// RSI filter
rsiBullOk = not useRsiFilter or rsiValue <= rsiOS or (rsiValue[1] <= rsiOS and rsiValue > rsiOS)
rsiBearOk = not useRsiFilter or rsiValue >= rsiOB or (rsiValue[1] >= rsiOB and rsiValue < rsiOB)

// ═══════════════════════════════════════════════════════════════
//  8. MARKET STRUCTURE SHIFT (MSS)
// ═══════════════════════════════════════════════════════════════
bullMSS = useMSS and not na(mssLastH) and close > mssLastH and close[1] <= mssLastH
bearMSS = useMSS and not na(mssLastL) and close < mssLastL and close[1] >= mssLastL

var bool bullMSSActive = false, var int bullMSSBar = na
var bool bearMSSActive = false, var int bearMSSBar = na

if bullMSS and bullDisplaceOk
    bullMSSActive := true
    bullMSSBar    := bar_index

if bearMSS and bearDisplaceOk
    bearMSSActive := true
    bearMSSBar    := bar_index

if bullMSSActive and not na(bullMSSBar) and bar_index - bullMSSBar > cancelBars
    bullMSSActive := false
if bearMSSActive and not na(bearMSSBar) and bar_index - bearMSSBar > cancelBars
    bearMSSActive := false

// ═══════════════════════════════════════════════════════════════
//  9. ORDER BLOCK DETECTION (with obDef support)
// ═══════════════════════════════════════════════════════════════
findBullOB() =>
    float obHi = na, float obLo = na
    if obDef == "swingOB"
        // Swing-based OB: use the last swing low candle
        if not na(lastSwLBar)
            offset = bar_index - lastSwLBar
            if offset >= 1 and offset <= obSearchBars * 3
                obHi := math.max(open[offset], close[offset])
                obLo := low[offset]
    else
        // lastOpp: last opposite candle before displacement
        float best = -999.0
        for i = 1 to obSearchBars
            isOpp = close[i] < open[i]
            bAtr = math.abs(open[i] - close[i]) / math.max(atr14[i], syminfo.mintick)
            sc = (isOpp ? 1.0 : -99.0) + bAtr * 0.5 - i * 0.04
            if isOpp and bAtr >= 0.10 and sc > best
                best := sc
                obHi := math.max(open[i], close[i])
                obLo := low[i]
    [obHi, obLo]

findBearOB() =>
    float obHi = na, float obLo = na
    if obDef == "swingOB"
        if not na(lastSwHBar)
            offset = bar_index - lastSwHBar
            if offset >= 1 and offset <= obSearchBars * 3
                obHi := high[offset]
                obLo := math.min(open[offset], close[offset])
    else
        float best = -999.0
        for i = 1 to obSearchBars
            isOpp = close[i] > open[i]
            bAtr = math.abs(open[i] - close[i]) / math.max(atr14[i], syminfo.mintick)
            sc = (isOpp ? 1.0 : -99.0) + bAtr * 0.5 - i * 0.04
            if isOpp and bAtr >= 0.10 and sc > best
                best := sc
                obHi := high[i]
                obLo := math.min(open[i], close[i])
    [obHi, obLo]

// ── OB Zone Rendering with Lifecycle Management ──────────────
// Bull and bear OBs tracked separately for distinct visuals.
// Mitigated OBs (price closes through the zone) are deleted.
// Expired OBs (older than obExpBars) are pruned.
var float[] obBullHi  = array.new_float(0), var float[] obBullLo  = array.new_float(0)
var int[]   obBullBar = array.new_int(0)
var box[]   obBullBox = array.new_box(0),   var label[] obBullLbl = array.new_label(0)

var float[] obBearHi  = array.new_float(0), var float[] obBearLo  = array.new_float(0)
var int[]   obBearBar = array.new_int(0)
var box[]   obBearBox = array.new_box(0),   var label[] obBearLbl = array.new_label(0)

if useOB and showOBZones
    // Register new bull OBs on bullish displacement
    if bullDisplace
        [obH, obL] = findBullOB()
        if not na(obH)
            newBox = box.new(bar_index - obSearchBars, obH, bar_index, obL,
                 bgcolor = color.new(bullCol, 85), border_color = color.new(bullCol, 40),
                 border_width = 1, border_style = line.style_solid)
            newLbl = label.new(bar_index, obH, "Bull OB",
                 style = label.style_none, textcolor = color.new(bullCol, 20), size = size.tiny)
            array.push(obBullHi, obH), array.push(obBullLo, obL)
            array.push(obBullBar, bar_index), array.push(obBullBox, newBox)
            array.push(obBullLbl, newLbl)
    // Register new bear OBs on bearish displacement
    if bearDisplace
        [obH, obL] = findBearOB()
        if not na(obH)
            newBox = box.new(bar_index - obSearchBars, obH, bar_index, obL,
                 bgcolor = color.new(bearCol, 85), border_color = color.new(bearCol, 40),
                 border_width = 1, border_style = line.style_solid)
            newLbl = label.new(bar_index, obL, "Bear OB",
                 style = label.style_none, textcolor = color.new(bearCol, 20), size = size.tiny)
            array.push(obBearHi, obH), array.push(obBearLo, obL)
            array.push(obBearBar, bar_index), array.push(obBearBox, newBox)
            array.push(obBearLbl, newLbl)

    // ── Bull OB lifecycle: extend active, delete mitigated/expired ──
    // Bull OB is mitigated when price closes below the OB low.
    int bi = array.size(obBullHi) - 1
    while bi >= 0
        obL = array.get(obBullLo, bi)
        age = bar_index - array.get(obBullBar, bi)
        mitigated = close < obL  // price closed through bull OB zone
        expired = age > obExpBars
        if mitigated or expired
            b = array.get(obBullBox, bi)
            if not na(b)
                box.delete(b)
            l = array.get(obBullLbl, bi)
            if not na(l)
                label.delete(l)
            array.remove(obBullHi, bi), array.remove(obBullLo, bi)
            array.remove(obBullBar, bi), array.remove(obBullBox, bi)
            array.remove(obBullLbl, bi)
        else
            b = array.get(obBullBox, bi)
            if not na(b)
                box.set_right(b, bar_index)
        bi -= 1

    // ── Bear OB lifecycle: extend active, delete mitigated/expired ──
    // Bear OB is mitigated when price closes above the OB high.
    int bj = array.size(obBearHi) - 1
    while bj >= 0
        obH = array.get(obBearHi, bj)
        age = bar_index - array.get(obBearBar, bj)
        mitigated = close > obH  // price closed through bear OB zone
        expired = age > obExpBars
        if mitigated or expired
            b = array.get(obBearBox, bj)
            if not na(b)
                box.delete(b)
            l = array.get(obBearLbl, bj)
            if not na(l)
                label.delete(l)
            array.remove(obBearHi, bj), array.remove(obBearLo, bj)
            array.remove(obBearBar, bj), array.remove(obBearBox, bj)
            array.remove(obBearLbl, bj)
        else
            b = array.get(obBearBox, bj)
            if not na(b)
                box.set_right(b, bar_index)
        bj -= 1

    // Limit OB zone count per side
    while array.size(obBullBox) > maxActiveFvg
        b = array.shift(obBullBox)
        if not na(b)
            box.delete(b)
        l = array.shift(obBullLbl)
        if not na(l)
            label.delete(l)
        array.shift(obBullHi), array.shift(obBullLo), array.shift(obBullBar)
    while array.size(obBearBox) > maxActiveFvg
        b = array.shift(obBearBox)
        if not na(b)
            box.delete(b)
        l = array.shift(obBearLbl)
        if not na(l)
            label.delete(l)
        array.shift(obBearHi), array.shift(obBearLo), array.shift(obBearBar)

// Clean all OB zones when the feature is disabled
if not useOB or not showOBZones
    while array.size(obBullBox) > 0
        b = array.shift(obBullBox)
        if not na(b)
            box.delete(b)
        l = array.shift(obBullLbl)
        if not na(l)
            label.delete(l)
        array.shift(obBullHi), array.shift(obBullLo), array.shift(obBullBar)
    while array.size(obBearBox) > 0
        b = array.shift(obBearBox)
        if not na(b)
            box.delete(b)
        l = array.shift(obBearLbl)
        if not na(l)
            label.delete(l)
        array.shift(obBearHi), array.shift(obBearLo), array.shift(obBearBar)

// ═══════════════════════════════════════════════════════════════
//  10. LIQUIDITY RAID DETECTION (useLiqPools gated)
// ═══════════════════════════════════════════════════════════════
sweepTol = atr14 * 0.05

// SSL raid (sweep below sell-side liquidity → bullish setup)
sslRaid = useLiqPools and not na(ssl) and low < ssl - sweepTol and close > ssl
pdlRaid = useLiqPools and usePDHL and not na(pdl) and low < pdl - sweepTol and close > pdl
eqlRaid = useLiqPools and useEqlHL and not na(eqlLevel) and low < eqlLevel - sweepTol and close > eqlLevel
prevSessLRaid = useLiqPools and useSessionHL and not na(prevSessL) and low < prevSessL - sweepTol and close > prevSessL
anyBullRaid = sslRaid or pdlRaid or eqlRaid or prevSessLRaid

// BSL raid (sweep above buy-side liquidity → bearish setup)
bslRaid = useLiqPools and not na(bsl) and high > bsl + sweepTol and close < bsl
pdhRaid = useLiqPools and usePDHL and not na(pdh) and high > pdh + sweepTol and close < pdh
eqhRaid = useLiqPools and useEqlHL and not na(eqhLevel) and high > eqhLevel + sweepTol and close < eqhLevel
prevSessHRaid = useLiqPools and useSessionHL and not na(prevSessH) and high > prevSessH + sweepTol and close < prevSessH
anyBearRaid = bslRaid or pdhRaid or eqhRaid or prevSessHRaid

// ── Identify which liquidity source was raided ───────────────
curBullRaidSrc = anyBullRaid ? (eqlRaid ? "EQL" : pdlRaid ? "PDL" : prevSessLRaid ? "SessL" : "SSL") : ""
curBullRaidLvl = anyBullRaid ? (eqlRaid ? eqlLevel : pdlRaid ? pdl : prevSessLRaid ? prevSessL : ssl) : na
curBearRaidSrc = anyBearRaid ? (eqhRaid ? "EQH" : pdhRaid ? "PDH" : prevSessHRaid ? "SessH" : "BSL") : ""
curBearRaidLvl = anyBearRaid ? (eqhRaid ? eqhLevel : pdhRaid ? pdh : prevSessHRaid ? prevSessH : bsl) : na

// Track most recent raid with source provenance
var bool bullRaidPending = false, var int bullRaidBar = na, var float bullRaidLow = na
var string bullRaidSrc = "", var float bullRaidLvl = na
var bool bearRaidPending = false, var int bearRaidBar = na, var float bearRaidHigh = na
var string bearRaidSrc = "", var float bearRaidLvl = na
var string lastRaidSide = ""
var string lastRaidSource = ""
var float lastRaidLevel = na

if anyBullRaid
    bullRaidPending := true
    bullRaidBar     := bar_index
    bullRaidLow     := low
    bullRaidSrc     := curBullRaidSrc
    bullRaidLvl     := curBullRaidLvl
    lastRaidSide    := "BULL"
    lastRaidSource  := curBullRaidSrc
    lastRaidLevel   := curBullRaidLvl

if anyBearRaid
    bearRaidPending := true
    bearRaidBar     := bar_index
    bearRaidHigh    := high
    bearRaidSrc     := curBearRaidSrc
    bearRaidLvl     := curBearRaidLvl
    lastRaidSide    := "BEAR"
    lastRaidSource  := curBearRaidSrc
    lastRaidLevel   := curBearRaidLvl

// Expire stale raids
if bullRaidPending and not na(bullRaidBar) and bar_index - bullRaidBar > cancelBars
    bullRaidPending := false
if bearRaidPending and not na(bearRaidBar) and bar_index - bearRaidBar > cancelBars
    bearRaidPending := false

// ═══════════════════════════════════════════════════════════════
//  11. SMT DIVERGENCE DETECTION
// ═══════════════════════════════════════════════════════════════
var bool smtBullDiv = false, var bool smtBearDiv = false
var int smtDivBar = na

if smtEn
    [_, smtBHigh, smtBLow] = request.security(smtSymbolB, timeframe.period,
         [close, high, low], lookahead = barmerge.lookahead_off)

    smtBPivH = ta.pivothigh(smtBHigh, smtPivotLen, smtPivotLen)
    smtBPivL = ta.pivotlow(smtBLow, smtPivotLen, smtPivotLen)

    var float smtBLastH = na, var float smtBLastL = na

    if not na(smtBPivH)
        smtBLastH := smtBPivH
    if not na(smtBPivL)
        smtBLastL := smtBPivL

    if smtCorr == "positive"
        if not na(pivotH) and not na(lastSwH) and pivotH > prevSwH and not na(smtBLastH) and smtBPivH < smtBLastH
            smtBearDiv := true
            smtDivBar  := bar_index
        if not na(pivotL) and not na(lastSwL) and pivotL < prevSwL and not na(smtBLastL) and smtBPivL > smtBLastL
            smtBullDiv := true
            smtDivBar  := bar_index
    else
        if not na(pivotH) and not na(lastSwH) and pivotH > prevSwH and not na(smtBLastL) and smtBPivL > smtBLastL
            smtBearDiv := true
            smtDivBar  := bar_index
        if not na(pivotL) and not na(lastSwL) and pivotL < prevSwL and not na(smtBLastH) and smtBPivH < smtBLastH
            smtBullDiv := true
            smtDivBar  := bar_index

    if not na(smtDivBar) and bar_index - smtDivBar > smtMaxBars
        smtBullDiv := false
        smtBearDiv := false

// ═══════════════════════════════════════════════════════════════
//  12. CONFLUENCE SCORING ENGINE
// ═══════════════════════════════════════════════════════════════
calcScore(hasLiqRaid, hasMSS, hasFVG, hasOB, inKillZone, hasSMT) =>
    int score = 0
    score += hasLiqRaid ? wLiquidity : 0
    score += hasMSS     ? wMSS      : 0
    score += hasFVG     ? wFVG      : 0
    score += hasOB      ? wOB       : 0
    score += inKillZone ? wSession  : 0
    score += hasSMT     ? wSMT     : 0
    score

// Adaptive threshold computation
var int recentWins = 0, var int recentTotal = 0
adaptiveWR = recentTotal > 0 ? recentWins * 100.0 / recentTotal : 50.0
adaptiveShift = profileMode == "AUTO" ?
     int(clamp((50.0 - adaptiveWR) * adaptiveMaxShift / 50.0, -adaptiveMaxShift, adaptiveMaxShift)) : 0
effectiveThreshold = profileMode == "MANUAL" ?
     math.max(1, int(manualConfThreshold / 10)) :
     math.max(1, scoreThreshold + adaptiveShift)

scorePassesThreshold(score) =>
    not useScoring or score >= effectiveThreshold

// ═══════════════════════════════════════════════════════════════
//  13. PO3 / AMD SESSION TRACKING
// ═══════════════════════════════════════════════════════════════
var float po3AccumH = na, var float po3AccumL = na
var bool po3AccumDone = false
var bool po3ManipDone = false
var bool po3ManipBull = false
var float po3ManipExtreme = na

if inPo3Accum
    if inPo3Accum and not inPo3Accum[1]
        po3AccumH := high
        po3AccumL := low
        po3AccumDone := false
        po3ManipDone := false
    else
        po3AccumH := math.max(nz(po3AccumH, high), high)
        po3AccumL := math.min(nz(po3AccumL, low), low)
    po3AccumDone := true

if strat3En and inPo3Manip and po3AccumDone and not po3ManipDone
    sweepAbove = not na(po3AccumH) and high > po3AccumH + atr14 * 0.05 and close < po3AccumH
    sweepBelow = not na(po3AccumL) and low < po3AccumL - atr14 * 0.05 and close > po3AccumL
    if sweepAbove
        po3ManipDone    := true
        po3ManipBull    := false
        po3ManipExtreme := high
    if sweepBelow
        po3ManipDone    := true
        po3ManipBull    := true
        po3ManipExtreme := low

// ═══════════════════════════════════════════════════════════════
//  14. JUDAS SWING TRACKING (timezone-aware via tzMain)
// ═══════════════════════════════════════════════════════════════
var float judasOpenRef = na
var bool judasRaidDone = false
var bool judasIsBull = false
var float judasExtreme = na

// Midnight reference — uses global timezone
midnightSession = timeBasis == "UTC" ? "0500-0501" :
     timeBasis == "New York (ICT)" ? "0000-0001" :
     "0000-0001"
isMidnight = not na(time(timeframe.period, midnightSession, tzMain))
if isMidnight and (na(judasOpenRef) or isMidnight and not isMidnight[1])
    judasOpenRef  := open
    judasRaidDone := false

if strat4En and inJudas and not na(judasOpenRef) and not judasRaidDone
    if high > judasOpenRef + atr14 * 0.15 and close < judasOpenRef
        judasRaidDone := true
        judasIsBull   := false
        judasExtreme  := high
    if low < judasOpenRef - atr14 * 0.15 and close > judasOpenRef
        judasRaidDone := true
        judasIsBull   := true
        judasExtreme  := low

// ═══════════════════════════════════════════════════════════════
//  15. CANDIDATE-BASED STRATEGY EVALUATION
// ═══════════════════════════════════════════════════════════════
// Each strategy writes to parallel candidate arrays (index 0-4 = S1-S5).
// Priority engine (section 16) selects the winning candidate.

// Candidate arrays — fresh each bar (no var)
bool[]   cValid    = array.new_bool(5, false)
bool[]   cBull     = array.new_bool(5, false)
bool[]   cCandidate = array.new_bool(5, false)
bool[]   cArmed    = array.new_bool(5, false)
float[]  cEntry    = array.new_float(5, na)
float[]  cSL       = array.new_float(5, na)
float[]  cTP1      = array.new_float(5, na)
float[]  cTP2      = array.new_float(5, na)
int[]    cScore    = array.new_int(5, 0)
string[] cSetup    = array.new_string(5, "")
float[]  cZoneHi   = array.new_float(5, na)
float[]  cZoneLo   = array.new_float(5, na)
string[] cRaidSrc  = array.new_string(5, "")
float[]  cRaidLvl  = array.new_float(5, na)
string[] cEntrySrc = array.new_string(5, "")
int[]    cEntryBar = array.new_int(5, na)
int[]    cArmedBar = array.new_int(5, na)
int[]    cTriggerBar = array.new_int(5, na)
int[]    cMitBar   = array.new_int(5, na)
string[] cZoneType = array.new_string(5, "")
string[] cState    = array.new_string(5, "IDLE")
string[] cDesc     = array.new_string(5, "")
string[] cPlan     = array.new_string(5, "")

// Setup lifecycle model: candidate identifies likely intent, armed publishes the trade plan,
// triggered validates that price actually traded the execution zone, and signalPrinted is the final chart event.
var float plannedEntryPrice = na
var float executionZoneLow = na
var float executionZoneHigh = na
var int setupArmedBarIndex = na
var int triggerBarIndex = na
var bool setupCandidate = false
var bool setupArmed = false
var bool signalPrinted = false

// ── Helper: compute entry price (FVG CE or proximal edge) ────
calcEntryPrice(isBull, fvgHi, fvgLo) =>
    // fvgHi = proximal for bull, fvgLo = proximal for bear
    fvgCE = (fvgHi + fvgLo) / 2.0
    if fvgUseCE
        [fvgCE, "FVG_CE"]
    else
        lvl = isBull ? fvgHi : fvgLo
        [lvl, "FVG_TOUCH"]

// ── Helper: compute SL/TP using riskMode ─────────────────────
// findStructureTP: find nearest structural level for TP
findStructureTP(isBull, entryPrice) =>
    float tp = na
    if isBull
        if not na(pdh) and pdh > entryPrice and (na(tp) or pdh < tp)
            tp := pdh
        if not na(sessH) and sessH > entryPrice and (na(tp) or sessH < tp)
            tp := sessH
        if not na(eqhLevel) and eqhLevel > entryPrice and (na(tp) or eqhLevel < tp)
            tp := eqhLevel
        if not na(bsl) and bsl > entryPrice and (na(tp) or bsl < tp)
            tp := bsl
    else
        if not na(pdl) and pdl < entryPrice and (na(tp) or pdl > tp)
            tp := pdl
        if not na(sessL) and sessL < entryPrice and (na(tp) or sessL > tp)
            tp := sessL
        if not na(eqlLevel) and eqlLevel < entryPrice and (na(tp) or eqlLevel > tp)
            tp := eqlLevel
        if not na(ssl) and ssl < entryPrice and (na(tp) or ssl > tp)
            tp := ssl
    tp

calcTrade(isBull, entryPrice, raidExtreme, fvgBound) =>
    float sl = na
    float risk = na
    if stopMode == "structure"
        sl := isBull ? raidExtreme - atr14 * stopBuf : raidExtreme + atr14 * stopBuf
    else if stopMode == "atr"
        sl := isBull ? entryPrice - ta.atr(stopAtrLen) * stopAtrMult : entryPrice + ta.atr(stopAtrLen) * stopAtrMult
    else
        sl := isBull ? fvgBound - atr14 * stopBuf : fvgBound + atr14 * stopBuf
    risk := math.abs(entryPrice - sl)
    float tp1 = na
    float tp2 = na
    if riskMode == "fixedRR"
        tp1 := isBull ? entryPrice + risk * rrRatio : entryPrice - risk * rrRatio
        tp2 := tp1
    else if riskMode == "structure"
        structTP = findStructureTP(isBull, entryPrice)
        if not na(structTP)
            tp1 := structTP
            tp2 := structTP
        else
            // Fallback to multiRR if no structure found
            tp1 := isBull ? entryPrice + risk * t1R : entryPrice - risk * t1R
            tp2 := isBull ? entryPrice + risk * t2R : entryPrice - risk * t2R
    else
        // multiRR (default)
        tp1 := isBull ? entryPrice + risk * t1R : entryPrice - risk * t1R
        tp2 := isBull ? entryPrice + risk * t2R : entryPrice - risk * t2R
    riskOk = risk <= maxRiskAtr * atr14 and risk > syminfo.mintick
    [sl, tp1, tp2, risk, riskOk]

setLifecycleCandidate(int idx, bool isBull, string setup, string description, string stateText, string raidSource, float raidLevel) =>
    array.set(cCandidate, idx, true)
    array.set(cBull, idx, isBull)
    array.set(cSetup, idx, setup)
    array.set(cDesc, idx, description)
    array.set(cState, idx, stateText)
    array.set(cRaidSrc, idx, raidSource)
    array.set(cRaidLvl, idx, raidLevel)

setLifecycleArmed(int idx, bool isBull, string setup, string description, float entryP, float sl, float tp1, float tp2, int score, float zoneHi, float zoneLo, string raidSource, float raidLevel, string entrySrc, int armedBar, string zoneType) =>
    array.set(cCandidate, idx, true)
    array.set(cArmed, idx, true)
    array.set(cBull, idx, isBull)
    array.set(cEntry, idx, entryP)
    array.set(cSL, idx, sl)
    array.set(cTP1, idx, tp1)
    array.set(cTP2, idx, tp2)
    array.set(cScore, idx, score)
    array.set(cSetup, idx, setup)
    array.set(cZoneHi, idx, zoneHi)
    array.set(cZoneLo, idx, zoneLo)
    array.set(cRaidSrc, idx, raidSource)
    array.set(cRaidLvl, idx, raidLevel)
    array.set(cEntrySrc, idx, entrySrc)
    array.set(cArmedBar, idx, armedBar)
    array.set(cState, idx, "ARMED")
    array.set(cDesc, idx, description)
    array.set(cPlan, idx, entryPlanLabel(entrySrc, zoneType))
    array.set(cZoneType, idx, zoneType)

setLifecycleTriggered(int idx, int triggerBar, int mitigationBar) =>
    array.set(cValid, idx, true)
    array.set(cTriggerBar, idx, triggerBar)
    array.set(cEntryBar, idx, triggerBar)
    array.set(cMitBar, idx, mitigationBar)
    array.set(cState, idx, "TRIGGERED")

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 1: Liquidity Raid → MSS/Displacement → FVG Entry
// ═══════════════════════════════════════════════════════════════
var int s1BullState = 0, var int s1BearState = 0
var int s1BullBar = na, var int s1BearBar = na
var float s1BullRaidLow = na, var float s1BearRaidHigh = na
var float s1BullFvgHi = na, var float s1BullFvgLo = na
var float s1BearFvgHi = na, var float s1BearFvgLo = na
var bool s1BullHasOB = false, var bool s1BearHasOB = false

if newDay
    s1BullState := 0
    s1BearState := 0
    s1BullBar := na
    s1BearBar := na
    s1BullFvgHi := na
    s1BullFvgLo := na
    s1BearFvgHi := na
    s1BearFvgLo := na
    s1BullHasOB := false
    s1BearHasOB := false

if strat1En and tfOk
    // ── BULL path ──
    if s1BullState == 0 and anyBullRaid
        s1BullState   := 1
        s1BullBar     := bar_index
        s1BullRaidLow := low

    if s1BullState == 1
        setLifecycleCandidate(0, true, "RAID_MSS_FVG", strategyDescription(1), "CANDIDATE", bullRaidSrc, bullRaidLvl)

    if s1BullState == 1 and bullMSS and bullDisplaceOk and volSpikeOk
        hasFvg = not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= 3
        if hasFvg
            s1BullState := 2
            s1BullBar   := bar_index
            s1BullFvgHi := lastBullFvgHi
            s1BullFvgLo := lastBullFvgLo
            if useOB
                [obH, obL] = findBullOB()
                s1BullHasOB := not na(obH)

    // State 2 → Armed: FVG is known, so publish the execution plan before price returns to it.
    if s1BullState == 2 and not na(s1BullFvgHi) and not na(s1BullFvgLo)
        [entryP, entrySrc] = calcEntryPrice(true, s1BullFvgHi, s1BullFvgLo)
        [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, s1BullRaidLow, s1BullFvgLo)
        score = calcScore(true, true, true, s1BullHasOB, inAnyKz, smtBullDiv)
        armedReady = inSessionFinal and htfBullOk and premDiscOk(true) and rsiBullOk and riskOk and scorePassesThreshold(score)
        if armedReady
            setLifecycleArmed(0, true, "RAID_MSS_FVG", strategyDescription(1), entryP, sl, tp1, tp2, score, s1BullFvgHi, s1BullFvgLo, bullRaidSrc, bullRaidLvl, entrySrc, nz(s1BullBar, bar_index), "FVG")
            triggerTouch = executionZoneTouched(true, entryP, s1BullFvgHi, s1BullFvgLo, entrySrc)
            if triggerTouch and barConfirmedOk
                setLifecycleTriggered(0, bar_index, bar_index)

    // Expiry
    if s1BullState > 0 and not na(s1BullBar) and bar_index - s1BullBar > cancelBars
        s1BullState := 0
    if s1BullState > 0 and anyBearRaid
        s1BullState := 0

    // ── BEAR path ──
    if s1BearState == 0 and anyBearRaid
        s1BearState    := 1
        s1BearBar      := bar_index
        s1BearRaidHigh := high

    if s1BearState == 1
        setLifecycleCandidate(0, false, "RAID_MSS_FVG", strategyDescription(1), "CANDIDATE", bearRaidSrc, bearRaidLvl)

    if s1BearState == 1 and bearMSS and bearDisplaceOk and volSpikeOk
        hasFvg = not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= 3
        if hasFvg
            s1BearState := 2
            s1BearBar   := bar_index
            s1BearFvgHi := lastBearFvgHi
            s1BearFvgLo := lastBearFvgLo
            if useOB
                [obH, obL] = findBearOB()
                s1BearHasOB := not na(obH)

    if s1BearState == 2 and not na(s1BearFvgHi) and not na(s1BearFvgLo) and not array.get(cValid, 0)
        [entryP, entrySrc] = calcEntryPrice(false, s1BearFvgHi, s1BearFvgLo)
        [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, s1BearRaidHigh, s1BearFvgHi)
        score = calcScore(true, true, true, s1BearHasOB, inAnyKz, smtBearDiv)
        armedReady = inSessionFinal and htfBearOk and premDiscOk(false) and rsiBearOk and riskOk and scorePassesThreshold(score)
        if armedReady
            setLifecycleArmed(0, false, "RAID_MSS_FVG", strategyDescription(1), entryP, sl, tp1, tp2, score, s1BearFvgHi, s1BearFvgLo, bearRaidSrc, bearRaidLvl, entrySrc, nz(s1BearBar, bar_index), "FVG")
            triggerTouch = executionZoneTouched(false, entryP, s1BearFvgHi, s1BearFvgLo, entrySrc)
            if triggerTouch and barConfirmedOk
                setLifecycleTriggered(0, bar_index, bar_index)

    if s1BearState > 0 and not na(s1BearBar) and bar_index - s1BearBar > cancelBars
        s1BearState := 0
    if s1BearState > 0 and anyBullRaid
        s1BearState := 0

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 2: ICT Silver Bullet
// ═══════════════════════════════════════════════════════════════
var float s2BullFvgHi = na, var float s2BullFvgLo = na, var int s2BullBar = na
var float s2BearFvgHi = na, var float s2BearFvgLo = na, var int s2BearBar = na
var bool s2BullRaided = false, var bool s2BearRaided = false
var float s2BullRaidLow = na, var string s2BullRaidSrc = ""
var float s2BearRaidHigh = na, var string s2BearRaidSrc = ""

if newDay
    s2BullFvgHi := na
    s2BullFvgLo := na
    s2BullBar := na
    s2BearFvgHi := na
    s2BearFvgLo := na
    s2BearBar := na
    s2BullRaided := false
    s2BearRaided := false
    s2BullRaidLow := na
    s2BullRaidSrc := ""
    s2BearRaidHigh := na
    s2BearRaidSrc := ""

if strat2En and tfOk and inAnySB
    if bullFvgDisp and anyBullRaid
        s2BullFvgHi   := lastBullFvgHi
        s2BullFvgLo   := lastBullFvgLo
        s2BullBar     := bar_index
        s2BullRaided  := true
        s2BullRaidLow := low
        s2BullRaidSrc := curBullRaidSrc

    if bearFvgDisp and anyBearRaid
        s2BearFvgHi    := lastBearFvgHi
        s2BearFvgLo    := lastBearFvgLo
        s2BearBar      := bar_index
        s2BearRaided   := true
        s2BearRaidHigh := high
        s2BearRaidSrc  := curBearRaidSrc

    if s2BullRaided and not na(s2BullFvgHi)
        [entryP, entrySrc] = calcEntryPrice(true, s2BullFvgHi, s2BullFvgLo)
        [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, s2BullRaidLow, s2BullFvgLo)
        score = calcScore(true, false, true, false, true, smtBullDiv)
        armedReady = htfBullOk and rsiBullOk and riskOk and scorePassesThreshold(score)
        if armedReady
            setLifecycleArmed(1, true, "SILVER_BULLET", strategyDescription(2), entryP, sl, tp1, tp2, score, s2BullFvgHi, s2BullFvgLo, s2BullRaidSrc, nz(bullRaidLvl), entrySrc, nz(s2BullBar, bar_index), "FVG")
            triggerTouch = executionZoneTouched(true, entryP, s2BullFvgHi, s2BullFvgLo, entrySrc)
            if triggerTouch and barConfirmedOk
                setLifecycleTriggered(1, bar_index, bar_index)

    if s2BearRaided and not na(s2BearFvgHi) and not array.get(cValid, 1)
        [entryP, entrySrc] = calcEntryPrice(false, s2BearFvgHi, s2BearFvgLo)
        [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, s2BearRaidHigh, s2BearFvgHi)
        score = calcScore(true, false, true, false, true, smtBearDiv)
        armedReady = htfBearOk and rsiBearOk and riskOk and scorePassesThreshold(score)
        if armedReady
            setLifecycleArmed(1, false, "SILVER_BULLET", strategyDescription(2), entryP, sl, tp1, tp2, score, s2BearFvgHi, s2BearFvgLo, s2BearRaidSrc, nz(bearRaidLvl), entrySrc, nz(s2BearBar, bar_index), "FVG")
            triggerTouch = executionZoneTouched(false, entryP, s2BearFvgHi, s2BearFvgLo, entrySrc)
            if triggerTouch and barConfirmedOk
                setLifecycleTriggered(1, bar_index, bar_index)

if not inAnySB
    s2BullRaided := false
    s2BearRaided := false
    s2BullFvgHi  := na
    s2BullFvgLo  := na
    s2BearFvgHi  := na
    s2BearFvgLo  := na

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 3: Power of Three (PO3 / AMD)
// ═══════════════════════════════════════════════════════════════
var int s3State = 0
var int s3Bar = na
var float s3FvgHi = na, var float s3FvgLo = na

if newDay
    s3State := 0
    s3Bar := na
    s3FvgHi := na
    s3FvgLo := na

if strat3En and tfOk
    if s3State == 0 and po3ManipDone and inPo3Manip
        s3State := 1
        s3Bar   := bar_index

    if s3State == 1
        setLifecycleCandidate(2, po3ManipBull, "PO3_AMD", strategyDescription(3), "CANDIDATE", "PO3_Manip", nz(po3ManipExtreme))

    if s3State == 1
        if po3ManipBull and bullMSS and bullDisplaceOk
            hasFvg = not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= 5
            if hasFvg
                s3State  := 2
                s3FvgHi  := lastBullFvgHi
                s3FvgLo  := lastBullFvgLo
                s3Bar    := bar_index
        if not po3ManipBull and bearMSS and bearDisplaceOk
            hasFvg = not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= 5
            if hasFvg
                s3State  := 2
                s3FvgHi  := lastBearFvgHi
                s3FvgLo  := lastBearFvgLo
                s3Bar    := bar_index

    if s3State == 2 and not na(s3FvgHi) and not na(s3FvgLo)
        if po3ManipBull
            [entryP, entrySrc] = calcEntryPrice(true, s3FvgHi, s3FvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, nz(po3ManipExtreme, low), s3FvgLo)
            score = calcScore(true, true, true, false, true, smtBullDiv)
            armedReady = rsiBullOk and riskOk and scorePassesThreshold(score)
            if armedReady
                setLifecycleArmed(2, true, "PO3_AMD", strategyDescription(3), entryP, sl, tp1, tp2, score, s3FvgHi, s3FvgLo, "PO3_Manip", nz(po3ManipExtreme), entrySrc, nz(s3Bar, bar_index), "FVG")
                triggerTouch = executionZoneTouched(true, entryP, s3FvgHi, s3FvgLo, entrySrc)
                if inPo3Dist and triggerTouch and barConfirmedOk
                    setLifecycleTriggered(2, bar_index, bar_index)
        else
            [entryP, entrySrc] = calcEntryPrice(false, s3FvgHi, s3FvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, nz(po3ManipExtreme, high), s3FvgHi)
            score = calcScore(true, true, true, false, true, smtBearDiv)
            armedReady = rsiBearOk and riskOk and scorePassesThreshold(score)
            if armedReady
                setLifecycleArmed(2, false, "PO3_AMD", strategyDescription(3), entryP, sl, tp1, tp2, score, s3FvgHi, s3FvgLo, "PO3_Manip", nz(po3ManipExtreme), entrySrc, nz(s3Bar, bar_index), "FVG")
                triggerTouch = executionZoneTouched(false, entryP, s3FvgHi, s3FvgLo, entrySrc)
                if inPo3Dist and triggerTouch and barConfirmedOk
                    setLifecycleTriggered(2, bar_index, bar_index)

    if s3State > 0 and not na(s3Bar) and bar_index - s3Bar > cancelBars * 2
        s3State := 0

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 4: Judas Swing
// ═══════════════════════════════════════════════════════════════
var int s4State = 0
var int s4Bar = na
var float s4FvgHi = na, var float s4FvgLo = na

if newDay
    s4State := 0
    s4Bar := na
    s4FvgHi := na
    s4FvgLo := na

if strat4En and tfOk
    if s4State == 0 and judasRaidDone and inJudas
        s4State := 1
        s4Bar   := bar_index

    if s4State == 1
        setLifecycleCandidate(3, judasIsBull, "JUDAS_SWING", strategyDescription(4), "CANDIDATE", "Judas", nz(judasExtreme))

    if s4State == 1
        if judasIsBull and bullMSS and bullDisplaceOk
            hasFvg = not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= 5
            if hasFvg
                s4State := 2
                s4FvgHi := lastBullFvgHi
                s4FvgLo := lastBullFvgLo
                s4Bar   := bar_index
        if not judasIsBull and bearMSS and bearDisplaceOk
            hasFvg = not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= 5
            if hasFvg
                s4State := 2
                s4FvgHi := lastBearFvgHi
                s4FvgLo := lastBearFvgLo
                s4Bar   := bar_index

    if s4State == 2 and not na(s4FvgHi) and not na(s4FvgLo)
        if judasIsBull
            [entryP, entrySrc] = calcEntryPrice(true, s4FvgHi, s4FvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, nz(judasExtreme, low), s4FvgLo)
            score = calcScore(true, true, true, false, inAnyKz, smtBullDiv)
            armedReady = inSessionFinal and rsiBullOk and riskOk and scorePassesThreshold(score)
            if armedReady
                setLifecycleArmed(3, true, "JUDAS_SWING", strategyDescription(4), entryP, sl, tp1, tp2, score, s4FvgHi, s4FvgLo, "Judas", nz(judasExtreme), entrySrc, nz(s4Bar, bar_index), "FVG")
                triggerTouch = executionZoneTouched(true, entryP, s4FvgHi, s4FvgLo, entrySrc)
                if triggerTouch and barConfirmedOk
                    setLifecycleTriggered(3, bar_index, bar_index)
        else
            [entryP, entrySrc] = calcEntryPrice(false, s4FvgHi, s4FvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, nz(judasExtreme, high), s4FvgHi)
            score = calcScore(true, true, true, false, inAnyKz, smtBearDiv)
            armedReady = inSessionFinal and rsiBearOk and riskOk and scorePassesThreshold(score)
            if armedReady
                setLifecycleArmed(3, false, "JUDAS_SWING", strategyDescription(4), entryP, sl, tp1, tp2, score, s4FvgHi, s4FvgLo, "Judas", nz(judasExtreme), entrySrc, nz(s4Bar, bar_index), "FVG")
                triggerTouch = executionZoneTouched(false, entryP, s4FvgHi, s4FvgLo, entrySrc)
                if triggerTouch and barConfirmedOk
                    setLifecycleTriggered(3, bar_index, bar_index)

    if s4State > 0 and not na(s4Bar) and bar_index - s4Bar > cancelBars
        s4State := 0

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 5: SMT Divergence Reversal
// ═══════════════════════════════════════════════════════════════
var bool s5BullArmed = false, var bool s5BearArmed = false
var int s5BullBar = na, var int s5BearBar = na
var float s5BullFvgHi = na, var float s5BullFvgLo = na
var float s5BearFvgHi = na, var float s5BearFvgLo = na
var float s5BullRaidLow = na, var float s5BearRaidHigh = na
var float s5BullRaidLvl = na, var float s5BearRaidLvl = na
var string s5BullRaidSrc = "", var string s5BearRaidSrc = ""

if newDay
    s5BullArmed := false
    s5BearArmed := false
    s5BullBar := na
    s5BearBar := na
    s5BullFvgHi := na
    s5BullFvgLo := na
    s5BearFvgHi := na
    s5BearFvgLo := na
    s5BullRaidLow := na
    s5BearRaidHigh := na
    s5BullRaidLvl := na
    s5BearRaidLvl := na
    s5BullRaidSrc := ""
    s5BearRaidSrc := ""

if strat5En and smtEn and tfOk
    if smtBullDiv and anyBullRaid and bullMSS and bullDisplaceOk
        hasFvg = not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= 5
        if hasFvg
            s5BullArmed := true
            s5BullBar := bar_index
            s5BullFvgHi := lastBullFvgHi
            s5BullFvgLo := lastBullFvgLo
            s5BullRaidLow := nz(bullRaidLow, low)
            s5BullRaidLvl := bullRaidLvl
            s5BullRaidSrc := bullRaidSrc

    if smtBearDiv and anyBearRaid and bearMSS and bearDisplaceOk and not array.get(cValid, 4)
        hasFvg = not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= 5
        if hasFvg
            s5BearArmed := true
            s5BearBar := bar_index
            s5BearFvgHi := lastBearFvgHi
            s5BearFvgLo := lastBearFvgLo
            s5BearRaidHigh := nz(bearRaidHigh, high)
            s5BearRaidLvl := bearRaidLvl
            s5BearRaidSrc := bearRaidSrc

if s5BullArmed and not na(s5BullFvgHi) and not na(s5BullFvgLo)
    [entryP, entrySrc] = calcEntryPrice(true, s5BullFvgHi, s5BullFvgLo)
    [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, s5BullRaidLow, s5BullFvgLo)
    score = calcScore(true, true, true, false, inAnyKz, true)
    armedReady = inSessionFinal and rsiBullOk and riskOk and scorePassesThreshold(score)
    if armedReady
        setLifecycleArmed(4, true, "SMT_REVERSAL", strategyDescription(5), entryP, sl, tp1, tp2, score, s5BullFvgHi, s5BullFvgLo, s5BullRaidSrc, s5BullRaidLvl, entrySrc, nz(s5BullBar, bar_index), "FVG")
        triggerTouch = executionZoneTouched(true, entryP, s5BullFvgHi, s5BullFvgLo, entrySrc)
        if triggerTouch and barConfirmedOk
            setLifecycleTriggered(4, bar_index, bar_index)

if s5BearArmed and not na(s5BearFvgHi) and not na(s5BearFvgLo) and not array.get(cValid, 4)
    [entryP, entrySrc] = calcEntryPrice(false, s5BearFvgHi, s5BearFvgLo)
    [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, s5BearRaidHigh, s5BearFvgHi)
    score = calcScore(true, true, true, false, inAnyKz, true)
    armedReady = inSessionFinal and rsiBearOk and riskOk and scorePassesThreshold(score)
    if armedReady
        setLifecycleArmed(4, false, "SMT_REVERSAL", strategyDescription(5), entryP, sl, tp1, tp2, score, s5BearFvgHi, s5BearFvgLo, s5BearRaidSrc, s5BearRaidLvl, entrySrc, nz(s5BearBar, bar_index), "FVG")
        triggerTouch = executionZoneTouched(false, entryP, s5BearFvgHi, s5BearFvgLo, entrySrc)
        if triggerTouch and barConfirmedOk
            setLifecycleTriggered(4, bar_index, bar_index)

if s5BullArmed and not na(s5BullBar) and bar_index - s5BullBar > cancelBars
    s5BullArmed := false
    s5BullFvgHi := na
    s5BullFvgLo := na
    s5BullRaidLvl := na

if s5BearArmed and not na(s5BearBar) and bar_index - s5BearBar > cancelBars
    s5BearArmed := false
    s5BearFvgHi := na
    s5BearFvgLo := na
    s5BearRaidLvl := na

// ═══════════════════════════════════════════════════════════════
//  16. STRATEGY PRIORITY ENGINE
// ═══════════════════════════════════════════════════════════════
// Parse stratPriority string and select first valid candidate.

var int    sigStrat     = 0
var bool   sigBull      = false
var bool   sigBear      = false
var float  sigEntry     = na
var float  sigSL        = na
var float  sigTP1       = na
var float  sigTP2       = na
var int    sigScore     = 0
var string sigSetupType = ""
var float  sigZoneHi    = na
var float  sigZoneLo    = na
var string sigRaidSrc   = ""
var float  sigRaidLvl   = na
var string sigEntrySrc  = ""
var int    sigEntryBar  = na
var int    sigArmedBar  = na
var int    sigMitBar    = na
var string sigZoneType  = ""

var int    activePlanStrat = 0
var bool   activePlanBull = false
var string activePlanSetup = ""
var string activePlanState = "IDLE"
var string activePlanDesc = ""
var string activePlanEntryPlan = ""
var float  activePlanEntry = na
var float  activePlanSL = na
var float  activePlanTP1 = na
var float  activePlanTP2 = na
var float  activePlanZoneHi = na
var float  activePlanZoneLo = na
var float  activePlanRaidLvl = na
var string activePlanRaidSrc = ""
var string activePlanEntrySrc = ""
var int    activePlanBar = na
var int    activePlanScore = 0
var string activePlanZoneType = ""

var float  entryPriceLogic = na
var int    entryBarIndex = na
var int    mitigationBarIndex = na
var bool   entryReady = false
var bool   entryTriggered = false
var string entrySourceZoneType = ""
var string lastSelectedStrategy = "none"
var float  lastEntryPriceLogic = na
var int    lastEntryBarIndex = na
var int    lastMitigationBarIndex = na
var string lastEntryZoneType = ""

// Debug: track which candidates were valid and which won
var string debugCandidates = ""
var string debugWinner = ""

// Reset each bar
sigStrat     := 0
sigBull      := false
sigBear      := false
sigEntry     := na
sigSL        := na
sigTP1       := na
sigTP2       := na
sigScore     := 0
sigSetupType := ""
sigZoneHi    := na
sigZoneLo    := na
sigRaidSrc   := ""
sigRaidLvl   := na
sigEntrySrc  := ""
sigEntryBar  := na
sigArmedBar  := na
sigMitBar    := na
sigZoneType  := ""
activePlanStrat := 0
activePlanBull := false
activePlanSetup := ""
activePlanState := "IDLE"
activePlanDesc := ""
activePlanEntryPlan := ""
activePlanEntry := na
activePlanSL := na
activePlanTP1 := na
activePlanTP2 := na
activePlanZoneHi := na
activePlanZoneLo := na
activePlanRaidLvl := na
activePlanRaidSrc := ""
activePlanEntrySrc := ""
activePlanBar := na
activePlanScore := 0
activePlanZoneType := ""
entryPriceLogic := na
entryBarIndex := na
mitigationBarIndex := na
entryReady := false
entryTriggered := false
entrySourceZoneType := ""
plannedEntryPrice := na
executionZoneLow := na
executionZoneHigh := na
setupArmedBarIndex := na
triggerBarIndex := na
setupCandidate := false
setupArmed := false
signalPrinted := false
debugCandidates := ""
debugWinner := ""

// Build debug string of valid candidates
for ci = 0 to 4
    if array.get(cCandidate, ci) or array.get(cArmed, ci) or array.get(cValid, ci)
        debugCandidates := debugCandidates + (debugCandidates != "" ? "," : "") + "S" + str.tostring(ci + 1) + ":" + array.get(cState, ci)

// Parse priority and select winner
string[] prioParts = str.split(stratPriority, ",")
bool winnerFound = false
int armedFoundIdx = -1
int candidateFoundIdx = -1
for i = 0 to math.min(array.size(prioParts) - 1, 9)
    part = str.replace_all(array.get(prioParts, i), " ", "")
    stratIdx = part == "S1" ? 0 : part == "S2" ? 1 : part == "S3" ? 2 : part == "S4" ? 3 : part == "S5" ? 4 : -1
    if stratIdx >= 0 and stratIdx < 5
        if armedFoundIdx == -1 and array.get(cArmed, stratIdx)
            armedFoundIdx := stratIdx
        if candidateFoundIdx == -1 and array.get(cCandidate, stratIdx)
            candidateFoundIdx := stratIdx
        if not winnerFound and array.get(cValid, stratIdx)
            sigStrat     := stratIdx + 1
            sigBull      := array.get(cBull, stratIdx)
            sigBear      := not array.get(cBull, stratIdx)
            sigEntry     := array.get(cEntry, stratIdx)
            sigSL        := array.get(cSL, stratIdx)
            sigTP1       := array.get(cTP1, stratIdx)
            sigTP2       := array.get(cTP2, stratIdx)
            sigScore     := array.get(cScore, stratIdx)
            sigSetupType := array.get(cSetup, stratIdx)
            sigZoneHi    := array.get(cZoneHi, stratIdx)
            sigZoneLo    := array.get(cZoneLo, stratIdx)
            sigRaidSrc   := array.get(cRaidSrc, stratIdx)
            sigRaidLvl   := array.get(cRaidLvl, stratIdx)
            sigEntrySrc  := array.get(cEntrySrc, stratIdx)
            sigEntryBar  := array.get(cEntryBar, stratIdx)
            sigArmedBar  := array.get(cArmedBar, stratIdx)
            sigMitBar    := array.get(cMitBar, stratIdx)
            sigZoneType  := array.get(cZoneType, stratIdx)
            debugWinner  := "S" + str.tostring(stratIdx + 1)
            winnerFound  := true

int activePlanIdx = winnerFound ? sigStrat - 1 : (armedFoundIdx >= 0 ? armedFoundIdx : candidateFoundIdx)
if activePlanIdx >= 0
    activePlanStrat := activePlanIdx + 1
    activePlanBull := array.get(cBull, activePlanIdx)
    activePlanSetup := array.get(cSetup, activePlanIdx)
    activePlanState := array.get(cState, activePlanIdx)
    activePlanDesc := array.get(cDesc, activePlanIdx)
    activePlanEntryPlan := array.get(cPlan, activePlanIdx)
    activePlanEntry := array.get(cEntry, activePlanIdx)
    activePlanSL := array.get(cSL, activePlanIdx)
    activePlanTP1 := array.get(cTP1, activePlanIdx)
    activePlanTP2 := array.get(cTP2, activePlanIdx)
    activePlanZoneHi := array.get(cZoneHi, activePlanIdx)
    activePlanZoneLo := array.get(cZoneLo, activePlanIdx)
    activePlanRaidLvl := array.get(cRaidLvl, activePlanIdx)
    activePlanRaidSrc := array.get(cRaidSrc, activePlanIdx)
    activePlanEntrySrc := array.get(cEntrySrc, activePlanIdx)
    activePlanBar := array.get(cArmedBar, activePlanIdx)
    activePlanScore := array.get(cScore, activePlanIdx)
    activePlanZoneType := array.get(cZoneType, activePlanIdx)

plannedEntryPrice := activePlanEntry
executionZoneLow := activePlanZoneLo
executionZoneHigh := activePlanZoneHi
setupArmedBarIndex := activePlanBar
triggerBarIndex := winnerFound ? sigEntryBar : na
setupCandidate := activePlanState == "CANDIDATE"
setupArmed := activePlanState == "ARMED" or activePlanState == "TRIGGERED"

// Reset winning strategy state after selection
if sigStrat == 1
    if sigBull
        s1BullState := 0
    else
        s1BearState := 0
else if sigStrat == 2
    if sigBull
        s2BullRaided := false
        s2BullFvgHi  := na
    else
        s2BearRaided := false
        s2BearFvgHi  := na
else if sigStrat == 3
    s3State := 0
else if sigStrat == 4
    s4State := 0
else if sigStrat == 5
    if sigBull
        smtBullDiv := false
        s5BullArmed := false
        s5BullFvgHi := na
        s5BullFvgLo := na
    else
        smtBearDiv := false
        s5BearArmed := false
        s5BearFvgHi := na
        s5BearFvgLo := na

// ═══════════════════════════════════════════════════════════════
//  17. STANDALONE FVG MITIGATION (fallback when no strategy fires)
// ═══════════════════════════════════════════════════════════════
hasStratSignal = sigStrat > 0

var bool   fvgBuySignal  = false, var bool   fvgSellSignal = false
var float  fvgBuyEntry   = na, var float  fvgBuySL  = na
var float  fvgBuyTP      = na, var float  fvgBuyTP1 = na
var float  fvgSellEntry  = na, var float  fvgSellSL = na
var float  fvgSellTP     = na, var float  fvgSellTP1 = na
var int    fvgBuyScore   = 0, var int    fvgSellScore = 0
var int    fvgBuyEntryBar = na, var int fvgSellEntryBar = na

fvgBuySignal  := false
fvgSellSignal := false
fvgBuyEntryBar := na
fvgSellEntryBar := na

fvgEntryDepth = 0.30

// Bear FVG zones → SELL signals
if useFvg and array.size(sfHi) > 0 and not hasStratSignal
    int i = 0
    while i < array.size(sfHi)
        fHi = array.get(sfHi, i), fLo = array.get(sfLo, i)
        fAge = bar_index - array.get(sfBar, i)
        touched = array.get(sfTouched, i)

        fullFill = close < fLo - atr14 * 0.20
        if fAge > fvgExpBars or fullFill
            b = array.get(sfBox, i)
            if not na(b)
                box.delete(b)
            array.remove(sfHi, i), array.remove(sfLo, i), array.remove(sfSize, i)
            array.remove(sfBar, i), array.remove(sfBox, i), array.remove(sfTouched, i)
            continue

        priceInZone = high >= fLo and low <= fHi
        priceJustEntered = priceInZone and not touched
        if priceInZone and not touched
            array.set(sfTouched, i, true)

        proximalCeiling = fLo + (fHi - fLo) * fvgEntryDepth
        entryNearProximal = close <= proximalCeiling
        cameFromBelow = low[1] < fLo
        approachUp = (close[1] > open[1]) or (close[2] > open[2])
        potentialSL = fHi + atr14 * stopBuf
        potentialRisk = math.abs(close - potentialSL)
        riskOk = potentialRisk <= maxRiskAtr * atr14
        rejection = bearCandle and bodyPct >= 0.45 and entryNearProximal

        if priceJustEntered and rejection and cameFromBelow and approachUp and riskOk and
             inSessionFinal and htfBearOk and barConfirmedOk
            fvgSellSignal := true
            fvgSellEntry  := close
            fvgSellSL     := potentialSL
            fvgRisk        = potentialRisk
            fvgSellTP     := fvgSellEntry - fvgRisk * rrRatio
            fvgSellTP1    := fvgSellEntry - fvgRisk * t1R
            fvgSellScore  := calcScore(false, false, true, false, inAnyKz, smtBearDiv)
            fvgSellEntryBar := bar_index
            b = array.get(sfBox, i)
            if not na(b)
                box.delete(b)
            array.remove(sfHi, i), array.remove(sfLo, i), array.remove(sfSize, i)
            array.remove(sfBar, i), array.remove(sfBox, i), array.remove(sfTouched, i)
            break
        i += 1

// Bull FVG zones → BUY signals
if useFvg and array.size(bfHi) > 0 and not hasStratSignal
    int j = 0
    while j < array.size(bfHi)
        fHi = array.get(bfHi, j), fLo = array.get(bfLo, j)
        fAge = bar_index - array.get(bfBar, j)
        touched = array.get(bfTouched, j)

        fullFill = close > fHi + atr14 * 0.20
        if fAge > fvgExpBars or fullFill
            b = array.get(bfBox, j)
            if not na(b)
                box.delete(b)
            array.remove(bfHi, j), array.remove(bfLo, j), array.remove(bfSize, j)
            array.remove(bfBar, j), array.remove(bfBox, j), array.remove(bfTouched, j)
            continue

        priceInZone = low <= fHi and high >= fLo
        priceJustEntered = priceInZone and not touched
        if priceInZone and not touched
            array.set(bfTouched, j, true)

        proximalFloor = fHi - (fHi - fLo) * fvgEntryDepth
        entryNearProximal = close >= proximalFloor
        cameFromAbove = high[1] > fHi
        approachDown = (close[1] < open[1]) or (close[2] < open[2])
        potentialSL = fLo - atr14 * stopBuf
        potentialRisk = math.abs(close - potentialSL)
        riskOk = potentialRisk <= maxRiskAtr * atr14
        rejection = bullCandle and bodyPct >= 0.45 and entryNearProximal

        if priceJustEntered and rejection and cameFromAbove and approachDown and riskOk and
             inSessionFinal and htfBullOk and barConfirmedOk
            fvgBuySignal  := true
            fvgBuyEntry   := close
            fvgBuySL      := potentialSL
            fvgRisk        = potentialRisk
            fvgBuyTP      := fvgBuyEntry + fvgRisk * rrRatio
            fvgBuyTP1     := fvgBuyEntry + fvgRisk * t1R
            fvgBuyScore   := calcScore(false, false, true, false, inAnyKz, smtBullDiv)
            fvgBuyEntryBar := bar_index
            b = array.get(bfBox, j)
            if not na(b)
                box.delete(b)
            array.remove(bfHi, j), array.remove(bfLo, j), array.remove(bfSize, j)
            array.remove(bfBar, j), array.remove(bfBox, j), array.remove(bfTouched, j)
            break
        j += 1

// ═══════════════════════════════════════════════════════════════
//  18. SIGNAL CONSOLIDATION & COOLDOWN
// ═══════════════════════════════════════════════════════════════
hasFvgStandalone = (fvgBuySignal or fvgSellSignal) and not hasStratSignal

// Cooldown: suppress after consecutive losses
var int lastSignalBar = na
var int cooldownUntilBar = na
var int adaptiveLossStreak = 0

signalCooldownOk = na(lastSignalBar) or bar_index - lastSignalBar >= suppressBars
lossCooldownOk = na(cooldownUntilBar) or bar_index >= cooldownUntilBar

// Final trigger logic: only a real zone touch can promote an armed plan into a printed signal.
finalBuy  = (sigBull or fvgBuySignal) and signalCooldownOk and lossCooldownOk
finalSell = (sigBear or fvgSellSignal) and signalCooldownOk and lossCooldownOk

entryPriceLogic := hasStratSignal ? sigEntry : fvgBuySignal ? fvgBuyEntry : fvgSellSignal ? fvgSellEntry : na
entryBarIndex := hasStratSignal ? sigEntryBar : fvgBuySignal ? fvgBuyEntryBar : fvgSellSignal ? fvgSellEntryBar : na
mitigationBarIndex := hasStratSignal ? sigMitBar : fvgBuySignal ? fvgBuyEntryBar : fvgSellSignal ? fvgSellEntryBar : na
entryReady := (setupArmed and not na(plannedEntryPrice)) or hasFvgStandalone
entryTriggered := finalBuy or finalSell
signalPrinted := finalBuy or finalSell
entrySourceZoneType := hasStratSignal ? sigZoneType : setupArmed ? activePlanZoneType : hasFvgStandalone ? "STANDALONE_FVG" : ""

if finalBuy or finalSell
    lastSignalBar := bar_index
    lastSelectedStrategy := hasStratSignal ? debugWinner + " (" + sigSetupType + ")" : "FVG_MITIGATION"
    lastEntryPriceLogic := entryPriceLogic
    lastEntryBarIndex := entryBarIndex
    lastMitigationBarIndex := mitigationBarIndex
    lastEntryZoneType := entrySourceZoneType

// ═══════════════════════════════════════════════════════════════
//  19. PERFORMANCE TRACKING (with time stop + SIGNAL_CLOSE)
// ═══════════════════════════════════════════════════════════════
var string[] activeTradeId  = array.new_string(0)
var string[] activeTradeST  = array.new_string(0)
var string[] activeTradeDir = array.new_string(0)
var float[]  activeTradeEnt = array.new_float(0)
var float[]  activeTradeSL  = array.new_float(0)
var float[]  activeTradeTP  = array.new_float(0)
var float[]  activeTradeRR  = array.new_float(0)
var int[]    activeTradeBar = array.new_int(0)
var int[]    activeTradeConf = array.new_int(0)
var float[]  activeTradeTP1 = array.new_float(0)
var float[]  activeTradeBE  = array.new_float(0)  // BE level (na until BE triggered)
var float[]  activeTradeRisk = array.new_float(0)
var bool[]   activeTradeTP1Done = array.new_bool(0)
var float[]  activeTradeRealizedR = array.new_float(0)
var float[]  activeTradeQtyLeft = array.new_float(0)

var int   totalTrades = 0, var int   totalWins = 0, var int totalLoss = 0
var float totalR      = 0.0
var string lastSignalDirection = "NONE"
var string lastSignalSetup = "NONE"
var int   lastSigConf = na
var string lastCloseReason = "NONE"
var string lastCloseTradeId = ""
var float  lastCloseEntry = na
var float  lastClosePnlR = na
var string lastCloseSetup = ""

// Track new signals
if finalBuy
    direction = "LONG"
    setup = hasStratSignal ? sigSetupType : "FVG_MITIGATION"
    entry = hasStratSignal ? sigEntry : fvgBuyEntry
    sl    = hasStratSignal ? sigSL : fvgBuySL
    tp    = hasStratSignal ? sigTP2 : fvgBuyTP
    tp1val = hasStratSignal ? sigTP1 : fvgBuyTP1
    baseRisk = math.abs(entry - sl)
    rr    = baseRisk > syminfo.mintick ? math.abs(tp - entry) / baseRisk : 0.0
    conf  = hasStratSignal ? sigScore : fvgBuyScore
    openBarIdx = hasStratSignal ? sigEntryBar : fvgBuyEntryBar
    tradeId = buildExternalTradeId(setup, direction, int(time_close))
    array.push(activeTradeId, tradeId), array.push(activeTradeST, setup)
    array.push(activeTradeDir, direction), array.push(activeTradeEnt, entry)
    array.push(activeTradeSL, sl), array.push(activeTradeTP, tp)
    array.push(activeTradeRR, rr), array.push(activeTradeBar, nz(openBarIdx, bar_index))
    array.push(activeTradeConf, conf)
    array.push(activeTradeTP1, tp1val)
    array.push(activeTradeBE, na)
    array.push(activeTradeRisk, baseRisk)
    array.push(activeTradeTP1Done, false)
    array.push(activeTradeRealizedR, 0.0)
    array.push(activeTradeQtyLeft, 1.0)
    lastSignalDirection := direction
    lastSignalSetup := setup
    lastSigConf := conf
    while array.size(activeTradeId) > maxTrackedSigs
        array.shift(activeTradeId), array.shift(activeTradeST)
        array.shift(activeTradeDir), array.shift(activeTradeEnt)
        array.shift(activeTradeSL), array.shift(activeTradeTP)
        array.shift(activeTradeRR), array.shift(activeTradeBar)
        array.shift(activeTradeConf), array.shift(activeTradeTP1)
        array.shift(activeTradeBE)
        array.shift(activeTradeRisk), array.shift(activeTradeTP1Done)
        array.shift(activeTradeRealizedR), array.shift(activeTradeQtyLeft)

if finalSell
    direction = "SHORT"
    setup = hasStratSignal ? sigSetupType : "FVG_MITIGATION"
    entry = hasStratSignal ? sigEntry : fvgSellEntry
    sl    = hasStratSignal ? sigSL : fvgSellSL
    tp    = hasStratSignal ? sigTP2 : fvgSellTP
    tp1val = hasStratSignal ? sigTP1 : fvgSellTP1
    baseRisk = math.abs(entry - sl)
    rr    = baseRisk > syminfo.mintick ? math.abs(tp - entry) / baseRisk : 0.0
    conf  = hasStratSignal ? sigScore : fvgSellScore
    openBarIdx = hasStratSignal ? sigEntryBar : fvgSellEntryBar
    tradeId = buildExternalTradeId(setup, direction, int(time_close))
    array.push(activeTradeId, tradeId), array.push(activeTradeST, setup)
    array.push(activeTradeDir, direction), array.push(activeTradeEnt, entry)
    array.push(activeTradeSL, sl), array.push(activeTradeTP, tp)
    array.push(activeTradeRR, rr), array.push(activeTradeBar, nz(openBarIdx, bar_index))
    array.push(activeTradeConf, conf)
    array.push(activeTradeTP1, tp1val)
    array.push(activeTradeBE, na)
    array.push(activeTradeRisk, baseRisk)
    array.push(activeTradeTP1Done, false)
    array.push(activeTradeRealizedR, 0.0)
    array.push(activeTradeQtyLeft, 1.0)
    lastSignalDirection := direction
    lastSignalSetup := setup
    lastSigConf := conf
    while array.size(activeTradeId) > maxTrackedSigs
        array.shift(activeTradeId), array.shift(activeTradeST)
        array.shift(activeTradeDir), array.shift(activeTradeEnt)
        array.shift(activeTradeSL), array.shift(activeTradeTP)
        array.shift(activeTradeRR), array.shift(activeTradeBar)
        array.shift(activeTradeConf), array.shift(activeTradeTP1)
        array.shift(activeTradeBE)
        array.shift(activeTradeRisk), array.shift(activeTradeTP1Done)
        array.shift(activeTradeRealizedR), array.shift(activeTradeQtyLeft)

// Resolve open trades (with BE move, time stop, close alerts)
if array.size(activeTradeId) > 0
    int idx = array.size(activeTradeId) - 1
    while idx >= 0
        openBar = array.get(activeTradeBar, idx)
        if bar_index > openBar
            dir = array.get(activeTradeDir, idx)
            isLong = dir == "LONG"
            entryLvl = array.get(activeTradeEnt, idx)
            stopLvl = array.get(activeTradeSL, idx)
            tgtLvl  = array.get(activeTradeTP, idx)
            tp1Lvl  = array.get(activeTradeTP1, idx)
            tradeRR = array.get(activeTradeRR, idx)
            beLvl   = array.get(activeTradeBE, idx)
            baseRisk = array.get(activeTradeRisk, idx)
            tp1Done = array.get(activeTradeTP1Done, idx)
            realizedR = array.get(activeTradeRealizedR, idx)
            qtyLeft = array.get(activeTradeQtyLeft, idx)

            // Move-to-BE check: if price has reached moveToBEatR level
            partialEnabled = riskMode == "multiRR" and tp1Lvl != tgtLvl and partial1Pct > 0
            tp1Reached = partialEnabled and not tp1Done and ((isLong and high >= tp1Lvl) or (not isLong and low <= tp1Lvl))
            if tp1Reached and baseRisk > syminfo.mintick
                tp1RValue = math.abs(tp1Lvl - entryLvl) / baseRisk
                realizedR += tp1RValue * (partial1Pct / 100.0)
                qtyLeft := math.max(0.0, 1.0 - partial1Pct / 100.0)
                tp1Done := true
                array.set(activeTradeTP1Done, idx, true)
                array.set(activeTradeRealizedR, idx, realizedR)
                array.set(activeTradeQtyLeft, idx, qtyLeft)

            beThresholdPrice = isLong ? entryLvl + baseRisk * moveToBEatR : entryLvl - baseRisk * moveToBEatR
            if na(beLvl) and ((isLong and high >= beThresholdPrice) or (not isLong and low <= beThresholdPrice))
                beLvl := entryLvl
                array.set(activeTradeBE, idx, entryLvl)
                array.set(activeTradeSL, idx, entryLvl)
                stopLvl := entryLvl

            // Time stop check
            barsSinceEntry = bar_index - openBar
            tfMinutes = math.max(timeframe.in_seconds() / 60, 1)
            minutesSinceEntry = barsSinceEntry * tfMinutes
            timeStopHit = useTimeStop and minutesSinceEntry >= timeStopMins

            won  = isLong ? high >= tgtLvl : low <= tgtLvl
            lost = isLong ? low <= stopLvl : high >= stopLvl

            if won or lost or timeStopHit
                sameBarConflict = won and lost
                stopComponentR = math.abs(stopLvl - entryLvl) <= syminfo.mintick ? 0.0 : -1.0
                timeStopR = baseRisk > syminfo.mintick ? (isLong ? (close - entryLvl) / baseRisk : (entryLvl - close) / baseRisk) : 0.0
                pnlR = sameBarConflict or lost ? realizedR + qtyLeft * stopComponentR :
                     won ? realizedR + qtyLeft * tradeRR :
                     realizedR + qtyLeft * timeStopR
                totalTrades += 1
                // Adaptive tracking
                recentTotal := math.min(recentTotal + 1, adaptiveWindow)
                if pnlR > 0
                    totalWins += 1
                    totalR += pnlR
                    adaptiveLossStreak := 0
                    recentWins := math.min(recentWins + 1, adaptiveWindow)
                else if pnlR < 0
                    totalLoss += 1
                    totalR += pnlR
                    adaptiveLossStreak += 1
                    // Trigger cooldown after consecutive losses
                    if adaptiveLossStreak >= cooldownLossTrig
                        cooldownUntilBar := bar_index + cooldownBase
                else
                    totalR += pnlR
                    adaptiveLossStreak := 0

                closeReason = sameBarConflict or lost ? "SL" : won ? "TP" : "TIME"
                lastCloseReason := closeReason
                lastCloseTradeId := array.get(activeTradeId, idx)
                lastCloseEntry := entryLvl
                lastClosePnlR := pnlR
                lastCloseSetup := array.get(activeTradeST, idx)

                array.remove(activeTradeId, idx), array.remove(activeTradeST, idx)
                array.remove(activeTradeDir, idx), array.remove(activeTradeEnt, idx)
                array.remove(activeTradeSL, idx), array.remove(activeTradeTP, idx)
                array.remove(activeTradeRR, idx), array.remove(activeTradeBar, idx)
                array.remove(activeTradeConf, idx), array.remove(activeTradeTP1, idx)
                array.remove(activeTradeBE, idx)
                array.remove(activeTradeRisk, idx), array.remove(activeTradeTP1Done, idx)
                array.remove(activeTradeRealizedR, idx), array.remove(activeTradeQtyLeft, idx)
        idx -= 1

// ═══════════════════════════════════════════════════════════════
//  20. TRADE ZONE BOXES (TP/SL drawn ONLY on execution trigger)
// ═══════════════════════════════════════════════════════════════
// State model for trade visualization:
//   1. Setup detected, execution zone known → pending zone shown (section 20b)
//   2. Price enters execution zone (FVG retracement) → candidate becomes valid
//   3. Priority engine selects winner → finalBuy/finalSell fires
//   4. ONLY THEN are TP/SL trade boxes drawn here
// TP/SL boxes are NEVER drawn for pending setups that haven't triggered.
var box[]  trdBoxes = array.new_box(0)
var line[] trdLines = array.new_line(0)
var label[] trdLabels = array.new_label(0)

clearTradeDrawings() =>
    clearBoxArray(trdBoxes)
    clearLineArray(trdLines)
    clearLabelArray(trdLabels)

drawTradeBoxes(entryPrice, slPrice, tp1Price, tp2Price, isBull, entryBarIdx, entryText) =>
    slBg  = color.new(bearCol, 82), slBrd  = color.new(bearCol, 45)
    tp1Bg = color.new(bullCol, 76), tp1Brd = color.new(bullCol, 38)
    tp2Bg = color.new(bullCol, 90), tp2Brd = color.new(bullCol, 62)
    ext   = entryBarIdx + tradeExtBars
    if isBull
        array.push(trdBoxes, box.new(entryBarIdx, entryPrice, ext, slPrice, bgcolor = slBg, border_color = slBrd, border_width = 1))
        array.push(trdBoxes, box.new(entryBarIdx, tp1Price, ext, entryPrice, bgcolor = tp1Bg, border_color = tp1Brd, border_width = 1))
        if tp2Price != tp1Price
            array.push(trdBoxes, box.new(entryBarIdx, tp2Price, ext, tp1Price, bgcolor = tp2Bg, border_color = tp2Brd, border_style = line.style_dashed, border_width = 1))
    else
        array.push(trdBoxes, box.new(entryBarIdx, slPrice, ext, entryPrice, bgcolor = slBg, border_color = slBrd, border_width = 1))
        array.push(trdBoxes, box.new(entryBarIdx, entryPrice, ext, tp1Price, bgcolor = tp1Bg, border_color = tp1Brd, border_width = 1))
        if tp2Price != tp1Price
            array.push(trdBoxes, box.new(entryBarIdx, tp1Price, ext, tp2Price, bgcolor = tp2Bg, border_color = tp2Brd, border_style = line.style_dashed, border_width = 1))
    array.push(trdLines, line.new(entryBarIdx, entryPrice, ext, entryPrice, color = color.new(color.white, 30), style = line.style_solid, width = 1))
    array.push(trdLines, line.new(entryBarIdx, slPrice, ext, slPrice, color = color.new(bearCol, 15), style = line.style_dashed, width = 1))
    array.push(trdLines, line.new(entryBarIdx, tp1Price, ext, tp1Price, color = color.new(bullCol, 20), style = line.style_dotted, width = 1))
    if tp2Price != tp1Price
        array.push(trdLines, line.new(entryBarIdx, tp2Price, ext, tp2Price, color = color.new(bullCol, 5), style = line.style_dashed, width = 2))
    array.push(trdLabels, label.new(entryBarIdx, entryPrice, entryText,
         style = isBull ? label.style_label_up : label.style_label_down,
         color = color.new(execZoneCol, 68), textcolor = color.white, size = size.tiny))

if showExecZone
    if finalBuy and hasStratSignal and not na(sigSL) and not na(sigTP1) and not na(sigTP2)
        drawTradeBoxes(sigEntry, sigSL, sigTP1, sigTP2, true, nz(sigEntryBar, bar_index), "Entry · " + sigEntrySrc)

    if finalSell and hasStratSignal and not na(sigSL) and not na(sigTP1) and not na(sigTP2)
        drawTradeBoxes(sigEntry, sigSL, sigTP1, sigTP2, false, nz(sigEntryBar, bar_index), "Entry · " + sigEntrySrc)

    if fvgBuySignal and not hasStratSignal and not na(fvgBuySL) and not na(fvgBuyTP1) and not na(fvgBuyTP)
        drawTradeBoxes(fvgBuyEntry, fvgBuySL, fvgBuyTP1, fvgBuyTP, true, nz(fvgBuyEntryBar, bar_index), "Entry · STANDALONE_FVG")

    if fvgSellSignal and not hasStratSignal and not na(fvgSellSL) and not na(fvgSellTP1) and not na(fvgSellTP)
        drawTradeBoxes(fvgSellEntry, fvgSellSL, fvgSellTP1, fvgSellTP, false, nz(fvgSellEntryBar, bar_index), "Entry · STANDALONE_FVG")

    trimBoxArray(trdBoxes, maxDrawnTrades * 3)
    trimLineArray(trdLines, maxDrawnTrades * 4)
    trimLabelArray(trdLabels, maxDrawnTrades)
else
    clearTradeDrawings()

// ═══════════════════════════════════════════════════════════════
//  20b. EXECUTION ZONE RENDERING (pending zone vs triggered trade)
// ═══════════════════════════════════════════════════════════════
// Pending visuals remain explicitly projected. Triggered visuals only appear after the real touch.
var box execBox = na
var line raidRefLine = na
var label raidRefLbl = na
var label execEntryLbl = na
var box[] projectedPlanBoxes = array.new_box(0)
var line[] projectedPlanLines = array.new_line(0)
var label[] projectedPlanLabels = array.new_label(0)
var label[] pendingStateLabels = array.new_label(0)

clearProjectedPlanDrawings() =>
    clearBoxArray(projectedPlanBoxes)
    clearLineArray(projectedPlanLines)
    clearLabelArray(projectedPlanLabels)

clearPendingStateMarkers() =>
    clearLabelArray(pendingStateLabels)

drawPendingStateMarker(string setupState, int stratIdx, bool isBull, float markerPrice) =>
    if showPendingSetupMarker
        markerStyle = label.style_label_left
        markerColor = setupState == "ARMED" ? color.new(execZoneCol, 58) : color.new(color.silver, 72)
        marker = label.new(bar_index, markerPrice, pendingMarkerText(setupState, stratIdx),
             style = markerStyle, color = markerColor,
             textcolor = color.white, size = size.tiny)
        array.push(pendingStateLabels, marker)

drawProjectedPlan(int stratIdx, bool isBull, int leftBar, float zoneHi, float zoneLo, float entryPrice, float slPrice, float tp1Price, float tp2Price, string entrySrc) =>
    // Projected trade plan rendering stays advisory: lighter styling, dashed levels, and explicit plan labels.
    int leftIdx = nz(leftBar, bar_index)
    int rightIdx = bar_index + 6
    color zoneBorder = color.new(execZoneCol, projectedPlanBorderOpacity())
    color zoneFill = color.new(execZoneCol, projectedPlanFillOpacity())
    if projectedPlanStyle != "Minimal"
        array.push(projectedPlanBoxes, box.new(leftIdx, zoneHi, rightIdx, zoneLo,
             bgcolor = zoneFill, border_color = zoneBorder, border_style = projectedPlanBorderStyle(), border_width = 1))
    array.push(projectedPlanLines, line.new(leftIdx, entryPrice, rightIdx, entryPrice,
         color = color.new(color.white, 46), style = projectedPlanBorderStyle(), width = 1))
    array.push(projectedPlanLines, line.new(leftIdx, slPrice, rightIdx, slPrice,
         color = color.new(bearCol, 44), style = projectedPlanBorderStyle(), width = 1))
    array.push(projectedPlanLines, line.new(leftIdx, tp1Price, rightIdx, tp1Price,
         color = color.new(bullCol, 42), style = projectedPlanBorderStyle(), width = 1))
    if tp2Price != tp1Price
        array.push(projectedPlanLines, line.new(leftIdx, tp2Price, rightIdx, tp2Price,
             color = color.new(bullCol, 28), style = projectedPlanBorderStyle(), width = 1))
    array.push(projectedPlanLabels, label.new(leftIdx, entryPrice, "Plan · S" + str.tostring(stratIdx) + " · " + entryPlanLabel(entrySrc, "FVG"),
         style = isBull ? label.style_label_up : label.style_label_down,
         color = color.new(execZoneCol, 78), textcolor = color.white, size = size.tiny))

if not showExecZone
    if not na(execBox)
        box.delete(execBox)
        execBox := na
    if not na(raidRefLine)
        line.delete(raidRefLine)
        raidRefLine := na
    if not na(raidRefLbl)
        label.delete(raidRefLbl)
        raidRefLbl := na
    if not na(execEntryLbl)
        label.delete(execEntryLbl)
        execEntryLbl := na
    clearProjectedPlanDrawings()
    clearPendingStateMarkers()
else
    clearProjectedPlanDrawings()
    clearPendingStateMarkers()
    if activePlanStrat > 0 and activePlanState == "ARMED"
        if showProjectedTradePlan and not na(activePlanZoneHi) and not na(activePlanZoneLo) and not na(activePlanEntry)
            drawProjectedPlan(activePlanStrat, activePlanBull, setupArmedBarIndex, activePlanZoneHi, activePlanZoneLo, activePlanEntry, activePlanSL, activePlanTP1, activePlanTP2, activePlanEntrySrc)
        if showArmedState
            drawPendingStateMarker("ARMED", activePlanStrat, activePlanBull, signalAnchorPrice(activePlanBull, activePlanEntry, activePlanZoneHi, activePlanZoneLo))
    else if activePlanStrat > 0 and activePlanState == "CANDIDATE" and showCandidateState
        markerPrice = not na(activePlanRaidLvl) ? activePlanRaidLvl : close
        drawPendingStateMarker("CANDIDATE", activePlanStrat, activePlanBull, markerPrice)

if (finalBuy or finalSell) and showExecZone
    if not na(execBox)
        box.delete(execBox)
        execBox := na
    clearProjectedPlanDrawings()
    clearPendingStateMarkers()
    if not na(raidRefLine)
        line.delete(raidRefLine)
        raidRefLine := na
    if not na(raidRefLbl)
        label.delete(raidRefLbl)
        raidRefLbl := na
    if not na(execEntryLbl)
        label.delete(execEntryLbl)
        execEntryLbl := na
    if hasStratSignal and not na(sigZoneHi) and not na(sigZoneLo) and not na(entryBarIndex)
        execBox := box.new(entryBarIndex, sigZoneHi, entryBarIndex + 10, sigZoneLo,
             bgcolor = color.new(execZoneCol, 78), border_color = color.new(execZoneCol, 15), border_width = 2)
        execEntryLbl := label.new(entryBarIndex, entryPriceLogic, "Entry " + sigEntrySrc,
             style = sigBull ? label.style_label_up : label.style_label_down,
             color = color.new(execZoneCol, 68), textcolor = color.white, size = size.tiny)
        if not na(sigRaidLvl)
            raidRefLine := line.new(math.max(0, entryBarIndex - 5), sigRaidLvl, entryBarIndex + 10, sigRaidLvl,
                 color = color.new(sigBull ? bullCol : bearCol, 30), style = line.style_solid, width = 2)
            raidRefLbl := label.new(math.max(0, entryBarIndex - 5), sigRaidLvl, sigRaidSrc + " sweep",
                 style = sigBull ? label.style_label_up : label.style_label_down,
                 color = color.new(sigBull ? bullCol : bearCol, 70), textcolor = color.white, size = size.tiny)

if not na(execBox) and showExecZone
    box.set_right(execBox, bar_index + 5)
if not na(raidRefLine) and showExecZone
    line.set_x2(raidRefLine, bar_index + 5)

if barstate.islast
    drawPDHPDL()
    drawEqhEql()
    drawSessionHL()

// ═══════════════════════════════════════════════════════════════
//  21. SIGNAL LABELS (truthful sweep sources)
// ═══════════════════════════════════════════════════════════════
var line[] sweepMarkerLines = array.new_line(0)
var label[] sweepMarkerLabels = array.new_label(0)
var label[] finalSignalLabels = array.new_label(0)

clearSweepMarkers() =>
    clearLineArray(sweepMarkerLines)
    clearLabelArray(sweepMarkerLabels)

drawFinalSignalLabel(int stratIdx, bool isBull, int score, float entryPrice, float zoneHi, float zoneLo, int anchorBar) =>
    labelColor = showSignalDirectionColor ? (isBull ? bullCol : bearCol) : gradeColor(score)
    anchorPrice = signalAnchorPrice(isBull, entryPrice, zoneHi, zoneLo)
    marker = label.new(nz(anchorBar, bar_index), anchorPrice, signalText(stratIdx, isBull, score),
         style = isBull ? label.style_label_up : label.style_label_down,
         color = color.new(labelColor, signalLabelMode == "Full" ? 12 : 24),
         textcolor = color.white, size = signalLabelSizeValue())
    array.push(finalSignalLabels, marker)
    trimLabelArray(finalSignalLabels, maxDrawnTrades * 3)

drawStandaloneSignalLabel(bool isBull, int score, float entryPrice, int anchorBar) =>
    marker = label.new(nz(anchorBar, bar_index), entryPrice, isBull ? "FVG-B" : "FVG-S",
         style = isBull ? label.style_label_up : label.style_label_down,
         color = color.new(fvgCol, 22), textcolor = color.white, size = signalLabelSizeValue())
    array.push(finalSignalLabels, marker)
    trimLabelArray(finalSignalLabels, maxDrawnTrades * 3)

drawSweepMarker(bool isBull, float raidLevel, string raidText) =>
    if not na(raidLevel) and raidText != ""
        markerLine = line.new(bar_index, raidLevel, bar_index + 4, raidLevel,
             color = color.new(isBull ? bullCol : bearCol, 35), style = line.style_dotted, width = 1)
        markerLabel = label.new(bar_index, isBull ? low - atr14 * 0.15 : high + atr14 * 0.15,
             (isBull ? "↑ " : "↓ ") + raidText,
             style = isBull ? label.style_label_up : label.style_label_down,
             color = color.new(isBull ? bullCol : bearCol, 60), textcolor = color.white, size = size.tiny)
        array.push(sweepMarkerLines, markerLine)
        array.push(sweepMarkerLabels, markerLabel)
        trimLineArray(sweepMarkerLines, 30)
        trimLabelArray(sweepMarkerLabels, 30)

if finalBuy and hasStratSignal
    drawFinalSignalLabel(sigStrat, true, sigScore, sigEntry, sigZoneHi, sigZoneLo, sigEntryBar)

if finalSell and hasStratSignal
    drawFinalSignalLabel(sigStrat, false, sigScore, sigEntry, sigZoneHi, sigZoneLo, sigEntryBar)

// FVG standalone signals
if fvgBuySignal and not hasStratSignal
    drawStandaloneSignalLabel(true, fvgBuyScore, fvgBuyEntry, fvgBuyEntryBar)

if fvgSellSignal and not hasStratSignal
    drawStandaloneSignalLabel(false, fvgSellScore, fvgSellEntry, fvgSellEntryBar)

if showSweepMarks
    if anyBullRaid
        drawSweepMarker(true, curBullRaidLvl, curBullRaidSrc)
    if anyBearRaid
        drawSweepMarker(false, curBearRaidLvl, curBearRaidSrc)
else
    clearSweepMarkers()

// MSS markers
if bullMSSActive and bullMSSBar == bar_index
    label.new(bar_index, low - atr14 * 0.35, "MSS▲",
         style = label.style_label_up, color = color.new(bullCol, 40), textcolor = color.white, size = size.tiny)

if bearMSSActive and bearMSSBar == bar_index
    label.new(bar_index, high + atr14 * 0.35, "MSS▼",
         style = label.style_label_down, color = color.new(bearCol, 40), textcolor = color.white, size = size.tiny)

// SMT divergence markers
if smtEn and smtBullDiv and not na(smtDivBar) and smtDivBar == bar_index
    label.new(bar_index, low - atr14 * 0.50, "SMT▲",
         style = label.style_label_up, color = color.new(smtCol, 20), textcolor = color.white, size = size.tiny)

if smtEn and smtBearDiv and not na(smtDivBar) and smtDivBar == bar_index
    label.new(bar_index, high + atr14 * 0.50, "SMT▼",
         style = label.style_label_down, color = color.new(smtCol, 20), textcolor = color.white, size = size.tiny)

// ═══════════════════════════════════════════════════════════════
//  22. ALERTS (SIGNAL_OPEN + SIGNAL_CLOSE)
// ═══════════════════════════════════════════════════════════════
buildPayload(setup, dir, entry, sl, tp, score, eventType) =>
    "{" +
     "\"schemaVersion\":\"2.0\"," +
     "\"eventType\":" + jsonStr(eventType) + "," +
     "\"symbol\":" + jsonStr(syminfo.tickerid) + "," +
     "\"timeframe\":" + jsonStr(normalizeTimeframeId(timeframe.period)) + "," +
     "\"timestamp\":" + str.tostring(time_close) + "," +
     "\"setupType\":" + jsonStr(setup) + "," +
     "\"direction\":" + jsonStr(dir) + "," +
     "\"entry\":" + jsonNum(entry) + "," +
     "\"stopLoss\":" + jsonNum(sl) + "," +
     "\"takeProfit\":" + jsonNum(tp) + "," +
     "\"confluenceScore\":" + str.tostring(score) + "," +
     "\"regime\":" + jsonStr(regime.name) + "," +
     "\"htfBias\":" + jsonStr(htfBias) + "," +
     "\"timeBasis\":" + jsonStr(timeBasis) + "," +
     "\"executionMode\":" + jsonStr(executionMode) + "," +
     "\"riskMode\":" + jsonStr(riskMode) + "," +
     "\"session\":" + jsonStr(inOverlap ? "OVERLAP" : inLondon ? "LONDON" : inNewYork ? "NY" : inTokyo ? "TOKYO" : "OTHER") + "," +
     "\"features\":{" +
         "\"atr\":" + jsonNum(atr14) + "," +
         "\"adx\":" + jsonNum(adxVal) + "," +
         "\"volatilityState\":" + jsonStr(regime.volatilityState) +
     "}," +
     "\"authToken\":" + jsonStr(webhookToken) +
     "}"

if emitOpenAlerts and finalBuy and hasStratSignal
    alert(buildPayload(sigSetupType, "LONG", sigEntry, sigSL, sigTP2, sigScore, "SIGNAL_OPEN"), alert.freq_once_per_bar_close)

if emitOpenAlerts and finalSell and hasStratSignal
    alert(buildPayload(sigSetupType, "SHORT", sigEntry, sigSL, sigTP2, sigScore, "SIGNAL_OPEN"), alert.freq_once_per_bar_close)

if emitOpenAlerts and fvgBuySignal and not hasStratSignal
    alert(buildPayload("FVG_MITIGATION", "LONG", fvgBuyEntry, fvgBuySL, fvgBuyTP, fvgBuyScore, "SIGNAL_OPEN"), alert.freq_once_per_bar_close)

if emitOpenAlerts and fvgSellSignal and not hasStratSignal
    alert(buildPayload("FVG_MITIGATION", "SHORT", fvgSellEntry, fvgSellSL, fvgSellTP, fvgSellScore, "SIGNAL_OPEN"), alert.freq_once_per_bar_close)

// SIGNAL_CLOSE: emitted when a tracked trade resolves
if emitCloseAlerts and lastCloseTradeId != "" and lastCloseReason != "NONE"
    closeDir = lastClosePnlR > 0 ? "WIN" : lastClosePnlR < 0 ? "LOSS" : "BREAKEVEN"
    closePayload = "{" +
         "\"schemaVersion\":\"2.0\"," +
         "\"eventType\":\"SIGNAL_CLOSE\"," +
         "\"tradeId\":" + jsonStr(lastCloseTradeId) + "," +
         "\"symbol\":" + jsonStr(syminfo.tickerid) + "," +
         "\"timeframe\":" + jsonStr(normalizeTimeframeId(timeframe.period)) + "," +
         "\"timestamp\":" + str.tostring(time_close) + "," +
         "\"setupType\":" + jsonStr(lastCloseSetup) + "," +
         "\"closeReason\":" + jsonStr(lastCloseReason) + "," +
         "\"result\":" + jsonStr(closeDir) + "," +
         "\"pnlR\":" + jsonNum(lastClosePnlR) + "," +
         "\"entry\":" + jsonNum(lastCloseEntry) + "," +
         "\"authToken\":" + jsonStr(webhookToken) +
         "}"
    alert(closePayload, alert.freq_once_per_bar_close)
    lastCloseTradeId := ""

// Generic alert conditions
alertcondition(finalBuy, "Buy Signal", "SMC v6 Buy Signal")
alertcondition(finalSell, "Sell Signal", "SMC v6 Sell Signal")
alertcondition(finalBuy or finalSell, "Any Signal", "SMC v6 Signal")

// ═══════════════════════════════════════════════════════════════
//  23. DASHBOARD (toggle-aware, delete when off)
// ═══════════════════════════════════════════════════════════════
wr = totalTrades > 0 ? totalWins * 100.0 / totalTrades : na
wrText = na(wr) ? "–" : str.tostring(wr, "#.#") + "%"
netR = str.tostring(totalR, "#.##") + "R"

activeLifecycleVisible = activePlanStrat > 0 and
     ((activePlanState == "CANDIDATE" and showCandidateState) or
     (activePlanState == "ARMED" and showArmedState) or
     (activePlanState == "TRIGGERED" and showTriggeredState))
activeSetupText = hasStratSignal ? "S" + str.tostring(sigStrat) + (showTriggeredState ? ":TRIGGERED" : "") :
     activeLifecycleVisible ? "S" + str.tostring(activePlanStrat) + ":" + activePlanState :
     hasFvgStandalone ? "FVG" + (showTriggeredState ? ":TRIGGERED" : "") : "IDLE"

displayScore = hasStratSignal ? sigScore :
     activePlanStrat > 0 and activePlanScore > 0 ? activePlanScore :
     hasFvgStandalone ? (fvgBuySignal ? fvgBuyScore : fvgSellScore) :
     na(lastSigConf) ? na : lastSigConf
displayScoreText = na(displayScore) ? "–" : str.tostring(displayScore)

s1StatusText = strat1En ? (s1BullState == 0 and s1BearState == 0 ? "Idle" :
     s1BullState == 1 ? "Candidate▲" : s1BullState == 2 ? "Armed▲" :
     s1BearState == 1 ? "Candidate▼" : s1BearState == 2 ? "Armed▼" : "Active") : "OFF"
s2StatusText = strat2En ? (s2BullRaided ? "Armed▲" : s2BearRaided ? "Armed▼" : inAnySB ? "In Window" : "Waiting") : "OFF"
s3StatusText = strat3En ? (s3State == 0 ? "Idle" : s3State == 1 ? "Candidate" : "Armed") : "OFF"
s4StatusText = strat4En ? (s4State == 0 ? "Idle" : s4State == 1 ? "Candidate" : "Armed") : "OFF"
s5StatusText = strat5En ? (s5BullArmed ? "Armed▲" : s5BearArmed ? "Armed▼" : (smtBullDiv or smtBearDiv) ? "Divergence" : "Monitoring") : "OFF"

lastRaidTxt = lastRaidSource != "" ?
     lastRaidSide + ": " + lastRaidSource + (not na(lastRaidLevel) ? " @ " + str.tostring(lastRaidLevel, format.mintick) : "") :
     "–"
stratStatePrimary = "S1:" + s1StatusText + " | S2:" + s2StatusText
stratStateSecondary = "S3:" + s3StatusText + " | S4:" + s4StatusText + " | S5:" + s5StatusText
qaSelectedStrategy = sigStrat > 0 or hasFvgStandalone ? (sigStrat > 0 ? debugWinner + " (" + sigSetupType + ")" : "FVG_MITIGATION") : lastSelectedStrategy
qaEntryPriceLogic = not na(entryPriceLogic) ? entryPriceLogic : lastEntryPriceLogic
qaEntryBarIndex = not na(entryBarIndex) ? entryBarIndex : lastEntryBarIndex
qaMitigationBarIndex = not na(mitigationBarIndex) ? mitigationBarIndex : lastMitigationBarIndex
qaZoneType = entrySourceZoneType != "" ? entrySourceZoneType : lastEntryZoneType
setupStateText = activeLifecycleVisible ? activePlanState + " · " + (activePlanBull ? "Bull" : "Bear") +
     (activePlanScore > 0 ? " · Score " + str.tostring(activePlanScore) : "") :
     (hasFvgStandalone and showTriggeredState) ? "TRIGGERED · Standalone FVG" : "–"
plannedEntryText = activeLifecycleVisible and not na(activePlanEntry) ? activePlanEntryPlan + " @ " + str.tostring(activePlanEntry, format.mintick) : "–"
plannedRiskText = activeLifecycleVisible and not na(activePlanSL) and not na(activePlanTP1) ?
     "SL " + str.tostring(activePlanSL, format.mintick) + " · TP1 " + str.tostring(activePlanTP1, format.mintick) +
     (not na(activePlanTP2) ? " · TP2 " + str.tostring(activePlanTP2, format.mintick) : "") : "–"
// Dashboard description logic stays opt-in and only surfaces enabled or active strategies.
strategyDescriptionText = describeStrategy ?
     (strategyDescriptionMode == "Enabled Strategies" ? enabledStrategySummary() :
     activeLifecycleVisible ? activePlanDesc :
     sigStrat > 0 ? strategyDescription(sigStrat) :
     "–") : ""
activeSetupColor = activeSetupText == "IDLE" ? color.gray :
     hasStratSignal ? (sigBull ? bullCol : bearCol) :
     activePlanStrat > 0 ? (activePlanBull ? bullCol : bearCol) :
     hasFvgStandalone ? (fvgBuySignal ? bullCol : bearCol) :
     bullCol

var table dash = na

clearDashboard() =>
    if not na(dash)
        table.delete(dash)

drawDashboard() =>
    tbl = table.new(position.bottom_left, 2, 18,
         bgcolor = color.new(color.rgb(8, 10, 28), 5),
         border_width = 1, border_color = color.new(color.white, 78))
    hBg = color.new(color.rgb(15, 18, 55), 0)
    r = 0
    table.cell(tbl, 0, r, "SMC v6 Multi-Strategy", text_color = color.white, text_size = size.small, bgcolor = hBg)
    table.cell(tbl, 1, r, webhookSource, text_color = color.white, text_size = size.small, bgcolor = hBg)
    r += 1
    table.cell(tbl, 0, r, "HTF Bias", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, htfBias + (htfStrong ? " · Strong" : " · Soft"),
         text_color = htfBull ? bullCol : htfBear ? bearCol : color.gray, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Active Setup", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, activeSetupText, text_color = activeSetupColor, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Setup State", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, setupStateText, text_color = activeSetupColor, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Entry Plan", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, plannedEntryText, text_color = activeLifecycleVisible ? color.white : color.gray, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Plan Levels", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, plannedRiskText, text_color = activeLifecycleVisible ? color.new(color.white, 8) : color.gray, text_size = size.small)
    r += 1
    // Confluence interpretation: qualitative label + numeric detail
    confLabel = na(displayScore) ? "–" : getConfluenceLabel(nz(displayScore, 0))
    confText = na(displayScore) ? "–" : confLabel + " (" + str.tostring(nz(displayScore, 0)) + " vs " + str.tostring(effectiveThreshold) + " min)" + (profileMode == "AUTO" ? " · Auto" : "")
    confColor = na(displayScore) ? color.gray : displayScore >= effectiveThreshold ? (confLabel == "Excellent" or confLabel == "Strong" ? bullCol : color.orange) : bearCol
    table.cell(tbl, 0, r, "Confluence", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, confText, text_color = confColor, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Last Raid", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, lastRaidTxt, text_color = lastRaidSide == "BULL" ? bullCol : lastRaidSide == "BEAR" ? bearCol : color.gray, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "S1 / S2", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, stratStatePrimary, text_color = color.new(color.white, 15), text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "S3 / S4 / S5", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, stratStateSecondary, text_color = color.new(color.white, 15), text_size = size.small)
    if describeStrategy
        r += 1
        table.cell(tbl, 0, r, "Strategy Note", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(tbl, 1, r, strategyDescriptionText, text_color = color.new(color.white, 12), text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Session", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, inOverlap ? "LON-NY Overlap" : inLondon ? "London" : inNewYork ? "New York" : inTokyo ? "Tokyo" : inSydney ? "Sydney" : "Off-Session",
         text_color = inOverlap ? color.new(#f59e0b, 0) : inAnySession ? bullCol : color.gray, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Kill Zone", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, inLondonKz ? "London KZ" : inNyAmKz ? "NY AM KZ" : inNyPmKz ? "NY PM KZ" : inAnySB ? "Silver Bullet" : "–",
         text_color = inAnyKz or inAnySB ? bullCol : color.gray, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "PDH / PDL", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, (na(pdh) ? "–" : str.tostring(pdh, format.mintick)) + " / " + (na(pdl) ? "–" : str.tostring(pdl, format.mintick)),
         text_color = color.new(color.white, 20), text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "FVG Zones", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, "Bull:" + str.tostring(array.size(bfHi)) + " Bear:" + str.tostring(array.size(sfHi)),
         text_color = array.size(bfHi) + array.size(sfHi) > 0 ? fvgCol : color.gray, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Win Rate", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, wrText, text_color = na(wr) ? color.gray : wr >= 55 ? bullCol : wr >= 45 ? color.orange : bearCol, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Net R", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, netR, text_color = totalR >= 0 ? bullCol : bearCol, text_size = size.small)
    r += 1
    table.cell(tbl, 0, r, "Trades", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(tbl, 1, r, str.tostring(totalWins) + "W  " + str.tostring(totalLoss) + "L  ·  " + lastCloseReason,
         text_color = color.new(color.white, 30), text_size = size.small)
    tbl

if barstate.islast
    clearDashboard()
    dash := na
    if showDash
        dash := drawDashboard()

// ═══════════════════════════════════════════════════════════════
//  24. DEBUG LABELS (showDebug)
// ═══════════════════════════════════════════════════════════════
var label[] debugSignalLabels = array.new_label(0)
var label lastBarDebugLabel = na

if not showDebug
    clearLabelArray(debugSignalLabels)
    if not na(lastBarDebugLabel)
        label.delete(lastBarDebugLabel)
        lastBarDebugLabel := na

if showDebug and (finalBuy or finalSell)
    dbgTxt = "DEBUG " + (hasStratSignal ? "S" + str.tostring(sigStrat) + " " + sigSetupType : "FVG_MITIGATION") +
         "\nentryPriceLogic: " + (na(entryPriceLogic) ? "na" : str.tostring(entryPriceLogic, format.mintick)) +
         "\nentryBarIndex: " + (na(entryBarIndex) ? "na" : str.tostring(entryBarIndex)) +
         "\nmitigationBarIndex: " + (na(mitigationBarIndex) ? "na" : str.tostring(mitigationBarIndex)) +
         "\nexecutionMode: " + executionMode +
         "\nconfirmed: " + str.tostring(barstate.isconfirmed) +
         "\nzoneType: " + entrySourceZoneType +
         "\nentrySrc: " + (hasStratSignal ? sigEntrySrc : "STANDALONE_FVG") +
         "\nscore: " + str.tostring(hasStratSignal ? sigScore : finalBuy ? fvgBuyScore : fvgSellScore) + "/" + str.tostring(effectiveThreshold) +
         "\nlastRaid: " + lastRaidTxt +
         "\ncandidates: " + (debugCandidates != "" ? debugCandidates : "none") +
         "\nwinner: " + (debugWinner != "" ? debugWinner : "none")
    array.push(debugSignalLabels, label.new(bar_index, finalBuy ? low - atr14 * 1.5 : high + atr14 * 1.5, dbgTxt,
         style = finalBuy ? label.style_label_up : label.style_label_down,
         color = color.new(color.purple, 20), textcolor = color.white, size = size.tiny))
    trimLabelArray(debugSignalLabels, 25)

if showDebug and barstate.islast
    if not na(lastBarDebugLabel)
        label.delete(lastBarDebugLabel)
    lastDbg = "LAST BAR DEBUG" +
         "\nTimeBasis: " + timeBasis + " TZ: " + tzMain +
         "\nSessions: L=" + str.tostring(inLondon) + " NY=" + str.tostring(inNewYork) +
         " T=" + str.tostring(inTokyo) + " S=" + str.tostring(inSydney) +
         "\ninSession=" + str.tostring(inSessionFinal) + " KZ=" + str.tostring(inAnyKz) +
         " SB=" + str.tostring(inAnySB) + " Judas=" + str.tostring(inJudas) +
         "\nentryPriceLogic=" + (na(qaEntryPriceLogic) ? "na" : str.tostring(qaEntryPriceLogic, format.mintick)) +
         " entryBar=" + (na(qaEntryBarIndex) ? "na" : str.tostring(qaEntryBarIndex)) +
         "\nmitBar=" + (na(qaMitigationBarIndex) ? "na" : str.tostring(qaMitigationBarIndex)) +
         " zone=" + qaZoneType +
         "\nLossStreak=" + str.tostring(adaptiveLossStreak) +
         " Cooldown=" + (not na(cooldownUntilBar) and bar_index < cooldownUntilBar ? str.tostring(cooldownUntilBar - bar_index) + "bars" : "none")
    lastBarDebugLabel := label.new(bar_index + 3, close, lastDbg,
         style = label.style_label_left, color = color.new(color.purple, 30), textcolor = color.white, size = size.tiny)

// ═══════════════════════════════════════════════════════════════
//  25. QA MODE TABLE (qaMode)
// ═══════════════════════════════════════════════════════════════
var table qaTable = na

drawQATable() =>
    tbl = table.new(position.top_right, 2, 14,
         bgcolor = color.new(color.rgb(10, 12, 30), 5),
         border_width = 1, border_color = color.new(color.yellow, 60))
    hBg2 = color.new(color.rgb(30, 20, 60), 0)
    qr = 0
    table.cell(tbl, 0, qr, "QA MODE", text_color = color.yellow, text_size = size.small, bgcolor = hBg2)
    table.cell(tbl, 1, qr, "SMC v6", text_color = color.yellow, text_size = size.small, bgcolor = hBg2)
    qr += 1
    table.cell(tbl, 0, qr, "Toggles", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, "Dash:" + str.tostring(showDash) + " Sweep:" + str.tostring(showSweepMarks) +
         " PDH:" + str.tostring(showPDHL) + " EQL:" + str.tostring(showEqlHL) +
         " SessHL:" + str.tostring(showSessionHL) + " Exec:" + str.tostring(showExecZone),
         text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "timeBasis", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, timeBasis + " (" + tzMain + ")", text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "Sessions", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, "L:" + str.tostring(inLondon) + " NY:" + str.tostring(inNewYork) + " T:" + str.tostring(inTokyo) + " S:" + str.tostring(inSydney),
         text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "KZ/SB/Judas", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, "KZ:" + str.tostring(inAnyKz) + " SB:" + str.tostring(inAnySB) + " J:" + str.tostring(inJudas),
         text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "Strategy States", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, stratStatePrimary + " | " + stratStateSecondary, text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "S2 Armed", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, "B:" + str.tostring(s2BullRaided) + " S:" + str.tostring(s2BearRaided), text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "Last Raid", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, lastRaidTxt, text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "Selected", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, qaSelectedStrategy,
         text_color = qaSelectedStrategy != "none" ? bullCol : color.gray, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "Candidates", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, debugCandidates != "" ? debugCandidates : "none", text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "entryPriceLogic", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, na(qaEntryPriceLogic) ? "–" : str.tostring(qaEntryPriceLogic, format.mintick), text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "entryBarIndex", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, na(qaEntryBarIndex) ? "–" : str.tostring(qaEntryBarIndex), text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "mitigationBar", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, na(qaMitigationBarIndex) ? "–" : str.tostring(qaMitigationBarIndex), text_color = color.white, text_size = size.small)
    qr += 1
    table.cell(tbl, 0, qr, "Entry State", text_color = color.new(color.white, 20), text_size = size.small)
    table.cell(tbl, 1, qr, "Ready:" + str.tostring(entryReady) + " Triggered:" + str.tostring(entryTriggered) + " Plan:" + activePlanState + " Zone:" + qaZoneType,
         text_color = entryTriggered ? bullCol : color.white, text_size = size.small)
    tbl

if barstate.islast
    if not na(qaTable)
        table.delete(qaTable)
        qaTable := na
    if qaMode
        qaTable := drawQATable()
