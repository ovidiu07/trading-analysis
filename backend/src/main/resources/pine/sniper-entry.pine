     tooltip = "Number of recent trades used to compute adaptive win rate.")
adaptiveMaxShift = input.int(8, "Max Confidence Shift", minval = 2, maxval = 16, group = grpAdaptive,
     tooltip = "Max adjustment to score threshold in AUTO mode based on recent performance.")
cooldownLossTrig = input.int(2, "Cooldown After N Losses", minval = 2, maxval = 5, group = grpAdaptive,
     tooltip = "After this many consecutive losses, suppress signals for cooldownBase bars.")
cooldownBase    = input.int(12, "Cooldown Base (bars)", minval = 3, maxval = 60, group = grpAdaptive)
maxTrackedSigs  = input.int(36, "Max Tracked Signals", minval = 8, maxval = 64, group = grpAdaptive)

// ── Webhook ──────────────────────────────────────────────────
emitOpenAlerts  = input.bool(true, "Emit SIGNAL_OPEN Alerts", group = grpWebhook)
emitCloseAlerts = input.bool(false, "Emit SIGNAL_CLOSE Alerts", group = grpWebhook,
     tooltip = "Emits alert when tracked trade hits SL or TP.")
webhookToken    = input.string("", "Webhook Auth Token", group = grpWebhook)
webhookSource   = input.string("TRADEJAUDIT_PINE_V2", "Webhook Source Tag", group = grpWebhook)

// ═══════════════════════════════════════════════════════════════
//  TYPES
// ═══════════════════════════════════════════════════════════════
type RegimeState
    string name
    string volatilityState
    float atrRatio
    float adxValue

type TradePlan
    string externalTradeId
    string setupType
    string direction
    string regime
    string profileId
    float entry
    float sl
    float tp
    float tp2
    float rr
    int confidence
    int score

// ═══════════════════════════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════════════════════════
clamp(v, lo, hi) => math.max(lo, math.min(hi, v))

gradeColor(score) =>
    score >= 8 ? color.new(#00c27a, 0) :
     score >= 5 ? color.new(#f5a623, 0) :
     color.new(#9b9b9b, 0)

stratLabel(idx) =>
    idx == 1 ? "RAID→MSS→FVG" :
     idx == 2 ? "SILVER_BULLET" :
     idx == 3 ? "PO3_AMD" :
     idx == 4 ? "JUDAS_SWING" :
     idx == 5 ? "SMT_REVERSAL" : "UNKNOWN"

sanitizeSymbol(s) =>
    str.replace_all(str.replace_all(str.replace_all(s, ":", "_"), ".", "_"), "/", "_")

normalizeTimeframeId(tf) =>
    tf == "1H" ? "60" : tf == "4H" ? "240" : tf == "1D" ? "D" : tf

buildExternalTradeId(setupType, direction, signalTime) =>
    "tv-" + sanitizeSymbol(syminfo.tickerid) + "-" + normalizeTimeframeId(timeframe.period) + "-" + str.tostring(signalTime) + "-" + str.lower(direction) + "-" + str.lower(setupType)

jsonStr(v) => "\"" + v + "\""
jsonNum(v) => na(v) ? "null" : str.tostring(v)

// Execution mode helper
requireConfirmed = executionMode == "Confirmed Close"
barConfirmedOk = not requireConfirmed or barstate.isconfirmed

// ═══════════════════════════════════════════════════════════════
//  1. CORE INDICATORS
// ═══════════════════════════════════════════════════════════════
atr14         = ta.atr(14)
atrMean       = ta.sma(atr14, 50)
bodySize      = math.abs(close - open)
candleRange   = math.max(high - low, syminfo.mintick)
bodyPct       = bodySize / candleRange
bullCandle    = close > open
bearCandle    = close < open
trendEma      = ta.ema(close, 34)
emaSlope      = (trendEma - trendEma[8]) / math.max(atrMean, syminfo.mintick)
stdevClose    = ta.stdev(close, 20)
rsiValue      = ta.rsi(close, rsiLen)

[_, _, adxVal] = ta.dmi(14, 14)

bbBasis       = ta.sma(close, 20)
bbDev         = ta.stdev(close, 20) * 2.0
bbWidth       = (bbDev * 2.0) / math.max(math.abs(bbBasis), syminfo.mintick)
bbWidthMean   = ta.sma(bbWidth, 50)
bbWidthRatio  = bbWidth / math.max(bbWidthMean, syminfo.mintick)

// Regime detection
calcRegime() =>
    atrRat = atr14 / math.max(atrMean, syminfo.mintick)
    trendReady = adxVal >= 23 and math.abs(emaSlope) >= 0.22
    volExp = atrRat >= 1.20 or bbWidthRatio >= 1.15
    volComp = atrRat <= 0.85 and bbWidthRatio <= 0.92
    regName = trendReady and not volExp ? "TREND" :
         volComp ? "VOL_COMPRESS" :
         volExp ? "VOL_EXPAND" : "RANGE"
    volState = atrRat >= 1.15 ? "EXPANDING" : atrRat <= 0.90 ? "COMPRESSING" : "BALANCED"
    RegimeState.new(regName, volState, atrRat, adxVal)

regime = calcRegime()

// TF check
chartTfMins = timeframe.in_seconds() / 60
tfOk = not requireTfCheck or chartTfMins <= executionTfMax

// ═══════════════════════════════════════════════════════════════
//  2. SESSION ENGINE (timezone-aware, UTC-first)
// ═══════════════════════════════════════════════════════════════
// IANA timezone constants
string TZ_LONDON = "Europe/London"
string TZ_NY     = "America/New_York"
string TZ_TOKYO  = "Asia/Tokyo"
string TZ_SYDNEY = "Australia/Sydney"
string TZ_UTC    = "Etc/UTC"

// Resolve timezone per session based on timeBasis
tzForSession(string localTz) =>
    timeBasis == "UTC" ? TZ_UTC :
     timeBasis == "New York (ICT)" ? TZ_NY :
     timeBasis == "Local-per-session" ? localTz :
     customTz  // Custom mode

// Resolve global timezone (for Judas midnight, PO3, daily boundaries)
tzGlobal() =>
    timeBasis == "UTC" ? TZ_UTC :
     timeBasis == "New York (ICT)" ? TZ_NY :
     timeBasis == "Custom" ? customTz :
     TZ_NY  // Local-per-session: use NY for global anchors

string tzLondon = tzForSession(TZ_LONDON)
string tzNy     = tzForSession(TZ_NY)
string tzTokyo  = tzForSession(TZ_TOKYO)
string tzSydney = tzForSession(TZ_SYDNEY)
string tzMain   = tzGlobal()

// Each session interpreted in its resolved timezone (DST-safe via IANA)
inLondon    = londonEn  and not na(time(timeframe.period, londonSess, tzLondon))
inNewYork   = newyorkEn and not na(time(timeframe.period, newyorkSess, tzNy))
inTokyo     = tokyoEn   and not na(time(timeframe.period, tokyoSess, tzTokyo))
inSydney    = sydneyEn  and not na(time(timeframe.period, sydneySess, tzSydney))

// Overlap = true intersection of London AND NY (DST-safe, no separate session string)
inOverlap   = overlapEn and inLondon and inNewYork
inLunch     = excludeLunch and not na(time(timeframe.period, lunchSess, tzNy))

inAnySession = not useSessions or (inLondon or inNewYork or inTokyo or inSydney)
inSessionFinal = inAnySession and not inLunch

// Kill zones — use resolved timezone
inLondonKz  = not na(time(timeframe.period, londonKzSess, tzLondon))
inNyAmKz    = not na(time(timeframe.period, nyAmKzSess, tzNy))
inNyPmKz    = not na(time(timeframe.period, nyPmKzSess, tzNy))
inAnyKz     = inLondonKz or inNyAmKz or inNyPmKz

// Silver Bullet — use resolved timezone
inSbLondon  = not na(time(timeframe.period, sbLondonSess, tzLondon))
inSbNyAm    = not na(time(timeframe.period, sbNyAmSess, tzNy))
inSbNyPm    = not na(time(timeframe.period, sbNyPmSess, tzNy))
inAnySB     = inSbLondon or inSbNyAm or inSbNyPm

// Judas + PO3: use global timezone (follows timeBasis)
inJudas     = not na(time(timeframe.period, judasSess, tzMain))
inPo3Accum  = not na(time(timeframe.period, po3AccumSess, tzMain))
inPo3Manip  = not na(time(timeframe.period, po3ManipSess, tzMain))
inPo3Dist   = not na(time(timeframe.period, po3DistSess, tzMain))

// Session background — uses sessionCol input
sessionBgColor = showSessionBg ? (inOverlap ? color.new(#f59e0b, 92) :
     inLondon ? sessionCol :
     inNewYork ? color.new(#10b981, 96) :
     inTokyo ? color.new(#8b5cf6, 96) :
     inSydney ? color.new(#ec4899, 96) : na) : na
bgcolor(sessionBgColor, title = "Session BG")

// ═══════════════════════════════════════════════════════════════
//  3. HTF BIAS
// ═══════════════════════════════════════════════════════════════
[htfClose, htfEma, htfAtr] = request.security(
     syminfo.tickerid, htfTf,
     [close, ta.ema(close, htfEmaLen), ta.atr(14)],
     lookahead = barmerge.lookahead_off)

htfBull    = htfClose > htfEma
htfBear    = htfClose < htfEma
htfGap     = math.abs(htfClose - htfEma) / math.max(htfAtr, syminfo.mintick)
htfStrong  = htfGap >= 0.40
htfBias    = htfBull ? "BULLISH" : htfBear ? "BEARISH" : "NEUTRAL"
htfBullOk  = not useHtfBias or htfBull
htfBearOk  = not useHtfBias or htfBear

plot(htfEma, "HTF EMA", color = htfBull ? color.new(bullCol, 45) : color.new(bearCol, 45), linewidth = 2)

// ═══════════════════════════════════════════════════════════════
//  4. PIVOT DETECTION (swing highs/lows)
// ═══════════════════════════════════════════════════════════════
pivotH = ta.pivothigh(high, pivotLen, pivotLen)
pivotL = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSwH = na, var float lastSwL = na
var int lastSwHBar = na, var int lastSwLBar = na
var float prevSwH = na, var float prevSwL = na
var int prevSwHBar = na, var int prevSwLBar = na

if not na(pivotH)
    prevSwH    := lastSwH
    prevSwHBar := lastSwHBar
    lastSwH    := pivotH
    lastSwHBar := bar_index - pivotLen
if not na(pivotL)
    prevSwL    := lastSwL
    prevSwLBar := lastSwLBar
    lastSwL    := pivotL
    lastSwLBar := bar_index - pivotLen

bsl = lastSwH  // Buy-Side Liquidity
ssl = lastSwL  // Sell-Side Liquidity

// MSS-specific shorter pivots
mssPivH = ta.pivothigh(high, mssPivotLen, mssPivotLen)
mssPivL = ta.pivotlow(low, mssPivotLen, mssPivotLen)
var float mssLastH = na, var float mssLastL = na
var int mssLastHBar = na, var int mssLastLBar = na

if not na(mssPivH)
    mssLastH    := mssPivH
    mssLastHBar := bar_index - mssPivotLen
if not na(mssPivL)
    mssLastL    := mssPivL
    mssLastLBar := bar_index - mssPivotLen

// ═══════════════════════════════════════════════════════════════
//  5. LIQUIDITY LEVELS
// ═══════════════════════════════════════════════════════════════

// ── Previous Day High/Low (uses global timezone for day boundary) ──
var float pdh = na, var float pdl = na
var float curDayH = na, var float curDayL = na
newDay = ta.change(time("D", "", tzMain)) != 0
if newDay
    pdh := curDayH
    pdl := curDayL
    curDayH := high
    curDayL := low
else
    curDayH := math.max(nz(curDayH, high), high)
    curDayL := math.min(nz(curDayL, low), low)

// PDH/PDL lines — managed for toggle cleanup
var line pdhLine = na, var line pdlLine = na
if barstate.islast
    if not na(pdhLine)
        line.delete(pdhLine)
        pdhLine := na
    if not na(pdlLine)
        line.delete(pdlLine)
        pdlLine := na
    if showPDHL and usePDHL and not na(pdh)
        pdhLine := line.new(bar_index - 50, pdh, bar_index + 5, pdh, color = color.new(bearCol, 50), style = line.style_dashed, width = 1)
        pdlLine := line.new(bar_index - 50, pdl, bar_index + 5, pdl, color = color.new(bullCol, 50), style = line.style_dashed, width = 1)

// ── Session High/Low tracking ────────────────────────────────
var float sessH = na, var float sessL = na
var float prevSessH = na, var float prevSessL = na

bool londonStart  = inLondon  and not inLondon[1]
bool nyStart      = inNewYork and not inNewYork[1]
bool tokyoStart   = inTokyo   and not inTokyo[1]
bool sydneyStart  = inSydney  and not inSydney[1]
sessionStart = londonStart or nyStart or tokyoStart or sydneyStart

if sessionStart
    prevSessH := sessH
    prevSessL := sessL
    sessH := high
    sessL := low
else if inLondon or inNewYork or inTokyo or inSydney
    sessH := math.max(nz(sessH, high), high)
    sessL := math.min(nz(sessL, low), low)

// ── Session H/L line rendering (toggle-aware) ────────────────
var line sessHLine = na, var line sessLLine = na
if barstate.islast
    if not na(sessHLine)
        line.delete(sessHLine)
        sessHLine := na
    if not na(sessLLine)
        line.delete(sessLLine)
        sessLLine := na
    if showSessionHL and useSessionHL and not na(sessH)
        sessHLine := line.new(bar_index - 30, sessH, bar_index + 5, sessH,
             color = color.new(bearCol, 55), style = line.style_dotted, width = 1)
    if showSessionHL and useSessionHL and not na(sessL)
        sessLLine := line.new(bar_index - 30, sessL, bar_index + 5, sessL,
             color = color.new(bullCol, 55), style = line.style_dotted, width = 1)

// ── Equal Highs/Lows Detection ───────────────────────────────
eqlTol = eqlTolMode == "atr" ? atr14 * eqlTolValue : eqlTolValue * syminfo.mintick

var float eqhLevel = na, var int eqhBar = na
var float eqlLevel = na, var int eqlBar = na

if useEqlHL and not na(pivotH) and not na(prevSwH)
    barsApart = not na(prevSwHBar) ? (bar_index - pivotLen) - prevSwHBar : 9999
    if math.abs(pivotH - prevSwH) <= eqlTol and barsApart <= eqlMaxBars
        eqhLevel := (pivotH + prevSwH) / 2.0
        eqhBar   := bar_index

if useEqlHL and not na(pivotL) and not na(prevSwL)
    barsApart = not na(prevSwLBar) ? (bar_index - pivotLen) - prevSwLBar : 9999
    if math.abs(pivotL - prevSwL) <= eqlTol and barsApart <= eqlMaxBars
        eqlLevel := (pivotL + prevSwL) / 2.0
        eqlBar   := bar_index

// ── EQL/EQH line rendering (toggle-aware) ────────────────────
var line eqhLine = na, var line eqlLine2 = na
if barstate.islast
    if not na(eqhLine)
        line.delete(eqhLine)
        eqhLine := na
    if not na(eqlLine2)
        line.delete(eqlLine2)
        eqlLine2 := na
    if showEqlHL and useEqlHL and not na(eqhLevel)
        eqhLine := line.new(nz(eqhBar, bar_index - 20), eqhLevel, bar_index + 5, eqhLevel,
             color = color.new(bearCol, 35), style = line.style_dotted, width = 1)
    if showEqlHL and useEqlHL and not na(eqlLevel)
        eqlLine2 := line.new(nz(eqlBar, bar_index - 20), eqlLevel, bar_index + 5, eqlLevel,
             color = color.new(bullCol, 35), style = line.style_dotted, width = 1)

// ── Premium / Discount Zones ─────────────────────────────────
dealingRangeH = math.max(nz(lastSwH, high), nz(pdh, high))
dealingRangeL = math.min(nz(lastSwL, low), nz(pdl, low))
dealingMid    = (dealingRangeH + dealingRangeL) / 2.0
inPremium     = close > dealingMid
inDiscount    = close < dealingMid
premDiscOk(isBull) => not usePremDisc or (isBull ? inDiscount : inPremium)

// ═══════════════════════════════════════════════════════════════
//  6. FVG DETECTION (3-candle rule)
// ═══════════════════════════════════════════════════════════════
bullFvgRaw = bar_index >= 2 and low > high[2]
bearFvgRaw = bar_index >= 2 and high < low[2]

bullFvgSize = bullFvgRaw ? low - high[2] : 0.0
bearFvgSize = bearFvgRaw ? low[2] - high : 0.0

bullFvgValid = useFvg and bullFvgRaw and bullFvgSize >= atr14 * minFvgSizeAtr
bearFvgValid = useFvg and bearFvgRaw and bearFvgSize >= atr14 * minFvgSizeAtr

// Displacement-quality FVG: the middle candle (candle[1]) must be strong
bullFvgDisp = bullFvgValid and bullCandle[1] and (math.abs(close[1] - open[1]) / math.max(high[1] - low[1], syminfo.mintick)) >= fvgBodyMin
bearFvgDisp = bearFvgValid and bearCandle[1] and (math.abs(close[1] - open[1]) / math.max(high[1] - low[1], syminfo.mintick)) >= fvgBodyMin

// Store latest FVG for strategy use
var float lastBullFvgHi = na, var float lastBullFvgLo = na, var int lastBullFvgBar = na
var float lastBearFvgHi = na, var float lastBearFvgLo = na, var int lastBearFvgBar = na

if bullFvgDisp
    lastBullFvgHi  := low       // proximal
    lastBullFvgLo  := high[2]   // distal
    lastBullFvgBar := bar_index

if bearFvgDisp
    lastBearFvgHi  := low[2]    // distal
    lastBearFvgLo  := high      // proximal
    lastBearFvgBar := bar_index

bullFvgCE = not na(lastBullFvgHi) ? (lastBullFvgHi + lastBullFvgLo) / 2.0 : na
bearFvgCE = not na(lastBearFvgHi) ? (lastBearFvgHi + lastBearFvgLo) / 2.0 : na

// ── Active FVG zone storage (for standalone mitigation signals) ──
var float[] sfHi = array.new_float(0), var float[] sfLo = array.new_float(0)
var float[] sfSize = array.new_float(0), var int[] sfBar = array.new_int(0)
var box[] sfBox = array.new_box(0), var bool[] sfTouched = array.new_bool(0)

var float[] bfHi = array.new_float(0), var float[] bfLo = array.new_float(0)
var float[] bfSize = array.new_float(0), var int[] bfBar = array.new_int(0)
var box[] bfBox = array.new_box(0), var bool[] bfTouched = array.new_bool(0)

// Register bear FVGs
if bearFvgDisp and (not useHtfBias or htfBear) and array.size(sfHi) < maxActiveFvg
    fHi = low[2]
    fLo = high
    newBox = showFvgZones ? box.new(bar_index - 2, fHi, bar_index, fLo,
         bgcolor = color.new(fvgCol, 88), border_color = color.new(fvgCol, 45), border_width = 1) : na
    array.push(sfHi, fHi), array.push(sfLo, fLo), array.push(sfSize, fHi - fLo)
    array.push(sfBar, bar_index), array.push(sfBox, newBox), array.push(sfTouched, false)

// Register bull FVGs
if bullFvgDisp and (not useHtfBias or htfBull) and array.size(bfHi) < maxActiveFvg
    fHi = low
    fLo = high[2]
    newBox = showFvgZones ? box.new(bar_index - 2, fHi, bar_index, fLo,
         bgcolor = color.new(fvgCol, 88), border_color = color.new(fvgCol, 45), border_width = 1) : na
    array.push(bfHi, fHi), array.push(bfLo, fLo), array.push(bfSize, fHi - fLo)
    array.push(bfBar, bar_index), array.push(bfBox, newBox), array.push(bfTouched, false)

// Extend FVG boxes
if showFvgZones and array.size(sfHi) > 0
    for i = 0 to array.size(sfHi) - 1
        b = array.get(sfBox, i)
        if not na(b)
            box.set_right(b, bar_index)
if showFvgZones and array.size(bfHi) > 0
    for i = 0 to array.size(bfHi) - 1
        b = array.get(bfBox, i)
        if not na(b)
            box.set_right(b, bar_index)

// ═══════════════════════════════════════════════════════════════
//  7. DISPLACEMENT DETECTION
// ═══════════════════════════════════════════════════════════════
dispRef = dispMetric == "atr" ? atr14 * dispThreshold : stdevClose * dispThreshold
bullDisplace = bullCandle and bodySize >= dispRef and bodyPct >= 0.55
bearDisplace = bearCandle and bodySize >= dispRef and bodyPct >= 0.55

bullDisplaceOk = not useDispFilter or bullDisplace
bearDisplaceOk = not useDispFilter or bearDisplace

// Volume spike
volAvg = ta.sma(volume, volLookback)
volSpikeOk = not useVolSpike or (volume >= volAvg * volMultiple)

// RSI filter
rsiBullOk = not useRsiFilter or rsiValue <= rsiOS or (rsiValue[1] <= rsiOS and rsiValue > rsiOS)
rsiBearOk = not useRsiFilter or rsiValue >= rsiOB or (rsiValue[1] >= rsiOB and rsiValue < rsiOB)

// ═══════════════════════════════════════════════════════════════
//  8. MARKET STRUCTURE SHIFT (MSS)
// ═══════════════════════════════════════════════════════════════
bullMSS = useMSS and not na(mssLastH) and close > mssLastH and close[1] <= mssLastH
bearMSS = useMSS and not na(mssLastL) and close < mssLastL and close[1] >= mssLastL

var bool bullMSSActive = false, var int bullMSSBar = na, var float bullMSSLevel = na
var bool bearMSSActive = false, var int bearMSSBar = na, var float bearMSSLevel = na

if bullMSS and bullDisplaceOk
    bullMSSActive := true
    bullMSSBar    := bar_index
    bullMSSLevel  := mssLastH

if bearMSS and bearDisplaceOk
    bearMSSActive := true
    bearMSSBar    := bar_index
    bearMSSLevel  := mssLastL

if bullMSSActive and not na(bullMSSBar) and bar_index - bullMSSBar > cancelBars
    bullMSSActive := false
if bearMSSActive and not na(bearMSSBar) and bar_index - bearMSSBar > cancelBars
    bearMSSActive := false

// ═══════════════════════════════════════════════════════════════
//  9. ORDER BLOCK DETECTION (with obDef support)
// ═══════════════════════════════════════════════════════════════
findBullOB() =>
    float obHi = na, float obLo = na
    if obDef == "swingOB"
        // Swing-based OB: use the last swing low candle
        if not na(lastSwLBar)
            offset = bar_index - lastSwLBar
            if offset >= 1 and offset <= obSearchBars * 3
                obHi := math.max(open[offset], close[offset])
                obLo := low[offset]
    else
        // lastOpp: last opposite candle before displacement
        float best = -999.0
        for i = 1 to obSearchBars
            isOpp = close[i] < open[i]
            bAtr = math.abs(open[i] - close[i]) / math.max(atr14[i], syminfo.mintick)
            sc = (isOpp ? 1.0 : -99.0) + bAtr * 0.5 - i * 0.04
            if isOpp and bAtr >= 0.10 and sc > best
                best := sc
                obHi := math.max(open[i], close[i])
                obLo := low[i]
    [obHi, obLo]

findBearOB() =>
    float obHi = na, float obLo = na
    if obDef == "swingOB"
        if not na(lastSwHBar)
            offset = bar_index - lastSwHBar
            if offset >= 1 and offset <= obSearchBars * 3
                obHi := high[offset]
                obLo := math.min(open[offset], close[offset])
    else
        float best = -999.0
        for i = 1 to obSearchBars
            isOpp = close[i] > open[i]
            bAtr = math.abs(open[i] - close[i]) / math.max(atr14[i], syminfo.mintick)
            sc = (isOpp ? 1.0 : -99.0) + bAtr * 0.5 - i * 0.04
            if isOpp and bAtr >= 0.10 and sc > best
                best := sc
                obHi := high[i]
                obLo := math.min(open[i], close[i])
    [obHi, obLo]

// ── OB Zone Rendering (showOBZones toggle) ───────────────────
var box[] obZoneBoxes = array.new_box(0)

if useOB and showOBZones
    if bullDisplace
        [obH, obL] = findBullOB()
        if not na(obH)
            array.push(obZoneBoxes, box.new(bar_index - obSearchBars, obH, bar_index, obL,
                 bgcolor = color.new(bullCol, 90), border_color = color.new(bullCol, 55), border_width = 1, border_style = line.style_dotted))
    if bearDisplace
        [obH, obL] = findBearOB()
        if not na(obH)
            array.push(obZoneBoxes, box.new(bar_index - obSearchBars, obH, bar_index, obL,
                 bgcolor = color.new(bearCol, 90), border_color = color.new(bearCol, 55), border_width = 1, border_style = line.style_dotted))
    // Extend OB boxes
    if array.size(obZoneBoxes) > 0
        for i = 0 to array.size(obZoneBoxes) - 1
            box.set_right(array.get(obZoneBoxes, i), bar_index)
    // Limit OB zone count
    while array.size(obZoneBoxes) > maxActiveFvg * 2
        box.delete(array.shift(obZoneBoxes))

// Clean OB zones when toggle is off
if not showOBZones and array.size(obZoneBoxes) > 0
    while array.size(obZoneBoxes) > 0
        box.delete(array.shift(obZoneBoxes))

// ═══════════════════════════════════════════════════════════════
//  10. LIQUIDITY RAID DETECTION (useLiqPools gated)
// ═══════════════════════════════════════════════════════════════
sweepTol = atr14 * 0.05

// SSL raid (sweep below sell-side liquidity → bullish setup)
sslRaid = useLiqPools and not na(ssl) and low < ssl - sweepTol and close > ssl
pdlRaid = useLiqPools and usePDHL and not na(pdl) and low < pdl - sweepTol and close > pdl
eqlRaid = useLiqPools and useEqlHL and not na(eqlLevel) and low < eqlLevel - sweepTol and close > eqlLevel
prevSessLRaid = useLiqPools and useSessionHL and not na(prevSessL) and low < prevSessL - sweepTol and close > prevSessL
anyBullRaid = sslRaid or pdlRaid or eqlRaid or prevSessLRaid

// BSL raid (sweep above buy-side liquidity → bearish setup)
bslRaid = useLiqPools and not na(bsl) and high > bsl + sweepTol and close < bsl
pdhRaid = useLiqPools and usePDHL and not na(pdh) and high > pdh + sweepTol and close < pdh
eqhRaid = useLiqPools and useEqlHL and not na(eqhLevel) and high > eqhLevel + sweepTol and close < eqhLevel
prevSessHRaid = useLiqPools and useSessionHL and not na(prevSessH) and high > prevSessH + sweepTol and close < prevSessH
anyBearRaid = bslRaid or pdhRaid or eqhRaid or prevSessHRaid

// ── Identify which liquidity source was raided ───────────────
curBullRaidSrc = anyBullRaid ? (eqlRaid ? "EQL" : pdlRaid ? "PDL" : prevSessLRaid ? "SessL" : "SSL") : ""
curBullRaidLvl = anyBullRaid ? (eqlRaid ? eqlLevel : pdlRaid ? pdl : prevSessLRaid ? prevSessL : ssl) : na
curBearRaidSrc = anyBearRaid ? (eqhRaid ? "EQH" : pdhRaid ? "PDH" : prevSessHRaid ? "SessH" : "BSL") : ""
curBearRaidLvl = anyBearRaid ? (eqhRaid ? eqhLevel : pdhRaid ? pdh : prevSessHRaid ? prevSessH : bsl) : na

// Track most recent raid with source provenance
var bool bullRaidPending = false, var int bullRaidBar = na, var float bullRaidLow = na
var string bullRaidSrc = "", var float bullRaidLvl = na
var bool bearRaidPending = false, var int bearRaidBar = na, var float bearRaidHigh = na
var string bearRaidSrc = "", var float bearRaidLvl = na

if anyBullRaid
    bullRaidPending := true
    bullRaidBar     := bar_index
    bullRaidLow     := low
    bullRaidSrc     := curBullRaidSrc
    bullRaidLvl     := curBullRaidLvl

if anyBearRaid
    bearRaidPending := true
    bearRaidBar     := bar_index
    bearRaidHigh    := high
    bearRaidSrc     := curBearRaidSrc
    bearRaidLvl     := curBearRaidLvl

// Expire stale raids
if bullRaidPending and not na(bullRaidBar) and bar_index - bullRaidBar > cancelBars
    bullRaidPending := false
if bearRaidPending and not na(bearRaidBar) and bar_index - bearRaidBar > cancelBars
    bearRaidPending := false

// ═══════════════════════════════════════════════════════════════
//  11. SMT DIVERGENCE DETECTION
// ═══════════════════════════════════════════════════════════════
var bool smtBullDiv = false, var bool smtBearDiv = false
var int smtDivBar = na

if smtEn
    [smtBClose, smtBHigh, smtBLow] = request.security(smtSymbolB, timeframe.period,
         [close, high, low], lookahead = barmerge.lookahead_off)

    smtBPivH = ta.pivothigh(smtBHigh, smtPivotLen, smtPivotLen)
    smtBPivL = ta.pivotlow(smtBLow, smtPivotLen, smtPivotLen)

    var float smtBLastH = na, var float smtBLastL = na

    if not na(smtBPivH)
        smtBLastH := smtBPivH
    if not na(smtBPivL)
        smtBLastL := smtBPivL

    if smtCorr == "positive"
        if not na(pivotH) and not na(lastSwH) and pivotH > prevSwH and not na(smtBLastH) and smtBPivH < smtBLastH
            smtBearDiv := true
            smtDivBar  := bar_index
        if not na(pivotL) and not na(lastSwL) and pivotL < prevSwL and not na(smtBLastL) and smtBPivL > smtBLastL
            smtBullDiv := true
            smtDivBar  := bar_index
    else
        if not na(pivotH) and not na(lastSwH) and pivotH > prevSwH and not na(smtBLastL) and smtBPivL > smtBLastL
            smtBearDiv := true
            smtDivBar  := bar_index
        if not na(pivotL) and not na(lastSwL) and pivotL < prevSwL and not na(smtBLastH) and smtBPivH < smtBLastH
            smtBullDiv := true
            smtDivBar  := bar_index

    if not na(smtDivBar) and bar_index - smtDivBar > smtMaxBars
        smtBullDiv := false
        smtBearDiv := false

// ═══════════════════════════════════════════════════════════════
//  12. CONFLUENCE SCORING ENGINE
// ═══════════════════════════════════════════════════════════════
calcScore(hasLiqRaid, hasMSS, hasFVG, hasOB, inKillZone, hasSMT) =>
    int score = 0
    score += hasLiqRaid ? wLiquidity : 0
    score += hasMSS     ? wMSS      : 0
    score += hasFVG     ? wFVG      : 0
    score += hasOB      ? wOB       : 0
    score += inKillZone ? wSession  : 0
    score += hasSMT     ? wSMT     : 0
    score

// Adaptive threshold computation
var int recentWins = 0, var int recentTotal = 0
adaptiveWR = recentTotal > 0 ? recentWins * 100.0 / recentTotal : 50.0
adaptiveShift = profileMode == "AUTO" ?
     int(clamp((50.0 - adaptiveWR) * adaptiveMaxShift / 50.0, -adaptiveMaxShift, adaptiveMaxShift)) : 0
effectiveThreshold = profileMode == "MANUAL" ?
     math.max(1, int(manualConfThreshold / 10)) :
     math.max(1, scoreThreshold + adaptiveShift)

scorePassesThreshold(score) =>
    not useScoring or score >= effectiveThreshold

// ═══════════════════════════════════════════════════════════════
//  13. PO3 / AMD SESSION TRACKING
// ═══════════════════════════════════════════════════════════════
var float po3AccumH = na, var float po3AccumL = na
var bool po3AccumDone = false
var bool po3ManipDone = false
var bool po3ManipBull = false
var float po3ManipExtreme = na
var int po3ManipBar = na

if inPo3Accum
    if inPo3Accum and not inPo3Accum[1]
        po3AccumH := high
        po3AccumL := low
        po3AccumDone := false
        po3ManipDone := false
    else
        po3AccumH := math.max(nz(po3AccumH, high), high)
        po3AccumL := math.min(nz(po3AccumL, low), low)
    po3AccumDone := true

if strat3En and inPo3Manip and po3AccumDone and not po3ManipDone
    sweepAbove = not na(po3AccumH) and high > po3AccumH + atr14 * 0.05 and close < po3AccumH
    sweepBelow = not na(po3AccumL) and low < po3AccumL - atr14 * 0.05 and close > po3AccumL
    if sweepAbove
        po3ManipDone    := true
        po3ManipBull    := false
        po3ManipExtreme := high
        po3ManipBar     := bar_index
    if sweepBelow
        po3ManipDone    := true
        po3ManipBull    := true
        po3ManipExtreme := low
        po3ManipBar     := bar_index

// ═══════════════════════════════════════════════════════════════
//  14. JUDAS SWING TRACKING (timezone-aware via tzMain)
// ═══════════════════════════════════════════════════════════════
var float judasOpenRef = na
var bool judasRaidDone = false
var bool judasIsBull = false
var float judasExtreme = na
var int judasRaidBar = na

// Midnight reference — uses global timezone
midnightSession = timeBasis == "UTC" ? "0500-0501" :
     timeBasis == "New York (ICT)" ? "0000-0001" :
     "0000-0001"
isMidnight = not na(time(timeframe.period, midnightSession, tzMain))
if isMidnight and (na(judasOpenRef) or isMidnight and not isMidnight[1])
    judasOpenRef  := open
    judasRaidDone := false

if strat4En and inJudas and not na(judasOpenRef) and not judasRaidDone
    if high > judasOpenRef + atr14 * 0.15 and close < judasOpenRef
        judasRaidDone := true
        judasIsBull   := false
        judasExtreme  := high
        judasRaidBar  := bar_index
    if low < judasOpenRef - atr14 * 0.15 and close > judasOpenRef
        judasRaidDone := true
        judasIsBull   := true
        judasExtreme  := low
        judasRaidBar  := bar_index

// ═══════════════════════════════════════════════════════════════
//  15. CANDIDATE-BASED STRATEGY EVALUATION
// ═══════════════════════════════════════════════════════════════
// Each strategy writes to parallel candidate arrays (index 0-4 = S1-S5).
// Priority engine (section 16) selects the winning candidate.

// Candidate arrays — fresh each bar (no var)
bool[]   cValid    = array.new_bool(5, false)
bool[]   cBull     = array.new_bool(5, false)
float[]  cEntry    = array.new_float(5, na)
float[]  cSL       = array.new_float(5, na)
float[]  cTP1      = array.new_float(5, na)
float[]  cTP2      = array.new_float(5, na)
int[]    cScore    = array.new_int(5, 0)
string[] cSetup    = array.new_string(5, "")
float[]  cZoneHi   = array.new_float(5, na)
float[]  cZoneLo   = array.new_float(5, na)
string[] cRaidSrc  = array.new_string(5, "")
float[]  cRaidLvl  = array.new_float(5, na)
string[] cEntrySrc = array.new_string(5, "")

// ── Helper: compute entry price (FVG CE or proximal edge) ────
calcEntryPrice(isBull, fvgHi, fvgLo) =>
    // fvgHi = proximal for bull, fvgLo = proximal for bear
    fvgCE = (fvgHi + fvgLo) / 2.0
    if fvgUseCE
        [fvgCE, "FVG_CE"]
    else
        lvl = isBull ? fvgHi : fvgLo
        [lvl, "FVG_TOUCH"]

// ── Helper: compute SL/TP using riskMode ─────────────────────
// findStructureTP: find nearest structural level for TP
findStructureTP(isBull, entryPrice) =>
    float tp = na
    if isBull
        if not na(pdh) and pdh > entryPrice and (na(tp) or pdh < tp)
            tp := pdh
        if not na(sessH) and sessH > entryPrice and (na(tp) or sessH < tp)
            tp := sessH
        if not na(eqhLevel) and eqhLevel > entryPrice and (na(tp) or eqhLevel < tp)
            tp := eqhLevel
        if not na(bsl) and bsl > entryPrice and (na(tp) or bsl < tp)
            tp := bsl
    else
        if not na(pdl) and pdl < entryPrice and (na(tp) or pdl > tp)
            tp := pdl
        if not na(sessL) and sessL < entryPrice and (na(tp) or sessL > tp)
            tp := sessL
        if not na(eqlLevel) and eqlLevel < entryPrice and (na(tp) or eqlLevel > tp)
            tp := eqlLevel
        if not na(ssl) and ssl < entryPrice and (na(tp) or ssl > tp)
            tp := ssl
    tp

calcTrade(isBull, entryPrice, raidExtreme, fvgBound) =>
    float sl = na
    float risk = na
    if stopMode == "structure"
        sl := isBull ? raidExtreme - atr14 * stopBuf : raidExtreme + atr14 * stopBuf
    else if stopMode == "atr"
        sl := isBull ? entryPrice - ta.atr(stopAtrLen) * stopAtrMult : entryPrice + ta.atr(stopAtrLen) * stopAtrMult
    else
        sl := isBull ? fvgBound - atr14 * stopBuf : fvgBound + atr14 * stopBuf
    risk := math.abs(entryPrice - sl)
    float tp1 = na
    float tp2 = na
    if riskMode == "fixedRR"
        tp1 := isBull ? entryPrice + risk * rrRatio : entryPrice - risk * rrRatio
        tp2 := tp1
    else if riskMode == "structure"
        structTP = findStructureTP(isBull, entryPrice)
        if not na(structTP)
            tp1 := structTP
            tp2 := structTP
        else
            // Fallback to multiRR if no structure found
            tp1 := isBull ? entryPrice + risk * t1R : entryPrice - risk * t1R
            tp2 := isBull ? entryPrice + risk * t2R : entryPrice - risk * t2R
    else
        // multiRR (default)
        tp1 := isBull ? entryPrice + risk * t1R : entryPrice - risk * t1R
        tp2 := isBull ? entryPrice + risk * t2R : entryPrice - risk * t2R
    riskOk = risk <= maxRiskAtr * atr14 and risk > syminfo.mintick
    [sl, tp1, tp2, risk, riskOk]

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 1: Liquidity Raid → MSS/Displacement → FVG Entry
// ═══════════════════════════════════════════════════════════════
var int s1BullState = 0, var int s1BearState = 0
var int s1BullBar = na, var int s1BearBar = na
var float s1BullRaidLow = na, var float s1BearRaidHigh = na
var float s1BullFvgHi = na, var float s1BullFvgLo = na
var float s1BearFvgHi = na, var float s1BearFvgLo = na
var bool s1BullHasOB = false, var bool s1BearHasOB = false
var float s1BullOBHi = na, var float s1BullOBLo = na
var float s1BearOBHi = na, var float s1BearOBLo = na

if strat1En and tfOk
    // ── BULL path ──
    if s1BullState == 0 and anyBullRaid
        s1BullState   := 1
        s1BullBar     := bar_index
        s1BullRaidLow := low

    if s1BullState == 1 and bullMSS and bullDisplaceOk and volSpikeOk
        hasFvg = not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= 3
        if hasFvg
            s1BullState := 2
            s1BullBar   := bar_index
            s1BullFvgHi := lastBullFvgHi
            s1BullFvgLo := lastBullFvgLo
            if useOB
                [obH, obL] = findBullOB()
                s1BullHasOB := not na(obH)
                s1BullOBHi  := obH
                s1BullOBLo  := obL

    // State 2 → Candidate: Price retraces into FVG
    if s1BullState == 2 and not na(s1BullFvgHi) and not na(s1BullFvgLo)
        priceRetraced = low <= s1BullFvgHi and close >= s1BullFvgLo
        if priceRetraced and inSessionFinal and htfBullOk and premDiscOk(true) and rsiBullOk and barConfirmedOk
            [entryP, entrySrc] = calcEntryPrice(true, s1BullFvgHi, s1BullFvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, s1BullRaidLow, s1BullFvgLo)
            score = calcScore(true, true, true, s1BullHasOB, inAnyKz, smtBullDiv)
            if riskOk and scorePassesThreshold(score)
                array.set(cValid, 0, true)
                array.set(cBull, 0, true)
                array.set(cEntry, 0, entryP)
                array.set(cSL, 0, sl)
                array.set(cTP1, 0, tp1)
                array.set(cTP2, 0, tp2)
                array.set(cScore, 0, score)
                array.set(cSetup, 0, "RAID_MSS_FVG")
                array.set(cZoneHi, 0, s1BullFvgHi)
                array.set(cZoneLo, 0, s1BullFvgLo)
                array.set(cRaidSrc, 0, bullRaidSrc)
                array.set(cRaidLvl, 0, bullRaidLvl)
                array.set(cEntrySrc, 0, entrySrc)

    // Expiry
    if s1BullState > 0 and not na(s1BullBar) and bar_index - s1BullBar > cancelBars
        s1BullState := 0
    if s1BullState > 0 and anyBearRaid
        s1BullState := 0

    // ── BEAR path ──
    if s1BearState == 0 and anyBearRaid
        s1BearState    := 1
        s1BearBar      := bar_index
        s1BearRaidHigh := high

    if s1BearState == 1 and bearMSS and bearDisplaceOk and volSpikeOk
        hasFvg = not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= 3
        if hasFvg
            s1BearState := 2
            s1BearBar   := bar_index
            s1BearFvgHi := lastBearFvgHi
            s1BearFvgLo := lastBearFvgLo
            if useOB
                [obH, obL] = findBearOB()
                s1BearHasOB := not na(obH)
                s1BearOBHi  := obH
                s1BearOBLo  := obL

    if s1BearState == 2 and not na(s1BearFvgHi) and not na(s1BearFvgLo) and not array.get(cValid, 0)
        priceRetraced = high >= s1BearFvgLo and close <= s1BearFvgHi
        if priceRetraced and inSessionFinal and htfBearOk and premDiscOk(false) and rsiBearOk and barConfirmedOk
            [entryP, entrySrc] = calcEntryPrice(false, s1BearFvgHi, s1BearFvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, s1BearRaidHigh, s1BearFvgHi)
            score = calcScore(true, true, true, s1BearHasOB, inAnyKz, smtBearDiv)
            if riskOk and scorePassesThreshold(score)
                array.set(cValid, 0, true)
                array.set(cBull, 0, false)
                array.set(cEntry, 0, entryP)
                array.set(cSL, 0, sl)
                array.set(cTP1, 0, tp1)
                array.set(cTP2, 0, tp2)
                array.set(cScore, 0, score)
                array.set(cSetup, 0, "RAID_MSS_FVG")
                array.set(cZoneHi, 0, s1BearFvgHi)
                array.set(cZoneLo, 0, s1BearFvgLo)
                array.set(cRaidSrc, 0, bearRaidSrc)
                array.set(cRaidLvl, 0, bearRaidLvl)
                array.set(cEntrySrc, 0, entrySrc)

    if s1BearState > 0 and not na(s1BearBar) and bar_index - s1BearBar > cancelBars
        s1BearState := 0
    if s1BearState > 0 and anyBullRaid
        s1BearState := 0

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 2: ICT Silver Bullet
// ═══════════════════════════════════════════════════════════════
var float s2BullFvgHi = na, var float s2BullFvgLo = na, var int s2BullBar = na
var float s2BearFvgHi = na, var float s2BearFvgLo = na, var int s2BearBar = na
var bool s2BullRaided = false, var bool s2BearRaided = false
var float s2BullRaidLow = na, var string s2BullRaidSrc = ""
var float s2BearRaidHigh = na, var string s2BearRaidSrc = ""

if strat2En and tfOk and inAnySB
    if bullFvgDisp and anyBullRaid
        s2BullFvgHi   := lastBullFvgHi
        s2BullFvgLo   := lastBullFvgLo
        s2BullBar     := bar_index
        s2BullRaided  := true
        s2BullRaidLow := low
        s2BullRaidSrc := curBullRaidSrc

    if bearFvgDisp and anyBearRaid
        s2BearFvgHi    := lastBearFvgHi
        s2BearFvgLo    := lastBearFvgLo
        s2BearBar      := bar_index
        s2BearRaided   := true
        s2BearRaidHigh := high
        s2BearRaidSrc  := curBearRaidSrc

    if s2BullRaided and not na(s2BullFvgHi)
        priceRetraced = low <= s2BullFvgHi and close >= s2BullFvgLo
        if priceRetraced and htfBullOk and rsiBullOk and barConfirmedOk
            [entryP, entrySrc] = calcEntryPrice(true, s2BullFvgHi, s2BullFvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, s2BullRaidLow, s2BullFvgLo)
            score = calcScore(true, false, true, false, true, smtBullDiv)
            if riskOk and scorePassesThreshold(score)
                array.set(cValid, 1, true)
                array.set(cBull, 1, true)
                array.set(cEntry, 1, entryP)
                array.set(cSL, 1, sl)
                array.set(cTP1, 1, tp1)
                array.set(cTP2, 1, tp2)
                array.set(cScore, 1, score)
                array.set(cSetup, 1, "SILVER_BULLET")
                array.set(cZoneHi, 1, s2BullFvgHi)
                array.set(cZoneLo, 1, s2BullFvgLo)
                array.set(cRaidSrc, 1, s2BullRaidSrc)
                array.set(cRaidLvl, 1, nz(bullRaidLvl))
                array.set(cEntrySrc, 1, entrySrc)

    if s2BearRaided and not na(s2BearFvgHi) and not array.get(cValid, 1)
        priceRetraced = high >= s2BearFvgLo and close <= s2BearFvgHi
        if priceRetraced and htfBearOk and rsiBearOk and barConfirmedOk
            [entryP, entrySrc] = calcEntryPrice(false, s2BearFvgHi, s2BearFvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, s2BearRaidHigh, s2BearFvgHi)
            score = calcScore(true, false, true, false, true, smtBearDiv)
            if riskOk and scorePassesThreshold(score)
                array.set(cValid, 1, true)
                array.set(cBull, 1, false)
                array.set(cEntry, 1, entryP)
                array.set(cSL, 1, sl)
                array.set(cTP1, 1, tp1)
                array.set(cTP2, 1, tp2)
                array.set(cScore, 1, score)
                array.set(cSetup, 1, "SILVER_BULLET")
                array.set(cZoneHi, 1, s2BearFvgHi)
                array.set(cZoneLo, 1, s2BearFvgLo)
                array.set(cRaidSrc, 1, s2BearRaidSrc)
                array.set(cRaidLvl, 1, nz(bearRaidLvl))
                array.set(cEntrySrc, 1, entrySrc)

if not inAnySB
    s2BullRaided := false
    s2BearRaided := false
    s2BullFvgHi  := na
    s2BearFvgHi  := na

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 3: Power of Three (PO3 / AMD)
// ═══════════════════════════════════════════════════════════════
var int s3State = 0
var int s3Bar = na
var float s3FvgHi = na, var float s3FvgLo = na

if strat3En and tfOk
    if s3State == 0 and po3ManipDone and inPo3Manip
        s3State := 1
        s3Bar   := bar_index

    if s3State == 1
        if po3ManipBull and bullMSS and bullDisplaceOk
            hasFvg = not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= 5
            if hasFvg
                s3State  := 2
                s3FvgHi  := lastBullFvgHi
                s3FvgLo  := lastBullFvgLo
                s3Bar    := bar_index
        if not po3ManipBull and bearMSS and bearDisplaceOk
            hasFvg = not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= 5
            if hasFvg
                s3State  := 2
                s3FvgHi  := lastBearFvgHi
                s3FvgLo  := lastBearFvgLo
                s3Bar    := bar_index

    if s3State == 2 and inPo3Dist and not na(s3FvgHi) and not na(s3FvgLo)
        if po3ManipBull
            priceRetraced = low <= s3FvgHi and close >= s3FvgLo
            if priceRetraced and rsiBullOk and barConfirmedOk
                [entryP, entrySrc] = calcEntryPrice(true, s3FvgHi, s3FvgLo)
                [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, nz(po3ManipExtreme, low), s3FvgLo)
                score = calcScore(true, true, true, false, true, smtBullDiv)
                if riskOk and scorePassesThreshold(score)
                    array.set(cValid, 2, true)
                    array.set(cBull, 2, true)
                    array.set(cEntry, 2, entryP)
                    array.set(cSL, 2, sl)
                    array.set(cTP1, 2, tp1)
                    array.set(cTP2, 2, tp2)
                    array.set(cScore, 2, score)
                    array.set(cSetup, 2, "PO3_AMD")
                    array.set(cZoneHi, 2, s3FvgHi)
                    array.set(cZoneLo, 2, s3FvgLo)
                    array.set(cRaidSrc, 2, "PO3_Manip")
                    array.set(cRaidLvl, 2, nz(po3ManipExtreme))
                    array.set(cEntrySrc, 2, entrySrc)
        else
            priceRetraced = high >= s3FvgLo and close <= s3FvgHi
            if priceRetraced and rsiBearOk and barConfirmedOk
                [entryP, entrySrc] = calcEntryPrice(false, s3FvgHi, s3FvgLo)
                [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, nz(po3ManipExtreme, high), s3FvgHi)
                score = calcScore(true, true, true, false, true, smtBearDiv)
                if riskOk and scorePassesThreshold(score)
                    array.set(cValid, 2, true)
                    array.set(cBull, 2, false)
                    array.set(cEntry, 2, entryP)
                    array.set(cSL, 2, sl)
                    array.set(cTP1, 2, tp1)
                    array.set(cTP2, 2, tp2)
                    array.set(cScore, 2, score)
                    array.set(cSetup, 2, "PO3_AMD")
                    array.set(cZoneHi, 2, s3FvgHi)
                    array.set(cZoneLo, 2, s3FvgLo)
                    array.set(cRaidSrc, 2, "PO3_Manip")
                    array.set(cRaidLvl, 2, nz(po3ManipExtreme))
                    array.set(cEntrySrc, 2, entrySrc)

    if s3State > 0 and not na(s3Bar) and bar_index - s3Bar > cancelBars * 2
        s3State := 0

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 4: Judas Swing
// ═══════════════════════════════════════════════════════════════
var int s4State = 0
var int s4Bar = na
var float s4FvgHi = na, var float s4FvgLo = na

if strat4En and tfOk
    if s4State == 0 and judasRaidDone and inJudas
        s4State := 1
        s4Bar   := bar_index

    if s4State == 1
        if judasIsBull and bullMSS and bullDisplaceOk
            hasFvg = not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= 5
            if hasFvg
                s4State := 2
                s4FvgHi := lastBullFvgHi
                s4FvgLo := lastBullFvgLo
                s4Bar   := bar_index
        if not judasIsBull and bearMSS and bearDisplaceOk
            hasFvg = not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= 5
            if hasFvg
                s4State := 2
                s4FvgHi := lastBearFvgHi
                s4FvgLo := lastBearFvgLo
                s4Bar   := bar_index

    if s4State == 2 and not na(s4FvgHi) and not na(s4FvgLo)
        if judasIsBull
            priceRetraced = low <= s4FvgHi and close >= s4FvgLo
            if priceRetraced and inSessionFinal and rsiBullOk and barConfirmedOk
                [entryP, entrySrc] = calcEntryPrice(true, s4FvgHi, s4FvgLo)
                [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, nz(judasExtreme, low), s4FvgLo)
                score = calcScore(true, true, true, false, inAnyKz, smtBullDiv)
                if riskOk and scorePassesThreshold(score)
                    array.set(cValid, 3, true)
                    array.set(cBull, 3, true)
                    array.set(cEntry, 3, entryP)
                    array.set(cSL, 3, sl)
                    array.set(cTP1, 3, tp1)
                    array.set(cTP2, 3, tp2)
                    array.set(cScore, 3, score)
                    array.set(cSetup, 3, "JUDAS_SWING")
                    array.set(cZoneHi, 3, s4FvgHi)
                    array.set(cZoneLo, 3, s4FvgLo)
                    array.set(cRaidSrc, 3, "Judas")
                    array.set(cRaidLvl, 3, nz(judasExtreme))
                    array.set(cEntrySrc, 3, entrySrc)
        else
            priceRetraced = high >= s4FvgLo and close <= s4FvgHi
            if priceRetraced and inSessionFinal and rsiBearOk and barConfirmedOk
                [entryP, entrySrc] = calcEntryPrice(false, s4FvgHi, s4FvgLo)
                [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, nz(judasExtreme, high), s4FvgHi)
                score = calcScore(true, true, true, false, inAnyKz, smtBearDiv)
                if riskOk and scorePassesThreshold(score)
                    array.set(cValid, 3, true)
                    array.set(cBull, 3, false)
                    array.set(cEntry, 3, entryP)
                    array.set(cSL, 3, sl)
                    array.set(cTP1, 3, tp1)
                    array.set(cTP2, 3, tp2)
                    array.set(cScore, 3, score)
                    array.set(cSetup, 3, "JUDAS_SWING")
                    array.set(cZoneHi, 3, s4FvgHi)
                    array.set(cZoneLo, 3, s4FvgLo)
                    array.set(cRaidSrc, 3, "Judas")
                    array.set(cRaidLvl, 3, nz(judasExtreme))
                    array.set(cEntrySrc, 3, entrySrc)

    if s4State > 0 and not na(s4Bar) and bar_index - s4Bar > cancelBars
        s4State := 0

// ═══════════════════════════════════════════════════════════════
//  STRATEGY 5: SMT Divergence Reversal
// ═══════════════════════════════════════════════════════════════
if strat5En and smtEn and tfOk
    if smtBullDiv and anyBullRaid and bullMSS and bullDisplaceOk
        hasFvg = not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= 5
        if hasFvg and inSessionFinal and rsiBullOk and barConfirmedOk
            [entryP, entrySrc] = calcEntryPrice(true, lastBullFvgHi, lastBullFvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(true, entryP, nz(bullRaidLow, low), lastBullFvgLo)
            score = calcScore(true, true, true, false, inAnyKz, true)
            if riskOk and scorePassesThreshold(score)
                array.set(cValid, 4, true)
                array.set(cBull, 4, true)
                array.set(cEntry, 4, entryP)
                array.set(cSL, 4, sl)
                array.set(cTP1, 4, tp1)
                array.set(cTP2, 4, tp2)
                array.set(cScore, 4, score)
                array.set(cSetup, 4, "SMT_REVERSAL")
                array.set(cZoneHi, 4, lastBullFvgHi)
                array.set(cZoneLo, 4, lastBullFvgLo)
                array.set(cRaidSrc, 4, bullRaidSrc)
                array.set(cRaidLvl, 4, bullRaidLvl)
                array.set(cEntrySrc, 4, entrySrc)

    if smtBearDiv and anyBearRaid and bearMSS and bearDisplaceOk and not array.get(cValid, 4)
        hasFvg = not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= 5
        if hasFvg and inSessionFinal and rsiBearOk and barConfirmedOk
            [entryP, entrySrc] = calcEntryPrice(false, lastBearFvgHi, lastBearFvgLo)
            [sl, tp1, tp2, risk, riskOk] = calcTrade(false, entryP, nz(bearRaidHigh, high), lastBearFvgHi)
            score = calcScore(true, true, true, false, inAnyKz, true)
            if riskOk and scorePassesThreshold(score)
                array.set(cValid, 4, true)
                array.set(cBull, 4, false)
                array.set(cEntry, 4, entryP)
                array.set(cSL, 4, sl)
                array.set(cTP1, 4, tp1)
                array.set(cTP2, 4, tp2)
                array.set(cScore, 4, score)
                array.set(cSetup, 4, "SMT_REVERSAL")
                array.set(cZoneHi, 4, lastBearFvgHi)
                array.set(cZoneLo, 4, lastBearFvgLo)
                array.set(cRaidSrc, 4, bearRaidSrc)
                array.set(cRaidLvl, 4, bearRaidLvl)
                array.set(cEntrySrc, 4, entrySrc)

// ═══════════════════════════════════════════════════════════════
//  16. STRATEGY PRIORITY ENGINE
// ═══════════════════════════════════════════════════════════════
// Parse stratPriority string and select first valid candidate.

var int    sigStrat     = 0
var bool   sigBull      = false
var bool   sigBear      = false
var float  sigEntry     = na
var float  sigSL        = na
var float  sigTP1       = na
var float  sigTP2       = na
var int    sigScore     = 0
var string sigSetupType = ""
var float  sigZoneHi    = na
var float  sigZoneLo    = na
var string sigRaidSrc   = ""
var float  sigRaidLvl   = na
var string sigEntrySrc  = ""
var int    sigEntryBar  = na

// Debug: track which candidates were valid and which won
var string debugCandidates = ""
var string debugWinner = ""

// Reset each bar
sigStrat     := 0
sigBull      := false
sigBear      := false
sigEntry     := na
sigSL        := na
sigTP1       := na
sigTP2       := na
sigScore     := 0
sigSetupType := ""
sigZoneHi    := na
sigZoneLo    := na
sigRaidSrc   := ""
sigRaidLvl   := na
sigEntrySrc  := ""
sigEntryBar  := na
debugCandidates := ""
debugWinner := ""

// Build debug string of valid candidates
for ci = 0 to 4
    if array.get(cValid, ci)
        debugCandidates := debugCandidates + (debugCandidates != "" ? "," : "") + "S" + str.tostring(ci + 1)

// Parse priority and select winner
string[] prioParts = str.split(stratPriority, ",")
bool winnerFound = false
for i = 0 to math.min(array.size(prioParts) - 1, 9)
    if not winnerFound
        part = str.replace_all(array.get(prioParts, i), " ", "")
        stratIdx = part == "S1" ? 0 : part == "S2" ? 1 : part == "S3" ? 2 : part == "S4" ? 3 : part == "S5" ? 4 : -1
        if stratIdx >= 0 and stratIdx < 5 and array.get(cValid, stratIdx)
            sigStrat     := stratIdx + 1
            sigBull      := array.get(cBull, stratIdx)
            sigBear      := not array.get(cBull, stratIdx)
            sigEntry     := array.get(cEntry, stratIdx)
            sigSL        := array.get(cSL, stratIdx)
            sigTP1       := array.get(cTP1, stratIdx)
            sigTP2       := array.get(cTP2, stratIdx)
            sigScore     := array.get(cScore, stratIdx)
            sigSetupType := array.get(cSetup, stratIdx)
            sigZoneHi    := array.get(cZoneHi, stratIdx)
            sigZoneLo    := array.get(cZoneLo, stratIdx)
            sigRaidSrc   := array.get(cRaidSrc, stratIdx)
            sigRaidLvl   := array.get(cRaidLvl, stratIdx)
            sigEntrySrc  := array.get(cEntrySrc, stratIdx)
            sigEntryBar  := bar_index
            debugWinner  := "S" + str.tostring(stratIdx + 1)
            winnerFound  := true

// Reset winning strategy state after selection
if sigStrat == 1
    if sigBull
        s1BullState := 0
    else
        s1BearState := 0
else if sigStrat == 2
    if sigBull
        s2BullRaided := false
        s2BullFvgHi  := na
    else
        s2BearRaided := false
        s2BearFvgHi  := na
else if sigStrat == 3
    s3State := 0
else if sigStrat == 4
    s4State := 0
else if sigStrat == 5
    if sigBull
        smtBullDiv := false
    else
        smtBearDiv := false

// ═══════════════════════════════════════════════════════════════
//  17. STANDALONE FVG MITIGATION (fallback when no strategy fires)
// ═══════════════════════════════════════════════════════════════
hasStratSignal = sigStrat > 0

var bool   fvgBuySignal  = false, var bool   fvgSellSignal = false
var float  fvgBuyEntry   = na, var float  fvgBuySL  = na
var float  fvgBuyTP      = na, var float  fvgBuyTP1 = na
var float  fvgSellEntry  = na, var float  fvgSellSL = na
var float  fvgSellTP     = na, var float  fvgSellTP1 = na
var int    fvgBuyScore   = 0, var int    fvgSellScore = 0

fvgBuySignal  := false
fvgSellSignal := false

fvgEntryDepth = 0.30

// Bear FVG zones → SELL signals
if useFvg and array.size(sfHi) > 0 and not hasStratSignal
    int i = 0
    while i < array.size(sfHi)
        fHi = array.get(sfHi, i), fLo = array.get(sfLo, i)
        fAge = bar_index - array.get(sfBar, i)
        touched = array.get(sfTouched, i)

        fullFill = close < fLo - atr14 * 0.20
        if fAge > fvgExpBars or fullFill
            b = array.get(sfBox, i)
            if not na(b)
                box.delete(b)
            array.remove(sfHi, i), array.remove(sfLo, i), array.remove(sfSize, i)
            array.remove(sfBar, i), array.remove(sfBox, i), array.remove(sfTouched, i)
            continue

        priceInZone = high >= fLo and low <= fHi
        priceJustEntered = priceInZone and not touched
        if priceInZone and not touched
            array.set(sfTouched, i, true)

        proximalCeiling = fLo + (fHi - fLo) * fvgEntryDepth
        entryNearProximal = close <= proximalCeiling
        cameFromBelow = low[1] < fLo
        approachUp = (close[1] > open[1]) or (close[2] > open[2])
        potentialSL = fHi + atr14 * stopBuf
        potentialRisk = math.abs(close - potentialSL)
        riskOk = potentialRisk <= maxRiskAtr * atr14
        rejection = bearCandle and bodyPct >= 0.45 and entryNearProximal

        if priceJustEntered and rejection and cameFromBelow and approachUp and riskOk and
             inSessionFinal and htfBearOk and barConfirmedOk
            fvgSellSignal := true
            fvgSellEntry  := close
            fvgSellSL     := potentialSL
            fvgRisk        = potentialRisk
            fvgSellTP     := fvgSellEntry - fvgRisk * rrRatio
            fvgSellTP1    := fvgSellEntry - fvgRisk * t1R
            fvgSellScore  := calcScore(false, false, true, false, inAnyKz, smtBearDiv)
            b = array.get(sfBox, i)
            if not na(b)
                box.delete(b)
            array.remove(sfHi, i), array.remove(sfLo, i), array.remove(sfSize, i)
            array.remove(sfBar, i), array.remove(sfBox, i), array.remove(sfTouched, i)
            break
        i += 1

// Bull FVG zones → BUY signals
if useFvg and array.size(bfHi) > 0 and not hasStratSignal
    int j = 0
    while j < array.size(bfHi)
        fHi = array.get(bfHi, j), fLo = array.get(bfLo, j)
        fAge = bar_index - array.get(bfBar, j)
        touched = array.get(bfTouched, j)

        fullFill = close > fHi + atr14 * 0.20
        if fAge > fvgExpBars or fullFill
            b = array.get(bfBox, j)
            if not na(b)
                box.delete(b)
            array.remove(bfHi, j), array.remove(bfLo, j), array.remove(bfSize, j)
            array.remove(bfBar, j), array.remove(bfBox, j), array.remove(bfTouched, j)
            continue

        priceInZone = low <= fHi and high >= fLo
        priceJustEntered = priceInZone and not touched
        if priceInZone and not touched
            array.set(bfTouched, j, true)

        proximalFloor = fHi - (fHi - fLo) * fvgEntryDepth
        entryNearProximal = close >= proximalFloor
        cameFromAbove = high[1] > fHi
        approachDown = (close[1] < open[1]) or (close[2] < open[2])
        potentialSL = fLo - atr14 * stopBuf
        potentialRisk = math.abs(close - potentialSL)
        riskOk = potentialRisk <= maxRiskAtr * atr14
        rejection = bullCandle and bodyPct >= 0.45 and entryNearProximal

        if priceJustEntered and rejection and cameFromAbove and approachDown and riskOk and
             inSessionFinal and htfBullOk and barConfirmedOk
            fvgBuySignal  := true
            fvgBuyEntry   := close
            fvgBuySL      := potentialSL
            fvgRisk        = potentialRisk
            fvgBuyTP      := fvgBuyEntry + fvgRisk * rrRatio
            fvgBuyTP1     := fvgBuyEntry + fvgRisk * t1R
            fvgBuyScore   := calcScore(false, false, true, false, inAnyKz, smtBullDiv)
            b = array.get(bfBox, j)
            if not na(b)
                box.delete(b)
            array.remove(bfHi, j), array.remove(bfLo, j), array.remove(bfSize, j)
            array.remove(bfBar, j), array.remove(bfBox, j), array.remove(bfTouched, j)
            break
        j += 1

// ═══════════════════════════════════════════════════════════════
//  18. SIGNAL CONSOLIDATION & COOLDOWN
// ═══════════════════════════════════════════════════════════════
hasFvgStandalone = (fvgBuySignal or fvgSellSignal) and not hasStratSignal

// Cooldown: suppress after consecutive losses
var int lastSignalBar = na
var int cooldownUntilBar = na
var int adaptiveLossStreak = 0

signalCooldownOk = na(lastSignalBar) or bar_index - lastSignalBar >= suppressBars
lossCooldownOk = na(cooldownUntilBar) or bar_index >= cooldownUntilBar

finalBuy  = (sigBull or fvgBuySignal) and signalCooldownOk and lossCooldownOk
finalSell = (sigBear or fvgSellSignal) and signalCooldownOk and lossCooldownOk

if finalBuy or finalSell
    lastSignalBar := bar_index

// ═══════════════════════════════════════════════════════════════
//  19. PERFORMANCE TRACKING (with time stop + SIGNAL_CLOSE)
// ═══════════════════════════════════════════════════════════════
var string[] activeTradeId  = array.new_string(0)
var string[] activeTradeST  = array.new_string(0)
var string[] activeTradeDir = array.new_string(0)
var float[]  activeTradeEnt = array.new_float(0)
var float[]  activeTradeSL  = array.new_float(0)
var float[]  activeTradeTP  = array.new_float(0)
var float[]  activeTradeRR  = array.new_float(0)
var int[]    activeTradeBar = array.new_int(0)
var int[]    activeTradeConf = array.new_int(0)
var float[]  activeTradeTP1 = array.new_float(0)
var float[]  activeTradeBE  = array.new_float(0)  // BE level (na until BE triggered)

var int   totalTrades = 0, var int   totalWins = 0, var int totalLoss = 0
var float totalR      = 0.0
var string lastSignalDirection = "NONE"
var string lastSignalSetup = "NONE"
var int   lastSigConf = na
var string lastCloseReason = "NONE"
var string lastCloseTradeId = ""
var float  lastCloseEntry = na
var float  lastClosePnlR = na
var string lastCloseSetup = ""

// Track new signals
if finalBuy
    direction = "LONG"
    setup = hasStratSignal ? sigSetupType : "FVG_MITIGATION"
    entry = hasStratSignal ? sigEntry : fvgBuyEntry
    sl    = hasStratSignal ? sigSL : fvgBuySL
    tp    = hasStratSignal ? sigTP2 : fvgBuyTP
    tp1val = hasStratSignal ? sigTP1 : fvgBuyTP1
    rr    = hasStratSignal ? t2R : rrRatio
    conf  = hasStratSignal ? sigScore : fvgBuyScore
    tradeId = buildExternalTradeId(setup, direction, int(time_close))
    array.push(activeTradeId, tradeId), array.push(activeTradeST, setup)
    array.push(activeTradeDir, direction), array.push(activeTradeEnt, entry)
    array.push(activeTradeSL, sl), array.push(activeTradeTP, tp)
    array.push(activeTradeRR, rr), array.push(activeTradeBar, bar_index)
    array.push(activeTradeConf, conf)
    array.push(activeTradeTP1, tp1val)
    array.push(activeTradeBE, na)
    lastSignalDirection := direction
    lastSignalSetup := setup
    lastSigConf := conf
    while array.size(activeTradeId) > maxTrackedSigs
        array.shift(activeTradeId), array.shift(activeTradeST)
        array.shift(activeTradeDir), array.shift(activeTradeEnt)
        array.shift(activeTradeSL), array.shift(activeTradeTP)
        array.shift(activeTradeRR), array.shift(activeTradeBar)
        array.shift(activeTradeConf), array.shift(activeTradeTP1)
        array.shift(activeTradeBE)

if finalSell
    direction = "SHORT"
    setup = hasStratSignal ? sigSetupType : "FVG_MITIGATION"
    entry = hasStratSignal ? sigEntry : fvgSellEntry
    sl    = hasStratSignal ? sigSL : fvgSellSL
    tp    = hasStratSignal ? sigTP2 : fvgSellTP
    tp1val = hasStratSignal ? sigTP1 : fvgSellTP1
    rr    = hasStratSignal ? t2R : rrRatio
    conf  = hasStratSignal ? sigScore : fvgSellScore
    tradeId = buildExternalTradeId(setup, direction, int(time_close))
    array.push(activeTradeId, tradeId), array.push(activeTradeST, setup)
    array.push(activeTradeDir, direction), array.push(activeTradeEnt, entry)
    array.push(activeTradeSL, sl), array.push(activeTradeTP, tp)
    array.push(activeTradeRR, rr), array.push(activeTradeBar, bar_index)
    array.push(activeTradeConf, conf)
    array.push(activeTradeTP1, tp1val)
    array.push(activeTradeBE, na)
    lastSignalDirection := direction
    lastSignalSetup := setup
    lastSigConf := conf
    while array.size(activeTradeId) > maxTrackedSigs
        array.shift(activeTradeId), array.shift(activeTradeST)
        array.shift(activeTradeDir), array.shift(activeTradeEnt)
        array.shift(activeTradeSL), array.shift(activeTradeTP)
        array.shift(activeTradeRR), array.shift(activeTradeBar)
        array.shift(activeTradeConf), array.shift(activeTradeTP1)
        array.shift(activeTradeBE)

// Resolve open trades (with BE move, time stop, close alerts)
if array.size(activeTradeId) > 0
    int idx = array.size(activeTradeId) - 1
    while idx >= 0
        openBar = array.get(activeTradeBar, idx)
        if bar_index > openBar
            dir = array.get(activeTradeDir, idx)
            isLong = dir == "LONG"
            entryLvl = array.get(activeTradeEnt, idx)
            stopLvl = array.get(activeTradeSL, idx)
            tgtLvl  = array.get(activeTradeTP, idx)
            tp1Lvl  = array.get(activeTradeTP1, idx)
            tradeRR = array.get(activeTradeRR, idx)
            beLvl   = array.get(activeTradeBE, idx)

            // Move-to-BE check: if price has reached moveToBEatR level
            risk = math.abs(entryLvl - stopLvl)
            beThresholdPrice = isLong ? entryLvl + risk * moveToBEatR : entryLvl - risk * moveToBEatR
            if na(beLvl) and ((isLong and high >= beThresholdPrice) or (not isLong and low <= beThresholdPrice))
                beLvl := entryLvl
                array.set(activeTradeBE, idx, entryLvl)
                array.set(activeTradeSL, idx, entryLvl)
                stopLvl := entryLvl

            // Time stop check
            barsSinceEntry = bar_index - openBar
            tfMinutes = math.max(timeframe.in_seconds() / 60, 1)
            minutesSinceEntry = barsSinceEntry * tfMinutes
            timeStopHit = useTimeStop and minutesSinceEntry >= timeStopMins

            won  = isLong ? high >= tgtLvl : low <= tgtLvl
            lost = isLong ? low <= stopLvl : high >= stopLvl

            if won or lost or timeStopHit
                isLoss = lost or timeStopHit or (won and lost)
                pnlR = isLoss ? -1.0 : tradeRR
                totalTrades += 1
                // Adaptive tracking
                recentTotal := math.min(recentTotal + 1, adaptiveWindow)
                if pnlR > 0
                    totalWins += 1
                    totalR += pnlR
                    adaptiveLossStreak := 0
                    recentWins := math.min(recentWins + 1, adaptiveWindow)
                else
                    totalLoss += 1
                    totalR -= 1.0
                    adaptiveLossStreak += 1
                    // Trigger cooldown after consecutive losses
                    if adaptiveLossStreak >= cooldownLossTrig
                        cooldownUntilBar := bar_index + cooldownBase

                closeReason = timeStopHit ? "TIME" : isLoss ? "SL" : "TP"
                lastCloseReason := closeReason
                lastCloseTradeId := array.get(activeTradeId, idx)
                lastCloseEntry := entryLvl
                lastClosePnlR := pnlR
                lastCloseSetup := array.get(activeTradeST, idx)

                array.remove(activeTradeId, idx), array.remove(activeTradeST, idx)
                array.remove(activeTradeDir, idx), array.remove(activeTradeEnt, idx)
                array.remove(activeTradeSL, idx), array.remove(activeTradeTP, idx)
                array.remove(activeTradeRR, idx), array.remove(activeTradeBar, idx)
                array.remove(activeTradeConf, idx), array.remove(activeTradeTP1, idx)
                array.remove(activeTradeBE, idx)
        idx -= 1

// ═══════════════════════════════════════════════════════════════
//  20. TRADE ZONE BOXES (with drawing lifecycle)
// ═══════════════════════════════════════════════════════════════
var box[]  trdBoxes = array.new_box(0)
var line[] trdLines = array.new_line(0)

drawTradeBoxes(entryPrice, slPrice, tp1Price, tp2Price, isBull, entryBarIdx) =>
    slBg  = color.new(bearCol, 82), slBrd  = color.new(bearCol, 45)
    tp1Bg = color.new(bullCol, 76), tp1Brd = color.new(bullCol, 38)
    tp2Bg = color.new(bullCol, 90), tp2Brd = color.new(bullCol, 62)
    ext   = entryBarIdx + tradeExtBars
    // Trade box starts at entryBarIdx (exact entry bar, no +1 offset)
    if isBull
        array.push(trdBoxes, box.new(entryBarIdx, entryPrice, ext, slPrice, bgcolor = slBg, border_color = slBrd, border_width = 1))
        array.push(trdBoxes, box.new(entryBarIdx, tp1Price, ext, entryPrice, bgcolor = tp1Bg, border_color = tp1Brd, border_width = 1))
        if tp2Price != tp1Price
            array.push(trdBoxes, box.new(entryBarIdx, tp2Price, ext, tp1Price, bgcolor = tp2Bg, border_color = tp2Brd, border_style = line.style_dashed, border_width = 1))
    else
        array.push(trdBoxes, box.new(entryBarIdx, slPrice, ext, entryPrice, bgcolor = slBg, border_color = slBrd, border_width = 1))
        array.push(trdBoxes, box.new(entryBarIdx, entryPrice, ext, tp1Price, bgcolor = tp1Bg, border_color = tp1Brd, border_width = 1))
        if tp2Price != tp1Price
            array.push(trdBoxes, box.new(entryBarIdx, tp1Price, ext, tp2Price, bgcolor = tp2Bg, border_color = tp2Brd, border_style = line.style_dashed, border_width = 1))
    array.push(trdLines, line.new(entryBarIdx, entryPrice, ext, entryPrice, color = color.new(color.white, 30), style = line.style_solid, width = 1))
    array.push(trdLines, line.new(entryBarIdx, slPrice, ext, slPrice, color = color.new(bearCol, 15), style = line.style_dashed, width = 1))
    array.push(trdLines, line.new(entryBarIdx, tp1Price, ext, tp1Price, color = color.new(bullCol, 20), style = line.style_dotted, width = 1))
    if tp2Price != tp1Price
        array.push(trdLines, line.new(entryBarIdx, tp2Price, ext, tp2Price, color = color.new(bullCol, 5), style = line.style_dashed, width = 2))

// Strategy signals — use sigEntryBar for exact positioning
if finalBuy and hasStratSignal and not na(sigSL) and not na(sigTP1) and not na(sigTP2)
    drawTradeBoxes(sigEntry, sigSL, sigTP1, sigTP2, true, bar_index)

if finalSell and hasStratSignal and not na(sigSL) and not na(sigTP1) and not na(sigTP2)
    drawTradeBoxes(sigEntry, sigSL, sigTP1, sigTP2, false, bar_index)

// FVG standalone signals
if fvgBuySignal and not hasStratSignal and not na(fvgBuySL) and not na(fvgBuyTP1) and not na(fvgBuyTP)
    drawTradeBoxes(fvgBuyEntry, fvgBuySL, fvgBuyTP1, fvgBuyTP, true, bar_index)

if fvgSellSignal and not hasStratSignal and not na(fvgSellSL) and not na(fvgSellTP1) and not na(fvgSellTP)
    drawTradeBoxes(fvgSellEntry, fvgSellSL, fvgSellTP1, fvgSellTP, false, bar_index)

// Drawing lifecycle: delete oldest when exceeding maxDrawnTrades
while array.size(trdBoxes) > maxDrawnTrades * 3
    box.delete(array.shift(trdBoxes))
while array.size(trdLines) > maxDrawnTrades * 4
    line.delete(array.shift(trdLines))

// ═══════════════════════════════════════════════════════════════
//  20b. EXECUTION ZONE RENDERING (fixed timing)
// ═══════════════════════════════════════════════════════════════
var box execBox = na
var line raidRefLine = na
var label raidRefLbl = na

// Pending execution zone — shows FVG zone while strategy awaits mitigation
bool s1BullPending = s1BullState == 2 and not na(s1BullFvgHi)
bool s1BearPending = s1BearState == 2 and not na(s1BearFvgHi)
bool s3Pending = s3State == 2 and not na(s3FvgHi)
bool s4Pending = s4State == 2 and not na(s4FvgHi)
bool anyPending = s1BullPending or s1BearPending or s3Pending or s4Pending
float pendHi = s1BullPending ? s1BullFvgHi : s1BearPending ? s1BearFvgHi : s3Pending ? s3FvgHi : s4Pending ? s4FvgHi : na
float pendLo = s1BullPending ? s1BullFvgLo : s1BearPending ? s1BearFvgLo : s3Pending ? s3FvgLo : s4Pending ? s4FvgLo : na

var box pendingZoneBox = na
if showExecZone and anyPending and not na(pendHi)
    if na(pendingZoneBox)
        pendingZoneBox := box.new(bar_index, pendHi, bar_index + 5, pendLo,
             bgcolor = color.new(execZoneCol, 88), border_color = color.new(execZoneCol, 50),
             border_width = 1, border_style = line.style_dashed)
    else
        box.set_top(pendingZoneBox, pendHi)
        box.set_bottom(pendingZoneBox, pendLo)
        box.set_right(pendingZoneBox, bar_index + 5)
else if not na(pendingZoneBox)
    box.delete(pendingZoneBox)
    pendingZoneBox := na

// Execution zone box — drawn on signal at exact entry bar with logical entry price
if (finalBuy or finalSell) and showExecZone
    if not na(execBox)
        box.delete(execBox)
    if not na(raidRefLine)
        line.delete(raidRefLine)
    if not na(raidRefLbl)
        label.delete(raidRefLbl)
    if hasStratSignal and not na(sigZoneHi) and not na(sigZoneLo)
        // Exec zone anchored to entry bar (bar_index), not bar_index-5
        execBox := box.new(bar_index, sigZoneHi, bar_index + 10, sigZoneLo,
             bgcolor = color.new(execZoneCol, 78), border_color = color.new(execZoneCol, 15), border_width = 2)
        if not na(sigRaidLvl)
            raidRefLine := line.new(bar_index - 5, sigRaidLvl, bar_index + 10, sigRaidLvl,
                 color = color.new(sigBull ? bullCol : bearCol, 30), style = line.style_solid, width = 2)
            raidRefLbl := label.new(bar_index - 5, sigRaidLvl, sigRaidSrc + " sweep",
                 style = sigBull ? label.style_label_up : label.style_label_down,
                 color = color.new(sigBull ? bullCol : bearCol, 70), textcolor = color.white, size = size.tiny)
    if not na(pendingZoneBox)
        box.delete(pendingZoneBox)
        pendingZoneBox := na

// Extend exec zone box
if not na(execBox) and showExecZone
    box.set_right(execBox, bar_index + 5)

// Clean exec zone when toggle is off
if not showExecZone
    if not na(execBox)
        box.delete(execBox)
        execBox := na
    if not na(raidRefLine)
        line.delete(raidRefLine)
        raidRefLine := na
    if not na(raidRefLbl)
        label.delete(raidRefLbl)
        raidRefLbl := na
    if not na(pendingZoneBox)
        box.delete(pendingZoneBox)
        pendingZoneBox := na

// ═══════════════════════════════════════════════════════════════
//  21. SIGNAL LABELS (truthful sweep sources)
// ═══════════════════════════════════════════════════════════════
if finalBuy and hasStratSignal
    lbl = stratLabel(sigStrat)
    srcTxt = sigRaidSrc != "" ? " | " + sigRaidSrc : ""
    label.new(bar_index, low - atr14 * 0.65,
         "▲ BUY " + lbl + " [" + str.tostring(sigScore) + "]" + srcTxt,
         style = label.style_label_up, color = gradeColor(sigScore), textcolor = color.white, size = size.normal)

if finalSell and hasStratSignal
    lbl = stratLabel(sigStrat)
    srcTxt = sigRaidSrc != "" ? " | " + sigRaidSrc : ""
    label.new(bar_index, high + atr14 * 0.65,
         "▼ SELL " + lbl + " [" + str.tostring(sigScore) + "]" + srcTxt,
         style = label.style_label_down, color = gradeColor(sigScore), textcolor = color.white, size = size.normal)

// FVG standalone signals
if fvgBuySignal and not hasStratSignal
    label.new(bar_index, low - atr14 * 0.65,
         "◆ FVG BUY [" + str.tostring(fvgBuyScore) + "]",
         style = label.style_label_up, color = color.new(fvgCol, 0), textcolor = color.white, size = size.normal)

if fvgSellSignal and not hasStratSignal
    label.new(bar_index, high + atr14 * 0.65,
         "◆ FVG SELL [" + str.tostring(fvgSellScore) + "]",
         style = label.style_label_down, color = color.new(fvgCol, 0), textcolor = color.white, size = size.normal)

// Raid confirmation markers
if showSweepMarks and anyBullRaid
    label.new(bar_index, low - atr14 * 0.15, "↑ " + curBullRaidSrc,
         style = label.style_label_up, color = color.new(bullCol, 60), textcolor = color.white, size = size.tiny)

if showSweepMarks and anyBearRaid
    label.new(bar_index, high + atr14 * 0.15, "↓ " + curBearRaidSrc,
         style = label.style_label_down, color = color.new(bearCol, 60), textcolor = color.white, size = size.tiny)

// MSS markers
if bullMSSActive and bullMSSBar == bar_index
    label.new(bar_index, low - atr14 * 0.35, "MSS▲",
         style = label.style_label_up, color = color.new(bullCol, 40), textcolor = color.white, size = size.tiny)

if bearMSSActive and bearMSSBar == bar_index
    label.new(bar_index, high + atr14 * 0.35, "MSS▼",
         style = label.style_label_down, color = color.new(bearCol, 40), textcolor = color.white, size = size.tiny)

// SMT divergence markers
if smtEn and smtBullDiv and not na(smtDivBar) and smtDivBar == bar_index
    label.new(bar_index, low - atr14 * 0.50, "SMT▲",
         style = label.style_label_up, color = color.new(smtCol, 20), textcolor = color.white, size = size.tiny)

if smtEn and smtBearDiv and not na(smtDivBar) and smtDivBar == bar_index
    label.new(bar_index, high + atr14 * 0.50, "SMT▼",
         style = label.style_label_down, color = color.new(smtCol, 20), textcolor = color.white, size = size.tiny)

// ═══════════════════════════════════════════════════════════════
//  22. ALERTS (SIGNAL_OPEN + SIGNAL_CLOSE)
// ═══════════════════════════════════════════════════════════════
buildPayload(setup, dir, entry, sl, tp, score, eventType) =>
    "{" +
     "\"schemaVersion\":\"2.0\"," +
     "\"eventType\":" + jsonStr(eventType) + "," +
     "\"symbol\":" + jsonStr(syminfo.tickerid) + "," +
     "\"timeframe\":" + jsonStr(normalizeTimeframeId(timeframe.period)) + "," +
     "\"timestamp\":" + str.tostring(time_close) + "," +
     "\"setupType\":" + jsonStr(setup) + "," +
     "\"direction\":" + jsonStr(dir) + "," +
     "\"entry\":" + jsonNum(entry) + "," +
     "\"stopLoss\":" + jsonNum(sl) + "," +
     "\"takeProfit\":" + jsonNum(tp) + "," +
     "\"confluenceScore\":" + str.tostring(score) + "," +
     "\"regime\":" + jsonStr(regime.name) + "," +
     "\"htfBias\":" + jsonStr(htfBias) + "," +
     "\"timeBasis\":" + jsonStr(timeBasis) + "," +
     "\"executionMode\":" + jsonStr(executionMode) + "," +
     "\"riskMode\":" + jsonStr(riskMode) + "," +
     "\"session\":" + jsonStr(inOverlap ? "OVERLAP" : inLondon ? "LONDON" : inNewYork ? "NY" : inTokyo ? "TOKYO" : "OTHER") + "," +
     "\"features\":{" +
         "\"atr\":" + jsonNum(atr14) + "," +
         "\"adx\":" + jsonNum(adxVal) + "," +
         "\"volatilityState\":" + jsonStr(regime.volatilityState) +
     "}," +
     "\"authToken\":" + jsonStr(webhookToken) +
     "}"

if emitOpenAlerts and finalBuy and hasStratSignal
    alert(buildPayload(sigSetupType, "LONG", sigEntry, sigSL, sigTP2, sigScore, "SIGNAL_OPEN"), alert.freq_once_per_bar_close)

if emitOpenAlerts and finalSell and hasStratSignal
    alert(buildPayload(sigSetupType, "SHORT", sigEntry, sigSL, sigTP2, sigScore, "SIGNAL_OPEN"), alert.freq_once_per_bar_close)

if emitOpenAlerts and fvgBuySignal and not hasStratSignal
    alert(buildPayload("FVG_MITIGATION", "LONG", fvgBuyEntry, fvgBuySL, fvgBuyTP, fvgBuyScore, "SIGNAL_OPEN"), alert.freq_once_per_bar_close)

if emitOpenAlerts and fvgSellSignal and not hasStratSignal
    alert(buildPayload("FVG_MITIGATION", "SHORT", fvgSellEntry, fvgSellSL, fvgSellTP, fvgSellScore, "SIGNAL_OPEN"), alert.freq_once_per_bar_close)

// SIGNAL_CLOSE: emitted when a tracked trade resolves
if emitCloseAlerts and lastCloseTradeId != "" and lastCloseReason != "NONE"
    closeDir = lastClosePnlR > 0 ? "WIN" : "LOSS"
    closePayload = "{" +
         "\"schemaVersion\":\"2.0\"," +
         "\"eventType\":\"SIGNAL_CLOSE\"," +
         "\"tradeId\":" + jsonStr(lastCloseTradeId) + "," +
         "\"symbol\":" + jsonStr(syminfo.tickerid) + "," +
         "\"timeframe\":" + jsonStr(normalizeTimeframeId(timeframe.period)) + "," +
         "\"timestamp\":" + str.tostring(time_close) + "," +
         "\"setupType\":" + jsonStr(lastCloseSetup) + "," +
         "\"closeReason\":" + jsonStr(lastCloseReason) + "," +
         "\"result\":" + jsonStr(closeDir) + "," +
         "\"pnlR\":" + jsonNum(lastClosePnlR) + "," +
         "\"entry\":" + jsonNum(lastCloseEntry) + "," +
         "\"authToken\":" + jsonStr(webhookToken) +
         "}"
    alert(closePayload, alert.freq_once_per_bar_close)
    lastCloseTradeId := ""

// Generic alert conditions
alertcondition(finalBuy, "Buy Signal", "SMC v6 Buy Signal")
alertcondition(finalSell, "Sell Signal", "SMC v6 Sell Signal")
alertcondition(finalBuy or finalSell, "Any Signal", "SMC v6 Signal")

// ═══════════════════════════════════════════════════════════════
//  23. DASHBOARD (toggle-aware, delete when off)
// ═══════════════════════════════════════════════════════════════
wr = totalTrades > 0 ? totalWins * 100.0 / totalTrades : na
wrText = na(wr) ? "–" : str.tostring(wr, "#.#") + "%"
netR = str.tostring(totalR, "#.##") + "R"

activeSetupText = hasStratSignal ? sigSetupType :
     hasFvgStandalone ? "FVG_MITIGATION" :
     s1BullState >= 1 or s1BearState >= 1 ? "S1:TRACKING" :
     s3State >= 1 ? "S3:PO3" :
     s4State >= 1 ? "S4:JUDAS" : "IDLE"

displayScore = hasStratSignal ? sigScore :
     hasFvgStandalone ? (fvgBuySignal ? fvgBuyScore : fvgSellScore) :
     na(lastSigConf) ? na : lastSigConf
displayScoreText = na(displayScore) ? "–" : str.tostring(displayScore)

s1StatusText = strat1En ? (s1BullState == 0 and s1BearState == 0 ? "Idle" :
     s1BullState == 1 ? "Raid▲" : s1BullState == 2 ? "FVG▲" :
     s1BearState == 1 ? "Raid▼" : s1BearState == 2 ? "FVG▼" : "Active") : "OFF"
s2StatusText = strat2En ? (inAnySB ? "In Window" : "Waiting") : "OFF"
s3StatusText = strat3En ? (s3State == 0 ? "Idle" : s3State == 1 ? "Manip" : "Confirm") : "OFF"
s4StatusText = strat4En ? (s4State == 0 ? "Idle" : s4State == 1 ? "Raid" : "Confirm") : "OFF"
s5StatusText = strat5En ? (smtBullDiv or smtBearDiv ? "Divergence" : "Monitoring") : "OFF"

var table dash = na
if barstate.islast
    if not na(dash)
        table.delete(dash)
        dash := na
    if showDash
        dash := table.new(position.bottom_left, 2, 22,
             bgcolor = color.new(color.rgb(8, 10, 28), 5),
             border_width = 1, border_color = color.new(color.white, 78))
        hBg = color.new(color.rgb(15, 18, 55), 0)
        r = 0
        table.cell(dash, 0, r, "SMC v6 Multi-Strategy", text_color = color.white, text_size = size.small, bgcolor = hBg)
        table.cell(dash, 1, r, webhookSource, text_color = color.white, text_size = size.small, bgcolor = hBg)
        r += 1

        table.cell(dash, 0, r, "Time Basis", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, timeBasis + " (" + tzMain + ")",
             text_color = timeBasis == "UTC" ? color.new(#00e5ff, 0) : color.new(#f59e0b, 0), text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Exec Mode", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, executionMode,
             text_color = executionMode == "Confirmed Close" ? color.new(color.white, 20) : color.new(#f59e0b, 0), text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Risk Mode", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, riskMode, text_color = color.new(color.white, 20), text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Regime", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, regime.name + " · " + regime.volatilityState,
             text_color = regime.name == "TREND" ? bullCol : regime.name == "RANGE" ? color.orange : color.new(color.white, 15), text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "HTF Bias", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, htfBias + (htfStrong ? " · Strong" : " · Soft"),
             text_color = htfBull ? bullCol : htfBear ? bearCol : color.gray, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Active Setup", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, activeSetupText,
             text_color = activeSetupText == "IDLE" ? color.gray : bullCol, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Score / Threshold", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, displayScoreText + " / " + str.tostring(effectiveThreshold) + (profileMode == "AUTO" ? " (AUTO)" : ""),
             text_color = na(displayScore) ? color.gray : displayScore >= effectiveThreshold ? bullCol : bearCol, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Priority", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, stratPriority, text_color = color.new(color.white, 30), text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Last Raid", text_color = color.new(color.white, 25), text_size = size.small)
        lastRaidTxt = bullRaidSrc != "" ? "Bull: " + bullRaidSrc : bearRaidSrc != "" ? "Bear: " + bearRaidSrc : "–"
        table.cell(dash, 1, r, lastRaidTxt,
             text_color = bullRaidSrc != "" ? bullCol : bearRaidSrc != "" ? bearCol : color.gray, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "S1 Raid→MSS→FVG", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, s1StatusText,
             text_color = s1StatusText == "OFF" ? color.gray : s1StatusText == "Idle" ? color.new(color.white, 40) : bullCol, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "S2 Silver Bullet", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, s2StatusText,
             text_color = s2StatusText == "OFF" ? color.gray : s2StatusText == "In Window" ? bullCol : color.new(color.white, 40), text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "S3 PO3/AMD", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, s3StatusText,
             text_color = s3StatusText == "OFF" ? color.gray : s3StatusText == "Idle" ? color.new(color.white, 40) : bullCol, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "S4 Judas Swing", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, s4StatusText,
             text_color = s4StatusText == "OFF" ? color.gray : s4StatusText == "Idle" ? color.new(color.white, 40) : bullCol, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "S5 SMT Divergence", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, s5StatusText,
             text_color = s5StatusText == "OFF" ? color.gray : s5StatusText == "Divergence" ? smtCol : color.new(color.white, 40), text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Session", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, inOverlap ? "LON-NY Overlap" : inLondon ? "London" : inNewYork ? "New York" : inTokyo ? "Tokyo" : inSydney ? "Sydney" : "Off-Session",
             text_color = inOverlap ? color.new(#f59e0b, 0) : inAnySession ? bullCol : color.gray, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Kill Zone", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, inLondonKz ? "London KZ" : inNyAmKz ? "NY AM KZ" : inNyPmKz ? "NY PM KZ" : inAnySB ? "Silver Bullet" : "–",
             text_color = inAnyKz or inAnySB ? bullCol : color.gray, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "PDH / PDL", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, (na(pdh) ? "–" : str.tostring(pdh, format.mintick)) + " / " + (na(pdl) ? "–" : str.tostring(pdl, format.mintick)),
             text_color = color.new(color.white, 20), text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "FVG Zones", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, "Bull:" + str.tostring(array.size(bfHi)) + " Bear:" + str.tostring(array.size(sfHi)),
             text_color = array.size(bfHi) + array.size(sfHi) > 0 ? fvgCol : color.gray, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Win Rate", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, wrText,
             text_color = na(wr) ? color.gray : wr >= 55 ? bullCol : wr >= 45 ? color.orange : bearCol, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Net R", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, netR,
             text_color = totalR >= 0 ? bullCol : bearCol, text_size = size.small)
        r += 1

        table.cell(dash, 0, r, "Trades", text_color = color.new(color.white, 25), text_size = size.small)
        table.cell(dash, 1, r, str.tostring(totalWins) + "W  " + str.tostring(totalLoss) + "L  ·  " + lastCloseReason,
             text_color = color.new(color.white, 30), text_size = size.small)

// ═══════════════════════════════════════════════════════════════
//  24. DEBUG LABELS (showDebug)
// ═══════════════════════════════════════════════════════════════
if showDebug and (finalBuy or finalSell) and hasStratSignal
    dbgEntry = not na(sigEntry) ? str.tostring(sigEntry, format.mintick) : "na"
    dbgTxt = "DEBUG S" + str.tostring(sigStrat) + " " + sigSetupType +
         "\nEntry: " + dbgEntry + " | Src: " + sigEntrySrc +
         "\nBar: " + str.tostring(bar_index) +
         "\nMode: " + executionMode +
         "\nConfirmed: " + str.tostring(barstate.isconfirmed) +
         "\nTimeBasis: " + timeBasis +
         "\nCandidates: " + debugCandidates +
         "\nWinner: " + debugWinner +
         "\nScore: " + str.tostring(sigScore) + "/" + str.tostring(effectiveThreshold) +
         "\nSessions: Lon=" + str.tostring(inLondon) + " NY=" + str.tostring(inNewYork) +
         " Tok=" + str.tostring(inTokyo) + " Syd=" + str.tostring(inSydney) +
         "\nKZ=" + str.tostring(inAnyKz) + " SB=" + str.tostring(inAnySB) + " Judas=" + str.tostring(inJudas) +
         "\nRaid: " + sigRaidSrc + " MSS=" + str.tostring(bullMSSActive or bearMSSActive) +
         " FVG=" + str.tostring(not na(sigZoneHi))
    label.new(bar_index, sigBull ? low - atr14 * 1.5 : high + atr14 * 1.5, dbgTxt,
         style = sigBull ? label.style_label_up : label.style_label_down,
         color = color.new(color.purple, 20), textcolor = color.white, size = size.tiny)

// Debug on last bar: show current state
if showDebug and barstate.islast
    lastDbg = "LAST BAR DEBUG" +
         "\nTimeBasis: " + timeBasis + " TZ: " + tzMain +
         "\nSessions: Lon=" + str.tostring(inLondon) + " NY=" + str.tostring(inNewYork) +
         " Tok=" + str.tostring(inTokyo) + " Syd=" + str.tostring(inSydney) +
         "\ninSession=" + str.tostring(inSessionFinal) + " KZ=" + str.tostring(inAnyKz) +
         " SB=" + str.tostring(inAnySB) + " Judas=" + str.tostring(inJudas) +
         "\nS1: B=" + str.tostring(s1BullState) + " S=" + str.tostring(s1BearState) +
         " S3=" + str.tostring(s3State) + " S4=" + str.tostring(s4State) +
         "\nLossStreak=" + str.tostring(adaptiveLossStreak) +
         " Cooldown=" + (not na(cooldownUntilBar) and bar_index < cooldownUntilBar ? str.tostring(cooldownUntilBar - bar_index) + "bars" : "none")
    label.new(bar_index + 3, close, lastDbg,
         style = label.style_label_left, color = color.new(color.purple, 30), textcolor = color.white, size = size.tiny)

// ═══════════════════════════════════════════════════════════════
//  25. QA MODE TABLE (qaMode)
// ═══════════════════════════════════════════════════════════════
var table qaTable = na
if barstate.islast
    if not na(qaTable)
        table.delete(qaTable)
        qaTable := na
    if qaMode
        qaTable := table.new(position.top_right, 2, 24,
             bgcolor = color.new(color.rgb(10, 12, 30), 5),
             border_width = 1, border_color = color.new(color.yellow, 60))
        hBg2 = color.new(color.rgb(30, 20, 60), 0)
        qr = 0
        table.cell(qaTable, 0, qr, "QA MODE", text_color = color.yellow, text_size = size.small, bgcolor = hBg2)
        table.cell(qaTable, 1, qr, "SMC v6", text_color = color.yellow, text_size = size.small, bgcolor = hBg2)
        qr += 1

        table.cell(qaTable, 0, qr, "timeBasis", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, timeBasis, text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "tzMain", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, tzMain, text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "tzLondon/NY", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, tzLondon + " / " + tzNy, text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Sessions", text_color = color.new(color.white, 20), text_size = size.small)
        sessStr = "L:" + str.tostring(inLondon) + " NY:" + str.tostring(inNewYork) + " T:" + str.tostring(inTokyo) + " S:" + str.tostring(inSydney)
        table.cell(qaTable, 1, qr, sessStr, text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "inSessionFinal", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, str.tostring(inSessionFinal), text_color = inSessionFinal ? bullCol : bearCol, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "KZ/SB/Judas", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, "KZ:" + str.tostring(inAnyKz) + " SB:" + str.tostring(inAnySB) + " J:" + str.tostring(inJudas),
             text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "PO3 Phase", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, "Acc:" + str.tostring(inPo3Accum) + " Man:" + str.tostring(inPo3Manip) + " Dist:" + str.tostring(inPo3Dist),
             text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Strategy States", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, "S1b:" + str.tostring(s1BullState) + " S1s:" + str.tostring(s1BearState) + " S3:" + str.tostring(s3State) + " S4:" + str.tostring(s4State),
             text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "S2 Armed", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, "B:" + str.tostring(s2BullRaided) + " S:" + str.tostring(s2BearRaided),
             text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Last Raid", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, "B:" + bullRaidSrc + " S:" + bearRaidSrc,
             text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Priority Winner", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, sigStrat > 0 ? debugWinner + " (" + sigSetupType + ")" : "none",
             text_color = sigStrat > 0 ? bullCol : color.gray, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Candidates", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, debugCandidates != "" ? debugCandidates : "none",
             text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Entry Price", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, not na(sigEntry) ? str.tostring(sigEntry, format.mintick) + " (" + sigEntrySrc + ")" : "–",
             text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Exec Mode", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, executionMode, text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Risk Mode", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, riskMode, text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Eff. Threshold", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, str.tostring(effectiveThreshold) + " (base:" + str.tostring(scoreThreshold) + " shift:" + str.tostring(adaptiveShift) + ")",
             text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Cooldown", text_color = color.new(color.white, 20), text_size = size.small)
        cdText = not na(cooldownUntilBar) and bar_index < cooldownUntilBar ?
             str.tostring(cooldownUntilBar - bar_index) + " bars (streak:" + str.tostring(adaptiveLossStreak) + ")" : "none"
        table.cell(qaTable, 1, qr, cdText, text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Toggles", text_color = color.new(color.white, 20), text_size = size.small)
        togStr = "Dash:" + str.tostring(showDash) + " Sweep:" + str.tostring(showSweepMarks) +
             " PDH:" + str.tostring(showPDHL) + " EQL:" + str.tostring(showEqlHL) +
             " SessHL:" + str.tostring(showSessionHL) + " Exec:" + str.tostring(showExecZone)
        table.cell(qaTable, 1, qr, togStr, text_color = color.white, text_size = size.small)
        qr += 1

        table.cell(qaTable, 0, qr, "Pending Zone", text_color = color.new(color.white, 20), text_size = size.small)
        table.cell(qaTable, 1, qr, anyPending ? "YES" : "no",
             text_color = anyPending ? bullCol : color.gray, text_size = size.small)
