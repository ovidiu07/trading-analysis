//@version=6
indicator("SMC Clean Signals v6 [TradeJAudit]", "SMC v6", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 500)

// ═══════════════════════════════════════════════════════════════
//  CHANGELOG (v5 → v6 Refactor)
// ═══════════════════════════════════════════════════════════════
// 1. INPUTS: Removed all dead inputs. Every input now affects behaviour.
//    - sessionProfile → timeBasis (UTC default, 4 modes)
//    - Added executionMode (Confirmed Close / Intrabar)
//    - Added qaMode for QA instrumentation table
//    - Added customTz for Custom time basis
//    - Wired: showDebug, stratPriority, useLiqPools, obDef, showOBZones,
//      riskMode, partial1Pct, moveToBEatR, useTimeStop, timeStopMins,
//      sessionCol, profileMode, manualConfThreshold, adaptiveWindow,
//      adaptiveMaxShift, cooldownLossTrig, cooldownBase, emitCloseAlerts
// 2. SESSIONS: UTC is now the default time basis. All session/KZ/SB/Judas/PO3
//    windows default to UTC hours. timeBasis controls timezone for all time().
// 3. DISPLAY: All toggles properly hide/show. Dashboard fully deleted when off.
//    Session BG uses sessionCol. Stale objects cleaned on toggle-off.
// 4. ENTRY ZONE: entryPriceLogic anchored to FVG CE or proximal edge (never
//    close). Trade box starts at entryBarIndex. No half-candle drift.
// 5. STRATEGY PRIORITY: Candidates evaluated independently, winner selected
//    by parsed stratPriority order. Debug shows rejected candidates.
// 6. RISK MODE: fixedRR (single TP), multiRR (TP1+TP2), structure (PDH/PDL/
//    session/EQL targets). partial1Pct, moveToBEatR, timeStop all wired.
// 7. ALERTS: SIGNAL_CLOSE emitted on trade resolution. Payload includes
//    timeBasis, executionMode, strategyId, entryPriceLogic, riskMode.
// 8. DEBUG: showDebug prints signal-bar diagnostics. QA table on last bar.
// 9. ADAPTIVE: profileMode AUTO adjusts effective threshold from recent WR.
//    cooldownLossTrig/cooldownBase suppress signals after loss streaks.
// ═══════════════════════════════════════════════════════════════
//  QA CHECKLIST
// ═══════════════════════════════════════════════════════════════
// ① General: htfTf, htfEmaLen, useHtfBias, executionTfMax, requireTfCheck,
//    showDebug, qaMode, executionMode → verify HTF EMA on chart, TF gate.
// ② Sessions: timeBasis, customTz, londonEn/Sess, nyEn/Sess, tokyoEn/Sess,
//    sydneyEn/Sess, KZ/SB/Judas/PO3 windows → switch timeBasis modes,
//    verify session BG colours appear/disappear.
// ③ Strategy Toggles: strat1-5En, stratPriority, suppressBars →
//    enable/disable each, verify priority tie-breaking.
// ④ Confluence: pivotLen, useLiqPools, useEqlHL, usePDHL, useSessionHL,
//    usePremDisc, useDispFilter, useMSS, useVolSpike, useRsiFilter →
//    toggle each, verify scoring changes.
// ⑤ FVG: useFvg, fvgUseCE, minFvgSizeAtr, fvgBodyMin, maxActiveFvg,
//    fvgExpBars, showFvgZones → toggle zones on/off, verify CE vs proximal.
// ⑥ OB: useOB, obDef, obSearchBars, showOBZones → switch lastOpp/swingOB,
//    toggle zone visibility.
// ⑦ SMT: smtEn, smtSymbolB, smtCorr, smtPivotLen, smtMaxBars →
//    enable with correlated pair, verify divergence markers.
// ⑧ Risk: riskMode, rrRatio, stopMode, t1R, t2R, partial1Pct, moveToBEatR,
//    useTimeStop, timeStopMins → switch modes, verify TP levels change.
// ⑨ Scoring: useScoring, scoreThreshold, weights → adjust, verify filter.
// ⑩ Display: showDash, showSweepMarks, showPDHL, showEqlHL, showSessionHL,
//    showExecZone, sessionCol, showSessionBg → flip each, no stale objects.
// ⑪ Adaptive: profileMode, manualConfThreshold, adaptiveWindow,
//    adaptiveMaxShift, cooldownLossTrig, cooldownBase → AUTO vs MANUAL.
// ⑫ Webhook: emitOpenAlerts, emitCloseAlerts, webhookToken → verify JSON.
// ═══════════════════════════════════════════════════════════════
//  IMPLEMENTATION NOTES
// ═══════════════════════════════════════════════════════════════
// entryPriceLogic: fvgUseCE ? (fvgHi+fvgLo)/2 : proximal edge of FVG.
//   Never falls back to close. Standalone FVG uses close (rejection entry).
// entryBarIndex: bar_index on the bar where all conditions become true.
// executionMode: "Confirmed Close" requires barstate.isconfirmed.
//   "Intrabar (Aggressive)" fires immediately (may repaint on live bar).
//   Historical bars are identical (isconfirmed always true historically).
// timeBasis: "UTC" → all time() calls use Etc/UTC with UTC-expressed hours.
//   "New York (ICT)" → America/New_York. "Local-per-session" → native IANA.
//   "Custom" → user-provided customTz string.
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
//  SETTINGS
// ═══════════════════════════════════════════════════════════════
grpGeneral  = "① General"
grpSessions = "② Sessions & Kill Zones"
grpStrat    = "③ Strategy Toggles"
grpConf     = "④ Confluence & Detection"
grpFvg      = "⑤ FVG Settings"
grpOB       = "⑥ Order Block Settings"
grpSMT      = "⑦ SMT / Correlation"
grpRisk     = "⑧ Risk Management"
grpScore    = "⑨ Confluence Scoring"
grpDisplay  = "⑩ Display"
grpAdaptive = "⑪ Adaptive Engine"
grpWebhook  = "⑫ TradingView Webhook"

// ── General ──────────────────────────────────────────────────
htfTf           = input.timeframe("240", "HTF Bias Timeframe", group = grpGeneral)
htfEmaLen       = input.int(50, "HTF EMA Period", minval = 10, maxval = 200, group = grpGeneral)
useHtfBias      = input.bool(true, "Require HTF Bias Alignment", group = grpGeneral)
executionTfMax  = input.int(15, "Max Execution TF (minutes)", options = [1, 3, 5, 15, 30, 60], group = grpGeneral,
     tooltip = "Signals only fire when chart TF <= this value.")
requireTfCheck  = input.bool(true, "Enforce Max Execution TF", group = grpGeneral)
executionMode   = input.string("Confirmed Close", "Execution Mode", options = ["Confirmed Close", "Intrabar (Aggressive)"], group = grpGeneral,
     tooltip = "Confirmed Close: signal on bar close (no repaint). Intrabar: fires immediately (may repaint live bar). Historical identical.")
showDebug       = input.bool(false, "Show Debug Labels", group = grpGeneral,
     tooltip = "Prints signal-bar diagnostics: entry price, bar index, strategy, zone type, conditions.")
qaMode          = input.bool(false, "QA Mode (Last-Bar Table)", group = grpGeneral,
     tooltip = "Shows compact QA panel on last bar with session states, strategy states, and toggle status.")

// ── Sessions ─────────────────────────────────────────────────
