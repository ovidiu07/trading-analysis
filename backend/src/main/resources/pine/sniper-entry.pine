//@version=6
indicator("SMC Clean Signals v4 [TradeJAudit]", "SMC v4", overlay = true,
     max_labels_count = 200, max_lines_count = 200, max_boxes_count = 200, max_bars_back = 500)

// ═══════════════════════════════════════════════════════════════
//  SETTINGS
// ═══════════════════════════════════════════════════════════════
grpSweep   = "① Sweep + OB Setup"
grpFvg     = "② FVG Mitigation Setup"
grpFilter  = "③ Filters (Both Setups)"
grpRisk    = "④ Risk Management"
grpDisplay = "⑤ Display"
grpAdaptive = "⑥ Adaptive Engine"
grpWebhook = "⑦ TradingView Webhook"

// ── Sweep quality ──────────────────────────────────────────────
swingLen      = input.int(30,   "Swing Length",             minval = 10, maxval = 60, group = grpSweep,
     tooltip = "Pivot half-length. Higher = fewer, more significant swing levels.")
minSweepAtr   = input.float(0.20, "Min Sweep Depth (ATR)",  minval = 0.05, maxval = 1.0, step = 0.05, group = grpSweep,
     tooltip = "Wick must pierce level by this many ATRs. Removes tick-through noise.")
sweepRetrace  = input.float(0.60, "Min Close Retrace %",    minval = 0.30, maxval = 0.95, step = 0.05, group = grpSweep,
     tooltip = "After sweep, close must retrace this % back inside the range.")
requireWick   = input.bool(true,  "Body Must Stay on Correct Side", group = grpSweep,
     tooltip = "ON: body stays above/below swept level. Rejects full-body breaks (those are MSS, not sweeps).")
minLevelAge   = input.int(8,    "Min Level Age (bars)",      minval = 3, maxval = 30, group = grpSweep,
     tooltip = "Level must exist this many bars before it can be swept.")
sweepCooldown = input.int(15,   "Sweep Cooldown (bars)",     minval = 5, maxval = 60, group = grpSweep,
     tooltip = "Bars to wait before another same-direction sweep can fire.")
minTouches    = input.int(2,    "Min Touches Before Sweep",  minval = 1, maxval = 6, group = grpSweep,
     tooltip = "Level must be tested this many times before sweeping = deeper liquidity pool.")
dispBodyMin   = input.float(0.55, "Min Displacement Body %", minval = 0.30, maxval = 0.90, step = 0.05, group = grpSweep,
     tooltip = "Displacement candle body % of full range. Filters weak pushes.")
obSearchBars  = input.int(6,    "OB Search Bars",            minval = 2, maxval = 12, group = grpSweep,
     tooltip = "Bars back to search for the Order Block after displacement.")

// ── FVG Mitigation Setup ───────────────────────────────────────
useFvgSetup    = input.bool(true,  "Enable FVG Mitigation Signals", group = grpFvg,
     tooltip = "Standalone signals: significant FVG forms during displacement → price retraces into it → rejection = signal.")
minFvgSizeAtr  = input.float(0.30, "Min FVG Size (ATR)",     minval = 0.05, maxval = 2.0, step = 0.05, group = grpFvg,
     tooltip = "Gap must be at least this many ATRs wide. Filters tiny micro-gaps.")
fvgBodyMin     = input.float(0.50, "Min FVG Candle Body %",  minval = 0.20, maxval = 0.90, step = 0.05, group = grpFvg,
     tooltip = "The candle creating the FVG must have this body % — confirms it formed during strong displacement.")
maxActiveFvg   = input.int(4,     "Max Active FVG Zones",    minval = 1, maxval = 6, group = grpFvg,
     tooltip = "Maximum simultaneous FVG zones tracked per direction.")
fvgExpBars     = input.int(60,    "FVG Zone Expiry (bars)",  minval = 10, maxval = 200, group = grpFvg,
     tooltip = "FVG zones expire after this many bars if not triggered.")
fvgEntryDepth  = input.float(0.30, "Max Entry Depth (0=proximal, 1=distal)", minval = 0.05, maxval = 0.80, step = 0.05, group = grpFvg,
     tooltip = "How far into the FVG the rejection close can be. 0.30 = only accept entries in the first 30% of the zone from the proximal edge. Keeps SL tight.")
maxRiskAtr     = input.float(1.50, "Max Allowed Risk (ATR)",  minval = 0.20, maxval = 5.0, step = 0.10, group = grpFvg,
     tooltip = "If SL distance exceeds this many ATRs, skip the signal. Prevents wide-stop entries when price is deep in the zone.")
showFvgZones   = input.bool(true,  "Show FVG Zones",          group = grpFvg,
     tooltip = "Draw the FVG boxes on chart while they are active.")

// ── Shared filters ─────────────────────────────────────────────
htfTf         = input.timeframe("240", "HTF Timeframe",      group = grpFilter,
     tooltip = "Directional bias timeframe. Should be higher than chart timeframe.")
htfEmaLen     = input.int(50,   "HTF EMA Period",             minval = 10, maxval = 200, group = grpFilter)
useHtfBias    = input.bool(true, "Require HTF Bias Alignment", group = grpFilter,
     tooltip = "Only take longs when above HTF EMA, shorts when below.")
useObFvgConf  = input.bool(true, "OB Setup: Require FVG Confluence", group = grpFilter,
     tooltip = "Sweep+OB signals require a nearby FVG for confirmation.")
fvgConfLookback = input.int(8,  "OB FVG Confluence Lookback", minval = 2, maxval = 20, group = grpFilter)
useSession    = input.bool(true, "Session Filter",             group = grpFilter)
sessionTime   = input.session("0700-1600", "Valid Session",   group = grpFilter,
     tooltip = "London–NY overlap. For crypto: set 0000-2359 or disable.")

// ── Risk ────────────────────────────────────────────────────────
rrRatio       = input.float(2.5, "Risk : Reward",             minval = 0.5, maxval = 10.0, step = 0.1, group = grpRisk)
stopBuf       = input.float(0.20, "Stop Buffer (ATR)",         minval = 0.0, maxval = 1.0, step = 0.05, group = grpRisk,
     tooltip = "Extra buffer below/above stop level. Prevents minor wick stop-outs.")
tradeExtBars  = input.int(40,   "Trade Box Width (bars)",      minval = 10, maxval = 150, group = grpRisk)

// ── Display ─────────────────────────────────────────────────────
showOBZone    = input.bool(true,  "Show OB Zones",             group = grpDisplay)
showObFvgConf = input.bool(true,  "Show OB FVG Confluence Box", group = grpDisplay)
showSweepConf = input.bool(true,  "Show Sweep Confirmation Markers", group = grpDisplay,
     tooltip = "Small dot appears on the displacement bar ONLY after sweep+displacement both confirmed. Not on raw sweeps.")
showDash      = input.bool(true,  "Show Dashboard",            group = grpDisplay)
bullCol       = input.color(color.new(#00c27a, 0), "Bull Color",   group = grpDisplay)
bearCol       = input.color(color.new(#ff3d5a, 0), "Bear Color",   group = grpDisplay)
fvgCol        = input.color(color.new(#a78bfa, 0), "FVG Zone Color", group = grpDisplay,
     tooltip = "Color for standalone FVG mitigation zones.")

// ── Adaptive engine ───────────────────────────────────────────
profileMode    = input.string("AUTO", "Profile Mode", options = ["AUTO", "MANUAL"], group = grpAdaptive,
     tooltip = "AUTO maps the active timeframe and detected regime into a profile pack. MANUAL uses the settings above and the manual confidence/cooldown values below.")
manualProfileId = input.string("MANUAL_CUSTOM_V1", "Manual Profile ID", group = grpAdaptive,
     tooltip = "Identifier emitted in alert payloads when Profile Mode = MANUAL.")
manualConfidenceThreshold = input.int(68, "Manual Confidence Threshold", minval = 40, maxval = 95, group = grpAdaptive)
manualCooldownBase = input.int(12, "Manual Cooldown Base (bars)", minval = 3, maxval = 60, group = grpAdaptive)
adaptiveRecentWindow = input.int(40, "Adaptive Memory Window", minval = 12, maxval = 120, group = grpAdaptive,
     tooltip = "Rolling closed-signal sample used for setup/direction/regime weighting inside Pine.")
adaptiveMaxShift = input.int(8, "Max Confidence Shift", minval = 2, maxval = 16, group = grpAdaptive,
     tooltip = "Maximum threshold tightening/relaxing from recent local performance.")
cooldownLossTrigger = input.int(2, "Cooldown Starts After Losses", minval = 2, maxval = 5, group = grpAdaptive)
maxTrackedSignals = input.int(36, "Max Locally Tracked Signals", minval = 8, maxval = 64, group = grpAdaptive,
     tooltip = "Bound for Pine-side open signal tracking and close-event simulation.")

// ── TradingView webhook ───────────────────────────────────────
emitSignalOpenAlerts = input.bool(true, "Emit SIGNAL_OPEN alert() payloads", group = grpWebhook)
emitSignalCloseAlerts = input.bool(false, "Emit simulated SIGNAL_CLOSE alert() payloads", group = grpWebhook,
     tooltip = "Uses local TP/SL tracking inside Pine. This is useful for validation, but it is still a simulated outcome stream.")
webhookAuthToken = input.string("", "Webhook Auth Token", group = grpWebhook,
     tooltip = "Paste the TradeJAudit TradingView webhook secret here. It is emitted inside the JSON payload.")
webhookSourceTag = input.string("TRADEJAUDIT_PINE_V1", "Webhook Source Tag", group = grpWebhook,
     tooltip = "Optional tag for your own alert routing/logging.")

// ═══════════════════════════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════════════════════════
clamp(v, lo, hi) => math.max(lo, math.min(hi, v))

gradeColor(g) =>
    g == "A" ? color.new(#00c27a, 0) :
     g == "B" ? color.new(#f5a623, 0) :
     color.new(#9b9b9b, 0)

fvgGradeColor(g) =>
    g == "A" ? color.new(#a78bfa, 0) :
     g == "B" ? color.new(#c084fc, 0) :
     color.new(#9b9b9b, 0)

type ProfilePack
    string id
    int swingLen
    float minSweepAtr
    float sweepRetrace
    float dispBodyMin
    float minFvgSizeAtr
    int obSearchBars
    float maxRiskAtr
    int confidenceThreshold
    int cooldownBase
    bool useObFvgConf
    bool useHtfBias
    string sessionPreset

type RegimeState
    string name
    string volatilityState
    string rangeState
    float atrRatio
    float adxValue
    float emaSlope
    float bbWidthRatio

type TradePlan
    string externalTradeId
    string setupType
    string direction
    string regime
    string profileId
    float entry
    float sl
    float tp
    float rr
    int confidence

normalizeTimeframeId(tf) =>
    tf == "1H" ? "60" :
     tf == "4H" ? "240" :
     tf == "1D" ? "D" :
     tf

sessionPresetLabel() =>
    not useSession ? "ANY" :
     sessionTime == "0700-1600" ? "LONDON_NY" :
     sessionTime == "0000-2359" ? "FULL_DAY" :
     "CUSTOM"

getBaseProfilePack(tf) =>
    normalizedTf = normalizeTimeframeId(tf)
    if normalizedTf == "1"
        ProfilePack.new("AUTO_1_TREND_V1", 16, 0.18, 0.62, 0.60, 0.22, 5, 1.10, 66, 9, true, true, "LONDON_NY")
    else if normalizedTf == "3"
        ProfilePack.new("AUTO_3_TREND_V1", 18, 0.20, 0.62, 0.58, 0.24, 5, 1.20, 67, 10, true, true, "LONDON_NY")
    else if normalizedTf == "5"
        ProfilePack.new("AUTO_5_TREND_V1", 22, 0.22, 0.60, 0.56, 0.28, 6, 1.30, 68, 12, true, true, "LONDON_NY")
    else if normalizedTf == "15"
        ProfilePack.new("AUTO_15_TREND_V1", 26, 0.24, 0.58, 0.55, 0.30, 6, 1.45, 70, 14, true, true, "LONDON_NY")
    else if normalizedTf == "60"
        ProfilePack.new("AUTO_60_TREND_V1", 30, 0.26, 0.55, 0.52, 0.34, 7, 1.60, 72, 16, true, true, "LONDON_NY")
    else if normalizedTf == "240"
        ProfilePack.new("AUTO_240_TREND_V1", 34, 0.28, 0.54, 0.50, 0.38, 7, 1.80, 74, 18, true, true, "LONDON_NY")
    else
        ProfilePack.new("AUTO_D_TREND_V1", 38, 0.30, 0.52, 0.48, 0.42, 8, 2.00, 76, 20, true, true, "LONDON_NY")

getProfilePack(tf, regimeName) =>
    normalizedTf = normalizeTimeframeId(tf)
    base = getBaseProfilePack(normalizedTf)
    int pSwingLen = base.swingLen
    float pMinSweepAtr = base.minSweepAtr
    float pSweepRetrace = base.sweepRetrace
    float pDispBodyMin = base.dispBodyMin
    float pMinFvgSizeAtr = base.minFvgSizeAtr
    int pObSearchBars = base.obSearchBars
    float pMaxRiskAtr = base.maxRiskAtr
    int pConfidenceThreshold = base.confidenceThreshold
    int pCooldownBase = base.cooldownBase
    if regimeName == "RANGE"
        pSwingLen += 2
        pMinSweepAtr -= 0.02
        pDispBodyMin -= 0.03
        pMinFvgSizeAtr -= 0.04
        pConfidenceThreshold -= 2
    else if regimeName == "VOL_EXPANSION"
        pMinSweepAtr += 0.05
        pDispBodyMin += 0.04
        pMaxRiskAtr += 0.10
        pConfidenceThreshold += 2
    else if regimeName == "VOL_COMPRESSION"
        pSwingLen += 4
        pMinSweepAtr -= 0.03
        pDispBodyMin -= 0.05
        pMinFvgSizeAtr -= 0.05
        pCooldownBase -= 2
    else
        pDispBodyMin += 0.02
        pConfidenceThreshold += 1
    finalProfileId = "AUTO_" + normalizedTf + "_" + regimeName + "_V1"
    ProfilePack.new(finalProfileId, pSwingLen, pMinSweepAtr, pSweepRetrace, pDispBodyMin, pMinFvgSizeAtr,
         pObSearchBars, pMaxRiskAtr, pConfidenceThreshold, pCooldownBase, base.useObFvgConf, base.useHtfBias, base.sessionPreset)

calcRegime(atrValue, atrMeanValue, adxValue, emaSlopeValue, bbWidthRatioValue) =>
    atrRatioValue = atrValue / math.max(atrMeanValue, syminfo.mintick)
    trendReady = adxValue >= 23 and math.abs(emaSlopeValue) >= 0.22
    volExpansion = atrRatioValue >= 1.20 or bbWidthRatioValue >= 1.15
    volCompression = atrRatioValue <= 0.85 and bbWidthRatioValue <= 0.92
    regimeName = trendReady and not volExpansion ? "TREND" :
         volCompression ? "VOL_COMPRESSION" :
         volExpansion ? "VOL_EXPANSION" :
         "RANGE"
    volatilityState = atrRatioValue >= 1.15 ? "EXPANDING" : atrRatioValue <= 0.90 ? "COMPRESSING" : "BALANCED"
    rangeState = regimeName == "RANGE" ? "RANGING" :
         regimeName == "VOL_COMPRESSION" ? "COMPRESSED" :
         "DIRECTIONAL"
    RegimeState.new(regimeName, volatilityState, rangeState, atrRatioValue, adxValue, emaSlopeValue, bbWidthRatioValue)

calcHtfBiasLabel(closeValue, emaValue) =>
    closeValue > emaValue ? "BULLISH" : closeValue < emaValue ? "BEARISH" : "NEUTRAL"

regimeFitScore(setupType, regimeName) =>
    if setupType == "SWEEP_OB_REVERSAL"
        regimeName == "RANGE" ? 12.0 :
         regimeName == "VOL_COMPRESSION" ? 10.0 :
         regimeName == "TREND" ? 7.0 :
         6.0
    else
        regimeName == "TREND" ? 12.0 :
         regimeName == "VOL_EXPANSION" ? 11.0 :
         regimeName == "RANGE" ? 6.0 :
         5.0

volatilitySuitabilityScore(setupType, atrRatioValue, regimeName) =>
    ideal = setupType == "FVG_MITIGATION" ? 1.15 : 0.98
    distance = math.abs(atrRatioValue - ideal)
    base = distance <= 0.15 ? 10.0 :
         distance <= 0.35 ? 7.0 :
         distance <= 0.55 ? 4.0 :
         2.0
    boost = (setupType == "FVG_MITIGATION" and regimeName == "TREND") or (setupType == "SWEEP_OB_REVERSAL" and regimeName == "RANGE") ? 2.0 : 0.0
    clamp(base + boost, 0.0, 12.0)

scoreSetupCandidate(setupType, sweepDepthAtr, displacementBodyPct, zoneSizeAtr, hasOb, hasFvg, htfAligned, htfIsStrong, isSessionValid, regimeName, atrRatioValue, recentEdge, lossPenalty) =>
    score = 18.0
    score += htfAligned ? 12.0 : -2.0
    score += htfIsStrong ? 4.0 : 0.0
    score += regimeFitScore(setupType, regimeName)
    score += clamp((nz(sweepDepthAtr, 0.0) - 0.10) / 0.60, 0.0, 1.0) * (setupType == "SWEEP_OB_REVERSAL" ? 16.0 : 8.0)
    score += clamp((displacementBodyPct - 0.40) / 0.35, 0.0, 1.0) * 14.0
    score += clamp(nz(zoneSizeAtr, 0.0) / 1.20, 0.0, 1.0) * 12.0
    score += hasOb ? 8.0 : 0.0
    score += hasFvg ? 10.0 : 0.0
    score += isSessionValid ? 8.0 : 2.0
    score += volatilitySuitabilityScore(setupType, atrRatioValue, regimeName)
    score += recentEdge
    score -= lossPenalty
    int(math.round(clamp(score, 0.0, 100.0)))

sanitizeSymbol(srcText) =>
    str.replace_all(str.replace_all(str.replace_all(srcText, ":", "_"), ".", "_"), "/", "_")

buildExternalTradeId(setupType, direction, signalTime) =>
    setupSuffix = setupType == "SWEEP_OB_REVERSAL" ? "sweepob" : "fvgmit"
    "tv-" + sanitizeSymbol(syminfo.tickerid) + "-" + normalizeTimeframeId(timeframe.period) + "-" + str.tostring(signalTime) + "-" + str.lower(direction) + "-" + setupSuffix

buildTradePlan(setupType, direction, regimeName, profileId, entryPrice, stopPrice, takeProfitPrice, rrValue, confidenceScore, signalTime) =>
    TradePlan.new(buildExternalTradeId(setupType, direction, signalTime), setupType, direction, regimeName, profileId, entryPrice, stopPrice, takeProfitPrice, rrValue, confidenceScore)

jsonString(value) =>
    "\"" + value + "\""

jsonNumber(value) =>
    na(value) ? "null" : str.tostring(value)

buildAlertPayload(plan, string eventType, string htfBiasLabel, string sessionLabel, float atrValue, float atrMeanValue, float adxValue, float emaSlopeValue, float bodyPctValue, float sweepDepthAtrValue, float fvgSizeAtrValue, float obSizeAtrValue, string volatilityState, string rangeState, int holdBarsValue, string exitReason, float pnlRValue, string resultValue) =>
    openPayload = "{" +
         "\"schemaVersion\":\"1.0\"," +
         "\"eventType\":" + jsonString(eventType) + "," +
         "\"externalTradeId\":" + jsonString(plan.externalTradeId) + "," +
         "\"symbol\":" + jsonString(syminfo.tickerid) + "," +
         "\"timeframe\":" + jsonString(normalizeTimeframeId(timeframe.period)) + "," +
         "\"timestamp\":" + str.tostring(time_close) + "," +
         "\"barTime\":" + str.tostring(time_close) + "," +
         "\"setupType\":" + jsonString(plan.setupType) + "," +
         "\"direction\":" + jsonString(plan.direction) + "," +
         "\"entry\":" + jsonNumber(plan.entry) + "," +
         "\"stopLoss\":" + jsonNumber(plan.sl) + "," +
         "\"takeProfit\":" + jsonNumber(plan.tp) + "," +
         "\"rr\":" + jsonNumber(plan.rr) + "," +
         "\"confidenceScore\":" + str.tostring(plan.confidence) + "," +
         "\"regime\":" + jsonString(plan.regime) + "," +
         "\"htfBias\":" + jsonString(htfBiasLabel) + "," +
         "\"session\":" + jsonString(sessionLabel) + "," +
         "\"parameterProfileId\":" + jsonString(plan.profileId) + "," +
         "\"features\":{" +
             "\"atr\":" + jsonNumber(atrValue) + "," +
             "\"atrMean\":" + jsonNumber(atrMeanValue) + "," +
             "\"adx\":" + jsonNumber(adxValue) + "," +
             "\"emaSlope\":" + jsonNumber(emaSlopeValue) + "," +
             "\"bodyPct\":" + jsonNumber(bodyPctValue) + "," +
             "\"sweepDepthAtr\":" + jsonNumber(sweepDepthAtrValue) + "," +
             "\"fvgSizeAtr\":" + jsonNumber(fvgSizeAtrValue) + "," +
             "\"obSizeAtr\":" + jsonNumber(obSizeAtrValue) + "," +
             "\"volatilityState\":" + jsonString(volatilityState) + "," +
             "\"rangeState\":" + jsonString(rangeState) +
         "}," +
         "\"authToken\":" + jsonString(webhookAuthToken) +
     "}"
    closePayload = "{" +
         "\"schemaVersion\":\"1.0\"," +
         "\"eventType\":\"SIGNAL_CLOSE\"," +
         "\"externalTradeId\":" + jsonString(plan.externalTradeId) + "," +
         "\"symbol\":" + jsonString(syminfo.tickerid) + "," +
         "\"timeframe\":" + jsonString(normalizeTimeframeId(timeframe.period)) + "," +
         "\"timestamp\":" + str.tostring(time_close) + "," +
         "\"result\":" + jsonString(resultValue) + "," +
         "\"pnlR\":" + jsonNumber(pnlRValue) + "," +
         "\"exitReason\":" + jsonString(exitReason) + "," +
         "\"slippage\":0," +
         "\"holdBars\":" + str.tostring(holdBarsValue) + "," +
         "\"holdMinutes\":" + str.tostring(math.max(holdBarsValue, 0) * timeframe.in_seconds() / 60) + "," +
         "\"authToken\":" + jsonString(webhookAuthToken) +
     "}"
    eventType == "SIGNAL_OPEN" ? openPayload : closePayload

var string[] histSetup = array.new_string(0)
var string[] histDirection = array.new_string(0)
var string[] histRegime = array.new_string(0)
var float[] histResultR = array.new_float(0)

var string[] activeTradeId = array.new_string(0)
var string[] activeTradeSetup = array.new_string(0)
var string[] activeTradeDirection = array.new_string(0)
var string[] activeTradeRegime = array.new_string(0)
var string[] activeTradeProfile = array.new_string(0)
var float[] activeTradeEntry = array.new_float(0)
var float[] activeTradeStop = array.new_float(0)
var float[] activeTradeTarget = array.new_float(0)
var float[] activeTradeRr = array.new_float(0)
var int[] activeTradeConfidence = array.new_int(0)
var int[] activeTradeOpenBar = array.new_int(0)
var int[] activeTradeOpenTime = array.new_int(0)

var int adaptiveLossStreak = 0
var int adaptiveCooldownUntilBar = na
var string lastSignalDirection = "NONE"
var string lastSignalSetupType = "NONE"
var int lastSignalConfidence = na
var string lastProfileId = "AUTO_15_TREND_V1"
var string lastCloseReason = "NONE"

calcAdaptiveEdge(targetSetup, targetDirection, targetRegime) =>
    float setupWeighted = 0.0
    float directionWeighted = 0.0
    float regimeWeighted = 0.0
    float setupWeight = 0.0
    float directionWeight = 0.0
    float regimeWeight = 0.0
    historySize = array.size(histResultR)
    if historySize > 0
        int maxCount = math.min(historySize, adaptiveRecentWindow)
        for offset = 0 to maxCount - 1
            idx = historySize - 1 - offset
            weight = 1.0 / (1.0 + offset * 0.35)
            normalizedResult = clamp(array.get(histResultR, idx) / math.max(rrRatio, 1.0), -1.0, 1.0)
            if array.get(histSetup, idx) == targetSetup
                setupWeighted += normalizedResult * weight
                setupWeight += weight
            if array.get(histDirection, idx) == targetDirection
                directionWeighted += normalizedResult * weight
                directionWeight += weight
            if array.get(histRegime, idx) == targetRegime
                regimeWeighted += normalizedResult * weight
                regimeWeight += weight
    setupEdge = setupWeight > 0 ? (setupWeighted / setupWeight) * 6.0 : 0.0
    directionEdge = directionWeight > 0 ? (directionWeighted / directionWeight) * 4.0 : 0.0
    regimeEdge = regimeWeight > 0 ? (regimeWeighted / regimeWeight) * 4.0 : 0.0
    clamp(setupEdge + directionEdge + regimeEdge, -10.0, 10.0)

calcRecentPerformanceEstimate() =>
    historySize = array.size(histResultR)
    if historySize == 0
        50.0
    else
        float weighted = 0.0
        float totalWeight = 0.0
        int maxCount = math.min(historySize, adaptiveRecentWindow)
        for offset = 0 to maxCount - 1
            idx = historySize - 1 - offset
            weight = 1.0 / (1.0 + offset * 0.30)
            normalizedResult = clamp(array.get(histResultR, idx) / math.max(rrRatio, 1.0), -1.0, 1.0)
            weighted += normalizedResult * weight
            totalWeight += weight
        estimate = totalWeight > 0 ? weighted / totalWeight : 0.0
        clamp(50.0 + estimate * 35.0, 0.0, 100.0)

rememberOutcome(setupType, direction, regimeName, pnlRValue) =>
    array.push(histSetup, setupType)
    array.push(histDirection, direction)
    array.push(histRegime, regimeName)
    array.push(histResultR, pnlRValue)
    while array.size(histResultR) > adaptiveRecentWindow
        array.shift(histSetup)
        array.shift(histDirection)
        array.shift(histRegime)
        array.shift(histResultR)

trackOpenSignal(plan) =>
    array.push(activeTradeId, plan.externalTradeId)
    array.push(activeTradeSetup, plan.setupType)
    array.push(activeTradeDirection, plan.direction)
    array.push(activeTradeRegime, plan.regime)
    array.push(activeTradeProfile, plan.profileId)
    array.push(activeTradeEntry, plan.entry)
    array.push(activeTradeStop, plan.sl)
    array.push(activeTradeTarget, plan.tp)
    array.push(activeTradeRr, plan.rr)
    array.push(activeTradeConfidence, plan.confidence)
    array.push(activeTradeOpenBar, bar_index)
    array.push(activeTradeOpenTime, int(time_close))
    while array.size(activeTradeId) > maxTrackedSignals
        array.shift(activeTradeId)
        array.shift(activeTradeSetup)
        array.shift(activeTradeDirection)
        array.shift(activeTradeRegime)
        array.shift(activeTradeProfile)
        array.shift(activeTradeEntry)
        array.shift(activeTradeStop)
        array.shift(activeTradeTarget)
        array.shift(activeTradeRr)
        array.shift(activeTradeConfidence)
        array.shift(activeTradeOpenBar)
        array.shift(activeTradeOpenTime)

// ═══════════════════════════════════════════════════════════════
//  1. ATR + SESSION + CANDLE METRICS
// ═══════════════════════════════════════════════════════════════
atr          = ta.atr(14)
atrMean      = ta.sma(atr, 50)
inSession    = not useSession or not na(time(timeframe.period, sessionTime))
bodySize     = math.abs(close - open)
candleRange  = math.max(high - low, syminfo.mintick)
bodyPct      = bodySize / candleRange
bullCandle   = close > open
bearCandle   = close < open
trendEma     = ta.ema(close, 34)
emaSlope     = (trendEma - trendEma[8]) / math.max(atrMean, syminfo.mintick)

// ADX Fix: Extract ADX from the ta.dmi tuple
[_, _, adxValue] = ta.dmi(14, 14)

bbBasis      = ta.sma(close, 20)
bbDev        = ta.stdev(close, 20) * 2.0
bbWidth      = (bbDev * 2.0) / math.max(math.abs(bbBasis), syminfo.mintick)
bbWidthMean  = ta.sma(bbWidth, 50)
bbWidthRatio = bbWidth / math.max(bbWidthMean, syminfo.mintick)
regimeState  = calcRegime(atr, atrMean, adxValue, emaSlope, bbWidthRatio)

normalizedTf = normalizeTimeframeId(timeframe.period)
selectedProfile = profileMode == "AUTO"
     ? getProfilePack(normalizedTf, regimeState.name)
     : ProfilePack.new(manualProfileId, swingLen, minSweepAtr, sweepRetrace, dispBodyMin, minFvgSizeAtr,
          obSearchBars, maxRiskAtr, manualConfidenceThreshold, manualCooldownBase, useObFvgConf, useHtfBias, sessionPresetLabel())
effSwingLen = selectedProfile.swingLen
effMinSweepAtr = selectedProfile.minSweepAtr
effSweepRetrace = selectedProfile.sweepRetrace
effDispBodyMin = selectedProfile.dispBodyMin
effMinFvgSizeAtr = selectedProfile.minFvgSizeAtr
effObSearchBars = selectedProfile.obSearchBars
effMaxRiskAtr = selectedProfile.maxRiskAtr
effConfidenceThreshold = selectedProfile.confidenceThreshold
effCooldownBase = selectedProfile.cooldownBase
useHtfBiasEff = useHtfBias and selectedProfile.useHtfBias
useObFvgConfEff = useObFvgConf and selectedProfile.useObFvgConf
currentSessionLabel = sessionPresetLabel()

// ═══════════════════════════════════════════════════════════════
//  2. HTF BIAS
// ═══════════════════════════════════════════════════════════════
[htfClose, htfEma, htfAtr] = request.security(
     syminfo.tickerid, htfTf,
     [close, ta.ema(close, htfEmaLen), ta.atr(14)],
     lookahead = barmerge.lookahead_off)

htfBull   = htfClose > htfEma
htfBear   = htfClose < htfEma
htfGap    = math.abs(htfClose - htfEma) / math.max(htfAtr, syminfo.mintick)
htfStrong = htfGap >= 0.40
htfBiasLabel = calcHtfBiasLabel(htfClose, htfEma)

// ═══════════════════════════════════════════════════════════════
//  3. PIVOT-BASED SWING LEVELS
//     Fixed price levels — not rolling windows. This is critical.
//     ta.pivothigh/low only confirm a pivot after pivotHLen bars,
//     so we store the level at the TRUE bar it formed.
// ═══════════════════════════════════════════════════════════════
pivotHLen     = math.max(2, int(math.round(effSwingLen / 2.0)))
pivotH        = ta.pivothigh(high, pivotHLen, pivotHLen)
pivotL        = ta.pivotlow(low,   pivotHLen, pivotHLen)

var float lastSwingH    = na
var float lastSwingL    = na
var int   lastSwingHBar = na
var int   lastSwingLBar = na

if not na(pivotH)
    lastSwingH    := pivotH
    lastSwingHBar := bar_index - pivotHLen

if not na(pivotL)
    lastSwingL    := pivotL
    lastSwingLBar := bar_index - pivotHLen

bsl = lastSwingH   // Buy-Side Liquidity (swing high)
ssl = lastSwingL   // Sell-Side Liquidity (swing low)

// ═══════════════════════════════════════════════════════════════
//  4. TOUCH COUNT HELPER
// ═══════════════════════════════════════════════════════════════
touchTol = atr * 0.15

countTouches(lvl, lookback, isHigh) =>
    int cnt = 0
    for i = 1 to lookback
        if isHigh
            if high[i] >= lvl - touchTol and high[i] <= lvl + touchTol and close[i] < lvl
                cnt += 1
        else
            if low[i] <= lvl + touchTol and low[i] >= lvl - touchTol and close[i] > lvl
                cnt += 1
    cnt

// ═══════════════════════════════════════════════════════════════
//  5. SWEEP DETECTION — 6-FILTER STRICT VERSION
//
//  (a) Wick penetrates level >= minSweepAtr * ATR
//  (b) Close retraces >= sweepRetrace% back inside
//  (c) Body stays on correct side (no full-body breaks)
//  (d) Level age >= minLevelAge bars
//  (e) Level has >= minTouches prior tests
//  (f) Cooldown since last sweep in same direction
//
//  ⚠️  Sweep markers are NOT drawn here.
//      They only appear when displacement CONFIRMS the sweep (Section 7).
//      This prevents the "false sweep" arrows the user reported.
// ═══════════════════════════════════════════════════════════════
var int lastBullSweepBar = na
var int lastBearSweepBar = na

bullPen     = not na(ssl) ? ssl - low  : na
bearPen     = not na(bsl) ? high - bsl : na

bullPenOk   = not na(bullPen) and bullPen >= atr * effMinSweepAtr
bearPenOk   = not na(bearPen) and bearPen >= atr * effMinSweepAtr

bullRetOk   = not na(bullPen) and bullPenOk and close > ssl - bullPen * (1.0 - effSweepRetrace)
bearRetOk   = not na(bearPen) and bearPenOk and close < bsl + bearPen * (1.0 - effSweepRetrace)

bullBodyAbove = math.min(open, close) > ssl
bearBodyBelow = math.max(open, close) < bsl
bullWickOk  = not requireWick or bullBodyAbove
bearWickOk  = not requireWick or bearBodyBelow

bullLvlAge  = not na(lastSwingLBar) ? bar_index - lastSwingLBar : 0
bearLvlAge  = not na(lastSwingHBar) ? bar_index - lastSwingHBar : 0
bullAgeOk   = bullLvlAge >= minLevelAge
bearAgeOk   = bearLvlAge >= minLevelAge

bullTouchOk = minTouches <= 1 or (not na(ssl) and countTouches(ssl, math.min(bullLvlAge, 30), false) >= minTouches - 1)
bearTouchOk = minTouches <= 1 or (not na(bsl) and countTouches(bsl, math.min(bearLvlAge, 30), true)  >= minTouches - 1)

bullCoolOk  = na(lastBullSweepBar) or bar_index - lastBullSweepBar >= effCooldownBase
bearCoolOk  = na(lastBearSweepBar) or bar_index - lastBearSweepBar >= effCooldownBase

bullSwept   = low  < ssl and bullPenOk and bullRetOk and bullWickOk and bullAgeOk and bullTouchOk and bullCoolOk
bearSwept   = high > bsl and bearPenOk and bearRetOk and bearWickOk and bearAgeOk and bearTouchOk and bearCoolOk

if bullSwept
    lastBullSweepBar := bar_index
if bearSwept
    lastBearSweepBar := bar_index

// ═══════════════════════════════════════════════════════════════
//  6. FVG DETECTION (CONFLUENCE — for OB setup)
// ═══════════════════════════════════════════════════════════════
bullFvgConf = bar_index >= 2 and low > high[2]
bearFvgConf = bar_index >= 2 and high < low[2]

var float lastBullFvgConfHi  = na
var float lastBullFvgConfLo  = na
var int   lastBullFvgConfIdx = na
var float lastBearFvgConfHi  = na
var float lastBearFvgConfLo  = na
var int   lastBearFvgConfIdx = na

if bullFvgConf
    lastBullFvgConfHi  := low
    lastBullFvgConfLo  := high[2]
    lastBullFvgConfIdx := bar_index

if bearFvgConf
    lastBearFvgConfHi  := low[2]
    lastBearFvgConfLo  := high
    lastBearFvgConfIdx := bar_index

// ═══════════════════════════════════════════════════════════════
//  7. DISPLACEMENT CANDLE + ORDER BLOCK FINDER
// ═══════════════════════════════════════════════════════════════
bullDisplace = bullCandle and bodyPct >= effDispBodyMin
bearDisplace = bearCandle and bodyPct >= effDispBodyMin

findBullOB() =>
    float obHi = na
    float obLo = na
    float best = -999.0
    for i = 1 to effObSearchBars
        isOpp = close[i] < open[i]
        bAtr  = math.abs(open[i] - close[i]) / math.max(atr[i], syminfo.mintick)
        wkPct = (high[i] - close[i]) / math.max(high[i] - low[i], syminfo.mintick)
        sc    = (isOpp ? 1.0 : -99.0) + bAtr * 0.5 + (1.0 - wkPct) * 0.5 - i * 0.04
        if isOpp and bAtr >= 0.10 and sc > best
            best := sc
            obHi := math.max(open[i], close[i])
            obLo := low[i]
    [obHi, obLo]

findBearOB() =>
    float obHi = na
    float obLo = na
    float best = -999.0
    for i = 1 to effObSearchBars
        isOpp = close[i] > open[i]
        bAtr  = math.abs(open[i] - close[i]) / math.max(atr[i], syminfo.mintick)
        wkPct = (close[i] - low[i]) / math.max(high[i] - low[i], syminfo.mintick)
        sc    = (isOpp ? 1.0 : -99.0) + bAtr * 0.5 + (1.0 - wkPct) * 0.5 - i * 0.04
        if isOpp and bAtr >= 0.10 and sc > best
            best := sc
            obHi := high[i]
            obLo := math.min(open[i], close[i])
    [obHi, obLo]

// ═══════════════════════════════════════════════════════════════
//  8. GRADING HELPERS
// ═══════════════════════════════════════════════════════════════
gradeObSignal(hasFvg, htfAligned, htfIsStrong, isInSession, sweepDepthR) =>
    pts = 1
    pts += hasFvg       ? 1 : 0
    pts += htfAligned   ? 1 : 0
    pts += htfIsStrong  ? 1 : 0
    pts += isInSession  ? 1 : 0
    pts += sweepDepthR >= 0.40 ? 1 : 0
    pts >= 5 ? "A" : pts >= 4 ? "A" : pts >= 3 ? "B" : "C"

gradeFvgSignal(htfAligned, htfIsStrong, isInSession, fvgSizeR) =>
    pts = 1
    pts += htfAligned   ? 1 : 0
    pts += htfIsStrong  ? 1 : 0
    pts += isInSession  ? 1 : 0
    pts += fvgSizeR >= 0.60 ? 1 : 0   // large gap = better reaction expected
    pts >= 4 ? "A" : pts >= 3 ? "B" : "C"

// ═══════════════════════════════════════════════════════════════
//  9. SWEEP + OB STATE MACHINE
//     0=Idle  1=Swept  2=OB Armed  3=Retest (entry bar)
// ═══════════════════════════════════════════════════════════════
var int    bullSt      = 0
var int    bearSt      = 0
var float  bullObHi    = na
var float  bullObLo    = na
var float  bearObHi    = na
var float  bearObLo    = na
var float  bullObMid   = na
var float  bearObMid   = na
var int    bullStBar   = na
var int    bearStBar   = na
var bool   bullHasFvg  = false
var bool   bearHasFvg  = false
var float  bullFvgConfHi = na
var float  bullFvgConfLo = na
var float  bearFvgConfHi = na
var float  bearFvgConfLo = na
var string bullGrade   = "C"
var string bearGrade   = "C"
var float  bullMitPct  = 0.0
var float  bearMitPct  = 0.0
var float  bullSweepD  = na
var float  bearSweepD  = na

// Tracks whether a confirmed sweep+displacement just happened (for markers)
var bool bullSweepConfirmed = false
var bool bearSweepConfirmed = false

barMov  = ta.sma(math.abs(close - close[1]), 8)
zoneExp = int(clamp(math.ceil(2.5 * atr / math.max(barMov, syminfo.mintick * 5)), 10, 40))

// ── BULL ──────────────────────────────────────────────────────
bullSweepConfirmed := false

// Idle → Swept
if bullSt == 0 and bullSwept
    bullSt     := 1
    bullStBar  := bar_index
    bullSweepD := nz(bullPen, 0) / math.max(atr, syminfo.mintick)

// Swept → OB Armed  (displacement CONFIRMS the sweep — only now draw marker)
if bullSt == 1 and bullDisplace
    [bHi, bLo] = findBullOB()
    if not na(bHi)
        bullSt      := 2
        bullObHi    := bHi
        bullObLo    := bLo
        bullObMid   := (bHi + bLo) / 2.0
        bullMitPct  := 0.0
        hasFvgNear   = not na(lastBullFvgConfIdx) and bar_index - lastBullFvgConfIdx <= fvgConfLookback
        bullHasFvg  := hasFvgNear
        bullFvgConfHi := hasFvgNear ? lastBullFvgConfHi : na
        bullFvgConfLo := hasFvgNear ? lastBullFvgConfLo : na
        bullGrade   := gradeObSignal(hasFvgNear, htfBull, htfStrong, inSession, nz(bullSweepD, 0))
        bullStBar   := bar_index
        bullSweepConfirmed := true   // ← marker fires NOW (sweep was real)
    else
        bullSt := 0

// OB Armed: track mitigation, wait for price to return to zone
if bullSt == 2 and not na(bullObHi) and not na(bullObLo)
    zR   = math.max(bullObHi - bullObLo, syminfo.mintick)
    pen  = math.max(0.0, bullObHi - math.max(low, bullObLo))
    bullMitPct := math.max(bullMitPct, pen / zR)
    if low <= bullObHi and high >= bullObLo
        bullSt    := 3
        bullStBar := bar_index

bullZoneExp    = bullSt != 0 and not na(bullStBar) and bar_index - bullStBar > zoneExp
bullZoneBroken = bullSt >= 2 and not na(bullObLo) and close < bullObLo - atr * 0.20
bullOverMit    = bullSt >= 2 and bullMitPct > 0.55

if bullZoneExp or bullZoneBroken or bullOverMit or (bullSt >= 1 and bearSwept)
    bullSt    := 0
    bullObHi  := na
    bullObLo  := na
    bullObMid := na
    bullHasFvg := false

// ── BEAR ──────────────────────────────────────────────────────
bearSweepConfirmed := false

if bearSt == 0 and bearSwept
    bearSt     := 1
    bearStBar  := bar_index
    bearSweepD := nz(bearPen, 0) / math.max(atr, syminfo.mintick)

if bearSt == 1 and bearDisplace
    [bHi, bLo] = findBearOB()
    if not na(bHi)
        bearSt      := 2
        bearObHi    := bHi
        bearObLo    := bLo
        bearObMid   := (bHi + bLo) / 2.0
        bearMitPct  := 0.0
        hasFvgNear   = not na(lastBearFvgConfIdx) and bar_index - lastBearFvgConfIdx <= fvgConfLookback
        bearHasFvg  := hasFvgNear
        bearFvgConfHi := hasFvgNear ? lastBearFvgConfHi : na
        bearFvgConfLo := hasFvgNear ? lastBearFvgConfLo : na
        bearGrade   := gradeObSignal(hasFvgNear, htfBear, htfStrong, inSession, nz(bearSweepD, 0))
        bearStBar   := bar_index
        bearSweepConfirmed := true
    else
        bearSt := 0

if bearSt == 2 and not na(bearObHi) and not na(bearObLo)
    zR   = math.max(bearObHi - bearObLo, syminfo.mintick)
    pen  = math.max(0.0, math.min(high, bearObHi) - bearObLo)
    bearMitPct := math.max(bearMitPct, pen / zR)
    if high >= bearObLo and low <= bearObHi
        bearSt    := 3
        bearStBar := bar_index

bearZoneExp    = bearSt != 0 and not na(bearStBar) and bar_index - bearStBar > zoneExp
bearZoneBroken = bearSt >= 2 and not na(bearObHi) and close > bearObHi + atr * 0.20
bearOverMit    = bearSt >= 2 and bearMitPct > 0.55

if bearZoneExp or bearZoneBroken or bearOverMit or (bearSt >= 1 and bullSwept)
    bearSt    := 0
    bearObHi  := na
    bearObLo  := na
    bearObMid := na
    bearHasFvg := false

// ═══════════════════════════════════════════════════════════════
//  10. SWEEP + OB ENTRY SIGNALS
// ═══════════════════════════════════════════════════════════════
bullConfirm = bullCandle and bodyPct >= 0.50 and not na(bullObMid) and close >= bullObMid
bearConfirm = bearCandle and bodyPct >= 0.50 and not na(bearObMid) and close <= bearObMid

htfBullPass = not useHtfBiasEff or htfBull
htfBearPass = not useHtfBiasEff or htfBear
fvgBullPass = not useObFvgConfEff or bullHasFvg
fvgBearPass = not useObFvgConfEff or bearHasFvg

buySignal   = bullSt == 3 and bullConfirm and htfBullPass and fvgBullPass and inSession and barstate.isconfirmed
sellSignal  = bearSt == 3 and bearConfirm and htfBearPass and fvgBearPass and inSession and barstate.isconfirmed

var int lastBuyBar  = na
var int lastSellBar = na
buySignal  := buySignal  and (na(lastBuyBar)  or bar_index - lastBuyBar  > 3)
sellSignal := sellSignal and (na(lastSellBar) or bar_index - lastSellBar > 3)

if buySignal
    bullSt     := 0

if sellSignal
    bearSt      := 0

// ═══════════════════════════════════════════════════════════════
//  11. STANDALONE FVG MITIGATION SETUP
//
//  Logic:
//  A) Register a "significant FVG" when:
//     - Standard FVG condition (gap between candles)
//     - Gap >= minFvgSizeAtr * ATR
//     - The candle creating the gap has body% >= fvgBodyMin
//       (ensures it formed during real displacement, not drift)
//     - HTF bias aligned (bear FVG needs HTF bearish, bull FVG needs HTF bullish)
//
//  B) Each bar, check each active FVG:
//     - Has price entered the zone? (bar touches fvgLo → fvgHi)
//     - Is there a rejection confirmation candle?
//     - HTF aligned, in session?
//     → Signal fires
//
//  C) FVG is invalidated when:
//     - Fully filled: close beyond distal edge
//     - Expired: > fvgExpBars old
//     - Signal already fired from this zone
//
//  Bear FVG: high < low[2] → gap at top of a downward move
//     fvgHi = low[2] (distal — stop goes above here)
//     fvgLo = high   (proximal — entry near here)
//     Price retraces UP into zone → sell rejection
//
//  Bull FVG: low > high[2] → gap at bottom of an upward move
//     fvgHi = low    (proximal — entry near here)
//     fvgLo = high[2] (distal — stop goes below here)
//     Price retraces DOWN into zone → buy rejection
// ═══════════════════════════════════════════════════════════════

// ── Storage arrays for active FVG zones ───────────────────────
// Bear FVGs  (price retraces UP into these → sell)
//   sfHi = distal  (stop goes above this)
//   sfLo = proximal (price touches this first on retracement)
var float[] sfHi      = array.new_float(0)
var float[] sfLo      = array.new_float(0)
var float[] sfSize    = array.new_float(0)
var int[]   sfBar     = array.new_int(0)
var box[]   sfBox     = array.new_box(0)
var bool[]  sfTouched = array.new_bool(0)   // true once price has entered zone

// Bull FVGs  (price retraces DOWN into these → buy)
//   bfHi = proximal (price touches this first on retracement)
//   bfLo = distal  (stop goes below this)
var float[] bfHi      = array.new_float(0)
var float[] bfLo      = array.new_float(0)
var float[] bfSize    = array.new_float(0)
var int[]   bfBar     = array.new_int(0)
var box[]   bfBox     = array.new_box(0)
var bool[]  bfTouched = array.new_bool(0)

// ── Register new significant FVGs ─────────────────────────────
//  Bear FVG: current high < low[2]  →  gap above current price
//    distal  = low[2]  (top of gap,  stop above here)
//    proximal= high    (bottom of gap, price hits this first on retrace up)
isBearFvgDisplace = bearCandle[1] and
     (math.abs(close[1] - open[1]) / math.max(high[1] - low[1], syminfo.mintick)) >= fvgBodyMin
isBearFvgSig = high < low[2] and (low[2] - high) >= atr * effMinFvgSizeAtr and isBearFvgDisplace

if useFvgSetup and isBearFvgSig and (not useHtfBiasEff or htfBear) and array.size(sfHi) < maxActiveFvg
    fHi  = low[2]
    fLo  = high
    newBox = showFvgZones ? box.new(bar_index - 2, fHi, bar_index, fLo,
         bgcolor      = color.new(fvgCol, 88),
         border_color = color.new(fvgCol, 45),
         border_width = 1) : na
    array.push(sfHi,     fHi)
    array.push(sfLo,     fLo)
    array.push(sfSize,   fHi - fLo)
    array.push(sfBar,    bar_index)
    array.push(sfBox,    newBox)
    array.push(sfTouched, false)

//  Bull FVG: current low > high[2]  →  gap below current price
//    proximal= low    (top of gap, price hits this first on retrace down)
//    distal  = high[2] (bottom of gap, stop below here)
isBullFvgDisplace = bullCandle[1] and
     (math.abs(close[1] - open[1]) / math.max(high[1] - low[1], syminfo.mintick)) >= fvgBodyMin
isBullFvgSig = low > high[2] and (low - high[2]) >= atr * effMinFvgSizeAtr and isBullFvgDisplace

if useFvgSetup and isBullFvgSig and (not useHtfBiasEff or htfBull) and array.size(bfHi) < maxActiveFvg
    fHi  = low
    fLo  = high[2]
    newBox = showFvgZones ? box.new(bar_index - 2, fHi, bar_index, fLo,
         bgcolor      = color.new(fvgCol, 88),
         border_color = color.new(fvgCol, 45),
         border_width = 1) : na
    array.push(bfHi,     fHi)
    array.push(bfLo,     fLo)
    array.push(bfSize,   fHi - fLo)
    array.push(bfBar,    bar_index)
    array.push(bfBox,    newBox)
    array.push(bfTouched, false)

// ── Extend active FVG boxes ────────────────────────────────────
if array.size(sfHi) > 0
    for i = 0 to array.size(sfHi) - 1
        b = array.get(sfBox, i)
        if not na(b)
            box.set_right(b, bar_index)

if array.size(bfHi) > 0
    for i = 0 to array.size(bfHi) - 1
        b = array.get(bfBox, i)
        if not na(b)
            box.set_right(b, bar_index)

// ── FVG Signal Variables ───────────────────────────────────────
var bool   fvgBuySignal  = false
var bool   fvgSellSignal = false
var float  fvgBuyEntry   = na
var float  fvgBuySL      = na
var float  fvgBuyTP      = na
var float  fvgBuyTP1     = na
var string fvgBuyGrade   = "C"
var float  fvgBuySizeAtr = na
var float  fvgSellEntry  = na
var float  fvgSellSL     = na
var float  fvgSellTP     = na
var float  fvgSellTP1    = na
var string fvgSellGrade  = "C"
var float  fvgSellSizeAtr = na

fvgBuySignal  := false
fvgSellSignal := false
fvgBuySizeAtr := na
fvgSellSizeAtr := na

// ── Check Bear FVG zones → SELL signals ───────────────────────
//
//  Five quality gates (all must pass):
//  1. PROXIMAL ENTRY: close is within fvgEntryDepth% of the zone from
//     the proximal edge (fLo). Prevents deep-in-zone wide-stop entries.
//  2. FIRST TOUCH ONLY: signal only fires on the bar price first
//     enters the zone, tracked via sfTouched.
//  3. CAME FROM OUTSIDE: the previous bar must have been BELOW fLo,
//     confirming a true retracement into the zone, not ranging inside it.
//  4. APPROACH MOMENTUM: at least one of the two bars before entry was
//     bullish (rising), confirming price was actively retracing up.
//  5. MAX RISK: SL distance must be < maxRiskAtr * ATR.
//
if useFvgSetup and array.size(sfHi) > 0
    int i = 0
    while i < array.size(sfHi)
        fHi     = array.get(sfHi,     i)
        fLo     = array.get(sfLo,     i)
        fAge    = bar_index - array.get(sfBar, i)
        fSz     = array.get(sfSize,   i)
        touched = array.get(sfTouched, i)

        // ── Expiry / full fill ──
        fullFill = close < fLo - atr * 0.20   // closed significantly below proximal = zone broken
        if fAge > fvgExpBars or fullFill
            b = array.get(sfBox, i)
            if not na(b)
                box.delete(b)
            array.remove(sfHi,     i)
            array.remove(sfLo,     i)
            array.remove(sfSize,   i)
            array.remove(sfBar,    i)
            array.remove(sfBox,    i)
            array.remove(sfTouched,i)
            continue

        // ── Track first touch ──
        // touched was false before this bar = this IS the first touch bar
        priceInZone      = high >= fLo and low <= fHi
        priceJustEntered = priceInZone and not touched
        if priceInZone and not touched
            array.set(sfTouched, i, true)

        // ── Gate 1: Proximal entry — close in first fvgEntryDepth of zone from fLo ──
        proximalCeiling   = fLo + (fHi - fLo) * fvgEntryDepth
        entryNearProximal = close <= proximalCeiling

        // ── Gate 3: Came from outside — prev bar was below fLo (entered from below) ──
        cameFromBelow = low[1] < fLo

        // ── Gate 4: Approach momentum — recent bars trending up (retracing into zone) ──
        approachUp = (close[1] > open[1]) or (close[2] > open[2])

        // ── Gate 5: Max risk ──
        potentialSL   = fHi + atr * stopBuf
        potentialRisk = math.abs(close - potentialSL)
        riskOk        = potentialRisk <= effMaxRiskAtr * atr

        // ── Rejection candle ──
        rejection = bearCandle and bodyPct >= 0.45 and entryNearProximal

        if priceJustEntered and rejection and cameFromBelow and approachUp and riskOk and
             inSession and (not useHtfBiasEff or htfBear)
            fvgSellSignal := true
            fvgSellEntry  := close
            fvgSellSL     := potentialSL
            fvgRisk        = potentialRisk
            fvgSellTP     := fvgSellEntry - fvgRisk * rrRatio
            fvgSellTP1    := fvgSellEntry - fvgRisk
            fvgSellGrade  := gradeFvgSignal(htfBear, htfStrong, inSession, fSz / math.max(atr, syminfo.mintick))
            fvgSellSizeAtr := fSz / math.max(atr, syminfo.mintick)
            b = array.get(sfBox, i)
            if not na(b)
                box.delete(b)
            array.remove(sfHi,     i)
            array.remove(sfLo,     i)
            array.remove(sfSize,   i)
            array.remove(sfBar,    i)
            array.remove(sfBox,    i)
            array.remove(sfTouched,i)
            break

        i += 1

// ── Check Bull FVG zones → BUY signals ────────────────────────
//  Mirror logic: price retraces DOWN into a bull FVG.
//  Gate 1: close within fvgEntryDepth from bfHi (proximal, top of gap)
//  Gate 3: previous bar high was above bfHi (price came from above)
//  Gate 4: approach was bearish (retracing down)
//
if useFvgSetup and array.size(bfHi) > 0
    int j = 0
    while j < array.size(bfHi)
        fHi     = array.get(bfHi,     j)
        fLo     = array.get(bfLo,     j)
        fAge    = bar_index - array.get(bfBar, j)
        fSz     = array.get(bfSize,   j)
        touched = array.get(bfTouched, j)

        fullFill = close > fHi + atr * 0.20
        if fAge > fvgExpBars or fullFill
            b = array.get(bfBox, j)
            if not na(b)
                box.delete(b)
            array.remove(bfHi,     j)
            array.remove(bfLo,     j)
            array.remove(bfSize,   j)
            array.remove(bfBar,    j)
            array.remove(bfBox,    j)
            array.remove(bfTouched,j)
            continue

        priceInZone      = low <= fHi and high >= fLo
        priceJustEntered = priceInZone and not touched
        if priceInZone and not touched
            array.set(bfTouched, j, true)

        // Gate 1: close within fvgEntryDepth from proximal (fHi = top of gap)
        proximalFloor     = fHi - (fHi - fLo) * fvgEntryDepth
        entryNearProximal = close >= proximalFloor

        // Gate 3: prev bar was above fHi (price entered from above)
        cameFromAbove = high[1] > fHi

        // Gate 4: approach was bearish (retracing down into zone)
        approachDown = (close[1] < open[1]) or (close[2] < open[2])

        potentialSL   = fLo - atr * stopBuf
        potentialRisk = math.abs(close - potentialSL)
        riskOk        = potentialRisk <= effMaxRiskAtr * atr

        rejection = bullCandle and bodyPct >= 0.45 and entryNearProximal

        if priceJustEntered and rejection and cameFromAbove and approachDown and riskOk and
             inSession and (not useHtfBiasEff or htfBull)
            fvgBuySignal  := true
            fvgBuyEntry   := close
            fvgBuySL      := potentialSL
            fvgRisk        = potentialRisk
            fvgBuyTP      := fvgBuyEntry + fvgRisk * rrRatio
            fvgBuyTP1     := fvgBuyEntry + fvgRisk
            fvgBuyGrade   := gradeFvgSignal(htfBull, htfStrong, inSession, fSz / math.max(atr, syminfo.mintick))
            fvgBuySizeAtr := fSz / math.max(atr, syminfo.mintick)
            b = array.get(bfBox, j)
            if not na(b)
                box.delete(b)
            array.remove(bfHi,     j)
            array.remove(bfLo,     j)
            array.remove(bfSize,   j)
            array.remove(bfBar,    j)
            array.remove(bfBox,    j)
            array.remove(bfTouched,j)
            break

        j += 1


// ═══════════════════════════════════════════════════════════════
//  12. OB LEVELS FOR TRADE BOXES
// ═══════════════════════════════════════════════════════════════
bullStop  = not na(bullObLo) ? bullObLo - atr * stopBuf : na
bearStop  = not na(bearObHi) ? bearObHi + atr * stopBuf : na
bullRisk  = not na(bullStop) ? math.abs(close - bullStop) : na
bearRisk  = not na(bearStop) ? math.abs(close - bearStop) : na
bullTP    = not na(bullRisk) ? close + bullRisk * rrRatio : na
bearTP    = not na(bearRisk) ? close - bearRisk * rrRatio : na
bullTP1   = not na(bullRisk) ? close + bullRisk          : na
bearTP1   = not na(bearRisk) ? close - bearRisk          : na

bullObSizeAtr = not na(bullObHi) and not na(bullObLo) ? (bullObHi - bullObLo) / math.max(atr, syminfo.mintick) : na
bearObSizeAtr = not na(bearObHi) and not na(bearObLo) ? (bearObHi - bearObLo) / math.max(atr, syminfo.mintick) : na
bullAdaptiveEdge = calcAdaptiveEdge("SWEEP_OB_REVERSAL", "LONG", regimeState.name)
bearAdaptiveEdge = calcAdaptiveEdge("SWEEP_OB_REVERSAL", "SHORT", regimeState.name)
fvgBuyAdaptiveEdge = calcAdaptiveEdge("FVG_MITIGATION", "LONG", regimeState.name)
fvgSellAdaptiveEdge = calcAdaptiveEdge("FVG_MITIGATION", "SHORT", regimeState.name)
cooldownBarsLeft = na(adaptiveCooldownUntilBar) ? 0 : math.max(adaptiveCooldownUntilBar - bar_index, 0)
cooldownActive = cooldownBarsLeft > 0
baseLossPenalty = math.min(adaptiveLossStreak * 2.0, 8.0)
bullConfidence = scoreSetupCandidate("SWEEP_OB_REVERSAL", nz(bullSweepD, 0.0), bodyPct, bullObSizeAtr, true, bullHasFvg, htfBullPass, htfStrong, inSession, regimeState.name, regimeState.atrRatio, bullAdaptiveEdge, baseLossPenalty)
bearConfidence = scoreSetupCandidate("SWEEP_OB_REVERSAL", nz(bearSweepD, 0.0), bodyPct, bearObSizeAtr, true, bearHasFvg, htfBearPass, htfStrong, inSession, regimeState.name, regimeState.atrRatio, bearAdaptiveEdge, baseLossPenalty)
fvgBuyConfidence = scoreSetupCandidate("FVG_MITIGATION", 0.0, bodyPct, fvgBuySizeAtr, false, true, htfBull or not useHtfBiasEff, htfStrong, inSession, regimeState.name, regimeState.atrRatio, fvgBuyAdaptiveEdge, baseLossPenalty)
fvgSellConfidence = scoreSetupCandidate("FVG_MITIGATION", 0.0, bodyPct, fvgSellSizeAtr, false, true, htfBear or not useHtfBiasEff, htfStrong, inSession, regimeState.name, regimeState.atrRatio, fvgSellAdaptiveEdge, baseLossPenalty)

bullRiskFilterOk = not na(bullRisk) and bullRisk <= effMaxRiskAtr * atr
bearRiskFilterOk = not na(bearRisk) and bearRisk <= effMaxRiskAtr * atr
thresholdShiftBull = int(math.round(clamp(-bullAdaptiveEdge, -adaptiveMaxShift, adaptiveMaxShift)))
thresholdShiftBear = int(math.round(clamp(-bearAdaptiveEdge, -adaptiveMaxShift, adaptiveMaxShift)))
thresholdShiftFvgBuy = int(math.round(clamp(-fvgBuyAdaptiveEdge, -adaptiveMaxShift, adaptiveMaxShift)))
thresholdShiftFvgSell = int(math.round(clamp(-fvgSellAdaptiveEdge, -adaptiveMaxShift, adaptiveMaxShift)))
cooldownTightening = cooldownActive ? 6 : 0
bullMinConfidence = int(clamp(effConfidenceThreshold + thresholdShiftBull + adaptiveLossStreak + cooldownTightening, 40, 95))
bearMinConfidence = int(clamp(effConfidenceThreshold + thresholdShiftBear + adaptiveLossStreak + cooldownTightening, 40, 95))
fvgBuyMinConfidence = int(clamp(effConfidenceThreshold + thresholdShiftFvgBuy + adaptiveLossStreak + cooldownTightening, 40, 95))
fvgSellMinConfidence = int(clamp(effConfidenceThreshold + thresholdShiftFvgSell + adaptiveLossStreak + cooldownTightening, 40, 95))

buySignal := buySignal and bullRiskFilterOk and bullConfidence >= bullMinConfidence
sellSignal := sellSignal and bearRiskFilterOk and bearConfidence >= bearMinConfidence
fvgBuySignal := fvgBuySignal and fvgBuyConfidence >= fvgBuyMinConfidence and barstate.isconfirmed
fvgSellSignal := fvgSellSignal and fvgSellConfidence >= fvgSellMinConfidence and barstate.isconfirmed

if buySignal
    lastBuyBar := bar_index
if sellSignal
    lastSellBar := bar_index

// ═══════════════════════════════════════════════════════════════
//  13. VISUAL — OB ZONE BOXES
// ═══════════════════════════════════════════════════════════════
var box bullObBox     = na
var box bearObBox     = na
var box bullObFvgBox  = na
var box bearObFvgBox  = na

if bullSt == 2 and na(bullObBox) and not na(bullObHi) and not na(bullObLo) and showOBZone
    bullObBox := box.new(bar_index - effObSearchBars, bullObHi, bar_index, bullObLo,
         bgcolor = color.new(bullCol, 84), border_color = color.new(bullCol, 40), border_width = 1)

if bearSt == 2 and na(bearObBox) and not na(bearObHi) and not na(bearObLo) and showOBZone
    bearObBox := box.new(bar_index - effObSearchBars, bearObHi, bar_index, bearObLo,
         bgcolor = color.new(bearCol, 84), border_color = color.new(bearCol, 40), border_width = 1)

if bullSt == 2 and na(bullObFvgBox) and bullHasFvg and not na(bullFvgConfHi) and not na(bullFvgConfLo) and showObFvgConf
    bullObFvgBox := box.new(bar_index - fvgConfLookback, bullFvgConfHi, bar_index, bullFvgConfLo,
         bgcolor = color.new(#5b9cf6, 92), border_color = color.new(#5b9cf6, 55), border_style = line.style_dashed)

if bearSt == 2 and na(bearObFvgBox) and bearHasFvg and not na(bearFvgConfHi) and not na(bearFvgConfLo) and showObFvgConf
    bearObFvgBox := box.new(bar_index - fvgConfLookback, bearFvgConfHi, bar_index, bearFvgConfLo,
         bgcolor = color.new(#5b9cf6, 92), border_color = color.new(#5b9cf6, 55), border_style = line.style_dashed)

if not na(bullObBox)    and (bullSt == 2 or bullSt == 3)
    box.set_right(bullObBox,    bar_index)
if not na(bullObFvgBox) and (bullSt == 2 or bullSt == 3)
    box.set_right(bullObFvgBox, bar_index)
if not na(bearObBox)    and (bearSt == 2 or bearSt == 3)
    box.set_right(bearObBox,    bar_index)
if not na(bearObFvgBox) and (bearSt == 2 or bearSt == 3)
    box.set_right(bearObFvgBox, bar_index)

if bullSt == 0
    if not na(bullObBox)
        box.delete(bullObBox)
        bullObBox := na
    if not na(bullObFvgBox)
        box.delete(bullObFvgBox)
        bullObFvgBox := na

if bearSt == 0
    if not na(bearObBox)
        box.delete(bearObBox)
        bearObBox := na
    if not na(bearObFvgBox)
        box.delete(bearObFvgBox)
        bearObFvgBox := na

// ═══════════════════════════════════════════════════════════════
//  14. TRADE ZONE BOXES
//      Stack of 3 colored boxes per signal:
//        Red zone   = SL area (entry → stop)
//        Green zone = TP1 area (entry → 1R)   ← take partials
//        Light zone = TP2 area (1R → full TP)
//      4 key lines: Entry (white), SL (red dashed), TP1 (dotted), TP2 (solid bold)
// ═══════════════════════════════════════════════════════════════
drawTradeBoxes(entryPrice, slPrice, tp1Price, tp2Price, isBull) =>
    slBg    = color.new(bearCol, 82)
    slBrd   = color.new(bearCol, 45)
    tp1Bg   = isBull ? color.new(bullCol, 76) : color.new(bullCol, 76)
    tp1Brd  = isBull ? color.new(bullCol, 38) : color.new(bullCol, 38)
    tp2Bg   = isBull ? color.new(bullCol, 90) : color.new(bullCol, 90)
    tp2Brd  = isBull ? color.new(bullCol, 62) : color.new(bullCol, 62)
    ext     = bar_index + tradeExtBars

    // SL box
    if isBull
        box.new(bar_index, entryPrice, ext, slPrice,
             bgcolor = slBg, border_color = slBrd, border_width = 1)
        box.new(bar_index, tp1Price, ext, entryPrice,
             bgcolor = tp1Bg, border_color = tp1Brd, border_width = 1)
        box.new(bar_index, tp2Price, ext, tp1Price,
             bgcolor = tp2Bg, border_color = tp2Brd, border_style = line.style_dashed, border_width = 1)
    else
        box.new(bar_index, slPrice, ext, entryPrice,
             bgcolor = slBg, border_color = slBrd, border_width = 1)
        box.new(bar_index, entryPrice, ext, tp1Price,
             bgcolor = tp1Bg, border_color = tp1Brd, border_width = 1)
        box.new(bar_index, tp1Price, ext, tp2Price,
             bgcolor = tp2Bg, border_color = tp2Brd, border_style = line.style_dashed, border_width = 1)

    // Lines
    line.new(bar_index, entryPrice, ext, entryPrice, color = color.new(color.white, 30), style = line.style_solid,  width = 1)
    line.new(bar_index, slPrice,    ext, slPrice,    color = color.new(bearCol, 15),     style = line.style_dashed, width = 1)
    line.new(bar_index, tp1Price,   ext, tp1Price,   color = color.new(bullCol, 20),     style = line.style_dotted, width = 1)
    line.new(bar_index, tp2Price,   ext, tp2Price,   color = color.new(bullCol, 5),      style = line.style_dashed, width = 2)

// Draw for OB signals
if buySignal  and not na(bullStop) and not na(bullTP) and not na(bullTP1)
    drawTradeBoxes(close, bullStop, bullTP1, bullTP, true)

if sellSignal and not na(bearStop) and not na(bearTP) and not na(bearTP1)
    drawTradeBoxes(close, bearStop, bearTP1, bearTP, false)

// Draw for FVG signals
if fvgBuySignal  and not na(fvgBuySL) and not na(fvgBuyTP) and not na(fvgBuyTP1)
    drawTradeBoxes(fvgBuyEntry, fvgBuySL, fvgBuyTP1, fvgBuyTP, true)

if fvgSellSignal and not na(fvgSellSL) and not na(fvgSellTP) and not na(fvgSellTP1)
    drawTradeBoxes(fvgSellEntry, fvgSellSL, fvgSellTP1, fvgSellTP, false)

// ═══════════════════════════════════════════════════════════════
//  15. SIGNAL LABELS
// ═══════════════════════════════════════════════════════════════
// OB Signals — solid filled labels
if buySignal
    gl = bullGrade
    label.new(bar_index, low - atr * 0.65,
         "▲  BUY  " + gl + "  " + str.tostring(bullConfidence),
         style = label.style_label_up, color = gradeColor(gl), textcolor = color.white, size = size.normal)

if sellSignal
    gl = bearGrade
    label.new(bar_index, high + atr * 0.65,
         "▼  SELL  " + gl + "  " + str.tostring(bearConfidence),
         style = label.style_label_down, color = gradeColor(gl), textcolor = color.white, size = size.normal)

// FVG Signals — distinct diamond labels
if fvgBuySignal
    gl = fvgBuyGrade
    label.new(bar_index, low - atr * 0.65,
         "◆  FVG BUY  " + gl + "  " + str.tostring(fvgBuyConfidence),
         style = label.style_label_up, color = fvgGradeColor(gl), textcolor = color.white, size = size.normal)

if fvgSellSignal
    gl = fvgSellGrade
    label.new(bar_index, high + atr * 0.65,
         "◆  FVG SELL  " + gl + "  " + str.tostring(fvgSellConfidence),
         style = label.style_label_down, color = fvgGradeColor(gl), textcolor = color.white, size = size.normal)

// Sweep Confirmation Markers — only after BOTH sweep + displacement confirmed
// These appear on the displacement bar, NOT on the raw sweep bar
if showSweepConf and bullSweepConfirmed
    label.new(bar_index, low - atr * 0.15, "↑",
         style = label.style_label_up, color = color.new(bullCol, 60), textcolor = color.white, size = size.tiny)

if showSweepConf and bearSweepConfirmed
    label.new(bar_index, high + atr * 0.15, "↓",
         style = label.style_label_down, color = color.new(bearCol, 60), textcolor = color.white, size = size.tiny)

// ── Background tint — active OB setup ─────────────────────────
bgBull = bullSt == 2 or bullSt == 3
bgBear = bearSt == 2 or bearSt == 3
bgcolor(bgBull ? color.new(bullCol, 97) : bgBear ? color.new(bearCol, 97) : na, title = "OB Setup BG")

// ── HTF EMA ───────────────────────────────────────────────────
plot(htfEma, "HTF EMA",
     color = htfBull ? color.new(bullCol, 45) : color.new(bearCol, 45), linewidth = 2)

// ═══════════════════════════════════════════════════════════════
//  16. PERFORMANCE TRACKING
// ═══════════════════════════════════════════════════════════════
var int   totalTrades = 0
var int   totalWins   = 0
var int   totalLoss   = 0
var float totalR      = 0.0

if buySignal and not na(bullStop) and not na(bullTP)
    bullPlan = buildTradePlan("SWEEP_OB_REVERSAL", "LONG", regimeState.name, selectedProfile.id, close, bullStop, bullTP, rrRatio, bullConfidence, int(time_close))
    trackOpenSignal(bullPlan)
    lastSignalDirection := "LONG"
    lastSignalSetupType := "SWEEP_OB_REVERSAL"
    lastSignalConfidence := bullConfidence
    lastProfileId := selectedProfile.id
    if emitSignalOpenAlerts
        alert(buildAlertPayload(bullPlan, "SIGNAL_OPEN", htfBiasLabel, currentSessionLabel, atr, atrMean, adxValue, emaSlope, bodyPct, nz(bullSweepD, 0.0), bullHasFvg and not na(bullFvgConfHi) and not na(bullFvgConfLo) ? (bullFvgConfHi - bullFvgConfLo) / math.max(atr, syminfo.mintick) : 0.0, bullObSizeAtr, regimeState.volatilityState, regimeState.rangeState, 0, "", na, ""), alert.freq_once_per_bar_close)

if sellSignal and not na(bearStop) and not na(bearTP)
    bearPlan = buildTradePlan("SWEEP_OB_REVERSAL", "SHORT", regimeState.name, selectedProfile.id, close, bearStop, bearTP, rrRatio, bearConfidence, int(time_close))
    trackOpenSignal(bearPlan)
    lastSignalDirection := "SHORT"
    lastSignalSetupType := "SWEEP_OB_REVERSAL"
    lastSignalConfidence := bearConfidence
    lastProfileId := selectedProfile.id
    if emitSignalOpenAlerts
        alert(buildAlertPayload(bearPlan, "SIGNAL_OPEN", htfBiasLabel, currentSessionLabel, atr, atrMean, adxValue, emaSlope, bodyPct, nz(bearSweepD, 0.0), bearHasFvg and not na(bearFvgConfHi) and not na(bearFvgConfLo) ? (bearFvgConfHi - bearFvgConfLo) / math.max(atr, syminfo.mintick) : 0.0, bearObSizeAtr, regimeState.volatilityState, regimeState.rangeState, 0, "", na, ""), alert.freq_once_per_bar_close)

if fvgBuySignal and not na(fvgBuySL) and not na(fvgBuyTP)
    fvgBuyPlan = buildTradePlan("FVG_MITIGATION", "LONG", regimeState.name, selectedProfile.id, fvgBuyEntry, fvgBuySL, fvgBuyTP, rrRatio, fvgBuyConfidence, int(time_close))
    trackOpenSignal(fvgBuyPlan)
    lastSignalDirection := "LONG"
    lastSignalSetupType := "FVG_MITIGATION"
    lastSignalConfidence := fvgBuyConfidence
    lastProfileId := selectedProfile.id
    if emitSignalOpenAlerts
        alert(buildAlertPayload(fvgBuyPlan, "SIGNAL_OPEN", htfBiasLabel, currentSessionLabel, atr, atrMean, adxValue, emaSlope, bodyPct, 0.0, nz(fvgBuySizeAtr, 0.0), 0.0, regimeState.volatilityState, regimeState.rangeState, 0, "", na, ""), alert.freq_once_per_bar_close)

if fvgSellSignal and not na(fvgSellSL) and not na(fvgSellTP)
    fvgSellPlan = buildTradePlan("FVG_MITIGATION", "SHORT", regimeState.name, selectedProfile.id, fvgSellEntry, fvgSellSL, fvgSellTP, rrRatio, fvgSellConfidence, int(time_close))
    trackOpenSignal(fvgSellPlan)
    lastSignalDirection := "SHORT"
    lastSignalSetupType := "FVG_MITIGATION"
    lastSignalConfidence := fvgSellConfidence
    lastProfileId := selectedProfile.id
    if emitSignalOpenAlerts
        alert(buildAlertPayload(fvgSellPlan, "SIGNAL_OPEN", htfBiasLabel, currentSessionLabel, atr, atrMean, adxValue, emaSlope, bodyPct, 0.0, nz(fvgSellSizeAtr, 0.0), 0.0, regimeState.volatilityState, regimeState.rangeState, 0, "", na, ""), alert.freq_once_per_bar_close)

if array.size(activeTradeId) > 0
    int idx = array.size(activeTradeId) - 1
    while idx >= 0
        openBar = array.get(activeTradeOpenBar, idx)
        if bar_index > openBar
            direction = array.get(activeTradeDirection, idx)
            isLong = direction == "LONG"
            stopLevel = array.get(activeTradeStop, idx)
            targetLevel = array.get(activeTradeTarget, idx)
            won = isLong ? high >= targetLevel : low <= targetLevel
            lost = isLong ? low <= stopLevel : high >= stopLevel
            if won or lost
                resolvedAsLoss = lost or (won and lost)
                pnlRValue = resolvedAsLoss ? -1.0 : array.get(activeTradeRr, idx)
                exitReason = resolvedAsLoss ? "SL" : "TP"
                holdBarsValue = bar_index - openBar
                totalTrades += 1
                if pnlRValue > 0
                    totalWins += 1
                    totalR += pnlRValue
                    adaptiveLossStreak := 0
                else
                    totalLoss += 1
                    totalR -= 1.0
                    adaptiveLossStreak += 1
                    if adaptiveLossStreak >= cooldownLossTrigger
                        cooldownMultiplier = math.min(adaptiveLossStreak - cooldownLossTrigger + 1, 3)
                        adaptiveCooldownUntilBar := bar_index + effCooldownBase * cooldownMultiplier
                rememberOutcome(array.get(activeTradeSetup, idx), direction, array.get(activeTradeRegime, idx), pnlRValue)
                lastCloseReason := exitReason
                closedPlan = TradePlan.new(
                     array.get(activeTradeId, idx),
                     array.get(activeTradeSetup, idx),
                     direction,
                     array.get(activeTradeRegime, idx),
                     array.get(activeTradeProfile, idx),
                     array.get(activeTradeEntry, idx),
                     stopLevel,
                     targetLevel,
                     array.get(activeTradeRr, idx),
                     array.get(activeTradeConfidence, idx))
                if emitSignalCloseAlerts
                    alert(buildAlertPayload(closedPlan, "SIGNAL_CLOSE", htfBiasLabel, currentSessionLabel, atr, atrMean, adxValue, emaSlope, bodyPct, 0.0, 0.0, 0.0, regimeState.volatilityState, regimeState.rangeState, holdBarsValue, exitReason, pnlRValue, pnlRValue > 0 ? "WIN" : "LOSS"), alert.freq_once_per_bar_close)
                array.remove(activeTradeId, idx)
                array.remove(activeTradeSetup, idx)
                array.remove(activeTradeDirection, idx)
                array.remove(activeTradeRegime, idx)
                array.remove(activeTradeProfile, idx)
                array.remove(activeTradeEntry, idx)
                array.remove(activeTradeStop, idx)
                array.remove(activeTradeTarget, idx)
                array.remove(activeTradeRr, idx)
                array.remove(activeTradeConfidence, idx)
                array.remove(activeTradeOpenBar, idx)
                array.remove(activeTradeOpenTime, idx)
        idx -= 1

wr     = totalTrades > 0 ? totalWins * 100.0 / totalTrades : na
wrText = na(wr) ? "–" : str.tostring(wr, "#.#") + "%"
netR   = str.tostring(totalR, "#.##") + "R"
recentPerfEstimate = calcRecentPerformanceEstimate()
dashboardCooldownBars = na(adaptiveCooldownUntilBar) ? 0 : math.max(adaptiveCooldownUntilBar - bar_index, 0)
cooldownStatusText = dashboardCooldownBars > 0 ? "Tight +" + str.tostring(dashboardCooldownBars) : adaptiveLossStreak > 0 ? "Watch (" + str.tostring(adaptiveLossStreak) + ")" : "Clear"
activeSetupText = buySignal or sellSignal ? "SWEEP_OB_REVERSAL" :
     fvgBuySignal or fvgSellSignal ? "FVG_MITIGATION" :
     bullSt >= 1 or bearSt >= 1 ? "SWEEP_OB_REVERSAL" :
     (array.size(bfHi) + array.size(sfHi) > 0 ? "FVG_MITIGATION" : "IDLE")
displayConfidence = buySignal ? bullConfidence :
     sellSignal ? bearConfidence :
     fvgBuySignal ? fvgBuyConfidence :
     fvgSellSignal ? fvgSellConfidence :
     (na(lastSignalConfidence) ? na : lastSignalConfidence)
displayConfidenceText = na(displayConfidence) ? "–" : str.tostring(displayConfidence)

// ═══════════════════════════════════════════════════════════════
//  17. DASHBOARD
// ═══════════════════════════════════════════════════════════════
stLbl(st) =>
    st == 0 ? "–" : st == 1 ? "Swept ↺" : st == 2 ? "OB Active ◈" : "Armed ◉"

var table dash = table.new(position.bottom_left, 2, 16,
     bgcolor = color.new(color.rgb(8, 10, 28), 5),
     border_width = 1, border_color = color.new(color.white, 78))

if showDash and barstate.islast
    hBg = color.new(color.rgb(15, 18, 55), 0)
    table.cell(dash, 0, 0,  "SMC Adaptive v4", text_color = color.white, text_size = size.small, bgcolor = hBg)
    table.cell(dash, 1, 0,  webhookSourceTag,  text_color = color.white, text_size = size.small, bgcolor = hBg)

    table.cell(dash, 0, 1,  "Regime", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 1,  regimeState.name + " · " + regimeState.volatilityState,
         text_color = regimeState.name == "TREND" ? bullCol : regimeState.name == "RANGE" ? color.orange : color.new(color.white, 15), text_size = size.small)

    table.cell(dash, 0, 2,  "HTF Bias", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 2,  htfBiasLabel + (htfStrong ? " · Strong" : " · Soft"),
         text_color = htfBull ? bullCol : htfBear ? bearCol : color.gray, text_size = size.small)

    table.cell(dash, 0, 3,  "Profile", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 3,  selectedProfile.id,
         text_color = color.new(color.white, 10), text_size = size.small)

    table.cell(dash, 0, 4,  "Active Setup", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 4,  activeSetupText,
         text_color = activeSetupText == "SWEEP_OB_REVERSAL" ? bullCol : activeSetupText == "FVG_MITIGATION" ? fvgCol : color.gray, text_size = size.small)

    table.cell(dash, 0, 5,  "Confidence", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 5,  displayConfidenceText + " / " + str.tostring(effConfidenceThreshold),
         text_color = na(displayConfidence) ? color.gray : displayConfidence >= effConfidenceThreshold ? bullCol : bearCol, text_size = size.small)

    table.cell(dash, 0, 6,  "Recent Local", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 6,  str.tostring(recentPerfEstimate, "#") + "/100",
         text_color = recentPerfEstimate >= 55 ? bullCol : recentPerfEstimate >= 45 ? color.orange : bearCol, text_size = size.small)

    table.cell(dash, 0, 7,  "Cooldown", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 7,  cooldownStatusText,
         text_color = dashboardCooldownBars > 0 ? color.orange : color.new(color.white, 15), text_size = size.small)

    table.cell(dash, 0, 8,  "Last Signal", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 8,  lastSignalSetupType + " · " + lastSignalDirection,
         text_color = lastSignalDirection == "LONG" ? bullCol : lastSignalDirection == "SHORT" ? bearCol : color.gray, text_size = size.small)

    table.cell(dash, 0, 9,  "Bull OB State", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 9,  stLbl(bullSt) + (bullSt >= 2 ? "  " + bullGrade : ""),
         text_color = bullSt == 3 ? bullCol : bullSt == 2 ? color.new(bullCol, 30) : color.gray, text_size = size.small)

    table.cell(dash, 0, 10, "Bear OB State", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 10, stLbl(bearSt) + (bearSt >= 2 ? "  " + bearGrade : ""),
         text_color = bearSt == 3 ? bearCol : bearSt == 2 ? color.new(bearCol, 30) : color.gray, text_size = size.small)

    table.cell(dash, 0, 11, "Bull FVG Zones", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 11, str.tostring(array.size(bfHi)) + " active",
         text_color = array.size(bfHi) > 0 ? bullCol : color.gray, text_size = size.small)

    table.cell(dash, 0, 12, "Bear FVG Zones", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 12, str.tostring(array.size(sfHi)) + " active",
         text_color = array.size(sfHi) > 0 ? bearCol : color.gray, text_size = size.small)

    table.cell(dash, 0, 13, "Win Rate", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 13, wrText,
         text_color = na(wr) ? color.gray : wr >= 55 ? bullCol : wr >= 45 ? color.orange : bearCol, text_size = size.small)

    table.cell(dash, 0, 14, "Net R", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 14, netR,
         text_color = totalR >= 0 ? bullCol : bearCol, text_size = size.small)

    table.cell(dash, 0, 15, "Trades", text_color = color.new(color.white, 25), text_size = size.small)
    table.cell(dash, 1, 15, str.tostring(totalWins) + "W  " + str.tostring(totalLoss) + "L  ·  " + lastCloseReason,
         text_color = color.new(color.white, 30), text_size = size.small)
