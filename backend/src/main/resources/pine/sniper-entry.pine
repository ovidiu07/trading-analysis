     tooltip = "UTC: all sessions evaluated in UTC (default). New York: America/New_York. Local: each session in native TZ. Custom: your IANA string.")
customTz        = input.string("Etc/UTC", "Custom Timezone (IANA)", group = grpSessions,
     tooltip = "Used only when Time Basis = Custom. Example: Europe/Berlin, Asia/Singapore.")
londonEn        = input.bool(true, "London Session", group = grpSessions)
londonSess      = input.session("0700-1600", "London Hours", group = grpSessions,
     tooltip = "Default is UTC. Adjust if using a different Time Basis.")
newyorkEn       = input.bool(true, "New York Session", group = grpSessions)
newyorkSess     = input.session("1300-2200", "New York Hours", group = grpSessions,
     tooltip = "Default is UTC.")
tokyoEn         = input.bool(false, "Tokyo Session", group = grpSessions)
