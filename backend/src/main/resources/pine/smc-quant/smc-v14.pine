indicator("SMC & ICT Multi-Strategy v2 [Pro]", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 3000)

// =====================================================================
// CONSTANTS
// =====================================================================
string NY_TZ       = "America/New_York"
color  BULL_COLOR  = #089981
color  BEAR_COLOR  = #f23645
color  NEUTRAL_CLR = #5b9cf6

int DIR_NONE = 0
int DIR_BULL = 1
int DIR_BEAR = -1

int ZONE_NONE = 0
int ZONE_FVG  = 1
int ZONE_OB   = 2

int STATE_MONITORING      = 0
int STATE_LIQUIDITY_NEAR  = 1
int STATE_SWEEP_CONFIRMED = 2
int STATE_MSS_PENDING     = 3
int STATE_MSS_CONFIRMED   = 4
int STATE_ZONE_FORMED     = 5
int STATE_ARMED           = 6
int STATE_PENDING_ENTRY   = 7
int STATE_TRIGGERED       = 8
int STATE_INVALIDATED     = 9
int STATE_EXPIRED         = 10

// =====================================================================
// USER DEFINED TYPES
// =====================================================================
type Trade
    string strategyName = ""
    bool   isLong       = false
    float  entryPrice   = na
    float  stopPrice    = na
    float  tp1Price     = na
    float  tp2Price     = na
    int    entryBar     = na
    bool   isActive     = false
    bool   isTp1Hit     = false
    box    tpBox        = na
    box    slBox        = na

type AlertLog
    string timeStr    = ""
    string signalType = ""
    float  price      = na
    color  col        = color.gray

type Stats
    int   totalTrades  = 0
    int   wins         = 0
    int   losses       = 0
    float totalR       = 0.0
    float equityR      = 0.0
    float maxDrawdownR = 0.0
    float peakEquityR  = 0.0

type SessionData
    string name       = ""
    string timeRange  = ""
    bool   isActive   = false
    float  high       = na
    float  low        = na
    float  lastHigh   = na
    float  lastLow    = na
    int    startBar   = na
    int    lastStart  = na
    int    lastEnd    = na

type LiquidityRef
    bool   valid     = false
    int    direction = 0
    int    priority  = 0
    string key       = ""
    string label     = ""
    string category  = ""
    float  price     = na
    int    refBar    = na

type SweepCandidate
    bool   active    = false
    int    direction = 0
    int    priority  = 0
    string label     = ""
    string category  = ""
    float  price     = na
    float  extreme   = na
    int    startBar  = na
    int    refBar    = na

type ZoneData
    box    boxId       = na
    int    direction   = 0
    int    zoneType    = 0
    float  top         = na
    float  bottom      = na
    int    createdBar  = na
    int    quality     = 0
    int    touchCount  = 0
    int    lastTouchBar = na
    float  fillPct     = 0.0
    bool   isMitigated = false
    bool   isInvalid   = false
    bool   isInverted  = false
    string label       = ""

type TradePlan
    bool   valid             = false
    float  entryPrice        = na
    string entryModel        = ""
    float  stopPrice         = na
    string stopModel         = ""
    float  tp1               = na
    float  tp2               = na
    float  invalidationPrice = na
    float  internalTarget    = na
    float  externalTarget    = na
    float  primaryRr         = na
    string targetModel       = ""

type SetupState
    int    direction         = 0
    int    state             = 0
    int    stateBar          = na
    int    score             = 0
    string strategy          = ""
    string waitReason        = ""
    string blockReason       = ""
    string summary           = ""
    string liquidityKey      = ""
    string liquidityLabel    = ""
    string liquidityCategory = ""
    float  liquidityPrice    = na
    int    liquidityPriority = 0
    int    liquidityBar      = na
    float  sweepExtreme      = na
    int    sweepBar          = na
    float  sweepWickRatio    = 0.0
    int    trendAtSweep      = 0
    float  mssWatchLevel     = na
    int    mssWatchBar       = na
    int    mssDeadlineBar    = na
    float  mssLevel          = na
    int    mssBar            = na
    string structureTag      = ""
    int    displacementScore = 0
    float  displacementAtr   = na
    float  bodyAtr           = na
    float  followThrough     = na
    float  dealingHigh       = na
    float  dealingLow        = na
    float  equilibrium       = na
    int    zoneType          = 0
    string zoneLabel         = ""
    float  zoneTop           = na
    float  zoneBottom        = na
    int    zoneBar           = na
    int    zoneScore         = 0
    int    zoneTouches       = 0
    float  zoneFillPct       = 0.0
    bool   sessionOk         = false
    bool   htfOk             = false
    bool   pdOk              = false
    bool   regimeOk          = false
    bool   rrOk              = false
    bool   momentumOk        = false
    float  entryPrice        = na
    string entryModel        = ""
    float  stopPrice         = na
    string stopModel         = ""
    float  tp1Price          = na
    float  tp2Price          = na
    string targetModel       = ""
    float  rrToTp1           = na
    float  rrToTp2           = na
    float  internalTarget    = na
    float  externalTarget    = na
    float  invalidationPrice = na
    int    expiryBar         = na
    int    triggerBar        = na

// =====================================================================
// INPUTS — Core Modes
// =====================================================================
var string G_SENS = "Core Mode"
string sensitivityMode = input.string("Balanced", "Sensitivity Profile", options = ["Aggressive", "Balanced", "Conservative"], tooltip = "Aggressive enters earlier, Balanced is default, Conservative enforces stricter MSS, HTF, and killzone behavior.", group = G_SENS)

// =====================================================================
// INPUTS — Strategy Toggles
// =====================================================================
var string G_STRAT = "Strategy Toggles"
bool enableICT2022      = input.bool(true, "Enable Flagship Sweep → MSS → Zone Engine", group = G_STRAT)
bool enableSilverBullet = input.bool(true, "Label In Silver Bullet Windows", tooltip = "When enabled, setups that begin inside Silver Bullet windows are tagged separately while using the same deterministic engine.", group = G_STRAT)

// =====================================================================
// INPUTS — HTF Trend Filter
// =====================================================================
var string G_HTF = "HTF Trend Filter"
bool   useHTFTrendFilter = input.bool(true, "Enable HTF Trend Filter", group = G_HTF)
string htfTrendTF        = input.timeframe("60", "HTF Trend Timeframe", group = G_HTF)
string htfTrendTF2       = input.timeframe("240", "HTF 2 Timeframe", group = G_HTF)
int    htfFastLen        = input.int(50, "HTF Fast EMA Length", minval = 10, maxval = 200, group = G_HTF)
int    htfEmaLen         = input.int(200, "HTF Slow EMA Length", minval = 20, maxval = 500, group = G_HTF)
string htfBiasMode       = input.string("Both", "HTF Bias Method", options = ["EMA", "Structure", "Both"], group = G_HTF)

// =====================================================================
// INPUTS — Premium / Discount Filter
// =====================================================================
var string G_PD = "Premium / Discount Filter"
bool   usePDFilter  = input.bool(true, "Enable Premium/Discount Filter", group = G_PD)
string pdStrictness = input.string("Strict", "Strictness", options = ["Soft", "Strict"], group = G_PD, tooltip = "Soft keeps P/D in scoring; Strict blocks entries that are on the wrong side of the setup dealing range.")

// =====================================================================
// INPUTS — Structure / Sweep / Displacement
// =====================================================================
var string G_STRUCT = "Structure Engine"
int    internalPivotLenInput         = input.int(3, "Base Internal Pivot Length", minval = 2, maxval = 8, group = G_STRUCT)
int    externalPivotLenInput         = input.int(8, "Base External Pivot Length", minval = 4, maxval = 20, group = G_STRUCT)
int    sweepCloseBars                = input.int(1, "Sweep Reclaim Bars", minval = 1, maxval = 4, group = G_STRUCT, tooltip = "How many bars the raid can take to reclaim the swept level. 1 = same-bar reclaim only.")
float  wickFactor                    = input.float(1.0, "Sweep Wick / Body Ratio", minval = 0.0, maxval = 5.0, step = 0.1, group = G_STRUCT)
float  maxSweepDistanceAtr           = input.float(0.80, "Max Sweep Excursion (ATR)", minval = 0.10, maxval = 3.0, step = 0.05, group = G_STRUCT)
int    mssWindowBars                 = input.int(10, "MSS Window Bars", minval = 3, maxval = 40, group = G_STRUCT)
float  minimumBreakDistanceAtr       = input.float(0.08, "Minimum Break Distance (ATR)", minval = 0.01, maxval = 0.50, step = 0.01, group = G_STRUCT)
float  minDisplacementAtr            = input.float(1.10, "Min Displacement Range (ATR)", minval = 0.20, maxval = 3.0, step = 0.05, group = G_STRUCT)
float  minDisplacementBodyAtr        = input.float(0.55, "Min Displacement Body (ATR)", minval = 0.10, maxval = 2.0, step = 0.05, group = G_STRUCT)
int    displacementFollowThroughBars = input.int(2, "Displacement Follow-Through Bars", minval = 1, maxval = 4, group = G_STRUCT)
bool   useEqualHighLow               = input.bool(true, "Track Equal Highs/Lows", group = G_STRUCT)
float  equalToleranceAtr             = input.float(0.08, "Equal High/Low Tolerance (ATR)", minval = 0.01, maxval = 0.50, step = 0.01, group = G_STRUCT)
int    equalMaxBarsApart             = input.int(45, "Equal High/Low Max Separation", minval = 5, maxval = 150, group = G_STRUCT)

