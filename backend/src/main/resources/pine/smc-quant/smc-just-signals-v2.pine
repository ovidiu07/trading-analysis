// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("SMC & ICT Multi-Strategy [Pro Visuals]", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// --- Constants ---
string NY_TZ = "America/New_York"
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color NEUTRAL_COLOR = #5b9cf6

// --- User Defined Types ---
type Trade
    string  strategyName
    bool    isLong
    float   entryPrice
    float   stopPrice
    float   tp1Price
    float   tp2Price
    int     entryBar
    bool    isActive = false
    bool    isTp1Hit = false
    box     tpBox    = na
    box     slBox    = na

type Stats
    int     totalTrades = 0
    int     wins = 0
    int     losses = 0
    float   totalR = 0.0
    float   equityR = 0.0
    float   maxDrawdownR = 0.0
    float   peakEquityR = 0.0

type SetupState
    string  phase = "Monitoring"
    int     score = 0
    string  missing = "Searching for context..."
    float   targetLevel = na
    float   triggerLevel = na
    float   invalidationLevel = na
    bool    isPotentialLong = false
    bool    isPotentialShort = false

// --- Inputs ---
var string G_SENS = "Signal Sensitivity"
string sensitivityMode = input.string("Balanced", "Sensitivity Mode", options = ["Aggressive", "Balanced", "Conservative"], tooltip = "Adjusts pivot lookback and displacement requirements for signals.", group = G_SENS)

var string G_VIS = "Visual Style & Display"
bool showLabels = input.bool(true, "Show Buy/Sell Labels", tooltip = "Displays entry labels on the chart.", group = G_VIS)
bool showZones = input.bool(true, "Show Trade SL/TP Zones", tooltip = "Draws boxes for SL and TP targets.", group = G_VIS)
int maxHistory = input.int(5, "Max Historical Trades Shown", minval = 1, maxval = 20, tooltip = "Number of closed trade boxes to keep on chart.", group = G_VIS)
bool showOutcomeMarkers = input.bool(true, "Show Outcome Markers (TP/SL)", tooltip = "Labels the outcome at the point of exit.", group = G_VIS)

var string G_STRAT = "Strategy Toggles"
bool enableICT2022 = input.bool(true, "ICT 2022 Model (Sweep + MSS)", group = G_STRAT)
bool enableSilverBullet = input.bool(true, "Silver Bullet (Time + FVG)", group = G_STRAT)

var string G_READINESS = "Setup Readiness Dashboard"
bool showReadiness = input.bool(true, "Show Readiness Dashboard", group = G_READINESS)
bool showReadinessScore = input.bool(true, "Show Score", group = G_READINESS)
bool showMissing = input.bool(true, "Show Missing Conditions", group = G_READINESS)
bool showLevels = input.bool(true, "Show Key Levels Table", group = G_READINESS)
bool showPreview = input.bool(true, "Show Projected Trade Preview", group = G_READINESS)
string readinessPos = input.string("bottom_right", "Dashboard Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = G_READINESS)

var string G_DASH = "Performance Dashboard"
bool showDash = input.bool(true, "Show Performance Dashboard", group = G_DASH)
string dashPos = input.string("top_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = G_DASH)

// --- Sensitivity Logic ---
float sensAtrMult = sensitivityMode == "Aggressive" ? 1.0 : sensitivityMode == "Conservative" ? 2.5 : 1.5
int sensPivotLen = sensitivityMode == "Aggressive" ? 2 : sensitivityMode == "Conservative" ? 5 : 3

// --- Core Data & Primitives ---
float atr = ta.atr(14)
bool isDisplacement = (high - low) > (atr * sensAtrMult)
float emaBias = ta.ema(close, 200)
string marketBias = close > emaBias ? "Bullish" : "Bearish"

// Market Structure Shift (MSS)
float pHi = ta.pivothigh(sensPivotLen, sensPivotLen)
float pLo = ta.pivotlow(sensPivotLen, sensPivotLen)
var float lastPHi = na
var float lastPLo = na
if not na(pHi)
    lastPHi := pHi
if not na(pLo)
    lastPLo := pLo

bool mssBull = ta.crossover(close, lastPHi) and isDisplacement
bool mssBear = ta.crossunder(close, lastPLo) and isDisplacement

// Fair Value Gaps (FVG)
bool bullFVG = low > high[2] and isDisplacement[1]
bool bearFVG = high < low[2] and isDisplacement[1]
var float lastBullFVG_CE = na
var float lastBearFVG_CE = na
if bullFVG
    lastBullFVG_CE := (low + high[2]) / 2
if bearFVG
    lastBearFVG_CE := (high + low[2]) / 2

// Liquidity Sweeps
var float sessHi = na
var float sessLo = na
bool inAsia = not na(time(timeframe.period, "2000-0000", NY_TZ))
if ta.change(inAsia)
    sessHi := high
    sessLo := low
else if inAsia
    sessHi := math.max(high, sessHi)
    sessLo := math.min(low, sessLo)

var bool sweptSSL = false
var bool sweptBSL = false
if low < sessLo[1] and close > sessLo[1]
    sweptSSL := true
    sweptBSL := false
if high > sessHi[1] and close < sessHi[1]
    sweptBSL := true
    sweptSSL := false

if mssBull
    sweptSSL := false
if mssBear
    sweptBSL := false

// Session Timing
bool isKillzone = not na(time(timeframe.period, "0300-0400", NY_TZ)) or not na(time(timeframe.period, "1000-1100", NY_TZ))
string currentSess = inAsia ? "Asia" : isKillzone ? "ICT Killzone" : "Regular Session"

// Premium / Discount
int rangeLookback = 50
float rangeHi = ta.highest(rangeLookback)
float rangeLo = ta.lowest(rangeLookback)
float pdArray = (rangeHi + rangeLo) / 2
string pdStatus = close > pdArray ? "Premium" : "Discount"

// Volatility Regime
float atrMa = ta.sma(atr, 100)
string volRegime = atr > atrMa * 1.2 ? "Expanding" : atr < atrMa * 0.8 ? "Compressed" : "Normal"

// --- Setup Readiness Evaluation ---
SetupState liveSetup = SetupState.new()

eval_setup(string bias, string pd, bool killzone, bool sweptL, bool sweptS, bool mssB, bool mssS, bool fvgB, bool fvgS, float pHiVal, float pLoVal, float fvgB_CE, float fvgS_CE, float sessHiVal, float sessLoVal) =>
    SetupState s = SetupState.new()
    int score = 0
    string missing = ""

    if bias == "Bullish"
        score += 10
        if pd == "Discount"
            score += 10
        if killzone
            score += 10

        if sweptL
            score += 20
            s.phase := "Sweep Detected"
            if not mssB
                s.phase := "MSS Pending"
                missing := "Wait for Bullish MSS (" + str.tostring(pHiVal, "#.#####") + ")"
                s.triggerLevel := pHiVal
            else
                score += 20
                s.phase := "MSS Confirmed"
                if not fvgB
                    s.phase := "FVG Pending"
                    missing := "Waiting for Bullish FVG"
                else
                    score += 20
                    s.phase := "FVG Formed"
                    if close > fvgB_CE
                        s.phase := "Retrace Pending"
                        missing := "Wait for retest of FVG CE (" + str.tostring(fvgB_CE, "#.#####") + ")"
                    else
                        score += 10
                        s.phase := "Armed"
                        missing := "Ready for Trigger"
        else if close < sessLoVal * 1.005
            s.phase := "Liquidity Nearby"
            missing := "Waiting for Sell-Side Sweep (" + str.tostring(sessLoVal, "#.#####") + ")"
            s.targetLevel := sessLoVal
        else
            s.phase := "Monitoring"
            missing := "Searching for liquidity sweep..."

    else
        score += 10
        if pd == "Premium"
            score += 10
        if killzone
            score += 10

        if sweptS
            score += 20
            s.phase := "Sweep Detected"
            if not mssS
                s.phase := "MSS Pending"
                missing := "Wait for Bearish MSS (" + str.tostring(pLoVal, "#.#####") + ")"
                s.triggerLevel := pLoVal
            else
                score += 20
                s.phase := "MSS Confirmed"
                if not fvgS
                    s.phase := "FVG Pending"
                    missing := "Waiting for Bearish FVG"
                else
                    score += 20
                    s.phase := "FVG Formed"
                    if close < fvgS_CE
                        s.phase := "Retrace Pending"
                        missing := "Wait for retest of FVG CE (" + str.tostring(fvgS_CE, "#.#####") + ")"
                    else
                        score += 10
                        s.phase := "Armed"
                        missing := "Ready for Trigger"
        else if close > sessHiVal * 0.995
            s.phase := "Liquidity Nearby"
            missing := "Waiting for Buy-Side Sweep (" + str.tostring(sessHiVal, "#.#####") + ")"
            s.targetLevel := sessHiVal
        else
            s.phase := "Monitoring"
            missing := "Searching for liquidity sweep..."

    s.score := score
    s.missing := missing
    s.isPotentialLong := bias == "Bullish"
    s.isPotentialShort := bias == "Bearish"
    s

liveSetup := eval_setup(marketBias, pdStatus, isKillzone, sweptSSL, sweptBSL, mssBull, mssBear, bullFVG, bearFVG, lastPHi, lastPLo, lastBullFVG_CE, lastBearFVG_CE, sessHi, sessLo)

// --- Strategy Detection ---
bool sig2022B = sweptSSL and mssBull and enableICT2022
bool sig2022S = sweptBSL and mssBear and enableICT2022
bool inSB = not na(time(timeframe.period, "0300-0400", NY_TZ)) or not na(time(timeframe.period, "1000-1100", NY_TZ))
bool sigSBB = inSB and bullFVG and enableSilverBullet
bool sigSBS = inSB and bearFVG and enableSilverBullet

// --- Trade Management Logic ---
var Stats mainStats = Stats.new()
var Trade activeTrade = na
var box[] historicalBoxes = array.new_box()

method update_stats(Stats s, float rEarned, bool isWin) =>
    s.totalTrades += 1
    s.totalR += rEarned
    s.equityR += rEarned
    if isWin
        s.wins += 1
    else
        s.losses += 1
    s.peakEquityR := math.max(s.peakEquityR, s.equityR)
    s.maxDrawdownR := math.min(s.maxDrawdownR, s.equityR - s.peakEquityR)

// Entry Logic
bool isSignalB = sig2022B or sigSBB
bool isSignalS = sig2022S or sigSBS

if (isSignalB or isSignalS) and na(activeTrade)
    float sl = isSignalB ? low[1] - (atr * 0.5) : high[1] + (atr * 0.5)
    float risk = math.abs(close - sl)
    float tp1 = isSignalB ? close + risk * 1.0 : close - risk * 1.0
    float tp2 = isSignalB ? close + risk * 2.0 : close - risk * 2.0

    box tpB = na
    box slB = na
    if showZones
        tpB := box.new(bar_index, isSignalB ? tp2 : close, bar_index, isSignalB ? close : tp2, bgcolor = color.new(BULL_COLOR, 90), border_color = color.new(BULL_COLOR, 80))
        slB := box.new(bar_index, isSignalB ? close : sl, bar_index, isSignalB ? sl : close, bgcolor = color.new(BEAR_COLOR, 90), border_color = color.new(BEAR_COLOR, 80))

    activeTrade := Trade.new(sig2022B or sig2022S ? "ICT 2022" : "SB", isSignalB, close, sl, tp1, tp2, bar_index, true, false, tpB, slB)

// Monitor Trade
if not na(activeTrade)
    bool closed = false
    float r = 0.0
    string outcome = ""

    if not na(activeTrade.tpBox)
        box.set_right(activeTrade.tpBox, bar_index)
        box.set_right(activeTrade.slBox, bar_index)

    if activeTrade.isLong
        if low <= activeTrade.stopPrice
            r := activeTrade.isTp1Hit ? 0.0 : -1.0
            closed := true
            outcome := r == 0 ? "BE" : "SL"
        else if high >= activeTrade.tp2Price
            r := 2.0
            closed := true
            outcome := "TP"
        else if high >= activeTrade.tp1Price and not activeTrade.isTp1Hit
            activeTrade.isTp1Hit := true
            if showOutcomeMarkers
                label.new(bar_index, activeTrade.tp1Price, "TP1", color = BULL_COLOR, textcolor = color.white, style = label.style_label_center, size = size.tiny)
    else
        if high >= activeTrade.stopPrice
            r := activeTrade.isTp1Hit ? 0.0 : -1.0
            closed := true
            outcome := r == 0 ? "BE" : "SL"
        else if low <= activeTrade.tp2Price
            r := 2.0
            closed := true
            outcome := "TP"
        else if low <= activeTrade.tp1Price and not activeTrade.isTp1Hit
            activeTrade.isTp1Hit := true
            if showOutcomeMarkers
                label.new(bar_index, activeTrade.tp1Price, "TP1", color = BULL_COLOR, textcolor = color.white, style = label.style_label_center, size = size.tiny)

    if closed
        mainStats.update_stats(r, r > 0)
        if showOutcomeMarkers
            float exitPrice = outcome == "TP" ? activeTrade.tp2Price : activeTrade.stopPrice
            label.new(bar_index, exitPrice, outcome, color = outcome == "TP" ? BULL_COLOR : BEAR_COLOR, textcolor = color.white, style = label.style_label_center, size = size.tiny)

        array.push(historicalBoxes, activeTrade.tpBox)
        array.push(historicalBoxes, activeTrade.slBox)
        if array.size(historicalBoxes) > maxHistory * 2
            box.delete(array.shift(historicalBoxes))
            box.delete(array.shift(historicalBoxes))

        activeTrade := na

// --- Dashboard Rendering ---
var table perfTable = table.new(dashPos == "top_right" ? position.top_right : (dashPos == "top_left" ? position.top_left : (dashPos == "bottom_right" ? position.bottom_right : position.bottom_left)), 2, 5, bgcolor = color.new(chart.bg_color, 10), border_width = 1, border_color = chart.fg_color)
if showDash and barstate.islast
    float wr = mainStats.totalTrades > 0 ? (float(mainStats.wins) / mainStats.totalTrades) * 100 : 0
    table.cell(perfTable, 0, 0, "Performance", text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(perfTable, 1, 0, "", bgcolor = chart.bg_color)
    table.cell(perfTable, 0, 1, "Win Rate", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(perfTable, 1, 1, str.format("{0,number,#.##}%", wr), text_color = wr >= 50 ? BULL_COLOR : BEAR_COLOR, text_size = size.small)
    table.cell(perfTable, 0, 2, "Total R", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(perfTable, 1, 2, str.format("{0,number,#.##}R", mainStats.totalR), text_color = mainStats.totalR >= 0 ? BULL_COLOR : BEAR_COLOR, text_size = size.small)
    table.cell(perfTable, 0, 3, "Trades", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(perfTable, 1, 3, str.tostring(mainStats.totalTrades), text_color = chart.fg_color, text_size = size.small)

// --- Readiness Dashboard ---
var table readTable = table.new(readinessPos == "bottom_right" ? position.bottom_right : (readinessPos == "bottom_left" ? position.bottom_left : (readinessPos == "top_right" ? position.top_right : position.top_left)), 2, 12, bgcolor = color.new(chart.bg_color, 10), border_width = 1, border_color = chart.fg_color)
if showReadiness and barstate.islast
    table.cell(readTable, 0, 0, "Setup Readiness", text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, 0, liveSetup.phase, text_color = NEUTRAL_COLOR, text_size = size.small)

    table.cell(readTable, 0, 1, "Market Bias", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, 1, marketBias, text_color = marketBias == "Bullish" ? BULL_COLOR : BEAR_COLOR, text_size = size.small)
    table.cell(readTable, 0, 2, "PD Array", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, 2, pdStatus, text_color = pdStatus == "Discount" ? BULL_COLOR : BEAR_COLOR, text_size = size.small)
    table.cell(readTable, 0, 3, "Session", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, 3, currentSess, text_color = isKillzone ? BULL_COLOR : color.gray, text_size = size.small)
    table.cell(readTable, 0, 4, "Volatility", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, 4, volRegime, text_color = volRegime == "Expanding" ? BULL_COLOR : color.gray, text_size = size.small)

    if showReadinessScore
        table.cell(readTable, 0, 5, "Readiness Score", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, 5, str.tostring(liveSetup.score) + "/100", text_color = liveSetup.score > 70 ? BULL_COLOR : (liveSetup.score > 40 ? color.orange : BEAR_COLOR), text_size = size.small)

    if showMissing
        table.cell(readTable, 0, 6, "Next Step", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, 6, liveSetup.missing, text_color = NEUTRAL_COLOR, text_size = size.small, text_halign = text.align_left)

    if showLevels
        table.cell(readTable, 0, 7, "Nearest SSL", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, 7, str.tostring(sessLo, "#.#####"), text_color = BEAR_COLOR, text_size = size.small)
        table.cell(readTable, 0, 8, "Nearest BSL", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, 8, str.tostring(sessHi, "#.#####"), text_color = BULL_COLOR, text_size = size.small)
        table.cell(readTable, 0, 9, "MSS Trigger", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, 9, str.tostring(liveSetup.triggerLevel, "#.#####"), text_color = NEUTRAL_COLOR, text_size = size.small)

// Projected Trade Preview
if showPreview and liveSetup.score >= 60 and na(activeTrade) and barstate.islast
    float projSl = marketBias == "Bullish" ? low - (atr * 0.5) : high + (atr * 0.5)
    float projRisk = math.abs(close - projSl)
    float projTp = marketBias == "Bullish" ? close + projRisk * 2.0 : close - projRisk * 2.0
    line.new(bar_index, close, bar_index + 5, close, color = NEUTRAL_COLOR, style = line.style_dashed)
    line.new(bar_index, projSl, bar_index + 5, projSl, color = BEAR_COLOR, style = line.style_dashed)
    line.new(bar_index, projTp, bar_index + 5, projTp, color = BULL_COLOR, style = line.style_dashed)
    label.new(bar_index + 5, close, "Candidate Preview", style = label.style_label_left, color = #00000000, textcolor = NEUTRAL_COLOR, size = size.tiny)

// --- Visual Shapes ---
plotshape(showLabels and isSignalB, "Buy Signal", shape.labelup, location.belowbar, BULL_COLOR, text="BUY", textcolor=color.white, size = size.small)
plotshape(showLabels and isSignalS, "Sell Signal", shape.labeldown, location.abovebar, BEAR_COLOR, text="SELL", textcolor=color.white, size = size.small)
