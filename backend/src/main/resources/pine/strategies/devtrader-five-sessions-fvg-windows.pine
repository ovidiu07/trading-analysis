    array.push(executionWindows, ExecutionWindow.new(t3_sym, t3_tz, t3_i1_ses, t3_sym + " / 1", t3_en and t3_i1_en))
    array.push(executionWindows, ExecutionWindow.new(t3_sym, t3_tz, t3_i2_ses, t3_sym + " / 2", t3_en and t3_i2_en))
    array.push(executionWindows, ExecutionWindow.new(t3_sym, t3_tz, t3_i3_ses, t3_sym + " / 3", t3_en and t3_i3_en))
    array.push(executionWindows, ExecutionWindow.new(t3_sym, t3_tz, t3_i4_ses, t3_sym + " / 4", t3_en and t3_i4_en))
    array.push(executionWindows, ExecutionWindow.new(t4_sym, t4_tz, t4_i1_ses, t4_sym + " / 1", t4_en and t4_i1_en))
