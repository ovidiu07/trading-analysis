    array.push(executionWindows, ExecutionWindow.new(t4_sym, t4_tz, t4_i4_ses, t4_sym + " / 4", t4_en and t4_i4_en))
    array.push(executionWindows, ExecutionWindow.new(t5_sym, t5_tz, t5_i1_ses, t5_sym + " / 1", t5_en and t5_i1_en))
