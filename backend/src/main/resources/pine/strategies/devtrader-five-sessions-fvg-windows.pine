int selectedWindow = na
bool anyExecutableProfile = false
bool windowBoundariesAligned = true
int chartMs = int(chartSeconds * 1000)
for i = 0 to array.size(executionWindows) - 1
    ExecutionWindow ew = array.get(executionWindows, i)
    bool matches = ew.enabled and f_symbolMatches(ew.symbol)
    if matches
        anyExecutableProfile := true
        int start = f_orbSessionOccurrenceStart(ew.hours, ew.timezone)
        int finish = f_orbSessionOccurrenceEnd(ew.hours, ew.timezone, start)
        if na(ew.occurrenceStart) or start != ew.occurrenceStart
            ew.occurrenceStart := start
            ew.fills := 0
        ew.occurrenceEnd := finish
        ew.inside := not na(time("", ew.hours, ew.timezone)) and time >= start and time_close <= finish
        windowBoundariesAligned := windowBoundariesAligned and chartMs > 0 and start % chartMs == 0 and finish % chartMs == 0
        if ew.inside and na(selectedWindow)
            selectedWindow := i
    else
        ew.inside := false

string fvgDetectionTf = fvgTimeframe == "" ? timeframe.period : fvgTimeframe
float detectionSeconds = timeframe.in_seconds(fvgDetectionTf)
bool executionChart = directionChartCompatible and chartSeconds == timeframe.in_seconds(executionTimeframe)
bool detectionCompatible = not na(detectionSeconds) and detectionSeconds >= chartSeconds and detectionSeconds % chartSeconds == 0
bool fvgAgeAligned = not firstTradeFromSessionFvg or (chartMs > 0 and maximumFvgAgeMinutes * 60000 % chartMs == 0)
bool nativeMode = executionChart and detectionCompatible and windowBoundariesAligned and anyExecutableProfile and fvgAgeAligned
[fvgBullRaw, fvgBearRaw, fvgMaxRaw, fvgMinRaw, fvgSourceTimeRaw, fvgAnchorTimeRaw, fvgSourceBarIndexRaw, fvgSourceCloseRaw, structureLowRaw, structureHighRaw] = request.security(syminfo.tickerid, fvgDetectionTf, f_strategyFvgPayload(), lookahead=barmerge.lookahead_off)
var int lastConfirmedFvgSourceTime = na
bool confirmedNewFvg = barstate.isconfirmed and time_close == fvgSourceCloseRaw and (fvgBullRaw or fvgBearRaw) and (na(lastConfirmedFvgSourceTime) or lastConfirmedFvgSourceTime != fvgSourceTimeRaw)
if confirmedNewFvg
    lastConfirmedFvgSourceTime := fvgSourceTimeRaw

// Store confirmed gaps in creation order, including the opening 15 minutes.
// The first filled trade belongs to a direction-session occurrence, not a window.
type SessionFvg
    int sessionStart
    int bias
    int sourceTime
    int anchorTime
    int sourceClose
    int expires
    float upper
    float lower
    float structureLow
    float structureHigh
    bool attempted = false

type SessionTradeState
    int startTime = na
    bool hasFill = false

var array<SessionFvg> sessionFvgs = array.new<SessionFvg>()
var SessionTradeState sessionTradeState = SessionTradeState.new()

f_gapMitigated(SessionFvg gap) =>
    gap.bias == 1 ? close < gap.lower : close > gap.upper

f_pruneSessionFvgs(int sessionStart, bool sessionActive) =>
    int i = array.size(sessionFvgs) - 1
    while i >= 0
        SessionFvg gap = array.get(sessionFvgs, i)
        if not sessionActive or gap.sessionStart != sessionStart or time_close >= gap.expires or gap.attempted or f_gapMitigated(gap)
            array.remove(sessionFvgs, i)
        i -= 1
    true

f_firstSessionFvg(int bias) =>
    SessionFvg candidate = na
    int i = 0
    while i < array.size(sessionFvgs) and na(candidate)
        SessionFvg gap = array.get(sessionFvgs, i)
        if gap.bias == bias and not gap.attempted
            candidate := gap
        i += 1
    candidate

// --- A single pending/open plan; attached brackets protect same-bar fills ---
type TradePlan
    int windowIndex
    int windowStart
    int sessionStart
    int expires
    int bias
    string orderId
    float entry
    float stop
    float target
    float upper
    float lower
    int anchorTime
    int sourceClose
    bool filled = false
    line entryLine = na
    line stopLine = na
    line targetLine = na
    box zoneBox = na
    label setupLabel = na

var TradePlan activePlan = na
var float plannedQtyValue = na
var float plannedRiskValue = na
var float targetRiskValue = na
var array<TradePlan> drawingHistory = array.new<TradePlan>()
var int processedClosed = 0
var int qualifiedSetups = 0
var int rejectedWideStop = 0
var int rejectedQuantity = 0
var int pendingCancellations = 0
var string lastEvent = "Waiting for direction and a trading window"

f_erasePlan(TradePlan p) =>
    line.delete(p.entryLine)
    line.delete(p.stopLine)
    line.delete(p.targetLine)
    box.delete(p.zoneBox)
    label.delete(p.setupLabel)
    true

f_finishPlanDrawing(TradePlan p, int endTime) =>
    if not na(p.entryLine)
        line.set_x2(p.entryLine, endTime)
    if not na(p.stopLine)
        line.set_x2(p.stopLine, endTime)
    if not na(p.targetLine)
        line.set_x2(p.targetLine, endTime)
    true

f_drawPlan(TradePlan p) =>
    color directionColor = p.bias == 1 ? fiveSessionLongColor : fiveSessionShortColor
    if showTradeBoxes
        p.zoneBox := box.new(p.anchorTime, p.upper, time + fvgExtendBars * chartMs, p.lower, xloc=xloc.bar_time, border_color=na, bgcolor=p.bias == 1 ? fvgBullColor : fvgBearColor)
    if showEntry
        p.entryLine := line.new(p.anchorTime, p.entry, p.expires, p.entry, xloc=xloc.bar_time, color=directionColor, style=line.style_dashed)
    if showSL
        p.stopLine := line.new(p.sourceClose, p.stop, p.expires, p.stop, xloc=xloc.bar_time, color=color.red)
    if showTP
        p.targetLine := line.new(p.sourceClose, p.target, p.expires, p.target, xloc=xloc.bar_time, color=color.lime)
    if showTradeLabels
        string details = (p.bias == 1 ? "LONG" : "SHORT") + " · " + str.tostring(entryDepthPercent, "#.##") + "% FVG\nE " + str.tostring(p.entry, format.mintick) + " · SL " + str.tostring(p.stop, format.mintick) + "\nTP " + str.tostring(p.target, format.mintick) + " · " + str.tostring(math.abs(p.entry - p.stop) / stopPointSize, "#.##") + " pts/pips"
        p.setupLabel := label.new(p.sourceClose, p.entry, details, xloc=xloc.bar_time, style=p.bias == 1 ? label.style_label_up : label.style_label_down, textcolor=color.white, color=color.new(directionColor, 30), size=size.tiny)
    array.push(drawingHistory, p)
    while array.size(drawingHistory) > retainedTradeDrawings
        f_erasePlan(array.shift(drawingHistory))
    true

f_countFill(TradePlan p) =>
    if not p.filled
        p.filled := true
        if sessionTradeState.startTime == p.sessionStart
            sessionTradeState.hasFill := true
        ExecutionWindow owner = array.get(executionWindows, p.windowIndex)
        if owner.occurrenceStart == p.windowStart
            owner.fills += 1
    true

if barstate.isconfirmed
    if na(sessionTradeState.startTime) or sessionTradeState.startTime != fiveSessionState.startTime or not fiveSessionState.active
        array.clear(sessionFvgs)
        sessionTradeState.startTime := fiveSessionState.startTime
        sessionTradeState.hasFill := false
    if firstTradeFromSessionFvg
        f_pruneSessionFvgs(fiveSessionState.startTime, fiveSessionState.active)
        if nativeMode and fiveSessionState.active and not sessionTradeState.hasFill and confirmedNewFvg and fvgSourceTimeRaw >= fiveSessionState.startTime and fvgSourceCloseRaw <= fiveSessionState.endTime
            int gapExpiry = math.min(fvgSourceCloseRaw + maximumFvgAgeMinutes * 60000, fiveSessionState.endTime)
            array.push(sessionFvgs, SessionFvg.new(fiveSessionState.startTime, fvgBullRaw ? 1 : -1, fvgSourceTimeRaw, fvgAnchorTimeRaw, fvgSourceCloseRaw, gapExpiry, fvgMaxRaw, fvgMinRaw, structureLowRaw, structureHighRaw))
    // A limit entry and bracket can both fill within one chart candle. Read the
    // closed ledger before the open position so that these round trips count once.
    if strategy.closedtrades > processedClosed
        for i = processedClosed to strategy.closedtrades - 1
            if not na(activePlan) and strategy.closedtrades.entry_id(i) == activePlan.orderId
                f_countFill(activePlan)
                f_finishPlanDrawing(activePlan, time_close)
                lastEvent := strategy.closedtrades.exit_comment(i) + " · " + activePlan.orderId
                plannedQtyValue := na
                plannedRiskValue := na
                targetRiskValue := na
                activePlan := na
        processedClosed := strategy.closedtrades
    if not na(activePlan) and strategy.position_size != 0
        f_countFill(activePlan)
        f_finishPlanDrawing(activePlan, time_close)
        lastEvent := "Open " + activePlan.orderId

    if not na(activePlan) and not activePlan.filled
        ExecutionWindow owner = array.get(executionWindows, activePlan.windowIndex)
        bool expired = time_close >= activePlan.expires or owner.occurrenceStart != activePlan.windowStart
        bool directionChanged = currentActiveSessionIndex == 0 or fiveSessionState.startTime != activePlan.sessionStart or fiveSessionState.bias != activePlan.bias
        bool invalidated = activePlan.bias == 1 ? close < activePlan.lower : close > activePlan.upper
        if not nativeMode or expired or directionChanged or invalidated
            strategy.cancel(activePlan.orderId)
            strategy.cancel(activePlan.orderId + "-EXIT")
            f_finishPlanDrawing(activePlan, time_close)
            pendingCancellations += 1
            plannedQtyValue := na
            plannedRiskValue := na
            targetRiskValue := na
            lastEvent := "Pending entry cancelled: " + (not nativeMode ? "chart/settings" : expired ? "FVG age/window/session ended" : directionChanged ? "session direction changed" : "FVG mitigated")
            activePlan := na

    bool directionReady = fiveSessionState.active and fiveSessionState.evaluated and fiveSessionState.bias != 0 and time_close >= fiveSessionState.openingEnd
    bool free = na(activePlan) and strategy.position_size == 0
    if nativeMode and directionReady and free and not na(selectedWindow)
        ExecutionWindow ew = array.get(executionWindows, selectedWindow)
        bool afterWindowOpened = fvgSourceCloseRaw > ew.occurrenceStart
        bool afterDirectionKnown = fvgSourceCloseRaw > fiveSessionState.openingEnd
        bool beforeDeadline = time_close < ew.occurrenceEnd and time_close < fiveSessionState.endTime
        bool allowance = maximumTradesPerWindow == 0 or ew.fills < maximumTradesPerWindow
        bool alignedFvg = fiveSessionState.bias == 1 ? fvgBullRaw : fvgBearRaw
        bool useSessionGap = firstTradeFromSessionFvg and not sessionTradeState.hasFill
        SessionFvg candidate = useSessionGap ? f_firstSessionFvg(fiveSessionState.bias) : na
        if not useSessionGap and confirmedNewFvg and afterWindowOpened and afterDirectionKnown and alignedFvg
            candidate := SessionFvg.new(fiveSessionState.startTime, fiveSessionState.bias, fvgSourceTimeRaw, fvgAnchorTimeRaw, fvgSourceCloseRaw, fiveSessionState.endTime, fvgMaxRaw, fvgMinRaw, structureLowRaw, structureHighRaw)
        if beforeDeadline and allowance and not na(candidate)
            // Consume an attempted gap once; a rejection/cancellation cannot loop
            // back to it or prevent the next valid gap from being considered.
            candidate.attempted := true
            int bias = fiveSessionState.bias
            float entry = f_entryPrice(candidate.upper, candidate.lower, bias)
            float structuralStop = bias == 1 ? candidate.structureLow : candidate.structureHigh
            float stop = f_stopPrice(entry, structuralStop, bias)
            float riskDistance = bias * (entry - stop)
            float target = math.round_to_mintick(entry + bias * riskDistance * rewardRiskRatio)
            float riskPoints = riskDistance / stopPointSize
            float riskPerContract = riskPoints * pointValue
            float rawQty = riskPerContract > 0 ? riskPerTrade / riskPerContract : na
            float steppedQty = na(rawQty) ? na : math.floor(rawQty / qtyStep) * qtyStep
            float qty = na(steppedQty) ? na : maxQty > 0 ? math.min(steppedQty, maxQty) : steppedQty
            bool stopValid = f_stopValid(entry, structuralStop, stop, bias)
            bool targetValid = bias * (target - entry) > 0
            bool quantityValid = not na(qty) and qty >= syminfo.mincontract and qty > 0
            if not stopValid
                rejectedWideStop += 1
                lastEvent := "Rejected structural SL " + str.tostring(bias * (entry - structuralStop) / stopPointSize, "#.##") + " pts/pips"
            else if not quantityValid
                rejectedQuantity += 1
                lastEvent := "Quantity below symbol minimum: " + str.tostring(qty) + " / " + str.tostring(syminfo.mincontract)
            else if not targetValid
                lastEvent := "Rejected TP: selected R:R rounds to zero reward at this tick size"
            else
                int expires = math.min(ew.occurrenceEnd, candidate.expires)
                string orderId = (bias == 1 ? "LONG-" : "SHORT-") + str.tostring(candidate.sourceTime) + "-" + str.tostring(selectedWindow)
                activePlan := TradePlan.new(selectedWindow, ew.occurrenceStart, fiveSessionState.startTime, expires, bias, orderId, entry, stop, target, candidate.upper, candidate.lower, candidate.anchorTime, candidate.sourceClose)
                plannedQtyValue := qty
                plannedRiskValue := qty * math.abs(activePlan.entry - activePlan.stop) / stopPointSize * pointValue
                targetRiskValue := riskPerTrade
                qualifiedSetups += 1
                f_drawPlan(activePlan)
                strategy.entry(orderId, bias == 1 ? strategy.long : strategy.short, limit=entry, qty=qty, comment=(bias == 1 ? "LONG " : "SHORT ") + ew.tag)
                strategy.exit(orderId + "-EXIT", from_entry=orderId, stop=stop, limit=target, comment_profit="TP", comment_loss="SL")
                lastEvent := "Pending " + orderId

// --- Compact diagnostics and exportable audit series ---
f_price(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)
string warning = not executionChart ? "Use standard " + executionTimeframe + "-minute candles dividing 15 minutes. Orders disabled." : not detectionCompatible ? "FVG timeframe must be >= chart and a whole multiple. Orders disabled." : not anyExecutableProfile ? "No enabled ticker/window profile matches this symbol." : not windowBoundariesAligned ? "Trading-window boundaries must align with chart bars. Orders disabled." : not fvgAgeAligned ? "Maximum FVG age must align with chart bars. Orders disabled." : ""
var table dashboard = table.new(position.top_right, 2, 13, bgcolor=color.new(#131722, 10), frame_color=color.gray, frame_width=1)
if barstate.islast or barstate.islastconfirmedhistory
    table.clear(dashboard, 0, 0, 1, 12)
    if showStrategyDashboard or warning != ""
        string windowName = na(selectedWindow) ? "Outside entry windows" : array.get(executionWindows, selectedWindow).tag
        string directionText = currentActiveSessionIndex == 0 ? "Outside reference sessions" : fiveSessionState.status
        array<string> keys = array.from("Status", "Session / direction", "Exact fifth high", "Opening close", "Trading window", "Order", "Entry", "SL / TP", "Max SL + tolerance / R:R", "Qualified / SL rejects", "Qty rejects / cancelled", "Planned risk", "Last event")
        array<string> vals = array.from(warning == "" ? "READY · confirmed candles" : warning, fiveOccurrenceName + " · " + directionText, na(fiveSessionState.reference) ? "—" : f_price(fiveSessionState.reference.high), f_price(fiveSessionState.openingPrice), windowName, na(activePlan) ? "None" : activePlan.filled ? "OPEN" : "PENDING", na(activePlan) ? "—" : f_price(activePlan.entry), na(activePlan) ? "—" : f_price(activePlan.stop) + " / " + f_price(activePlan.target), str.tostring(maxStopPoints) + " + " + str.tostring(stopTolerancePoints) + " / 1:" + str.tostring(rewardRiskRatio), str.tostring(qualifiedSetups) + " / " + str.tostring(rejectedWideStop), str.tostring(rejectedQuantity) + " / " + str.tostring(pendingCancellations), na(plannedRiskValue) ? "—" : str.tostring(plannedRiskValue, "#.##") + " / " + str.tostring(riskPerTrade, "#.##"), lastEvent)
        for i = 0 to 12
            table.cell(dashboard, 0, i, array.get(keys, i), text_color=color.silver, text_size=size.tiny)
            table.cell(dashboard, 1, i, array.get(vals, i), text_color=i == 0 and warning != "" ? color.orange : color.white, text_size=size.tiny)
plot(fiveSessionState.bias, "Audit: Session Bias", display=display.data_window)
plot(na(fiveSessionState.reference) ? na : fiveSessionState.reference.high, "Audit: Fifth Session High", display=display.data_window)
plot(fiveSessionState.openingPrice, "Audit: Opening Close", display=display.data_window)
plot(fiveSessionState.startTime, "Audit: Session Start ms", display=display.data_window)
plot(fiveSessionState.openingEnd, "Audit: Direction Time ms", display=display.data_window)
plot(selectedWindow, "Audit: Window Index", display=display.data_window)
plot(confirmedNewFvg and fvgBullRaw ? 1 : 0, "Audit: Bull FVG", display=display.data_window)
plot(confirmedNewFvg and fvgBearRaw ? 1 : 0, "Audit: Bear FVG", display=display.data_window)
plot(confirmedNewFvg ? fvgMaxRaw : na, "Audit: FVG Upper", display=display.data_window)
plot(confirmedNewFvg ? fvgMinRaw : na, "Audit: FVG Lower", display=display.data_window)
plot(confirmedNewFvg ? structureLowRaw : na, "Audit: Three Candle Low", display=display.data_window)
plot(confirmedNewFvg ? structureHighRaw : na, "Audit: Three Candle High", display=display.data_window)
plot(na(activePlan) ? na : activePlan.entry, "Audit: Planned Entry", display=display.data_window)
plot(na(activePlan) ? na : activePlan.stop, "Audit: Planned SL", display=display.data_window)
plot(na(activePlan) ? na : activePlan.target, "Audit: Planned TP", display=display.data_window)
plot(plannedQtyValue, "Audit: Planned Qty", display=display.data_window)
plot(plannedRiskValue, "Audit: Planned Risk", display=display.data_window)
plot(targetRiskValue, "Audit: Target Risk", display=display.data_window)
plot(na(activePlan) ? na : activePlan.expires, "Audit: Pending Deadline ms", display=display.data_window)
plot(firstTradeFromSessionFvg ? array.size(sessionFvgs) : na, "Audit: Session FVG Queue", display=display.data_window)
plot(sessionTradeState.hasFill ? 1 : 0, "Audit: Session First Trade Filled", display=display.data_window)
plot(na(activePlan) ? na : activePlan.sourceClose, "Audit: Planned FVG Confirmation ms", display=display.data_window)
