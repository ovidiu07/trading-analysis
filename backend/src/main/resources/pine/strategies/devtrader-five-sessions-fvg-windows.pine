// --- Status Label ---
var label statusLabel = na
if barstate.islast and showCurrentProfileLabel and configuredChartVisible
    label.delete(statusLabel)

    string labelTxt = ""
    color labelBg = color.new(color.gray, 90)

    if not timeframe.isintraday
        labelTxt := "This indicator is designed for intraday charts.\nSwitch to 1m, 5m, 15m, etc. to see accurate trading windows."
        labelBg := color.new(#f23645, 80)
    else if anyMatched
        labelTxt := "Window Profile: " + matchedProfileName + "\nTimezone: " + matchedProfileTZ
        labelBg := color.new(#089981, 80)
    else
        labelTxt := "No ticker window profile matched"
        labelBg := color.new(#f23645, 80)

    statusLabel := label.new(
         bar_index,
         high,
         labelTxt,
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = label.style_label_left,
         textcolor = chart.fg_color,
         color = labelBg,
         size = size.small
     )

// --- Chronological five-session direction (from Sessions POI indicator) ---
groupFiveSessions = "Five Sessions Direction"
const string TZ_TOOLTIP_TEXT = "IANA session timezone; daylight saving changes are handled automatically."
const int FIVE_SESSION_LOOKBACK = 5
const int FIVE_SESSION_OPENING_MS = 15 * 60 * 1000
const int FIVE_SESSION_MAX_DRAWINGS = 20
const string FIRST_SESSION_GROUP = "First Session"
showFirstSession         = input.bool(true, "Show session", group = FIRST_SESSION_GROUP)
firstSessionName         = input.string("Tokyo", "Displayed name", group = FIRST_SESSION_GROUP, active = showFirstSession)
firstSessionTime         = input.session("0900-1800", "Session time", group = FIRST_SESSION_GROUP, active = showFirstSession)
firstSessionTimezone     = input.string("Asia/Tokyo", "Session timezone", group = FIRST_SESSION_GROUP, tooltip = TZ_TOOLTIP_TEXT, active = showFirstSession)
firstSessionSeparatorClr = input.color(color.new(#ffffff, 100), "Separator color", group = FIRST_SESSION_GROUP, active = showFirstSession)

const string SECOND_SESSION_GROUP = "Second Session"
showSecondSession         = input.bool(true, "Show session", group = SECOND_SESSION_GROUP)
secondSessionName         = input.string("London", "Displayed name", group = SECOND_SESSION_GROUP, active = showSecondSession)
secondSessionTime         = input.session("0800-1600", "Session time", group = SECOND_SESSION_GROUP, active = showSecondSession)
secondSessionTimezone     = input.string("Europe/London", "Session timezone", group = SECOND_SESSION_GROUP, tooltip = TZ_TOOLTIP_TEXT, active = showSecondSession)
secondSessionSeparatorClr = input.color(color.new(#ffffff, 100), "Separator color", group = SECOND_SESSION_GROUP, active = showSecondSession)

const string THIRD_SESSION_GROUP = "Third Session"
showThirdSession         = input.bool(true, "Show session", group = THIRD_SESSION_GROUP)
thirdSessionName         = input.string("New York", "Displayed name", group = THIRD_SESSION_GROUP, active = showThirdSession)
thirdSessionTime         = input.session("0930-1600", "Session time", group = THIRD_SESSION_GROUP, active = showThirdSession)
thirdSessionTimezone     = input.string("America/New_York", "Session timezone", group = THIRD_SESSION_GROUP, tooltip = TZ_TOOLTIP_TEXT, active = showThirdSession)
thirdSessionSeparatorClr = input.color(color.new(#ffffff, 100), "Separator color", group = THIRD_SESSION_GROUP, active = showThirdSession)

// --- Inputs: Five Sessions Direction ---
// One chronological history across enabled sessions, independent of ORB / H-L visibility.
showFiveSessionLine    = input.bool(false, "Show direction line", group = groupFiveSessions, tooltip = "Connect the high of exactly five preceding enabled sessions to the confirmed close of the last candle in this session's first 15 minutes. Sessions are counted chronologically, not separately by name. Later sessions take ownership of overlaps, like Session High / Low.")
showFiveSessionText    = input.bool(true, "Show direction text", group = groupFiveSessions)
fiveSessionKeep        = input.int(8, "Session drawings to keep", minval = 1, maxval = FIVE_SESSION_MAX_DRAWINGS, group = groupFiveSessions)
fiveSessionLongColor   = input.color(#089981, "LONG color", inline = "fiveColors", group = groupFiveSessions)
fiveSessionShortColor  = input.color(#f23645, "SHORT color", inline = "fiveColors", group = groupFiveSessions)
fiveSessionFlatColor   = input.color(#787B86, "Neutral / unavailable", group = groupFiveSessions)
fiveSessionLineWidth   = input.int(1, "Line width", minval = 1, maxval = 4, group = groupFiveSessions, active = showFiveSessionLine)
fiveSessionTextFormat  = input.string("{session} · {trend} {angle}°", "Text format", group = groupFiveSessions, active = showFiveSessionText, tooltip = "Editable placeholders: {session}, {trend}, {angle}. Example: {trend} | {angle}°. A flat line is NEUTRAL; missing history / opening data is UNAVAILABLE.")
fiveSessionLongText    = input.string("LONG", "Upward text", inline = "fiveWords", group = groupFiveSessions, active = showFiveSessionText)
fiveSessionShortText   = input.string("SHORT", "Downward text", inline = "fiveWords", group = groupFiveSessions, active = showFiveSessionText)
fiveSessionTextSize    = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal"], group = groupFiveSessions, active = showFiveSessionText)
fiveSessionTextBg      = input.color(color.new(#131722, 15), "Text background", group = groupFiveSessions, active = showFiveSessionText)
fiveSessionTextX       = input.int(5, "Text offset (minutes)", minval = 0, maxval = 120, group = groupFiveSessions, active = showFiveSessionText)
fiveSessionTextY       = input.int(0, "Text offset (ticks)", minval = -1000, maxval = 1000, group = groupFiveSessions, active = showFiveSessionText)
fiveSessionAngleUnit   = input.float(1.0, "Angle price units per 15 minutes", minval = 0.00000001, group = groupFiveSessions, tooltip = "Angle = atan((closing price - reference high) / price units / elapsed 15-minute units), in degrees. This is a signed, zoom-independent normalized slope, not a screen/pixel angle. Adjust for your instrument's price scale. Changing this never changes LONG / SHORT.")

type FiveSessionReference
    float high
    int highTime
    int startTime
    string sessionName

type FiveSessionState
    bool active = false
    int sessionIndex = 0
    string sessionName = ""
    int startTime = na
    int endTime = na
    int openingEnd = na
    int lastClose = na
    float high = na
    int highTime = na
    bool complete = false
    bool openingComplete = false
    bool evaluated = false
    FiveSessionReference reference = na
    string status = "Waiting for a session"
    int bias = 0
    float openingPrice = na
    float angle = na

var array<FiveSessionReference> fiveSessionHistory = array.new<FiveSessionReference>()
var array<int> fiveSessionSeenStarts = array.new<int>(3, na)
var array<line> fiveSessionLines = array.new<line>()
var array<label> fiveSessionLabels = array.new<label>()
var FiveSessionState fiveSessionState = FiveSessionState.new()

f_getTextSize(string textSizeInput) =>
    switch textSizeInput
        "Tiny" => size.tiny
        "Normal" => size.normal
        => size.small

f_orbSessionOccurrenceStart(string sessionValue, string timezoneValue) =>
    int startHour = int(str.tonumber(str.substring(sessionValue, 0, 2)))
    int startMinute = int(str.tonumber(str.substring(sessionValue, 2, 4)))
    int localYear = year(time, timezoneValue)
    int localMonth = month(time, timezoneValue)
    int localDay = dayofmonth(time, timezoneValue)
    int occurrenceStart = timestamp(timezoneValue, localYear, localMonth, localDay, startHour, startMinute)
    if occurrenceStart > time
        occurrenceStart := timestamp(timezoneValue, localYear, localMonth, localDay - 1, startHour, startMinute)
    occurrenceStart

f_orbSessionOccurrenceEnd(string sessionValue, string timezoneValue, int occurrenceStartTime) =>
    int startHour = int(str.tonumber(str.substring(sessionValue, 0, 2)))
    int startMinute = int(str.tonumber(str.substring(sessionValue, 2, 4)))
    int endHour = int(str.tonumber(str.substring(sessionValue, 5, 7)))
    int endMinute = int(str.tonumber(str.substring(sessionValue, 7, 9)))
    int startMinutes = startHour * 60 + startMinute
    int endMinutes = endHour * 60 + endMinute
    int endDayOffset = endMinutes <= startMinutes ? 1 : 0
    timestamp(timezoneValue, year(occurrenceStartTime, timezoneValue), month(occurrenceStartTime, timezoneValue), dayofmonth(occurrenceStartTime, timezoneValue) + endDayOffset, endHour, endMinute)

f_getSessionState(bool enabled, string sessionValue, string timezoneValue) =>
    int sessionTime = time("", sessionValue, timezoneValue)
    bool inSession = enabled and not na(sessionTime)
    bool wasInSession = enabled and not na(sessionTime[1])
    [inSession, inSession and not wasInSession, not inSession and wasInSession]

f_fiveNextStart(string sessionValue, string timezoneValue) =>
    int h = int(str.tonumber(str.substring(sessionValue, 0, 2)))
    int m = int(str.tonumber(str.substring(sessionValue, 2, 4)))
    int nextStart = timestamp(timezoneValue, year(time, timezoneValue), month(time, timezoneValue), dayofmonth(time, timezoneValue), h, m)
    if nextStart <= time
        nextStart := timestamp(timezoneValue, year(time, timezoneValue), month(time, timezoneValue), dayofmonth(time, timezoneValue) + 1, h, m)
    nextStart

f_fiveStoreHigh(FiveSessionState s) =>
    if s.active
        // Keep an unavailable slot for an incomplete occurrence. Skipping it would
        // silently select the sixth (or older) session instead of exactly the fifth.
        bool validHigh = s.complete and not na(s.high)
        array.push(fiveSessionHistory, FiveSessionReference.new(validHigh ? s.high : na, validHigh ? s.highTime : na, s.startTime, s.sessionName))
        while array.size(fiveSessionHistory) > FIVE_SESSION_LOOKBACK
            array.shift(fiveSessionHistory)
        s.active := false
    true

f_fiveLabelText(string sessionName, string trend, string angleText) =>
    string labelText = str.replace_all(fiveSessionTextFormat, "{session}", sessionName)
    labelText := str.replace_all(labelText, "{trend}", trend)
    str.replace_all(labelText, "{angle}", angleText)

f_keepFiveLine(array<line> levelLines, line levelLine, int maxCount) =>
    if not na(levelLine)
        array.push(levelLines, levelLine)
        if array.size(levelLines) > maxCount
            line.delete(array.shift(levelLines))

f_keepFiveLabel(array<label> levelLabels, label levelLabel, int maxCount) =>
    if not na(levelLabel)
        array.push(levelLabels, levelLabel)
        if array.size(levelLabels) > maxCount
            label.delete(array.shift(levelLabels))

f_fiveEvaluate(FiveSessionState s) =>
    s.evaluated := true
    s.openingPrice := close
    bool openingValid = s.openingComplete and time_close == s.openingEnd and s.lastClose == s.openingEnd
    bool referenceValid = not na(s.reference) and not na(s.reference.high) and not na(s.reference.highTime)
    string trend = "UNAVAILABLE"
    string angleText = "—"
    color directionColor = fiveSessionFlatColor
    string detail = not openingValid ? "The complete, aligned first 15 minutes are missing." : "Exactly five complete preceding sessions are required. An incomplete fifth session remains unavailable."
    if openingValid and referenceValid
        float difference = close - s.reference.high
        s.bias := difference > 0 ? 1 : difference < 0 ? -1 : 0
        float elapsedUnits = (time - s.reference.highTime) / float(FIVE_SESSION_OPENING_MS)
        float angle = math.atan(difference / fiveSessionAngleUnit / elapsedUnits) * 180.0 / math.pi
        s.angle := angle
        trend := difference > 0 ? fiveSessionLongText : difference < 0 ? fiveSessionShortText : "NEUTRAL"
        directionColor := difference > 0 ? fiveSessionLongColor : difference < 0 ? fiveSessionShortColor : fiveSessionFlatColor
        angleText := (angle > 0 ? "+" : "") + str.tostring(angle, "0.0")
        detail := "Fifth prior session: " + s.reference.sessionName + "\nStart: " + str.format_time(s.reference.startTime, "yyyy-MM-dd HH:mm", syminfo.timezone) + " (exchange time)\nHigh: " + str.tostring(s.reference.high, format.mintick) + "\nOpening close: " + str.tostring(close, format.mintick) + "\nConfirmed at: " + str.format_time(s.openingEnd, "yyyy-MM-dd HH:mm", syminfo.timezone) + " (exchange time)\nAngle: normalized price/time slope; independent of zoom."
        if showFiveSessionLine
            // Candle bodies / wicks are centered on their opening timestamps.
            // The endpoint is the final opening-range candle's CLOSE, never its wick.
            line directionLine = line.new(s.reference.highTime, s.reference.high, time, close, xloc = xloc.bar_time, extend = extend.none, color = directionColor, width = fiveSessionLineWidth)
            f_keepFiveLine(fiveSessionLines, directionLine, fiveSessionKeep)
    s.status := trend + (angleText == "—" ? "" : " " + angleText + "°")
    if showFiveSessionText
        label directionLabel = label.new(time + fiveSessionTextX * 60000, close + fiveSessionTextY * syminfo.mintick, f_fiveLabelText(s.sessionName, trend, angleText), xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = fiveSessionTextBg, textcolor = directionColor, size = f_getTextSize(fiveSessionTextSize), tooltip = detail)
        f_keepFiveLabel(fiveSessionLabels, directionLabel, fiveSessionKeep)
    true

f_fiveProcess(FiveSessionState s, int owner, int occurrenceStart, int occurrenceEnd, string sessionName) =>
    FiveSessionState next = s
    // Flush BEFORE taking the next reference snapshot, including across feed gaps.
    if next.active and (time >= next.endTime or owner != next.sessionIndex or occurrenceStart != next.startTime)
        f_fiveStoreHigh(next)
    if owner > 0 and not na(occurrenceStart) and (na(array.get(fiveSessionSeenStarts, owner - 1)) or array.get(fiveSessionSeenStarts, owner - 1) != occurrenceStart)
        array.set(fiveSessionSeenStarts, owner - 1, occurrenceStart)
        next := FiveSessionState.new()
        next.active := true
        next.sessionIndex := owner
        next.sessionName := sessionName
        next.startTime := occurrenceStart
        next.endTime := occurrenceEnd
        next.openingEnd := occurrenceStart + FIVE_SESSION_OPENING_MS
        // A normal market closure can hide the first scheduled bar. Use the
        // available session OHLC, like the strategy; exclude a truncated dataset.
        next.complete := not barstate.isfirst or time <= occurrenceStart
        next.openingComplete := time == occurrenceStart
        next.reference := array.size(fiveSessionHistory) == FIVE_SESSION_LOOKBACK ? array.get(fiveSessionHistory, 0) : na
        next.status := "Waiting for the confirmed 15-minute opening close"
    if next.active
        // Session highs use available confirmed candles clipped to the window.
        // Only the opening price requires a continuous, exactly aligned 15 minutes.
        bool belongs = time >= next.startTime and time_close <= next.endTime
        if not belongs
            next.complete := false
        if time < next.openingEnd and (not belongs or (not na(next.lastClose) and time != next.lastClose))
            next.openingComplete := false
        if belongs
            if na(next.high) or high > next.high
                next.high := high
                next.highTime := time
            next.lastClose := time_close
        if not next.evaluated and time_close >= next.openingEnd
            f_fiveEvaluate(next)
        if time_close >= next.endTime
            f_fiveStoreHigh(next)
    next

[firstInSession, firstSessionStarted, firstSessionEnded] = f_getSessionState(showFirstSession, firstSessionTime, firstSessionTimezone)
[secondInSession, secondSessionStarted, secondSessionEnded] = f_getSessionState(showSecondSession, secondSessionTime, secondSessionTimezone)
[thirdInSession, thirdSessionStarted, thirdSessionEnded] = f_getSessionState(showThirdSession, thirdSessionTime, thirdSessionTimezone)
int currentActiveSessionIndex = thirdInSession ? 3 : secondInSession ? 2 : firstInSession ? 1 : 0
int fiveOccurrenceStart = currentActiveSessionIndex == 3 ? f_orbSessionOccurrenceStart(thirdSessionTime, thirdSessionTimezone) : currentActiveSessionIndex == 2 ? f_orbSessionOccurrenceStart(secondSessionTime, secondSessionTimezone) : currentActiveSessionIndex == 1 ? f_orbSessionOccurrenceStart(firstSessionTime, firstSessionTimezone) : na
int fiveOccurrenceEnd = currentActiveSessionIndex == 3 ? f_orbSessionOccurrenceEnd(thirdSessionTime, thirdSessionTimezone, fiveOccurrenceStart) : currentActiveSessionIndex == 2 ? f_orbSessionOccurrenceEnd(secondSessionTime, secondSessionTimezone, fiveOccurrenceStart) : currentActiveSessionIndex == 1 ? f_orbSessionOccurrenceEnd(firstSessionTime, firstSessionTimezone, fiveOccurrenceStart) : na
string fiveOccurrenceName = currentActiveSessionIndex == 3 ? thirdSessionName : currentActiveSessionIndex == 2 ? secondSessionName : firstSessionName
if currentActiveSessionIndex == 1 and showSecondSession
    fiveOccurrenceEnd := math.min(fiveOccurrenceEnd, f_fiveNextStart(secondSessionTime, secondSessionTimezone))
if currentActiveSessionIndex > 0 and currentActiveSessionIndex < 3 and showThirdSession
    fiveOccurrenceEnd := math.min(fiveOccurrenceEnd, f_fiveNextStart(thirdSessionTime, thirdSessionTimezone))
float chartSeconds = timeframe.in_seconds()
bool directionChartCompatible = chart.is_standard and timeframe.isintraday and not na(chartSeconds) and chartSeconds > 0 and chartSeconds <= 900 and 900 % chartSeconds == 0
if directionChartCompatible and barstate.isconfirmed
    fiveSessionState := f_fiveProcess(fiveSessionState, currentActiveSessionIndex, fiveOccurrenceStart, fiveOccurrenceEnd, fiveOccurrenceName)

// --- Execution settings ---
string G_EXEC = "Strategy Execution"
string G_FVG = "Fair Value Gaps"
string G_VIS = "Strategy Visuals / Audit"
string executionTimeframe = input.timeframe("5", "Execution Timeframe", group=G_EXEC, tooltip="Set the standard candle chart to this interval. It must divide 15 minutes; window boundaries must also align with it.")
float entryDepthPercent = input.float(25.0, "FVG Entry Percentage", minval=0, maxval=100, step=0.1, group=G_EXEC, tooltip="Depth from the retest edge: bullish top toward bottom, bearish bottom toward top. Matches the FVG indicator's percentage line.")
float maxStopPoints = input.float(36.0, "Maximum SL (points / pips)", minval=0.00000001, group=G_EXEC, tooltip="Maximum planned entry-to-SL distance. Keep the structural wick stop within this cap; if it exceeds the cap by no more than the SL tolerance, place SL at the cap instead.")
float stopTolerancePoints = input.float(9.0, "SL Excess Tolerance (points / pips)", minval=0.0, group=G_EXEC, tooltip="Allow a structural SL up to Maximum SL plus this tolerance. Example: maximum 36 and tolerance 9 accepts structural distances through 45, with the actual SL capped at 36. Zero restores strict rejection above the maximum.")
float stopPointSize = input.float(1.0, "Price Size Of One Point / Pip", minval=0.00000001, group=G_EXEC, tooltip="1.0 for GER40/NQ price points. For forex, enter your pip size, e.g. 0.0001 for GBPUSD or 0.01 for a JPY quote. This is a price-distance conversion, not position risk sizing.")
float riskPerTrade = input.float(100.0, "Account Risk Per Trade (account currency)", minval=0.0, group=G_EXEC, tooltip="Target money at risk per position in the account currency. Position size uses the actual planned stop distance, including any SL cap.")
float pointValue = input.float(1.15, "Money Value Of One Point Per Contract", minval=0.00000001, group=G_EXEC, tooltip="Account-currency P&L of a 1 price-point move on 1 contract. For this GER40 CFD quoted in EUR with a USD account it is about 1.15 (EUR/USD). Set per instrument.")
float qtyStep = input.float(0.01, "Order Size Step", minval=0.00000001, group=G_EXEC, tooltip="Size is rounded DOWN to this step so realised risk never exceeds the target.")
float maxQty = input.float(10.0, "Maximum Order Size (0 = unlimited)", minval=0.0, group=G_EXEC, tooltip="Safety cap — a very tight stop would otherwise produce a very large size.")
float rewardRiskRatio = input.float(1.5, "Reward / Risk", minval=0.01, step=0.1, group=G_EXEC)
int maximumTradesPerWindow = input.int(0, "Maximum Filled Trades Per Window (0 = unlimited)", minval=0, group=G_EXEC, tooltip="By default, a new FVG can qualify after the previous trade closes, regardless of win/loss. No pyramiding; only one pending entry or open trade at a time.")
bool firstTradeFromSessionFvg = input.bool(false, "First Trade From Earliest Unmitigated Session FVG", group=G_EXEC, tooltip="For the first filled trade of each direction session, use its earliest still-valid same-direction FVG, including gaps confirmed during the opening 15 minutes or before the entry window. Wait for confirmed direction and an enabled entry window. Later trades require a new FVG as usual. Mitigation follows the detector: a close beyond the far edge.")
int maximumFvgAgeMinutes = input.int(120, "Maximum FVG Age (minutes)", minval=1, maxval=10080, group=G_EXEC, active=firstTradeFromSessionFvg, tooltip="Applies to first-trade session FVGs when the checkbox is enabled. Measured from the third candle's confirmation, never from order submission. Cancel the pending order at this age or the entry-window/session end, whichever comes first. Must align with the execution interval.")
COLOR_BULL = #98cac2
COLOR_BEAR = #d3a3a7
fvgThresholdPercent = input.float(0.04, "Threshold %", minval=0.0, maxval=100.0, step=0.1, inline="fvgThreshold", group=G_FVG)
fvgThresholdAuto = input.bool(false, "Auto", inline="fvgThreshold", group=G_FVG)
fvgTimeframe = input.timeframe("", "Detection Timeframe", group=G_FVG)
fvgExtendBars = input.int(20, "Extend", minval=0, inline="fvgRender", group=G_FVG)
fvgBullColor = input.color(color.new(COLOR_BULL, 70), "Bullish FVG", group=G_FVG)
fvgBearColor = input.color(color.new(COLOR_BEAR, 70), "Bearish FVG", group=G_FVG)
bool showTradeBoxes = input.bool(true, "Show Traded FVG Boxes", group=G_VIS)
bool showEntry = input.bool(true, "Show Entry / Percentage Line", group=G_VIS)
bool showSL = input.bool(true, "Show SL", group=G_VIS)
bool showTP = input.bool(true, "Show TP", group=G_VIS)
bool showTradeLabels = input.bool(true, "Show Trade Labels", group=G_VIS)
bool showStrategyDashboard = input.bool(true, "Show Strategy Dashboard", group=G_VIS)
int retainedTradeDrawings = input.int(30, "Retained Setup Drawings", minval=1, maxval=40, group=G_VIS)
f_fvgThreshold() =>
    fvgThresholdAuto ? (bar_index > 0 ? ta.cum((high - low) / low) / bar_index : 0.0) : fvgThresholdPercent / 100.0

f_fvgDetectPayload() =>
    float threshold = f_fvgThreshold()
    bool bullFvg = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > threshold
    bool bearFvg = high < low[2] and close[1] < low[2] and (low[2] - high) / high > threshold
    float recordMax = bullFvg ? low : bearFvg ? low[2] : na
    float recordMin = bullFvg ? high[2] : bearFvg ? high : na
    [bullFvg, bearFvg, recordMax, recordMin, time, time[2], bar_index]

// Keep the indicator's detector unchanged; append only confirmation and SL data
// from the SAME detection-timeframe three-candle structure.
f_strategyFvgPayload() =>
    [bull, bear, upper, lower, sourceTime, anchorTime, sourceBar] = f_fvgDetectPayload()
    [bull, bear, upper, lower, sourceTime, anchorTime, sourceBar, time_close, ta.lowest(low, 3), ta.highest(high, 3)]

f_entryPrice(float upper, float lower, int bias) =>
    float fraction = entryDepthPercent / 100.0
    math.round_to_mintick(bias == 1 ? upper - (upper - lower) * fraction : lower + (upper - lower) * fraction)

f_stopPrice(float entry, float structuralStop, int bias) =>
    float structuralDistance = bias * (entry - structuralStop)
    // Round the cap DOWN to whole ticks so a non-aligned cap is never exceeded.
    float capDistance = math.floor(maxStopPoints * stopPointSize / syminfo.mintick + 0.000001) * syminfo.mintick
    structuralDistance > maxStopPoints * stopPointSize ? math.round_to_mintick(entry - bias * capDistance) : structuralStop

f_stopValid(float entry, float structuralStop, float stop, int bias) =>
    float structuralRisk = bias * (entry - structuralStop)
    float actualRisk = bias * (entry - stop)
    float epsilon = syminfo.mintick * 0.000001
    structuralRisk > 0 and structuralRisk <= (maxStopPoints + stopTolerancePoints) * stopPointSize + epsilon and actualRisk > 0 and actualRisk <= maxStopPoints * stopPointSize + epsilon

// --- Trading-window occurrences ---
type ExecutionWindow
    string symbol
    string timezone
    string hours
    string tag
    bool enabled
    int occurrenceStart = na
    int occurrenceEnd = na
    int fills = 0
    bool inside = false

var array<ExecutionWindow> executionWindows = array.new<ExecutionWindow>()
if barstate.isfirst
    array.push(executionWindows, ExecutionWindow.new(t1_sym, t1_tz, t1_i1_ses, t1_sym + " / 1", t1_en and t1_i1_en))
    array.push(executionWindows, ExecutionWindow.new(t1_sym, t1_tz, t1_i2_ses, t1_sym + " / 2", t1_en and t1_i2_en))
    array.push(executionWindows, ExecutionWindow.new(t1_sym, t1_tz, t1_i3_ses, t1_sym + " / 3", t1_en and t1_i3_en))
    array.push(executionWindows, ExecutionWindow.new(t1_sym, t1_tz, t1_i4_ses, t1_sym + " / 4", t1_en and t1_i4_en))
