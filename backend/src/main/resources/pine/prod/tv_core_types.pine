//@version=6
// @description Shared type definitions and constants for SMC trading system.
// All constants are exported as zero-argument functions (Pine v6 library constraint).
library("tv_core_types", overlay = true)

// =====================================================================
// EXPORTED CONSTANTS (as functions — Pine v6 cannot export top-level const from libraries)
// =====================================================================

// --- Liquidity Source Constants ---
export SRC_SESSION()     => 1
export SRC_PDH_PDL()     => 2
export SRC_PWH_PWL()     => 3
export SRC_PIVOT_EXT()   => 4
export SRC_PIVOT_INT()   => 5
export SRC_EQH_EQL()     => 6
export SRC_DEVELOPING()  => 7
export SRC_PIVOT_HTF_1() => 8
export SRC_PIVOT_HTF_2() => 9
export SRC_PIVOT_HTF_3() => 10
export SRC_ROUND_NUM()   => 11

// --- Source Priority Scores ---
export PRI_PWH_PWL()     => 100
export PRI_PDH_PDL()     => 80
export PRI_EQH_EQL()     => 70
export PRI_SESSION()     => 60
export PRI_PIVOT_EXT()   => 50
export PRI_PIVOT_INT()   => 25
export PRI_DEVELOPING()  => 15
export PRI_PIVOT_HTF_1() => 68
export PRI_PIVOT_HTF_2() => 78
export PRI_PIVOT_HTF_3() => 88
export PRI_ROUND_NUM()   => 35

// --- Sweep Type Classification ---
export SWEEP_SHALLOW()       => 1
export SWEEP_CLEAN_RAID()    => 2
export SWEEP_DEEP_STOP_RUN() => 3
export SWEEP_EXT_LIQ_GRAB()  => 4
export SWEEP_INT_LIQ_SWEEP() => 5
export SWEEP_SESSION()       => 6
export SWEEP_HTF()           => 7
export SWEEP_INDUCEMENT()    => 8

// --- Sweep Lifecycle States ---
export LIFE_DETECTED()    => 1
export LIFE_ACTIVE()      => 2
export LIFE_CONFIRMED()   => 3
export LIFE_CONSUMED()    => 4
export LIFE_STALE()       => 5
export LIFE_INVALIDATED() => 6

// --- Setup Lifecycle Constants ---
export LC_NONE()                   => 0
export LC_LIQUIDITY_IDENTIFIED()   => 1
export LC_SWEEP_CONFIRMED()        => 2
export LC_RECLAIM_VISIBLE()        => 3
export LC_MSS_CONFIRMED()          => 4
export LC_DISPLACEMENT_CONFIRMED() => 5
export LC_ENTRY_ARMED()            => 6
export LC_ENTRY_TRIGGERED()        => 7
export LC_ACTIVE()                 => 8
export LC_EXPIRED()                => 9
export LC_INVALIDATED()            => 10
export LC_DESYNC()                 => 11

// =====================================================================
// EXPORTED TYPES
// =====================================================================

export type Trade
    string  strategyName
    bool    isLong
    float   entryPrice
    float   stopPrice
    float   tp1Price
    float   tp2Price
    int     entryBar
    bool    isActive = false
    bool    isTp1Hit = false
    box     tpBox    = na
    box     slBox    = na

export type AlertLog
    string  timeStr
    string  signalType
    float   price
    color   col

export type Stats
    int     totalTrades = 0
    int     wins = 0
    int     losses = 0
    float   totalR = 0.0
    float   equityR = 0.0
    float   maxDrawdownR = 0.0
    float   peakEquityR = 0.0

export type SessionData
    string name
    string timeRange
    bool   isActive = false
    float  high = na
    float  low = na
    float  lastHigh = na
    float  lastLow = na

export type DispState
    bool    detectedLong = false
    bool    detectedShort = false
    bool    weakLong = false
    bool    weakShort = false
    bool    validLong = false
    bool    validShort = false
    bool    strongLong = false
    bool    strongShort = false
    bool    freshLong = true
    bool    freshShort = true
    bool    failedLong = false
    bool    failedShort = false
    float   scoreLong = 0.0
    float   scoreShort = 0.0
    string  reasonLong = ""
    string  reasonShort = ""
    string  failReasonLong = ""
    string  failReasonShort = ""
    float   rangeAtrLong = 0.0
    float   rangeAtrShort = 0.0
    float   bodyDomLong = 0.0
    float   bodyDomShort = 0.0
    bool    hasImbalanceLong = false
    bool    hasImbalanceShort = false
    int     fvgGradeLong = 0
    int     fvgGradeShort = 0
    bool    retainedLong = false
    bool    retainedShort = false

export type LiqLevel
    string  name
    float   price
    int     sourceType
    int     priority
    bool    isExternal
    bool    isSSL
    bool    isHTF
    bool    isSession
    bool    isCluster
    int     clusterCount
    int     createdBar

export type LiqSweep
    string  levelName
    float   levelPrice
    int     sourceType
    int     sourcePriority
    bool    isExternal
    bool    isSSL
    float   sweepDepth
    float   sweepDepthAtr
    float   wickPenetrationRatio
    float   rejectionStrength
    bool    hasRejection
    bool    hasDisplacement
    int     sweepType
    string  sweepTypeStr
    string  grade
    float   qualityScore
    int     sweepBar
    int     lifecycleState
    bool    isActionable
    bool    isConsumed
    bool    isHTF
    bool    isSessionSweep
    bool    isClusterSweep
    int     clusterCount
    bool    isInducementLike
    bool    inKillzone
    bool    inSilverBullet
    string  sessionAtSweep

export type SmartZone
    box   boxId
    float top
    float bottom
    bool  isBull
    bool  mitigated = false
    bool  isInverted = false
    int   startBar
    float ce = na
    bool  ceRespected = false
    bool  ceBroken = false
    int   touchCount = 0
    float gapSize = na
