// =====================================================================
var string G_MOM = "Momentum Confirmation"
bool   useMomentumFilter = input.bool(true, "Enable Momentum Filter", group = G_MOM)
string momentumMode      = input.string("Candle", "Momentum Method", options = ["Candle", "RSI", "Displacement"], tooltip = "Candle: close position within range. RSI: threshold check. Displacement: continuation bar quality.", group = G_MOM)
int    rsiLength         = input.int(14, "RSI Length", minval = 5, maxval = 50, group = G_MOM)
float  rsiBullThreshold  = input.float(45.0, "RSI Bull Threshold (above)", minval = 20, maxval = 60, group = G_MOM)
float  rsiBearThreshold  = input.float(55.0, "RSI Bear Threshold (below)", minval = 40, maxval = 80, group = G_MOM)

// =====================================================================
// INPUTS — Entry Model
// =====================================================================
var string G_ENTRY = "Entry Execution"
string entryModel          = input.string("immediate", "Entry Model", options = ["immediate", "fvgRetrace", "obRetrace", "blended"], tooltip = "immediate: enter on confirmation. fvgRetrace/obRetrace: wait for pullback into zone. blended: nearest FVG or OB.", group = G_ENTRY)
float  entryZonePadATR     = input.float(0.2, "Entry Zone Padding (ATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = G_ENTRY)
int    pendingSetupExpiry  = input.int(20, "Pending Setup Expiry (bars)", minval = 5, maxval = 100, tooltip = "How many bars to wait for retracement before canceling pending setup.", group = G_ENTRY)

// =====================================================================
// INPUTS — Risk Management
// =====================================================================
var string G_RISK = "Risk Management"
string stopMode       = input.string("hybrid", "Stop-Loss Mode", options = ["structure", "sweepWick", "obInvalidation", "atr", "hybrid"], tooltip = "structure: beyond invalidation swing. sweepWick: beyond sweep candle wick. hybrid: best structural stop + ATR padding.", group = G_RISK)
float  stopPadATR     = input.float(0.3, "Stop Padding (ATR mult)", minval = 0.0, maxval = 2.0, step = 0.1, group = G_RISK)
string tpMode         = input.string("hybrid", "Take-Profit Mode", options = ["fixedRR", "internalLiquidity", "externalLiquidity", "hybrid"], tooltip = "fixedRR: fixed risk multiples. internalLiquidity: nearest opposing swing. hybrid: TP1 at internal, TP2 at external liquidity.", group = G_RISK)
float  rrTarget1      = input.float(1.5, "TP1 Risk Multiple", minval = 0.5, maxval = 5.0, step = 0.1, group = G_RISK)
float  rrTarget2      = input.float(3.0, "TP2 Risk Multiple", minval = 1.0, maxval = 10.0, step = 0.5, group = G_RISK)

// =====================================================================
