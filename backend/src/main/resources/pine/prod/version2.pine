indicator("SMC & ICT Multi-Strategy v2 [Pro]", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// =====================================================================
// CONSTANTS
// =====================================================================
string NY_TZ       = "America/New_York"
color  BULL_COLOR  = #089981
color  BEAR_COLOR  = #f23645
color  NEUTRAL_CLR = #5b9cf6

// =====================================================================
// USER DEFINED TYPES
// =====================================================================
type Trade
    string  strategyName
    bool    isLong
    float   entryPrice
    float   stopPrice
    float   tp1Price
    float   tp2Price
    int     entryBar
    bool    isActive    = false
    bool    isTp1Hit    = false
    box     tpBox       = na
    box     slBox       = na

type PendingSetup
    bool    isActive    = false
    bool    isLong      = false
    float   entryTop    = na
    float   entryBot    = na
    float   stopPrice   = na
    float   sweepWick   = na
    int     setupBar    = 0
    int     score       = 0
    string  strategy    = ""

type AlertLog
    string  timeStr
    string  signalType
    float   price
    color   col

type Stats
    int     totalTrades   = 0
    int     wins          = 0
    int     losses        = 0
    float   totalR        = 0.0
    float   equityR       = 0.0
    float   maxDrawdownR  = 0.0
    float   peakEquityR   = 0.0

type SessionData
    string  name
    string  timeRange
    bool    isActive  = false
    float   high      = na
    float   low       = na
    float   lastHigh  = na
    float   lastLow   = na

type SetupState
    string  phase      = "Monitoring"
    int     score      = 0
    string  missing    = "Searching for context..."
    float   nearestBSL = na
    float   nearestSSL = na
    float   requiredSweep     = na
    float   triggerLevel      = na
    float   invalidationLevel = na
    bool    isPotentialLong   = false
    bool    isPotentialShort  = false

type SmartZone
    box     boxId
    float   top
    float   bottom
    bool    isBull
    bool    mitigated   = false
    bool    isInverted  = false
    int     startBar
    float   displacement = 0.0

// =====================================================================
// INPUTS — Core Modes
// =====================================================================
var string G_SENS = "Core Mode"
string sensitivityMode = input.string("Balanced", "Sensitivity Profile", options = ["Aggressive", "Balanced", "Conservative"], tooltip = "Controls confirmation depth, displacement thresholds, pivot structure, and minimum score. Aggressive = more signals, lower quality. Conservative = fewer signals, highest quality.", group = G_SENS)

// =====================================================================
// INPUTS — Strategy Toggles
// =====================================================================
var string G_STRAT = "Strategy Toggles"
bool enableICT2022      = input.bool(true, "ICT 2022 Model (Sweep → MSS → FVG)", group = G_STRAT)
bool enableSilverBullet = input.bool(true, "Silver Bullet (Time + FVG)", group = G_STRAT)

// =====================================================================
// INPUTS — HTF Trend Filter
// =====================================================================
var string G_HTF = "HTF Trend Filter"
bool   useHTFTrendFilter = input.bool(true, "Enable HTF Trend Filter", tooltip = "When enabled, long setups require bullish HTF bias and short setups require bearish HTF bias.", group = G_HTF)
string htfTrendTF        = input.timeframe("60", "HTF Trend Timeframe", group = G_HTF)
string htfTrendTF2       = input.timeframe("240", "HTF 2 Timeframe", group = G_HTF)
int    htfEmaLen         = input.int(200, "HTF EMA Length", minval = 10, maxval = 500, group = G_HTF)
string htfBiasMode       = input.string("EMA", "HTF Bias Method", options = ["EMA", "Structure", "Both"], tooltip = "EMA: price vs EMA. Structure: swing highs/lows trend. Both: requires agreement.", group = G_HTF)

// =====================================================================
// INPUTS — Premium / Discount Filter
// =====================================================================
var string G_PD = "Premium / Discount Filter"
bool   usePDFilter   = input.bool(true, "Enable Premium/Discount Filter", tooltip = "Longs prefer discount zone, shorts prefer premium zone.", group = G_PD)
int    pdLookback    = input.int(50, "Range Lookback", minval = 10, maxval = 200, group = G_PD)
string pdStrictness  = input.string("Soft", "Strictness", options = ["Soft", "Strict"], tooltip = "Soft: adds score but doesn't block. Strict: blocks entries in wrong zone.", group = G_PD)

// =====================================================================
// INPUTS — FVG Settings
// =====================================================================
var string G_FVG = "FVG Settings"
bool   requireFVG       = input.bool(false, "Require FVG for Entry", tooltip = "When enabled, setups must have a valid FVG present.", group = G_FVG)
float  minFvgAtrMult    = input.float(0.3, "Min FVG Size (ATR multiple)", minval = 0.05, maxval = 2.0, step = 0.05, tooltip = "FVGs smaller than this fraction of ATR are filtered out as noise.", group = G_FVG)
bool   requireFvgRetrace = input.bool(false, "Require FVG Retracement", tooltip = "Entry only after price retraces into the FVG zone.", group = G_FVG)
string fvgEntryMode     = input.string("touch", "FVG Entry Mode", options = ["touch", "midpoint", "fullZone"], tooltip = "touch: enter on contact. midpoint: enter at 50% fill. fullZone: enter at far edge.", group = G_FVG)

// =====================================================================
// INPUTS — Order Block Settings
// =====================================================================
var string G_OB = "Order Block Settings"
bool   requireOB       = input.bool(false, "Require OB for Entry", tooltip = "When enabled, price must be near an active OB zone.", group = G_OB)
int    obLookback      = input.int(20, "OB Search Lookback", minval = 5, maxval = 50, group = G_OB)
int    obMaxAge        = input.int(100, "OB Max Age (bars)", minval = 10, maxval = 500, tooltip = "Order blocks older than this are considered stale.", group = G_OB)
float  obProximityATR  = input.float(1.0, "OB Proximity (ATR mult)", minval = 0.1, maxval = 5.0, step = 0.1, tooltip = "How close price must be to OB zone to count as confluence.", group = G_OB)

// =====================================================================
