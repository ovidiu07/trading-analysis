//@version=6
// @description Generic table rendering plumbing for trading dashboards.
// Contains ONLY UI layout helpers — no trading logic.
library("tv_dashboard_utils", overlay = true)

// --- 2-Column Primitives ---

// @function Renders a section header row spanning two columns.
export table_header(table tbl, int row, string title, color headerColor, color bgColor = na) =>
    table.cell(tbl, 0, row, title, text_color = headerColor, text_size = size.small, text_halign = text.align_left, bgcolor = bgColor)
    table.cell(tbl, 1, row, "", bgcolor = bgColor)
    row + 1

// @function Renders a section divider row (─── Title ───) spanning two columns.
export table_section(table tbl, int row, string title, color headerColor, color bgColor = na) =>
    table.cell(tbl, 0, row, "─── " + title + " ───", text_color = headerColor, text_size = size.tiny, text_halign = text.align_left, bgcolor = bgColor)
    table.cell(tbl, 1, row, "", bgcolor = bgColor)
    row + 1

// @function Renders an emphasized key/value row (High Priority).
export table_kv_emph(table tbl, int row, string key, string val, color keyColor, color valColor, color bgColor = na) =>
    table.cell(tbl, 0, row, key, text_color = keyColor, text_size = size.small, text_halign = text.align_left, bgcolor = bgColor)
    table.cell(tbl, 1, row, val, text_color = valColor, text_size = size.small, bgcolor = bgColor)
    row + 1

// @function Renders a standard key/value row.
export table_kv(table tbl, int row, string key, string val, color keyColor, color valColor, color bgColor = na) =>
    table.cell(tbl, 0, row, key, text_color = keyColor, text_size = size.small, text_halign = text.align_left, bgcolor = bgColor)
    table.cell(tbl, 1, row, val, text_color = valColor, text_size = size.small, bgcolor = bgColor)
    row + 1

// @function Renders a muted key/value row (Low Priority).
export table_kv_muted(table tbl, int row, string key, string val, color keyColor, color valColor, color bgColor = na) =>
    table.cell(tbl, 0, row, key, text_color = keyColor, text_size = size.tiny, text_halign = text.align_left, bgcolor = bgColor)
    table.cell(tbl, 1, row, val, text_color = valColor, text_size = size.tiny, bgcolor = bgColor)
    row + 1

// @function Renders a merged guidance message (Next steps / Requirements).
export table_guidance(table tbl, int row, string msg, color msgColor, color bgColor = na) =>
    table.cell(tbl, 0, row, "→ " + msg, text_color = msgColor, text_size = size.tiny, text_halign = text.align_left, bgcolor = bgColor)
    table.merge_cells(tbl, 0, row, 1, row)
    row + 1

// --- 3-Column Primitives ---

// @function Renders a 3-column header row.
export table_header3(table tbl, int row, string h1, string h2, string h3, color headerColor, color bgColor = na) =>
    table.cell(tbl, 0, row, h1, text_color = headerColor, text_size = size.tiny, bgcolor = bgColor)
    table.cell(tbl, 1, row, h2, text_color = headerColor, text_size = size.tiny, bgcolor = bgColor)
    table.cell(tbl, 2, row, h3, text_color = headerColor, text_size = size.tiny, bgcolor = bgColor)
    row + 1

// @function Renders an emphasized 3-column row (Highlighted).
export table_row3_emph(table tbl, int row, string c1, string c2, string c3, color c1Color, color c2Color, color c3Color, color bgColor = na) =>
    table.cell(tbl, 0, row, c1, text_color = c1Color, text_size = size.small, bgcolor = bgColor)
    table.cell(tbl, 1, row, c2, text_color = c2Color, text_size = size.small, bgcolor = bgColor)
    table.cell(tbl, 2, row, c3, text_color = c3Color, text_size = size.small, bgcolor = bgColor)
    row + 1

// @function Renders a standard 3-column data row.
export table_row3(table tbl, int row, string c1, string c2, string c3, color c1Color, color c2Color, color c3Color, color bgColor = na) =>
    table.cell(tbl, 0, row, c1, text_color = c1Color, text_size = size.tiny, bgcolor = bgColor)
    table.cell(tbl, 1, row, c2, text_color = c2Color, text_size = size.tiny, bgcolor = bgColor)
    table.cell(tbl, 2, row, c3, text_color = c3Color, text_size = size.tiny, bgcolor = bgColor)
    row + 1

// @function Renders a muted 3-column data row.
export table_row3_muted(table tbl, int row, string c1, string c2, string c3, color c1Color, color c2Color, color c3Color, color bgColor = na) =>
    table.cell(tbl, 0, row, c1, text_color = color.new(c1Color, 40), text_size = size.tiny, bgcolor = bgColor)
    table.cell(tbl, 1, row, c2, text_color = color.new(c2Color, 40), text_size = size.tiny, bgcolor = bgColor)
    table.cell(tbl, 2, row, c3, text_color = color.new(c3Color, 40), text_size = size.tiny, bgcolor = bgColor)
    row + 1

// @function Renders a single-cell merged "no data" message for 3-column layouts.
export table_empty3(table tbl, int row, string msg, color msgColor, color bgColor = na) =>
    table.cell(tbl, 0, row, msg, text_color = msgColor, text_size = size.tiny, bgcolor = bgColor)
    table.merge_cells(tbl, 0, row, 2, row)
    row + 1
