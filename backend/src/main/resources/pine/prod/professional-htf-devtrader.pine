//@version=6
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
indicator("Professional HTF Bias + SMC Dashboard", shorttitle="Institutional SMC", overlay=true)

// --- Groups ---
G_DAY   = "Daily / NY Levels"
G_WEEK  = "Weekly Levels"
G_MONTH = "Monthly Levels"
G_ASIA  = "Asia Session (Liquidity)"
G_SMC   = "SMC / Market Structure"
G_DASH  = "Bias Dashboard"

// --- Inputs ---
showMidnight = input.bool(true, "NY Midnight Open", group=G_DAY)
colorNY      = input.color(color.white, "Midnight Color", group=G_DAY)
showAsia     = input.bool(true, "Asia Session H/L", group=G_ASIA)
asiaSession  = input.session("0000-0900:1234567", "Asia Session Time (UTC)", group=G_ASIA)
colorAsia    = input.color(#5b9cf6, "Asia Color", group=G_ASIA)

showPDH   = input.bool(true, "Prev Day High", group=G_DAY, inline="d1")
showPDL   = input.bool(true, "Prev Day Low", group=G_DAY, inline="d1")
showDO    = input.bool(true, "Daily Open", group=G_DAY)
colorDay  = input.color(#f23645, "Daily Color", group=G_DAY)

showPWH   = input.bool(true, "Prev Week High", group=G_WEEK, inline="w1")
showPWL   = input.bool(true, "Prev Week Low", group=G_WEEK, inline="w1")
showWO    = input.bool(true, "Weekly Open", group=G_WEEK)
colorWeek = input.color(#089981, "Weekly Color", group=G_WEEK)

// SMC Professional Filters
showSMC      = input.bool(true, "Detect Institutional Sweeps & MSS", group=G_SMC)
requireDisp  = input.bool(true, "Require Displacement (ATR Filter)", group=G_SMC)
dispMult     = input.float(1.4, "Displacement Multiplier", step=0.1, group=G_SMC, tooltip="Higher = less noise, requires more aggressive moves")
swingLen     = input.int(3, "Swing Strength (Fractal)", minval=1, group=G_SMC)

showDash     = input.bool(true, "Show Bias Dashboard", group=G_DASH)
dashPos      = input.string("Top Right", "Position", options=["Top Right", "Bottom Right", "Top Left"], group=G_DASH)

// --- HTF Data ---
[pdh, pdl, dO] = request.security(syminfo.tickerid, "D", [high[1], low[1], open[0]], lookahead=barmerge.lookahead_on)
[pwh, pwl, wO] = request.security(syminfo.tickerid, "W", [high[1], low[1], open[0]], lookahead=barmerge.lookahead_on)

isNewDayNY = hour(time, "America/New_York") == 0 and minute(time, "America/New_York") == 0
var float nyMidnight = na
if isNewDayNY
    nyMidnight := open

inAsia = not na(time(timeframe.period, asiaSession, "UTC"))
var float asiaH = na, var float asiaL = na
if inAsia and not inAsia[1]
    asiaH := high, asiaL := low
else if inAsia
    asiaH := math.max(high, nz(asiaH, high)), asiaL := math.min(low, nz(asiaL, low))

// --- SMC Engine (Reduced Noise) ---
var bool waitingForMSS_Short = false
var bool waitingForMSS_Long  = false
var float lastSwh = na, var float lastSwl = na
var string structureStatus = "Neutral"

// Displacement Calculation - Filters out slow, non-aggressive moves
avgCandleBody = ta.sma(math.abs(close - open), 20)
displacement  = math.abs(close - open) > (avgCandleBody * dispMult)

// Swing Points - Fractal based identification of key structure
swh = ta.pivothigh(high, swingLen, swingLen)
swl = ta.pivotlow(low, swingLen, swingLen)
if not na(swh)
    lastSwh := swh
if not na(swl)
    lastSwl := swl

// Professional SFP (Sweep) Logic - Requires candle rejection
// Candle must wick the level and close in the opposite half of its range
isSFP_High = (high > pdh and close < pdh) or (high > pwh and close < pwh) or (high > asiaH and close < asiaH)
isSFP_Low  = (low < pdl and close > pdl) or (low < pwl and close > pwl) or (low < asiaL and close > asiaL)

rejectionHigh = isSFP_High and (close < (high + low) / 2)
rejectionLow  = isSFP_Low  and (close > (high + low) / 2)

if showSMC and rejectionHigh
    label.new(bar_index, high, "SFP ⌁", color=#00000000, textcolor=#f23645, style=label.style_label_down, size=size.tiny)
    waitingForMSS_Short := true, waitingForMSS_Long := false
if showSMC and rejectionLow
    label.new(bar_index, low, "SFP ⌁", color=#00000000, textcolor=#089981, style=label.style_label_up, size=size.tiny)
    waitingForMSS_Long := true, waitingForMSS_Short := false

// MSS Detection with Displacement - Only looks for MSS AFTER a valid SFP
if showSMC and waitingForMSS_Short and close < lastSwl and (not requireDisp or (displacement and close < open))
    label.new(bar_index, low, "MSS ↘", color=#f23645, textcolor=color.white, style=label.style_label_down, size=size.small)
    structureStatus := "Bearish", waitingForMSS_Short := false
if showSMC and waitingForMSS_Long and close > lastSwh and (not requireDisp or (displacement and close > open))
    label.new(bar_index, high, "MSS ↗", color=#089981, textcolor=color.white, style=label.style_label_up, size=size.small)
    structureStatus := "Bullish", waitingForMSS_Long := false

// --- Visual Objects ---
f_update(show, val, txt, clr, l, lb) =>
    if show and not na(val)
        line.set_xy1(l, bar_index, val), line.set_xy2(l, bar_index + 5, val), line.set_color(l, clr)
        label.set_xy(lb, bar_index + 5, val), label.set_textcolor(lb, clr)
        label.set_text(lb, txt + " (" + str.tostring(val, format.mintick) + ")")
    else
        line.set_y1(l, na), line.set_y2(l, na), label.set_y(lb, na)

var lnPDH = line.new(na, na, na, na), var lbPDH = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnPDL = line.new(na, na, na, na), var lbPDL = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnDO  = line.new(na, na, na, na), var lbDO  = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnPWH = line.new(na, na, na, na), var lbPWH = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnPWL = line.new(na, na, na, na), var lbPWL = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnNY  = line.new(na, na, na, na), var lbNY  = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)

if barstate.islast
    f_update(showPDH, pdh, "PDH", colorDay, lnPDH, lbPDH)
    f_update(showPDL, pdl, "PDL", colorDay, lnPDL, lbPDL)
    f_update(showDO,  dO,  "DO",  colorDay, lnDO, lbDO)
    f_update(showPWH, pwh, "PWH", colorWeek, lnPWH, lbPWH)
    f_update(showPWL, pwl, "PWL", colorWeek, lnPWL, lbPWL)
    f_update(showMidnight, nyMidnight, "NY-Mid", colorNY, lnNY, lbNY)

    if showDash
        pos = dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : position.bottom_right
        dashTable = table.new(pos, 2, 5, border_width=1, border_color=chart.fg_color)
        table.cell(dashTable, 0, 0, "HTF / SMC BIAS", bgcolor=chart.fg_color, text_color=chart.bg_color, text_size=size.small)
        table.cell(dashTable, 1, 0, "STATUS", bgcolor=chart.fg_color, text_color=chart.bg_color, text_size=size.small)

        bT1 = close > dO ? "BULL" : "BEAR", bC1 = close > dO ? #089981 : #f23645
        table.cell(dashTable, 0, 1, "Daily Open", text_color=colorDay, text_size=size.small, bgcolor=chart.bg_color)
        table.cell(dashTable, 1, 1, bT1, text_color=color.white, bgcolor=bC1, text_size=size.small)

        bT3 = close > nyMidnight ? "BULL" : "BEAR", bC3 = close > nyMidnight ? #089981 : #f23645
        table.cell(dashTable, 0, 2, "NY Midnight", text_color=colorNY, text_size=size.small, bgcolor=chart.bg_color)
        table.cell(dashTable, 1, 2, bT3, text_color=color.white, bgcolor=bC3, text_size=size.small)

        msC = structureStatus == "Bullish" ? #089981 : structureStatus == "Bearish" ? #f23645 : #787b86
        table.cell(dashTable, 0, 3, "Market Structure", text_color=chart.fg_color, text_size=size.small, bgcolor=chart.bg_color)
        table.cell(dashTable, 1, 3, structureStatus, text_color=color.white, bgcolor=msC, text_size=size.small)
