//@version=6
indicator("Professional HTF Bias + SMC Dashboard", shorttitle="Institutional SMC", overlay=true, max_labels_count=500, max_lines_count=500)

// --- Groups ---
G_DAY   = "Daily / NY Levels"
G_WEEK  = "Weekly Levels"
G_MONTH = "Monthly Levels"
G_ASIA  = "Asia Session (Liquidity)"
G_SMC   = "SMC / Market Structure"
G_DASH  = "Bias Dashboard"

// --- Constants ---
COLOR_BULL = #089981
COLOR_BEAR = #f23645
COLOR_NEUT = #5b9cf6

// --- Inputs ---
// Daily Group
showMidnight = input.bool(true, "NY Midnight Open", group=G_DAY, tooltip="Shows the New York 00:00 Open level.")
colorNY      = input.color(color.gray, "Midnight Color", group=G_DAY)
showPDH      = input.bool(true, "Prev Day High", group=G_DAY, inline="d1", tooltip="Previous Day High")
showPDL      = input.bool(true, "Prev Day Low", group=G_DAY, inline="d1", tooltip="Previous Day Low")
showDO       = input.bool(true, "Daily Open", group=G_DAY, tooltip="Current Daily Open")
colorDay     = input.color(#f23645, "Daily Color", group=G_DAY)

// Weekly Group
showPWH      = input.bool(true, "Prev Week High", group=G_WEEK, inline="w1", tooltip="Previous Weekly High")
showPWL      = input.bool(true, "Prev Week Low", group=G_WEEK, inline="w1", tooltip="Previous Weekly Low")
showWO       = input.bool(true, "Weekly Open", group=G_WEEK, tooltip="Current Weekly Open")
colorWeek    = input.color(#089981, "Weekly Color", group=G_WEEK)

// Monthly Group
showPMH      = input.bool(true, "Prev Month High", group=G_MONTH, inline="m1", tooltip="Previous Monthly High")
showPML      = input.bool(true, "Prev Month Low", group=G_MONTH, inline="m1", tooltip="Previous Monthly Low")
showMO       = input.bool(true, "Monthly Open", group=G_MONTH, tooltip="Current Monthly Open")
colorMonth   = input.color(#5b9cf6, "Monthly Color", group=G_MONTH)

// Asia Group
showAsia     = input.bool(true, "Asia Session H/L", group=G_ASIA, tooltip="Highlights the high and low of the Asian session.")
asiaSession  = input.session("0000-0900:1234567", "Asia Session Time (UTC)", group=G_ASIA)
colorAsia    = input.color(color.new(#5b9cf6, 50), "Asia Range Color", group=G_ASIA)

// SMC Group
showSMC      = input.bool(true, "Detect Institutional Sweeps & MSS", group=G_SMC, tooltip="Enables SFP (Swing Failure Patterns) and MSS (Market Structure Shifts).")
requireDisp  = input.bool(true, "Require Displacement (ATR Filter)", group=G_SMC, tooltip="Requires the move to be aggressive (large candle bodies) to confirm a shift.")
dispMult     = input.float(1.4, "Displacement Multiplier", step=0.1, group=G_SMC, tooltip="Multiplies the average candle body size to define 'aggressive' movement.")
swingLen     = input.int(3, "Swing Strength (Fractal)", minval=1, group=G_SMC, tooltip="The number of bars on each side for swing high/low detection.")

// Dashboard Group
showDash     = input.bool(true, "Show Bias Dashboard", group=G_DASH)
dashPos      = input.string("Top Right", "Position", options=["Top Right", "Bottom Right", "Top Left"], group=G_DASH)

// --- HTF Data Extraction ---
[pdh, pdl, dO] = request.security(syminfo.tickerid, "D", [high[1], low[1], open[0]], lookahead=barmerge.lookahead_on)
[pwh, pwl, wO] = request.security(syminfo.tickerid, "W", [high[1], low[1], open[0]], lookahead=barmerge.lookahead_on)
[pmh, pml, mO] = request.security(syminfo.tickerid, "M", [high[1], low[1], open[0]], lookahead=barmerge.lookahead_on)

// New York Midnight Calculation
isNewDayNY = hour(time, "America/New_York") == 0 and minute(time, "America/New_York") == 0
var float nyMidnight = na
if isNewDayNY
    nyMidnight := open

// Asia Session Logic
inAsia = not na(time(timeframe.period, asiaSession, "UTC"))
var float asiaH = na
var float asiaL = na
var box asiaBox = na

if inAsia and not inAsia[1]
    asiaH := high
    asiaL := low
    if showAsia
        asiaBox := box.new(bar_index, asiaH, bar_index, asiaL, border_color=colorAsia, bgcolor=color.new(colorAsia, 90))
else if inAsia
    asiaH := math.max(high, nz(asiaH, high))
    asiaL := math.min(low, nz(asiaL, low))
    if showAsia and not na(asiaBox)
        box.set_top(asiaBox, asiaH)
        box.set_bottom(asiaBox, asiaL)
        box.set_right(asiaBox, bar_index)

// --- SMC Institutional Engine ---
var bool waitingForMSS_Short = false
var bool waitingForMSS_Long  = false
var float lastSwh = na
var float lastSwl = na
var string structureStatus = "Neutral"

// Displacement Logic
avgCandleBody = ta.sma(math.abs(close - open), 20)
displacement  = math.abs(close - open) > (avgCandleBody * dispMult)

// Swing Fractals
swh = ta.pivothigh(high, swingLen, swingLen)
swl = ta.pivotlow(low, swingLen, swingLen)
if not na(swh)
    lastSwh := swh
if not na(swl)
    lastSwl := swl

// Liquidity Sweeps (SFP)
isSFP_High = (high > pdh and close < pdh) or (high > pwh and close < pwh) or (high > pmh and close < pmh) or (high > asiaH and close < asiaH)
isSFP_Low  = (low < pdl and close > pdl) or (low < pwl and close > pwl) or (low < pml and close > pml) or (low < asiaL and close > asiaL)

rejectionHigh = isSFP_High and (close < (high + low) / 2)
rejectionLow  = isSFP_Low  and (close > (high + low) / 2)

if showSMC and rejectionHigh
    label.new(bar_index, high, "SFP ⌁", color=#00000000, textcolor=COLOR_BEAR, style=label.style_label_down, size=size.tiny)
    waitingForMSS_Short := true
    waitingForMSS_Long  := false

if showSMC and rejectionLow
    label.new(bar_index, low, "SFP ⌁", color=#00000000, textcolor=COLOR_BULL, style=label.style_label_up, size=size.tiny)
    waitingForMSS_Long  := true
    waitingForMSS_Short := false

// MSS Detection
if showSMC and waitingForMSS_Short and close < lastSwl and (not requireDisp or (displacement and close < open))
    label.new(bar_index, low, "MSS ↘", color=COLOR_BEAR, textcolor=color.white, style=label.style_label_down, size=size.small)
    structureStatus := "Bearish"
    waitingForMSS_Short := false

if showSMC and waitingForMSS_Long and close > lastSwh and (not requireDisp or (displacement and close > open))
    label.new(bar_index, high, "MSS ↗", color=COLOR_BULL, textcolor=color.white, style=label.style_label_up, size=size.small)
    structureStatus := "Bullish"
    waitingForMSS_Long := false

// --- Visual Objects for HTF Levels ---
f_updateLevel(show, val, txt, clr, l, lb) =>
    if show and not na(val)
        line.set_xy1(l, bar_index - 50, val)
        line.set_xy2(l, bar_index + 10, val)
        line.set_color(l, clr)
        label.set_xy(lb, bar_index + 10, val)
        label.set_textcolor(lb, clr)
        label.set_text(lb, txt + " (" + str.tostring(val, format.mintick) + ")")
    else
        line.set_y1(l, na)
        line.set_y2(l, na)
        label.set_y(lb, na)

var lnPDH = line.new(na, na, na, na)
var lbPDH = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnPDL = line.new(na, na, na, na)
var lbPDL = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnDO  = line.new(na, na, na, na)
var lbDO  = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnPWH = line.new(na, na, na, na)
var lbPWH = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnPWL = line.new(na, na, na, na)
var lbPWL = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnPMH = line.new(na, na, na, na)
var lbPMH = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnPML = line.new(na, na, na, na)
var lbPML = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var lnNY  = line.new(na, na, na, na)
var lbNY  = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)

if barstate.islast
    f_updateLevel(showPDH, pdh, "PDH", colorDay, lnPDH, lbPDH)
    f_updateLevel(showPDL, pdl, "PDL", colorDay, lnPDL, lbPDL)
    f_updateLevel(showDO,  dO,  "DO",  colorDay, lnDO,  lbDO)
    f_updateLevel(showPWH, pwh, "PWH", colorWeek, lnPWH, lbPWH)
    f_updateLevel(showPWL, pwl, "PWL", colorWeek, lnPWL, lbPWL)
    f_updateLevel(showPMH, pmh, "PMH", colorMonth, lnPMH, lbPMH)
    f_updateLevel(showPML, pml, "PML", colorMonth, lnPML, lbPML)
    f_updateLevel(showMidnight, nyMidnight, "NY-Mid", colorNY, lnNY, lbNY)

    if showDash
        pos = dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : position.bottom_right
        dashTable = table.new(pos, 2, 6, border_width=1, border_color=chart.fg_color)

        table.cell(dashTable, 0, 0, "HTF / SMC BIAS", bgcolor=chart.fg_color, text_color=chart.bg_color, text_size=size.small)
        table.cell(dashTable, 1, 0, "STATUS", bgcolor=chart.fg_color, text_color=chart.bg_color, text_size=size.small)

        bT1 = close > dO ? "BULL" : "BEAR"
        bC1 = close > dO ? COLOR_BULL : COLOR_BEAR
        table.cell(dashTable, 0, 1, "Daily Open", text_color=chart.fg_color, text_size=size.small, bgcolor=chart.bg_color)
        table.cell(dashTable, 1, 1, bT1, text_color=color.white, bgcolor=bC1, text_size=size.small)

        bT2 = close > wO ? "BULL" : "BEAR"
        bC2 = close > wO ? COLOR_BULL : COLOR_BEAR
        table.cell(dashTable, 0, 2, "Weekly Open", text_color=chart.fg_color, text_size=size.small, bgcolor=chart.bg_color)
        table.cell(dashTable, 1, 2, bT2, text_color=color.white, bgcolor=bC2, text_size=size.small)

        bT3 = close > nyMidnight ? "BULL" : "BEAR"
        bC3 = close > nyMidnight ? COLOR_BULL : COLOR_BEAR
        table.cell(dashTable, 0, 3, "NY Midnight", text_color=chart.fg_color, text_size=size.small, bgcolor=chart.bg_color)
        table.cell(dashTable, 1, 3, bT3, text_color=color.white, bgcolor=bC3, text_size=size.small)

        msC = structureStatus == "Bullish" ? COLOR_BULL : structureStatus == "Bearish" ? COLOR_BEAR : #787b86
        table.cell(dashTable, 0, 4, "Structure", text_color=chart.fg_color, text_size=size.small, bgcolor=chart.bg_color)
        table.cell(dashTable, 1, 4, structureStatus, text_color=color.white, bgcolor=msC, text_size=size.small)

        overAll = (close > dO and structureStatus == "Bullish") ? "STRONG BULL" : (close < dO and structureStatus == "Bearish") ? "STRONG BEAR" : "CONSOLIDATING"
        overC   = (close > dO and structureStatus == "Bullish") ? COLOR_BULL : (close < dO and structureStatus == "Bearish") ? COLOR_BEAR : COLOR_NEUT
        table.cell(dashTable, 0, 5, "Overall Bias", text_color=chart.fg_color, text_size=size.small, bgcolor=chart.bg_color)
        table.cell(dashTable, 1, 5, overAll, text_color=color.white, bgcolor=overC, text_size=size.small)
