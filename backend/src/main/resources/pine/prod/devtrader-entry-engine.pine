// Bridge-driven companion for devtrader-chart.pine.
//@version=6
indicator("Devtrader - Entry Engine", shorttitle="Devtrader Entry", overlay=true, max_bars_back=5000, max_labels_count=250, max_lines_count=80, max_boxes_count=250)

//------------------------------------------------------------------------------
// Constants and Types
//------------------------------------------------------------------------------
string G_MODE = "Signal Mode"
string G_BRIDGE = "Bridge Inputs"
string G_FLOW = "Trade Spacing"
string G_ENTRY = "Entry Timing"
string G_RISK = "Risk Framework"
string G_VIS = "Visuals"
string G_STATS = "Stats"

color COLOR_BULL = #98cac2
color COLOR_BEAR = #d3a3a7
color COLOR_NEUT = #5b9cf6

int HTF_STATE_BEAR_REV = -2
int HTF_STATE_BEAR_CONT = -1
int HTF_STATE_RANGE = 0
int HTF_STATE_BULL_CONT = 1
int HTF_STATE_BULL_REV = 2

type tracked_signal
    bool   isLong
    float  entryPrice
    float  stopPrice
    float  tp1Price
    float  tp2Price
    int    signalBar
    bool   active
    bool   tp1Hit
    string grade

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
string signalMode = input.string("Balanced", "Signal Mode", options=["Aggressive", "Balanced", "Conservative"], group=G_MODE)
string setupFamily = input.string("Both", "Setup Family", options=["Both", "Reversal Only", "Continuation Only"], group=G_MODE)
string directionFilter = input.string("Both", "Direction Filter", options=["Both", "Long Only", "Short Only"], group=G_MODE)
bool requireDirectionalAlignment = input.bool(false, "Require Directional Alignment", group=G_MODE, tooltip="Hard blocker for continuation setups when the bridge context leans the other way.")
bool allowCountertrendReversals = input.bool(true, "Allow Countertrend Reversals", group=G_MODE, tooltip="If disabled, reversal setups are blocked when the compact HTF bridge is strongly opposite.")
float armThresholdBuffer = input.float(14.0, "Arm Threshold Gap", minval=6.0, maxval=24.0, step=1.0, group=G_MODE, tooltip="How much easier it is to arm a setup than to execute it. Larger values keep more valid setups live while waiting for timing.")

bool enforceTradeSpacing = input.bool(true, "Enforce Trade Spacing", group=G_FLOW, tooltip="Suppresses clustered entries so setups remain visually and operationally distinct.")
int minBarsBetweenAnyTrades = input.int(6, "Min Bars Between Any Trades", minval=0, maxval=100, group=G_FLOW)
int minBarsBetweenSameDirection = input.int(12, "Min Bars Same Direction", minval=0, maxval=150, group=G_FLOW)
bool requirePreviousTradeClosed = input.bool(true, "Require Previous Trade To Close", group=G_FLOW, tooltip="Blocks fresh entries while any tracked trade is still active.")
int cooldownAfterResolutionBars = input.int(2, "Cooldown After Resolution", minval=0, maxval=50, group=G_FLOW)
float strongSetupBypassScore = input.float(84.0, "Strong Setup Spacing Bypass", minval=70.0, maxval=95.0, step=1.0, group=G_FLOW, tooltip="Very strong setups can overcome part of the spacing penalties when structure and location are materially new.")

bool bridgeReady = input.bool(false, "Bridge Inputs Ready", group=G_BRIDGE, tooltip="Enable after you manually map the source inputs below to the hidden BRIDGE_* plots from Devtrader - Chart Analysis.")
float bridgeHtfBiasSrc = input.source(close, "BRIDGE_HTF_BIAS", group=G_BRIDGE)
float bridgeContextPackSrc = input.source(close, "BRIDGE_CONTEXT_PACK", group=G_BRIDGE)
float bridgeContextDetailPackSrc = input.source(close, "BRIDGE_CONTEXT_DETAIL_PACK", group=G_BRIDGE)
float bridgeNearestBslSrc = input.source(close, "BRIDGE_NEAREST_BSL", group=G_BRIDGE)
float bridgeNearestSslSrc = input.source(close, "BRIDGE_NEAREST_SSL", group=G_BRIDGE)
float bridgeBslMetaSrc = input.source(close, "BRIDGE_BSL_META", group=G_BRIDGE)
float bridgeSslMetaSrc = input.source(close, "BRIDGE_SSL_META", group=G_BRIDGE)
float bridgeSweepLevelSrc = input.source(close, "BRIDGE_SWEEP_LEVEL", group=G_BRIDGE)
float bridgeStopAnchorSrc = input.source(close, "BRIDGE_STOP_ANCHOR", group=G_BRIDGE)
float bridgeWaitShortMetaSrc = input.source(close, "BRIDGE_WAIT_SHORT_META", group=G_BRIDGE)
float bridgeWaitLongMetaSrc = input.source(close, "BRIDGE_WAIT_LONG_META", group=G_BRIDGE)
float bridgeStructurePackSrc = input.source(close, "BRIDGE_STRUCTURE_PACK", group=G_BRIDGE)
float bridgeProtHighSrc = input.source(close, "BRIDGE_PROT_HIGH", group=G_BRIDGE)
float bridgeProtLowSrc = input.source(close, "BRIDGE_PROT_LOW", group=G_BRIDGE)
float bridgeIdmLevelSrc = input.source(close, "BRIDGE_IDM_LEVEL", group=G_BRIDGE)
float bridgeIdmMetaSrc = input.source(close, "BRIDGE_IDM_META", group=G_BRIDGE)
float bridgeBullFvgCeSrc = input.source(close, "BRIDGE_BULL_FVG_CE", group=G_BRIDGE)
float bridgeBullFvgMetaSrc = input.source(close, "BRIDGE_BULL_FVG_META", group=G_BRIDGE)
float bridgeBearFvgCeSrc = input.source(close, "BRIDGE_BEAR_FVG_CE", group=G_BRIDGE)
float bridgeBearFvgMetaSrc = input.source(close, "BRIDGE_BEAR_FVG_META", group=G_BRIDGE)

string entryTiming = input.string("Confirmation Candle", "Entry Timing", options=["Reclaim Close", "Confirmation Candle", "Retest Entry"], group=G_ENTRY)
int setupExpiryBars = input.int(8, "Setup Expiry Bars", minval=1, maxval=30, group=G_ENTRY)
int maxRetestBars = input.int(6, "Max Retest Bars", minval=1, maxval=20, group=G_ENTRY)
float confirmationBodyMult = input.float(1.15, "Confirmation Body Mult", minval=0.8, step=0.05, group=G_ENTRY)
float rejectionWickRatio = input.float(0.85, "Retest Wick Ratio", minval=0.3, step=0.05, group=G_ENTRY)
bool allowSecondaryTiming = input.bool(true, "Allow Secondary Timing Paths", group=G_ENTRY, tooltip="Lets a strong reclaim, retest, or confirmation candle qualify as secondary timing when it is not the selected primary mode.")

string stopMethod = input.string("Bridge Hybrid", "Stop Method", options=["Sweep Anchor", "Protected Level", "Bridge Hybrid", "ATR Structure"], group=G_RISK)
float stopAtrBuffer = input.float(0.15, "Stop ATR Buffer", minval=0.0, step=0.05, group=G_RISK)
float atrStructureMult = input.float(1.15, "ATR Structure Mult", minval=0.5, step=0.05, group=G_RISK)
string targetMethod = input.string("Nearest Opposing Liquidity", "Target Method", options=["Nearest Opposing Liquidity", "R-Multiple", "External Liquidity"], group=G_RISK)
float tp1R = input.float(1.0, "TP1 R-Multiple", minval=0.5, step=0.25, group=G_RISK)
float tp2R = input.float(2.0, "TP2 R-Multiple", minval=1.0, step=0.25, group=G_RISK)
float entryBufferAtr = input.float(0.0, "Entry Buffer ATR", minval=0.0, step=0.05, group=G_RISK)
float minRRToFirstTarget = input.float(0.80, "Min RR To First Target", minval=0.25, step=0.05, group=G_RISK)

bool showTradeBoxes = input.bool(true, "Show Trade Boxes", group=G_VIS)
bool showBoxText = input.bool(false, "Show Box Text", group=G_VIS)
bool showQualityScore = input.bool(true, "Include Score In Box Text", group=G_VIS)
bool showOnlyAB = input.bool(false, "Draw Only A/B Trades", group=G_VIS)
int tradeBoxWidthBars = input.int(12, "Trade Box Width (Bars)", minval=2, maxval=80, group=G_VIS)
int tradeBoxHistory = input.int(30, "Trade Boxes To Keep", minval=5, maxval=80, group=G_VIS)
bool showCompactInfo = input.bool(true, "Show Compact Info Table", group=G_VIS)
bool showDiagnostics = input.bool(true, "Show Diagnostics Rows", group=G_VIS, tooltip="Adds compact execution diagnostics so setup flow can be tuned without guessing.")
color longColor = input.color(color.new(COLOR_BULL, 0), "Long Color", group=G_VIS)
color shortColor = input.color(color.new(COLOR_BEAR, 0), "Short Color", group=G_VIS)
color profitBoxColor = input.color(color.new(#27ae60, 78), "Profit Box Fill", group=G_VIS)
color riskBoxColor = input.color(color.new(#e74c3c, 80), "Risk Box Fill", group=G_VIS)
color profitBoxBorderColor = input.color(color.new(#27ae60, 0), "Profit Box Border", group=G_VIS)
color riskBoxBorderColor = input.color(color.new(#e74c3c, 0), "Risk Box Border", group=G_VIS)
color boxTextColor = input.color(color.white, "Trade Box Text", group=G_VIS)

bool enableOutcomeStats = input.bool(true, "Track Simple Outcomes", group=G_STATS)
int statsHistoryCap = input.int(150, "Tracked Signals", minval=25, maxval=400, group=G_STATS)

//------------------------------------------------------------------------------
// Utilities
//------------------------------------------------------------------------------
f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

f_boolScore(bool cond, float score) =>
    cond ? score : 0.0

f_gradeText(float score) =>
    score >= 85.0 ? "A" : score >= 70.0 ? "B" : score >= 60.0 ? "C" : "D"

f_modeThreshold(string mode) =>
    mode == "Aggressive" ? 56.0 : mode == "Conservative" ? 76.0 : 66.0

f_armThreshold(string mode) =>
    f_clamp(f_modeThreshold(mode) - armThresholdBuffer, 40.0, 74.0)

f_softPenalty(bool cond, float penalty) =>
    cond ? penalty : 0.0

f_signalAllowedByDirection(bool isLong) =>
    directionFilter == "Both" or (isLong and directionFilter == "Long Only") or (not isLong and directionFilter == "Short Only")

f_signalAllowedByFamily(string family) =>
    setupFamily == "Both" or (setupFamily == "Reversal Only" and family == "Reversal") or (setupFamily == "Continuation Only" and family == "Continuation")

f_distanceScore(float distAtr) =>
    na(distAtr) ? 0.0 : distAtr <= 0.10 ? 100.0 : distAtr <= 0.35 ? 86.0 : distAtr <= 0.75 ? 70.0 : distAtr <= 1.25 ? 54.0 : distAtr <= 2.0 ? 32.0 : 12.0

f_priceDistScore(float anchor, float ref, float atrRef) =>
    not na(anchor) and not na(ref) and atrRef > 0 ? f_distanceScore(math.abs(anchor - ref) / atrRef) : 0.0

f_relDistanceAtr(float a, float b, float atrRef) =>
    not na(a) and not na(b) and atrRef > 0 ? math.abs(a - b) / atrRef : na

f_roundInt(float src) =>
    int(math.round(nz(src, 0.0)))

f_packField(int pack, int divisor, int base) =>
    int(math.floor(pack / divisor)) % base

f_hasBit(int mask, int bit) =>
    int(math.floor(mask / bit)) % 2 == 1

f_firstValid(float a, float b, float c, float d) =>
    not na(a) ? a : not na(b) ? b : not na(c) ? c : d

f_minValid4(float a, float b, float c, float d) =>
    float out = na
    if not na(a)
        out := a
    if not na(b)
        out := na(out) ? b : math.min(out, b)
    if not na(c)
        out := na(out) ? c : math.min(out, c)
    if not na(d)
        out := na(out) ? d : math.min(out, d)
    out

f_maxValid4(float a, float b, float c, float d) =>
    float out = na
    if not na(a)
        out := a
    if not na(b)
        out := na(out) ? b : math.max(out, b)
    if not na(c)
        out := na(out) ? c : math.max(out, c)
    if not na(d)
        out := na(out) ? d : math.max(out, d)
    out

f_liqClassScore(int classCode) =>
    classCode == 5 ? 16.0 : classCode == 4 ? 14.0 : classCode == 3 ? 10.0 : classCode == 2 ? 8.0 : classCode == 1 ? 4.0 : 0.0

f_liqTierScore(int tierCode) =>
    tierCode == 3 ? 16.0 : tierCode == 2 ? 10.0 : tierCode == 1 ? 4.0 : 0.0

f_waitTierScore(int tierCode) =>
    tierCode == 2 ? 18.0 : tierCode == 1 ? 10.0 : 0.0

f_rejectionScore(int rejectionCode) =>
    rejectionCode == 1 ? 10.0 : rejectionCode == 2 ? 4.0 : rejectionCode == 3 ? -12.0 : 0.0

f_rrSoftScore(float rr, float targetFloor) =>
    na(rr) ? 0.0 : rr >= targetFloor + 0.50 ? 96.0 : rr >= targetFloor + 0.20 ? 88.0 : rr >= targetFloor ? 78.0 : rr >= targetFloor * 0.85 ? 68.0 : rr >= targetFloor * 0.70 ? 54.0 : rr >= targetFloor * 0.55 ? 40.0 : 20.0

f_stopEfficiencyScore(float riskAtr) =>
    na(riskAtr) ? 0.0 : riskAtr <= 0.20 ? 44.0 : riskAtr <= 0.45 ? 86.0 : riskAtr <= 0.85 ? 94.0 : riskAtr <= 1.30 ? 74.0 : riskAtr <= 1.80 ? 56.0 : 34.0

f_dynamicThreshold(string mode, string family, float baseScore, float timingQuality, float riskQuality, float sessionQuality, float contextQuality, float spacingPenalty) =>
    float threshold = f_modeThreshold(mode)
    threshold -= baseScore >= 82.0 ? 3.0 : baseScore >= 74.0 ? 1.5 : 0.0
    threshold -= timingQuality >= 92.0 ? 3.0 : timingQuality >= 80.0 ? 2.0 : timingQuality >= 70.0 ? 1.0 : 0.0
    threshold -= riskQuality >= 86.0 ? 2.0 : riskQuality >= 74.0 ? 1.0 : 0.0
    threshold -= family == "Reversal" and sessionQuality >= 86.0 ? 1.0 : 0.0
    threshold += sessionQuality < 42.0 ? 2.5 : 0.0
    threshold += family == "Continuation" and contextQuality < 50.0 ? 2.0 : 0.0
    threshold += spacingPenalty > 18.0 ? 1.5 : 0.0
    f_clamp(threshold, f_modeThreshold(mode) - 6.0, f_modeThreshold(mode) + 6.0)

f_spacingPenalty(int anyGap, int dirGap, int cooldownGap, int openTrades, float candidateScore, bool freshStructure, bool sameLocation, bool sameFamily) =>
    float penalty = 0.0
    if enforceTradeSpacing
        if minBarsBetweenAnyTrades > 0 and anyGap < minBarsBetweenAnyTrades
            penalty += float(minBarsBetweenAnyTrades - anyGap) * 4.0
        if minBarsBetweenSameDirection > 0 and dirGap < minBarsBetweenSameDirection
            penalty += float(minBarsBetweenSameDirection - dirGap) * 3.0
        if requirePreviousTradeClosed and openTrades > 0
            penalty += 11.0 + math.max(float(openTrades - 1), 0.0) * 3.0
        if cooldownAfterResolutionBars > 0 and cooldownGap < cooldownAfterResolutionBars
            penalty += float(cooldownAfterResolutionBars - cooldownGap) * 4.5
        penalty -= candidateScore >= strongSetupBypassScore ? 10.0 : candidateScore >= 74.0 ? 4.0 : 0.0
        penalty -= freshStructure ? 7.0 : 0.0
        penalty -= not sameLocation ? 4.0 : 0.0
        penalty -= not sameFamily ? 3.0 : 0.0
    math.max(penalty, 0.0)

f_executionState(bool armed, bool timingPass, bool riskPass, bool spacingHardBlocked, bool ready, string rejectReason) =>
    not ready ? "Reject" : spacingHardBlocked ? "Reject" : timingPass and riskPass ? "Signal" : armed ? "Pending" : "Idle"

f_stateScore(int state, bool isLong) =>
    if isLong
        state == HTF_STATE_BULL_CONT ? 100.0 : state == HTF_STATE_BULL_REV ? 82.0 : state == HTF_STATE_RANGE ? 54.0 : state == HTF_STATE_BEAR_REV ? 28.0 : 0.0
    else
        state == HTF_STATE_BEAR_CONT ? 100.0 : state == HTF_STATE_BEAR_REV ? 82.0 : state == HTF_STATE_RANGE ? 54.0 : state == HTF_STATE_BULL_REV ? 28.0 : 0.0

f_pdContinuationBonus(float pdPos, bool isLong) =>
    if isLong
        pdPos <= 0.30 ? 14.0 : pdPos <= 0.50 ? 8.0 : pdPos <= 0.65 ? 2.0 : -8.0
    else
        pdPos >= 0.70 ? 14.0 : pdPos >= 0.50 ? 8.0 : pdPos >= 0.35 ? 2.0 : -8.0

f_pdReversalBonus(float pdPos, bool isLong) =>
    if isLong
        pdPos <= 0.20 ? 16.0 : pdPos <= 0.40 ? 10.0 : pdPos <= 0.60 ? 4.0 : -6.0
    else
        pdPos >= 0.80 ? 16.0 : pdPos >= 0.60 ? 10.0 : pdPos >= 0.40 ? 4.0 : -6.0

f_bridgeLiqScore(bool found, int classCode, int tierCode, int importance, int actionability, float priceRef, float atrRef) =>
    found ? f_clamp(f_liqClassScore(classCode) + f_liqTierScore(tierCode) + importance * 0.28 + actionability * 0.28 + f_priceDistScore(close, priceRef, atrRef) * 0.12, 0.0, 100.0) : 0.0

f_decodeWaitFlags(int meta) =>
    // WAIT meta uses decimal slots plus an 11-bit flags mask. The mask can exceed 999 because of the 1024 bit,
    // so this strips 1k blocks until the remainder fits the flag ceiling and uses that as the primary state.
    int lower = meta % 10000
    int flags = lower
    if flags > 2047
        flags -= 1000
    if flags > 2047
        flags -= 1000
    if flags > 2047
        flags -= 1000
    math.max(flags, 0)

f_decodeWaitRejection(int meta) =>
    int lower = meta % 10000
    int flags = f_decodeWaitFlags(meta)
    int(math.max(0, math.min(3, math.round((lower - flags) / 1000.0))))

f_decodeFvgWidth(int meta) =>
    int lower = meta % 1000000
    int(math.floor(lower / 10))

f_decodeFvgHook(int meta) =>
    // The bridge stores 0 / 5 / 10 hook points in the low digits. A stored 10 can spill into the width bucket,
    // so width is treated as primary and the hook is only a small bonus.
    int lower = meta % 10
    lower == 5 ? 5 : lower == 0 ? 0 : lower

f_sessionScore(bool isReversal, bool asiaFlag, bool londonFlag, bool nyFlag, bool londonSweepFlag, bool nySweepFlag) =>
    float score = 48.0
    if isReversal
        score := londonSweepFlag or nySweepFlag ? 96.0 : londonFlag or nyFlag ? 78.0 : asiaFlag ? 52.0 : 34.0
    else
        score := londonFlag or nyFlag ? 88.0 : londonSweepFlag or nySweepFlag ? 82.0 : asiaFlag ? 60.0 : 46.0
    score

f_sessionText(bool asiaFlag, bool londonFlag, bool nyFlag, bool londonSweepFlag, bool nySweepFlag) =>
    londonSweepFlag ? "London sweep" : nySweepFlag ? "NY sweep" : londonFlag ? "London" : nyFlag ? "New York" : asiaFlag ? "Asia" : "Off session"

f_tradeBoxText(bool isLong, string family, string grade, float score) =>
    if not showBoxText
        ""
    else
        string txt = isLong ? "Long " : "Short "
        txt += family + " " + grade
        if showQualityScore
            txt += " " + str.tostring(score, "#")
        txt

//------------------------------------------------------------------------------
// Local Bar Metrics
//------------------------------------------------------------------------------
max_bars_back(time, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)

float atrVal = ta.atr(14)
float avgBody = ta.sma(math.abs(close - open), 20)
float avgVol = ta.sma(volume, 20)
float relVol = avgVol > 0 ? volume / avgVol : 1.0
float barRange = high - low
float safeRange = math.max(barRange, syminfo.mintick)
float body = math.abs(close - open)
float lowerWick = math.min(open, close) - low
float upperWick = high - math.max(open, close)
bool bullDisp = close > open and body > avgBody * confirmationBodyMult and close >= high - safeRange * 0.35
bool bearDisp = close < open and body > avgBody * confirmationBodyMult and close <= low + safeRange * 0.35
bool bullConfirmCandle = close > open and (body > avgBody * confirmationBodyMult or bullDisp or close > high[1])
bool bearConfirmCandle = close < open and (body > avgBody * confirmationBodyMult or bearDisp or close < low[1])
float touchTolerance = math.max(atrVal * 0.10, syminfo.mintick * 4.0)
float entryBuffer = atrVal * entryBufferAtr
float chartBarSeconds = timeframe.in_seconds(timeframe.period)
int chartBarMillis = int(math.max(chartBarSeconds, 60.0) * 1000.0)

//------------------------------------------------------------------------------
// Bridge Decode
//------------------------------------------------------------------------------
float htfBias = nz(bridgeHtfBiasSrc, 0.0)
int contextPack = f_roundInt(bridgeContextPackSrc)
int contextDetailPack = f_roundInt(bridgeContextDetailPackSrc)
int bslMeta = f_roundInt(bridgeBslMetaSrc)
int sslMeta = f_roundInt(bridgeSslMetaSrc)
int waitShortMeta = f_roundInt(bridgeWaitShortMetaSrc)
int waitLongMeta = f_roundInt(bridgeWaitLongMetaSrc)
int structurePack = f_roundInt(bridgeStructurePackSrc)
int idmMeta = f_roundInt(bridgeIdmMetaSrc)
int bullFvgMeta = f_roundInt(bridgeBullFvgMetaSrc)
int bearFvgMeta = f_roundInt(bridgeBearFvgMetaSrc)

// Decode the compact context packs published by devtrader-chart.pine.
int htf1StateCode = f_packField(contextPack, 1000000000000, 10)
int htf2StateCode = f_packField(contextPack, 100000000000, 10)
int structureTrendCode = f_packField(contextPack, 10000000000, 10)
int msBiasCode = f_packField(contextPack, 1000000000, 10)
int htf1State = htf1StateCode - 2
int htf2State = htf2StateCode - 2
int structureTrend = structureTrendCode - 1
int msBias = msBiasCode - 1
bool htf1NearHighLiq = f_packField(contextPack, 100000000, 10) == 1
bool htf1NearLowLiq = f_packField(contextPack, 10000000, 10) == 1
bool htf2NearHighLiq = f_packField(contextPack, 1000000, 10) == 1
bool htf2NearLowLiq = f_packField(contextPack, 100000, 10) == 1
bool inAsia = f_packField(contextPack, 10000, 10) == 1
bool inLondon = f_packField(contextPack, 1000, 10) == 1
bool inNY = f_packField(contextPack, 100, 10) == 1
bool inLondonSweepWindow = f_packField(contextPack, 10, 10) == 1
bool inNYSweepWindow = f_packField(contextPack, 1, 10) == 1

int htf1Conf = f_packField(contextDetailPack, 100000000, 100)
int htf2Conf = f_packField(contextDetailPack, 1000000, 100)
int htf1PdRaw = f_packField(contextDetailPack, 10000, 100)
int htf2PdRaw = f_packField(contextDetailPack, 100, 100)
int htf1DispCode = f_packField(contextDetailPack, 10, 10)
int htf2DispCode = f_packField(contextDetailPack, 1, 10)
int htf1DispBias = htf1DispCode - 1
int htf2DispBias = htf2DispCode - 1

bool nearestBslFound = f_packField(bslMeta, 1000000, 10) == 1 and not na(bridgeNearestBslSrc)
bool nearestSslFound = f_packField(sslMeta, 1000000, 10) == 1 and not na(bridgeNearestSslSrc)
int nearestBslClass = f_packField(bslMeta, 100000, 10)
int nearestSslClass = f_packField(sslMeta, 100000, 10)
int nearestBslTier = f_packField(bslMeta, 10000, 10)
int nearestSslTier = f_packField(sslMeta, 10000, 10)
int nearestBslImportance = f_packField(bslMeta, 100, 100)
int nearestSslImportance = f_packField(sslMeta, 100, 100)
int nearestBslActionability = f_packField(bslMeta, 1, 100)
int nearestSslActionability = f_packField(sslMeta, 1, 100)
float nearestBsl = nearestBslFound ? bridgeNearestBslSrc : na
float nearestSsl = nearestSslFound ? bridgeNearestSslSrc : na

int waitShortTier = f_packField(waitShortMeta, 10000, 10)
int waitLongTier = f_packField(waitLongMeta, 10000, 10)
int waitShortFlags = f_decodeWaitFlags(waitShortMeta)
int waitLongFlags = f_decodeWaitFlags(waitLongMeta)
int waitShortRejection = f_decodeWaitRejection(waitShortMeta)
int waitLongRejection = f_decodeWaitRejection(waitLongMeta)

bool waitShortActive = (waitShortTier > 0 or f_hasBit(waitShortFlags, 1)) and not na(bridgeSweepLevelSrc)
bool waitLongActive = (waitLongTier > 0 or f_hasBit(waitLongFlags, 1)) and not na(bridgeSweepLevelSrc)
bool waitShortReclaimOk = f_hasBit(waitShortFlags, 2)
bool waitLongReclaimOk = f_hasBit(waitLongFlags, 2)
bool waitShortSessionOk = f_hasBit(waitShortFlags, 4)
bool waitLongSessionOk = f_hasBit(waitLongFlags, 4)
bool waitShortVolumeOk = f_hasBit(waitShortFlags, 8)
bool waitLongVolumeOk = f_hasBit(waitLongFlags, 8)
bool waitShortChoch = f_hasBit(waitShortFlags, 16)
bool waitLongChoch = f_hasBit(waitLongFlags, 16)
bool waitShortContinuation = f_hasBit(waitShortFlags, 32)
bool waitLongContinuation = f_hasBit(waitLongFlags, 32)
bool waitShortOpposingBroken = f_hasBit(waitShortFlags, 64)
bool waitLongOpposingBroken = f_hasBit(waitLongFlags, 64)
bool waitShortInternalShift = f_hasBit(waitShortFlags, 128)
bool waitLongInternalShift = f_hasBit(waitLongFlags, 128)
bool waitShortExternalShift = f_hasBit(waitShortFlags, 256)
bool waitLongExternalShift = f_hasBit(waitLongFlags, 256)
bool waitShortTrendAligned = f_hasBit(waitShortFlags, 512)
bool waitLongTrendAligned = f_hasBit(waitLongFlags, 512)
bool waitShortPostStructure = f_hasBit(waitShortFlags, 1024)
bool waitLongPostStructure = f_hasBit(waitLongFlags, 1024)

bool structInternalBreakS = f_hasBit(structurePack, 1)
bool structInternalBreakL = f_hasBit(structurePack, 2)
bool structExternalBreakS = f_hasBit(structurePack, 4)
bool structExternalBreakL = f_hasBit(structurePack, 8)
bool structBearChochEvent = f_hasBit(structurePack, 16)
bool structBullChochEvent = f_hasBit(structurePack, 32)
bool structBearBosEvent = f_hasBit(structurePack, 64)
bool structBullBosEvent = f_hasBit(structurePack, 128)
bool protectedBearIntact = f_hasBit(structurePack, 256)
bool protectedBullIntact = f_hasBit(structurePack, 512)
bool continuationConfirmedShort = f_hasBit(structurePack, 1024)
bool continuationConfirmedLong = f_hasBit(structurePack, 2048)

float protectedHigh = bridgeProtHighSrc
float protectedLow = bridgeProtLowSrc
float sweepLevel = bridgeSweepLevelSrc
float stopAnchor = bridgeStopAnchorSrc

int idmState = f_packField(idmMeta, 1000000, 10)
int idmBiasCode = f_packField(idmMeta, 100000, 10)
int idmBias = idmBiasCode > 0 ? idmBiasCode - 1 : 0
int idmScore = f_packField(idmMeta, 1000, 100)
bool idmStrong = f_packField(idmMeta, 100, 10) == 1
bool idmTaken = f_packField(idmMeta, 10, 10) == 1
bool idmPendingSweep = f_packField(idmMeta, 1, 10) == 1
float idmLevel = bridgeIdmLevelSrc

bool bullFvgInside = f_packField(bullFvgMeta, 10000000, 10) == 1
bool bullFvgDirectionalFound = f_packField(bullFvgMeta, 1000000, 10) == 1 and not na(bridgeBullFvgCeSrc)
int bullFvgWidthTicks = f_decodeFvgWidth(bullFvgMeta)
int bullFvgHook = f_decodeFvgHook(bullFvgMeta)
float bullFvgCe = bridgeBullFvgCeSrc
float bullFvgHalfWidth = bullFvgWidthTicks * syminfo.mintick * 0.5
float bullFvgLow = not na(bullFvgCe) ? bullFvgCe - bullFvgHalfWidth : na
float bullFvgHigh = not na(bullFvgCe) ? bullFvgCe + bullFvgHalfWidth : na

bool bearFvgInside = f_packField(bearFvgMeta, 10000000, 10) == 1
bool bearFvgDirectionalFound = f_packField(bearFvgMeta, 1000000, 10) == 1 and not na(bridgeBearFvgCeSrc)
int bearFvgWidthTicks = f_decodeFvgWidth(bearFvgMeta)
int bearFvgHook = f_decodeFvgHook(bearFvgMeta)
float bearFvgCe = bridgeBearFvgCeSrc
float bearFvgHalfWidth = bearFvgWidthTicks * syminfo.mintick * 0.5
float bearFvgLow = not na(bearFvgCe) ? bearFvgCe - bearFvgHalfWidth : na
float bearFvgHigh = not na(bearFvgCe) ? bearFvgCe + bearFvgHalfWidth : na

bool contextPackValid = htf1StateCode >= 0 and htf1StateCode <= 4 and htf2StateCode >= 0 and htf2StateCode <= 4 and structureTrendCode >= 0 and structureTrendCode <= 2 and msBiasCode >= 0 and msBiasCode <= 2
bool contextDetailValid = htf1Conf >= 0 and htf1Conf <= 99 and htf2Conf >= 0 and htf2Conf <= 99 and htf1PdRaw >= 0 and htf1PdRaw <= 99 and htf2PdRaw >= 0 and htf2PdRaw <= 99 and htf1DispCode >= 0 and htf1DispCode <= 2 and htf2DispCode >= 0 and htf2DispCode <= 2
bool structureValid = structurePack >= 0 and structurePack <= 4095
bool idmValid = idmState >= 0 and idmState <= 4 and idmScore >= 0 and idmScore <= 99 and idmBiasCode >= 0 and idmBiasCode <= 2
bool bridgeCoreValid = bridgeReady and contextPackValid and structureValid
bool bridgeDetailValid = contextDetailValid
bool bridgeOptionalValid = idmValid
bool bridgeValid = bridgeCoreValid

//------------------------------------------------------------------------------
// Bridge-Derived Context and Confluence
//------------------------------------------------------------------------------
float htf1ConfSafe = bridgeDetailValid ? float(htf1Conf) : 50.0
float htf2ConfSafe = bridgeDetailValid ? float(htf2Conf) : 50.0
float htf1PdSafe = bridgeDetailValid ? float(htf1PdRaw) : 50.0
float htf2PdSafe = bridgeDetailValid ? float(htf2PdRaw) : 50.0
int htf1DispBiasSafe = bridgeDetailValid ? htf1DispBias : 0
int htf2DispBiasSafe = bridgeDetailValid ? htf2DispBias : 0
float avgHtfConf = (htf1ConfSafe + htf2ConfSafe) * 0.5
float avgPdPos = (htf1PdSafe + htf2PdSafe) * 0.5 / 100.0
float bridgeResiliencePenalty = f_softPenalty(not bridgeDetailValid, 5.0) + f_softPenalty(not bridgeOptionalValid, 3.0)

float longContextScore = f_clamp(math.max(htfBias, 0.0) * 0.40 + (f_stateScore(htf1State, true) + f_stateScore(htf2State, true)) * 0.18 + avgHtfConf * 0.16 + f_boolScore(msBias == 1, 12.0) + f_boolScore(structureTrend == 1, 10.0) + f_boolScore(htf1DispBiasSafe == 1 or htf2DispBiasSafe == 1, 6.0) + f_boolScore(htf1NearLowLiq or htf2NearLowLiq, 6.0) - f_boolScore(htf1NearHighLiq or htf2NearHighLiq, 6.0), 0.0, 100.0)
float shortContextScore = f_clamp(math.max(-htfBias, 0.0) * 0.40 + (f_stateScore(htf1State, false) + f_stateScore(htf2State, false)) * 0.18 + avgHtfConf * 0.16 + f_boolScore(msBias == -1, 12.0) + f_boolScore(structureTrend == -1, 10.0) + f_boolScore(htf1DispBiasSafe == -1 or htf2DispBiasSafe == -1, 6.0) + f_boolScore(htf1NearHighLiq or htf2NearHighLiq, 6.0) - f_boolScore(htf1NearLowLiq or htf2NearLowLiq, 6.0), 0.0, 100.0)

float longSupportScore = f_bridgeLiqScore(nearestSslFound, nearestSslClass, nearestSslTier, nearestSslImportance, nearestSslActionability, nearestSsl, atrVal)
float shortSupportScore = f_bridgeLiqScore(nearestBslFound, nearestBslClass, nearestBslTier, nearestBslImportance, nearestBslActionability, nearestBsl, atrVal)
float longTargetScore = f_bridgeLiqScore(nearestBslFound, nearestBslClass, nearestBslTier, nearestBslImportance, nearestBslActionability, nearestBsl, atrVal)
float shortTargetScore = f_bridgeLiqScore(nearestSslFound, nearestSslClass, nearestSslTier, nearestSslImportance, nearestSslActionability, nearestSsl, atrVal)

float longIdmConfluence = bridgeOptionalValid and idmBias == 1 and not na(idmLevel) ? f_clamp(idmScore * 0.65 + f_boolScore(idmStrong, 12.0) + (idmState == 1 ? 10.0 : idmTaken ? 6.0 : idmState == 2 ? -8.0 : 0.0) + f_priceDistScore(close, idmLevel, atrVal) * 0.25 + f_boolScore(idmPendingSweep, 4.0), 0.0, 100.0) : 0.0
float shortIdmConfluence = bridgeOptionalValid and idmBias == -1 and not na(idmLevel) ? f_clamp(idmScore * 0.65 + f_boolScore(idmStrong, 12.0) + (idmState == 1 ? 10.0 : idmTaken ? 6.0 : idmState == 2 ? -8.0 : 0.0) + f_priceDistScore(close, idmLevel, atrVal) * 0.25 + f_boolScore(idmPendingSweep, 4.0), 0.0, 100.0) : 0.0

float bullFvgWidthAtr = atrVal > 0 ? bullFvgWidthTicks * syminfo.mintick / atrVal : na
float bearFvgWidthAtr = atrVal > 0 ? bearFvgWidthTicks * syminfo.mintick / atrVal : na
float longFvgConfluence = bullFvgDirectionalFound or bullFvgInside ? f_clamp((bullFvgInside ? 70.0 : 56.0) + f_priceDistScore(close, bullFvgCe, atrVal) * 0.18 + f_clamp(12.0 - nz(bullFvgWidthAtr, 0.0) * 4.0, 0.0, 12.0) + bullFvgHook, 0.0, 100.0) : 0.0
float shortFvgConfluence = bearFvgDirectionalFound or bearFvgInside ? f_clamp((bearFvgInside ? 70.0 : 56.0) + f_priceDistScore(close, bearFvgCe, atrVal) * 0.18 + f_clamp(12.0 - nz(bearFvgWidthAtr, 0.0) * 4.0, 0.0, 12.0) + bearFvgHook, 0.0, 100.0) : 0.0

float longConfluenceScore = f_clamp(longIdmConfluence * 0.35 + longFvgConfluence * 0.30 + longSupportScore * 0.20 + longTargetScore * 0.15, 0.0, 100.0)
float shortConfluenceScore = f_clamp(shortIdmConfluence * 0.35 + shortFvgConfluence * 0.30 + shortSupportScore * 0.20 + shortTargetScore * 0.15, 0.0, 100.0)

bool longProtectedOk = protectedBullIntact or na(protectedLow)
bool shortProtectedOk = protectedBearIntact or na(protectedHigh)

float longPullbackAnchor = f_firstValid(idmBias == 1 ? idmLevel : na, bullFvgDirectionalFound or bullFvgInside ? bullFvgCe : na, protectedLow, nearestSsl)
float shortPullbackAnchor = f_firstValid(idmBias == -1 ? idmLevel : na, bearFvgDirectionalFound or bearFvgInside ? bearFvgCe : na, protectedHigh, nearestBsl)
float longPullbackProxScore = f_priceDistScore(close, longPullbackAnchor, atrVal)
float shortPullbackProxScore = f_priceDistScore(close, shortPullbackAnchor, atrVal)
float sweepProxScore = f_priceDistScore(close, sweepLevel, atrVal)

float longReversalZoneLow = f_minValid4(stopAnchor, protectedLow, bullFvgLow, sweepLevel)
float longReversalZoneHigh = f_maxValid4(sweepLevel, bullFvgHigh, protectedLow, idmBias == 1 ? idmLevel : na)
float longReversalEntryRef = f_firstValid(sweepLevel, bullFvgCe, protectedLow, close)
float longReversalStopRef = f_minValid4(stopAnchor, protectedLow, bullFvgLow, sweepLevel)

float shortReversalZoneLow = f_minValid4(sweepLevel, bearFvgLow, protectedHigh, idmBias == -1 ? idmLevel : na)
float shortReversalZoneHigh = f_maxValid4(stopAnchor, protectedHigh, bearFvgHigh, sweepLevel)
float shortReversalEntryRef = f_firstValid(sweepLevel, bearFvgCe, protectedHigh, close)
float shortReversalStopRef = f_maxValid4(stopAnchor, protectedHigh, bearFvgHigh, sweepLevel)

float longContinuationZoneLow = f_minValid4(protectedLow, idmBias == 1 ? idmLevel : na, bullFvgLow, nearestSsl)
float longContinuationZoneHigh = f_maxValid4(protectedLow, idmBias == 1 ? idmLevel : na, bullFvgHigh, nearestSsl)
float longContinuationEntryRef = f_firstValid(idmBias == 1 ? idmLevel : na, bullFvgCe, protectedLow, nearestSsl)
float longContinuationStopRef = f_minValid4(protectedLow, idmBias == 1 ? idmLevel : na, bullFvgLow, nearestSsl)

float shortContinuationZoneLow = f_minValid4(protectedHigh, idmBias == -1 ? idmLevel : na, bearFvgLow, nearestBsl)
float shortContinuationZoneHigh = f_maxValid4(protectedHigh, idmBias == -1 ? idmLevel : na, bearFvgHigh, nearestBsl)
float shortContinuationEntryRef = f_firstValid(idmBias == -1 ? idmLevel : na, bearFvgCe, protectedHigh, nearestBsl)
float shortContinuationStopRef = f_maxValid4(protectedHigh, idmBias == -1 ? idmLevel : na, bearFvgHigh, nearestBsl)

//------------------------------------------------------------------------------
// Multi-Stage Candidate Evaluation
//------------------------------------------------------------------------------
float longReversalSessionScore = f_sessionScore(true, inAsia, inLondon, inNY, inLondonSweepWindow, inNYSweepWindow)
float shortReversalSessionScore = f_sessionScore(true, inAsia, inLondon, inNY, inLondonSweepWindow, inNYSweepWindow)
float longContinuationSessionScore = f_sessionScore(false, inAsia, inLondon, inNY, inLondonSweepWindow, inNYSweepWindow)
float shortContinuationSessionScore = f_sessionScore(false, inAsia, inLondon, inNY, inLondonSweepWindow, inNYSweepWindow)

float longReversalLocationScore = f_clamp(sweepProxScore * 0.40 + longIdmConfluence * 0.20 + longFvgConfluence * 0.18 + longSupportScore * 0.22, 0.0, 100.0)
float shortReversalLocationScore = f_clamp(sweepProxScore * 0.40 + shortIdmConfluence * 0.20 + shortFvgConfluence * 0.18 + shortSupportScore * 0.22, 0.0, 100.0)
float longContinuationLocationScore = f_clamp(longPullbackProxScore * 0.42 + longIdmConfluence * 0.22 + longFvgConfluence * 0.18 + longSupportScore * 0.18, 0.0, 100.0)
float shortContinuationLocationScore = f_clamp(shortPullbackProxScore * 0.42 + shortIdmConfluence * 0.22 + shortFvgConfluence * 0.18 + shortSupportScore * 0.18, 0.0, 100.0)

int longReversalSupportCount = (waitLongReclaimOk ? 1 : 0) + ((waitLongChoch or structBullChochEvent) ? 1 : 0) + ((waitLongInternalShift or structInternalBreakL) ? 1 : 0) + ((waitLongExternalShift or structExternalBreakL) ? 1 : 0) + ((waitLongPostStructure or waitLongOpposingBroken) ? 1 : 0)
int shortReversalSupportCount = (waitShortReclaimOk ? 1 : 0) + ((waitShortChoch or structBearChochEvent) ? 1 : 0) + ((waitShortInternalShift or structInternalBreakS) ? 1 : 0) + ((waitShortExternalShift or structExternalBreakS) ? 1 : 0) + ((waitShortPostStructure or waitShortOpposingBroken) ? 1 : 0)
int longContinuationSupportCount = (continuationConfirmedLong ? 1 : 0) + (structBullBosEvent ? 1 : 0) + (structBullChochEvent ? 1 : 0) + (structInternalBreakL ? 1 : 0) + (structExternalBreakL ? 1 : 0)
int shortContinuationSupportCount = (continuationConfirmedShort ? 1 : 0) + (structBearBosEvent ? 1 : 0) + (structBearChochEvent ? 1 : 0) + (structInternalBreakS ? 1 : 0) + (structExternalBreakS ? 1 : 0)

bool longReversalCoreOk = (waitLongActive or sweepProxScore >= 68.0) and longReversalSupportCount >= 2 and not na(longReversalEntryRef) and not na(longReversalStopRef)
bool shortReversalCoreOk = (waitShortActive or sweepProxScore >= 68.0) and shortReversalSupportCount >= 2 and not na(shortReversalEntryRef) and not na(shortReversalStopRef)
bool longContinuationCoreOk = longContinuationSupportCount >= 1 and (longPullbackProxScore >= 32.0 or longConfluenceScore >= 48.0 or longContextScore >= 58.0) and not na(longContinuationEntryRef) and not na(longContinuationStopRef)
bool shortContinuationCoreOk = shortContinuationSupportCount >= 1 and (shortPullbackProxScore >= 32.0 or shortConfluenceScore >= 48.0 or shortContextScore >= 58.0) and not na(shortContinuationEntryRef) and not na(shortContinuationStopRef)

float longReversalCounterPenalty = math.max(shortContextScore - longContextScore - 8.0, 0.0) * (allowCountertrendReversals ? 0.20 : 0.32) + f_softPenalty(not allowCountertrendReversals and htfBias < -20.0, 4.0)
float shortReversalCounterPenalty = math.max(longContextScore - shortContextScore - 8.0, 0.0) * (allowCountertrendReversals ? 0.20 : 0.32) + f_softPenalty(not allowCountertrendReversals and htfBias > 20.0, 4.0)
float longContinuationAlignmentPenalty = math.max(shortContextScore - longContextScore - 4.0, 0.0) * 0.22 + f_softPenalty(requireDirectionalAlignment and structureTrend == -1, 4.0) + f_softPenalty(msBias == -1, 4.0)
float shortContinuationAlignmentPenalty = math.max(longContextScore - shortContextScore - 4.0, 0.0) * 0.22 + f_softPenalty(requireDirectionalAlignment and structureTrend == 1, 4.0) + f_softPenalty(msBias == 1, 4.0)

bool longReversalHardBlocked = not allowCountertrendReversals and shortContextScore > longContextScore + 34.0 and htfBias < -48.0 and not waitLongPostStructure
bool shortReversalHardBlocked = not allowCountertrendReversals and longContextScore > shortContextScore + 34.0 and htfBias > 48.0 and not waitShortPostStructure
bool longContinuationHardBlocked = requireDirectionalAlignment and shortContextScore > longContextScore + 34.0 and structureTrend == -1 and msBias == -1 and htfBias < -48.0
bool shortContinuationHardBlocked = requireDirectionalAlignment and longContextScore > shortContextScore + 34.0 and structureTrend == 1 and msBias == 1 and htfBias > 48.0

float longReversalPackageBonus = f_boolScore(waitLongReclaimOk and (waitLongChoch or structBullChochEvent), 8.0) + f_boolScore(waitLongReclaimOk and (waitLongInternalShift or structInternalBreakL or waitLongExternalShift or structExternalBreakL), 6.0) + f_boolScore((waitLongPostStructure or waitLongOpposingBroken) and waitLongRejection != 3, 6.0) + f_boolScore(longReversalLocationScore >= 60.0, 5.0)
float shortReversalPackageBonus = f_boolScore(waitShortReclaimOk and (waitShortChoch or structBearChochEvent), 8.0) + f_boolScore(waitShortReclaimOk and (waitShortInternalShift or structInternalBreakS or waitShortExternalShift or structExternalBreakS), 6.0) + f_boolScore((waitShortPostStructure or waitShortOpposingBroken) and waitShortRejection != 3, 6.0) + f_boolScore(shortReversalLocationScore >= 60.0, 5.0)
float longContinuationPackageBonus = f_boolScore(structBullBosEvent and (bullFvgDirectionalFound or bullFvgInside or idmBias == 1 or not na(protectedLow)), 8.0) + f_boolScore((structBullChochEvent or continuationConfirmedLong) and longProtectedOk, 6.0) + f_boolScore(structInternalBreakL and longContextScore >= 58.0 and longPullbackProxScore >= 52.0, 6.0) + f_boolScore(msBias == 1 and structureTrend == 1 and (longFvgConfluence >= 55.0 or longIdmConfluence >= 55.0), 5.0)
float shortContinuationPackageBonus = f_boolScore(structBearBosEvent and (bearFvgDirectionalFound or bearFvgInside or idmBias == -1 or not na(protectedHigh)), 8.0) + f_boolScore((structBearChochEvent or continuationConfirmedShort) and shortProtectedOk, 6.0) + f_boolScore(structInternalBreakS and shortContextScore >= 58.0 and shortPullbackProxScore >= 52.0, 6.0) + f_boolScore(msBias == -1 and structureTrend == -1 and (shortFvgConfluence >= 55.0 or shortIdmConfluence >= 55.0), 5.0)

float longReversalTriggerScore = f_clamp(f_boolScore(waitLongActive, 16.0) + f_waitTierScore(waitLongTier) * 0.82 + math.max(f_rejectionScore(waitLongRejection), -8.0) + f_boolScore(waitLongReclaimOk, 12.0) + f_boolScore(waitLongChoch or structBullChochEvent, 10.0) + f_boolScore(waitLongContinuation or continuationConfirmedLong, 7.0) + f_boolScore(waitLongInternalShift or structInternalBreakL, 8.0) + f_boolScore(waitLongExternalShift or structExternalBreakL, 8.0) + f_boolScore(waitLongPostStructure or waitLongOpposingBroken, 10.0) + f_boolScore(waitLongTrendAligned, 4.0) + f_boolScore(waitLongSessionOk, 4.0) + f_boolScore(waitLongVolumeOk or relVol >= 0.95, 4.0) + sweepProxScore * 0.10 + longReversalPackageBonus + longReversalSessionScore * 0.10 + f_pdReversalBonus(avgPdPos, true) - longReversalCounterPenalty - bridgeResiliencePenalty, 0.0, 100.0)
float shortReversalTriggerScore = f_clamp(f_boolScore(waitShortActive, 16.0) + f_waitTierScore(waitShortTier) * 0.82 + math.max(f_rejectionScore(waitShortRejection), -8.0) + f_boolScore(waitShortReclaimOk, 12.0) + f_boolScore(waitShortChoch or structBearChochEvent, 10.0) + f_boolScore(waitShortContinuation or continuationConfirmedShort, 7.0) + f_boolScore(waitShortInternalShift or structInternalBreakS, 8.0) + f_boolScore(waitShortExternalShift or structExternalBreakS, 8.0) + f_boolScore(waitShortPostStructure or waitShortOpposingBroken, 10.0) + f_boolScore(waitShortTrendAligned, 4.0) + f_boolScore(waitShortSessionOk, 4.0) + f_boolScore(waitShortVolumeOk or relVol >= 0.95, 4.0) + sweepProxScore * 0.10 + shortReversalPackageBonus + shortReversalSessionScore * 0.10 + f_pdReversalBonus(avgPdPos, false) - shortReversalCounterPenalty - bridgeResiliencePenalty, 0.0, 100.0)

float longContinuationTriggerScore = f_clamp(f_boolScore(continuationConfirmedLong, 16.0) + f_boolScore(structBullBosEvent, 14.0) + f_boolScore(structBullChochEvent, 10.0) + f_boolScore(structInternalBreakL, 8.0) + f_boolScore(structExternalBreakL, 8.0) + f_boolScore(longProtectedOk, 9.0) + f_boolScore(msBias == 1, 6.0) + f_boolScore(structureTrend == 1, 6.0) + f_boolScore(inLondon or inNY, 6.0) + f_boolScore(inLondonSweepWindow or inNYSweepWindow, 5.0) + f_boolScore(inAsia, 3.0) + f_boolScore(relVol >= 0.95, 4.0) + longPullbackProxScore * 0.18 + longContinuationPackageBonus + longContinuationSessionScore * 0.08 + f_pdContinuationBonus(avgPdPos, true) - longContinuationAlignmentPenalty - bridgeResiliencePenalty, 0.0, 100.0)
float shortContinuationTriggerScore = f_clamp(f_boolScore(continuationConfirmedShort, 16.0) + f_boolScore(structBearBosEvent, 14.0) + f_boolScore(structBearChochEvent, 10.0) + f_boolScore(structInternalBreakS, 8.0) + f_boolScore(structExternalBreakS, 8.0) + f_boolScore(shortProtectedOk, 9.0) + f_boolScore(msBias == -1, 6.0) + f_boolScore(structureTrend == -1, 6.0) + f_boolScore(inLondon or inNY, 6.0) + f_boolScore(inLondonSweepWindow or inNYSweepWindow, 5.0) + f_boolScore(inAsia, 3.0) + f_boolScore(relVol >= 0.95, 4.0) + shortPullbackProxScore * 0.18 + shortContinuationPackageBonus + shortContinuationSessionScore * 0.08 + f_pdContinuationBonus(avgPdPos, false) - shortContinuationAlignmentPenalty - bridgeResiliencePenalty, 0.0, 100.0)

float longReversalStructureQuality = f_clamp(longReversalTriggerScore * 0.72 + longReversalLocationScore * 0.28, 0.0, 100.0)
float shortReversalStructureQuality = f_clamp(shortReversalTriggerScore * 0.72 + shortReversalLocationScore * 0.28, 0.0, 100.0)
float longContinuationStructureQuality = f_clamp(longContinuationTriggerScore * 0.68 + longContinuationLocationScore * 0.32, 0.0, 100.0)
float shortContinuationStructureQuality = f_clamp(shortContinuationTriggerScore * 0.68 + shortContinuationLocationScore * 0.32, 0.0, 100.0)

float longReversalScore = f_clamp(longContextScore * 0.18 + longReversalStructureQuality * 0.46 + longConfluenceScore * 0.18 + longReversalSessionScore * 0.12 + longReversalLocationScore * 0.06, 0.0, 100.0)
float shortReversalScore = f_clamp(shortContextScore * 0.18 + shortReversalStructureQuality * 0.46 + shortConfluenceScore * 0.18 + shortReversalSessionScore * 0.12 + shortReversalLocationScore * 0.06, 0.0, 100.0)
float longContinuationScore = f_clamp(longContextScore * 0.30 + longContinuationStructureQuality * 0.38 + longConfluenceScore * 0.16 + longContinuationSessionScore * 0.10 + longContinuationLocationScore * 0.06, 0.0, 100.0)
float shortContinuationScore = f_clamp(shortContextScore * 0.30 + shortContinuationStructureQuality * 0.38 + shortConfluenceScore * 0.16 + shortContinuationSessionScore * 0.10 + shortContinuationLocationScore * 0.06, 0.0, 100.0)

string longReversalStage = waitLongReclaimOk and (waitLongChoch or structBullChochEvent) ? "sweep reclaim + CHOCH" : (waitLongRejection == 1 or waitLongRejection == 2) and (waitLongInternalShift or structInternalBreakL or waitLongExternalShift or structExternalBreakL) ? "sweep rejection + shift" : (waitLongPostStructure or waitLongOpposingBroken) and waitLongReclaimOk ? "post-sweep hold + reclaim" : longReversalSupportCount >= 3 ? "sweep reaction package" : "qualified sweep reaction"
string shortReversalStage = waitShortReclaimOk and (waitShortChoch or structBearChochEvent) ? "sweep reclaim + CHOCH" : (waitShortRejection == 1 or waitShortRejection == 2) and (waitShortInternalShift or structInternalBreakS or waitShortExternalShift or structExternalBreakS) ? "sweep rejection + shift" : (waitShortPostStructure or waitShortOpposingBroken) and waitShortReclaimOk ? "post-sweep hold + reclaim" : shortReversalSupportCount >= 3 ? "sweep reaction package" : "qualified sweep reaction"
string longContinuationStage = structBullBosEvent and (bullFvgDirectionalFound or bullFvgInside or idmBias == 1 or not na(protectedLow)) ? "BOS + pullback zone" : (structBullChochEvent or continuationConfirmedLong) and longProtectedOk ? "CHOCH + protected hold" : structInternalBreakL and longContextScore >= 58.0 ? "internal break + efficient pullback" : "bullish continuation package"
string shortContinuationStage = structBearBosEvent and (bearFvgDirectionalFound or bearFvgInside or idmBias == -1 or not na(protectedHigh)) ? "BOS + pullback zone" : (structBearChochEvent or continuationConfirmedShort) and shortProtectedOk ? "CHOCH + protected hold" : structInternalBreakS and shortContextScore >= 58.0 ? "internal break + efficient pullback" : "bearish continuation package"

bool longReversalCandidateReady = bridgeValid and f_signalAllowedByDirection(true) and f_signalAllowedByFamily("Reversal") and longReversalCoreOk and not longReversalHardBlocked and longReversalScore >= f_armThreshold(signalMode)
bool shortReversalCandidateReady = bridgeValid and f_signalAllowedByDirection(false) and f_signalAllowedByFamily("Reversal") and shortReversalCoreOk and not shortReversalHardBlocked and shortReversalScore >= f_armThreshold(signalMode)
bool longContinuationCandidateReady = bridgeValid and f_signalAllowedByDirection(true) and f_signalAllowedByFamily("Continuation") and longContinuationCoreOk and not longContinuationHardBlocked and longContinuationScore >= f_armThreshold(signalMode)
bool shortContinuationCandidateReady = bridgeValid and f_signalAllowedByDirection(false) and f_signalAllowedByFamily("Continuation") and shortContinuationCoreOk and not shortContinuationHardBlocked and shortContinuationScore >= f_armThreshold(signalMode)
bool longReversalTrackable = bridgeValid and f_signalAllowedByDirection(true) and f_signalAllowedByFamily("Reversal") and longReversalCoreOk and not longReversalHardBlocked
bool shortReversalTrackable = bridgeValid and f_signalAllowedByDirection(false) and f_signalAllowedByFamily("Reversal") and shortReversalCoreOk and not shortReversalHardBlocked
bool longContinuationTrackable = bridgeValid and f_signalAllowedByDirection(true) and f_signalAllowedByFamily("Continuation") and longContinuationCoreOk and not longContinuationHardBlocked
bool shortContinuationTrackable = bridgeValid and f_signalAllowedByDirection(false) and f_signalAllowedByFamily("Continuation") and shortContinuationCoreOk and not shortContinuationHardBlocked

//------------------------------------------------------------------------------
// Entry Timing State
//------------------------------------------------------------------------------
var bool longRevArmActive = false
var float longRevArmScore = na
var float longRevArmEntryRef = na
var float longRevArmZoneLow = na
var float longRevArmZoneHigh = na
var float longRevArmStopRef = na
var int longRevArmBar = na
var string longRevArmReason = ""

var bool longContArmActive = false
var float longContArmScore = na
var float longContArmEntryRef = na
var float longContArmZoneLow = na
var float longContArmZoneHigh = na
var float longContArmStopRef = na
var int longContArmBar = na
var string longContArmReason = ""

var bool shortRevArmActive = false
var float shortRevArmScore = na
var float shortRevArmEntryRef = na
var float shortRevArmZoneLow = na
var float shortRevArmZoneHigh = na
var float shortRevArmStopRef = na
var int shortRevArmBar = na
var string shortRevArmReason = ""

var bool shortContArmActive = false
var float shortContArmScore = na
var float shortContArmEntryRef = na
var float shortContArmZoneLow = na
var float shortContArmZoneHigh = na
var float shortContArmStopRef = na
var int shortContArmBar = na
var string shortContArmReason = ""

if not bridgeValid
    longRevArmActive := false
    longContArmActive := false
    shortRevArmActive := false
    shortContArmActive := false

float rearmTolerance = math.max(atrVal * 0.35, syminfo.mintick * 8.0)
bool longRevNeedsRearm = longReversalCandidateReady and (not longRevArmActive or math.abs(nz(longReversalEntryRef, close) - nz(longRevArmEntryRef, close)) > rearmTolerance or math.abs(nz(longReversalZoneHigh, close) - nz(longRevArmZoneHigh, close)) > rearmTolerance or math.abs(nz(longReversalZoneLow, close) - nz(longRevArmZoneLow, close)) > rearmTolerance)
bool longContNeedsRearm = longContinuationCandidateReady and (not longContArmActive or math.abs(nz(longContinuationEntryRef, close) - nz(longContArmEntryRef, close)) > rearmTolerance or math.abs(nz(longContinuationZoneHigh, close) - nz(longContArmZoneHigh, close)) > rearmTolerance or math.abs(nz(longContinuationZoneLow, close) - nz(longContArmZoneLow, close)) > rearmTolerance)
bool shortRevNeedsRearm = shortReversalCandidateReady and (not shortRevArmActive or math.abs(nz(shortReversalEntryRef, close) - nz(shortRevArmEntryRef, close)) > rearmTolerance or math.abs(nz(shortReversalZoneHigh, close) - nz(shortRevArmZoneHigh, close)) > rearmTolerance or math.abs(nz(shortReversalZoneLow, close) - nz(shortRevArmZoneLow, close)) > rearmTolerance)
bool shortContNeedsRearm = shortContinuationCandidateReady and (not shortContArmActive or math.abs(nz(shortContinuationEntryRef, close) - nz(shortContArmEntryRef, close)) > rearmTolerance or math.abs(nz(shortContinuationZoneHigh, close) - nz(shortContArmZoneHigh, close)) > rearmTolerance or math.abs(nz(shortContinuationZoneLow, close) - nz(shortContArmZoneLow, close)) > rearmTolerance)

if longRevNeedsRearm
    longRevArmActive := true
    longRevArmScore := longReversalScore
    longRevArmEntryRef := longReversalEntryRef
    longRevArmZoneLow := longReversalZoneLow
    longRevArmZoneHigh := longReversalZoneHigh
    longRevArmStopRef := longReversalStopRef
    longRevArmBar := bar_index
    longRevArmReason := longReversalStage
else if longReversalCandidateReady and longRevArmActive
    longRevArmScore := math.max(nz(longRevArmScore, longReversalScore), longReversalScore)
    longRevArmEntryRef := longReversalEntryRef
    longRevArmZoneLow := longReversalZoneLow
    longRevArmZoneHigh := longReversalZoneHigh
    longRevArmStopRef := longReversalStopRef
    longRevArmReason := longReversalStage

if longContNeedsRearm
    longContArmActive := true
    longContArmScore := longContinuationScore
    longContArmEntryRef := longContinuationEntryRef
    longContArmZoneLow := longContinuationZoneLow
    longContArmZoneHigh := longContinuationZoneHigh
    longContArmStopRef := longContinuationStopRef
    longContArmBar := bar_index
    longContArmReason := longContinuationStage
else if longContinuationCandidateReady and longContArmActive
    longContArmScore := math.max(nz(longContArmScore, longContinuationScore), longContinuationScore)
    longContArmEntryRef := longContinuationEntryRef
    longContArmZoneLow := longContinuationZoneLow
    longContArmZoneHigh := longContinuationZoneHigh
    longContArmStopRef := longContinuationStopRef
    longContArmReason := longContinuationStage

if shortRevNeedsRearm
    shortRevArmActive := true
    shortRevArmScore := shortReversalScore
    shortRevArmEntryRef := shortReversalEntryRef
    shortRevArmZoneLow := shortReversalZoneLow
    shortRevArmZoneHigh := shortReversalZoneHigh
    shortRevArmStopRef := shortReversalStopRef
    shortRevArmBar := bar_index
    shortRevArmReason := shortReversalStage
else if shortReversalCandidateReady and shortRevArmActive
    shortRevArmScore := math.max(nz(shortRevArmScore, shortReversalScore), shortReversalScore)
    shortRevArmEntryRef := shortReversalEntryRef
    shortRevArmZoneLow := shortReversalZoneLow
    shortRevArmZoneHigh := shortReversalZoneHigh
    shortRevArmStopRef := shortReversalStopRef
    shortRevArmReason := shortReversalStage

if shortContNeedsRearm
    shortContArmActive := true
    shortContArmScore := shortContinuationScore
    shortContArmEntryRef := shortContinuationEntryRef
    shortContArmZoneLow := shortContinuationZoneLow
    shortContArmZoneHigh := shortContinuationZoneHigh
    shortContArmStopRef := shortContinuationStopRef
    shortContArmBar := bar_index
    shortContArmReason := shortContinuationStage
else if shortContinuationCandidateReady and shortContArmActive
    shortContArmScore := math.max(nz(shortContArmScore, shortContinuationScore), shortContinuationScore)
    shortContArmEntryRef := shortContinuationEntryRef
    shortContArmZoneLow := shortContinuationZoneLow
    shortContArmZoneHigh := shortContinuationZoneHigh
    shortContArmStopRef := shortContinuationStopRef
    shortContArmReason := shortContinuationStage

int longRevExpiryLimit = setupExpiryBars + (nz(longRevArmScore, 0.0) >= 80.0 ? 2 : 0) + 1
int longContExpiryLimit = setupExpiryBars + (nz(longContArmScore, 0.0) >= 80.0 ? 2 : 0)
int shortRevExpiryLimit = setupExpiryBars + (nz(shortRevArmScore, 0.0) >= 80.0 ? 2 : 0) + 1
int shortContExpiryLimit = setupExpiryBars + (nz(shortContArmScore, 0.0) >= 80.0 ? 2 : 0)

bool longRevArmExpired = longRevArmActive and not na(longRevArmBar) and (bar_index - longRevArmBar) > longRevExpiryLimit
bool longContArmExpired = longContArmActive and not na(longContArmBar) and (bar_index - longContArmBar) > longContExpiryLimit
bool shortRevArmExpired = shortRevArmActive and not na(shortRevArmBar) and (bar_index - shortRevArmBar) > shortRevExpiryLimit
bool shortContArmExpired = shortContArmActive and not na(shortContArmBar) and (bar_index - shortContArmBar) > shortContExpiryLimit

bool longRevArmInvalid = longRevArmActive and not na(longRevArmStopRef) and low < longRevArmStopRef - touchTolerance
bool longContArmInvalid = longContArmActive and not na(longContArmStopRef) and low < longContArmStopRef - touchTolerance
bool shortRevArmInvalid = shortRevArmActive and not na(shortRevArmStopRef) and high > shortRevArmStopRef + touchTolerance
bool shortContArmInvalid = shortContArmActive and not na(shortContArmStopRef) and high > shortContArmStopRef + touchTolerance

if longRevArmExpired or longRevArmInvalid
    longRevArmActive := false
if longContArmExpired or longContArmInvalid
    longContArmActive := false
if shortRevArmExpired or shortRevArmInvalid
    shortRevArmActive := false
if shortContArmExpired or shortContArmInvalid
    shortContArmActive := false

bool longRevTouchZone = longRevArmActive and low <= nz(longRevArmZoneHigh, longRevArmEntryRef) + touchTolerance and high >= nz(longRevArmZoneLow, longRevArmEntryRef) - touchTolerance
bool longContTouchZone = longContArmActive and low <= nz(longContArmZoneHigh, longContArmEntryRef) + touchTolerance and high >= nz(longContArmZoneLow, longContArmEntryRef) - touchTolerance
bool shortRevTouchZone = shortRevArmActive and high >= nz(shortRevArmZoneLow, shortRevArmEntryRef) - touchTolerance and low <= nz(shortRevArmZoneHigh, shortRevArmEntryRef) + touchTolerance
bool shortContTouchZone = shortContArmActive and high >= nz(shortContArmZoneLow, shortContArmEntryRef) - touchTolerance and low <= nz(shortContArmZoneHigh, shortContArmEntryRef) + touchTolerance

bool longRevReclaimNow = longRevArmActive and not na(longRevArmEntryRef) and low <= longRevArmEntryRef + touchTolerance and close > longRevArmEntryRef
bool longContReclaimNow = longContArmActive and not na(longContArmEntryRef) and low <= longContArmEntryRef + touchTolerance and close > longContArmEntryRef
bool shortRevReclaimNow = shortRevArmActive and not na(shortRevArmEntryRef) and high >= shortRevArmEntryRef - touchTolerance and close < shortRevArmEntryRef
bool shortContReclaimNow = shortContArmActive and not na(shortContArmEntryRef) and high >= shortContArmEntryRef - touchTolerance and close < shortContArmEntryRef

bool longRevRejectNow = longRevTouchZone and close > nz(longRevArmEntryRef, close) and (lowerWick >= math.max(body, syminfo.mintick) * rejectionWickRatio or bullDisp)
bool longContRejectNow = longContTouchZone and close > nz(longContArmEntryRef, close) and (lowerWick >= math.max(body, syminfo.mintick) * rejectionWickRatio or bullDisp)
bool shortRevRejectNow = shortRevTouchZone and close < nz(shortRevArmEntryRef, close) and (upperWick >= math.max(body, syminfo.mintick) * rejectionWickRatio or bearDisp)
bool shortContRejectNow = shortContTouchZone and close < nz(shortContArmEntryRef, close) and (upperWick >= math.max(body, syminfo.mintick) * rejectionWickRatio or bearDisp)

bool longRevRetestEvent = longRevArmActive and bar_index > nz(longRevArmBar, bar_index) and (bar_index - nz(longRevArmBar, bar_index)) <= maxRetestBars and longRevRejectNow
bool longContRetestEvent = longContArmActive and bar_index > nz(longContArmBar, bar_index) and (bar_index - nz(longContArmBar, bar_index)) <= maxRetestBars and longContRejectNow
bool shortRevRetestEvent = shortRevArmActive and bar_index > nz(shortRevArmBar, bar_index) and (bar_index - nz(shortRevArmBar, bar_index)) <= maxRetestBars and shortRevRejectNow
bool shortContRetestEvent = shortContArmActive and bar_index > nz(shortContArmBar, bar_index) and (bar_index - nz(shortContArmBar, bar_index)) <= maxRetestBars and shortContRejectNow

bool longRevConfirmNow = longRevArmActive and bullConfirmCandle and close > nz(longRevArmEntryRef, close)
bool longContConfirmNow = longContArmActive and bullConfirmCandle and close > nz(longContArmEntryRef, close)
bool shortRevConfirmNow = shortRevArmActive and bearConfirmCandle and close < nz(shortRevArmEntryRef, close)
bool shortContConfirmNow = shortContArmActive and bearConfirmCandle and close < nz(shortContArmEntryRef, close)

bool longRevDispNow = longRevTouchZone and bullDisp and close > nz(longRevArmEntryRef, close)
bool longContDispNow = longContTouchZone and bullDisp and close > nz(longContArmEntryRef, close)
bool shortRevDispNow = shortRevTouchZone and bearDisp and close < nz(shortRevArmEntryRef, close)
bool shortContDispNow = shortContTouchZone and bearDisp and close < nz(shortContArmEntryRef, close)

float longRevReclaimTimingScore = longRevReclaimNow ? (entryTiming == "Reclaim Close" ? 100.0 : allowSecondaryTiming ? 88.0 : 0.0) : 0.0
float longContReclaimTimingScore = longContReclaimNow ? (entryTiming == "Reclaim Close" ? 100.0 : allowSecondaryTiming ? 86.0 : 0.0) : 0.0
float shortRevReclaimTimingScore = shortRevReclaimNow ? (entryTiming == "Reclaim Close" ? 100.0 : allowSecondaryTiming ? 88.0 : 0.0) : 0.0
float shortContReclaimTimingScore = shortContReclaimNow ? (entryTiming == "Reclaim Close" ? 100.0 : allowSecondaryTiming ? 86.0 : 0.0) : 0.0

float longRevConfirmTimingScore = longRevConfirmNow ? (entryTiming == "Confirmation Candle" ? 100.0 : allowSecondaryTiming ? 84.0 : 0.0) : 0.0
float longContConfirmTimingScore = longContConfirmNow ? (entryTiming == "Confirmation Candle" ? 100.0 : allowSecondaryTiming ? 86.0 : 0.0) : 0.0
float shortRevConfirmTimingScore = shortRevConfirmNow ? (entryTiming == "Confirmation Candle" ? 100.0 : allowSecondaryTiming ? 84.0 : 0.0) : 0.0
float shortContConfirmTimingScore = shortContConfirmNow ? (entryTiming == "Confirmation Candle" ? 100.0 : allowSecondaryTiming ? 86.0 : 0.0) : 0.0

float longRevRetestTimingScore = longRevRetestEvent ? (entryTiming == "Retest Entry" ? 100.0 : allowSecondaryTiming ? 82.0 : 0.0) : 0.0
float longContRetestTimingScore = longContRetestEvent ? (entryTiming == "Retest Entry" ? 100.0 : allowSecondaryTiming ? 84.0 : 0.0) : 0.0
float shortRevRetestTimingScore = shortRevRetestEvent ? (entryTiming == "Retest Entry" ? 100.0 : allowSecondaryTiming ? 82.0 : 0.0) : 0.0
float shortContRetestTimingScore = shortContRetestEvent ? (entryTiming == "Retest Entry" ? 100.0 : allowSecondaryTiming ? 84.0 : 0.0) : 0.0

float longRevRejectTimingScore = allowSecondaryTiming and longRevRejectNow ? 76.0 : 0.0
float longContRejectTimingScore = allowSecondaryTiming and longContRejectNow ? 58.0 : 0.0
float shortRevRejectTimingScore = allowSecondaryTiming and shortRevRejectNow ? 76.0 : 0.0
float shortContRejectTimingScore = allowSecondaryTiming and shortContRejectNow ? 58.0 : 0.0

float longRevDispTimingScore = allowSecondaryTiming and longRevDispNow ? 80.0 : 0.0
float longContDispTimingScore = allowSecondaryTiming and longContDispNow ? 72.0 : 0.0
float shortRevDispTimingScore = allowSecondaryTiming and shortRevDispNow ? 80.0 : 0.0
float shortContDispTimingScore = allowSecondaryTiming and shortContDispNow ? 72.0 : 0.0

float longRevTimingQuality = math.max(math.max(longRevReclaimTimingScore, longRevConfirmTimingScore), math.max(math.max(longRevRetestTimingScore, longRevRejectTimingScore), longRevDispTimingScore))
float longContTimingQuality = math.max(math.max(longContReclaimTimingScore, longContConfirmTimingScore), math.max(math.max(longContRetestTimingScore, longContRejectTimingScore), longContDispTimingScore))
float shortRevTimingQuality = math.max(math.max(shortRevReclaimTimingScore, shortRevConfirmTimingScore), math.max(math.max(shortRevRetestTimingScore, shortRevRejectTimingScore), shortRevDispTimingScore))
float shortContTimingQuality = math.max(math.max(shortContReclaimTimingScore, shortContConfirmTimingScore), math.max(math.max(shortContRetestTimingScore, shortContRejectTimingScore), shortContDispTimingScore))

bool longRevTimingPass = longRevArmActive and longRevTimingQuality >= 62.0 and (longRevReclaimNow or longRevConfirmNow or longRevRetestEvent or (allowSecondaryTiming and (longRevRejectNow or longRevDispNow)))
bool longContTimingPass = longContArmActive and longContTimingQuality >= 64.0 and (longContReclaimNow or longContConfirmNow or longContRetestEvent or (allowSecondaryTiming and longContDispNow))
bool shortRevTimingPass = shortRevArmActive and shortRevTimingQuality >= 62.0 and (shortRevReclaimNow or shortRevConfirmNow or shortRevRetestEvent or (allowSecondaryTiming and (shortRevRejectNow or shortRevDispNow)))
bool shortContTimingPass = shortContArmActive and shortContTimingQuality >= 64.0 and (shortContReclaimNow or shortContConfirmNow or shortContRetestEvent or (allowSecondaryTiming and shortContDispNow))

string longRevTimingText = longRevTimingQuality == longRevReclaimTimingScore and longRevTimingQuality > 0.0 ? "Reclaim" : longRevTimingQuality == longRevConfirmTimingScore and longRevTimingQuality > 0.0 ? "Confirm" : longRevTimingQuality == longRevRetestTimingScore and longRevTimingQuality > 0.0 ? "Retest" : longRevTimingQuality == longRevRejectTimingScore and longRevTimingQuality > 0.0 ? "Reject" : longRevTimingQuality == longRevDispTimingScore and longRevTimingQuality > 0.0 ? "Displace" : "Waiting"
string longContTimingText = longContTimingQuality == longContReclaimTimingScore and longContTimingQuality > 0.0 ? "Reclaim" : longContTimingQuality == longContConfirmTimingScore and longContTimingQuality > 0.0 ? "Confirm" : longContTimingQuality == longContRetestTimingScore and longContTimingQuality > 0.0 ? "Retest" : longContTimingQuality == longContDispTimingScore and longContTimingQuality > 0.0 ? "Displace" : longContTimingQuality == longContRejectTimingScore and longContTimingQuality > 0.0 ? "Reject" : "Waiting"
string shortRevTimingText = shortRevTimingQuality == shortRevReclaimTimingScore and shortRevTimingQuality > 0.0 ? "Reclaim" : shortRevTimingQuality == shortRevConfirmTimingScore and shortRevTimingQuality > 0.0 ? "Confirm" : shortRevTimingQuality == shortRevRetestTimingScore and shortRevTimingQuality > 0.0 ? "Retest" : shortRevTimingQuality == shortRevRejectTimingScore and shortRevTimingQuality > 0.0 ? "Reject" : shortRevTimingQuality == shortRevDispTimingScore and shortRevTimingQuality > 0.0 ? "Displace" : "Waiting"
string shortContTimingText = shortContTimingQuality == shortContReclaimTimingScore and shortContTimingQuality > 0.0 ? "Reclaim" : shortContTimingQuality == shortContConfirmTimingScore and shortContTimingQuality > 0.0 ? "Confirm" : shortContTimingQuality == shortContRetestTimingScore and shortContTimingQuality > 0.0 ? "Retest" : shortContTimingQuality == shortContDispTimingScore and shortContTimingQuality > 0.0 ? "Displace" : shortContTimingQuality == shortContRejectTimingScore and shortContTimingQuality > 0.0 ? "Reject" : "Waiting"

//------------------------------------------------------------------------------
// Risk and Targets
//------------------------------------------------------------------------------
float longRevStopBase = na
float longContStopBase = na
float shortRevStopBase = na
float shortContStopBase = na
if stopMethod == "Sweep Anchor"
    longRevStopBase := f_firstValid(stopAnchor, sweepLevel, protectedLow, longRevArmStopRef)
    longContStopBase := f_firstValid(stopAnchor, longContArmStopRef, protectedLow, idmLevel)
    shortRevStopBase := f_firstValid(stopAnchor, sweepLevel, protectedHigh, shortRevArmStopRef)
    shortContStopBase := f_firstValid(stopAnchor, shortContArmStopRef, protectedHigh, idmLevel)
else if stopMethod == "Protected Level"
    longRevStopBase := f_firstValid(protectedLow, longRevArmStopRef, idmLevel, sweepLevel)
    longContStopBase := f_firstValid(protectedLow, longContArmStopRef, idmLevel, sweepLevel)
    shortRevStopBase := f_firstValid(protectedHigh, shortRevArmStopRef, idmLevel, sweepLevel)
    shortContStopBase := f_firstValid(protectedHigh, shortContArmStopRef, idmLevel, sweepLevel)
else if stopMethod == "Bridge Hybrid"
    longRevStopBase := f_minValid4(stopAnchor, protectedLow, bullFvgLow, sweepLevel)
    longContStopBase := f_minValid4(protectedLow, idmBias == 1 ? idmLevel : na, bullFvgLow, nearestSsl)
    shortRevStopBase := f_maxValid4(stopAnchor, protectedHigh, bearFvgHigh, sweepLevel)
    shortContStopBase := f_maxValid4(protectedHigh, idmBias == -1 ? idmLevel : na, bearFvgHigh, nearestBsl)
else
    longRevStopBase := close - atrVal * atrStructureMult
    longContStopBase := close - atrVal * atrStructureMult
    shortRevStopBase := close + atrVal * atrStructureMult
    shortContStopBase := close + atrVal * atrStructureMult

float longRevEntryCandidate = longRevTimingPass ? close + entryBuffer : na
float longContEntryCandidate = longContTimingPass ? close + entryBuffer : na
float shortRevEntryCandidate = shortRevTimingPass ? close - entryBuffer : na
float shortContEntryCandidate = shortContTimingPass ? close - entryBuffer : na

float longRevStopCandidate = not na(longRevEntryCandidate) ? nz(longRevStopBase, longRevArmStopRef) - atrVal * stopAtrBuffer : na
float longContStopCandidate = not na(longContEntryCandidate) ? nz(longContStopBase, longContArmStopRef) - atrVal * stopAtrBuffer : na
float shortRevStopCandidate = not na(shortRevEntryCandidate) ? nz(shortRevStopBase, shortRevArmStopRef) + atrVal * stopAtrBuffer : na
float shortContStopCandidate = not na(shortContEntryCandidate) ? nz(shortContStopBase, shortContArmStopRef) + atrVal * stopAtrBuffer : na

float longRevRisk = not na(longRevEntryCandidate) and not na(longRevStopCandidate) ? longRevEntryCandidate - longRevStopCandidate : na
float longContRisk = not na(longContEntryCandidate) and not na(longContStopCandidate) ? longContEntryCandidate - longContStopCandidate : na
float shortRevRisk = not na(shortRevEntryCandidate) and not na(shortRevStopCandidate) ? shortRevStopCandidate - shortRevEntryCandidate : na
float shortContRisk = not na(shortContEntryCandidate) and not na(shortContStopCandidate) ? shortContStopCandidate - shortContEntryCandidate : na

float longRevR1 = not na(longRevRisk) ? longRevEntryCandidate + longRevRisk * tp1R : na
float longRevR2 = not na(longRevRisk) ? longRevEntryCandidate + longRevRisk * tp2R : na
float longContR1 = not na(longContRisk) ? longContEntryCandidate + longContRisk * tp1R : na
float longContR2 = not na(longContRisk) ? longContEntryCandidate + longContRisk * tp2R : na
float shortRevR1 = not na(shortRevRisk) ? shortRevEntryCandidate - shortRevRisk * tp1R : na
float shortRevR2 = not na(shortRevRisk) ? shortRevEntryCandidate - shortRevRisk * tp2R : na
float shortContR1 = not na(shortContRisk) ? shortContEntryCandidate - shortContRisk * tp1R : na
float shortContR2 = not na(shortContRisk) ? shortContEntryCandidate - shortContRisk * tp2R : na

bool longExternalTargetAvailable = nearestBslFound and nearestBslClass >= 2
bool shortExternalTargetAvailable = nearestSslFound and nearestSslClass >= 2
bool longMinorOpposingTarget = nearestBslFound and (nearestBslClass <= 2 or nearestBslImportance < 50 or nearestBslActionability < 45)
bool shortMinorOpposingTarget = nearestSslFound and (nearestSslClass <= 2 or nearestSslImportance < 50 or nearestSslActionability < 45)

float longRevTp1Candidate = na
float longRevTp2Candidate = na
float longContTp1Candidate = na
float longContTp2Candidate = na
float shortRevTp1Candidate = na
float shortRevTp2Candidate = na
float shortContTp1Candidate = na
float shortContTp2Candidate = na

if targetMethod == "Nearest Opposing Liquidity"
    longRevTp1Candidate := nearestBslFound ? (longMinorOpposingTarget ? math.max(nearestBsl, nz(longRevR1, nearestBsl)) : nearestBsl) : longRevR1
    longRevTp2Candidate := nearestBslFound ? math.max(nearestBsl, nz(longRevR2, nearestBsl)) : longRevR2
    longContTp1Candidate := nearestBslFound ? (longMinorOpposingTarget ? math.max(nearestBsl, nz(longContR1, nearestBsl)) : nearestBsl) : longContR1
    longContTp2Candidate := nearestBslFound ? math.max(nearestBsl, nz(longContR2, nearestBsl)) : longContR2
    shortRevTp1Candidate := nearestSslFound ? (shortMinorOpposingTarget ? math.min(nearestSsl, nz(shortRevR1, nearestSsl)) : nearestSsl) : shortRevR1
    shortRevTp2Candidate := nearestSslFound ? math.min(nearestSsl, nz(shortRevR2, nearestSsl)) : shortRevR2
    shortContTp1Candidate := nearestSslFound ? (shortMinorOpposingTarget ? math.min(nearestSsl, nz(shortContR1, nearestSsl)) : nearestSsl) : shortContR1
    shortContTp2Candidate := nearestSslFound ? math.min(nearestSsl, nz(shortContR2, nearestSsl)) : shortContR2
else if targetMethod == "R-Multiple"
    longRevTp1Candidate := longRevR1
    longRevTp2Candidate := longRevR2
    longContTp1Candidate := longContR1
    longContTp2Candidate := longContR2
    shortRevTp1Candidate := shortRevR1
    shortRevTp2Candidate := shortRevR2
    shortContTp1Candidate := shortContR1
    shortContTp2Candidate := shortContR2
else
    longRevTp1Candidate := longExternalTargetAvailable ? nearestBsl : longRevR1
    longRevTp2Candidate := longExternalTargetAvailable ? math.max(nearestBsl, nz(longRevR2, nearestBsl)) : longRevR2
    longContTp1Candidate := longExternalTargetAvailable ? nearestBsl : longContR1
    longContTp2Candidate := longExternalTargetAvailable ? math.max(nearestBsl, nz(longContR2, nearestBsl)) : longContR2
    shortRevTp1Candidate := shortExternalTargetAvailable ? nearestSsl : shortRevR1
    shortRevTp2Candidate := shortExternalTargetAvailable ? math.min(nearestSsl, nz(shortRevR2, nearestSsl)) : shortRevR2
    shortContTp1Candidate := shortExternalTargetAvailable ? nearestSsl : shortContR1
    shortContTp2Candidate := shortExternalTargetAvailable ? math.min(nearestSsl, nz(shortContR2, nearestSsl)) : shortContR2

float rrHardFloor = math.max(minRRToFirstTarget * 0.55, 0.40)
float rrExpansionFloor = math.max(minRRToFirstTarget + 0.35, 1.10)

bool longRevGeometryValid = not na(longRevRisk) and longRevRisk > syminfo.mintick and not na(longRevTp1Candidate) and not na(longRevTp2Candidate) and longRevStopCandidate < longRevEntryCandidate and longRevTp1Candidate > longRevEntryCandidate and longRevTp2Candidate > longRevEntryCandidate
bool longContGeometryValid = not na(longContRisk) and longContRisk > syminfo.mintick and not na(longContTp1Candidate) and not na(longContTp2Candidate) and longContStopCandidate < longContEntryCandidate and longContTp1Candidate > longContEntryCandidate and longContTp2Candidate > longContEntryCandidate
bool shortRevGeometryValid = not na(shortRevRisk) and shortRevRisk > syminfo.mintick and not na(shortRevTp1Candidate) and not na(shortRevTp2Candidate) and shortRevStopCandidate > shortRevEntryCandidate and shortRevTp1Candidate < shortRevEntryCandidate and shortRevTp2Candidate < shortRevEntryCandidate
bool shortContGeometryValid = not na(shortContRisk) and shortContRisk > syminfo.mintick and not na(shortContTp1Candidate) and not na(shortContTp2Candidate) and shortContStopCandidate > shortContEntryCandidate and shortContTp1Candidate < shortContEntryCandidate and shortContTp2Candidate < shortContEntryCandidate

float longRevRrToFirstTarget = longRevGeometryValid ? (longRevTp1Candidate - longRevEntryCandidate) / longRevRisk : na
float longContRrToFirstTarget = longContGeometryValid ? (longContTp1Candidate - longContEntryCandidate) / longContRisk : na
float shortRevRrToFirstTarget = shortRevGeometryValid ? (shortRevEntryCandidate - shortRevTp1Candidate) / shortRevRisk : na
float shortContRrToFirstTarget = shortContGeometryValid ? (shortContEntryCandidate - shortContTp1Candidate) / shortContRisk : na

float longRevRrToSecondTarget = longRevGeometryValid ? (longRevTp2Candidate - longRevEntryCandidate) / longRevRisk : na
float longContRrToSecondTarget = longContGeometryValid ? (longContTp2Candidate - longContEntryCandidate) / longContRisk : na
float shortRevRrToSecondTarget = shortRevGeometryValid ? (shortRevEntryCandidate - shortRevTp2Candidate) / shortRevRisk : na
float shortContRrToSecondTarget = shortContGeometryValid ? (shortContEntryCandidate - shortContTp2Candidate) / shortContRisk : na

float longRevOpportunityRr = math.max(nz(longRevRrToFirstTarget, 0.0), nz(longRevRrToSecondTarget, 0.0) * 0.75)
float longContOpportunityRr = math.max(nz(longContRrToFirstTarget, 0.0), nz(longContRrToSecondTarget, 0.0) * 0.75)
float shortRevOpportunityRr = math.max(nz(shortRevRrToFirstTarget, 0.0), nz(shortRevRrToSecondTarget, 0.0) * 0.75)
float shortContOpportunityRr = math.max(nz(shortContRrToFirstTarget, 0.0), nz(shortContRrToSecondTarget, 0.0) * 0.75)

float longRevRiskAtr = not na(longRevRisk) and atrVal > 0 ? longRevRisk / atrVal : na
float longContRiskAtr = not na(longContRisk) and atrVal > 0 ? longContRisk / atrVal : na
float shortRevRiskAtr = not na(shortRevRisk) and atrVal > 0 ? shortRevRisk / atrVal : na
float shortContRiskAtr = not na(shortContRisk) and atrVal > 0 ? shortContRisk / atrVal : na

float longRevRiskQuality = longRevGeometryValid ? f_clamp(f_rrSoftScore(longRevRrToFirstTarget, minRRToFirstTarget) * 0.40 + f_rrSoftScore(longRevRrToSecondTarget, rrExpansionFloor) * 0.38 + f_stopEfficiencyScore(longRevRiskAtr) * 0.22, 0.0, 100.0) : 0.0
float longContRiskQuality = longContGeometryValid ? f_clamp(f_rrSoftScore(longContRrToFirstTarget, minRRToFirstTarget) * 0.40 + f_rrSoftScore(longContRrToSecondTarget, rrExpansionFloor) * 0.38 + f_stopEfficiencyScore(longContRiskAtr) * 0.22, 0.0, 100.0) : 0.0
float shortRevRiskQuality = shortRevGeometryValid ? f_clamp(f_rrSoftScore(shortRevRrToFirstTarget, minRRToFirstTarget) * 0.40 + f_rrSoftScore(shortRevRrToSecondTarget, rrExpansionFloor) * 0.38 + f_stopEfficiencyScore(shortRevRiskAtr) * 0.22, 0.0, 100.0) : 0.0
float shortContRiskQuality = shortContGeometryValid ? f_clamp(f_rrSoftScore(shortContRrToFirstTarget, minRRToFirstTarget) * 0.40 + f_rrSoftScore(shortContRrToSecondTarget, rrExpansionFloor) * 0.38 + f_stopEfficiencyScore(shortContRiskAtr) * 0.22, 0.0, 100.0) : 0.0

bool longRevRiskHardBlocked = not longRevGeometryValid or longRevOpportunityRr < rrHardFloor
bool longContRiskHardBlocked = not longContGeometryValid or longContOpportunityRr < rrHardFloor
bool shortRevRiskHardBlocked = not shortRevGeometryValid or shortRevOpportunityRr < rrHardFloor
bool shortContRiskHardBlocked = not shortContGeometryValid or shortContOpportunityRr < rrHardFloor

bool longRevRiskValid = longRevGeometryValid and not longRevRiskHardBlocked and longRevRiskQuality >= 38.0
bool longContRiskValid = longContGeometryValid and not longContRiskHardBlocked and longContRiskQuality >= 38.0
bool shortRevRiskValid = shortRevGeometryValid and not shortRevRiskHardBlocked and shortRevRiskQuality >= 38.0
bool shortContRiskValid = shortContGeometryValid and not shortContRiskHardBlocked and shortContRiskQuality >= 38.0

string longRevRiskReason = not longRevGeometryValid ? "Broken geometry" : longRevOpportunityRr < rrHardFloor ? "Insufficient expansion" : longRevRrToFirstTarget < minRRToFirstTarget and longRevRrToSecondTarget >= rrExpansionFloor ? "Tight TP1, TP2 viable" : longRevRiskQuality >= 72.0 ? "Efficient risk" : "Marginal RR"
string longContRiskReason = not longContGeometryValid ? "Broken geometry" : longContOpportunityRr < rrHardFloor ? "Insufficient expansion" : longContRrToFirstTarget < minRRToFirstTarget and longContRrToSecondTarget >= rrExpansionFloor ? "Tight TP1, TP2 viable" : longContRiskQuality >= 72.0 ? "Efficient risk" : "Marginal RR"
string shortRevRiskReason = not shortRevGeometryValid ? "Broken geometry" : shortRevOpportunityRr < rrHardFloor ? "Insufficient expansion" : shortRevRrToFirstTarget < minRRToFirstTarget and shortRevRrToSecondTarget >= rrExpansionFloor ? "Tight TP1, TP2 viable" : shortRevRiskQuality >= 72.0 ? "Efficient risk" : "Marginal RR"
string shortContRiskReason = not shortContGeometryValid ? "Broken geometry" : shortContOpportunityRr < rrHardFloor ? "Insufficient expansion" : shortContRrToFirstTarget < minRRToFirstTarget and shortContRrToSecondTarget >= rrExpansionFloor ? "Tight TP1, TP2 viable" : shortContRiskQuality >= 72.0 ? "Efficient risk" : "Marginal RR"

//------------------------------------------------------------------------------
// Final Signals
//------------------------------------------------------------------------------
var int lastLongSignalBar = na
var int lastShortSignalBar = na
var int lastAnySignalBar = na
var int lastResolvedTradeBar = na
var int openTradeCountState = 0
var float lastLongSignalEntryRef = na
var float lastShortSignalEntryRef = na
var string lastLongSignalFamily = ""
var string lastShortSignalFamily = ""

int anyGap = not na(lastAnySignalBar) ? bar_index - lastAnySignalBar : 1000
int longGap = not na(lastLongSignalBar) ? bar_index - lastLongSignalBar : 1000
int shortGap = not na(lastShortSignalBar) ? bar_index - lastShortSignalBar : 1000
int cooldownGap = not na(lastResolvedTradeBar) ? bar_index - lastResolvedTradeBar : 1000

bool longRevFreshStructure = waitLongPostStructure or waitLongChoch or structBullChochEvent or waitLongInternalShift or waitLongExternalShift or structInternalBreakL or structExternalBreakL
bool longContFreshStructure = continuationConfirmedLong or structBullBosEvent or structBullChochEvent or structInternalBreakL or structExternalBreakL
bool shortRevFreshStructure = waitShortPostStructure or waitShortChoch or structBearChochEvent or waitShortInternalShift or waitShortExternalShift or structInternalBreakS or structExternalBreakS
bool shortContFreshStructure = continuationConfirmedShort or structBearBosEvent or structBearChochEvent or structInternalBreakS or structExternalBreakS

float longRevLocationGap = f_relDistanceAtr(longRevArmEntryRef, lastLongSignalEntryRef, atrVal)
float longContLocationGap = f_relDistanceAtr(longContArmEntryRef, lastLongSignalEntryRef, atrVal)
float shortRevLocationGap = f_relDistanceAtr(shortRevArmEntryRef, lastShortSignalEntryRef, atrVal)
float shortContLocationGap = f_relDistanceAtr(shortContArmEntryRef, lastShortSignalEntryRef, atrVal)

bool longRevSameLocation = not na(longRevLocationGap) and longRevLocationGap <= 0.35
bool longContSameLocation = not na(longContLocationGap) and longContLocationGap <= 0.35
bool shortRevSameLocation = not na(shortRevLocationGap) and shortRevLocationGap <= 0.35
bool shortContSameLocation = not na(shortContLocationGap) and shortContLocationGap <= 0.35

bool longRevSameFamilyAsLast = lastLongSignalFamily == "Reversal"
bool longContSameFamilyAsLast = lastLongSignalFamily == "Continuation"
bool shortRevSameFamilyAsLast = lastShortSignalFamily == "Reversal"
bool shortContSameFamilyAsLast = lastShortSignalFamily == "Continuation"

float longRevSpacingPenalty = f_spacingPenalty(anyGap, longGap, cooldownGap, openTradeCountState, nz(longRevArmScore, longReversalScore), longRevFreshStructure, longRevSameLocation, longRevSameFamilyAsLast)
float longContSpacingPenalty = f_spacingPenalty(anyGap, longGap, cooldownGap, openTradeCountState, nz(longContArmScore, longContinuationScore), longContFreshStructure, longContSameLocation, longContSameFamilyAsLast)
float shortRevSpacingPenalty = f_spacingPenalty(anyGap, shortGap, cooldownGap, openTradeCountState, nz(shortRevArmScore, shortReversalScore), shortRevFreshStructure, shortRevSameLocation, shortRevSameFamilyAsLast)
float shortContSpacingPenalty = f_spacingPenalty(anyGap, shortGap, cooldownGap, openTradeCountState, nz(shortContArmScore, shortContinuationScore), shortContFreshStructure, shortContSameLocation, shortContSameFamilyAsLast)

bool longRevSpacingHardBlocked = enforceTradeSpacing and not na(lastLongSignalBar) and longGap <= 1 and longRevSameLocation and longRevSameFamilyAsLast
bool longContSpacingHardBlocked = enforceTradeSpacing and not na(lastLongSignalBar) and longGap <= 1 and longContSameLocation and longContSameFamilyAsLast
bool shortRevSpacingHardBlocked = enforceTradeSpacing and not na(lastShortSignalBar) and shortGap <= 1 and shortRevSameLocation and shortRevSameFamilyAsLast
bool shortContSpacingHardBlocked = enforceTradeSpacing and not na(lastShortSignalBar) and shortGap <= 1 and shortContSameLocation and shortContSameFamilyAsLast

float longRevExecutionScore = f_clamp(nz(longRevArmScore, longReversalScore) * 0.58 + longRevTimingQuality * 0.22 + longRevRiskQuality * 0.20 - longRevSpacingPenalty, 0.0, 100.0)
float longContExecutionScore = f_clamp(nz(longContArmScore, longContinuationScore) * 0.58 + longContTimingQuality * 0.22 + longContRiskQuality * 0.20 - longContSpacingPenalty, 0.0, 100.0)
float shortRevExecutionScore = f_clamp(nz(shortRevArmScore, shortReversalScore) * 0.58 + shortRevTimingQuality * 0.22 + shortRevRiskQuality * 0.20 - shortRevSpacingPenalty, 0.0, 100.0)
float shortContExecutionScore = f_clamp(nz(shortContArmScore, shortContinuationScore) * 0.58 + shortContTimingQuality * 0.22 + shortContRiskQuality * 0.20 - shortContSpacingPenalty, 0.0, 100.0)

float longRevExecutionThreshold = f_dynamicThreshold(signalMode, "Reversal", nz(longRevArmScore, longReversalScore), longRevTimingQuality, longRevRiskQuality, longReversalSessionScore, longContextScore, longRevSpacingPenalty)
float longContExecutionThreshold = f_dynamicThreshold(signalMode, "Continuation", nz(longContArmScore, longContinuationScore), longContTimingQuality, longContRiskQuality, longContinuationSessionScore, longContextScore, longContSpacingPenalty)
float shortRevExecutionThreshold = f_dynamicThreshold(signalMode, "Reversal", nz(shortRevArmScore, shortReversalScore), shortRevTimingQuality, shortRevRiskQuality, shortReversalSessionScore, shortContextScore, shortRevSpacingPenalty)
float shortContExecutionThreshold = f_dynamicThreshold(signalMode, "Continuation", nz(shortContArmScore, shortContinuationScore), shortContTimingQuality, shortContRiskQuality, shortContinuationSessionScore, shortContextScore, shortContSpacingPenalty)

bool longRevSignalReady = bridgeValid and longRevTimingPass and longRevRiskValid and not longRevSpacingHardBlocked and longRevExecutionScore >= longRevExecutionThreshold
bool longContSignalReady = bridgeValid and longContTimingPass and longContRiskValid and not longContSpacingHardBlocked and longContExecutionScore >= longContExecutionThreshold
bool shortRevSignalReady = bridgeValid and shortRevTimingPass and shortRevRiskValid and not shortRevSpacingHardBlocked and shortRevExecutionScore >= shortRevExecutionThreshold
bool shortContSignalReady = bridgeValid and shortContTimingPass and shortContRiskValid and not shortContSpacingHardBlocked and shortContExecutionScore >= shortContExecutionThreshold

float longRevPreviewScore = longRevSignalReady ? longRevExecutionScore : longRevArmActive ? nz(longRevArmScore, longReversalScore) : longReversalTrackable ? longReversalScore : na
float longContPreviewScore = longContSignalReady ? longContExecutionScore : longContArmActive ? nz(longContArmScore, longContinuationScore) : longContinuationTrackable ? longContinuationScore : na
float shortRevPreviewScore = shortRevSignalReady ? shortRevExecutionScore : shortRevArmActive ? nz(shortRevArmScore, shortReversalScore) : shortReversalTrackable ? shortReversalScore : na
float shortContPreviewScore = shortContSignalReady ? shortContExecutionScore : shortContArmActive ? nz(shortContArmScore, shortContinuationScore) : shortContinuationTrackable ? shortContinuationScore : na

string longBestFamily = ""
string shortBestFamily = ""
float longBestScore = na
float shortBestScore = na
float longBestEntryRef = na
float shortBestEntryRef = na
float longBestZoneLow = na
float shortBestZoneLow = na
float longBestZoneHigh = na
float shortBestZoneHigh = na
float longBestStopRef = na
float shortBestStopRef = na
string longBestStage = ""
string shortBestStage = ""

if not na(longRevPreviewScore)
    longBestFamily := "Reversal"
    longBestScore := longRevPreviewScore
    longBestEntryRef := nz(longRevArmEntryRef, longReversalEntryRef)
    longBestZoneLow := nz(longRevArmZoneLow, longReversalZoneLow)
    longBestZoneHigh := nz(longRevArmZoneHigh, longReversalZoneHigh)
    longBestStopRef := nz(longRevArmStopRef, longReversalStopRef)
    longBestStage := longRevArmReason != "" ? longRevArmReason : longReversalStage
if not na(longContPreviewScore) and (na(longBestScore) or longContPreviewScore > longBestScore + 0.5)
    longBestFamily := "Continuation"
    longBestScore := longContPreviewScore
    longBestEntryRef := nz(longContArmEntryRef, longContinuationEntryRef)
    longBestZoneLow := nz(longContArmZoneLow, longContinuationZoneLow)
    longBestZoneHigh := nz(longContArmZoneHigh, longContinuationZoneHigh)
    longBestStopRef := nz(longContArmStopRef, longContinuationStopRef)
    longBestStage := longContArmReason != "" ? longContArmReason : longContinuationStage

if not na(shortRevPreviewScore)
    shortBestFamily := "Reversal"
    shortBestScore := shortRevPreviewScore
    shortBestEntryRef := nz(shortRevArmEntryRef, shortReversalEntryRef)
    shortBestZoneLow := nz(shortRevArmZoneLow, shortReversalZoneLow)
    shortBestZoneHigh := nz(shortRevArmZoneHigh, shortReversalZoneHigh)
    shortBestStopRef := nz(shortRevArmStopRef, shortReversalStopRef)
    shortBestStage := shortRevArmReason != "" ? shortRevArmReason : shortReversalStage
if not na(shortContPreviewScore) and (na(shortBestScore) or shortContPreviewScore > shortBestScore + 0.5)
    shortBestFamily := "Continuation"
    shortBestScore := shortContPreviewScore
    shortBestEntryRef := nz(shortContArmEntryRef, shortContinuationEntryRef)
    shortBestZoneLow := nz(shortContArmZoneLow, shortContinuationZoneLow)
    shortBestZoneHigh := nz(shortContArmZoneHigh, shortContinuationZoneHigh)
    shortBestStopRef := nz(shortContArmStopRef, shortContinuationStopRef)
    shortBestStage := shortContArmReason != "" ? shortContArmReason : shortContinuationStage

bool longCandidateReady = longReversalCandidateReady or longContinuationCandidateReady
bool shortCandidateReady = shortReversalCandidateReady or shortContinuationCandidateReady
bool longNeedsRearm = longRevNeedsRearm or longContNeedsRearm
bool shortNeedsRearm = shortRevNeedsRearm or shortContNeedsRearm
bool longArmActive = longRevArmActive or longContArmActive
bool shortArmActive = shortRevArmActive or shortContArmActive
bool longTouchZone = longRevTouchZone or longContTouchZone
bool shortTouchZone = shortRevTouchZone or shortContTouchZone
bool longReclaimNow = longRevReclaimNow or longContReclaimNow
bool shortReclaimNow = shortRevReclaimNow or shortContReclaimNow
bool longRejectNow = longRevRejectNow or longContRejectNow
bool shortRejectNow = shortRevRejectNow or shortContRejectNow
bool longRetestEvent = longRevRetestEvent or longContRetestEvent
bool shortRetestEvent = shortRevRetestEvent or shortContRetestEvent
bool longConfirmNow = longRevConfirmNow or longContConfirmNow
bool shortConfirmNow = shortRevConfirmNow or shortContConfirmNow
bool longTimingPass = longRevTimingPass or longContTimingPass
bool shortTimingPass = shortRevTimingPass or shortContTimingPass

bool longSignal = false
bool shortSignal = false
float longEntryCandidate = na
float shortEntryCandidate = na
float longStopCandidate = na
float shortStopCandidate = na
float longTp1Candidate = na
float shortTp1Candidate = na
float longTp2Candidate = na
float shortTp2Candidate = na
float longRrToFirstTarget = na
float shortRrToFirstTarget = na
float longFinalScore = nz(longBestScore, 0.0)
float shortFinalScore = nz(shortBestScore, 0.0)
float longTimingQuality = 0.0
float shortTimingQuality = 0.0
float longRiskQuality = 0.0
float shortRiskQuality = 0.0
float longStructureQuality = 0.0
float shortStructureQuality = 0.0
float longConfluenceQuality = 0.0
float shortConfluenceQuality = 0.0
float longSpacingPenalty = 0.0
float shortSpacingPenalty = 0.0
float longExecutionThreshold = na
float shortExecutionThreshold = na
bool longRiskValid = false
bool shortRiskValid = false
bool longSpacingBlocked = false
bool shortSpacingBlocked = false
string longSignalFamily = longBestFamily
string shortSignalFamily = shortBestFamily
string longSignalStage = longBestStage
string shortSignalStage = shortBestStage
string longSignalTimingText = longBestFamily == "Reversal" ? longRevTimingText : longBestFamily == "Continuation" ? longContTimingText : "Waiting"
string shortSignalTimingText = shortBestFamily == "Reversal" ? shortRevTimingText : shortBestFamily == "Continuation" ? shortContTimingText : "Waiting"
string longRiskReason = longBestFamily == "Reversal" ? longRevRiskReason : longBestFamily == "Continuation" ? longContRiskReason : "No setup"
string shortRiskReason = shortBestFamily == "Reversal" ? shortRevRiskReason : shortBestFamily == "Continuation" ? shortContRiskReason : "No setup"

if longRevSignalReady and (not longContSignalReady or longRevExecutionScore > longContExecutionScore + 0.5 or (longRevTimingQuality > longContTimingQuality and longRevExecutionScore >= longContExecutionScore - 0.5) or (nz(longRevArmScore, 0.0) > nz(longContArmScore, 0.0) and math.abs(longRevExecutionScore - longContExecutionScore) <= 0.5))
    longSignal := true
    longSignalFamily := "Reversal"
    longSignalStage := longRevArmReason
    longSignalTimingText := longRevTimingText
    longEntryCandidate := longRevEntryCandidate
    longStopCandidate := longRevStopCandidate
    longTp1Candidate := longRevTp1Candidate
    longTp2Candidate := longRevTp2Candidate
    longRrToFirstTarget := longRevRrToFirstTarget
    longFinalScore := longRevExecutionScore
    longTimingQuality := longRevTimingQuality
    longRiskQuality := longRevRiskQuality
    longStructureQuality := longReversalStructureQuality
    longConfluenceQuality := longReversalLocationScore
    longSpacingPenalty := longRevSpacingPenalty
    longExecutionThreshold := longRevExecutionThreshold
    longRiskValid := longRevRiskValid
    longSpacingBlocked := longRevSpacingHardBlocked
    longRiskReason := longRevRiskReason
else if longContSignalReady
    longSignal := true
    longSignalFamily := "Continuation"
    longSignalStage := longContArmReason
    longSignalTimingText := longContTimingText
    longEntryCandidate := longContEntryCandidate
    longStopCandidate := longContStopCandidate
    longTp1Candidate := longContTp1Candidate
    longTp2Candidate := longContTp2Candidate
    longRrToFirstTarget := longContRrToFirstTarget
    longFinalScore := longContExecutionScore
    longTimingQuality := longContTimingQuality
    longRiskQuality := longContRiskQuality
    longStructureQuality := longContinuationStructureQuality
    longConfluenceQuality := longContinuationLocationScore
    longSpacingPenalty := longContSpacingPenalty
    longExecutionThreshold := longContExecutionThreshold
    longRiskValid := longContRiskValid
    longSpacingBlocked := longContSpacingHardBlocked
    longRiskReason := longContRiskReason
else
    longTimingQuality := longBestFamily == "Reversal" ? longRevTimingQuality : longBestFamily == "Continuation" ? longContTimingQuality : 0.0
    longRiskQuality := longBestFamily == "Reversal" ? longRevRiskQuality : longBestFamily == "Continuation" ? longContRiskQuality : 0.0
    longStructureQuality := longBestFamily == "Reversal" ? longReversalStructureQuality : longBestFamily == "Continuation" ? longContinuationStructureQuality : 0.0
    longConfluenceQuality := longBestFamily == "Reversal" ? longReversalLocationScore : longBestFamily == "Continuation" ? longContinuationLocationScore : 0.0
    longSpacingPenalty := longBestFamily == "Reversal" ? longRevSpacingPenalty : longBestFamily == "Continuation" ? longContSpacingPenalty : 0.0
    longExecutionThreshold := longBestFamily == "Reversal" ? longRevExecutionThreshold : longBestFamily == "Continuation" ? longContExecutionThreshold : na
    longRiskValid := longBestFamily == "Reversal" ? longRevRiskValid : longBestFamily == "Continuation" ? longContRiskValid : false
    longSpacingBlocked := longBestFamily == "Reversal" ? longRevSpacingHardBlocked : longBestFamily == "Continuation" ? longContSpacingHardBlocked : false

if shortRevSignalReady and (not shortContSignalReady or shortRevExecutionScore > shortContExecutionScore + 0.5 or (shortRevTimingQuality > shortContTimingQuality and shortRevExecutionScore >= shortContExecutionScore - 0.5) or (nz(shortRevArmScore, 0.0) > nz(shortContArmScore, 0.0) and math.abs(shortRevExecutionScore - shortContExecutionScore) <= 0.5))
    shortSignal := true
    shortSignalFamily := "Reversal"
    shortSignalStage := shortRevArmReason
    shortSignalTimingText := shortRevTimingText
    shortEntryCandidate := shortRevEntryCandidate
    shortStopCandidate := shortRevStopCandidate
    shortTp1Candidate := shortRevTp1Candidate
    shortTp2Candidate := shortRevTp2Candidate
    shortRrToFirstTarget := shortRevRrToFirstTarget
    shortFinalScore := shortRevExecutionScore
    shortTimingQuality := shortRevTimingQuality
    shortRiskQuality := shortRevRiskQuality
    shortStructureQuality := shortReversalStructureQuality
    shortConfluenceQuality := shortReversalLocationScore
    shortSpacingPenalty := shortRevSpacingPenalty
    shortExecutionThreshold := shortRevExecutionThreshold
    shortRiskValid := shortRevRiskValid
    shortSpacingBlocked := shortRevSpacingHardBlocked
    shortRiskReason := shortRevRiskReason
else if shortContSignalReady
    shortSignal := true
    shortSignalFamily := "Continuation"
    shortSignalStage := shortContArmReason
    shortSignalTimingText := shortContTimingText
    shortEntryCandidate := shortContEntryCandidate
    shortStopCandidate := shortContStopCandidate
    shortTp1Candidate := shortContTp1Candidate
    shortTp2Candidate := shortContTp2Candidate
    shortRrToFirstTarget := shortContRrToFirstTarget
    shortFinalScore := shortContExecutionScore
    shortTimingQuality := shortContTimingQuality
    shortRiskQuality := shortContRiskQuality
    shortStructureQuality := shortContinuationStructureQuality
    shortConfluenceQuality := shortContinuationLocationScore
    shortSpacingPenalty := shortContSpacingPenalty
    shortExecutionThreshold := shortContExecutionThreshold
    shortRiskValid := shortContRiskValid
    shortSpacingBlocked := shortContSpacingHardBlocked
    shortRiskReason := shortContRiskReason
else
    shortTimingQuality := shortBestFamily == "Reversal" ? shortRevTimingQuality : shortBestFamily == "Continuation" ? shortContTimingQuality : 0.0
    shortRiskQuality := shortBestFamily == "Reversal" ? shortRevRiskQuality : shortBestFamily == "Continuation" ? shortContRiskQuality : 0.0
    shortStructureQuality := shortBestFamily == "Reversal" ? shortReversalStructureQuality : shortBestFamily == "Continuation" ? shortContinuationStructureQuality : 0.0
    shortConfluenceQuality := shortBestFamily == "Reversal" ? shortReversalLocationScore : shortBestFamily == "Continuation" ? shortContinuationLocationScore : 0.0
    shortSpacingPenalty := shortBestFamily == "Reversal" ? shortRevSpacingPenalty : shortBestFamily == "Continuation" ? shortContSpacingPenalty : 0.0
    shortExecutionThreshold := shortBestFamily == "Reversal" ? shortRevExecutionThreshold : shortBestFamily == "Continuation" ? shortContExecutionThreshold : na
    shortRiskValid := shortBestFamily == "Reversal" ? shortRevRiskValid : shortBestFamily == "Continuation" ? shortContRiskValid : false
    shortSpacingBlocked := shortBestFamily == "Reversal" ? shortRevSpacingHardBlocked : shortBestFamily == "Continuation" ? shortContSpacingHardBlocked : false

if longSignal and shortSignal
    if longFinalScore > shortFinalScore + 0.5
        shortSignal := false
    else if shortFinalScore > longFinalScore + 0.5
        longSignal := false
    else if longTimingQuality > shortTimingQuality
        shortSignal := false
    else if shortTimingQuality > longTimingQuality
        longSignal := false
    else
        longSignal := false
        shortSignal := false

string longArmFamily = longSignal ? longSignalFamily : longBestFamily
string shortArmFamily = shortSignal ? shortSignalFamily : shortBestFamily
float longArmScore = longSignal ? longFinalScore : nz(longBestScore, 0.0)
float shortArmScore = shortSignal ? shortFinalScore : nz(shortBestScore, 0.0)
string longArmReason = longSignal ? longSignalStage : longBestStage
string shortArmReason = shortSignal ? shortSignalStage : shortBestStage

string longStateText = longSignal ? "Signaled " + longSignalFamily : longBestFamily == "Reversal" ? "Reversal " + f_executionState(longRevArmActive, longRevTimingPass, longRevRiskValid, longRevSpacingHardBlocked, longReversalTrackable or longRevArmActive, longRevRiskReason) : longBestFamily == "Continuation" ? "Continuation " + f_executionState(longContArmActive, longContTimingPass, longContRiskValid, longContSpacingHardBlocked, longContinuationTrackable or longContArmActive, longContRiskReason) : bridgeValid ? "Idle" : "Bridge"
string shortStateText = shortSignal ? "Signaled " + shortSignalFamily : shortBestFamily == "Reversal" ? "Reversal " + f_executionState(shortRevArmActive, shortRevTimingPass, shortRevRiskValid, shortRevSpacingHardBlocked, shortReversalTrackable or shortRevArmActive, shortRevRiskReason) : shortBestFamily == "Continuation" ? "Continuation " + f_executionState(shortContArmActive, shortContTimingPass, shortContRiskValid, shortContSpacingHardBlocked, shortContinuationTrackable or shortContArmActive, shortContRiskReason) : bridgeValid ? "Idle" : "Bridge"

string longSignalReasonText = longArmFamily + " | " + longArmReason + " | " + longSignalTimingText + " | RR " + str.tostring(longRrToFirstTarget, "#.##")
string shortSignalReasonText = shortArmFamily + " | " + shortArmReason + " | " + shortSignalTimingText + " | RR " + str.tostring(shortRrToFirstTarget, "#.##")

string longGrade = f_gradeText(longFinalScore)
string shortGrade = f_gradeText(shortFinalScore)

//------------------------------------------------------------------------------
// Stats and Guide Tracking
//------------------------------------------------------------------------------
var array<tracked_signal> trackedSignals = array.new<tracked_signal>(0)
var int statsSignals = 0
var int statsWins = 0
var int statsLosses = 0
var int statsBreakEvens = 0
var bool longInvalidationEvent = false
var bool shortInvalidationEvent = false
bool tradeResolvedThisBar = false

var bool guideLongActive = false
var float guideLongEntry = na
var float guideLongStop = na
var float guideLongTp1 = na
var float guideLongTp2 = na
var int guideLongBar = na

var bool guideShortActive = false
var float guideShortEntry = na
var float guideShortStop = na
var float guideShortTp1 = na
var float guideShortTp2 = na
var int guideShortBar = na

var box[] tradeProfitBoxes = array.new_box()
var box[] tradeRiskBoxes = array.new_box()
var int[] tradeBoxDirs = array.new_int()
var int[] tradeBoxBars = array.new_int()
var int[] tradeBoxResolvedBars = array.new_int()
var int[] tradeBoxStates = array.new_int()
var float[] tradeBoxEntries = array.new_float()
var float[] tradeBoxStops = array.new_float()
var float[] tradeBoxTp1s = array.new_float()
var float[] tradeBoxTp2s = array.new_float()
var bool[] tradeBoxTp1Hits = array.new_bool()

if longSignal
    lastLongSignalBar := bar_index
    lastAnySignalBar := bar_index
    lastLongSignalEntryRef := longEntryCandidate
    lastLongSignalFamily := longSignalFamily
    if enableOutcomeStats
        array.unshift(trackedSignals, tracked_signal.new(true, longEntryCandidate, longStopCandidate, longTp1Candidate, longTp2Candidate, bar_index, true, false, longGrade))
        statsSignals += 1
    guideLongActive := true
    guideLongEntry := longEntryCandidate
    guideLongStop := longStopCandidate
    guideLongTp1 := longTp1Candidate
    guideLongTp2 := longTp2Candidate
    guideLongBar := bar_index
    longRevArmActive := false
    longContArmActive := false
    if showTradeBoxes and (not showOnlyAB or longGrade == "A" or longGrade == "B")
        int rightTime = time + chartBarMillis * tradeBoxWidthBars
        box profitBox = box.new(time, longTp2Candidate, rightTime, longEntryCandidate, xloc=xloc.bar_time, bgcolor=profitBoxColor, border_color=profitBoxBorderColor, border_width=1)
        box riskBox = box.new(time, longEntryCandidate, rightTime, longStopCandidate, xloc=xloc.bar_time, bgcolor=riskBoxColor, border_color=riskBoxBorderColor, border_width=1)
        string tradeText = f_tradeBoxText(true, longSignalFamily, longGrade, longFinalScore)
        if tradeText != ""
            box.set_text(profitBox, tradeText)
            box.set_text_color(profitBox, boxTextColor)
        array.unshift(tradeProfitBoxes, profitBox)
        array.unshift(tradeRiskBoxes, riskBox)
        array.unshift(tradeBoxDirs, 1)
        array.unshift(tradeBoxBars, time)
        array.unshift(tradeBoxResolvedBars, int(na))
        array.unshift(tradeBoxStates, 0)
        array.unshift(tradeBoxEntries, longEntryCandidate)
        array.unshift(tradeBoxStops, longStopCandidate)
        array.unshift(tradeBoxTp1s, longTp1Candidate)
        array.unshift(tradeBoxTp2s, longTp2Candidate)
        array.unshift(tradeBoxTp1Hits, false)

if shortSignal
    lastShortSignalBar := bar_index
    lastAnySignalBar := bar_index
    lastShortSignalEntryRef := shortEntryCandidate
    lastShortSignalFamily := shortSignalFamily
    if enableOutcomeStats
        array.unshift(trackedSignals, tracked_signal.new(false, shortEntryCandidate, shortStopCandidate, shortTp1Candidate, shortTp2Candidate, bar_index, true, false, shortGrade))
        statsSignals += 1
    guideShortActive := true
    guideShortEntry := shortEntryCandidate
    guideShortStop := shortStopCandidate
    guideShortTp1 := shortTp1Candidate
    guideShortTp2 := shortTp2Candidate
    guideShortBar := bar_index
    shortRevArmActive := false
    shortContArmActive := false
    if showTradeBoxes and (not showOnlyAB or shortGrade == "A" or shortGrade == "B")
        int rightTime = time + chartBarMillis * tradeBoxWidthBars
        box profitBox = box.new(time, shortEntryCandidate, rightTime, shortTp2Candidate, xloc=xloc.bar_time, bgcolor=profitBoxColor, border_color=profitBoxBorderColor, border_width=1)
        box riskBox = box.new(time, shortStopCandidate, rightTime, shortEntryCandidate, xloc=xloc.bar_time, bgcolor=riskBoxColor, border_color=riskBoxBorderColor, border_width=1)
        string tradeText = f_tradeBoxText(false, shortSignalFamily, shortGrade, shortFinalScore)
        if tradeText != ""
            box.set_text(profitBox, tradeText)
            box.set_text_color(profitBox, boxTextColor)
        array.unshift(tradeProfitBoxes, profitBox)
        array.unshift(tradeRiskBoxes, riskBox)
        array.unshift(tradeBoxDirs, -1)
        array.unshift(tradeBoxBars, time)
        array.unshift(tradeBoxResolvedBars, int(na))
        array.unshift(tradeBoxStates, 0)
        array.unshift(tradeBoxEntries, shortEntryCandidate)
        array.unshift(tradeBoxStops, shortStopCandidate)
        array.unshift(tradeBoxTp1s, shortTp1Candidate)
        array.unshift(tradeBoxTp2s, shortTp2Candidate)
        array.unshift(tradeBoxTp1Hits, false)

longInvalidationEvent := false
shortInvalidationEvent := false
tradeResolvedThisBar := false

if not enableOutcomeStats
    if guideLongActive and bar_index > nz(guideLongBar, bar_index)
        if low <= guideLongStop
            guideLongActive := false
            longInvalidationEvent := true
            tradeResolvedThisBar := true
        else if high >= guideLongTp2
            guideLongActive := false
            tradeResolvedThisBar := true
    if guideShortActive and bar_index > nz(guideShortBar, bar_index)
        if high >= guideShortStop
            guideShortActive := false
            shortInvalidationEvent := true
            tradeResolvedThisBar := true
        else if low <= guideShortTp2
            guideShortActive := false
            tradeResolvedThisBar := true

if enableOutcomeStats and array.size(trackedSignals) > 0
    for i = array.size(trackedSignals) - 1 to 0
        tracked_signal sig = array.get(trackedSignals, i)
        if sig.active and bar_index > sig.signalBar
            if sig.isLong
                if low <= sig.stopPrice
                    if sig.tp1Hit
                        statsBreakEvens += 1
                    else
                        statsLosses += 1
                    sig.active := false
                    longInvalidationEvent := true
                    tradeResolvedThisBar := true
                    if guideLongActive and sig.signalBar == guideLongBar
                        guideLongActive := false
                else if high >= sig.tp2Price
                    statsWins += 1
                    sig.active := false
                    tradeResolvedThisBar := true
                    if guideLongActive and sig.signalBar == guideLongBar
                        guideLongActive := false
                else if high >= sig.tp1Price
                    sig.tp1Hit := true
            else
                if high >= sig.stopPrice
                    if sig.tp1Hit
                        statsBreakEvens += 1
                    else
                        statsLosses += 1
                    sig.active := false
                    shortInvalidationEvent := true
                    tradeResolvedThisBar := true
                    if guideShortActive and sig.signalBar == guideShortBar
                        guideShortActive := false
                else if low <= sig.tp2Price
                    statsWins += 1
                    sig.active := false
                    tradeResolvedThisBar := true
                    if guideShortActive and sig.signalBar == guideShortBar
                        guideShortActive := false
                else if low <= sig.tp1Price
                    sig.tp1Hit := true
        array.set(trackedSignals, i, sig)

if enableOutcomeStats
    while array.size(trackedSignals) > statsHistoryCap
        tracked_signal oldest = array.get(trackedSignals, array.size(trackedSignals) - 1)
        if oldest.active
            break
        array.pop(trackedSignals)

if array.size(tradeProfitBoxes) > 0
    for i = array.size(tradeProfitBoxes) - 1 to 0
        box profitBox = array.get(tradeProfitBoxes, i)
        box riskBox = array.get(tradeRiskBoxes, i)
        int dir = array.get(tradeBoxDirs, i)
        int signalTime = array.get(tradeBoxBars, i)
        int resolvedTime = array.get(tradeBoxResolvedBars, i)
        int state = array.get(tradeBoxStates, i)
        float stopPrice = array.get(tradeBoxStops, i)
        float tp1Price = array.get(tradeBoxTp1s, i)
        float tp2Price = array.get(tradeBoxTp2s, i)
        bool tp1Hit = array.get(tradeBoxTp1Hits, i)

        if na(resolvedTime) and time > signalTime
            if dir == 1
                if high >= tp1Price
                    tp1Hit := true
                if low <= stopPrice
                    state := tp1Hit ? 2 : -1
                    resolvedTime := time
                else if high >= tp2Price
                    state := 1
                    resolvedTime := time
            else
                if low <= tp1Price
                    tp1Hit := true
                if high >= stopPrice
                    state := tp1Hit ? 2 : -1
                    resolvedTime := time
                else if low <= tp2Price
                    state := 1
                    resolvedTime := time

        int maxRightTime = signalTime + chartBarMillis * tradeBoxWidthBars
        int liveRightTime = int(math.min(time + chartBarMillis, maxRightTime))
        int rightTime = na(resolvedTime) ? liveRightTime : resolvedTime
        box.set_right(profitBox, rightTime)
        box.set_right(riskBox, rightTime)

        if state == 1
            box.set_bgcolor(riskBox, color.new(riskBoxColor, 92))
            box.set_border_width(profitBox, 2)
        else if state == -1
            box.set_bgcolor(profitBox, color.new(profitBoxColor, 92))
            box.set_border_width(riskBox, 2)
        else if state == 2
            box.set_bgcolor(profitBox, color.new(profitBoxColor, 88))
            box.set_bgcolor(riskBox, color.new(riskBoxColor, 88))
            box.set_border_width(profitBox, 1)
            box.set_border_width(riskBox, 1)

        array.set(tradeBoxResolvedBars, i, resolvedTime)
        array.set(tradeBoxStates, i, state)
        array.set(tradeBoxTp1Hits, i, tp1Hit)

while array.size(tradeProfitBoxes) > tradeBoxHistory
    box oldProfit = array.pop(tradeProfitBoxes)
    box oldRisk = array.pop(tradeRiskBoxes)
    box.delete(oldProfit)
    box.delete(oldRisk)
    array.pop(tradeBoxDirs)
    array.pop(tradeBoxBars)
    array.pop(tradeBoxResolvedBars)
    array.pop(tradeBoxStates)
    array.pop(tradeBoxEntries)
    array.pop(tradeBoxStops)
    array.pop(tradeBoxTp1s)
    array.pop(tradeBoxTp2s)
    array.pop(tradeBoxTp1Hits)

if tradeResolvedThisBar
    lastResolvedTradeBar := bar_index

int nextOpenTradeCount = 0
if enableOutcomeStats and array.size(trackedSignals) > 0
    for i = 0 to array.size(trackedSignals) - 1
        tracked_signal sig = array.get(trackedSignals, i)
        if sig.active
            nextOpenTradeCount += 1
else
    nextOpenTradeCount := (guideLongActive ? 1 : 0) + (guideShortActive ? 1 : 0)
openTradeCountState := nextOpenTradeCount

float winRate = enableOutcomeStats and (statsWins + statsLosses) > 0 ? (float(statsWins) / float(statsWins + statsLosses)) * 100.0 : na
int resolvedSignals = enableOutcomeStats ? statsWins + statsLosses + statsBreakEvens : 0

int contextBias = longContextScore > shortContextScore + 5.0 ? 1 : shortContextScore > longContextScore + 5.0 ? -1 : 0
string contextText = not bridgeReady ? "Bridge pending" : not bridgeValid ? "Bridge invalid" : contextBias == 1 ? "Bullish bias" : contextBias == -1 ? "Bearish bias" : "Balanced"
string sessionText = f_sessionText(inAsia, inLondon, inNY, inLondonSweepWindow, inNYSweepWindow)
string bridgeStatusText = not bridgeReady ? "Wire sources" : not bridgeValid ? "Critical invalid" : bridgeDetailValid and bridgeOptionalValid ? "Ready" : bridgeDetailValid ? "Ready*" : "Core only"
string bridgeNoteText = not bridgeValid ? "Need critical bridge fields" : bridgeDetailValid and bridgeOptionalValid ? "Full bridge" : bridgeDetailValid ? "IDM soft-degraded" : bridgeOptionalValid ? "Detail soft-degraded" : "Detail + IDM soft-degraded"
string longTableText = bridgeValid ? str.tostring(longFinalScore, "#") + " | " + longGrade + " | " + (longSignal ? longSignalFamily : longBestFamily != "" ? longBestFamily : "Idle") : "Pending bridge"
string shortTableText = bridgeValid ? str.tostring(shortFinalScore, "#") + " | " + shortGrade + " | " + (shortSignal ? shortSignalFamily : shortBestFamily != "" ? shortBestFamily : "Idle") : "Pending bridge"
string longFlowText = bridgeValid ? longStateText + " | Arm " + str.tostring(longArmScore, "#") + " | Tim " + str.tostring(longTimingQuality, "#") : "Pending bridge"
string shortFlowText = bridgeValid ? shortStateText + " | Arm " + str.tostring(shortArmScore, "#") + " | Tim " + str.tostring(shortTimingQuality, "#") : "Pending bridge"
string longWhyText = bridgeValid ? "Str " + str.tostring(longStructureQuality, "#") + " | Loc " + str.tostring(longConfluenceQuality, "#") + " | Risk " + str.tostring(longRiskQuality, "#") + " | Sp " + str.tostring(longSpacingPenalty, "#") : "Pending bridge"
string shortWhyText = bridgeValid ? "Str " + str.tostring(shortStructureQuality, "#") + " | Loc " + str.tostring(shortConfluenceQuality, "#") + " | Risk " + str.tostring(shortRiskQuality, "#") + " | Sp " + str.tostring(shortSpacingPenalty, "#") : "Pending bridge"
string tradesTableText = not enableOutcomeStats ? "Off" : bridgeValid ? str.tostring(statsSignals) : "Pending bridge"
string winRateTableText = not enableOutcomeStats ? "Off" : not bridgeValid ? "Pending bridge" : not na(winRate) ? str.tostring(winRate, "#.0") + "%" : "NA"
string winsTableText = not enableOutcomeStats ? "Off" : bridgeValid ? str.tostring(statsWins) : "Pending bridge"
string lossesTableText = not enableOutcomeStats ? "Off" : bridgeValid ? str.tostring(statsLosses) : "Pending bridge"
string openTradesTableText = bridgeValid ? str.tostring(openTradeCountState) : "Pending bridge"

var table infoTable = table.new(position.top_right, 2, 15, bgcolor=color.new(chart.bg_color, 6), border_width=1, border_color=color.new(chart.fg_color, 70))
if barstate.islast
    if showCompactInfo
        table.cell(infoTable, 0, 0, "Bridge", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 0, bridgeStatusText, text_color=bridgeValid ? longColor : COLOR_NEUT, text_size=size.small)
        table.cell(infoTable, 0, 1, "Bias", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 1, contextText, text_color=contextBias == 1 ? longColor : contextBias == -1 ? shortColor : COLOR_NEUT, text_size=size.small)
        table.cell(infoTable, 0, 2, "Long", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 2, longTableText, text_color=bridgeValid and longFinalScore >= nz(longExecutionThreshold, f_modeThreshold(signalMode)) ? longColor : color.new(longColor, 45), text_size=size.small)
        table.cell(infoTable, 0, 3, "Long Flow", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 3, showDiagnostics ? longFlowText : "-", text_color=bridgeValid ? color.new(longColor, 10) : COLOR_NEUT, text_size=size.small)
        table.cell(infoTable, 0, 4, "Long Why", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 4, showDiagnostics ? longWhyText + " | " + longRiskReason : "-", text_color=bridgeValid ? color.new(longColor, 10) : COLOR_NEUT, text_size=size.small)
        table.cell(infoTable, 0, 5, "Short", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 5, shortTableText, text_color=bridgeValid and shortFinalScore >= nz(shortExecutionThreshold, f_modeThreshold(signalMode)) ? shortColor : color.new(shortColor, 45), text_size=size.small)
        table.cell(infoTable, 0, 6, "Short Flow", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 6, showDiagnostics ? shortFlowText : "-", text_color=bridgeValid ? color.new(shortColor, 10) : COLOR_NEUT, text_size=size.small)
        table.cell(infoTable, 0, 7, "Short Why", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 7, showDiagnostics ? shortWhyText + " | " + shortRiskReason : "-", text_color=bridgeValid ? color.new(shortColor, 10) : COLOR_NEUT, text_size=size.small)
        table.cell(infoTable, 0, 8, "Trades", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 8, tradesTableText, text_color=color.new(chart.fg_color, 0), text_size=size.small)
        table.cell(infoTable, 0, 9, "WR", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 9, winRateTableText, text_color=not bridgeValid or na(winRate) ? COLOR_NEUT : winRate >= 50.0 ? longColor : shortColor, text_size=size.small)
        table.cell(infoTable, 0, 10, "Wins", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 10, winsTableText, text_color=bridgeValid ? longColor : COLOR_NEUT, text_size=size.small)
        table.cell(infoTable, 0, 11, "Losses", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 11, lossesTableText, text_color=bridgeValid ? shortColor : COLOR_NEUT, text_size=size.small)
        table.cell(infoTable, 0, 12, "Open", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 12, openTradesTableText, text_color=color.new(chart.fg_color, 0), text_size=size.small)
        table.cell(infoTable, 0, 13, "Session", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 13, sessionText, text_color=color.new(chart.fg_color, 0), text_size=size.small)
        table.cell(infoTable, 0, 14, "Bridge Note", text_color=color.new(chart.fg_color, 20), text_size=size.small)
        table.cell(infoTable, 1, 14, bridgeNoteText, text_color=color.new(chart.fg_color, 0), text_size=size.small)
    else
        for row = 0 to 14
            table.cell(infoTable, 0, row, "", text_color=color.new(chart.fg_color, 100), text_size=size.small)
            table.cell(infoTable, 1, row, "", text_color=color.new(chart.fg_color, 100), text_size=size.small)

//------------------------------------------------------------------------------
// Alerts
//------------------------------------------------------------------------------
alertcondition(longSignal, "Long Signal", "Devtrader Entry Engine: long signal")
alertcondition(shortSignal, "Short Signal", "Devtrader Entry Engine: short signal")
alertcondition(longSignal and longGrade == "A", "Long A-Grade Signal", "Devtrader Entry Engine: A-grade long")
alertcondition(shortSignal and shortGrade == "A", "Short A-Grade Signal", "Devtrader Entry Engine: A-grade short")
alertcondition(longRetestEvent, "Long Confirmation Retest", "Devtrader Entry Engine: long retest opportunity")
alertcondition(shortRetestEvent, "Short Confirmation Retest", "Devtrader Entry Engine: short retest opportunity")
alertcondition(longInvalidationEvent, "Long Invalidation", "Devtrader Entry Engine: long invalidated")
alertcondition(shortInvalidationEvent, "Short Invalidation", "Devtrader Entry Engine: short invalidated")
