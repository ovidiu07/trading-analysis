//@version=6
// @description Structure evaluation engines: reclaim (Ch3), MSS (Ch4), displacement (Ch5).
// All functions are pure — they use only parameters and built-in series (close, open, high, low, bar_index).
library("tv_structure_engine", overlay = true)

// =====================================================================
// CHAPTER 3: RECLAIM STAGE EVALUATOR
// =====================================================================

// Formal structural reclaim assessment after liquidity sweep.
// Returns: [detected, weak, valid, strong_, failed, score, reason, newAccept, threshold]
export evaluate_reclaim_stage(bool isLong, int sweepBar_, float sweepLevel_, float sweepDepth_,
                       float atrVal, int prevAccept, bool prevFailed, int prevSweepRef) =>
    bool detected = false
    bool weak = false
    bool valid = false
    bool strong_ = false
    bool failed = prevFailed
    float score = 0.0
    string reason = "No sweep context"
    int acceptBars = 0
    float threshold = na

    if not na(sweepBar_) and not na(sweepLevel_) and atrVal > 0
        int age = bar_index - sweepBar_
        float sweepExtreme = na
        if not na(sweepDepth_)
            sweepExtreme := isLong ? sweepLevel_ - sweepDepth_ : sweepLevel_ + sweepDepth_

        if age >= 0 and age <= 50
            float primaryThresh = sweepLevel_
            float midThresh = not na(sweepExtreme) ? (sweepExtreme + sweepLevel_) / 2.0 : sweepLevel_
            float recoveryBand = not na(sweepExtreme) and not na(sweepDepth_) and sweepDepth_ > 0 ?
                 sweepExtreme + (isLong ? 1 : -1) * sweepDepth_ * 0.4 : midThresh
            threshold := primaryThresh

            bool abovePrimary = isLong ? close > primaryThresh : close < primaryThresh
            bool aboveMid = isLong ? close > midThresh : close < midThresh
            bool aboveRecovBand = isLong ? close > recoveryBand : close < recoveryBand
            bool dirCandle = isLong ? close > open : close < open

            bool sameRef = not na(prevSweepRef) and prevSweepRef == sweepBar_
            if not sameRef
                acceptBars := 0
                failed := false
            else
                acceptBars := prevAccept

            if abovePrimary
                detected := true
                acceptBars := acceptBars + 1
            else if aboveRecovBand or aboveMid
                detected := true
                if not abovePrimary and acceptBars > 0
                    acceptBars := math.max(0, acceptBars - 1)

            // Score computation (0-100)
            float recoveryDist = 0.0
            if not na(sweepExtreme)
                recoveryDist := isLong ? (close - sweepExtreme) / atrVal : (sweepExtreme - close) / atrVal
            score += math.min(math.max(recoveryDist * 10.0, 0.0), 25.0)

            score += abovePrimary ? 15.0 : (aboveMid ? 6.0 : (aboveRecovBand ? 3.0 : 0.0))
            score += dirCandle ? 5.0 : 0.0

            score += math.min(float(acceptBars) * 6.0, 20.0)

            bool noRetest = true
            if age >= 2
                int checkBars = math.min(age, 5)
                for i = 0 to checkBars - 1
                    bool retested = not na(sweepExtreme) ?
                         (isLong ? low[i] <= sweepExtreme : high[i] >= sweepExtreme) :
                         (isLong ? low[i] <= sweepLevel_ - atrVal * 0.3 : high[i] >= sweepLevel_ + atrVal * 0.3)
                    if retested
                        noRetest := false
            score += noRetest ? 15.0 : 0.0

            score += math.max(0.0, 10.0 - float(age) * 0.25)

            if acceptBars >= 2
                bool priorHeld = isLong ? close[1] > primaryThresh : close[1] < primaryThresh
                score += priorHeld ? 10.0 : 4.0

            score := math.min(score, 100.0)

            if detected
                weak := score < 35.0
                valid := score >= 35.0
                strong_ := score >= 60.0

            if not failed and sameRef and prevAccept >= 2
                bool lostPrimary = isLong ? close < primaryThresh - atrVal * 0.15 : close > primaryThresh + atrVal * 0.15
                if lostPrimary
                    failed := true
                    detected := false
                    valid := false
                    strong_ := false
                    reason := "Reclaim lost after " + str.tostring(prevAccept) + " acceptance bars"

            if not failed and sameRef
                bool newExtreme = not na(sweepExtreme) ?
                     (isLong ? low < sweepExtreme - atrVal * 0.1 : high > sweepExtreme + atrVal * 0.1) :
                     (isLong ? low < sweepLevel_ - atrVal * 0.5 : high > sweepLevel_ + atrVal * 0.5)
                if newExtreme
                    failed := true
                    detected := false
                    valid := false
                    strong_ := false
                    reason := "New extreme beyond sweep — reclaim invalidated"

            if not failed
                if strong_
                    reason := "Strong (" + str.tostring(math.round(score)) + ") — " + str.tostring(acceptBars) + " bars accepted"
                else if valid
                    reason := "Valid (" + str.tostring(math.round(score)) + ") — " + str.tostring(acceptBars) + " bars"
                else if weak and detected
                    reason := "Weak (" + str.tostring(math.round(score)) + ") — early recovery"
                else if not detected
                    reason := "No reclaim yet (age " + str.tostring(age) + ")"
        else
            reason := "Sweep aged out (" + str.tostring(age) + " bars)"
            failed := true

    [detected, weak, valid, strong_, failed, score, reason, acceptBars, threshold]

// Mode-dependent reclaim pass (Chapter 3)
export reclaim_mode_pass(bool detected_, bool valid_, bool strong_, float score_, string mode) =>
    bool pass = false
    if mode == "Aggressive"
        pass := detected_ and score_ >= 15.0
    else if mode == "Conservative"
        pass := strong_ or score_ >= 50.0
    else // Balanced
        pass := valid_ or score_ >= 30.0
    pass

// =====================================================================
// CHAPTER 4: MSS / STRUCTURE SHIFT VALIDATION
// =====================================================================

// Part B+C: Trigger Level Significance Classification
// Returns: [triggerType, significance, sigScore]
export classify_mss_trigger(bool isLong, float triggerLevel, int triggerBar, bool triggerIsExternal,
                      float sweepLevel_, float atrVal, float rangeSpan_, float rangeHigh_, float rangeLow_) =>
    string trigType = "unknown"
    int significance = 0
    float sigScore = 0.0
    if not na(triggerLevel) and not na(triggerBar) and atrVal > 0
        int pivotAge = bar_index - triggerBar
        float distFromSweep = not na(sweepLevel_) ? math.abs(triggerLevel - sweepLevel_) / atrVal : 0.0
        float rangePos = rangeSpan_ > 0 ? (triggerLevel - rangeLow_) / rangeSpan_ : 0.5
        sigScore += math.max(0.0, 20.0 - float(pivotAge) * 0.3)
        if triggerIsExternal
            sigScore += 20.0
            trigType := "protected-external"
        else
            float edgeDist = rangeSpan_ > 0 ? (isLong ? (rangeHigh_ - triggerLevel) / rangeSpan_ : (triggerLevel - rangeLow_) / rangeSpan_) : 0.5
            if edgeDist < 0.3
                sigScore += 14.0
                trigType := "protected-range"
            else
                sigScore += 6.0
                trigType := "internal"
        if distFromSweep > 0.5
            sigScore += math.min(distFromSweep * 5.0, 15.0)
        else if distFromSweep > 0.2
            sigScore += 5.0
        float postPivotMove = isLong ? (triggerLevel - rangeLow_) : (rangeHigh_ - triggerLevel)
        float swingDepth = atrVal > 0 ? postPivotMove / atrVal : 0.0
        sigScore += math.min(swingDepth * 4.0, 20.0)
        bool posOk = isLong ? rangePos > 0.35 : rangePos < 0.65
        sigScore += posOk ? 10.0 : 3.0
        if swingDepth < 0.3
            sigScore -= 10.0
        sigScore := math.max(0.0, math.min(100.0, sigScore))
        if sigScore >= 65.0
            significance := 3
            if trigType == "internal"
                trigType := "protected"
        else if sigScore >= 45.0
            significance := 2
        else if sigScore >= 25.0
            significance := 1
        else
            significance := 0
    [trigType, significance, sigScore]

// Part D: Break Quality Evaluation
// Returns: [bodyConfirmed, followThrough, decisive, weak, qualityScore]
export evaluate_break_quality(bool isLong, float triggerLevel, float breakClose, float breakOpen,
                        float breakHigh, float breakLow, float atrVal) =>
    bool bodyConfirmed = false
    bool followThrough = false
    bool decisive = false
    bool weak = true
    float qualityScore = 0.0
    if not na(triggerLevel) and atrVal > 0
        float breakRange = breakHigh - breakLow
        float breakBody = math.abs(breakClose - breakOpen)
        bool closedThrough = isLong ? breakClose > triggerLevel : breakClose < triggerLevel
        if closedThrough
            qualityScore += 25.0
        float bodyAtrRatio = breakBody / atrVal
        qualityScore += math.min(bodyAtrRatio * 15.0, 20.0)
        bodyConfirmed := closedThrough and (isLong ? breakClose > breakOpen : breakClose < breakOpen) and breakBody > atrVal * 0.3
        if bodyConfirmed
            qualityScore += 15.0
        float closeRatio = breakRange > 0 ? (isLong ? (breakClose - breakLow) / breakRange : (breakHigh - breakClose) / breakRange) : 0.5
        qualityScore += closeRatio * 15.0
        float breakDist = isLong ? (breakClose - triggerLevel) / atrVal : (triggerLevel - breakClose) / atrVal
        if breakDist > 0
            qualityScore += math.min(breakDist * 15.0, 15.0)
        else
            qualityScore -= 10.0
        if math.abs(breakDist) < 0.1 and not bodyConfirmed
            qualityScore -= 10.0
        followThrough := closedThrough and bodyConfirmed and bodyAtrRatio > 0.5
        if followThrough
            qualityScore += 10.0
        qualityScore := math.max(0.0, math.min(100.0, qualityScore))
        decisive := qualityScore >= 60.0
        weak := qualityScore < 35.0
    [bodyConfirmed, followThrough, decisive, weak, qualityScore]

// Part A+E: Formal MSS Stage Evaluator
// Returns: [detected, weak, valid, strong_, fresh, failed, score, reason, failReason,
//           breakLevel, bodyConfirmed, trigType, trigSig, followBars, breakQualScore]
export evaluate_mss_stage(bool isLong, int sweepBar_, bool reclaimDetected_, bool reclaimValid_,
                    int mssBar_, float mssDisp_, float triggerLevel, int triggerBar,
                    bool triggerIsExternal, float sweepLevel_, float atrVal,
                    float rangeSpan_, float rangeHigh_, float rangeLow_,
                    string mode, int prevMssRefBar, float prevMssScore, bool prevMssFailed,
                    int prevFollowBars, bool prevBodyConf, float prevBreakQScore) =>
    bool detected = false
    bool mssWeak = false
    bool valid = false
    bool strong_ = false
    bool fresh = true
    bool failed = prevMssFailed
    float score = 0.0
    string reason = "No MSS context"
    string failReason = ""
    float breakLvl = na
    bool bodyConf = prevBodyConf
    string trigType = ""
    int trigSig = 0
    int followBars = prevFollowBars
    float breakQScore = prevBreakQScore
    if not na(mssBar_) and atrVal > 0
        int mssAge = bar_index - mssBar_
        bool afterSweep = not na(sweepBar_) and mssBar_ >= sweepBar_
        bool newMss = na(prevMssRefBar) or mssBar_ != prevMssRefBar
        if newMss
            failed := false
            followBars := 0
            bodyConf := false
            breakQScore := 0.0
        [tType, tSig, tScore] = classify_mss_trigger(isLong, triggerLevel, triggerBar, triggerIsExternal, sweepLevel_, atrVal, rangeSpan_, rangeHigh_, rangeLow_)
        trigType := tType
        trigSig := tSig
        if newMss and mssAge <= 2
            [bConf, _bFollow, _bDecisive, _bWeak, bScore] = evaluate_break_quality(isLong, triggerLevel, close[mssAge], open[mssAge], high[mssAge], low[mssAge], atrVal)
            bodyConf := bConf
            breakQScore := bScore
        breakLvl := triggerLevel
        float seqScore = 0.0
        if afterSweep
            seqScore += 15.0
            if reclaimDetected_
                seqScore += 10.0
            if reclaimValid_
                seqScore += 5.0
        else if not na(sweepBar_)
            seqScore -= 10.0
        int mssMaxFresh = mode == "Aggressive" ? 40 : mode == "Conservative" ? 22 : 30
        fresh := mssAge <= mssMaxFresh
        if not fresh and not failed
            failed := true
            failReason := "MSS stale (" + str.tostring(mssAge) + " bars)"
        if not newMss and not failed and mssAge >= 1 and not na(triggerLevel)
            bool holdingBreak = isLong ? close > triggerLevel : close < triggerLevel
            if holdingBreak
                followBars := followBars + 1
            else if followBars > 0
                followBars := followBars - 1
        if not failed and not newMss and mssAge >= 2 and not na(triggerLevel)
            bool lostBreak = isLong ? close < triggerLevel - atrVal * 0.15 : close > triggerLevel + atrVal * 0.15
            if lostBreak and followBars <= 1
                failed := true
                failReason := "Break lost — price recrossed trigger"
        score += math.min(tScore * 0.3, 30.0)
        score += math.min(breakQScore * 0.3, 30.0)
        score += math.max(0.0, math.min(seqScore, 20.0))
        if not newMss and prevMssScore > score
            score := score * 0.7 + prevMssScore * 0.3
        float dispScore = not na(mssDisp_) ? math.min(mssDisp_ * 10.0, 15.0) : 0.0
        score += dispScore
        score += math.min(float(followBars) * 2.0, 5.0)
        if mssAge > math.round(mssMaxFresh * 0.5)
            float decay = float(mssAge - math.round(mssMaxFresh * 0.5)) / float(mssMaxFresh) * 15.0
            score -= decay
        score := math.max(0.0, math.min(100.0, score))
        detected := not failed
        if detected
            mssWeak := score < 35.0 or trigSig == 0
            valid := score >= 35.0 and trigSig >= 1
            strong_ := score >= 60.0 and trigSig >= 2 and bodyConf
        if failed
            detected := false
            valid := false
            strong_ := false
            reason := "MSS failed: " + failReason
        else if strong_
            reason := "Strong MSS (" + str.tostring(math.round(score)) + ") — " + trigType
        else if valid
            reason := "Valid MSS (" + str.tostring(math.round(score)) + ") — " + trigType
        else if detected and mssWeak
            reason := "Weak MSS (" + str.tostring(math.round(score)) + ") — " + (trigSig == 0 ? "trivial trigger" : "low quality break")
        else
            reason := na(sweepBar_) ? "No sweep context" : not afterSweep ? "MSS before sweep" : "No MSS detected"
    [detected, mssWeak, valid, strong_, fresh, failed, score, reason, failReason, breakLvl, bodyConf, trigType, trigSig, followBars, breakQScore]

// Mode-dependent MSS pass (Chapter 4)
// Returns: [pass, passStrong]
export mss_mode_pass(bool detected_, bool valid_, bool strong_, float score_, int trigSig_, string mode) =>
    bool pass = false
    bool passStrong = false
    if mode == "Aggressive"
        pass := detected_ and score_ >= 20.0
        passStrong := valid_ and score_ >= 50.0
    else if mode == "Conservative"
        pass := valid_ and trigSig_ >= 2 and score_ >= 45.0
        passStrong := strong_ and trigSig_ >= 2 and score_ >= 60.0
    else // Balanced
        pass := valid_ and trigSig_ >= 1 and score_ >= 30.0
        passStrong := strong_ or (valid_ and score_ >= 50.0 and trigSig_ >= 2)
    [pass, passStrong]

// Extension filter: blocks chased entries too far from structural anchor.
// Returns: [isExtended, distanceAtr, reason]
export compute_extension_block(bool isLong, int mssBar_, float pivotVal, float atrVal, string mode, float reqLevel) =>
    bool isExtended = false
    float distAtr = 0.0
    string reason = ""
    if atrVal > 0
        float anchor = not na(pivotVal) ? pivotVal : reqLevel
        if not na(anchor)
            distAtr := isLong ? (close - anchor) / atrVal : (anchor - close) / atrVal
            float maxExt = mode == "Aggressive" ? 1.5 : mode == "Conservative" ? 0.85 : 1.2
            if distAtr > maxExt
                isExtended := true
                reason := str.tostring(distAtr, "#.##") + " ATR > " + str.tostring(maxExt, "#.#") + " max"
        if not isExtended and not na(mssBar_)
            int barsSince = bar_index - mssBar_
            int maxBars = mode == "Aggressive" ? 15 : mode == "Conservative" ? 10 : 15
            if barsSince > maxBars
                isExtended := true
                reason := str.tostring(barsSince) + " bars since MSS > " + str.tostring(maxBars)
    [isExtended, distAtr, reason]

// MSS quality gate
// Returns: [qualityPass, qualityStrong, reason]
export evaluate_mss_quality(int sweepBar_, int mssBar_, float mssDisp_, float atrVal, string mode) =>
    bool qualityPass = false
    bool qualityStrong = false
    string reason = ""
    if not na(mssBar_) and not na(sweepBar_)
        bool afterSweep = mssBar_ >= sweepBar_
        int mssAge = bar_index - mssBar_
        int mssMaxFresh = mode == "Aggressive" ? 30 : mode == "Conservative" ? 15 : 20
        bool isFresh = mssAge <= mssMaxFresh
        float minDisp = mode == "Aggressive" ? 0.4 : mode == "Conservative" ? 1.0 : 0.7
        bool dispOk = not na(mssDisp_) and mssDisp_ >= minDisp
        if not afterSweep
            reason := "MSS before sweep"
        else if not isFresh
            reason := "MSS stale (" + str.tostring(mssAge) + " bars)"
        else if not dispOk
            reason := "Disp " + str.tostring(nz(mssDisp_), "#.##") + " < " + str.tostring(minDisp, "#.#") + " (ATR=" + str.tostring(atrVal, "#.##") + ")"
        else
            qualityPass := true
            qualityStrong := mssAge <= math.round(mssMaxFresh / 2) and mssDisp_ >= minDisp * 1.5
            reason := "OK" + (qualityStrong ? " [strong]" : "")
    else
        reason := na(mssBar_) ? "No MSS" : "No sweep"
    [qualityPass, qualityStrong, reason]

// =====================================================================
// CHAPTER 5: DISPLACEMENT QUALITY ENGINE
// =====================================================================

// Evaluate displacement quality after valid MSS.
// Returns: [detected, weak, valid, strong_, fresh, failed, score, reason, failReason,
//           dispBar, rangeAtr, bodyDom, closeQuality, followBars, hasImbalance,
//           fvgGrade_, retained, originPrice, extremePrice]
export evaluate_displacement_stage(bool isLong, int mssBar_, float mssDisp_, float mssBreakLvl_,
                            bool mssValid_, bool mssFailed_,
                            int fvgBar_, int fvgGrade_, bool fvgMitigated_,
                            float atrVal, string mode,
                            int prevDispRefBar, float prevDispScore, bool prevDispFailed,
                            int prevFollowBars, float prevOrigin, float prevExtreme,
                            int prevDispMssRef) =>
    bool detected = false
    bool dispWeak = false
    bool valid = false
    bool strong_ = false
    bool fresh = true
    bool failed = prevDispFailed
    float score = 0.0
    string reason = "No displacement context"
    string failReason = ""
    int dispBar = na
    float rangeAtr = 0.0
    float bodyDom = 0.0
    float closeQual = 0.0
    int followBars = prevFollowBars
    bool hasImbalance = false
    int fvgGrOut = 0
    bool retained = false
    float originPrice = prevOrigin
    float extremePrice = prevExtreme

    if not na(mssBar_) and atrVal > 0 and not mssFailed_
        int mssAge = bar_index - mssBar_
        bool newMss = na(prevDispMssRef) or mssBar_ != prevDispMssRef
        bool newDisp = na(prevDispRefBar) or (not na(fvgBar_) and fvgBar_ != prevDispRefBar)
        if newMss
            failed := false
            followBars := 0
            originPrice := na
            extremePrice := na
            score := 0.0

        int lookback = math.min(mssAge, 8)
        float bestRangeAtr = 0.0
        float bestBodyDom = 0.0
        float bestCloseQual = 0.0
        int bestDispBar = na
        float bestOrigin = na
        float bestExtreme = na
        bool foundDisp = false

        if lookback >= 0
            for i = lookback to 0
                float barOpen = open[i]
                float barClose = close[i]
                float barHigh = high[i]
                float barLow = low[i]
                float barBody = math.abs(barClose - barOpen)
                float barRange = barHigh - barLow
                if barRange <= 0
                    continue
                bool dirOk = isLong ? barClose > barOpen : barClose < barOpen
                if not dirOk
                    continue
                float rAtr = barRange / atrVal
                float bDom = barBody / barRange
                float cQual = isLong ? (barClose - barLow) / barRange : (barHigh - barClose) / barRange
                if rAtr < 0.3
                    continue
                float barQ = rAtr * 0.4 + bDom * 0.35 + cQual * 0.25
                if barQ > bestRangeAtr * 0.4 + bestBodyDom * 0.35 + bestCloseQual * 0.25 or not foundDisp
                    bestRangeAtr := rAtr
                    bestBodyDom := bDom
                    bestCloseQual := cQual
                    bestDispBar := bar_index - i
                    bestOrigin := isLong ? barLow : barHigh
                    bestExtreme := isLong ? barHigh : barLow
                    foundDisp := true

        if foundDisp
            dispBar := bestDispBar
            rangeAtr := bestRangeAtr
            bodyDom := bestBodyDom
            closeQual := bestCloseQual
            if newMss or na(originPrice)
                originPrice := bestOrigin
                extremePrice := bestExtreme
            else
                extremePrice := isLong ? math.max(nz(extremePrice), bestExtreme) : math.min(nz(extremePrice, 1e18), bestExtreme)

        float compScore = 0.0

        float rangeScore = math.min(rangeAtr * 10.0, 20.0)
        compScore += rangeScore

        float bodyScore = bodyDom >= 0.75 ? 20.0 : bodyDom >= 0.6 ? 15.0 : bodyDom >= 0.45 ? 10.0 : 5.0
        compScore += bodyScore

        float closeScore = closeQual >= 0.8 ? 15.0 : closeQual >= 0.6 ? 10.0 : closeQual >= 0.4 ? 5.0 : 0.0
        compScore += closeScore

        float commitScore = 0.0
        if not na(mssBreakLvl_) and atrVal > 0
            float beyondBreak = isLong ? (close - mssBreakLvl_) / atrVal : (mssBreakLvl_ - close) / atrVal
            commitScore := beyondBreak > 1.0 ? 15.0 : beyondBreak > 0.5 ? 10.0 : beyondBreak > 0.15 ? 5.0 : 0.0
        compScore += commitScore

        float imbScore = 0.0
        bool fvgAfterMss = not na(fvgBar_) and fvgBar_ >= mssBar_
        bool fvgFresh = not na(fvgBar_) and (bar_index - fvgBar_) <= 25
        if fvgAfterMss and fvgFresh and not fvgMitigated_
            hasImbalance := true
            fvgGrOut := fvgGrade_
            imbScore := fvgGrade_ >= 3 ? 15.0 : fvgGrade_ >= 2 ? 10.0 : 5.0
        else if fvgAfterMss and fvgMitigated_
            imbScore := -5.0
        if not hasImbalance and rangeAtr >= 1.5 and bodyDom >= 0.65
            imbScore := math.max(imbScore, 3.0)
        compScore += imbScore

        if not newMss and not failed and mssAge >= 1
            bool holdingBeyond = isLong ? close > nz(mssBreakLvl_) : close < nz(mssBreakLvl_, 1e18)
            if holdingBeyond
                followBars := followBars + 1
            else if followBars > 0
                followBars := followBars - 1
        float ftScore = math.min(float(followBars) * 2.5, 10.0)
        compScore += ftScore

        float snapbackPenalty = 0.0
        if not na(originPrice) and not na(extremePrice) and atrVal > 0
            float totalMove = math.abs(extremePrice - originPrice)
            float retraceFromExtreme = isLong ? (extremePrice - close) : (close - extremePrice)
            if totalMove > 0 and retraceFromExtreme > 0
                float retraceRatio = retraceFromExtreme / totalMove
                if retraceRatio > 0.8
                    snapbackPenalty := -15.0
                else if retraceRatio > 0.6
                    snapbackPenalty := -10.0
                else if retraceRatio > 0.4
                    snapbackPenalty := -5.0
        compScore += snapbackPenalty

        float dispBonus = not na(mssDisp_) ? math.min(mssDisp_ * 3.0, 5.0) : 0.0
        compScore += dispBonus

        int dispMaxFresh = mode == "Aggressive" ? 35 : mode == "Conservative" ? 18 : 26
        if mssAge > math.round(dispMaxFresh * 0.5) and mssAge <= dispMaxFresh
            float decay = float(mssAge - math.round(dispMaxFresh * 0.5)) / float(dispMaxFresh) * 12.0
            compScore -= decay
        fresh := mssAge <= dispMaxFresh

        if not fresh and not failed
            failed := true
            failReason := "Displacement stale (" + str.tostring(mssAge) + " bars since MSS)"

        if not failed and not newMss and mssAge >= 2 and not na(originPrice)
            bool lostDisp = isLong ? close < originPrice + atrVal * 0.1 : close > originPrice - atrVal * 0.1
            if lostDisp and followBars <= 1
                failed := true
                failReason := "Displacement failed — price snapped back to origin"

        if not failed and hasImbalance and fvgMitigated_ and not na(fvgBar_) and (bar_index - fvgBar_) <= 3
            failed := true
            failReason := "Displacement imbalance mitigated immediately"

        if not newMss and not newDisp and prevDispScore > compScore
            compScore := compScore * 0.7 + prevDispScore * 0.3
        score := math.max(0.0, math.min(100.0, compScore))

        if not failed and foundDisp and mssValid_
            detected := true
            dispWeak := score < 30.0
            valid := score >= 30.0
            strong_ := score >= 60.0 and bodyDom >= 0.6 and rangeAtr >= 0.8
            retained := not na(mssBreakLvl_) and (isLong ? close > mssBreakLvl_ : close < mssBreakLvl_)

        if failed
            detected := false
            valid := false
            strong_ := false
            reason := "Displacement failed: " + failReason
        else if strong_
            reason := "Strong displacement (" + str.tostring(math.round(score)) + ") — " + str.tostring(rangeAtr, "#.#") + "×ATR, body " + str.tostring(math.round(bodyDom * 100)) + "%"
        else if valid and not dispWeak
            reason := "Valid displacement (" + str.tostring(math.round(score)) + ") — " + str.tostring(rangeAtr, "#.#") + "×ATR"
        else if detected and dispWeak
            reason := "Weak push (" + str.tostring(math.round(score)) + ") — displacement not confirmed"
        else if mssFailed_
            reason := "MSS failed — no displacement context"
        else if not foundDisp
            reason := "No directional push found after MSS"
        else if not mssValid_
            reason := "MSS not validated — displacement pending"
    else
        if mssFailed_
            reason := "MSS failed — displacement blocked"
            failed := true
        else if na(mssBar_)
            reason := "No MSS context"

    [detected, dispWeak, valid, strong_, fresh, failed, score, reason, failReason,
     dispBar, rangeAtr, bodyDom, closeQual, followBars, hasImbalance, fvgGrOut,
     retained, originPrice, extremePrice]

// Mode-dependent displacement pass (Chapter 5)
// Returns: [pass, passStrong]
export displacement_mode_pass(bool detected_, bool valid_, bool strong_, float score_, bool failed_, string mode) =>
    bool pass = false
    bool passStrong = false
    if not failed_
        if mode == "Aggressive"
            pass := detected_ and score_ >= 15.0
            passStrong := valid_ and score_ >= 45.0
        else if mode == "Conservative"
            pass := valid_ and not strong_ ? score_ >= 45.0 : strong_
            passStrong := strong_ and score_ >= 60.0
        else // Balanced
            pass := valid_ and score_ >= 25.0
            passStrong := strong_ or (valid_ and score_ >= 55.0)
    [pass, passStrong]

// Displacement/FVG bridge (Chapter 5)
// Returns: [bridgePass, bridgeStrong, reason]
export evaluate_displacement_bridge(float mssDisp_, int fvgBar_, int fvgGrade_, bool fvgMitigated, bool seqOk, int mssBar_, string mode, bool dispValid_, bool dispStrong_, bool dispFailed_, float dispScore_) =>
    bool bridgePass = false
    bool bridgeStrong = false
    string reason = ""
    if dispFailed_
        reason := "Bridge fail — displacement failed"
    else
        [dPass, dPassStrong] = displacement_mode_pass(not dispFailed_, dispValid_, dispStrong_, dispScore_, dispFailed_, mode)
        bridgePass := dPass
        bridgeStrong := dPassStrong
        if not bridgePass
            float minDisp = mode == "Conservative" ? 1.3 : mode == "Balanced" ? 0.8 : 0.5
            bool legacyOk = not na(mssDisp_) and mssDisp_ >= minDisp
            bool hasFreshFvg = not na(fvgBar_) and fvgGrade_ >= 2 and not fvgMitigated
            bool fvgAfterMss = hasFreshFvg and not na(mssBar_) and fvgBar_ >= mssBar_
            if legacyOk and (seqOk or (fvgAfterMss and (bar_index - fvgBar_) <= 25))
                bridgePass := true
                reason := "Bridge OK [legacy fallback]"
        if bridgePass and reason == ""
            reason := "Bridge OK" + (bridgeStrong ? " [strong]" : "") + " (disp=" + str.tostring(math.round(dispScore_)) + ")"
        else if not bridgePass
            reason := "Bridge fail — disp score " + str.tostring(math.round(dispScore_)) + " insufficient for " + mode
    [bridgePass, bridgeStrong, reason]
