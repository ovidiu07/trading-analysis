//@version=6
// @description Improved Trader-Grade Liquidity Engine. Handles sophisticated sweep classification, tiered scoring, and institutional target selection (SMC/ICT style).
library("tv_liquidity_engine", overlay = true)

import Devtailor/tv_core_types/4 as T

// --- Constants: Source Types ---
int SRC_SESSION     = T.SRC_SESSION()
int SRC_PDH_PDL     = T.SRC_PDH_PDL()
int SRC_PWH_PWL     = T.SRC_PWH_PWL()
int SRC_PIVOT_EXT   = T.SRC_PIVOT_EXT()
int SRC_PIVOT_INT   = T.SRC_PIVOT_INT()
int SRC_EQH_EQL     = T.SRC_EQH_EQL()
int SRC_ROUND_NUM   = T.SRC_ROUND_NUM()
int SRC_PIVOT_HTF_1 = T.SRC_PIVOT_HTF_1()
int SRC_PIVOT_HTF_2 = T.SRC_PIVOT_HTF_2()
int SRC_PIVOT_HTF_3 = T.SRC_PIVOT_HTF_3()
int SRC_DEVELOPING  = T.SRC_DEVELOPING()

// --- Constants: Sweep Types ---
int SWEEP_SHALLOW       = T.SWEEP_SHALLOW()
int SWEEP_CLEAN_RAID    = T.SWEEP_CLEAN_RAID()
int SWEEP_DEEP_STOP_RUN = T.SWEEP_DEEP_STOP_RUN()
int SWEEP_EXT_LIQ_GRAB  = T.SWEEP_EXT_LIQ_GRAB()
int SWEEP_INT_LIQ_SWEEP = T.SWEEP_INT_LIQ_SWEEP()
int SWEEP_SESSION       = T.SWEEP_SESSION()
int SWEEP_HTF           = T.SWEEP_HTF()

// --- Constants: Tiers ---
string TIER_MAJOR    = "Major"      // HTF/Weekly/Monthly/External
string TIER_STRUCT   = "Structural" // Daily/Session/Major Internal
string TIER_MINOR    = "Minor"      // Local Pivots/Round Numbers
string TIER_INDUC    = "Inducement" // Traps/Low Probability

// =====================================================================
// 1. SOURCE INTELLIGENCE & TIERING
// =====================================================================

// Map source types to institutional significance tiers
export get_liquidity_tier(int srcType, bool isExt) =>
    string tier = TIER_MINOR
    if srcType == SRC_PWH_PWL or srcType == SRC_PIVOT_HTF_3 or (srcType == SRC_PIVOT_HTF_2 and isExt)
        tier := TIER_MAJOR
    else if srcType == SRC_PDH_PDL or srcType == SRC_SESSION or srcType == SRC_PIVOT_EXT or srcType == SRC_EQH_EQL
        tier := TIER_STRUCT
    tier

export source_category_label(int srcType, string lvlName) =>
    string label = "Liquidity"
    if srcType == SRC_PWH_PWL
        label := "Weekly Level"
    else if srcType == SRC_PDH_PDL
        label := "Daily Level"
    else if srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3
        label := "HTF Pivot"
    else if srcType == SRC_SESSION
        label := "Session Level"
    else if srcType == SRC_EQH_EQL
        label := "EQ Cluster"
    else if srcType == SRC_ROUND_NUM
        label := "Round Number"
    else if srcType == SRC_PIVOT_EXT
        label := "External Pivot"
    else if srcType == SRC_PIVOT_INT
        label := "Internal Pivot"

    if (srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3) and lvlName != ""
        label := label + " (" + lvlName + ")"
    label

// =====================================================================
// 2. SWEEP CLASSIFICATION & QUALITY (The "Trader" Logic)
// =====================================================================

// Improved classification based on structural intent
export classify_sweep_type(float depthAtr, bool isExt, bool isHTF_, bool isSess, bool isCluster_, int srcType, bool hasDisp) =>
    int sType = SWEEP_SHALLOW
    string sStr = "Shallow"

    if isHTF_
        sType := SWEEP_HTF
        sStr := "HTF Sweep"
    else if isExt and hasDisp
        sType := SWEEP_EXT_LIQ_GRAB
        sStr := "External Liquidity Raid"
    else if isSess
        sType := SWEEP_SESSION
        sStr := "Session Sweep"
    else if isCluster_
        sType := SWEEP_INT_LIQ_SWEEP
        sStr := "Pool Sweep"
    else
        sType := SWEEP_INT_LIQ_SWEEP
        sStr := "Internal Sweep"

    // Contextual Overrides
    if depthAtr > 1.8 // Too deep, likely a break of structure (BOS) not a sweep
        sType := SWEEP_DEEP_STOP_RUN
        sStr := "Stop Run / Trend"
    else if hasDisp and depthAtr > 0.15
        sType := SWEEP_CLEAN_RAID
        sStr := "Clean Raid"

    [sType, sStr]

// Multi-dimensional quality scoring with interaction effects
export compute_sweep_quality(float depthAtr, float wickPenRatio, float rejStr, bool hasRej, bool hasDisp, int srcPri, bool isExt, bool isHTF_, bool isCluster_, bool inKz, float freshness, int sweepT) =>
    float q = 0.0

    // 1. Base Multiplier (Structural significance)
    float multiplier = 1.0
    if isHTF_
        multiplier := multiplier * 1.25
    if isExt
        multiplier := multiplier * 1.15
    if inKz
        multiplier := multiplier * 1.10
    if isCluster_
        multiplier := multiplier * 1.05

    // 2. Execution Quality (Interactive logic)
    float execScore = 0.0
    if hasDisp
        execScore := 40.0 * (1.0 + rejStr)
    else if hasRej
        execScore := 20.0 + (rejStr * 15.0)

    if sweepT == SWEEP_DEEP_STOP_RUN and not hasRej
        multiplier := multiplier * 0.5

    // 3. Raw Components
    float sourceScore = (srcPri / 100.0) * 20.0
    float proximityScore = freshness * 15.0
    float depthScore = math.min(depthAtr * 10.0, 15.0)

    // 4. Combine
    q := (execScore + sourceScore + proximityScore + depthScore) * multiplier

    // 5. Final Constraints
    if wickPenRatio < 0.05 and not hasDisp
        q := q * 0.7

    math.max(0.0, math.min(100.0, q))

export get_sweep_grade(float q) =>
    q >= 75.0 ? "A+" : q >= 60.0 ? "A" : q >= 40.0 ? "B" : q >= 20.0 ? "C" : "D (Low Prob)"

// =====================================================================
// 3. RELEVANCE & HIERARCHY (Target Selection)
// =====================================================================

// Calculate level relevance with decay and tier weight
export hierarchy_level_score(float price_, int priority_, bool isExt, bool isHTF, bool isSess, bool isClust, int srcType, bool isConsumed, bool isDirty, float refPrice, float atrVal, int ageBars) =>
    float score = 0.0

    // Tier-based Base Score
    string tier = get_liquidity_tier(srcType, isExt)
    float baseScore = tier == TIER_MAJOR ? 55.0 : tier == TIER_STRUCT ? 35.0 : 15.0
    score := score + baseScore

    // Proximity (The "Magnet" Effect)
    float distAtr = atrVal > 0 ? math.abs(price_ - refPrice) / atrVal : 10.0
    float proxBonus = math.max(0.0, 30.0 - (distAtr * 5.0))

    // Multiplier for Proximity + Tier (Institutional levels are better magnets)
    float tierProxMult = tier == TIER_MAJOR ? 1.3 : tier == TIER_STRUCT ? 1.15 : 1.0
    score := score + (proxBonus * tierProxMult)

    // Time-based Decay (Institutional levels decay slower)
    float decayFactor = tier == TIER_MAJOR ? 0.0003 : tier == TIER_STRUCT ? 0.0015 : 0.006
    score := score * math.max(0.1, 1.0 - (ageBars * decayFactor))

    // Interaction Bonuses
    if isClust
        score := score + 15.0
    if isHTF
        score := score + 10.0
    if isSess
        score := score + 5.0

    // Contextual Penalties (Non-binary interaction logic)
    if isConsumed
        score := score - 60.0
    else if isDirty
        score := score - 20.0

    if srcType == SRC_ROUND_NUM
        score := score - 5.0

    score

// Select tactical targets: Separates "Nearest", "Inducement", and "The Draw"
export select_hierarchy_targets(T.LiqLevel[] levels, float refPrice, float atrVal, T.LiqSweep[] sweeps, int currentBar) =>
    float consumedTol = atrVal * 0.15
    float dirtyZone   = atrVal * 0.50

    // Results BSL
    float bslNear = na
    float bslDraw = na
    float bslInd = na
    string bslDrawName = ""
    string bslIndName = ""
    float bslMaxS = -999.0
    float bslNearS = -999.0
    string bslNearT = ""
    string bslDrawT = ""
    bool bslDrawDirty = false

    // Results SSL
    float sslNear = na
    float sslDraw = na
    float sslInd = na
    string sslDrawName = ""
    string sslIndName = ""
    float sslMaxS = -999.0
    float sslNearS = -999.0
    string sslNearT = ""
    string sslDrawT = ""
    bool sslDrawDirty = false

    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            T.LiqLevel lvl = array.get(levels, i)
            if na(lvl.price) or lvl.sourceType == SRC_DEVELOPING
                continue

            // 1. Contextual State (Consumed vs Dirty vs Clean)
            bool consumed = false
            bool dirty = false

            if math.abs(lvl.price - refPrice) <= dirtyZone
                dirty := true

            if array.size(sweeps) > 0
                for j = 0 to array.size(sweeps) - 1
                    T.LiqSweep s = array.get(sweeps, j)
                    if s.isSSL == lvl.isSSL and math.abs(s.levelPrice - lvl.price) <= consumedTol
                        consumed := true
                        dirty := false
                        break

            // 2. Real Age Activation (Using level bar as priority proxy if startBar is missing in UDT)
            // Note: If UDT doesn't have startBar, we assume priority or creation sequence handles sorting.
            // For now, we utilize ageBars as 0 but keep the infrastructure ready for the actual bar field.
            int ageBars = 0

            float hScore = hierarchy_level_score(lvl.price, lvl.priority, lvl.isExternal, lvl.isHTF, lvl.isSession, lvl.isCluster, lvl.sourceType, consumed, dirty, refPrice, atrVal, ageBars)
            string tier = get_liquidity_tier(lvl.sourceType, lvl.isExternal)

            if not lvl.isSSL and lvl.price > refPrice
                if na(bslNear) or lvl.price < bslNear
                    bslNear := lvl.price
                    bslNearS := hScore
                    bslNearT := tier

                if hScore > bslMaxS and not consumed
                    bslMaxS := hScore
                    bslDraw := lvl.price
                    bslDrawName := lvl.name
                    bslDrawT := tier
                    bslDrawDirty := dirty

            else if lvl.isSSL and lvl.price < refPrice
                if na(sslNear) or lvl.price > sslNear
                    sslNear := lvl.price
                    sslNearS := hScore
                    sslNearT := tier

                if hScore > sslMaxS and not consumed
                    sslMaxS := hScore
                    sslDraw := lvl.price
                    sslDrawName := lvl.name
                    sslDrawT := tier
                    sslDrawDirty := dirty

    // 3. Tactical Refinement (Inducement & Confidence Modeling)
    float bslConf = 0.0
    float sslConf = 0.0

    if not na(bslNear) and not na(bslDraw) and bslNear < bslDraw
        float scoreGap = bslMaxS - bslNearS
        float distRatio = (bslDraw - bslNear) / math.max(1e-6, bslNear - refPrice)
        bool tierInduc = bslNearT == TIER_MINOR and bslDrawT != TIER_MINOR

        if (tierInduc and scoreGap > 10.0) or (scoreGap > 25.0 and distRatio < 2.0)
            bslInd := bslNear
            bslIndName := "Inducement"
            bslConf := bslDrawDirty ? 0.6 : 0.9
        else
            bslConf := 0.45
    else if not na(bslDraw)
        bslConf := bslMaxS > 60.0 ? 0.75 : 0.50

    if not na(sslNear) and not na(sslDraw) and sslNear > sslDraw
        float scoreGap = sslMaxS - sslNearS
        float distRatio = (sslNear - sslDraw) / math.max(1e-6, refPrice - sslNear)
        bool tierInduc = sslNearT == TIER_MINOR and sslDrawT != TIER_MINOR

        if (tierInduc and scoreGap > 10.0) or (scoreGap > 25.0 and distRatio < 2.0)
            sslInd := sslNear
            sslIndName := "Inducement"
            sslConf := sslDrawDirty ? 0.6 : 0.9
        else
            sslConf := 0.45
    else if not na(sslDraw)
        sslConf := sslMaxS > 60.0 ? 0.75 : 0.50

    [bslNear, bslDraw, bslInd, bslDrawName, bslIndName, bslConf,
     sslNear, sslDraw, sslInd, sslDrawName, sslIndName, sslConf,
     bslMaxS, sslMaxS]

// =====================================================================
// 4. SUMMARY FUNCTIONS
// =====================================================================

export summarize_active_sweeps(T.LiqSweep[] sweeps) =>
    bool hasSSL = false
    bool hasBSL = false
    float qSSL = 0.0
    float qBSL = 0.0
    string typeSSL = ""
    string typeBSL = ""
    string gradeSSL = ""
    string gradeBSL = ""

    if array.size(sweeps) > 0
        for i = 0 to array.size(sweeps) - 1
            T.LiqSweep s = array.get(sweeps, i)
            if not s.isActionable or s.isConsumed
                continue
            if s.isSSL
                if s.qualityScore > qSSL
                    hasSSL := true
                    qSSL := s.qualityScore
                    typeSSL := s.sweepTypeStr
                    gradeSSL := s.grade
            else
                if s.qualityScore > qBSL
                    hasBSL := true
                    qBSL := s.qualityScore
                    typeBSL := s.sweepTypeStr
                    gradeBSL := s.grade

    [hasSSL, hasBSL, qSSL, qBSL, typeSSL, typeBSL, gradeSSL, gradeBSL]

export summarize_liquidity_map(T.LiqLevel[] levels, float refPrice) =>
    float _nearBSL = na
    float _nearSSL = na
    int _totalBSL = 0
    int _totalSSL = 0
    int _majorBSL = 0
    int _majorSSL = 0

    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            T.LiqLevel lvl = array.get(levels, i)
            if na(lvl.price) or lvl.sourceType == SRC_DEVELOPING
                continue

            string tier = get_liquidity_tier(lvl.sourceType, lvl.isExternal)

            if not lvl.isSSL and lvl.price > refPrice
                _totalBSL := _totalBSL + 1
                if tier == TIER_MAJOR
                    _majorBSL := _majorBSL + 1
                if na(_nearBSL) or lvl.price < _nearBSL
                    _nearBSL := lvl.price
            else if lvl.isSSL and lvl.price < refPrice
                _totalSSL := _totalSSL + 1
                if tier == TIER_MAJOR
                    _majorSSL := _majorSSL + 1
                if na(_nearSSL) or lvl.price > _nearSSL
                    _nearSSL := lvl.price

    [_nearBSL, _nearSSL, _totalBSL, _totalSSL, _majorBSL, _majorSSL]
