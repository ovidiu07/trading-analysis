//@version=6
indicator("SMC & ICT Multi-Strategy [Pro Visuals]", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// --- Constants ---
string NY_TZ = "America/New_York"
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color NEUTRAL_COLOR = #5b9cf6

// --- User Defined Types ---
type Trade
    string  strategyName
    bool    isLong
    float   entryPrice
    float   stopPrice
    float   tp1Price
    float   tp2Price
    int     entryBar
    bool    isActive = false
    bool    isTp1Hit = false
    box     tpBox    = na
    box     slBox    = na

type AlertLog
    string  timeStr
    string  signalType
    float   price
    color   col

type Stats
    int     totalTrades = 0
    int     wins = 0
    int     losses = 0
    float   totalR = 0.0
    float   equityR = 0.0
    float   maxDrawdownR = 0.0
    float   peakEquityR = 0.0

type SessionData
    string name
    string timeRange
    bool   isActive = false
    float  high = na
    float  low = na
    float  lastHigh = na
    float  lastLow = na

type SetupState
    string  phase = "Monitoring"
    int     score = 0
    string  missing = "Searching for context..."
    float   nearestBSL = na
    float   nearestSSL = na
    float   requiredSweep = na
    float   triggerLevel = na
    float   invalidationLevel = na
    bool    isPotentialLong = false
    bool    isPotentialShort = false
    // Phase 1+2: Quality & sequence tracking
    int     scoreLong = 0
    int     scoreShort = 0
    string  phaseLong = "Monitoring"
    string  phaseShort = "Monitoring"
    string  missingLong = ""
    string  missingShort = ""
    string  sweepGrade = ""
    string  mssGrade = ""
    string  fvgGrade = ""
    bool    sequenceValid = false
    bool    hasOBConfluence = false
    // Phase 5: Lifecycle
    bool    isExpired = false
    bool    isConflicted = false
    bool    isDegraded = false

type SmartZone
    box   boxId
    float top
    float bottom
    bool  isBull
    bool  mitigated = false
    bool  isInverted = false
    int   startBar
    float ce = na
    bool  ceRespected = false
    bool  ceBroken = false
    int   touchCount = 0
    float gapSize = na

// --- Liquidity Source Constants ---
// Source types (int enum for Pine efficiency)
int SRC_SESSION     = 1   // Asia/London/NY high or low
int SRC_PDH_PDL     = 2   // Previous day high/low
int SRC_PWH_PWL     = 3   // Previous week high/low
int SRC_PIVOT_EXT   = 4   // External structure pivot
int SRC_PIVOT_INT   = 5   // Internal structure pivot
int SRC_EQH_EQL     = 6   // Equal highs / equal lows cluster
int SRC_DEVELOPING  = 7   // Developing session level (lower trust)
int SRC_PIVOT_HTF_1 = 8   // Configured HTF pivot tier 1
int SRC_PIVOT_HTF_2 = 9   // Configured HTF pivot tier 2
int SRC_PIVOT_HTF_3 = 10  // Optional configured HTF pivot tier 3
int SRC_ROUND_NUM   = 11  // Psychological / round-number liquidity

// Source priority scores (higher = more important)
int PRI_PWH_PWL     = 100
int PRI_PDH_PDL     = 80
int PRI_EQH_EQL     = 70
int PRI_SESSION     = 60
int PRI_PIVOT_EXT   = 50
int PRI_PIVOT_INT   = 25
int PRI_DEVELOPING  = 15
int PRI_PIVOT_HTF_1 = 68
int PRI_PIVOT_HTF_2 = 78
int PRI_PIVOT_HTF_3 = 88
int PRI_ROUND_NUM   = 35

// Sweep type classification
int SWEEP_SHALLOW        = 1   // Tiny penetration, low confidence
int SWEEP_CLEAN_RAID     = 2   // Good penetration + rejection
int SWEEP_DEEP_STOP_RUN  = 3   // Very deep, exhaustion risk
int SWEEP_EXT_LIQ_GRAB   = 4   // Major external level swept
int SWEEP_INT_LIQ_SWEEP  = 5   // Internal level swept
int SWEEP_SESSION        = 6   // Session extreme swept
int SWEEP_HTF            = 7   // PDH/PDL/PWH/PWL swept
int SWEEP_INDUCEMENT     = 8   // Small level taken before bigger target

// Sweep lifecycle states
int LIFE_DETECTED        = 1
int LIFE_ACTIVE          = 2
int LIFE_CONFIRMED       = 3   // Validated by rejection/displacement
int LIFE_CONSUMED        = 4   // Used by MSS/setup
int LIFE_STALE           = 5
int LIFE_INVALIDATED     = 6

// --- Liquidity Level Type ---
// Represents a monitored liquidity source with classification metadata
type LiqLevel
    string  name           // Human-readable name
    float   price          // Level price
    int     sourceType     // SRC_* constant
    int     priority       // PRI_* score
    bool    isExternal     // External vs internal liquidity
    bool    isSSL          // true = sell-side (below), false = buy-side (above)
    bool    isHTF          // Weekly/Daily = true
    bool    isSession      // Session-derived level
    bool    isCluster      // Part of EQH/EQL cluster
    int     clusterCount   // Number of touches in cluster (0 if not cluster)
    int     createdBar     // Bar when level was registered

// --- Liquidity Sweep Type (expanded) ---
type LiqSweep
    // Identity
    string  levelName
    float   levelPrice
    int     sourceType      // SRC_* constant
    int     sourcePriority  // PRI_* score
    bool    isExternal      // External vs internal
    bool    isSSL           // Sell-side vs buy-side
    // Sweep metrics
    float   sweepDepth
    float   sweepDepthAtr
    float   wickPenetrationRatio   // wick beyond level / total range
    float   rejectionStrength      // body reclaim ratio (0-1)
    bool    hasRejection
    bool    hasDisplacement
    // Classification
    int     sweepType       // SWEEP_* constant
    string  sweepTypeStr    // Human-readable sweep type
    string  grade           // "A" / "B" / "C" / "Reject"
    float   qualityScore    // Composite 0-100
    // Lifecycle
    int     sweepBar
    int     lifecycleState  // LIFE_* constant
    bool    isActionable    // Still usable for setup
    bool    isConsumed      // Used by MSS/setup
    // Context
    bool    isHTF           // Weekly/Daily level sweep
    bool    isSessionSweep  // Session extreme sweep
    bool    isClusterSweep  // EQH/EQL cluster sweep
    int     clusterCount    // Persist cluster significance through lifecycle updates
    bool    isInducementLike
    bool    inKillzone      // Swept during killzone
    bool    inSilverBullet  // Swept during SB window
    string  sessionAtSweep  // Session name when swept

// --- Inputs ---
var string G_SENS = "Signal Sensitivity"
string sensitivityMode = input.string("Balanced", "Sensitivity Mode", options = ["Aggressive", "Balanced", "Conservative"], tooltip = "Adjusts pivot lookback and displacement requirements for signals.", group = G_SENS)

var string G_LIQ = "Liquidity Engine"
bool enableHtfPivot1 = input.bool(true, "Track HTF Pivot 1", group = G_LIQ, inline = "liq_htf1")
string liqPivotTf1 = input.timeframe("60", "", group = G_LIQ, inline = "liq_htf1")
bool enableHtfPivot2 = input.bool(true, "Track HTF Pivot 2", group = G_LIQ, inline = "liq_htf2")
string liqPivotTf2 = input.timeframe("240", "", group = G_LIQ, inline = "liq_htf2")
bool enableHtfPivot3 = input.bool(false, "Track HTF Pivot 3", group = G_LIQ, inline = "liq_htf3")
string liqPivotTf3 = input.timeframe("D", "", group = G_LIQ, inline = "liq_htf3")
int htfPivotLeftLen = input.int(3, "HTF Pivot Left", minval = 1, maxval = 10, group = G_LIQ, inline = "liq_htf_len")
int htfPivotRightLen = input.int(2, "Right", minval = 1, maxval = 10, group = G_LIQ, inline = "liq_htf_len")
int eqLocalLookback = input.int(12, "EQ Local Lookback", minval = 6, maxval = 40, group = G_LIQ)
int eqStructuralLookback = input.int(32, "EQ Structural Lookback", minval = 10, maxval = 80, group = G_LIQ)
int eqClusterMaxAge = input.int(220, "EQ Max Age (bars)", minval = 40, maxval = 1000, group = G_LIQ)
bool enableRoundNumbers = input.bool(false, "Track Round Numbers", group = G_LIQ, inline = "liq_rn")
float roundStep = input.float(1.0, "Primary Step", minval = 0.00001, step = 0.00001, group = G_LIQ, inline = "liq_rn")
float roundSubStep = input.float(0.0, "Substep", minval = 0.0, step = 0.00001, group = G_LIQ, inline = "liq_rn")
bool enableInducementTag = input.bool(true, "Tag Deterministic Inducement", group = G_LIQ)

var string G_VIS = "Visual Style & Display"
bool showLabels = input.bool(true, "Show Buy/Sell Labels", group = G_VIS)
bool showSetups = input.bool(true, "Show Setup Visuals", tooltip = "Master toggle for all setup boxes, candidate previews, and active trade zones.", group = G_VIS)
bool showZones = input.bool(true, "Show Trade SL/TP Zones", group = G_VIS)
int maxHistory = input.int(5, "Max Historical Trades Shown", minval = 1, maxval = 20, group = G_VIS)

var string G_SETUP_STYLE = "Setup Colors"
color longTpColor = input.color(#089981, "Long TP / Reward Color", group = G_SETUP_STYLE)
color longSlColor = input.color(#f23645, "Long Risk / SL Color", group = G_SETUP_STYLE)
color shortTpColor = input.color(#f23645, "Short TP / Reward Color", group = G_SETUP_STYLE)
color shortSlColor = input.color(#089981, "Short Risk / SL Color", group = G_SETUP_STYLE)
color setupLabelColor = input.color(#5b9cf6, "Setup Label Text Color", group = G_SETUP_STYLE)

var string G_SMC = "Supply & Demand Elements"
bool showOB = input.bool(true, "Show Order Blocks", group = G_SMC)
bool showFVG = input.bool(true, "Show FVG Zones", group = G_SMC)
bool showIFVG = input.bool(true, "Show Inversion FVGs", group = G_SMC, tooltip = "FVGs that are closed through become Inversion FVGs.")
int maxZones = input.int(10, "Max Historical Zones", minval = 1, maxval = 50, group = G_SMC)
color bullObColor = input.color(color.new(BULL_COLOR, 80), "Bull OB Color", group = G_SMC)
color bearObColor = input.color(color.new(BEAR_COLOR, 80), "Bear OB Color", group = G_SMC)
color bullFvgColor = input.color(color.new(BULL_COLOR, 90), "Bull FVG Color", group = G_SMC)
color bearFvgColor = input.color(color.new(BEAR_COLOR, 90), "Bear FVG Color", group = G_SMC)
color bullIfvgColor = input.color(color.new(BULL_COLOR, 75), "Bull IFVG Color", group = G_SMC)
color bearIfvgColor = input.color(color.new(BEAR_COLOR, 75), "Bear IFVG Color", group = G_SMC)

var string G_FVG_ENGINE = "FVG Engine"
float fvgThresholdPct = input.float(0.0, "Threshold %", minval = 0, maxval = 100, step = 0.1, inline = "fvg_thresh", group = G_FVG_ENGINE, tooltip = "Manual minimum gap size as % of price. 0 = no manual filter.")
bool fvgAutoThreshold = input.bool(true, "Auto", inline = "fvg_thresh", group = G_FVG_ENGINE, tooltip = "Adaptive threshold: cumulative average of range/price ratio.")
string fvgTimeframe = input.timeframe("", "FVG Timeframe", group = G_FVG_ENGINE, tooltip = "Leave empty for chart TF. Set to detect FVGs from a higher timeframe.")
int fvgExtendBars = input.int(20, "Extend Bars", minval = 0, group = G_FVG_ENGINE, tooltip = "Initial right extension of FVG boxes in bars.")

var string G_STRAT = "Strategy Toggles"
bool enableICT2022 = input.bool(true, "ICT 2022 Model (Sweep + MSS)", group = G_STRAT)
bool enableSilverBullet = input.bool(true, "Silver Bullet (Time + FVG)", group = G_STRAT)

var string G_READINESS = "Setup & Performance Dashboard"
bool showReadiness = input.bool(true, "Show Dashboard", group = G_READINESS)
string readinessPos = input.string("bottom_right", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = G_READINESS)
string dashMode = input.string("Analyst", "Display Mode", options = ["Trader", "Analyst", "Debug"], tooltip = "Trader: minimal, action-oriented view. Analyst: richer setup context and confluence. Debug: full engine transparency.", group = G_READINESS)

var string G_INTEL = "Market Intelligence Dashboard"
bool showMarketIntelDash = input.bool(true, "Show Dashboard", group = G_INTEL)
string marketIntelPos = input.string("bottom_left", "Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = G_INTEL)
string trendHTF1 = input.timeframe("60", "HTF 1 Timeframe", group = G_INTEL)
string trendHTF2 = input.timeframe("240", "HTF 2 Timeframe", group = G_INTEL)
int maxAlertRows = input.int(5, "Max Alert Rows", minval = 1, maxval = 10, group = G_INTEL)
int maxScannerRows = input.int(5, "Max OB Scanner Rows", minval = 1, maxval = 10, group = G_INTEL)

var string G_HTF_VIS = "HTF Levels Visibility"
string htfDisplayMode = input.string("Short Segment", "Display Mode", options = ["Short Segment", "Full Width"], group = G_HTF_VIS)
int htfSegLen = input.int(15, "Segment Length", minval = 1, group = G_HTF_VIS)
int htfSegOffset = input.int(5, "Segment Offset", minval = 0, group = G_HTF_VIS)
bool showPDH = input.bool(true, "PDH", group = G_HTF_VIS, inline = "pdh")
color pdhColor = input.color(color.new(color.gray, 30), "", group = G_HTF_VIS, inline = "pdh")
bool showPDL = input.bool(true, "PDL", group = G_HTF_VIS, inline = "pdl")
color pdlColor = input.color(color.new(color.gray, 30), "", group = G_HTF_VIS, inline = "pdl")
bool showPWH = input.bool(true, "PWH", group = G_HTF_VIS, inline = "pwh")
color pwhColor = input.color(color.new(color.blue, 30), "", group = G_HTF_VIS, inline = "pwh")
bool showPWL = input.bool(true, "PWL", group = G_HTF_VIS, inline = "pwl")
color pwlColor = input.color(color.new(color.blue, 30), "", group = G_HTF_VIS, inline = "pwl")
string htfLineStyleInput = input.string("Dashed", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = G_HTF_VIS)
int htfLineWidth = input.int(1, "Line Width", minval = 1, group = G_HTF_VIS)
bool htfShowLabels = input.bool(true, "Show Labels", group = G_HTF_VIS)

var string G_SESS_LINES = "Session High/Low Lines"
string sessDisplayMode = input.string("Short Segment", "Display Mode", options = ["Short Segment", "Full Width"], group = G_SESS_LINES)
int sessSegLen = input.int(15, "Segment Length", minval = 1, group = G_SESS_LINES)
bool showAsiaH = input.bool(false, "Asia High", group = G_SESS_LINES, inline = "asiah")
color asiaHColor = input.color(color.new(color.purple, 30), "", group = G_SESS_LINES, inline = "asiah")
bool showAsiaL = input.bool(false, "Asia Low", group = G_SESS_LINES, inline = "asial")
color asiaLColor = input.color(color.new(color.purple, 30), "", group = G_SESS_LINES, inline = "asial")
bool showLonH = input.bool(false, "London High", group = G_SESS_LINES, inline = "lonh")
color lonHColor = input.color(color.new(color.orange, 30), "", group = G_SESS_LINES, inline = "lonh")
bool showLonL = input.bool(false, "London Low", group = G_SESS_LINES, inline = "lonl")
color lonLColor = input.color(color.new(color.orange, 30), "", group = G_SESS_LINES, inline = "lonl")
bool showNYH = input.bool(false, "NY High", group = G_SESS_LINES, inline = "nyh")
color nyHColor = input.color(color.new(color.red, 30), "", group = G_SESS_LINES, inline = "nyh")
bool showNYL = input.bool(false, "NY Low", group = G_SESS_LINES, inline = "nyl")
color nyLColor = input.color(color.new(color.red, 30), "", group = G_SESS_LINES, inline = "nyl")
string sessLineStyleInput = input.string("Dotted", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = G_SESS_LINES)

var string G_EQ_VIS = "EQH / EQL Visibility"
bool showEqClusters = input.bool(true, "Show EQ Clusters", group = G_EQ_VIS)
int eqClusterSegLen = input.int(14, "Segment Length", minval = 4, maxval = 80, group = G_EQ_VIS)
int eqClusterOffset = input.int(2, "Segment Offset", minval = 0, maxval = 20, group = G_EQ_VIS)
bool eqClusterShowLabels = input.bool(true, "Show Labels", group = G_EQ_VIS)
color eqhColor = input.color(color.new(color.orange, 25), "EQH Color", group = G_EQ_VIS, inline = "eq_col")
color eqlColor = input.color(color.new(color.aqua, 25), "EQL Color", group = G_EQ_VIS, inline = "eq_col")

var string G_ACTIVE_VIS = "Active Setup Visuals"
bool showCandidatePreview = input.bool(true, "Show Projected Forming Setup", group = G_ACTIVE_VIS)
string activeSetupSize = input.string("Normal", "Active Setup Size", options = ["Compact", "Normal", "Large"], group = G_ACTIVE_VIS)
int activeMinWidth = input.int(15, "Min Projected Width (Bars)", minval = 5, group = G_ACTIVE_VIS)
bool extendCandidateRight = input.bool(true, "Extend Forming Setup to Right", group = G_ACTIVE_VIS)
int activeBorderWidth = input.int(2, "Active Border Thickness", minval = 1, maxval = 5, group = G_ACTIVE_VIS)
int activeTransp = input.int(85, "Active Setup Transparency", minval = 0, maxval = 100, group = G_ACTIVE_VIS)

var string G_OUTCOME_VIS = "Outcome Markers"
bool showTpMarkers = input.bool(true, "Show TP/TP1 Hit Markers", group = G_OUTCOME_VIS)
bool showSlMarkers = input.bool(true, "Show SL/BE Hit Markers", group = G_OUTCOME_VIS)
string markerSizeInput = input.string("Small", "Marker Size", options = ["Tiny", "Small", "Normal"], group = G_OUTCOME_VIS)
color tpMarkerColor = input.color(BULL_COLOR, "TP Marker Color", group = G_OUTCOME_VIS)
color slMarkerColor = input.color(BEAR_COLOR, "SL Marker Color", group = G_OUTCOME_VIS)

var string G_STYLE = "Dashboard Colors & UI Theme"
color uiBg = input.color(color.new(#131722, 10), "Dashboard Background", group = G_STYLE)
color uiBorder = input.color(#363a45, "Dashboard Border", group = G_STYLE)
color uiHeaderText = input.color(color.white, "Header Text", group = G_STYLE)
color uiLabelText = input.color(color.gray, "Label Text", group = G_STYLE)
color uiValueText = input.color(color.white, "Value Text", group = G_STYLE)
color uiPosColor = input.color(BULL_COLOR, "Positive Color", group = G_STYLE)
color uiNegColor = input.color(BEAR_COLOR, "Negative Color", group = G_STYLE)
color uiNeutralColor = input.color(NEUTRAL_COLOR, "Neutral/Accent Color", group = G_STYLE)

// --- Sensitivity Logic ---
float sensAtrMult = sensitivityMode == "Aggressive" ? 1.0 : sensitivityMode == "Conservative" ? 2.5 : 1.5
int sensPivotLen = sensitivityMode == "Aggressive" ? 2 : sensitivityMode == "Conservative" ? 5 : 3

// --- Session Engine ---
var asia    = SessionData.new("Asia", "2000-0000")
var london  = SessionData.new("London", "0200-1100")
var ny      = SessionData.new("New York", "0800-1700")
var overlap = SessionData.new("London/NY Overlap", "0800-1100")
var sbLon   = SessionData.new("SB London", "0300-0400")
var sbAm    = SessionData.new("SB AM", "1000-1100")

update_session(SessionData s) =>
    inSess = not na(time(timeframe.period, s.timeRange, NY_TZ))
    if inSess
        if not s.isActive
            s.high := high
            s.low := low
        else
            s.high := math.max(high, s.high)
            s.low := math.min(low, s.low)
    else if s.isActive
        s.lastHigh := s.high
        s.lastLow := s.low
    s.isActive := inSess

update_session(asia)
update_session(london)
update_session(ny)
update_session(overlap)
update_session(sbLon)
update_session(sbAm)

string activeSessName = overlap.isActive ? overlap.name : ny.isActive ? ny.name : london.isActive ? london.name : asia.isActive ? asia.name : "Inter-Session"
bool isKillzone = sbLon.isActive or sbAm.isActive or overlap.isActive
bool isSilverBullet = sbLon.isActive or sbAm.isActive

// --- HTF Liquidity ---
float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
float pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
float pwl = request.security(syminfo.tickerid, "W", low[1], lookahead = barmerge.lookahead_on)

get_last_confirmed_pivot_high(string tf, int leftLen, int rightLen) =>
    request.security(
         syminfo.tickerid,
         tf,
         ta.valuewhen(not na(ta.pivothigh(high, leftLen, rightLen)), ta.pivothigh(high, leftLen, rightLen), 0),
         lookahead = barmerge.lookahead_off)

get_last_confirmed_pivot_low(string tf, int leftLen, int rightLen) =>
    request.security(
         syminfo.tickerid,
         tf,
         ta.valuewhen(not na(ta.pivotlow(low, leftLen, rightLen)), ta.pivotlow(low, leftLen, rightLen), 0),
         lookahead = barmerge.lookahead_off)

// --- Core Data & Primitives ---
int atrLen = input.int(14, "ATR Length", minval = 1, group = G_SENS)
float atr = ta.atr(atrLen)
float bodySize = math.abs(close - open)
float rangeSize = high - low
float volSma = ta.sma(volume, 20)
bool volOk = na(volume) or volume > volSma * 1.2

bool isDispBull = bodySize > (atr * sensAtrMult * 0.6) and rangeSize > (atr * sensAtrMult) and close > open and volOk
bool isDispBear = bodySize > (atr * sensAtrMult * 0.6) and rangeSize > (atr * sensAtrMult) and close < open and volOk
bool isDisplacement = isDispBull or isDispBear

float emaBias = ta.ema(close, 200)
float emaSlope = emaBias - emaBias[10]
float emaBuffer = atr * 0.3
string marketBias = close > emaBias + emaBuffer and emaSlope > 0 ? "Bullish"
     : close < emaBias - emaBuffer and emaSlope < 0 ? "Bearish"
     : "Neutral"


// MTF Trend Data (BUG FIX: htf2Ema and htf2Price now use trendHTF2)
float htf1Ema = request.security(syminfo.tickerid, trendHTF1, ta.ema(close, 200))
float htf2Ema = request.security(syminfo.tickerid, trendHTF2, ta.ema(close, 200))
float htf1Price = request.security(syminfo.tickerid, trendHTF1, close)
float htf2Price = request.security(syminfo.tickerid, trendHTF2, close)

// --- Sensitivity Logic (updated) ---
int sensLeftLen = sensitivityMode == "Aggressive" ? 3 : sensitivityMode == "Conservative" ? 7 : 5
int sensRightLen = sensitivityMode == "Aggressive" ? 1 : sensitivityMode == "Conservative" ? 3 : 2
int pivotMaxAge = sensitivityMode == "Aggressive" ? 100 : sensitivityMode == "Conservative" ? 200 : 150

// --- Market Structure Shift (MSS) ---
float pHi = ta.pivothigh(sensLeftLen, sensRightLen)
float pLo = ta.pivotlow(sensLeftLen, sensRightLen)

var float lastPHi = na
var float prevPHi = na
var int lastPHiBar = na
var float lastPLo = na
var float prevPLo = na
var int lastPLoBar = na

float minSwingDepth = atr * 0.5

if not na(pHi) and (na(lastPLo) or (pHi - lastPLo) > minSwingDepth)
    prevPHi := lastPHi
    lastPHi := pHi
    lastPHiBar := bar_index - sensRightLen

if not na(pLo) and (na(lastPHi) or (lastPHi - pLo) > minSwingDepth)
    prevPLo := lastPLo
    lastPLo := pLo
    lastPLoBar := bar_index - sensRightLen

// Expire stale pivots
if not na(lastPHiBar) and (bar_index - lastPHiBar) > pivotMaxAge
    lastPHi := na
    lastPHiBar := na
if not na(lastPLoBar) and (bar_index - lastPLoBar) > pivotMaxAge
    lastPLo := na
    lastPLoBar := na

float htfPivot1High = enableHtfPivot1 ? get_last_confirmed_pivot_high(liqPivotTf1, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot1Low = enableHtfPivot1 ? get_last_confirmed_pivot_low(liqPivotTf1, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot2High = enableHtfPivot2 ? get_last_confirmed_pivot_high(liqPivotTf2, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot2Low = enableHtfPivot2 ? get_last_confirmed_pivot_low(liqPivotTf2, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot3High = enableHtfPivot3 ? get_last_confirmed_pivot_high(liqPivotTf3, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot3Low = enableHtfPivot3 ? get_last_confirmed_pivot_low(liqPivotTf3, htfPivotLeftLen, htfPivotRightLen) : na

// BOS (continuation) vs MSS (reversal)
bool bosBull = ta.crossover(close, lastPHi) and isDispBull
bool bosBear = ta.crossunder(close, lastPLo) and isDispBear
bool mssBull = ta.crossover(close, lastPHi) and isDispBull and not na(prevPLo) and low[1] < prevPLo
bool mssBear = ta.crossunder(close, lastPLo) and isDispBear and not na(prevPHi) and high[1] > prevPHi

// --- Sequence Tracking: persistent bar timestamps for Sweep → MSS → FVG ordering ---
var int lastMssBullBar = na
var int lastMssBearBar = na
var float lastMssBullDispStrength = na
var float lastMssBearDispStrength = na

if mssBull
    lastMssBullBar := bar_index
    lastMssBullDispStrength := math.abs(close - open) / atr
if mssBear
    lastMssBearBar := bar_index
    lastMssBearDispStrength := math.abs(close - open) / atr

// Expire stale MSS (same age logic as sweeps)
int mssMaxAge = sensitivityMode == "Aggressive" ? 50 : sensitivityMode == "Conservative" ? 120 : 80
if not na(lastMssBullBar) and (bar_index - lastMssBullBar) > mssMaxAge
    lastMssBullBar := na
    lastMssBullDispStrength := na
if not na(lastMssBearBar) and (bar_index - lastMssBearBar) > mssMaxAge
    lastMssBearBar := na
    lastMssBearDispStrength := na

// --- SMC Elements (FVG & OB) ---
var SmartZone[] fvgArray = array.new<SmartZone>()
var SmartZone[] obArray = array.new<SmartZone>()

// =====================================================================
// FVG ENGINE — Clean-room reimplementation of Lux-style detection behavior
// Original behavioral reference: Fair Value Gap [LuxAlgo] (CC BY-NC-SA 4.0)
// This is an independent reimplementation adapted to this indicator's
// SmartZone architecture, scoring pipeline, and setup lifecycle.
// =====================================================================

// FVG detection function — evaluated in source timeframe context via request.security.
// Returns: [bullDetected, bearDetected, zoneTop, zoneBot, sourceTimestamp]
//
// Detection rules (clean-room reimplementation of Lux-style behavior):
//   Bullish: low > high[2]  AND  close[1] > high[2]  AND  gapRatio > threshold
//   Bearish: high < low[2]  AND  close[1] < low[2]   AND  gapRatio > threshold
//
// Threshold modes:
//   Auto:   cumulative average of (range / low) across all bars — adapts to instrument & TF
//   Manual: user-supplied percentage converted to ratio
detect_fvg() =>
    // Threshold: adaptive cumulative average, or manual percentage
    float thresh = fvgAutoThreshold ? ta.cum((high - low) / low) / bar_index : fvgThresholdPct / 100.0

    // Bullish FVG: 3-candle upward imbalance with close commitment
    //   candle[0].low above candle[2].high = price gap up
    //   candle[1].close above candle[2].high = middle candle confirms bullish intent
    //   gap ratio = (gap size) / (reference price) must exceed threshold
    bool bull = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > thresh

    // Bearish FVG: mirror — 3-candle downward imbalance
    //   candle[0].high below candle[2].low = price gap down
    //   candle[1].close below candle[2].low = middle candle confirms bearish intent
    bool bear = high < low[2] and close[1] < low[2] and (low[2] - high) / high > thresh

    // Zone bounds (absolute price levels, TF-native)
    float zTop = bull ? low : bear ? low[2] : na
    float zBot = bull ? high[2] : bear ? high : na

    // Source-bar timestamp for MTF deduplication
    int zTime = time

    [bull, bear, zTop, zBot, zTime]

// Execute detection via request.security for optional MTF support.
// When fvgTimeframe is "" (default), evaluates on the chart timeframe.
// No lookahead — only confirmed source-bar data is used.
[fvgBullRaw, fvgBearRaw, fvgTopRaw, fvgBotRaw, fvgSourceTime] = request.security(syminfo.tickerid, fvgTimeframe, detect_fvg())

// MTF deduplication: one FVG registration per source-timeframe detection event.
// When using a higher TF, the same detection fires on every chart bar until the
// next HTF bar closes. The timestamp check prevents repeated insertions.
var int lastFvgRegisteredTime = 0
bool bullFVG = fvgBullRaw and fvgSourceTime != lastFvgRegisteredTime
bool bearFVG = fvgBearRaw and fvgSourceTime != lastFvgRegisteredTime

if bullFVG or bearFVG
    lastFvgRegisteredTime := fvgSourceTime

// Gap size from returned zone bounds (works for both local and MTF detection)
float fvgGapSize = not na(fvgTopRaw) and not na(fvgBotRaw) ? fvgTopRaw - fvgBotRaw : 0.0
float maxFvgSize = atr * 3.0

// Quality grading (for confluence scoring, not detection filtering)
// Grading uses chart-TF displacement and ATR — a large HTF gap relative to
// chart ATR naturally scores higher, which is the correct behavior.
// Grade A: strong displacement on middle candle + large gap (> 0.5 ATR)
bool bullFVG_A = bullFVG and isDispBull[1] and fvgGapSize > atr * 0.5 and fvgGapSize < maxFvgSize
bool bearFVG_A = bearFVG and isDispBear[1] and fvgGapSize > atr * 0.5 and fvgGapSize < maxFvgSize
// Grade B: displacement OR moderate gap (> 0.3 ATR), not already Grade A
bool bullFVG_B = bullFVG and (isDispBull[1] or fvgGapSize > atr * 0.3) and not bullFVG_A and fvgGapSize < maxFvgSize
bool bearFVG_B = bearFVG and (isDispBear[1] or fvgGapSize > atr * 0.3) and not bearFVG_A and fvgGapSize < maxFvgSize
// Grade C: basic valid FVG (passed Lux-style threshold + close confirmation)
bool bullFVG_C = bullFVG and not bullFVG_A and not bullFVG_B
bool bearFVG_C = bearFVG and not bearFVG_A and not bearFVG_B

// Bias-aligned variants for strategy triggers (Silver Bullet etc.)
bool bullFvgAligned = bullFVG and (marketBias != "Bearish")
bool bearFvgAligned = bearFVG and (marketBias != "Bullish")

// --- FVG Tracking State ---
// Persistent tracking for sequence validation (Sweep → MSS → FVG) and mitigation
var int   lastBullFvgBar = na
var int   lastBearFvgBar = na
var int   lastBullFvgGrade = 0
var int   lastBearFvgGrade = 0
var float lastBullFvgTop = na
var float lastBullFvgBot = na
var float lastBearFvgTop = na
var float lastBearFvgBot = na
var bool  lastBullFvgMitigated = false
var bool  lastBearFvgMitigated = false

if bullFVG
    lastBullFvgBar := bar_index
    lastBullFvgGrade := bullFVG_A ? 3 : bullFVG_B ? 2 : 1
    lastBullFvgTop := fvgTopRaw
    lastBullFvgBot := fvgBotRaw
    lastBullFvgMitigated := false
if bearFVG
    lastBearFvgBar := bar_index
    lastBearFvgGrade := bearFVG_A ? 3 : bearFVG_B ? 2 : 1
    lastBearFvgTop := fvgTopRaw
    lastBearFvgBot := fvgBotRaw
    lastBearFvgMitigated := false

// --- FVG Lifecycle: Close-Based Mitigation ---
// Bull FVG mitigated when close moves below its lower boundary (bottom of gap)
// Bear FVG mitigated when close moves above its upper boundary (top of gap)
// This is close-based, not wick-based — consistent with the reference behavior.
if not na(lastBullFvgBar) and not lastBullFvgMitigated and close < lastBullFvgBot
    lastBullFvgMitigated := true
if not na(lastBearFvgBar) and not lastBearFvgMitigated and close > lastBearFvgTop
    lastBearFvgMitigated := true

// --- FVG Expiry ---
int fvgMaxAge = sensitivityMode == "Aggressive" ? 40 : sensitivityMode == "Conservative" ? 100 : 60
if not na(lastBullFvgBar) and (bar_index - lastBullFvgBar) > fvgMaxAge
    lastBullFvgBar := na
    lastBullFvgGrade := 0
    lastBullFvgMitigated := false
if not na(lastBearFvgBar) and (bar_index - lastBearFvgBar) > fvgMaxAge
    lastBearFvgBar := na
    lastBearFvgGrade := 0
    lastBearFvgMitigated := false

// Returns: 0 = no overlap, 1 = merge (expand existing), 2 = near-duplicate (skip)
check_fvg_overlap(SmartZone[] arr, float newTop, float newBottom, bool newIsBull) =>
    int result = 0
    int mergeIdx = -1
    float newSize = newTop - newBottom
    if array.size(arr) > 0 and newSize > 0
        int startIdx = math.max(0, array.size(arr) - 8)
        for i = array.size(arr) - 1 to startIdx
            SmartZone existing = array.get(arr, i)
            if existing.isBull == newIsBull and not existing.mitigated
                float exSize = existing.top - existing.bottom
                if exSize > 0
                    float overlapTop = math.min(existing.top, newTop)
                    float overlapBot = math.max(existing.bottom, newBottom)
                    if overlapTop > overlapBot
                        float overlapSize = overlapTop - overlapBot
                        float smallerZone = math.min(exSize, newSize)
                        float overlapPct = overlapSize / smallerZone
                        if overlapPct > 0.8
                            result := 2
                            break
                        else if overlapPct > 0.3
                            result := 1
                            mergeIdx := i
                            break
    [result, mergeIdx]


// Merge: expand existing zone to encompass both
merge_fvg(SmartZone[] arr, int idx, float newTop, float newBottom, color bgCol) =>
    SmartZone existing = array.get(arr, idx)
    float mergedTop = math.max(existing.top, newTop)
    float mergedBot = math.min(existing.bottom, newBottom)
    existing.top := mergedTop
    existing.bottom := mergedBot
    existing.ce := (mergedTop + mergedBot) / 2.0
    box.set_top(existing.boxId, mergedTop)
    box.set_bottom(existing.boxId, mergedBot)
    box.set_border_width(existing.boxId, 2)
    box.set_bgcolor(existing.boxId, color.new(bgCol, 75))



// FVG Visual Rendering — uses zone bounds from the detection engine (fvgTopRaw/fvgBotRaw)
// so that MTF-detected FVGs render at the correct price levels.
// Overlap merge logic is preserved: same-direction nearby FVGs are merged to reduce clutter.
if showFVG
    if bullFVG
        float fvgTop = fvgTopRaw
        float fvgBot = fvgBotRaw
        [overlapResult, mergeIdx] = check_fvg_overlap(fvgArray, fvgTop, fvgBot, true)
        if overlapResult == 0
            float fvgCE = (fvgTop + fvgBot) / 2.0
            box b = box.new(bar_index - 2, fvgTop, bar_index + fvgExtendBars, fvgBot, bgcolor = bullFvgColor, border_color = color.new(bullFvgColor, 50), border_style = line.style_dotted)
            array.push(fvgArray, SmartZone.new(b, fvgTop, fvgBot, true, false, false, bar_index - 2, fvgCE, false, false, 0, fvgGapSize))
        else if overlapResult == 1
            merge_fvg(fvgArray, mergeIdx, fvgTop, fvgBot, bullFvgColor)

    if bearFVG
        float fvgTop = fvgTopRaw
        float fvgBot = fvgBotRaw
        [overlapResult, mergeIdx] = check_fvg_overlap(fvgArray, fvgTop, fvgBot, false)
        if overlapResult == 0
            float fvgCE = (fvgTop + fvgBot) / 2.0
            box b = box.new(bar_index - 2, fvgTop, bar_index + fvgExtendBars, fvgBot, bgcolor = bearFvgColor, border_color = color.new(bearFvgColor, 50), border_style = line.style_dotted)
            array.push(fvgArray, SmartZone.new(b, fvgTop, fvgBot, false, false, false, bar_index - 2, fvgCE, false, false, 0, fvgGapSize))
        else if overlapResult == 1
            merge_fvg(fvgArray, mergeIdx, fvgTop, fvgBot, bearFvgColor)



// OB Detection (Last opposite candle before MSS)
if showOB
    if mssBull
        int obBar = na
        for i = 1 to 20
            if close[i] < open[i]
                obBar := bar_index - i
                break
        if not na(obBar)
            float t = high[bar_index - obBar]
            float b_ = low[bar_index - obBar]
            box bx = box.new(obBar, t, bar_index, b_, bgcolor = bullObColor, border_color = color.new(bullObColor, 50))
            array.push(obArray, SmartZone.new(bx, t, b_, true, false, false, obBar, na, false, false, 0, na))

    if mssBear
        int obBar = na
        for i = 1 to 20
            if close[i] > open[i]
                obBar := bar_index - i
                break
        if not na(obBar)
            float t = high[bar_index - obBar]
            float b_ = low[bar_index - obBar]
            box bx = box.new(obBar, t, bar_index, b_, bgcolor = bearObColor, border_color = color.new(bearObColor, 50))
            array.push(obArray, SmartZone.new(bx, t, b_, false, false, false, obBar, na, false, false, 0, na))

// Mitigation & Inversion Logic (LuxAlgo-inspired: close-based mitigation for FVGs)
update_zones(SmartZone[] arr, int maxCount, bool isFVG) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            SmartZone sz = array.get(arr, i)
            if not sz.mitigated
                box.set_right(sz.boxId, bar_index)

                bool justMitigated = false

                if not sz.isInverted
                    if sz.isBull
                        // Track CE touch (price enters the FVG)
                        if isFVG and not na(sz.ce) and low <= sz.ce and not sz.ceRespected
                            sz.ceRespected := true
                            sz.touchCount += 1
                        // Check for inversion: close fully through bottom
                        if isFVG and showIFVG and close < sz.bottom
                            sz.isInverted := true
                            box.set_bgcolor(sz.boxId, bearIfvgColor)
                            box.set_border_style(sz.boxId, line.style_solid)
                        // FVG mitigation: CLOSE below bottom (LuxAlgo style — not just wick touch)
                        // OB mitigation: wick touch (unchanged — OBs are demand/supply zones)
                        else if isFVG and close < sz.bottom
                            justMitigated := true
                        else if not isFVG and low < sz.bottom
                            justMitigated := true
                    else
                        // Track CE touch
                        if isFVG and not na(sz.ce) and high >= sz.ce and not sz.ceRespected
                            sz.ceRespected := true
                            sz.touchCount += 1
                        // Check for inversion: close fully through top
                        if isFVG and showIFVG and close > sz.top
                            sz.isInverted := true
                            box.set_bgcolor(sz.boxId, bullIfvgColor)
                            box.set_border_style(sz.boxId, line.style_solid)
                        // FVG mitigation: CLOSE above top (LuxAlgo style)
                        else if isFVG and close > sz.top
                            justMitigated := true
                        else if not isFVG and high > sz.top
                            justMitigated := true
                else
                    // Mitigation for Inverted Zones (close-based for FVGs, touch for OBs)
                    if sz.isBull // Was originally Bullish, now Bearish IFVG (Resistance)
                        if (isFVG and close > sz.top) or (not isFVG and high > sz.top)
                            justMitigated := true
                    else // Was originally Bearish, now Bullish IFVG (Support)
                        if (isFVG and close < sz.bottom) or (not isFVG and low < sz.bottom)
                            justMitigated := true

                // On mitigation: delete the box entirely (no ghost lines)
                if justMitigated
                    sz.mitigated := true
                    box.delete(sz.boxId)

        if array.size(arr) > maxCount
            SmartZone old = array.shift(arr)
            box.delete(old.boxId)

update_zones(fvgArray, maxZones, true)
update_zones(obArray, maxZones, false)

// =====================================================================
// --- LIQUIDITY ENGINE v2 — Hierarchical Detection, Classification & Scoring ---
// =====================================================================

// --- Internal vs External Pivot Classification ---
// External: defines the active dealing range boundary (outermost swings)
// Internal: intermediate pullback pivots within the range
float rangeHigh50 = ta.highest(high, 50)
float rangeLow50  = ta.lowest(low, 50)
float rangeSpan   = rangeHigh50 - rangeLow50
float extThreshold = rangeSpan * 0.15  // Within 15% of range boundary = external

bool pivotHiIsExternal = not na(lastPHi) and (lastPHi > rangeHigh50 - extThreshold)
bool pivotLoIsExternal = not na(lastPLo) and (lastPLo < rangeLow50 + extThreshold)

// Previous pivot (for inducement detection)
bool prevPivotHiIsInternal = not na(prevPHi) and not (prevPHi > rangeHigh50 - extThreshold)
bool prevPivotLoIsInternal = not na(prevPLo) and not (prevPLo < rangeLow50 + extThreshold)

// --- Equal Highs / Equal Lows Detection ---
// Tracks recent swing highs/lows, scores clusters by recency/touches/context,
// and prefers local structure unless an older structural cluster is materially better.
float eqhTolerance = atr * 0.15
int eqPivotStore = math.max(eqLocalLookback, eqStructuralLookback)

var float[] recentSwingHighs = array.new_float()
var float[] recentSwingLows  = array.new_float()
var int[]   recentSwingHighBars = array.new_int()
var int[]   recentSwingLowBars  = array.new_int()

if not na(pHi)
    array.push(recentSwingHighs, pHi)
    array.push(recentSwingHighBars, bar_index - sensRightLen)
    if array.size(recentSwingHighs) > eqPivotStore
        array.shift(recentSwingHighs)
        array.shift(recentSwingHighBars)

if not na(pLo)
    array.push(recentSwingLows, pLo)
    array.push(recentSwingLowBars, bar_index - sensRightLen)
    if array.size(recentSwingLows) > eqPivotStore
        array.shift(recentSwingLows)
        array.shift(recentSwingLowBars)

level_is_near(float lhs, float rhs, float tol) =>
    not na(lhs) and not na(rhs) and math.abs(lhs - rhs) <= tol

cluster_context_bonus(float price_, bool isSSL_) =>
    float bonus = 0.0
    float tol = eqhTolerance * 1.5
    if isSSL_
        if level_is_near(price_, pdl, tol)
            bonus += 5.0
        if level_is_near(price_, pwl, tol)
            bonus += 6.0
        if level_is_near(price_, htfPivot1Low, tol)
            bonus += 3.0
        if level_is_near(price_, htfPivot2Low, tol)
            bonus += 4.0
        if level_is_near(price_, htfPivot3Low, tol)
            bonus += 5.0
        if level_is_near(price_, asia.lastLow, tol) or level_is_near(price_, london.lastLow, tol) or level_is_near(price_, ny.lastLow, tol)
            bonus += 3.0
        if level_is_near(price_, rangeLow50, tol * 2.0)
            bonus += 4.0
    else
        if level_is_near(price_, pdh, tol)
            bonus += 5.0
        if level_is_near(price_, pwh, tol)
            bonus += 6.0
        if level_is_near(price_, htfPivot1High, tol)
            bonus += 3.0
        if level_is_near(price_, htfPivot2High, tol)
            bonus += 4.0
        if level_is_near(price_, htfPivot3High, tol)
            bonus += 5.0
        if level_is_near(price_, asia.lastHigh, tol) or level_is_near(price_, london.lastHigh, tol) or level_is_near(price_, ny.lastHigh, tol)
            bonus += 3.0
        if level_is_near(price_, rangeHigh50, tol * 2.0)
            bonus += 4.0
    bonus

find_eq_cluster(float[] priceArr, int[] barArr, int lookbackN, bool isSSL_) =>
    float bestPrice = na
    int bestCount = 0
    int bestLastBar = na
    float bestScore = 0.0
    int available = array.size(priceArr)
    if available >= 2
        int startIdx = math.max(0, available - lookbackN)
        int localStartIdx = math.max(0, available - eqLocalLookback)
        for i = available - 1 to startIdx
            float refPrice = array.get(priceArr, i)
            int matchCount = 0
            int localTouches = 0
            float sumPrice = 0.0
            int lastTouchBar = na
            for j = startIdx to available - 1
                float cmpPrice = array.get(priceArr, j)
                int cmpBar = array.get(barArr, j)
                if math.abs(cmpPrice - refPrice) <= eqhTolerance
                    matchCount += 1
                    sumPrice += cmpPrice
                    if j >= localStartIdx
                        localTouches += 1
                    lastTouchBar := na(lastTouchBar) ? cmpBar : math.max(lastTouchBar, cmpBar)
            if matchCount >= 2 and not na(lastTouchBar)
                int ageBars = bar_index - lastTouchBar
                if ageBars <= eqClusterMaxAge
                    float avgPrice = sumPrice / matchCount
                    float recencyScore = math.max(0.0, 1.0 - float(ageBars) / eqClusterMaxAge)
                    float distAtr = atr > 0 ? math.abs(avgPrice - close) / atr : 0.0
                    float score = matchCount * 16.0 + localTouches * 5.0 + recencyScore * 20.0 + cluster_context_bonus(avgPrice, isSSL_) - math.min(math.max(distAtr - 6.0, 0.0) * 1.5, 12.0)
                    if score > bestScore or (score == bestScore and (na(bestLastBar) or lastTouchBar > bestLastBar))
                        bestPrice := avgPrice
                        bestCount := matchCount
                        bestLastBar := lastTouchBar
                        bestScore := score
    [bestPrice, bestCount, bestLastBar, bestScore]

select_cluster(float localPrice, int localCount, int localBar, float localScore, float structuralPrice, int structuralCount, int structuralBar, float structuralScore) =>
    float chosenPrice = na
    int chosenCount = 0
    int chosenBar = na
    float chosenScore = 0.0
    if not na(localPrice) or not na(structuralPrice)
        bool useStructural = false
        if na(localPrice)
            useStructural := true
        else if not na(structuralPrice)
            useStructural := structuralScore > localScore + 4.0 or (structuralCount > localCount and structuralScore >= localScore)
        chosenPrice := useStructural ? structuralPrice : localPrice
        chosenCount := useStructural ? structuralCount : localCount
        chosenBar := useStructural ? structuralBar : localBar
        chosenScore := useStructural ? structuralScore : localScore
    [chosenPrice, chosenCount, chosenBar, chosenScore]

cluster_priority_from_score(int clusterCount_, int lastTouchBar_, float clusterScore_) =>
    int pri = PRI_EQH_EQL
    if clusterCount_ >= 3
        pri += 4
    if clusterCount_ >= 4
        pri += 4
    if clusterScore_ >= 60
        pri += 4
    if clusterScore_ >= 75
        pri += 4
    if not na(lastTouchBar_)
        int ageBars = bar_index - lastTouchBar_
        if ageBars > math.round(eqClusterMaxAge * 0.6)
            pri -= 12
        else if ageBars > math.round(eqClusterMaxAge * 0.35)
            pri -= 6
    math.max(42, math.min(84, pri))

[eqhLocalLevel, eqhLocalCount, eqhLocalBar, eqhLocalScore] = find_eq_cluster(recentSwingHighs, recentSwingHighBars, eqLocalLookback, false)

[eqhStructLevel, eqhStructCount, eqhStructBar, eqhStructScore] = find_eq_cluster(recentSwingHighs, recentSwingHighBars, eqStructuralLookback, false)

[eqhLevel, eqhCount, eqhLastBar, eqhScore] = select_cluster(eqhLocalLevel, eqhLocalCount, eqhLocalBar, eqhLocalScore, eqhStructLevel, eqhStructCount, eqhStructBar, eqhStructScore)
int eqhPriority = not na(eqhLevel) ? cluster_priority_from_score(eqhCount, eqhLastBar, eqhScore) : PRI_EQH_EQL

[eqlLocalLevel, eqlLocalCount, eqlLocalBar, eqlLocalScore] = find_eq_cluster(recentSwingLows, recentSwingLowBars, eqLocalLookback, true)

[eqlStructLevel, eqlStructCount, eqlStructBar, eqlStructScore] = find_eq_cluster(recentSwingLows, recentSwingLowBars, eqStructuralLookback, true)

[eqlLevel, eqlCount, eqlLastBar, eqlScore] = select_cluster(eqlLocalLevel, eqlLocalCount, eqlLocalBar, eqlLocalScore, eqlStructLevel, eqlStructCount, eqlStructBar, eqlStructScore)
int eqlPriority = not na(eqlLevel) ? cluster_priority_from_score(eqlCount, eqlLastBar, eqlScore) : PRI_EQH_EQL

// --- Build Liquidity Level Registry ---
// Constructs LiqLevel objects for all monitored sources each bar
var LiqLevel[] liqLevels = array.new<LiqLevel>()
array.clear(liqLevels)

is_htf_liquidity_source(int srcType) =>
    srcType == SRC_PDH_PDL or srcType == SRC_PWH_PWL or srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3

source_category_label(int srcType, string lvlName) =>
    string label = "Liquidity"
    if srcType == SRC_PWH_PWL
        label := "Weekly Level"
    else if srcType == SRC_PDH_PDL
        label := "Daily Level"
    else if srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3
        label := "HTF Pivot"
    else if srcType == SRC_SESSION
        label := "Session Level"
    else if srcType == SRC_EQH_EQL
        label := "EQ Cluster"
    else if srcType == SRC_ROUND_NUM
        label := "Round Number"
    else if srcType == SRC_PIVOT_EXT
        label := "External Pivot"
    else if srcType == SRC_PIVOT_INT
        label := "Internal Pivot"
    if (srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3) and lvlName != ""
        label := label + " (" + lvlName + ")"
    label

source_phase_tag(int srcType, bool isExt) =>
    string tag = isExt ? " [Ext]" : " [Int]"
    if srcType == SRC_PWH_PWL
        tag := " [W]"
    else if srcType == SRC_PDH_PDL
        tag := " [D]"
    else if srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3
        tag := " [HTF Pivot]"
    else if srcType == SRC_EQH_EQL
        tag := " [EQ]"
    else if srcType == SRC_SESSION
        tag := " [Sess]"
    else if srcType == SRC_ROUND_NUM
        tag := " [RN]"
    tag

round_grid_base(float price_, float step_) =>
    step_ > 0 ? math.floor(price_ / step_) * step_ : na

float roundMainBase = enableRoundNumbers and roundStep > 0 ? round_grid_base(close, roundStep) : na
float roundMainBelow = roundMainBase
float roundMainAbove = not na(roundMainBase) ? roundMainBase + roundStep : na
bool hasRoundSubStep = enableRoundNumbers and roundSubStep > 0 and roundSubStep < roundStep
float roundSubBase = hasRoundSubStep ? round_grid_base(close, roundSubStep) : na
float roundSubBelow = roundSubBase
float roundSubAbove = not na(roundSubBase) ? roundSubBase + roundSubStep : na

// Helper: add level if valid
add_liq_level(LiqLevel[] arr, string name_, float price_, int srcType, int pri, bool ext, bool ssl, bool htf, bool sess, bool cluster, int clusterN) =>
    if not na(price_)
        array.push(arr, LiqLevel.new(name_, price_, srcType, pri, ext, ssl, htf, sess, cluster, clusterN, bar_index))

// Session levels (only completed sessions — no developing)
add_liq_level(liqLevels, "Asia High",   asia.isActive ? na : asia.lastHigh,     SRC_SESSION, PRI_SESSION, true, false, false, true, false, 0)
add_liq_level(liqLevels, "Asia Low",    asia.isActive ? na : asia.lastLow,      SRC_SESSION, PRI_SESSION, true, true,  false, true, false, 0)
add_liq_level(liqLevels, "London High", london.isActive ? na : london.lastHigh, SRC_SESSION, PRI_SESSION + 5, true, false, false, true, false, 0)
add_liq_level(liqLevels, "London Low",  london.isActive ? na : london.lastLow,  SRC_SESSION, PRI_SESSION + 5, true, true,  false, true, false, 0)
add_liq_level(liqLevels, "NY High",     ny.isActive ? na : ny.lastHigh,         SRC_SESSION, PRI_SESSION + 10, true, false, false, true, false, 0)
add_liq_level(liqLevels, "NY Low",      ny.isActive ? na : ny.lastLow,          SRC_SESSION, PRI_SESSION + 10, true, true,  false, true, false, 0)

// HTF levels
add_liq_level(liqLevels, "PDH", pdh, SRC_PDH_PDL, PRI_PDH_PDL, true, false, true, false, false, 0)
add_liq_level(liqLevels, "PDL", pdl, SRC_PDH_PDL, PRI_PDH_PDL, true, true,  true, false, false, 0)
add_liq_level(liqLevels, "PWH", pwh, SRC_PWH_PWL, PRI_PWH_PWL, true, false, true, false, false, 0)
add_liq_level(liqLevels, "PWL", pwl, SRC_PWH_PWL, PRI_PWH_PWL, true, true,  true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf1 + " High", htfPivot1High, SRC_PIVOT_HTF_1, PRI_PIVOT_HTF_1, true, false, true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf1 + " Low", htfPivot1Low, SRC_PIVOT_HTF_1, PRI_PIVOT_HTF_1, true, true,  true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf2 + " High", htfPivot2High, SRC_PIVOT_HTF_2, PRI_PIVOT_HTF_2, true, false, true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf2 + " Low", htfPivot2Low, SRC_PIVOT_HTF_2, PRI_PIVOT_HTF_2, true, true,  true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf3 + " High", enableHtfPivot3 ? htfPivot3High : na, SRC_PIVOT_HTF_3, PRI_PIVOT_HTF_3, true, false, true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf3 + " Low", enableHtfPivot3 ? htfPivot3Low : na, SRC_PIVOT_HTF_3, PRI_PIVOT_HTF_3, true, true,  true, false, false, 0)

// Structural pivots (classified by internal/external)
add_liq_level(liqLevels, "Pivot High", lastPHi, pivotHiIsExternal ? SRC_PIVOT_EXT : SRC_PIVOT_INT, pivotHiIsExternal ? PRI_PIVOT_EXT : PRI_PIVOT_INT, pivotHiIsExternal, false, false, false, false, 0)
add_liq_level(liqLevels, "Pivot Low",  lastPLo, pivotLoIsExternal ? SRC_PIVOT_EXT : SRC_PIVOT_INT, pivotLoIsExternal ? PRI_PIVOT_EXT : PRI_PIVOT_INT, pivotLoIsExternal, true,  false, false, false, 0)

// Equal highs/lows clusters
add_liq_level(liqLevels, "EQH", eqhLevel, SRC_EQH_EQL, eqhPriority, true, false, false, false, true, eqhCount)
add_liq_level(liqLevels, "EQL", eqlLevel, SRC_EQH_EQL, eqlPriority, true, true,  false, false, true, eqlCount)

// Optional psychological levels
add_liq_level(liqLevels, "RN " + str.tostring(roundMainAbove, "#.#####"), enableRoundNumbers ? roundMainAbove : na, SRC_ROUND_NUM, PRI_ROUND_NUM, false, false, false, false, false, 0)
add_liq_level(liqLevels, "RN " + str.tostring(roundMainBelow, "#.#####"), enableRoundNumbers ? roundMainBelow : na, SRC_ROUND_NUM, PRI_ROUND_NUM, false, true,  false, false, false, 0)
add_liq_level(liqLevels, "RN sub " + str.tostring(roundSubAbove, "#.#####"), hasRoundSubStep ? roundSubAbove : na, SRC_ROUND_NUM, PRI_ROUND_NUM - 5, false, false, false, false, false, 0)
add_liq_level(liqLevels, "RN sub " + str.tostring(roundSubBelow, "#.#####"), hasRoundSubStep ? roundSubBelow : na, SRC_ROUND_NUM, PRI_ROUND_NUM - 5, false, true,  false, false, false, 0)

// --- Session Timing Weight ---
// Returns multiplier for sweep significance based on when it happens
get_session_weight() =>
    float w = 1.0
    if overlap.isActive
        w := 1.3
    else if ny.isActive
        w := 1.2
    else if london.isActive
        w := 1.15
    else if asia.isActive
        w := 0.85
    else
        w := 0.7   // Inter-session dead time
    w

float sessionWeight = get_session_weight()

// --- Sweep Detection Engine v2 ---
var LiqSweep[] activeSweeps = array.new<LiqSweep>()
int sweepMaxAge = sensitivityMode == "Aggressive" ? 30 : sensitivityMode == "Conservative" ? 70 : 50
int sweepMaxCount = 8

// Classify sweep type based on metrics and source
classify_sweep_type(float depthAtr, bool isExt, bool isHTF_, bool isSess, bool isCluster_, int srcType) =>
    int sType = SWEEP_SHALLOW
    string sStr = "Shallow"
    if isHTF_
        sType := SWEEP_HTF
        sStr := "HTF Sweep"
    else if isExt and depthAtr > 0.3
        sType := SWEEP_EXT_LIQ_GRAB
        sStr := "Ext. Liq Grab"
    else if isSess
        sType := SWEEP_SESSION
        sStr := "Session Sweep"
    else if not isExt
        sType := SWEEP_INT_LIQ_SWEEP
        sStr := "Internal Sweep"
    // Override by depth
    if depthAtr > 1.5
        sType := SWEEP_DEEP_STOP_RUN
        sStr := "Deep Stop Run"
    else if depthAtr > 0.2 and depthAtr <= 1.5 and sType == SWEEP_SHALLOW
        sType := SWEEP_CLEAN_RAID
        sStr := "Clean Raid"
    [sType, sStr]

// Compute multi-dimensional quality score
compute_sweep_quality(float depthAtr, float wickPenRatio, float rejStr, bool hasRej, bool hasDisp, int srcPri, bool isExt, bool isHTF_, bool isCluster_, int clusterN, bool inKz, bool inSb, float sessW, float freshness, int sweepT) =>
    float q = 0.0
    // 1. Penetration quality (max 20)
    q += math.min(depthAtr * 15.0, 20.0)
    // 2. Rejection strength (max 20)
    if hasRej
        q += 10.0 + rejStr * 10.0
    // 3. Displacement follow-through (max 15)
    if hasDisp
        q += 15.0
    // 4. Source priority (max 15) — normalized from 0-100 priority to 0-15
    q += (srcPri / 100.0) * 15.0
    // 5. External vs internal multiplier
    if isExt
        q *= 1.15
    else
        q *= 0.85
    // 6. HTF bonus (max 8)
    if isHTF_
        q += 8.0
    // 7. Session timing (max 5)
    q += (sessW - 0.7) * 8.33   // Maps 0.7-1.3 → 0-5
    // 8. Cluster liquidity bonus (max 8)
    if isCluster_
        q += 4.0 + math.min(clusterN - 2, 3) * 1.33
    // 9. Freshness (max 10)
    q += freshness * 10.0
    // 10. Kill zone / Silver Bullet bonus
    if inSb
        q += 5.0
    else if inKz
        q += 3.0
    // 11. Deep stop-run penalty (overextended = risky)
    if sweepT == SWEEP_DEEP_STOP_RUN
        q -= 5.0
    // 12. Weak wick penetration penalty
    if wickPenRatio < 0.1 and not hasDisp
        q -= 5.0
    math.max(0.0, math.min(100.0, q))

// Grade from score
get_sweep_grade(float q) =>
    string g = q >= 70.0 ? "A" : q >= 45.0 ? "B" : q >= 25.0 ? "C" : "Reject"
    g

// Check sweep against a LiqLevel
check_sweep_level(LiqLevel lvl) =>
    LiqSweep result = na
    if not na(lvl) and not na(lvl.price)
        bool isSSL_ = lvl.isSSL
        float level = lvl.price
        bool swept = false
        float depth = 0.0

        if isSSL_ and level < close[1] and low <= level and close > level
            depth := level - low
            swept := true
        else if not isSSL_ and level > close[1] and high >= level and close < level
            depth := high - level
            swept := true

        if swept and depth > 0
            float depthAtr = depth / atr
            float rng = high - low
            float wickPen = rng > 0 ? depth / rng : 0.0
            // Rejection: body reclaim ratio — how much of the range is body closing back
            float bodyRatio = rng > 0 ? bodySize / rng : 0.0
            bool rejection = isSSL_ ? close > open : close < open
            float rejStr = rejection ? bodyRatio : 0.0
            bool disp = isSSL_ ? isDispBull : isDispBear

            [sType, sStr] = classify_sweep_type(depthAtr, lvl.isExternal, lvl.isHTF, lvl.isSession, lvl.isCluster, lvl.sourceType)
            float freshness = 1.0
            float q = compute_sweep_quality(depthAtr, wickPen, rejStr, rejection, disp, lvl.priority, lvl.isExternal, lvl.isHTF, lvl.isCluster, lvl.clusterCount, isKillzone, isSilverBullet, sessionWeight, freshness, sType)
            string grade = get_sweep_grade(q)

            result := LiqSweep.new(
                 lvl.name, level, lvl.sourceType, lvl.priority,
                 lvl.isExternal, isSSL_,
                 depth, depthAtr, wickPen, rejStr, rejection, disp,
                 sType, sStr, grade, q,
                 bar_index, LIFE_DETECTED, grade != "Reject", false,
                 lvl.isHTF, lvl.isSession, lvl.isCluster, lvl.clusterCount, false,
                 isKillzone, isSilverBullet, activeSessName)
    result

// --- Run sweep checks against all registered levels ---
if array.size(liqLevels) > 0
    for i = 0 to array.size(liqLevels) - 1
        LiqLevel lvl = array.get(liqLevels, i)
        LiqSweep sw = check_sweep_level(lvl)
        if not na(sw) and sw.isActionable
            // --- Advanced Deduplication ---
            // Check for near-duplicate: same side, similar price, recent
            bool duplicate = false
            int replaceIdx = -1
            if array.size(activeSweeps) > 0
                for j = array.size(activeSweeps) - 1 to math.max(0, array.size(activeSweeps) - 8)
                    LiqSweep existing = array.get(activeSweeps, j)
                    bool sameSide = existing.isSSL == sw.isSSL
                    bool sameName = existing.levelName == sw.levelName
                    bool nearPrice = math.abs(existing.levelPrice - sw.levelPrice) < atr * 0.3
                    bool recentBar = (bar_index - existing.sweepBar) < 5
                    if sameSide and (sameName or nearPrice) and recentBar
                        duplicate := true
                        // Replace if new sweep is stronger
                        if sw.qualityScore > existing.qualityScore
                            replaceIdx := j
                        break
            if not duplicate
                // Lifecycle: promote to ACTIVE if rejection or displacement present
                if sw.hasRejection or sw.hasDisplacement
                    sw.lifecycleState := LIFE_CONFIRMED
                else
                    sw.lifecycleState := LIFE_ACTIVE
                array.push(activeSweeps, sw)
            else if replaceIdx >= 0
                // Stronger sweep replaces weaker on same level
                LiqSweep old = array.get(activeSweeps, replaceIdx)
                sw.lifecycleState := old.lifecycleState == LIFE_CONFIRMED ? LIFE_CONFIRMED : (sw.hasRejection or sw.hasDisplacement ? LIFE_CONFIRMED : LIFE_ACTIVE)
                array.set(activeSweeps, replaceIdx, sw)

// --- Inducement Detection (deterministic only) ---
// Tag a smaller internal sweep only after a larger same-side external/HTF/session event
// is actually taken shortly after it. This keeps inducement as metadata, not prophecy.
if enableInducementTag and array.size(activeSweeps) > 1
    int inducementWindow = sensitivityMode == "Aggressive" ? 6 : sensitivityMode == "Conservative" ? 10 : 8
    for i = 0 to array.size(activeSweeps) - 1
        LiqSweep major = array.get(activeSweeps, i)
        bool majorSweep = (major.isExternal or is_htf_liquidity_source(major.sourceType) or major.sourceType == SRC_SESSION) and major.qualityScore >= 40
        if majorSweep
            for j = 0 to array.size(activeSweeps) - 1
                if i != j
                    LiqSweep minor = array.get(activeSweeps, j)
                    bool sameSide = minor.isSSL == major.isSSL
                    bool minorInternal = minor.sourceType == SRC_PIVOT_INT or (not minor.isExternal and minor.sourcePriority < major.sourcePriority)
                    bool shortLead = minor.sweepBar <= major.sweepBar and (major.sweepBar - minor.sweepBar) <= inducementWindow
                    bool lowerSig = minor.qualityScore < major.qualityScore and minor.sourcePriority < major.sourcePriority
                    if sameSide and minorInternal and shortLead and lowerSig and not minor.isInducementLike
                        minor.isInducementLike := true
                        minor.sweepType := SWEEP_INDUCEMENT
                        minor.sweepTypeStr := "Inducement"
                        minor.qualityScore := math.max(0.0, minor.qualityScore - 8.0)
                        minor.grade := get_sweep_grade(minor.qualityScore)
                        array.set(activeSweeps, j, minor)

// --- Lifecycle Management ---
// Expire stale sweeps, cap count, manage states
if array.size(activeSweeps) > 0
    for i = array.size(activeSweeps) - 1 to 0
        LiqSweep s = array.get(activeSweeps, i)
        int age = bar_index - s.sweepBar
        // Stale detection
        if age > sweepMaxAge
            array.remove(activeSweeps, i)
            continue
        // Degrade lifecycle as sweep ages
        if age > math.round(sweepMaxAge * 0.7) and s.lifecycleState == LIFE_ACTIVE
            s.lifecycleState := LIFE_STALE
            s.isActionable := false
        // Recalculate quality with updated freshness
        float freshness = 1.0 - (float(age) / sweepMaxAge)
        float updatedQ = compute_sweep_quality(s.sweepDepthAtr, s.wickPenetrationRatio, s.rejectionStrength, s.hasRejection, s.hasDisplacement, s.sourcePriority, s.isExternal, s.isHTF, s.isClusterSweep, s.clusterCount, s.inKillzone, s.inSilverBullet, 1.0, freshness, s.sweepType)
        s.qualityScore := updatedQ
        s.grade := get_sweep_grade(updatedQ)
        if updatedQ < 15.0
            s.isActionable := false
        array.set(activeSweeps, i, s)

// Cap sweep count — keep best by quality
while array.size(activeSweeps) > sweepMaxCount
    // Find and remove lowest quality
    int worstIdx = 0
    float worstQ = 999.0
    for i = 0 to array.size(activeSweeps) - 1
        LiqSweep s = array.get(activeSweeps, i)
        if s.qualityScore < worstQ
            worstQ := s.qualityScore
            worstIdx := i
    array.remove(activeSweeps, worstIdx)

// --- Consume sweeps on MSS (lifecycle transition) ---
if mssBull
    if array.size(activeSweeps) > 0
        for i = array.size(activeSweeps) - 1 to 0
            LiqSweep s = array.get(activeSweeps, i)
            if s.isSSL and s.lifecycleState != LIFE_CONSUMED
                s.lifecycleState := LIFE_CONSUMED
                s.isConsumed := true
                array.set(activeSweeps, i, s)
if mssBear
    if array.size(activeSweeps) > 0
        for i = array.size(activeSweeps) - 1 to 0
            LiqSweep s = array.get(activeSweeps, i)
            if not s.isSSL and s.lifecycleState != LIFE_CONSUMED
                s.lifecycleState := LIFE_CONSUMED
                s.isConsumed := true
                array.set(activeSweeps, i, s)

// --- Derived Sweep State (backwards-compatible + enriched) ---
bool sweptSSL = false
bool sweptBSL = false
float sweepQualitySSL = 0.0
float sweepQualityBSL = 0.0
int bestSweepBarSSL = na
int bestSweepBarBSL = na
// Enriched: best sweep metadata per side
string bestSweepTypeSSL = ""
string bestSweepGradeSSL = ""
string bestSweepNameSSL = ""
bool   bestSweepExtSSL = false
int    bestSweepSrcSSL = 0
bool   bestSweepInducementSSL = false
string bestSweepTypeBSL = ""
string bestSweepGradeBSL = ""
string bestSweepNameBSL = ""
bool   bestSweepExtBSL = false
int    bestSweepSrcBSL = 0
bool   bestSweepInducementBSL = false

if array.size(activeSweeps) > 0
    for i = 0 to array.size(activeSweeps) - 1
        LiqSweep s = array.get(activeSweeps, i)
        if not s.isActionable and not s.isConsumed
            continue
        if s.isSSL
            sweptSSL := true
            if s.qualityScore > sweepQualitySSL
                sweepQualitySSL := s.qualityScore
                bestSweepBarSSL := s.sweepBar
                bestSweepTypeSSL := s.sweepTypeStr
                bestSweepGradeSSL := s.grade
                bestSweepNameSSL := s.levelName
                bestSweepExtSSL := s.isExternal
                bestSweepSrcSSL := s.sourceType
                bestSweepInducementSSL := s.isInducementLike
        else
            sweptBSL := true
            if s.qualityScore > sweepQualityBSL
                sweepQualityBSL := s.qualityScore
                bestSweepBarBSL := s.sweepBar
                bestSweepTypeBSL := s.sweepTypeStr
                bestSweepGradeBSL := s.grade
                bestSweepNameBSL := s.levelName
                bestSweepExtBSL := s.isExternal
                bestSweepSrcBSL := s.sourceType
                bestSweepInducementBSL := s.isInducementLike

// Premium / Discount
int rangeLookback = 50
float pdArray = (ta.highest(rangeLookback) + ta.lowest(rangeLookback)) / 2
string pdStatus = close > pdArray ? "Premium" : "Discount"

// --- Enriched Liquidity Level Map ---
// Nearest levels by category: internal, external, session, HTF, cluster
float nearestBSL = na
float nearestSSL = na
float nearestExtBSL = na
float nearestExtSSL = na
float nearestIntBSL = na
float nearestIntSSL = na
float nearestSessBSL = na
float nearestSessSSL = na
float nearestHTFBSL = na
float nearestHTFSSL = na
float nearestClusterBSL = na
float nearestClusterSSL = na
float nearestRoundBSL = na
float nearestRoundSSL = na
// Source names for dashboard
string nearestBSLName = ""
string nearestSSLName = ""

if array.size(liqLevels) > 0
    for i = 0 to array.size(liqLevels) - 1
        LiqLevel lvl = array.get(liqLevels, i)
        if na(lvl.price)
            continue
        if lvl.isSSL and lvl.price < close
            // SSL: nearest = highest below price
            if na(nearestSSL) or lvl.price > nearestSSL
                nearestSSL := lvl.price
                nearestSSLName := lvl.name
            if lvl.isExternal and (na(nearestExtSSL) or lvl.price > nearestExtSSL)
                nearestExtSSL := lvl.price
            if not lvl.isExternal and (na(nearestIntSSL) or lvl.price > nearestIntSSL)
                nearestIntSSL := lvl.price
            if lvl.isSession and (na(nearestSessSSL) or lvl.price > nearestSessSSL)
                nearestSessSSL := lvl.price
            if lvl.isHTF and (na(nearestHTFSSL) or lvl.price > nearestHTFSSL)
                nearestHTFSSL := lvl.price
            if lvl.isCluster and (na(nearestClusterSSL) or lvl.price > nearestClusterSSL)
                nearestClusterSSL := lvl.price
            if lvl.sourceType == SRC_ROUND_NUM and (na(nearestRoundSSL) or lvl.price > nearestRoundSSL)
                nearestRoundSSL := lvl.price
        else if not lvl.isSSL and lvl.price > close
            // BSL: nearest = lowest above price
            if na(nearestBSL) or lvl.price < nearestBSL
                nearestBSL := lvl.price
                nearestBSLName := lvl.name
            if lvl.isExternal and (na(nearestExtBSL) or lvl.price < nearestExtBSL)
                nearestExtBSL := lvl.price
            if not lvl.isExternal and (na(nearestIntBSL) or lvl.price < nearestIntBSL)
                nearestIntBSL := lvl.price
            if lvl.isSession and (na(nearestSessBSL) or lvl.price < nearestSessBSL)
                nearestSessBSL := lvl.price
            if lvl.isHTF and (na(nearestHTFBSL) or lvl.price < nearestHTFBSL)
                nearestHTFBSL := lvl.price
            if lvl.isCluster and (na(nearestClusterBSL) or lvl.price < nearestClusterBSL)
                nearestClusterBSL := lvl.price
            if lvl.sourceType == SRC_ROUND_NUM and (na(nearestRoundBSL) or lvl.price < nearestRoundBSL)
                nearestRoundBSL := lvl.price

// reqL/reqS: backward-compatible required sweep levels
float reqL = nearestSSL
float reqS = nearestBSL

ict_liquidity_gate(bool isLong, int mssBar_, float mssDisp) =>
    bool ok = false
    bool hasValidExternal = false
    string detail = "No qualifying liquidity sweep detected"
    float bestQ = -1.0
    bool sawAnySweep = false
    bool sawInternalOnly = false
    bool sawWeakMajor = false
    bool sawOutOfSequence = false
    if array.size(activeSweeps) > 0
        for i = 0 to array.size(activeSweeps) - 1
            LiqSweep s = array.get(activeSweeps, i)
            bool sideOk = s.isSSL == isLong
            bool liveOk = s.isActionable or s.isConsumed
            if sideOk and liveOk
                sawAnySweep := true
                bool orderOk = na(mssBar_) or s.sweepBar <= mssBar_
                bool htfSweep = is_htf_liquidity_source(s.sourceType)
                bool strongSession = s.sourceType == SRC_SESSION and s.qualityScore >= 55.0
                bool strongExternal = s.isExternal and s.sourceType != SRC_SESSION and s.sourceType != SRC_PIVOT_INT and s.qualityScore >= 35.0
                bool aggressiveInternal = sensitivityMode == "Aggressive" and s.sourceType == SRC_PIVOT_INT and s.qualityScore >= 72.0 and mssDisp >= 1.2 and (s.hasRejection or s.hasDisplacement)
                bool hardQualified = htfSweep or strongSession or strongExternal or aggressiveInternal
                if orderOk and (htfSweep or strongSession or strongExternal)
                    hasValidExternal := true
                if not orderOk
                    sawOutOfSequence := true
                else if s.sourceType == SRC_PIVOT_INT and not aggressiveInternal
                    sawInternalOnly := true
                else if not hardQualified
                    sawWeakMajor := true

                if orderOk and hardQualified and s.qualityScore > bestQ
                    ok := true
                    bestQ := s.qualityScore
                    detail := s.levelName + " — " + source_category_label(s.sourceType, "")
                    if s.isInducementLike
                        detail := detail + " (preconditioned by inducement)"
    if not ok
        detail := not sawAnySweep ? "No liquidity sweep detected" : sawOutOfSequence ? "Sweep came after structure shift (wrong sequence)" : sawInternalOnly ? "Only internal liquidity swept — need external" : sawWeakMajor ? "Sweep quality insufficient for this strategy" : detail
    [ok, detail, hasValidExternal]

silver_bullet_liquidity_gate(bool isLong) =>
    bool ok = false
    bool hasValidSessionSweep = false
    string detail = "No qualifying sweep in Silver Bullet window"
    float bestQ = -1.0
    bool sawWindowSweep = false
    bool sawWeakWindowSweep = false
    int sbWindowBars = math.max(1, int(math.round(3600.0 / timeframe.in_seconds(timeframe.period)))) + 1
    if array.size(activeSweeps) > 0
        for i = 0 to array.size(activeSweeps) - 1
            LiqSweep s = array.get(activeSweeps, i)
            bool sideOk = s.isSSL == isLong
            bool liveOk = s.isActionable or s.isConsumed
            bool windowFresh = (bar_index - s.sweepBar) <= sbWindowBars
            if sideOk and liveOk and s.inSilverBullet and windowFresh
                sawWindowSweep := true
                bool validSession = s.sourceType == SRC_SESSION and s.qualityScore >= 42.0
                bool validExternal = (s.isExternal or is_htf_liquidity_source(s.sourceType)) and s.qualityScore >= 35.0
                if validSession
                    hasValidSessionSweep := true
                if (validSession or validExternal) and s.qualityScore > bestQ
                    ok := true
                    bestQ := s.qualityScore
                    detail := s.levelName + " — " + source_category_label(s.sourceType, "")
                else if not (validSession or validExternal)
                    sawWeakWindowSweep := true
    if not ok
        detail := not sawWindowSweep ? "No qualifying liquidity in Silver Bullet window" : sawWeakWindowSweep ? "Silver Bullet window sweep not structural enough" : detail
    [ok, detail, hasValidSessionSweep]

// --- OB Confluence Check: is price near an unmitigated OB? ---
bool obBullConfluence = false
bool obBearConfluence = false
if array.size(obArray) > 0
    for i = 0 to array.size(obArray) - 1
        SmartZone ob = array.get(obArray, i)
        if not ob.mitigated
            if ob.isBull and low <= ob.top and close >= ob.bottom
                obBullConfluence := true
            if not ob.isBull and high >= ob.bottom and close <= ob.top
                obBearConfluence := true

// --- Setup Readiness Evaluation ---
SetupState liveSetup = SetupState.new()

// Evaluate one side (long or short) with quality-weighted, sequence-aware scoring
// Enhanced: uses enriched sweep metadata (source type, external/internal, sweep type)
// Returns [score, phase, missing, sweepGrade, mssGrade, fvgGrade, sequenceOk, triggerLvl, expired, degraded]
eval_side(bool isLong, string bias, string pd, bool kz, bool sb, bool swept, float sweepQ, int sweepBar_, string sweepGradeIn, bool sweepIsExt, int sweepSrcType, int mssBar_, float mssDisp, int fvgBar_, int fvgGrade_, bool fvgMitigated, bool obConf, float pivotVal, float reqLevel, float atrVal, string sessName, int sweepMaxAge_, int mssMaxAge_, int fvgMaxAge_) =>
    float sc = 0.0
    string ph = "Scanning"
    string ms = ""
    string swG = ""
    string msG = ""
    string fgG = ""
    bool seqOk = false
    float trig = na
    bool expired = false
    bool degraded = false

    // --- Context Score (max 18) ---
    string alignedPD = isLong ? "Discount" : "Premium"
    bool biasAligned = (isLong and bias == "Bullish") or (not isLong and bias == "Bearish")
    bool biasCounter = (isLong and bias == "Bearish") or (not isLong and bias == "Bullish")

    if biasAligned
        sc += 5.0
    else if biasCounter
        sc -= 3.0

    if pd == alignedPD
        sc += 5.0
    else if pd != alignedPD and pd != ""
        sc -= 2.0

    // Timing — Silver Bullet > Killzone > No session (max 5)
    if sb
        sc += 5.0
    else if kz
        sc += 3.0

    bool isLondon = str.contains(sessName, "London") and not str.contains(sessName, "Overlap")
    bool isNY = str.contains(sessName, "New York") or str.contains(sessName, "Overlap")

    // --- Sweep Score (max 30) — enriched with source/type awareness ---
    if swept
        // Base sweep score from quality (0-100 → 10-25)
        float sweepScore = 10.0 + math.min(sweepQ, 100.0) * 0.15
        sc += sweepScore
        swG := sweepGradeIn

        // Liquidity source bonuses (v2 enrichment)
        // External liquidity sweep: +3 for reversal setups
        if sweepIsExt
            sc += 3.0
        // HTF level sweep: +2
        if sweepSrcType == SRC_PWH_PWL or sweepSrcType == SRC_PDH_PDL
            sc += 2.0
        // Cluster (EQH/EQL) sweep: +2
        if sweepSrcType == SRC_EQH_EQL
            sc += 2.0
        // Internal-only sweep penalty for reversal context (needs external for conviction)
        if not sweepIsExt and sweepSrcType == SRC_PIVOT_INT
            sc -= 3.0

        string srcLabel = source_phase_tag(sweepSrcType, sweepIsExt)
        ph := "Liquidity swept"

        // Sweep staleness penalty
        if not na(sweepBar_)
            float sweepAge = bar_index - sweepBar_
            float sweepLifeRatio = sweepAge / sweepMaxAge_
            if sweepLifeRatio > 0.7
                sc -= 5.0
                ph := ph + " ⌛"

        // --- MSS Score (max 25) — quality + sequence ---
        if not na(mssBar_)
            bool mssAfterSweep = not na(sweepBar_) and mssBar_ >= sweepBar_
            if mssAfterSweep
                float mssScore = 10.0
                if mssDisp > 1.5
                    mssScore := 25.0
                    msG := "A"
                else if mssDisp > 0.8
                    mssScore := 18.0
                    msG := "B"
                else
                    mssScore := 12.0
                    msG := "C"
                sc += mssScore
                ph := "Structure confirmed"

                float mssAge = bar_index - mssBar_
                float mssLifeRatio = mssAge / mssMaxAge_
                if mssLifeRatio > 0.6
                    sc -= 4.0
                    ph := ph + " ⌛"

                if mssLifeRatio > 0.85 and (na(fvgBar_) or fvgGrade_ == 0)
                    expired := true
                    ph := "Setup expired"
                    ms := "Structure shift expired without imbalance — setup invalid"

                // --- FVG Score (max 25) — grade + sequence ---
                if not expired and not na(fvgBar_) and fvgGrade_ > 0
                    bool fvgAfterMss = fvgBar_ >= mssBar_
                    if fvgAfterMss
                        if fvgMitigated
                            degraded := true
                            sc -= 10.0
                            ph := "Setup degraded"
                            ms := "Imbalance zone was filled — wait for a fresh one"
                        else
                            seqOk := true
                            float fvgScore = fvgGrade_ == 3 ? 25.0 : fvgGrade_ == 2 ? 18.0 : 12.0
                            fgG := fvgGrade_ == 3 ? "A" : fvgGrade_ == 2 ? "B" : "C"
                            sc += fvgScore
                            ph := "Setup ready"
                            ms := "Full sequence complete — monitor entry zone"

                            float fvgAge = bar_index - fvgBar_
                            if fvgAge / fvgMaxAge_ > 0.7
                                ms := ms + " (imbalance aging)"
                    else
                        ph := "Awaiting imbalance"
                        ms := "Imbalance predates structure shift — need a fresh one"
                else if not expired
                    ph := "Awaiting imbalance"
                    ms := "Need fresh " + (isLong ? "bullish" : "bearish") + " imbalance after structure shift"
            else
                ph := "Awaiting structure shift"
                ms := "Structure shift predates sweep — need new " + (isLong ? "bullish" : "bearish") + " confirmation"
                trig := pivotVal
        else
            ph := "Awaiting structure shift"
            trig := pivotVal
            ms := "Need " + (isLong ? "bullish" : "bearish") + " structure shift" + (na(pivotVal) ? "" : " — break " + (isLong ? "above " : "below ") + str.tostring(pivotVal, "#.#####"))
    else
        // No sweep yet — ATR-based proximity check
        if not na(reqLevel) and not na(atrVal)
            float proximity = math.abs(close - reqLevel) / atrVal
            if proximity < 0.5
                ph := "Liquidity imminent"
                sc += 3.0
                ms := (isLong ? "Sell-side" : "Buy-side") + " liquidity at " + str.tostring(reqLevel, "#.#####") + " — very close (" + str.tostring(proximity, "#.#") + " ATR)"
            else if proximity < 1.5
                ph := "Liquidity nearby"
                sc += 1.0
                ms := (isLong ? "Sell-side" : "Buy-side") + " liquidity at " + str.tostring(reqLevel, "#.#####") + " (" + str.tostring(proximity, "#.#") + " ATR away)"
            else if proximity < 3.0
                ph := "Approaching liquidity"
                ms := (isLong ? "Sell-side" : "Buy-side") + " liquidity at " + str.tostring(reqLevel, "#.#####") + " (" + str.tostring(proximity, "#.#") + " ATR away)"
            else
                ms := "Searching for " + (isLong ? "sell-side" : "buy-side") + " liquidity to sweep"
        else
            ms := "No liquidity levels identified"

    // --- Confluence Bonus (max 18) ---
    if obConf and seqOk
        sc += 5.0
        ms := ms + " (order block confluence)"

    // Full sequence + quality bonus
    if seqOk and sweepQ >= 40 and not na(mssDisp) and mssDisp > 0.8 and fvgGrade_ >= 2
        sc += 5.0

    // External + HTF sweep with valid sequence: premium confluence
    if seqOk and sweepIsExt and (sweepSrcType == SRC_PWH_PWL or sweepSrcType == SRC_PDH_PDL)
        sc += 3.0

    // Session alignment (max 3)
    if isLondon and swept
        sc += 2.0
    else if isNY and seqOk
        sc += 3.0
    else if isLondon or isNY
        sc += 1.0

    // Clamp score to 0-100
    int finalScore = math.max(0, math.min(100, math.round(sc)))
    [finalScore, ph, ms, swG, msG, fgG, seqOk, trig, expired, degraded]

// --- Run dual-side evaluation ---
[scoreLong, phaseLong, missingLong, swGradeL, msGradeL, fgGradeL, seqOkL, trigL, expiredL, degradedL] = eval_side(true, marketBias, pdStatus, isKillzone, isSilverBullet, sweptSSL, sweepQualitySSL, bestSweepBarSSL, bestSweepGradeSSL, bestSweepExtSSL, bestSweepSrcSSL, lastMssBullBar, lastMssBullDispStrength, lastBullFvgBar, lastBullFvgGrade, lastBullFvgMitigated, obBullConfluence, lastPHi, reqL, atr, activeSessName, sweepMaxAge, mssMaxAge, fvgMaxAge)
[scoreShort, phaseShort, missingShort, swGradeS, msGradeS, fgGradeS, seqOkS, trigS, expiredS, degradedS] = eval_side(false, marketBias, pdStatus, isKillzone, isSilverBullet, sweptBSL, sweepQualityBSL, bestSweepBarBSL, bestSweepGradeBSL, bestSweepExtBSL, bestSweepSrcBSL, lastMssBearBar, lastMssBearDispStrength, lastBearFvgBar, lastBearFvgGrade, lastBearFvgMitigated, obBearConfluence, lastPLo, reqS, atr, activeSessName, sweepMaxAge, mssMaxAge, fvgMaxAge)

// --- Select dominant side and populate SetupState ---
// Bias acts as tiebreaker multiplier, not gate
float biasMultLong = marketBias == "Bullish" ? 1.15 : marketBias == "Bearish" ? 0.85 : 1.0
float biasMultShort = marketBias == "Bearish" ? 1.15 : marketBias == "Bullish" ? 0.85 : 1.0
float adjScoreLong = scoreLong * biasMultLong
float adjScoreShort = scoreShort * biasMultShort

// Phase 5: Conflicted — both sides have strong valid sequences simultaneously
bool isConflicted = seqOkL and seqOkS and math.abs(adjScoreLong - adjScoreShort) < 15

bool pickLong = adjScoreLong >= adjScoreShort

liveSetup := SetupState.new()
liveSetup.nearestBSL := nearestBSL
liveSetup.nearestSSL := nearestSSL
liveSetup.scoreLong := scoreLong
liveSetup.scoreShort := scoreShort
liveSetup.phaseLong := phaseLong
liveSetup.phaseShort := phaseShort
liveSetup.missingLong := missingLong
liveSetup.missingShort := missingShort

// Dominant side drives the legacy fields for backwards compatibility
liveSetup.score := pickLong ? scoreLong : scoreShort
liveSetup.isPotentialLong := pickLong
liveSetup.isPotentialShort := not pickLong
liveSetup.requiredSweep := pickLong ? reqL : reqS
liveSetup.triggerLevel := pickLong ? trigL : trigS
liveSetup.sequenceValid := pickLong ? seqOkL : seqOkS
liveSetup.sweepGrade := pickLong ? swGradeL : swGradeS
liveSetup.mssGrade := pickLong ? msGradeL : msGradeS
liveSetup.fvgGrade := pickLong ? fgGradeL : fgGradeS
liveSetup.hasOBConfluence := pickLong ? obBullConfluence : obBearConfluence
liveSetup.isExpired := pickLong ? expiredL : expiredS
liveSetup.isDegraded := pickLong ? degradedL : degradedS
liveSetup.isConflicted := isConflicted

// Phase 5: Lifecycle overrides
// Expired/Degraded phases are already set by eval_side — just assign dominant side
liveSetup.phase := pickLong ? phaseLong : phaseShort
liveSetup.missing := pickLong ? missingLong : missingShort

// Conflicted overrides everything — both sides have valid armed sequences
if isConflicted
    liveSetup.phase := "Market conflicted"
    liveSetup.missing := "Both long (" + str.tostring(scoreLong) + ") and short (" + str.tostring(scoreShort) + ") setups active — no clear edge, stand aside"
    liveSetup.score := math.max(scoreLong, scoreShort)

// --- Strategy Detection ---
[ictGateLong, ictGateLongInfo, ictHasValidExternalLong] = ict_liquidity_gate(true, lastMssBullBar, lastMssBullDispStrength)

[ictGateShort, ictGateShortInfo, ictHasValidExternalShort] = ict_liquidity_gate(false, lastMssBearBar, lastMssBearDispStrength)

[sbGateLong, sbGateLongInfo, sbHasSessionSweepLong] = silver_bullet_liquidity_gate(true)

[sbGateShort, sbGateShortInfo, sbHasSessionSweepShort] = silver_bullet_liquidity_gate(false)

bool continuationLiquidityLong = sweptSSL and (bestSweepSrcSSL == SRC_PIVOT_INT or bestSweepExtSSL or bestSweepSrcSSL == SRC_EQH_EQL or bestSweepSrcSSL == SRC_ROUND_NUM or is_htf_liquidity_source(bestSweepSrcSSL))
bool continuationLiquidityShort = sweptBSL and (bestSweepSrcBSL == SRC_PIVOT_INT or bestSweepExtBSL or bestSweepSrcBSL == SRC_EQH_EQL or bestSweepSrcBSL == SRC_ROUND_NUM or is_htf_liquidity_source(bestSweepSrcBSL))

bool sig2022B = mssBull and ictGateLong and enableICT2022
bool sig2022S = mssBear and ictGateShort and enableICT2022
bool inSB = sbLon.isActive or sbAm.isActive
bool sigSBB = inSB and bullFvgAligned and sbGateLong and enableSilverBullet
bool sigSBS = inSB and bearFvgAligned and sbGateShort and enableSilverBullet

if pickLong and enableICT2022 and mssBull and not ictGateLong
    liveSetup.missing := "ICT 2022 blocked: " + ictGateLongInfo
else if not pickLong and enableICT2022 and mssBear and not ictGateShort
    liveSetup.missing := "ICT 2022 blocked: " + ictGateShortInfo
else if pickLong and enableSilverBullet and inSB and bullFvgAligned and not sbGateLong
    liveSetup.missing := "Silver Bullet blocked: " + sbGateLongInfo
else if not pickLong and enableSilverBullet and inSB and bearFvgAligned and not sbGateShort
    liveSetup.missing := "Silver Bullet blocked: " + sbGateShortInfo

bool dominantLiquidityBlocked = pickLong ? ((enableICT2022 and mssBull and not ictGateLong) or (enableSilverBullet and inSB and bullFvgAligned and not sbGateLong)) : ((enableICT2022 and mssBear and not ictGateShort) or (enableSilverBullet and inSB and bearFvgAligned and not sbGateShort))


// --- Alert History Engine ---
var AlertLog[] alertLogs = array.new<AlertLog>()
if (sig2022B or sigSBB or sig2022S or sigSBS)
    string sig = (sig2022B or sigSBB) ? "BUY" : "SELL"
    color c = (sig2022B or sigSBB) ? uiPosColor : uiNegColor
    array.unshift(alertLogs, AlertLog.new(str.format_time(time, "HH:mm", NY_TZ), sig, close, c))
    if array.size(alertLogs) > maxAlertRows
        array.pop(alertLogs)

// --- Trade Management ---
var Stats mainStats = Stats.new()
var Trade activeTrade = na
var box[] historicalBoxes = array.new_box()

method update_stats(Stats s, float rEarned, bool isWin) =>
    s.totalTrades += 1
    s.totalR += rEarned
    s.equityR += rEarned
    if isWin
        s.wins += 1
    else
        s.losses += 1
    s.peakEquityR := math.max(s.peakEquityR, s.equityR)
    s.maxDrawdownR := math.min(s.maxDrawdownR, s.equityR - s.peakEquityR)

bool isSignalB = sig2022B or sigSBB
bool isSignalS = sig2022S or sigSBS

if (isSignalB or isSignalS) and na(activeTrade)
    float sl = isSignalB ? low[1] - (atr * 0.5) : high[1] + (atr * 0.5)
    float risk = math.abs(close - sl)
    float tp1 = isSignalB ? close + risk * 1.0 : close - risk * 1.0
    float tp2 = isSignalB ? close + risk * 2.0 : close - risk * 2.0
    box tpB = na
    box slB = na
    if showSetups and showZones
        color tpCol = isSignalB ? longTpColor : shortTpColor
        color slCol = isSignalB ? longSlColor : shortSlColor
        tpB := box.new(bar_index, isSignalB ? tp2 : close, bar_index, isSignalB ? close : tp2, bgcolor = color.new(tpCol, activeTransp), border_color = tpCol, border_width = activeBorderWidth)
        slB := box.new(bar_index, isSignalB ? close : sl, bar_index, isSignalB ? sl : close, bgcolor = color.new(slCol, activeTransp), border_color = slCol, border_width = activeBorderWidth)
    activeTrade := Trade.new(sig2022B or sig2022S ? "ICT 2022" : "SB", isSignalB, close, sl, tp1, tp2, bar_index, true, false, tpB, slB)

if not na(activeTrade)
    bool closed = false
    float r = 0.0
    string outcome = ""
    string sz = markerSizeInput == "Tiny" ? size.tiny : markerSizeInput == "Small" ? size.small : size.normal

    if not na(activeTrade.tpBox)
        box.set_right(activeTrade.tpBox, bar_index + (extendCandidateRight ? activeMinWidth : 0))
        box.set_right(activeTrade.slBox, bar_index + (extendCandidateRight ? activeMinWidth : 0))

    if activeTrade.isLong
        if low <= activeTrade.stopPrice
            r := activeTrade.isTp1Hit ? 0.0 : -1.0
            closed := true
            outcome := r == 0 ? "BE" : "SL"
            if showSlMarkers
                label.new(bar_index, activeTrade.stopPrice, outcome, color = slMarkerColor, textcolor = color.white, style = label.style_label_up, size = sz)
        else if high >= activeTrade.tp2Price
            r := 2.0
            closed := true
            outcome := "TP2"
            if showTpMarkers
                label.new(bar_index, activeTrade.tp2Price, "TP2", color = tpMarkerColor, textcolor = color.white, style = label.style_label_down, size = sz)
        else if high >= activeTrade.tp1Price and not activeTrade.isTp1Hit
            activeTrade.isTp1Hit := true
            if showTpMarkers
                label.new(bar_index, activeTrade.tp1Price, "TP1", color = tpMarkerColor, textcolor = color.white, style = label.style_label_down, size = sz)
    else
        if high >= activeTrade.stopPrice
            r := activeTrade.isTp1Hit ? 0.0 : -1.0
            closed := true
            outcome := r == 0 ? "BE" : "SL"
            if showSlMarkers
                label.new(bar_index, activeTrade.stopPrice, outcome, color = slMarkerColor, textcolor = color.white, style = label.style_label_down, size = sz)
        else if low <= activeTrade.tp2Price
            r := 2.0
            closed := true
            outcome := "TP2"
            if showTpMarkers
                label.new(bar_index, activeTrade.tp2Price, "TP2", color = tpMarkerColor, textcolor = color.white, style = label.style_label_up, size = sz)
        else if low <= activeTrade.tp1Price and not activeTrade.isTp1Hit
            activeTrade.isTp1Hit := true
            if showTpMarkers
                label.new(bar_index, activeTrade.tp1Price, "TP1", color = tpMarkerColor, textcolor = color.white, style = label.style_label_up, size = sz)

    if closed
        mainStats.update_stats(r, r > 0)
        box.set_right(activeTrade.tpBox, bar_index)
        box.set_right(activeTrade.slBox, bar_index)
        box.set_border_width(activeTrade.tpBox, 1)
        box.set_border_width(activeTrade.slBox, 1)
        array.push(historicalBoxes, activeTrade.tpBox)
        array.push(historicalBoxes, activeTrade.slBox)
        if array.size(historicalBoxes) > maxHistory * 2
            box.delete(array.shift(historicalBoxes))
            box.delete(array.shift(historicalBoxes))
        activeTrade := na

// --- Level Rendering ---
render_level(float val, bool show, color col, string txt, string mode, int segLen, int offset, string styleStr, int width, bool showLabel) =>
    var line l = na
    var label lbl = na
    style = styleStr == "Solid" ? line.style_solid : styleStr == "Dashed" ? line.style_dashed : line.style_dotted

    if show and not na(val)
        x1 = mode == "Full Width" ? bar_index - 500 : bar_index - segLen + offset
        x2 = bar_index + offset
        if na(l)
            l := line.new(x1, val, x2, val, color = col, style = style, width = width)
            if showLabel
                lbl := label.new(x2, val, txt, color = #00000000, textcolor = col, style = label.style_label_left, size = size.small)
        else
            line.set_xy1(l, x1, val)
            line.set_xy2(l, x2, val)
            line.set_color(l, col)
            line.set_style(l, style)
            line.set_width(l, width)
            if showLabel
                if na(lbl)
                    lbl := label.new(x2, val, txt, color = #00000000, textcolor = col, style = label.style_label_left, size = size.small)
                else
                    label.set_xy(lbl, x2, val)
                    label.set_text(lbl, txt)
                    label.set_textcolor(lbl, col)
            else if not na(lbl)
                label.delete(lbl)
                lbl := na
    else
        if not na(l)
            line.delete(l)
            l := na
        if not na(lbl)
            label.delete(lbl)
            lbl := na
    [l, lbl]

bool eqhSwept = false
bool eqlSwept = false
if array.size(activeSweeps) > 0
    for i = 0 to array.size(activeSweeps) - 1
        LiqSweep s = array.get(activeSweeps, i)
        if s.sourceType == SRC_EQH_EQL
            if s.isSSL
                eqlSwept := true
            else
                eqhSwept := true

if barstate.islast
    render_level(pdh, showPDH, pdhColor, "PDH", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)
    render_level(pdl, showPDL, pdlColor, "PDL", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)
    render_level(pwh, showPWH, pwhColor, "PWH", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)
    render_level(pwl, showPWL, pwlColor, "PWL", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)

    render_level(asia.lastHigh, showAsiaH, asiaHColor, "Asia High", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(asia.lastLow, showAsiaL, asiaLColor, "Asia Low", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(london.lastHigh, showLonH, lonHColor, "London High", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(london.lastLow, showLonL, lonLColor, "London Low", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(ny.isActive ? ny.high : ny.lastHigh, showNYH, nyHColor, "NY High", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(ny.isActive ? ny.low : ny.lastLow, showNYL, nyLColor, "NY Low", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)

    int eqhTransp = eqhSwept ? 80 : math.max(18, 62 - math.round(eqhScore * 0.4))
    int eqlTransp = eqlSwept ? 80 : math.max(18, 62 - math.round(eqlScore * 0.4))
    int eqhWidth = eqhScore >= 68 ? 2 : 1
    int eqlWidth = eqlScore >= 68 ? 2 : 1
    string eqhText = "EQH" + (eqhCount >= 2 ? "×" + str.tostring(eqhCount) : "") + (eqhSwept ? " ✓" : "")
    string eqlText = "EQL" + (eqlCount >= 2 ? "×" + str.tostring(eqlCount) : "") + (eqlSwept ? " ✓" : "")
    render_level(eqhLevel, showEqClusters and eqhCount >= 2, color.new(eqhColor, eqhTransp), eqhText, "Short Segment", eqClusterSegLen, eqClusterOffset, "Dotted", eqhWidth, eqClusterShowLabels)
    render_level(eqlLevel, showEqClusters and eqlCount >= 2, color.new(eqlColor, eqlTransp), eqlText, "Short Segment", eqClusterSegLen, eqClusterOffset, "Dotted", eqlWidth, eqClusterShowLabels)

// --- Helper: resolve table position ---
resolve_pos(string pos) =>
    pos == "top_right" ? position.top_right : pos == "top_left" ? position.top_left : pos == "bottom_right" ? position.bottom_right : position.bottom_left

// --- Dashboard Helper Functions ---

format_grade_word(string grade) =>
    grade == "A" ? "high quality" : grade == "B" ? "moderate quality" : grade == "C" ? "low quality" : "—"

format_confidence(int score) =>
    score >= 85 ? "High conviction" : score >= 70 ? "Strong" : score >= 50 ? "Good" : score >= 30 ? "Moderate" : "Low"

format_score_bias(int sL, int sS) =>
    int diff = sL - sS
    math.abs(diff) < 5 ? "Neutral" : diff >= 20 ? "Strong long bias" : diff >= 10 ? "Long bias" : diff > 0 ? "Slight long bias" : diff <= -20 ? "Strong short bias" : diff <= -10 ? "Short bias" : "Slight short bias"

format_action(string phase, bool isConflicted, bool isExpired, bool isDegraded, bool seqValid, int score, bool isLong, bool gateBlocked, bool hasActiveTrade) =>
    string a = "Stand aside — no setup forming"
    if hasActiveTrade
        a := "Trade active — manage position"
    else if isConflicted
        a := "Stand aside — both sides active, no clear edge"
    else if isExpired
        a := "No trade — setup expired"
    else if isDegraded
        a := "No trade — imbalance was filled"
    else if gateBlocked
        a := "Setup blocked — check strategy eligibility"
    else if seqValid and score >= 60
        a := (isLong ? "Bullish" : "Bearish") + " setup ready — monitor entry zone"
    else if str.contains(phase, "Awaiting imbalance")
        a := "Wait for fresh " + (isLong ? "bullish" : "bearish") + " imbalance"
    else if str.contains(phase, "Structure confirmed")
        a := "Wait for " + (isLong ? "bullish" : "bearish") + " imbalance after structure shift"
    else if str.contains(phase, "Awaiting structure shift")
        a := "Wait for " + (isLong ? "bullish" : "bearish") + " structure confirmation"
    else if str.contains(phase, "Liquidity swept")
        a := "Wait for " + (isLong ? "bullish" : "bearish") + " structure shift"
    else if str.contains(phase, "imminent")
        a := "Approaching key liquidity — prepare for sweep"
    else if str.contains(phase, "nearby") or str.contains(phase, "Approaching")
        a := "Monitoring — approaching key liquidity"
    else if score >= 15
        a := "Monitoring — setup developing"
    a

// =====================================================================
// --- DASHBOARD 1: Trading Assistant ---
// =====================================================================
var table readTable = na
if barstate.islast
    if not na(readTable)
        table.delete(readTable)
    readTable := na
if showReadiness and barstate.islast
    bool isTrader = dashMode == "Trader"
    bool isAnalyst = dashMode == "Analyst"
    bool isDebug = dashMode == "Debug"
    bool showContext = isAnalyst or isDebug
    bool showAdvanced = isDebug

    int maxR = isDebug ? 38 : isAnalyst ? 26 : 16
    readTable := table.new(resolve_pos(readinessPos), 2, maxR, bgcolor = uiBg, border_width = 1, border_color = uiBorder)

    float wr = mainStats.totalTrades > 0 ? (float(mainStats.wins) / mainStats.totalTrades) * 100 : 0

    // --- Derived display values ---
    // Direction
    string dirStr = liveSetup.isConflicted ? "◆ BOTH" : liveSetup.isPotentialLong ? "▲ LONG" : "▼ SHORT"
    color dirColor = liveSetup.isConflicted ? color.yellow : liveSetup.isPotentialLong ? uiPosColor : uiNegColor

    // Setup state color
    color phaseColor = liveSetup.isConflicted ? color.yellow : liveSetup.isExpired ? color.gray : liveSetup.isDegraded ? color.orange : str.contains(liveSetup.phase, "Setup ready") ? uiPosColor : str.contains(liveSetup.phase, "confirmed") or str.contains(liveSetup.phase, "swept") ? color.orange : liveSetup.score >= 70 ? uiPosColor : liveSetup.score >= 40 ? color.orange : uiNeutralColor

    // Trader action
    string actionStr = format_action(liveSetup.phase, liveSetup.isConflicted, liveSetup.isExpired, liveSetup.isDegraded, liveSetup.sequenceValid, liveSetup.score, liveSetup.isPotentialLong, dominantLiquidityBlocked, not na(activeTrade))
    color actionColor = str.contains(actionStr, "ready") ? uiPosColor : str.contains(actionStr, "No trade") or str.contains(actionStr, "blocked") ? uiNegColor : str.contains(actionStr, "Stand aside") ? uiLabelText : str.contains(actionStr, "Wait") or str.contains(actionStr, "Monitor") ? color.orange : uiNeutralColor

    // Confidence
    string confStr = format_confidence(liveSetup.score)
    color confColor = liveSetup.score >= 70 ? uiPosColor : liveSetup.score >= 50 ? color.orange : liveSetup.score >= 30 ? uiNeutralColor : uiLabelText

    // Session
    string sessStr = activeSessName + (isSilverBullet ? " (Silver Bullet)" : isKillzone ? " (Kill Zone)" : "")
    color sessColor = isSilverBullet ? uiPosColor : isKillzone ? color.orange : uiLabelText

    // Price Location
    color pdColor = pdStatus == "Discount" ? uiPosColor : uiNegColor

    // Score bias
    string biasStr = format_score_bias(liveSetup.scoreLong, liveSetup.scoreShort)

    int r = 0

    // ═══════════════════════════════════════════════════════════════
    // PRIMARY DECISION BLOCK — answers: what side, what state, what to do
    // ═══════════════════════════════════════════════════════════════
    table.cell(readTable, 0, r, "Trading Assistant", text_color = uiHeaderText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, dirStr, text_color = dirColor, text_size = size.small)
    r += 1

    table.cell(readTable, 0, r, "Setup State", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, liveSetup.phase, text_color = phaseColor, text_size = size.small)
    r += 1

    table.cell(readTable, 0, r, "Trader Action", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, actionStr, text_color = actionColor, text_size = size.small, text_halign = text.align_left)
    r += 1

    table.cell(readTable, 0, r, "Next Required", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, liveSetup.missing, text_color = uiNeutralColor, text_size = size.small, text_halign = text.align_left)
    r += 1

    table.cell(readTable, 0, r, "Setup Quality", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, confStr + " (" + str.tostring(liveSetup.score) + ")", text_color = confColor, text_size = size.small)
    r += 1

    table.cell(readTable, 0, r, "Session", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, sessStr, text_color = sessColor, text_size = size.small)
    r += 1

    table.cell(readTable, 0, r, "Price Location", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, pdStatus, text_color = pdColor, text_size = size.small)
    r += 1

    // ═══════════════════════════════════════════════════════════════
    // SETUP CONTEXT BLOCK — explains why the setup looks the way it does
    // (Analyst + Debug modes only)
    // ═══════════════════════════════════════════════════════════════
    if showContext
        table.cell(readTable, 0, r, "─── Setup Context ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, "", bgcolor = uiBg)
        r += 1

        // Liquidity Event
        string liqEventStr = "No meaningful liquidity sweep yet"
        color liqEventCol = uiLabelText
        if liveSetup.isPotentialLong and sweptSSL
            liqEventStr := "Sell-side swept: " + bestSweepNameSSL + " (" + format_grade_word(bestSweepGradeSSL) + ")"
            liqEventCol := bestSweepGradeSSL == "A" ? uiPosColor : bestSweepGradeSSL == "B" ? color.orange : uiLabelText
        else if not liveSetup.isPotentialLong and sweptBSL
            liqEventStr := "Buy-side swept: " + bestSweepNameBSL + " (" + format_grade_word(bestSweepGradeBSL) + ")"
            liqEventCol := bestSweepGradeBSL == "A" ? uiPosColor : bestSweepGradeBSL == "B" ? color.orange : uiLabelText
        table.cell(readTable, 0, r, "Liquidity Event", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, liqEventStr, text_color = liqEventCol, text_size = size.tiny)
        r += 1

        // Structure Status
        string structStr = "No structure shift yet"
        color structCol = uiLabelText
        if liveSetup.mssGrade != ""
            structStr := (liveSetup.isPotentialLong ? "Bullish" : "Bearish") + " shift confirmed (" + format_grade_word(liveSetup.mssGrade) + ")"
            structCol := liveSetup.mssGrade == "A" ? uiPosColor : color.orange
        table.cell(readTable, 0, r, "Structure", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, structStr, text_color = structCol, text_size = size.tiny)
        r += 1

        // Imbalance Status
        string imbStr = "—"
        color imbCol = uiLabelText
        if liveSetup.isDegraded
            imbStr := "Imbalance zone was filled — setup weakened"
            imbCol := uiNegColor
        else if liveSetup.fvgGrade != ""
            imbStr := "Fresh " + (liveSetup.isPotentialLong ? "bullish" : "bearish") + " imbalance present (" + format_grade_word(liveSetup.fvgGrade) + ")"
            imbCol := liveSetup.fvgGrade == "A" ? uiPosColor : color.orange
        else if liveSetup.mssGrade != ""
            imbStr := "No fresh imbalance yet — waiting"
            imbCol := color.orange
        table.cell(readTable, 0, r, "Imbalance", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, imbStr, text_color = imbCol, text_size = size.tiny)
        r += 1

        // OB Confluence
        bool obConf = liveSetup.hasOBConfluence
        string obStr = obConf ? "Order block confluence present" : "No clean OB confluence"
        color obCol = obConf ? uiPosColor : uiLabelText
        table.cell(readTable, 0, r, "OB Confluence", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, obStr, text_color = obCol, text_size = size.tiny)
        r += 1

    // Long / Short Score (all modes, detail varies)
    string scoreStr = str.tostring(liveSetup.scoreLong) + " / " + str.tostring(liveSetup.scoreShort)
    if showContext
        scoreStr := scoreStr + "  ·  " + biasStr
    table.cell(readTable, 0, r, "Long / Short Score", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, scoreStr, text_color = phaseColor, text_size = size.small)
    r += 1

    // Nearest Liquidity (all modes)
    table.cell(readTable, 0, r, "Buy-Side Liquidity", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, (na(nearestBSL) ? "—" : str.tostring(nearestBSL, "#.#####") + " (" + nearestBSLName + ")"), text_color = uiNegColor, text_size = size.small)
    r += 1

    table.cell(readTable, 0, r, "Sell-Side Liquidity", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, (na(nearestSSL) ? "—" : str.tostring(nearestSSL, "#.#####") + " (" + nearestSSLName + ")"), text_color = uiPosColor, text_size = size.small)
    r += 1

    // Strategy Eligibility
    if showContext
        // ICT 2022 — detailed per-side
        string ictLongDetail = "Long: " + (ictGateLong ? "Valid" : "Invalid") + " — " + ictGateLongInfo + (ictHasValidExternalLong ? " [ext]" : "")
        string ictShortDetail = "Short: " + (ictGateShort ? "Valid" : "Invalid") + " — " + ictGateShortInfo + (ictHasValidExternalShort ? " [ext]" : "")
        color ictCol = ictGateLong and ictGateShort ? uiPosColor : (ictGateLong or ictGateShort ? color.orange : uiNegColor)
        table.cell(readTable, 0, r, "ICT 2022 Eligibility", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, ictLongDetail + "  |  " + ictShortDetail, text_color = ictCol, text_size = size.tiny)
        r += 1

        // Silver Bullet — detailed per-side
        string sbLongDetail = "Long: " + (sbGateLong ? "Valid" : "Invalid") + " — " + sbGateLongInfo + (sbHasSessionSweepLong ? " [sess]" : "")
        string sbShortDetail = "Short: " + (sbGateShort ? "Valid" : "Invalid") + " — " + sbGateShortInfo + (sbHasSessionSweepShort ? " [sess]" : "")
        color sbCol = sbGateLong and sbGateShort ? uiPosColor : (sbGateLong or sbGateShort ? color.orange : uiNegColor)
        table.cell(readTable, 0, r, "Silver Bullet Eligibility", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, sbLongDetail + "  |  " + sbShortDetail, text_color = sbCol, text_size = size.tiny)
        r += 1

        // Continuation Context
        string contStr = "Long: " + (continuationLiquidityLong ? "Valid" : "None") + "  |  Short: " + (continuationLiquidityShort ? "Valid" : "None")
        table.cell(readTable, 0, r, "Continuation Context", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, contStr, text_color = continuationLiquidityLong or continuationLiquidityShort ? uiNeutralColor : uiLabelText, text_size = size.tiny)
        r += 1
    else
        // Trader mode — compressed strategy summary
        string ictSummary = ictGateLong and ictGateShort ? "Both eligible" : ictGateLong ? "Long eligible" : ictGateShort ? "Short eligible" : "Not eligible"
        string sbSummary = sbGateLong and sbGateShort ? "Both eligible" : sbGateLong ? "Long eligible" : sbGateShort ? "Short eligible" : "Not eligible"
        string stratStr = "ICT 2022: " + ictSummary + "  |  SB: " + sbSummary
        color stratCol = (ictGateLong or ictGateShort or sbGateLong or sbGateShort) ? uiNeutralColor : uiLabelText
        table.cell(readTable, 0, r, "Strategy Status", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, r, stratStr, text_color = stratCol, text_size = size.small)
        r += 1

    // ═══════════════════════════════════════════════════════════════
    // ADVANCED BLOCK — raw engine diagnostics (Debug mode only)
    // ═══════════════════════════════════════════════════════════════
    if showAdvanced
        table.cell(readTable, 0, r, "─── Advanced ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, "", bgcolor = uiBg)
        r += 1

        // Confluence chain: Sweep(A) → MSS(B) → FVG(A) +OB
        string chainStr = ""
        if liveSetup.sweepGrade != ""
            chainStr := "Sweep(" + liveSetup.sweepGrade + ")"
        if liveSetup.mssGrade != ""
            chainStr := chainStr + " → MSS(" + liveSetup.mssGrade + ")"
        if liveSetup.fvgGrade != ""
            chainStr := chainStr + " → FVG(" + liveSetup.fvgGrade + ")"
        if liveSetup.hasOBConfluence
            chainStr := chainStr + " +OB"
        if liveSetup.isDegraded
            chainStr := chainStr + " ✗MIT"
        if liveSetup.isExpired
            chainStr := chainStr + " ✗EXP"
        if chainStr == ""
            chainStr := "—"
        table.cell(readTable, 0, r, "Confluence Chain", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, chainStr, text_color = phaseColor, text_size = size.tiny)
        r += 1

        // Sequence Status
        string seqStr = liveSetup.isConflicted ? "Conflicted" : liveSetup.isExpired ? "Expired" : liveSetup.isDegraded ? "Degraded" : liveSetup.sequenceValid ? "Valid" : "Incomplete"
        color seqColor = liveSetup.isConflicted ? color.yellow : liveSetup.isExpired ? color.gray : liveSetup.isDegraded ? color.orange : liveSetup.sequenceValid ? uiPosColor : uiNegColor
        table.cell(readTable, 0, r, "Sequence Status", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, seqStr, text_color = seqColor, text_size = size.tiny)
        r += 1

        // Best Sell-Side Sweep
        string sslScope = bestSweepSrcSSL == SRC_ROUND_NUM ? "RN" : ((bestSweepExtSSL or is_htf_liquidity_source(bestSweepSrcSSL)) ? "EXT" : "INT")
        string sslInfo = sweptSSL ? bestSweepNameSSL + " " + bestSweepGradeSSL + " [" + bestSweepTypeSSL + " · " + source_category_label(bestSweepSrcSSL, "") + " · " + sslScope + (bestSweepInducementSSL ? " · IND" : "") + "]" : "None"
        color sslInfoCol = sweptSSL ? (bestSweepGradeSSL == "A" ? uiPosColor : bestSweepGradeSSL == "B" ? color.orange : uiLabelText) : uiLabelText
        table.cell(readTable, 0, r, "Best Sell-Side Sweep", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, sslInfo, text_color = sslInfoCol, text_size = size.tiny)
        r += 1

        // Best Buy-Side Sweep
        string bslScope = bestSweepSrcBSL == SRC_ROUND_NUM ? "RN" : ((bestSweepExtBSL or is_htf_liquidity_source(bestSweepSrcBSL)) ? "EXT" : "INT")
        string bslInfo = sweptBSL ? bestSweepNameBSL + " " + bestSweepGradeBSL + " [" + bestSweepTypeBSL + " · " + source_category_label(bestSweepSrcBSL, "") + " · " + bslScope + (bestSweepInducementBSL ? " · IND" : "") + "]" : "None"
        color bslInfoCol = sweptBSL ? (bestSweepGradeBSL == "A" ? uiPosColor : bestSweepGradeBSL == "B" ? color.orange : uiLabelText) : uiLabelText
        table.cell(readTable, 0, r, "Best Buy-Side Sweep", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, bslInfo, text_color = bslInfoCol, text_size = size.tiny)
        r += 1

        // Sweep Quality
        table.cell(readTable, 0, r, "Sweep Quality", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, "SSL: " + str.tostring(math.round(sweepQualitySSL)) + "  |  BSL: " + str.tostring(math.round(sweepQualityBSL)), text_color = uiValueText, text_size = size.tiny)
        r += 1

        // EQ Clusters
        string eqInfo = ""
        if not na(eqhLevel)
            eqInfo := "EQH×" + str.tostring(eqhCount) + " @" + str.tostring(eqhLevel, "#.##") + " [" + str.tostring(math.round(eqhScore)) + "]"
        if not na(eqlLevel)
            eqInfo := eqInfo + (eqInfo != "" ? "  |  " : "") + "EQL×" + str.tostring(eqlCount) + " @" + str.tostring(eqlLevel, "#.##") + " [" + str.tostring(math.round(eqlScore)) + "]"
        if eqInfo == ""
            eqInfo := "—"
        table.cell(readTable, 0, r, "EQ Clusters", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, eqInfo, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Active Sweeps
        table.cell(readTable, 0, r, "Active Sweeps", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, str.tostring(array.size(activeSweeps)), text_color = uiValueText, text_size = size.tiny)
        r += 1

        // Nearest External Liquidity
        string extLiqStr = ""
        if not na(nearestExtBSL)
            extLiqStr := "BSL: " + str.tostring(nearestExtBSL, "#.#####")
        if not na(nearestExtSSL)
            extLiqStr := extLiqStr + (extLiqStr != "" ? "  |  " : "") + "SSL: " + str.tostring(nearestExtSSL, "#.#####")
        if extLiqStr == ""
            extLiqStr := "—"
        table.cell(readTable, 0, r, "Nearest Ext Liq", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, extLiqStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Nearest HTF Liquidity
        string htfLiqStr = ""
        if not na(nearestHTFBSL)
            htfLiqStr := "BSL: " + str.tostring(nearestHTFBSL, "#.#####")
        if not na(nearestHTFSSL)
            htfLiqStr := htfLiqStr + (htfLiqStr != "" ? "  |  " : "") + "SSL: " + str.tostring(nearestHTFSSL, "#.#####")
        if htfLiqStr == ""
            htfLiqStr := "—"
        table.cell(readTable, 0, r, "Nearest HTF Liq", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, htfLiqStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Nearest Round-Number Liquidity
        string rnLiqStr = ""
        if not na(nearestRoundBSL)
            rnLiqStr := "BSL: " + str.tostring(nearestRoundBSL, "#.#####")
        if not na(nearestRoundSSL)
            rnLiqStr := rnLiqStr + (rnLiqStr != "" ? "  |  " : "") + "SSL: " + str.tostring(nearestRoundSSL, "#.#####")
        if rnLiqStr == ""
            rnLiqStr := "—"
        table.cell(readTable, 0, r, "Nearest RN Liq", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, rnLiqStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

    // ═══════════════════════════════════════════════════════════════
    // PERFORMANCE SECTION — secondary emphasis, lighter visual weight
    // ═══════════════════════════════════════════════════════════════
    table.cell(readTable, 0, r, "─── Performance ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(readTable, 1, r, "", bgcolor = uiBg)
    r += 1

    table.cell(readTable, 0, r, "Win Rate", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, str.format("{0,number,#.##}%", wr), text_color = wr >= 50 ? uiPosColor : uiNegColor, text_size = size.small)
    r += 1

    if showContext
        table.cell(readTable, 0, r, "Total Trades", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, r, str.tostring(mainStats.totalTrades), text_color = uiValueText, text_size = size.small)
        r += 1

        table.cell(readTable, 0, r, "Wins / Losses", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, r, str.tostring(mainStats.wins) + " / " + str.tostring(mainStats.losses), text_color = uiValueText, text_size = size.small)
        r += 1

    table.cell(readTable, 0, r, "Net R", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, str.format("{0,number,#.##}R", mainStats.totalR), text_color = mainStats.totalR >= 0 ? uiPosColor : uiNegColor, text_size = size.small)
    r += 1

    if showContext
        table.cell(readTable, 0, r, "Equity R", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, r, str.format("{0,number,#.##}R", mainStats.equityR), text_color = mainStats.equityR >= 0 ? uiPosColor : uiNegColor, text_size = size.small)
        r += 1

    table.cell(readTable, 0, r, "Max Drawdown", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, str.format("{0,number,#.##}R", mainStats.maxDrawdownR), text_color = mainStats.maxDrawdownR < 0 ? uiNegColor : uiLabelText, text_size = size.small)

// =====================================================================
// --- DASHBOARD 2: Market Intelligence (MTF Trend + Alerts + OB Scanner) ---
// =====================================================================
int intelRows = 1 + 4 + 1 + 1 + maxAlertRows + 1 + 1 + maxScannerRows
var table marketIntelTable = table.new(resolve_pos(marketIntelPos), 3, intelRows, bgcolor = uiBg, border_width = 1, border_color = uiBorder)
if showMarketIntelDash and barstate.islast
    int row = 0

    // --- Section A: Header ---
    table.cell(marketIntelTable, 0, row, "Market Intelligence", text_color = uiHeaderText, text_size = size.small, text_halign = text.align_left)
    table.merge_cells(marketIntelTable, 0, row, 2, row)
    row += 1

    // --- Section B: MTF Trend ---
    bool htf1Bull = htf1Price > htf1Ema
    bool htf2Bull = htf2Price > htf2Ema
    bool curBull = close > emaBias

    int trendScore = (htf1Bull ? 1 : 0) + (htf2Bull ? 1 : 0) + (curBull ? 1 : 0)
    string alignment = trendScore == 3 ? "Strong Bullish" : trendScore == 0 ? "Strong Bearish" : trendScore == 2 ? "Bullish Alignment" : "Bearish Alignment"
    color alignCol = trendScore >= 2 ? uiPosColor : (trendScore == 0 ? uiNegColor : uiNeutralColor)

    table.cell(marketIntelTable, 0, row, "Alignment", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(marketIntelTable, 1, row, alignment, text_color = alignCol, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "", bgcolor = uiBg)
    row += 1

    table.cell(marketIntelTable, 0, row, "HTF 2 (" + trendHTF2 + ")", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(marketIntelTable, 1, row, htf2Bull ? "BULL" : "BEAR", text_color = htf2Bull ? uiPosColor : uiNegColor, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "", bgcolor = uiBg)
    row += 1

    table.cell(marketIntelTable, 0, row, "HTF 1 (" + trendHTF1 + ")", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(marketIntelTable, 1, row, htf1Bull ? "BULL" : "BEAR", text_color = htf1Bull ? uiPosColor : uiNegColor, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "", bgcolor = uiBg)
    row += 1

    table.cell(marketIntelTable, 0, row, "Current (" + timeframe.period + ")", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(marketIntelTable, 1, row, curBull ? "BULL" : "BEAR", text_color = curBull ? uiPosColor : uiNegColor, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "", bgcolor = uiBg)
    row += 1

    // --- Section C: Alert History ---
    table.cell(marketIntelTable, 0, row, "─── Alert History ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
    table.merge_cells(marketIntelTable, 0, row, 2, row)
    row += 1

    table.cell(marketIntelTable, 0, row, "Time (NY)", text_color = uiLabelText, text_size = size.tiny)
    table.cell(marketIntelTable, 1, row, "Signal", text_color = uiLabelText, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "Price", text_color = uiLabelText, text_size = size.tiny)
    row += 1

    if array.size(alertLogs) > 0
        for i = 0 to math.min(array.size(alertLogs) - 1, maxAlertRows - 1)
            AlertLog al = array.get(alertLogs, i)
            table.cell(marketIntelTable, 0, row, al.timeStr, text_color = uiLabelText, text_size = size.tiny)
            table.cell(marketIntelTable, 1, row, al.signalType, text_color = al.col, text_size = size.tiny)
            table.cell(marketIntelTable, 2, row, str.tostring(al.price, "#.#####"), text_color = uiValueText, text_size = size.tiny)
            row += 1
    else
        table.cell(marketIntelTable, 0, row, "No signals yet", text_color = uiLabelText, text_size = size.tiny)
        table.merge_cells(marketIntelTable, 0, row, 2, row)
        row += 1

    // --- Section D: Active Order Blocks ---
    table.cell(marketIntelTable, 0, row, "─── Active OBs ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
    table.merge_cells(marketIntelTable, 0, row, 2, row)
    row += 1

    table.cell(marketIntelTable, 0, row, "Type", text_color = uiLabelText, text_size = size.tiny)
    table.cell(marketIntelTable, 1, row, "Range", text_color = uiLabelText, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "Age", text_color = uiLabelText, text_size = size.tiny)
    row += 1

    int obCount = 0
    if array.size(obArray) > 0
        for i = array.size(obArray) - 1 to 0
            SmartZone szOb = array.get(obArray, i)
            if not szOb.mitigated and obCount < maxScannerRows
                color c = szOb.isBull ? uiPosColor : uiNegColor
                string t = szOb.isBull ? "BULL" : "BEAR"
                string p = str.format("{0,number,#.##}-{1,number,#.##}", szOb.bottom, szOb.top)
                string a = str.tostring(bar_index - szOb.startBar) + " bars"
                table.cell(marketIntelTable, 0, row, t, text_color = c, text_size = size.tiny)
                table.cell(marketIntelTable, 1, row, p, text_color = uiValueText, text_size = size.tiny)
                table.cell(marketIntelTable, 2, row, a, text_color = uiLabelText, text_size = size.tiny)
                row += 1
                obCount += 1

    if obCount == 0
        table.cell(marketIntelTable, 0, row, "No active OBs", text_color = uiLabelText, text_size = size.tiny)
        table.merge_cells(marketIntelTable, 0, row, 2, row)

// --- Candidate Preview ---
var box candTp = na
var box candSl = na
var label candLbl = na

if barstate.islast
    if showSetups and showCandidatePreview and liveSetup.score >= 60 and na(activeTrade) and not liveSetup.isExpired and not liveSetup.isConflicted and not liveSetup.isDegraded and not dominantLiquidityBlocked
        float projRisk = atr * 1.5
        float entry = close
        bool isLongCandidate = liveSetup.isPotentialLong
        float sl = isLongCandidate ? entry - projRisk : entry + projRisk
        float tp = isLongCandidate ? entry + projRisk * 2.0 : entry - projRisk * 2.0
        int width = activeSetupSize == "Large" ? activeMinWidth * 2 : activeSetupSize == "Normal" ? activeMinWidth : 10
        color candTpCol = isLongCandidate ? longTpColor : shortTpColor
        color candSlCol = isLongCandidate ? longSlColor : shortSlColor

        if na(candTp)
            candTp := box.new(bar_index, isLongCandidate ? tp : entry, bar_index + width, isLongCandidate ? entry : tp, bgcolor = color.new(candTpCol, activeTransp + 5), border_color = candTpCol, border_width = activeBorderWidth)
            candSl := box.new(bar_index, isLongCandidate ? entry : sl, bar_index + width, isLongCandidate ? sl : entry, bgcolor = color.new(candSlCol, activeTransp + 5), border_color = candSlCol, border_width = activeBorderWidth)
            string candDir = isLongCandidate ? "▲ " : "▼ "
            candLbl := label.new(bar_index + width, entry, candDir + "Candidate (" + str.tostring(liveSetup.score) + "%" + (liveSetup.sequenceValid ? " ✓" : "") + ")", color = #00000000, textcolor = setupLabelColor, style = label.style_label_left, size = size.small)
        else
            box.set_lefttop(candTp, bar_index, isLongCandidate ? tp : entry)
            box.set_rightbottom(candTp, bar_index + width, isLongCandidate ? entry : tp)
            box.set_bgcolor(candTp, color.new(candTpCol, activeTransp + 5))
            box.set_border_color(candTp, candTpCol)
            box.set_lefttop(candSl, bar_index, isLongCandidate ? entry : sl)
            box.set_rightbottom(candSl, bar_index + width, isLongCandidate ? sl : entry)
            box.set_bgcolor(candSl, color.new(candSlCol, activeTransp + 5))
            box.set_border_color(candSl, candSlCol)
            label.set_xy(candLbl, bar_index + width, entry)
            string candDir2 = isLongCandidate ? "▲ " : "▼ "
            label.set_text(candLbl, candDir2 + "Candidate (" + str.tostring(liveSetup.score) + "%" + (liveSetup.sequenceValid ? " ✓" : "") + ")")
            label.set_textcolor(candLbl, setupLabelColor)
    else
        if not na(candTp)
            box.delete(candTp)
            box.delete(candSl)
            label.delete(candLbl)
            candTp := na
            candSl := na
            candLbl := na

// --- Alerts ---
bool alertBuy = sig2022B or sigSBB
bool alertSell = sig2022S or sigSBS
alertcondition(alertBuy, "Buy Signal", "ICT/SMC Buy Setup Confirmed")
alertcondition(alertSell, "Sell Signal", "ICT/SMC Sell Setup Confirmed")

// --- Visual Shapes ---
plotshape(showLabels and isSignalB, "Buy Signal", shape.labelup, location.belowbar, BULL_COLOR, text="BUY", textcolor=color.white, size = size.small)
plotshape(showLabels and isSignalS, "Sell Signal", shape.labeldown, location.abovebar, BEAR_COLOR, text="SELL", textcolor=color.white, size = size.small)
