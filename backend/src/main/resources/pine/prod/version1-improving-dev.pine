// --- Sensitivity Logic ---
float sensAtrMult = sensitivityMode == "Aggressive" ? 1.0 : sensitivityMode == "Conservative" ? 2.5 : 1.5
int sensPivotLen = sensitivityMode == "Aggressive" ? 2 : sensitivityMode == "Conservative" ? 5 : 3

// --- Session Engine ---
var asia    = SessionData.new("Asia", "2000-0000")
var london  = SessionData.new("London", "0200-1100")
var ny      = SessionData.new("New York", "0800-1700")
var overlap = SessionData.new("London/NY Overlap", "0800-1100")
var sbLon   = SessionData.new("SB London", "0300-0400")
var sbAm    = SessionData.new("SB AM", "1000-1100")

update_session(SessionData s) =>
    inSess = not na(time(timeframe.period, s.timeRange, NY_TZ))
    if inSess
        if not s.isActive
            s.high := high
            s.low := low
        else
            s.high := math.max(high, s.high)
            s.low := math.min(low, s.low)
    else if s.isActive
        s.lastHigh := s.high
        s.lastLow := s.low
    s.isActive := inSess

update_session(asia)
update_session(london)
update_session(ny)
update_session(overlap)
update_session(sbLon)
update_session(sbAm)

string activeSessName = overlap.isActive ? overlap.name : ny.isActive ? ny.name : london.isActive ? london.name : asia.isActive ? asia.name : "Inter-Session"
bool isKillzone = sbLon.isActive or sbAm.isActive or overlap.isActive
bool isSilverBullet = sbLon.isActive or sbAm.isActive

// --- HTF Liquidity ---
float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
float pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
float pwl = request.security(syminfo.tickerid, "W", low[1], lookahead = barmerge.lookahead_on)

get_last_confirmed_pivot_high(string tf, int leftLen, int rightLen) =>
    request.security(
         syminfo.tickerid,
         tf,
         ta.valuewhen(not na(ta.pivothigh(high, leftLen, rightLen)), ta.pivothigh(high, leftLen, rightLen), 0),
         lookahead = barmerge.lookahead_off)

get_last_confirmed_pivot_low(string tf, int leftLen, int rightLen) =>
    request.security(
         syminfo.tickerid,
         tf,
         ta.valuewhen(not na(ta.pivotlow(low, leftLen, rightLen)), ta.pivotlow(low, leftLen, rightLen), 0),
         lookahead = barmerge.lookahead_off)

// --- Core Data & Primitives ---
int atrLen = input.int(14, "ATR Length", minval = 1, group = G_SENS)
float atr = ta.atr(atrLen)
float bodySize = math.abs(close - open)
float rangeSize = high - low
float volSma = ta.sma(volume, 20)
bool volOk = na(volume) or volume > volSma * 1.2

// --- Reclaim Proxy Primitives (Chapter 2) ---
float recentHigh5 = ta.highest(high, 5)
float recentLow5 = ta.lowest(low, 5)
float recentMid5 = (recentHigh5 + recentLow5) / 2.0

// --- Chapter 3: Reclaim Stage Persistent State ---
var int    _rclSweepRefL = na       // sweep bar this reclaim tracks (reset on new sweep)
var int    _rclSweepRefS = na
var float  _rclThreshL = na         // current reclaim threshold
var float  _rclThreshS = na
var int    _rclAcceptL = 0          // acceptance bar count
var int    _rclAcceptS = 0
var bool   _rclFailedL = false      // reclaim has failed
var bool   _rclFailedS = false
var int    _rclDetBarL = na         // bar when first detected
var int    _rclDetBarS = na

// --- Chapter 4: MSS / Structure Shift Persistent State ---
var int    _mssRefBarL = na          // bar of the MSS event being tracked (long side)
var int    _mssRefBarS = na
var float  _mssBreakLvlL = na        // the trigger level that was broken
var float  _mssBreakLvlS = na
var int    _mssSweepRefL = na        // sweep bar this MSS tracks
var int    _mssSweepRefS = na
var float  _mssScorePersistL = 0.0   // persisted composite score
var float  _mssScorePersistS = 0.0
var bool   _mssFailedPersistL = false
var bool   _mssFailedPersistS = false
var int    _mssFollowBarsL = 0       // bars of follow-through after break
var int    _mssFollowBarsS = 0
var bool   _mssBodyConfL = false     // persisted body confirmation
var bool   _mssBodyConfS = false
var float  _mssBreakQScoreL = 0.0    // persisted break quality score
var float  _mssBreakQScoreS = 0.0

bool isDispBull = bodySize > (atr * sensAtrMult * 0.6) and rangeSize > (atr * sensAtrMult) and close > open and volOk
bool isDispBear = bodySize > (atr * sensAtrMult * 0.6) and rangeSize > (atr * sensAtrMult) and close < open and volOk
bool isDisplacement = isDispBull or isDispBear

float emaBias = ta.ema(close, 200)
float emaSlope = emaBias - emaBias[10]
float emaBuffer = atr * 0.3
string marketBias = close > emaBias + emaBuffer and emaSlope > 0 ? "Bullish"
     : close < emaBias - emaBuffer and emaSlope < 0 ? "Bearish"
     : "Neutral"


// MTF Trend Data (BUG FIX: htf2Ema and htf2Price now use trendHTF2)
float htf1Ema = request.security(syminfo.tickerid, trendHTF1, ta.ema(close, 200))
float htf2Ema = request.security(syminfo.tickerid, trendHTF2, ta.ema(close, 200))
float htf1Price = request.security(syminfo.tickerid, trendHTF1, close)
float htf2Price = request.security(syminfo.tickerid, trendHTF2, close)

// --- Sensitivity Logic (updated) ---
int sensLeftLen = sensitivityMode == "Aggressive" ? 3 : sensitivityMode == "Conservative" ? 7 : 5
int sensRightLen = sensitivityMode == "Aggressive" ? 1 : sensitivityMode == "Conservative" ? 3 : 2
int pivotMaxAge = sensitivityMode == "Aggressive" ? 100 : sensitivityMode == "Conservative" ? 200 : 150

// --- Market Structure Shift (MSS) ---
float pHi = ta.pivothigh(sensLeftLen, sensRightLen)
float pLo = ta.pivotlow(sensLeftLen, sensRightLen)

var float lastPHi = na
var float prevPHi = na
var int lastPHiBar = na
var float lastPLo = na
var float prevPLo = na
var int lastPLoBar = na

float minSwingDepth = atr * 0.5

if not na(pHi) and (na(lastPLo) or (pHi - lastPLo) > minSwingDepth)
    prevPHi := lastPHi
    lastPHi := pHi
    lastPHiBar := bar_index - sensRightLen

if not na(pLo) and (na(lastPHi) or (lastPHi - pLo) > minSwingDepth)
    prevPLo := lastPLo
    lastPLo := pLo
    lastPLoBar := bar_index - sensRightLen

// Expire stale pivots
if not na(lastPHiBar) and (bar_index - lastPHiBar) > pivotMaxAge
    lastPHi := na
    lastPHiBar := na
if not na(lastPLoBar) and (bar_index - lastPLoBar) > pivotMaxAge
    lastPLo := na
    lastPLoBar := na

float htfPivot1High = enableHtfPivot1 ? get_last_confirmed_pivot_high(liqPivotTf1, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot1Low = enableHtfPivot1 ? get_last_confirmed_pivot_low(liqPivotTf1, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot2High = enableHtfPivot2 ? get_last_confirmed_pivot_high(liqPivotTf2, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot2Low = enableHtfPivot2 ? get_last_confirmed_pivot_low(liqPivotTf2, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot3High = enableHtfPivot3 ? get_last_confirmed_pivot_high(liqPivotTf3, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot3Low = enableHtfPivot3 ? get_last_confirmed_pivot_low(liqPivotTf3, htfPivotLeftLen, htfPivotRightLen) : na

// BOS (continuation) vs MSS (reversal)
bool bosBull = ta.crossover(close, lastPHi) and isDispBull
bool bosBear = ta.crossunder(close, lastPLo) and isDispBear
bool mssBull = ta.crossover(close, lastPHi) and isDispBull and not na(prevPLo) and low[1] < prevPLo
bool mssBear = ta.crossunder(close, lastPLo) and isDispBear and not na(prevPHi) and high[1] > prevPHi

// --- Sequence Tracking: persistent bar timestamps for Sweep → MSS → FVG ordering ---
var int lastMssBullBar = na
var int lastMssBearBar = na
var float lastMssBullDispStrength = na
var float lastMssBearDispStrength = na

if mssBull
    lastMssBullBar := bar_index
    lastMssBullDispStrength := math.abs(close - open) / atr
if mssBear
    lastMssBearBar := bar_index
    lastMssBearDispStrength := math.abs(close - open) / atr

// Expire stale MSS (same age logic as sweeps)
int mssMaxAge = sensitivityMode == "Aggressive" ? 50 : sensitivityMode == "Conservative" ? 120 : 80
if not na(lastMssBullBar) and (bar_index - lastMssBullBar) > mssMaxAge
    lastMssBullBar := na
    lastMssBullDispStrength := na
if not na(lastMssBearBar) and (bar_index - lastMssBearBar) > mssMaxAge
    lastMssBearBar := na
    lastMssBearDispStrength := na

// --- SMC Elements (FVG & OB) ---
var SmartZone[] fvgArray = array.new<SmartZone>()
var SmartZone[] obArray = array.new<SmartZone>()

// =====================================================================
// FVG ENGINE — Clean-room reimplementation of Lux-style detection behavior
// Original behavioral reference: Fair Value Gap [LuxAlgo] (CC BY-NC-SA 4.0)
// This is an independent reimplementation adapted to this indicator's
// SmartZone architecture, scoring pipeline, and setup lifecycle.
// =====================================================================

// FVG detection function — evaluated in source timeframe context via request.security.
// Returns: [bullDetected, bearDetected, zoneTop, zoneBot, sourceTimestamp]
//
// Detection rules (clean-room reimplementation of Lux-style behavior):
//   Bullish: low > high[2]  AND  close[1] > high[2]  AND  gapRatio > threshold
//   Bearish: high < low[2]  AND  close[1] < low[2]   AND  gapRatio > threshold
//
// Threshold modes:
//   Auto:   cumulative average of (range / low) across all bars — adapts to instrument & TF
//   Manual: user-supplied percentage converted to ratio
detect_fvg() =>
    // Threshold: adaptive cumulative average, or manual percentage
    float thresh = fvgAutoThreshold ? ta.cum((high - low) / low) / bar_index : fvgThresholdPct / 100.0

    // Bullish FVG: 3-candle upward imbalance with close commitment
    //   candle[0].low above candle[2].high = price gap up
    //   candle[1].close above candle[2].high = middle candle confirms bullish intent
    //   gap ratio = (gap size) / (reference price) must exceed threshold
    bool bull = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > thresh

    // Bearish FVG: mirror — 3-candle downward imbalance
    //   candle[0].high below candle[2].low = price gap down
    //   candle[1].close below candle[2].low = middle candle confirms bearish intent
    bool bear = high < low[2] and close[1] < low[2] and (low[2] - high) / high > thresh

    // Zone bounds (absolute price levels, TF-native)
    float zTop = bull ? low : bear ? low[2] : na
    float zBot = bull ? high[2] : bear ? high : na

    // Source-bar timestamp for MTF deduplication
    int zTime = time

    [bull, bear, zTop, zBot, zTime]

// Execute detection via request.security for optional MTF support.
// When fvgTimeframe is "" (default), evaluates on the chart timeframe.
// No lookahead — only confirmed source-bar data is used.
[fvgBullRaw, fvgBearRaw, fvgTopRaw, fvgBotRaw, fvgSourceTime] = request.security(syminfo.tickerid, fvgTimeframe, detect_fvg())

// MTF deduplication: one FVG registration per source-timeframe detection event.
// When using a higher TF, the same detection fires on every chart bar until the
// next HTF bar closes. The timestamp check prevents repeated insertions.
var int lastFvgRegisteredTime = 0
bool bullFVG = fvgBullRaw and fvgSourceTime != lastFvgRegisteredTime
bool bearFVG = fvgBearRaw and fvgSourceTime != lastFvgRegisteredTime

if bullFVG or bearFVG
    lastFvgRegisteredTime := fvgSourceTime

// Gap size from returned zone bounds (works for both local and MTF detection)
float fvgGapSize = not na(fvgTopRaw) and not na(fvgBotRaw) ? fvgTopRaw - fvgBotRaw : 0.0
float maxFvgSize = atr * 3.0

// Quality grading (for confluence scoring, not detection filtering)
// Grading uses chart-TF displacement and ATR — a large HTF gap relative to
// chart ATR naturally scores higher, which is the correct behavior.
// Grade A: strong displacement on middle candle + large gap (> 0.5 ATR)
bool bullFVG_A = bullFVG and isDispBull[1] and fvgGapSize > atr * 0.5 and fvgGapSize < maxFvgSize
bool bearFVG_A = bearFVG and isDispBear[1] and fvgGapSize > atr * 0.5 and fvgGapSize < maxFvgSize
// Grade B: displacement OR moderate gap (> 0.3 ATR), not already Grade A
bool bullFVG_B = bullFVG and (isDispBull[1] or fvgGapSize > atr * 0.3) and not bullFVG_A and fvgGapSize < maxFvgSize
bool bearFVG_B = bearFVG and (isDispBear[1] or fvgGapSize > atr * 0.3) and not bearFVG_A and fvgGapSize < maxFvgSize
// Grade C: basic valid FVG (passed Lux-style threshold + close confirmation)
bool bullFVG_C = bullFVG and not bullFVG_A and not bullFVG_B
bool bearFVG_C = bearFVG and not bearFVG_A and not bearFVG_B

// Bias-aligned variants for strategy triggers (Silver Bullet etc.)
bool bullFvgAligned = bullFVG and (marketBias != "Bearish")
bool bearFvgAligned = bearFVG and (marketBias != "Bullish")

// --- FVG Tracking State ---
// Persistent tracking for sequence validation (Sweep → MSS → FVG) and mitigation
var int   lastBullFvgBar = na
var int   lastBearFvgBar = na
var int   lastBullFvgGrade = 0
var int   lastBearFvgGrade = 0
var float lastBullFvgTop = na
var float lastBullFvgBot = na
var float lastBearFvgTop = na
var float lastBearFvgBot = na
var bool  lastBullFvgMitigated = false
var bool  lastBearFvgMitigated = false

if bullFVG
    lastBullFvgBar := bar_index
    lastBullFvgGrade := bullFVG_A ? 3 : bullFVG_B ? 2 : 1
    lastBullFvgTop := fvgTopRaw
    lastBullFvgBot := fvgBotRaw
    lastBullFvgMitigated := false
if bearFVG
    lastBearFvgBar := bar_index
    lastBearFvgGrade := bearFVG_A ? 3 : bearFVG_B ? 2 : 1
    lastBearFvgTop := fvgTopRaw
    lastBearFvgBot := fvgBotRaw
    lastBearFvgMitigated := false

// --- FVG Lifecycle: Close-Based Mitigation ---
// Bull FVG mitigated when close moves below its lower boundary (bottom of gap)
// Bear FVG mitigated when close moves above its upper boundary (top of gap)
// This is close-based, not wick-based — consistent with the reference behavior.
if not na(lastBullFvgBar) and not lastBullFvgMitigated and close < lastBullFvgBot
    lastBullFvgMitigated := true
if not na(lastBearFvgBar) and not lastBearFvgMitigated and close > lastBearFvgTop
    lastBearFvgMitigated := true

// --- FVG Expiry ---
int fvgMaxAge = sensitivityMode == "Aggressive" ? 40 : sensitivityMode == "Conservative" ? 100 : 60
if not na(lastBullFvgBar) and (bar_index - lastBullFvgBar) > fvgMaxAge
    lastBullFvgBar := na
    lastBullFvgGrade := 0
    lastBullFvgMitigated := false
if not na(lastBearFvgBar) and (bar_index - lastBearFvgBar) > fvgMaxAge
    lastBearFvgBar := na
    lastBearFvgGrade := 0
    lastBearFvgMitigated := false

// Returns: 0 = no overlap, 1 = merge (expand existing), 2 = near-duplicate (skip)
check_fvg_overlap(SmartZone[] arr, float newTop, float newBottom, bool newIsBull) =>
    int result = 0
    int mergeIdx = -1
    float newSize = newTop - newBottom
    if array.size(arr) > 0 and newSize > 0
        int startIdx = math.max(0, array.size(arr) - 8)
        for i = array.size(arr) - 1 to startIdx
            SmartZone existing = array.get(arr, i)
            if existing.isBull == newIsBull and not existing.mitigated
                float exSize = existing.top - existing.bottom
                if exSize > 0
                    float overlapTop = math.min(existing.top, newTop)
                    float overlapBot = math.max(existing.bottom, newBottom)
                    if overlapTop > overlapBot
                        float overlapSize = overlapTop - overlapBot
                        float smallerZone = math.min(exSize, newSize)
                        float overlapPct = overlapSize / smallerZone
                        if overlapPct > 0.8
                            result := 2
                            break
                        else if overlapPct > 0.3
                            result := 1
                            mergeIdx := i
                            break
    [result, mergeIdx]


// Merge: expand existing zone to encompass both
merge_fvg(SmartZone[] arr, int idx, float newTop, float newBottom, color bgCol) =>
    SmartZone existing = array.get(arr, idx)
    float mergedTop = math.max(existing.top, newTop)
    float mergedBot = math.min(existing.bottom, newBottom)
    existing.top := mergedTop
    existing.bottom := mergedBot
    existing.ce := (mergedTop + mergedBot) / 2.0
    box.set_top(existing.boxId, mergedTop)
    box.set_bottom(existing.boxId, mergedBot)
    box.set_border_width(existing.boxId, 2)
    box.set_bgcolor(existing.boxId, color.new(bgCol, 75))



// FVG Visual Rendering — uses zone bounds from the detection engine (fvgTopRaw/fvgBotRaw)
// so that MTF-detected FVGs render at the correct price levels.
// Overlap merge logic is preserved: same-direction nearby FVGs are merged to reduce clutter.
if showFVG
    if bullFVG
        float fvgTop = fvgTopRaw
        float fvgBot = fvgBotRaw
        [overlapResult, mergeIdx] = check_fvg_overlap(fvgArray, fvgTop, fvgBot, true)
        if overlapResult == 0
            float fvgCE = (fvgTop + fvgBot) / 2.0
            box b = box.new(bar_index - 2, fvgTop, bar_index + fvgExtendBars, fvgBot, bgcolor = bullFvgColor, border_color = color.new(bullFvgColor, 50), border_style = line.style_dotted)
            array.push(fvgArray, SmartZone.new(b, fvgTop, fvgBot, true, false, false, bar_index - 2, fvgCE, false, false, 0, fvgGapSize))
        else if overlapResult == 1
            merge_fvg(fvgArray, mergeIdx, fvgTop, fvgBot, bullFvgColor)

    if bearFVG
        float fvgTop = fvgTopRaw
        float fvgBot = fvgBotRaw
        [overlapResult, mergeIdx] = check_fvg_overlap(fvgArray, fvgTop, fvgBot, false)
        if overlapResult == 0
            float fvgCE = (fvgTop + fvgBot) / 2.0
            box b = box.new(bar_index - 2, fvgTop, bar_index + fvgExtendBars, fvgBot, bgcolor = bearFvgColor, border_color = color.new(bearFvgColor, 50), border_style = line.style_dotted)
            array.push(fvgArray, SmartZone.new(b, fvgTop, fvgBot, false, false, false, bar_index - 2, fvgCE, false, false, 0, fvgGapSize))
        else if overlapResult == 1
            merge_fvg(fvgArray, mergeIdx, fvgTop, fvgBot, bearFvgColor)



// OB Detection (Last opposite candle before MSS)
if showOB
    if mssBull
        int obBar = na
        for i = 1 to 20
            if close[i] < open[i]
                obBar := bar_index - i
                break
        if not na(obBar)
            float t = high[bar_index - obBar]
            float b_ = low[bar_index - obBar]
            box bx = box.new(obBar, t, bar_index, b_, bgcolor = bullObColor, border_color = color.new(bullObColor, 50))
            array.push(obArray, SmartZone.new(bx, t, b_, true, false, false, obBar, na, false, false, 0, na))

    if mssBear
        int obBar = na
        for i = 1 to 20
            if close[i] > open[i]
                obBar := bar_index - i
                break
        if not na(obBar)
            float t = high[bar_index - obBar]
            float b_ = low[bar_index - obBar]
            box bx = box.new(obBar, t, bar_index, b_, bgcolor = bearObColor, border_color = color.new(bearObColor, 50))
            array.push(obArray, SmartZone.new(bx, t, b_, false, false, false, obBar, na, false, false, 0, na))

// Mitigation & Inversion Logic (LuxAlgo-inspired: close-based mitigation for FVGs)
update_zones(SmartZone[] arr, int maxCount, bool isFVG) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            SmartZone sz = array.get(arr, i)
            if not sz.mitigated
                box.set_right(sz.boxId, bar_index)

                bool justMitigated = false

                if not sz.isInverted
                    if sz.isBull
                        // Track CE touch (price enters the FVG)
                        if isFVG and not na(sz.ce) and low <= sz.ce and not sz.ceRespected
                            sz.ceRespected := true
                            sz.touchCount += 1
                        // Check for inversion: close fully through bottom
                        if isFVG and showIFVG and close < sz.bottom
                            sz.isInverted := true
                            box.set_bgcolor(sz.boxId, bearIfvgColor)
                            box.set_border_style(sz.boxId, line.style_solid)
                        // FVG mitigation: CLOSE below bottom (LuxAlgo style — not just wick touch)
                        // OB mitigation: wick touch (unchanged — OBs are demand/supply zones)
                        else if isFVG and close < sz.bottom
                            justMitigated := true
                        else if not isFVG and low < sz.bottom
                            justMitigated := true
                    else
                        // Track CE touch
                        if isFVG and not na(sz.ce) and high >= sz.ce and not sz.ceRespected
                            sz.ceRespected := true
                            sz.touchCount += 1
                        // Check for inversion: close fully through top
                        if isFVG and showIFVG and close > sz.top
                            sz.isInverted := true
                            box.set_bgcolor(sz.boxId, bullIfvgColor)
                            box.set_border_style(sz.boxId, line.style_solid)
                        // FVG mitigation: CLOSE above top (LuxAlgo style)
                        else if isFVG and close > sz.top
                            justMitigated := true
                        else if not isFVG and high > sz.top
                            justMitigated := true
                else
                    // Mitigation for Inverted Zones (close-based for FVGs, touch for OBs)
                    if sz.isBull // Was originally Bullish, now Bearish IFVG (Resistance)
                        if (isFVG and close > sz.top) or (not isFVG and high > sz.top)
                            justMitigated := true
                    else // Was originally Bearish, now Bullish IFVG (Support)
                        if (isFVG and close < sz.bottom) or (not isFVG and low < sz.bottom)
                            justMitigated := true

                // On mitigation: delete the box entirely (no ghost lines)
                if justMitigated
                    sz.mitigated := true
                    box.delete(sz.boxId)

        if array.size(arr) > maxCount
            SmartZone old = array.shift(arr)
            box.delete(old.boxId)

update_zones(fvgArray, maxZones, true)
update_zones(obArray, maxZones, false)

// =====================================================================
// --- LIQUIDITY ENGINE v2 — Hierarchical Detection, Classification & Scoring ---
// =====================================================================

// --- Internal vs External Pivot Classification ---
// External: defines the active dealing range boundary (outermost swings)
// Internal: intermediate pullback pivots within the range
float rangeHigh50 = ta.highest(high, 50)
float rangeLow50  = ta.lowest(low, 50)
float rangeSpan   = rangeHigh50 - rangeLow50
float extThreshold = rangeSpan * 0.15  // Within 15% of range boundary = external

bool pivotHiIsExternal = not na(lastPHi) and (lastPHi > rangeHigh50 - extThreshold)
bool pivotLoIsExternal = not na(lastPLo) and (lastPLo < rangeLow50 + extThreshold)

// Previous pivot (for inducement detection)
bool prevPivotHiIsInternal = not na(prevPHi) and not (prevPHi > rangeHigh50 - extThreshold)
bool prevPivotLoIsInternal = not na(prevPLo) and not (prevPLo < rangeLow50 + extThreshold)

// --- Equal Highs / Equal Lows Detection ---
// Tracks recent swing highs/lows, scores clusters by recency/touches/context,
// and prefers local structure unless an older structural cluster is materially better.
float eqhTolerance = atr * 0.15
int eqPivotStore = math.max(eqLocalLookback, eqStructuralLookback)

var float[] recentSwingHighs = array.new_float()
var float[] recentSwingLows  = array.new_float()
var int[]   recentSwingHighBars = array.new_int()
var int[]   recentSwingLowBars  = array.new_int()

if not na(pHi)
    array.push(recentSwingHighs, pHi)
    array.push(recentSwingHighBars, bar_index - sensRightLen)
    if array.size(recentSwingHighs) > eqPivotStore
        array.shift(recentSwingHighs)
        array.shift(recentSwingHighBars)

if not na(pLo)
    array.push(recentSwingLows, pLo)
    array.push(recentSwingLowBars, bar_index - sensRightLen)
    if array.size(recentSwingLows) > eqPivotStore
        array.shift(recentSwingLows)
        array.shift(recentSwingLowBars)

level_is_near(float lhs, float rhs, float tol) =>
    not na(lhs) and not na(rhs) and math.abs(lhs - rhs) <= tol

cluster_context_bonus(float price_, bool isSSL_) =>
    float bonus = 0.0
    float tol = eqhTolerance * 1.5
    if isSSL_
        if level_is_near(price_, pdl, tol)
            bonus += 5.0
        if level_is_near(price_, pwl, tol)
            bonus += 6.0
        if level_is_near(price_, htfPivot1Low, tol)
            bonus += 3.0
        if level_is_near(price_, htfPivot2Low, tol)
            bonus += 4.0
        if level_is_near(price_, htfPivot3Low, tol)
            bonus += 5.0
        if level_is_near(price_, asia.lastLow, tol) or level_is_near(price_, london.lastLow, tol) or level_is_near(price_, ny.lastLow, tol)
            bonus += 3.0
        if level_is_near(price_, rangeLow50, tol * 2.0)
            bonus += 4.0
    else
        if level_is_near(price_, pdh, tol)
            bonus += 5.0
        if level_is_near(price_, pwh, tol)
            bonus += 6.0
        if level_is_near(price_, htfPivot1High, tol)
            bonus += 3.0
        if level_is_near(price_, htfPivot2High, tol)
            bonus += 4.0
        if level_is_near(price_, htfPivot3High, tol)
            bonus += 5.0
        if level_is_near(price_, asia.lastHigh, tol) or level_is_near(price_, london.lastHigh, tol) or level_is_near(price_, ny.lastHigh, tol)
            bonus += 3.0
        if level_is_near(price_, rangeHigh50, tol * 2.0)
            bonus += 4.0
    bonus

find_eq_cluster(float[] priceArr, int[] barArr, int lookbackN, bool isSSL_) =>
    float bestPrice = na
    int bestCount = 0
    int bestLastBar = na
    float bestScore = 0.0
    int available = array.size(priceArr)
    if available >= 2
        int startIdx = math.max(0, available - lookbackN)
        int localStartIdx = math.max(0, available - eqLocalLookback)
        for i = available - 1 to startIdx
            float refPrice = array.get(priceArr, i)
            int matchCount = 0
            int localTouches = 0
            float sumPrice = 0.0
            int lastTouchBar = na
            for j = startIdx to available - 1
                float cmpPrice = array.get(priceArr, j)
                int cmpBar = array.get(barArr, j)
                if math.abs(cmpPrice - refPrice) <= eqhTolerance
                    matchCount += 1
                    sumPrice += cmpPrice
                    if j >= localStartIdx
                        localTouches += 1
                    lastTouchBar := na(lastTouchBar) ? cmpBar : math.max(lastTouchBar, cmpBar)
            if matchCount >= 2 and not na(lastTouchBar)
                int ageBars = bar_index - lastTouchBar
                if ageBars <= eqClusterMaxAge
                    float avgPrice = sumPrice / matchCount
                    float recencyScore = math.max(0.0, 1.0 - float(ageBars) / eqClusterMaxAge)
                    float distAtr = atr > 0 ? math.abs(avgPrice - close) / atr : 0.0
                    float score = matchCount * 16.0 + localTouches * 5.0 + recencyScore * 20.0 + cluster_context_bonus(avgPrice, isSSL_) - math.min(math.max(distAtr - 6.0, 0.0) * 1.5, 12.0)
                    if score > bestScore or (score == bestScore and (na(bestLastBar) or lastTouchBar > bestLastBar))
                        bestPrice := avgPrice
                        bestCount := matchCount
                        bestLastBar := lastTouchBar
                        bestScore := score
    [bestPrice, bestCount, bestLastBar, bestScore]

select_cluster(float localPrice, int localCount, int localBar, float localScore, float structuralPrice, int structuralCount, int structuralBar, float structuralScore) =>
    float chosenPrice = na
    int chosenCount = 0
    int chosenBar = na
    float chosenScore = 0.0
    if not na(localPrice) or not na(structuralPrice)
        bool useStructural = false
        if na(localPrice)
            useStructural := true
        else if not na(structuralPrice)
            useStructural := structuralScore > localScore + 4.0 or (structuralCount > localCount and structuralScore >= localScore)
        chosenPrice := useStructural ? structuralPrice : localPrice
        chosenCount := useStructural ? structuralCount : localCount
        chosenBar := useStructural ? structuralBar : localBar
        chosenScore := useStructural ? structuralScore : localScore
    [chosenPrice, chosenCount, chosenBar, chosenScore]

cluster_priority_from_score(int clusterCount_, int lastTouchBar_, float clusterScore_) =>
    int pri = PRI_EQH_EQL
    if clusterCount_ >= 3
        pri += 4
    if clusterCount_ >= 4
        pri += 4
    if clusterScore_ >= 60
        pri += 4
    if clusterScore_ >= 75
        pri += 4
    if not na(lastTouchBar_)
        int ageBars = bar_index - lastTouchBar_
        if ageBars > math.round(eqClusterMaxAge * 0.6)
            pri -= 12
        else if ageBars > math.round(eqClusterMaxAge * 0.35)
            pri -= 6
    math.max(42, math.min(84, pri))

[eqhLocalLevel, eqhLocalCount, eqhLocalBar, eqhLocalScore] = find_eq_cluster(recentSwingHighs, recentSwingHighBars, eqLocalLookback, false)

[eqhStructLevel, eqhStructCount, eqhStructBar, eqhStructScore] = find_eq_cluster(recentSwingHighs, recentSwingHighBars, eqStructuralLookback, false)

[eqhLevel, eqhCount, eqhLastBar, eqhScore] = select_cluster(eqhLocalLevel, eqhLocalCount, eqhLocalBar, eqhLocalScore, eqhStructLevel, eqhStructCount, eqhStructBar, eqhStructScore)
int eqhPriority = not na(eqhLevel) ? cluster_priority_from_score(eqhCount, eqhLastBar, eqhScore) : PRI_EQH_EQL

[eqlLocalLevel, eqlLocalCount, eqlLocalBar, eqlLocalScore] = find_eq_cluster(recentSwingLows, recentSwingLowBars, eqLocalLookback, true)

[eqlStructLevel, eqlStructCount, eqlStructBar, eqlStructScore] = find_eq_cluster(recentSwingLows, recentSwingLowBars, eqStructuralLookback, true)

[eqlLevel, eqlCount, eqlLastBar, eqlScore] = select_cluster(eqlLocalLevel, eqlLocalCount, eqlLocalBar, eqlLocalScore, eqlStructLevel, eqlStructCount, eqlStructBar, eqlStructScore)
int eqlPriority = not na(eqlLevel) ? cluster_priority_from_score(eqlCount, eqlLastBar, eqlScore) : PRI_EQH_EQL

// --- Build Liquidity Level Registry ---
// Constructs LiqLevel objects for all monitored sources each bar
var LiqLevel[] liqLevels = array.new<LiqLevel>()
array.clear(liqLevels)

is_htf_liquidity_source(int srcType) =>
    srcType == SRC_PDH_PDL or srcType == SRC_PWH_PWL or srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3

source_category_label(int srcType, string lvlName) =>
    string label = "Liquidity"
    if srcType == SRC_PWH_PWL
        label := "Weekly Level"
    else if srcType == SRC_PDH_PDL
        label := "Daily Level"
    else if srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3
        label := "HTF Pivot"
    else if srcType == SRC_SESSION
        label := "Session Level"
    else if srcType == SRC_EQH_EQL
        label := "EQ Cluster"
    else if srcType == SRC_ROUND_NUM
        label := "Round Number"
    else if srcType == SRC_PIVOT_EXT
        label := "External Pivot"
    else if srcType == SRC_PIVOT_INT
        label := "Internal Pivot"
    if (srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3) and lvlName != ""
        label := label + " (" + lvlName + ")"
    label

source_phase_tag(int srcType, bool isExt) =>
    string tag = isExt ? " [Ext]" : " [Int]"
    if srcType == SRC_PWH_PWL
        tag := " [W]"
    else if srcType == SRC_PDH_PDL
        tag := " [D]"
    else if srcType == SRC_PIVOT_HTF_1 or srcType == SRC_PIVOT_HTF_2 or srcType == SRC_PIVOT_HTF_3
        tag := " [HTF Pivot]"
    else if srcType == SRC_EQH_EQL
        tag := " [EQ]"
    else if srcType == SRC_SESSION
        tag := " [Sess]"
    else if srcType == SRC_ROUND_NUM
        tag := " [RN]"
    tag

round_grid_base(float price_, float step_) =>
    step_ > 0 ? math.floor(price_ / step_) * step_ : na

float roundMainBase = enableRoundNumbers and roundStep > 0 ? round_grid_base(close, roundStep) : na
float roundMainBelow = roundMainBase
float roundMainAbove = not na(roundMainBase) ? roundMainBase + roundStep : na
bool hasRoundSubStep = enableRoundNumbers and roundSubStep > 0 and roundSubStep < roundStep
float roundSubBase = hasRoundSubStep ? round_grid_base(close, roundSubStep) : na
float roundSubBelow = roundSubBase
float roundSubAbove = not na(roundSubBase) ? roundSubBase + roundSubStep : na

// Helper: add level if valid
add_liq_level(LiqLevel[] arr, string name_, float price_, int srcType, int pri, bool ext, bool ssl, bool htf, bool sess, bool cluster, int clusterN) =>
    if not na(price_)
        array.push(arr, LiqLevel.new(name_, price_, srcType, pri, ext, ssl, htf, sess, cluster, clusterN, bar_index))

// Session levels (only completed sessions — no developing)
add_liq_level(liqLevels, "Asia High",   asia.isActive ? na : asia.lastHigh,     SRC_SESSION, PRI_SESSION, true, false, false, true, false, 0)
add_liq_level(liqLevels, "Asia Low",    asia.isActive ? na : asia.lastLow,      SRC_SESSION, PRI_SESSION, true, true,  false, true, false, 0)
add_liq_level(liqLevels, "London High", london.isActive ? na : london.lastHigh, SRC_SESSION, PRI_SESSION + 5, true, false, false, true, false, 0)
add_liq_level(liqLevels, "London Low",  london.isActive ? na : london.lastLow,  SRC_SESSION, PRI_SESSION + 5, true, true,  false, true, false, 0)
add_liq_level(liqLevels, "NY High",     ny.isActive ? na : ny.lastHigh,         SRC_SESSION, PRI_SESSION + 10, true, false, false, true, false, 0)
add_liq_level(liqLevels, "NY Low",      ny.isActive ? na : ny.lastLow,          SRC_SESSION, PRI_SESSION + 10, true, true,  false, true, false, 0)

// HTF levels
add_liq_level(liqLevels, "PDH", pdh, SRC_PDH_PDL, PRI_PDH_PDL, true, false, true, false, false, 0)
add_liq_level(liqLevels, "PDL", pdl, SRC_PDH_PDL, PRI_PDH_PDL, true, true,  true, false, false, 0)
add_liq_level(liqLevels, "PWH", pwh, SRC_PWH_PWL, PRI_PWH_PWL, true, false, true, false, false, 0)
add_liq_level(liqLevels, "PWL", pwl, SRC_PWH_PWL, PRI_PWH_PWL, true, true,  true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf1 + " High", htfPivot1High, SRC_PIVOT_HTF_1, PRI_PIVOT_HTF_1, true, false, true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf1 + " Low", htfPivot1Low, SRC_PIVOT_HTF_1, PRI_PIVOT_HTF_1, true, true,  true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf2 + " High", htfPivot2High, SRC_PIVOT_HTF_2, PRI_PIVOT_HTF_2, true, false, true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf2 + " Low", htfPivot2Low, SRC_PIVOT_HTF_2, PRI_PIVOT_HTF_2, true, true,  true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf3 + " High", enableHtfPivot3 ? htfPivot3High : na, SRC_PIVOT_HTF_3, PRI_PIVOT_HTF_3, true, false, true, false, false, 0)
add_liq_level(liqLevels, "HTF " + liqPivotTf3 + " Low", enableHtfPivot3 ? htfPivot3Low : na, SRC_PIVOT_HTF_3, PRI_PIVOT_HTF_3, true, true,  true, false, false, 0)

// Structural pivots (classified by internal/external)
add_liq_level(liqLevels, "Pivot High", lastPHi, pivotHiIsExternal ? SRC_PIVOT_EXT : SRC_PIVOT_INT, pivotHiIsExternal ? PRI_PIVOT_EXT : PRI_PIVOT_INT, pivotHiIsExternal, false, false, false, false, 0)
add_liq_level(liqLevels, "Pivot Low",  lastPLo, pivotLoIsExternal ? SRC_PIVOT_EXT : SRC_PIVOT_INT, pivotLoIsExternal ? PRI_PIVOT_EXT : PRI_PIVOT_INT, pivotLoIsExternal, true,  false, false, false, 0)

// Equal highs/lows clusters
add_liq_level(liqLevels, "EQH", eqhLevel, SRC_EQH_EQL, eqhPriority, true, false, false, false, true, eqhCount)
add_liq_level(liqLevels, "EQL", eqlLevel, SRC_EQH_EQL, eqlPriority, true, true,  false, false, true, eqlCount)

// Optional psychological levels
add_liq_level(liqLevels, "RN " + str.tostring(roundMainAbove, "#.#####"), enableRoundNumbers ? roundMainAbove : na, SRC_ROUND_NUM, PRI_ROUND_NUM, false, false, false, false, false, 0)
add_liq_level(liqLevels, "RN " + str.tostring(roundMainBelow, "#.#####"), enableRoundNumbers ? roundMainBelow : na, SRC_ROUND_NUM, PRI_ROUND_NUM, false, true,  false, false, false, 0)
add_liq_level(liqLevels, "RN sub " + str.tostring(roundSubAbove, "#.#####"), hasRoundSubStep ? roundSubAbove : na, SRC_ROUND_NUM, PRI_ROUND_NUM - 5, false, false, false, false, false, 0)
add_liq_level(liqLevels, "RN sub " + str.tostring(roundSubBelow, "#.#####"), hasRoundSubStep ? roundSubBelow : na, SRC_ROUND_NUM, PRI_ROUND_NUM - 5, false, true,  false, false, false, 0)

// --- Session Timing Weight ---
// Returns multiplier for sweep significance based on when it happens
get_session_weight() =>
    float w = 1.0
    if overlap.isActive
        w := 1.3
    else if ny.isActive
        w := 1.2
    else if london.isActive
        w := 1.15
    else if asia.isActive
        w := 0.85
    else
        w := 0.7   // Inter-session dead time
    w

float sessionWeight = get_session_weight()

// --- Sweep Detection Engine v2 ---
var LiqSweep[] activeSweeps = array.new<LiqSweep>()
int sweepMaxAge = sensitivityMode == "Aggressive" ? 30 : sensitivityMode == "Conservative" ? 70 : 50
int sweepMaxCount = 8

// Classify sweep type based on metrics and source
classify_sweep_type(float depthAtr, bool isExt, bool isHTF_, bool isSess, bool isCluster_, int srcType) =>
    int sType = SWEEP_SHALLOW
    string sStr = "Shallow"
    if isHTF_
        sType := SWEEP_HTF
        sStr := "HTF Sweep"
    else if isExt and depthAtr > 0.3
        sType := SWEEP_EXT_LIQ_GRAB
        sStr := "Ext. Liq Grab"
    else if isSess
        sType := SWEEP_SESSION
        sStr := "Session Sweep"
    else if not isExt
        sType := SWEEP_INT_LIQ_SWEEP
        sStr := "Internal Sweep"
    // Override by depth
    if depthAtr > 1.5
        sType := SWEEP_DEEP_STOP_RUN
        sStr := "Deep Stop Run"
    else if depthAtr > 0.2 and depthAtr <= 1.5 and sType == SWEEP_SHALLOW
        sType := SWEEP_CLEAN_RAID
        sStr := "Clean Raid"
    [sType, sStr]

// Compute multi-dimensional quality score
compute_sweep_quality(float depthAtr, float wickPenRatio, float rejStr, bool hasRej, bool hasDisp, int srcPri, bool isExt, bool isHTF_, bool isCluster_, int clusterN, bool inKz, bool inSb, float sessW, float freshness, int sweepT) =>
    float q = 0.0
    // 1. Penetration quality (max 20)
    q += math.min(depthAtr * 15.0, 20.0)
    // 2. Rejection strength (max 20)
    if hasRej
        q += 10.0 + rejStr * 10.0
    // 3. Displacement follow-through (max 15)
    if hasDisp
        q += 15.0
    // 4. Source priority (max 15) — normalized from 0-100 priority to 0-15
    q += (srcPri / 100.0) * 15.0
    // 5. External vs internal multiplier
    if isExt
        q *= 1.15
    else
        q *= 0.85
    // 6. HTF bonus (max 8)
    if isHTF_
        q += 8.0
    // 7. Session timing (max 5)
    q += (sessW - 0.7) * 8.33   // Maps 0.7-1.3 → 0-5
    // 8. Cluster liquidity bonus (max 8)
    if isCluster_
        q += 4.0 + math.min(clusterN - 2, 3) * 1.33
    // 9. Freshness (max 10)
    q += freshness * 10.0
    // 10. Kill zone / Silver Bullet bonus
    if inSb
        q += 5.0
    else if inKz
        q += 3.0
    // 11. Deep stop-run penalty (overextended = risky)
    if sweepT == SWEEP_DEEP_STOP_RUN
        q -= 5.0
    // 12. Weak wick penetration penalty
    if wickPenRatio < 0.1 and not hasDisp
        q -= 5.0
    math.max(0.0, math.min(100.0, q))

// Grade from score
get_sweep_grade(float q) =>
    string g = q >= 70.0 ? "A" : q >= 45.0 ? "B" : q >= 25.0 ? "C" : "Reject"
    g

// Check sweep against a LiqLevel
check_sweep_level(LiqLevel lvl) =>
    LiqSweep result = na
    if not na(lvl) and not na(lvl.price)
        bool isSSL_ = lvl.isSSL
        float level = lvl.price
        bool swept = false
        float depth = 0.0

        if isSSL_ and level < close[1] and low <= level and close > level
            depth := level - low
            swept := true
        else if not isSSL_ and level > close[1] and high >= level and close < level
            depth := high - level
            swept := true

        if swept and depth > 0
            float depthAtr = depth / atr
            float rng = high - low
            float wickPen = rng > 0 ? depth / rng : 0.0
            // Rejection: body reclaim ratio — how much of the range is body closing back
            float bodyRatio = rng > 0 ? bodySize / rng : 0.0
            bool rejection = isSSL_ ? close > open : close < open
            float rejStr = rejection ? bodyRatio : 0.0
            bool disp = isSSL_ ? isDispBull : isDispBear

            [sType, sStr] = classify_sweep_type(depthAtr, lvl.isExternal, lvl.isHTF, lvl.isSession, lvl.isCluster, lvl.sourceType)
            float freshness = 1.0
            float q = compute_sweep_quality(depthAtr, wickPen, rejStr, rejection, disp, lvl.priority, lvl.isExternal, lvl.isHTF, lvl.isCluster, lvl.clusterCount, isKillzone, isSilverBullet, sessionWeight, freshness, sType)
            string grade = get_sweep_grade(q)

            result := LiqSweep.new(
                 lvl.name, level, lvl.sourceType, lvl.priority,
                 lvl.isExternal, isSSL_,
                 depth, depthAtr, wickPen, rejStr, rejection, disp,
                 sType, sStr, grade, q,
                 bar_index, LIFE_DETECTED, grade != "Reject", false,
                 lvl.isHTF, lvl.isSession, lvl.isCluster, lvl.clusterCount, false,
                 isKillzone, isSilverBullet, activeSessName)
    result

// --- Run sweep checks against all registered levels ---
if array.size(liqLevels) > 0
    for i = 0 to array.size(liqLevels) - 1
        LiqLevel lvl = array.get(liqLevels, i)
        LiqSweep sw = check_sweep_level(lvl)
        if not na(sw) and sw.isActionable
            // --- Advanced Deduplication ---
            // Check for near-duplicate: same side, similar price, recent
            bool duplicate = false
            int replaceIdx = -1
            if array.size(activeSweeps) > 0
                for j = array.size(activeSweeps) - 1 to math.max(0, array.size(activeSweeps) - 8)
                    LiqSweep existing = array.get(activeSweeps, j)
                    bool sameSide = existing.isSSL == sw.isSSL
                    bool sameName = existing.levelName == sw.levelName
                    bool nearPrice = math.abs(existing.levelPrice - sw.levelPrice) < atr * 0.3
                    bool recentBar = (bar_index - existing.sweepBar) < 5
                    if sameSide and (sameName or nearPrice) and recentBar
                        duplicate := true
                        // Replace if new sweep is stronger
                        if sw.qualityScore > existing.qualityScore
                            replaceIdx := j
                        break
            if not duplicate
                // Lifecycle: promote to ACTIVE if rejection or displacement present
                if sw.hasRejection or sw.hasDisplacement
                    sw.lifecycleState := LIFE_CONFIRMED
                else
                    sw.lifecycleState := LIFE_ACTIVE
                array.push(activeSweeps, sw)
            else if replaceIdx >= 0
                // Stronger sweep replaces weaker on same level
                LiqSweep old = array.get(activeSweeps, replaceIdx)
                sw.lifecycleState := old.lifecycleState == LIFE_CONFIRMED ? LIFE_CONFIRMED : (sw.hasRejection or sw.hasDisplacement ? LIFE_CONFIRMED : LIFE_ACTIVE)
                array.set(activeSweeps, replaceIdx, sw)

// --- Inducement Detection (deterministic only) ---
// Tag a smaller internal sweep only after a larger same-side external/HTF/session event
// is actually taken shortly after it. This keeps inducement as metadata, not prophecy.
if enableInducementTag and array.size(activeSweeps) > 1
    int inducementWindow = sensitivityMode == "Aggressive" ? 6 : sensitivityMode == "Conservative" ? 10 : 8
    for i = 0 to array.size(activeSweeps) - 1
        LiqSweep major = array.get(activeSweeps, i)
        bool majorSweep = (major.isExternal or is_htf_liquidity_source(major.sourceType) or major.sourceType == SRC_SESSION) and major.qualityScore >= 40
        if majorSweep
            for j = 0 to array.size(activeSweeps) - 1
                if i != j
                    LiqSweep minor = array.get(activeSweeps, j)
                    bool sameSide = minor.isSSL == major.isSSL
                    bool minorInternal = minor.sourceType == SRC_PIVOT_INT or (not minor.isExternal and minor.sourcePriority < major.sourcePriority)
                    bool shortLead = minor.sweepBar <= major.sweepBar and (major.sweepBar - minor.sweepBar) <= inducementWindow
                    bool lowerSig = minor.qualityScore < major.qualityScore and minor.sourcePriority < major.sourcePriority
                    if sameSide and minorInternal and shortLead and lowerSig and not minor.isInducementLike
                        minor.isInducementLike := true
                        minor.sweepType := SWEEP_INDUCEMENT
                        minor.sweepTypeStr := "Inducement"
                        minor.qualityScore := math.max(0.0, minor.qualityScore - 8.0)
                        minor.grade := get_sweep_grade(minor.qualityScore)
                        array.set(activeSweeps, j, minor)

// --- Lifecycle Management ---
// Expire stale sweeps, cap count, manage states
if array.size(activeSweeps) > 0
    for i = array.size(activeSweeps) - 1 to 0
        LiqSweep s = array.get(activeSweeps, i)
        int age = bar_index - s.sweepBar
        // Stale detection
        if age > sweepMaxAge
            array.remove(activeSweeps, i)
            continue
        // Degrade lifecycle as sweep ages
        if age > math.round(sweepMaxAge * 0.7) and s.lifecycleState == LIFE_ACTIVE
            s.lifecycleState := LIFE_STALE
            s.isActionable := false
        // Recalculate quality with updated freshness
        float freshness = 1.0 - (float(age) / sweepMaxAge)
        float updatedQ = compute_sweep_quality(s.sweepDepthAtr, s.wickPenetrationRatio, s.rejectionStrength, s.hasRejection, s.hasDisplacement, s.sourcePriority, s.isExternal, s.isHTF, s.isClusterSweep, s.clusterCount, s.inKillzone, s.inSilverBullet, 1.0, freshness, s.sweepType)
        s.qualityScore := updatedQ
        s.grade := get_sweep_grade(updatedQ)
        if updatedQ < 15.0
            s.isActionable := false
        array.set(activeSweeps, i, s)

// Cap sweep count — keep best by quality
while array.size(activeSweeps) > sweepMaxCount
    // Find and remove lowest quality
    int worstIdx = 0
    float worstQ = 999.0
    for i = 0 to array.size(activeSweeps) - 1
        LiqSweep s = array.get(activeSweeps, i)
        if s.qualityScore < worstQ
            worstQ := s.qualityScore
            worstIdx := i
    array.remove(activeSweeps, worstIdx)

// --- Consume sweeps on MSS (lifecycle transition) ---
if mssBull
    if array.size(activeSweeps) > 0
        for i = array.size(activeSweeps) - 1 to 0
            LiqSweep s = array.get(activeSweeps, i)
            if s.isSSL and s.lifecycleState != LIFE_CONSUMED
                s.lifecycleState := LIFE_CONSUMED
                s.isConsumed := true
                array.set(activeSweeps, i, s)
if mssBear
    if array.size(activeSweeps) > 0
        for i = array.size(activeSweeps) - 1 to 0
            LiqSweep s = array.get(activeSweeps, i)
            if not s.isSSL and s.lifecycleState != LIFE_CONSUMED
                s.lifecycleState := LIFE_CONSUMED
                s.isConsumed := true
                array.set(activeSweeps, i, s)

// --- Derived Sweep State (backwards-compatible + enriched) ---
bool sweptSSL = false
bool sweptBSL = false
float sweepQualitySSL = 0.0
float sweepQualityBSL = 0.0
int bestSweepBarSSL = na
int bestSweepBarBSL = na
// Enriched: best sweep metadata per side
string bestSweepTypeSSL = ""
string bestSweepGradeSSL = ""
string bestSweepNameSSL = ""
bool   bestSweepExtSSL = false
int    bestSweepSrcSSL = 0
bool   bestSweepInducementSSL = false
string bestSweepTypeBSL = ""
string bestSweepGradeBSL = ""
string bestSweepNameBSL = ""
bool   bestSweepExtBSL = false
int    bestSweepSrcBSL = 0
bool   bestSweepInducementBSL = false
// Chapter 3: sweep level + depth for reclaim threshold computation
float bestSweepLevelSSL = na
float bestSweepLevelBSL = na
float bestSweepDepthSSL = na
float bestSweepDepthBSL = na

if array.size(activeSweeps) > 0
    for i = 0 to array.size(activeSweeps) - 1
        LiqSweep s = array.get(activeSweeps, i)
        if not s.isActionable and not s.isConsumed
            continue
        if s.isSSL
            sweptSSL := true
            if s.qualityScore > sweepQualitySSL
                sweepQualitySSL := s.qualityScore
                bestSweepBarSSL := s.sweepBar
                bestSweepTypeSSL := s.sweepTypeStr
                bestSweepGradeSSL := s.grade
                bestSweepNameSSL := s.levelName
                bestSweepExtSSL := s.isExternal
                bestSweepSrcSSL := s.sourceType
                bestSweepInducementSSL := s.isInducementLike
                bestSweepLevelSSL := s.levelPrice
                bestSweepDepthSSL := s.sweepDepth
        else
            sweptBSL := true
            if s.qualityScore > sweepQualityBSL
                sweepQualityBSL := s.qualityScore
                bestSweepBarBSL := s.sweepBar
                bestSweepTypeBSL := s.sweepTypeStr
                bestSweepGradeBSL := s.grade
                bestSweepNameBSL := s.levelName
                bestSweepExtBSL := s.isExternal
                bestSweepSrcBSL := s.sourceType
                bestSweepInducementBSL := s.isInducementLike
                bestSweepLevelBSL := s.levelPrice
                bestSweepDepthBSL := s.sweepDepth

// Premium / Discount
int rangeLookback = 50
float pdArray = (ta.highest(rangeLookback) + ta.lowest(rangeLookback)) / 2
string pdStatus = close > pdArray ? "Premium" : "Discount"

// --- Enriched Liquidity Level Map ---
// Nearest levels by category: internal, external, session, HTF, cluster
float nearestBSL = na
float nearestSSL = na
float nearestExtBSL = na
float nearestExtSSL = na
float nearestIntBSL = na
float nearestIntSSL = na
float nearestSessBSL = na
float nearestSessSSL = na
float nearestHTFBSL = na
float nearestHTFSSL = na
float nearestClusterBSL = na
float nearestClusterSSL = na
float nearestRoundBSL = na
float nearestRoundSSL = na
// Source names for dashboard
string nearestBSLName = ""
string nearestSSLName = ""

if array.size(liqLevels) > 0
    for i = 0 to array.size(liqLevels) - 1
        LiqLevel lvl = array.get(liqLevels, i)
        if na(lvl.price)
            continue
        if lvl.isSSL and lvl.price < close
            // SSL: nearest = highest below price
            if na(nearestSSL) or lvl.price > nearestSSL
                nearestSSL := lvl.price
                nearestSSLName := lvl.name
            if lvl.isExternal and (na(nearestExtSSL) or lvl.price > nearestExtSSL)
                nearestExtSSL := lvl.price
            if not lvl.isExternal and (na(nearestIntSSL) or lvl.price > nearestIntSSL)
                nearestIntSSL := lvl.price
            if lvl.isSession and (na(nearestSessSSL) or lvl.price > nearestSessSSL)
                nearestSessSSL := lvl.price
            if lvl.isHTF and (na(nearestHTFSSL) or lvl.price > nearestHTFSSL)
                nearestHTFSSL := lvl.price
            if lvl.isCluster and (na(nearestClusterSSL) or lvl.price > nearestClusterSSL)
                nearestClusterSSL := lvl.price
            if lvl.sourceType == SRC_ROUND_NUM and (na(nearestRoundSSL) or lvl.price > nearestRoundSSL)
                nearestRoundSSL := lvl.price
        else if not lvl.isSSL and lvl.price > close
            // BSL: nearest = lowest above price
            if na(nearestBSL) or lvl.price < nearestBSL
                nearestBSL := lvl.price
                nearestBSLName := lvl.name
            if lvl.isExternal and (na(nearestExtBSL) or lvl.price < nearestExtBSL)
                nearestExtBSL := lvl.price
            if not lvl.isExternal and (na(nearestIntBSL) or lvl.price < nearestIntBSL)
                nearestIntBSL := lvl.price
            if lvl.isSession and (na(nearestSessBSL) or lvl.price < nearestSessBSL)
                nearestSessBSL := lvl.price
            if lvl.isHTF and (na(nearestHTFBSL) or lvl.price < nearestHTFBSL)
                nearestHTFBSL := lvl.price
            if lvl.isCluster and (na(nearestClusterBSL) or lvl.price < nearestClusterBSL)
                nearestClusterBSL := lvl.price
            if lvl.sourceType == SRC_ROUND_NUM and (na(nearestRoundBSL) or lvl.price < nearestRoundBSL)
                nearestRoundBSL := lvl.price

// reqL/reqS: backward-compatible required sweep levels
float reqL = nearestSSL
float reqS = nearestBSL

ict_liquidity_gate(bool isLong, int mssBar_, float mssDisp) =>
    bool ok = false
    bool hasValidExternal = false
    string detail = "No qualifying liquidity sweep detected"
    float bestQ = -1.0
    bool sawAnySweep = false
    bool sawInternalOnly = false
    bool sawWeakMajor = false
    bool sawOutOfSequence = false
    if array.size(activeSweeps) > 0
        for i = 0 to array.size(activeSweeps) - 1
            LiqSweep s = array.get(activeSweeps, i)
            bool sideOk = s.isSSL == isLong
            bool liveOk = s.isActionable or s.isConsumed
            if sideOk and liveOk
                sawAnySweep := true
                bool orderOk = na(mssBar_) or s.sweepBar <= mssBar_
                bool htfSweep = is_htf_liquidity_source(s.sourceType)
                bool strongSession = s.sourceType == SRC_SESSION and s.qualityScore >= 55.0
                bool strongExternal = s.isExternal and s.sourceType != SRC_SESSION and s.sourceType != SRC_PIVOT_INT and s.qualityScore >= 35.0
                bool aggressiveInternal = sensitivityMode == "Aggressive" and s.sourceType == SRC_PIVOT_INT and s.qualityScore >= 72.0 and mssDisp >= 1.2 and (s.hasRejection or s.hasDisplacement)
                bool hardQualified = htfSweep or strongSession or strongExternal or aggressiveInternal
                if orderOk and (htfSweep or strongSession or strongExternal)
                    hasValidExternal := true
                if not orderOk
                    sawOutOfSequence := true
                else if s.sourceType == SRC_PIVOT_INT and not aggressiveInternal
                    sawInternalOnly := true
                else if not hardQualified
                    sawWeakMajor := true

                if orderOk and hardQualified and s.qualityScore > bestQ
                    ok := true
                    bestQ := s.qualityScore
                    detail := s.levelName + " — " + source_category_label(s.sourceType, "")
                    if s.isInducementLike
                        detail := detail + " (preconditioned by inducement)"
    if not ok
        detail := not sawAnySweep ? "No liquidity sweep detected" : sawOutOfSequence ? "Sweep came after structure shift (wrong sequence)" : sawInternalOnly ? "Only internal liquidity swept — need external" : sawWeakMajor ? "Sweep quality insufficient for this strategy" : detail
    [ok, detail, hasValidExternal]

silver_bullet_liquidity_gate(bool isLong) =>
    bool ok = false
    bool hasValidSessionSweep = false
    string detail = "No qualifying sweep in Silver Bullet window"
    float bestQ = -1.0
    bool sawWindowSweep = false
    bool sawWeakWindowSweep = false
    int sbWindowBars = math.max(1, int(math.round(3600.0 / timeframe.in_seconds(timeframe.period)))) + 1
    if array.size(activeSweeps) > 0
        for i = 0 to array.size(activeSweeps) - 1
            LiqSweep s = array.get(activeSweeps, i)
            bool sideOk = s.isSSL == isLong
            bool liveOk = s.isActionable or s.isConsumed
            bool windowFresh = (bar_index - s.sweepBar) <= sbWindowBars
            if sideOk and liveOk and s.inSilverBullet and windowFresh
                sawWindowSweep := true
                bool validSession = s.sourceType == SRC_SESSION and s.qualityScore >= 42.0
                bool validExternal = (s.isExternal or is_htf_liquidity_source(s.sourceType)) and s.qualityScore >= 35.0
                if validSession
                    hasValidSessionSweep := true
                if (validSession or validExternal) and s.qualityScore > bestQ
                    ok := true
                    bestQ := s.qualityScore
                    detail := s.levelName + " — " + source_category_label(s.sourceType, "")
                else if not (validSession or validExternal)
                    sawWeakWindowSweep := true
    if not ok
        detail := not sawWindowSweep ? "No qualifying liquidity in Silver Bullet window" : sawWeakWindowSweep ? "Silver Bullet window sweep not structural enough" : detail
    [ok, detail, hasValidSessionSweep]

// --- OB Confluence Check: is price near an unmitigated OB? ---
bool obBullConfluence = false
bool obBearConfluence = false
if array.size(obArray) > 0
    for i = 0 to array.size(obArray) - 1
        SmartZone ob = array.get(obArray, i)
        if not ob.mitigated
            if ob.isBull and low <= ob.top and close >= ob.bottom
                obBullConfluence := true
            if not ob.isBull and high >= ob.bottom and close <= ob.top
                obBearConfluence := true

// --- Setup Readiness Evaluation ---
// =====================================================================
// --- SETUP LIFECYCLE HELPERS (Chapter 1: State Machine Integrity) ---
// =====================================================================

lifecycle_name(int lc) =>
    lc == LC_NONE ? "No setup"
     : lc == LC_LIQUIDITY_IDENTIFIED ? "Liquidity identified"
     : lc == LC_SWEEP_CONFIRMED ? "Liquidity swept"
     : lc == LC_RECLAIM_VISIBLE ? "Reclaim visible"
     : lc == LC_MSS_CONFIRMED ? "Structure confirmed"
     : lc == LC_DISPLACEMENT_CONFIRMED ? "Displacement confirmed"
     : lc == LC_ENTRY_ARMED ? "Setup ready"
     : lc == LC_ENTRY_TRIGGERED ? "Entry triggered"
     : lc == LC_ACTIVE ? "Trade active"
     : lc == LC_EXPIRED ? "Setup expired"
     : lc == LC_INVALIDATED ? "Setup invalidated"
     : lc == LC_DESYNC ? "State desync" : "Unknown"

lifecycle_allows_activation(int lc) =>
    lc == LC_ENTRY_TRIGGERED or lc == LC_ACTIVE

lifecycle_is_preconfirmation(int lc) =>
    lc <= LC_SWEEP_CONFIRMED

lifecycle_is_terminal(int lc) =>
    lc == LC_EXPIRED or lc == LC_INVALIDATED or lc == LC_DESYNC

lifecycle_action_text(int lc) =>
    lc == LC_NONE ? "Stand aside — no setup"
     : lc == LC_LIQUIDITY_IDENTIFIED ? "Monitor liquidity — prepare for sweep"
     : lc == LC_SWEEP_CONFIRMED ? "Wait for structure shift"
     : lc == LC_RECLAIM_VISIBLE ? "Wait for confirmed structure shift"
     : lc == LC_MSS_CONFIRMED ? "Wait for displacement / entry development"
     : lc == LC_DISPLACEMENT_CONFIRMED ? "Wait for entry zone"
     : lc == LC_ENTRY_ARMED ? "Setup ready — monitor trigger"
     : lc == LC_ENTRY_TRIGGERED ? "Entry triggered — validate activation"
     : lc == LC_ACTIVE ? "Trade active — manage position"
     : lc == LC_EXPIRED ? "No trade — setup expired"
     : lc == LC_INVALIDATED ? "No trade — setup invalidated"
     : lc == LC_DESYNC ? "State error — setup/trade desync" : "Unknown state"

lifecycle_next_required(int lc, bool isLong, float pivotVal, float reqLevel) =>
    string side = isLong ? "bullish" : "bearish"
    string liqSide = isLong ? "sell-side" : "buy-side"
    string result = ""
    if lc == LC_NONE
        result := "Identify " + liqSide + " liquidity to target"
    else if lc == LC_LIQUIDITY_IDENTIFIED
        result := "Wait for " + liqSide + " liquidity sweep" + (na(reqLevel) ? "" : " at " + str.tostring(reqLevel, "#.#####"))
    else if lc == LC_SWEEP_CONFIRMED
        result := "Need " + side + " structure shift" + (na(pivotVal) ? "" : " — break " + (isLong ? "above " : "below ") + str.tostring(pivotVal, "#.#####"))
    else if lc == LC_RECLAIM_VISIBLE
        result := "Need confirmed " + side + " structure shift"
    else if lc == LC_MSS_CONFIRMED
        result := "Need fresh " + side + " displacement / imbalance"
    else if lc == LC_DISPLACEMENT_CONFIRMED
        result := "Need " + side + " imbalance / entry zone formation"
    else if lc == LC_ENTRY_ARMED
        result := "Monitor retrace / trigger into entry zone"
    else if lc == LC_ENTRY_TRIGGERED
        result := "Validate entry conditions for activation"
    else if lc == LC_ACTIVE
        result := "Manage active position"
    else if lc == LC_EXPIRED
        result := "Setup expired — wait for fresh sequence"
    else if lc == LC_INVALIDATED
        result := "Setup invalidated — wait for fresh sequence"
    else if lc == LC_DESYNC
        result := "Internal state contradiction detected"
    result

// =====================================================================
// --- SENSITIVITY MODE EXECUTION POLICY (Chapter 2) ---
// =====================================================================

// Mode policy helpers — central source of truth for mode behavior
mode_min_lifecycle_for_candidate(string mode) =>
    mode == "Aggressive" ? LC_MSS_CONFIRMED : mode == "Conservative" ? LC_ENTRY_ARMED : LC_DISPLACEMENT_CONFIRMED

mode_min_lifecycle_for_activation(string mode) =>
    mode == "Aggressive" ? LC_ENTRY_TRIGGERED : mode == "Conservative" ? LC_ENTRY_ARMED : LC_ENTRY_ARMED

mode_requires_retrace_for_activation(string mode) =>
    mode != "Aggressive"

mode_allows_direct_signal_activation(string mode) =>
    mode == "Aggressive"

mode_requires_displacement(string _mode) =>
    true

mode_requires_reclaim_proxy(string _mode) =>
    true

mode_name_short(string mode) =>
    mode == "Aggressive" ? "AGG" : mode == "Conservative" ? "CON" : "BAL"

// =====================================================================
// --- CHAPTER 2.2: QUALITY RECOVERY PATCH — Transitional Quality Helpers ---
// =====================================================================

// =====================================================================
// --- CHAPTER 3: RECLAIM STAGE EVALUATOR ---
// Formal structural reclaim assessment after liquidity sweep.
// Replaces crude reclaim proxy with graded, acceptance-aware, failable model.
// Returns: [detected, weak, valid, strong_, failed, score, reason, newAccept, threshold]
// =====================================================================
evaluate_reclaim_stage(bool isLong, int sweepBar_, float sweepLevel_, float sweepDepth_,
                       float atrVal, int prevAccept, bool prevFailed, int prevSweepRef) =>
    bool detected = false
    bool weak = false
    bool valid = false
    bool strong_ = false
    bool failed = prevFailed
    float score = 0.0
    string reason = "No sweep context"
    int acceptBars = 0
    float threshold = na

    if not na(sweepBar_) and not na(sweepLevel_) and atrVal > 0
        int age = bar_index - sweepBar_
        // Compute sweep extreme: for long, the low that swept below level; for short, the high above
        float sweepExtreme = na
        if not na(sweepDepth_)
            sweepExtreme := isLong ? sweepLevel_ - sweepDepth_ : sweepLevel_ + sweepDepth_

        if age >= 0 and age <= 50
            // --- Reclaim threshold computation ---
            // Primary: the swept liquidity level itself (must be reclaimed)
            float primaryThresh = sweepLevel_
            // Secondary: midpoint between sweep extreme and sweep level (early recovery reference)
            float midThresh = not na(sweepExtreme) ? (sweepExtreme + sweepLevel_) / 2.0 : sweepLevel_
            // Recovery band: minimum meaningful recovery = 40% of sweep depth from extreme
            float recoveryBand = not na(sweepExtreme) and not na(sweepDepth_) and sweepDepth_ > 0 ?
                 sweepExtreme + (isLong ? 1 : -1) * sweepDepth_ * 0.4 : midThresh
            threshold := primaryThresh

            // --- Directional checks ---
            bool abovePrimary = isLong ? close > primaryThresh : close < primaryThresh
            bool aboveMid = isLong ? close > midThresh : close < midThresh
            bool aboveRecovBand = isLong ? close > recoveryBand : close < recoveryBand
            bool dirCandle = isLong ? close > open : close < open

            // --- Reset tracking on new sweep ---
            bool sameRef = not na(prevSweepRef) and prevSweepRef == sweepBar_
            if not sameRef
                // New sweep — reset acceptance, clear failure
                acceptBars := 0
                failed := false
            else
                acceptBars := prevAccept

            // --- Reclaim detection ---
            if abovePrimary
                detected := true
                // Accumulate acceptance bars
                acceptBars := acceptBars + 1
            else if aboveRecovBand or aboveMid
                detected := true
                // Early/partial reclaim — don't accumulate acceptance
                if not abovePrimary and acceptBars > 0
                    // Was above, now lost primary but still in recovery band
                    acceptBars := math.max(0, acceptBars - 1)

            // --- Score computation (0-100) ---
            // 1. Recovery distance from sweep extreme (0-25)
            float recoveryDist = 0.0
            if not na(sweepExtreme)
                recoveryDist := isLong ? (close - sweepExtreme) / atrVal : (sweepExtreme - close) / atrVal
            score += math.min(math.max(recoveryDist * 10.0, 0.0), 25.0)

            // 2. Primary threshold acceptance (0-20)
            score += abovePrimary ? 15.0 : (aboveMid ? 6.0 : (aboveRecovBand ? 3.0 : 0.0))
            score += dirCandle ? 5.0 : 0.0

            // 3. Acceptance bar count (0-20) — sustained holds are more meaningful
            score += math.min(float(acceptBars) * 6.0, 20.0)

            // 4. No re-sweep of extreme (0-15)
            bool noRetest = true
            if age >= 2
                int checkBars = math.min(age, 5)
                for i = 0 to checkBars - 1
                    bool retested = not na(sweepExtreme) ?
                         (isLong ? low[i] <= sweepExtreme : high[i] >= sweepExtreme) :
                         (isLong ? low[i] <= sweepLevel_ - atrVal * 0.3 : high[i] >= sweepLevel_ + atrVal * 0.3)
                    if retested
                        noRetest := false
            score += noRetest ? 15.0 : 0.0

            // 5. Age freshness (0-10) — reclaim soon after sweep is more meaningful
            score += math.max(0.0, 10.0 - float(age) * 0.25)

            // 6. Multi-bar holding bonus (0-10)
            if acceptBars >= 2
                bool priorHeld = isLong ? close[1] > primaryThresh : close[1] < primaryThresh
                score += priorHeld ? 10.0 : 4.0

            score := math.min(score, 100.0)

            // --- Grade reclaim ---
            if detected
                weak := score < 35.0
                valid := score >= 35.0
                strong_ := score >= 60.0

            // --- Failed reclaim detection ---
            if not failed and sameRef and prevAccept >= 2
                // Had meaningful acceptance, now check for loss
                bool lostPrimary = isLong ? close < primaryThresh - atrVal * 0.15 : close > primaryThresh + atrVal * 0.15
                if lostPrimary
                    failed := true
                    detected := false
                    valid := false
                    strong_ := false
                    reason := "Reclaim lost after " + str.tostring(prevAccept) + " acceptance bars"

            if not failed and sameRef
                // Check for new extreme beyond sweep (invalidates reclaim entirely)
                bool newExtreme = not na(sweepExtreme) ?
                     (isLong ? low < sweepExtreme - atrVal * 0.1 : high > sweepExtreme + atrVal * 0.1) :
                     (isLong ? low < sweepLevel_ - atrVal * 0.5 : high > sweepLevel_ + atrVal * 0.5)
                if newExtreme
                    failed := true
                    detected := false
                    valid := false
                    strong_ := false
                    reason := "New extreme beyond sweep — reclaim invalidated"

            // --- Build reason string ---
            if not failed
                if strong_
                    reason := "Strong (" + str.tostring(math.round(score)) + ") — " + str.tostring(acceptBars) + " bars accepted"
                else if valid
                    reason := "Valid (" + str.tostring(math.round(score)) + ") — " + str.tostring(acceptBars) + " bars"
                else if weak and detected
                    reason := "Weak (" + str.tostring(math.round(score)) + ") — early recovery"
                else if not detected
                    reason := "No reclaim yet (age " + str.tostring(age) + ")"
        else
            // Sweep too old for reclaim tracking
            reason := "Sweep aged out (" + str.tostring(age) + " bars)"
            failed := true

    [detected, weak, valid, strong_, failed, score, reason, acceptBars, threshold]

// Mode-dependent reclaim pass: maps formal reclaim grades to mode thresholds (Chapter 3)
reclaim_mode_pass(bool detected_, bool valid_, bool strong_, float score_, string mode) =>
    bool pass = false
    if mode == "Aggressive"
        pass := detected_ and score_ >= 15.0
    else if mode == "Conservative"
        pass := strong_ or score_ >= 55.0
    else // Balanced
        pass := valid_ or score_ >= 35.0
    pass

// =====================================================================
// --- CHAPTER 4: MSS / STRUCTURE SHIFT VALIDATION ---
// Formal structural shift assessment after sweep + reclaim.
// Replaces lightweight MSS quality shortcuts with graded, significance-aware,
// break-quality-validated, failable MSS truth.
// NOTE: This chapter improves structural truth and setup quality. Performance
// gains remain limited by the current generic entry/SL/TP scaffold.
// =====================================================================

// --- Part B+C: Trigger Level Significance Classification ---
// Evaluates whether the pivot being broken is meaningful protected structure
// or trivial internal noise.
// Returns: [triggerType, significance, sigScore]
// significance: 0=trivial, 1=internal-relevant, 2=protected, 3=strongly-protected
classify_mss_trigger(bool isLong, float triggerLevel, int triggerBar, bool triggerIsExternal,
                      float sweepLevel_, float atrVal, float rangeSpan_, float rangeHigh_, float rangeLow_) =>
    string trigType = "unknown"
    int significance = 0
    float sigScore = 0.0
    if not na(triggerLevel) and not na(triggerBar) and atrVal > 0
        int pivotAge = bar_index - triggerBar
        float distFromSweep = not na(sweepLevel_) ? math.abs(triggerLevel - sweepLevel_) / atrVal : 0.0
        float rangePos = rangeSpan_ > 0 ? (triggerLevel - rangeLow_) / rangeSpan_ : 0.5
        // 1. Pivot age freshness (0-20)
        sigScore += math.max(0.0, 20.0 - float(pivotAge) * 0.3)
        // 2. External vs internal (0-20)
        if triggerIsExternal
            sigScore += 20.0
            trigType := "protected-external"
        else
            float edgeDist = rangeSpan_ > 0 ? (isLong ? (rangeHigh_ - triggerLevel) / rangeSpan_ : (triggerLevel - rangeLow_) / rangeSpan_) : 0.5
            if edgeDist < 0.3
                sigScore += 14.0
                trigType := "protected-range"
            else
                sigScore += 6.0
                trigType := "internal"
        // 3. Distance from sweep (0-15)
        if distFromSweep > 0.5
            sigScore += math.min(distFromSweep * 5.0, 15.0)
        else if distFromSweep > 0.2
            sigScore += 5.0
        // 4. Pivot prominence via post-pivot depth (0-20)
        float postPivotMove = isLong ? (triggerLevel - rangeLow_) : (rangeHigh_ - triggerLevel)
        float swingDepth = atrVal > 0 ? postPivotMove / atrVal : 0.0
        sigScore += math.min(swingDepth * 4.0, 20.0)
        // 5. Range position appropriateness (0-10)
        bool posOk = isLong ? rangePos > 0.35 : rangePos < 0.65
        sigScore += posOk ? 10.0 : 3.0
        // 6. Micro-pivot penalty
        if swingDepth < 0.3
            sigScore -= 10.0
        sigScore := math.max(0.0, math.min(100.0, sigScore))
        // Classify tier
        if sigScore >= 65.0
            significance := 3
            if trigType == "internal"
                trigType := "protected"
        else if sigScore >= 45.0
            significance := 2
        else if sigScore >= 25.0
            significance := 1
        else
            significance := 0
    [trigType, significance, sigScore]

// --- Part D: Break Quality Evaluation ---
// Assesses whether the structure break is decisive or a weak wick-through.
// Returns: [bodyConfirmed, followThrough, decisive, weak, qualityScore]
evaluate_break_quality(bool isLong, float triggerLevel, float breakClose, float breakOpen,
                        float breakHigh, float breakLow, float atrVal) =>
    bool bodyConfirmed = false
    bool followThrough = false
    bool decisive = false
    bool weak = true
    float qualityScore = 0.0
    if not na(triggerLevel) and atrVal > 0
        float breakRange = breakHigh - breakLow
        float breakBody = math.abs(breakClose - breakOpen)
        // 1. Close beyond trigger (25)
        bool closedThrough = isLong ? breakClose > triggerLevel : breakClose < triggerLevel
        if closedThrough
            qualityScore += 25.0
        // 2. Body size relative to ATR (0-20)
        float bodyAtrRatio = breakBody / atrVal
        qualityScore += math.min(bodyAtrRatio * 15.0, 20.0)
        // 3. Body confirmation: correct direction + meaningful body
        bodyConfirmed := closedThrough and (isLong ? breakClose > breakOpen : breakClose < breakOpen) and breakBody > atrVal * 0.3
        if bodyConfirmed
            qualityScore += 15.0
        // 4. Close location in candle range (0-15)
        float closeRatio = breakRange > 0 ? (isLong ? (breakClose - breakLow) / breakRange : (breakHigh - breakClose) / breakRange) : 0.5
        qualityScore += closeRatio * 15.0
        // 5. Break distance beyond level (0-15)
        float breakDist = isLong ? (breakClose - triggerLevel) / atrVal : (triggerLevel - breakClose) / atrVal
        if breakDist > 0
            qualityScore += math.min(breakDist * 15.0, 15.0)
        else
            qualityScore -= 10.0
        // 6. Barely-through penalty
        if math.abs(breakDist) < 0.1 and not bodyConfirmed
            qualityScore -= 10.0
        // 7. Follow-through hint
        followThrough := closedThrough and bodyConfirmed and bodyAtrRatio > 0.5
        if followThrough
            qualityScore += 10.0
        qualityScore := math.max(0.0, math.min(100.0, qualityScore))
        decisive := qualityScore >= 60.0
        weak := qualityScore < 35.0
    [bodyConfirmed, followThrough, decisive, weak, qualityScore]

// --- Part A+E: Formal MSS Stage Evaluator ---
// Main authority for structure-shift truth. Replaces evaluate_mss_quality().
// Returns: [detected, weak, valid, strong_, fresh, failed, score, reason, failReason,
//           breakLevel, bodyConfirmed, trigType, trigSig, followBars, breakQualScore]
evaluate_mss_stage(bool isLong, int sweepBar_, bool reclaimDetected_, bool reclaimValid_,
                    int mssBar_, float mssDisp_, float triggerLevel, int triggerBar,
                    bool triggerIsExternal, float sweepLevel_, float atrVal,
                    float rangeSpan_, float rangeHigh_, float rangeLow_,
                    string mode, int prevMssRefBar, float prevMssScore, bool prevMssFailed,
                    int prevFollowBars, bool prevBodyConf, float prevBreakQScore) =>
    bool detected = false
    bool mssWeak = false
    bool valid = false
    bool strong_ = false
    bool fresh = true
    bool failed = prevMssFailed
    float score = 0.0
    string reason = "No MSS context"
    string failReason = ""
    float breakLvl = na
    bool bodyConf = prevBodyConf
    string trigType = ""
    int trigSig = 0
    int followBars = prevFollowBars
    float breakQScore = prevBreakQScore
    if not na(mssBar_) and atrVal > 0
        int mssAge = bar_index - mssBar_
        bool afterSweep = not na(sweepBar_) and mssBar_ >= sweepBar_
        // Reset on new MSS event
        bool newMss = na(prevMssRefBar) or mssBar_ != prevMssRefBar
        if newMss
            failed := false
            followBars := 0
            bodyConf := false
            breakQScore := 0.0
        // --- Trigger significance (Part B+C) ---
        [tType, tSig, tScore] = classify_mss_trigger(isLong, triggerLevel, triggerBar, triggerIsExternal, sweepLevel_, atrVal, rangeSpan_, rangeHigh_, rangeLow_)
        trigType := tType
        trigSig := tSig
        // --- Break quality (Part D) — on fresh MSS bar ---
        if newMss and mssAge <= 2
            [bConf, _bFollow, _bDecisive, _bWeak, bScore] = evaluate_break_quality(isLong, triggerLevel, close[mssAge], open[mssAge], high[mssAge], low[mssAge], atrVal)
            bodyConf := bConf
            breakQScore := bScore
        breakLvl := triggerLevel
        // --- Sequence validation ---
        float seqScore = 0.0
        if afterSweep
            seqScore += 15.0
            if reclaimDetected_
                seqScore += 10.0
            if reclaimValid_
                seqScore += 5.0
        else if not na(sweepBar_)
            seqScore -= 10.0
        // --- Freshness (Part E) ---
        int mssMaxFresh = mode == "Aggressive" ? 35 : mode == "Conservative" ? 18 : 25
        fresh := mssAge <= mssMaxFresh
        if not fresh and not failed
            failed := true
            failReason := "MSS stale (" + str.tostring(mssAge) + " bars)"
        // --- Follow-through tracking ---
        if not newMss and not failed and mssAge >= 1 and not na(triggerLevel)
            bool holdingBreak = isLong ? close > triggerLevel : close < triggerLevel
            if holdingBreak
                followBars := followBars + 1
            else if followBars > 0
                followBars := followBars - 1
        // --- MSS failure detection (Part E) ---
        if not failed and not newMss and mssAge >= 2 and not na(triggerLevel)
            bool lostBreak = isLong ? close < triggerLevel - atrVal * 0.15 : close > triggerLevel + atrVal * 0.15
            if lostBreak and followBars <= 1
                failed := true
                failReason := "Break lost — price recrossed trigger"
        // --- Composite score ---
        score += math.min(tScore * 0.3, 30.0)
        score += math.min(breakQScore * 0.3, 30.0)
        score += math.max(0.0, math.min(seqScore, 20.0))
        float dispScore = not na(mssDisp_) ? math.min(mssDisp_ * 10.0, 15.0) : 0.0
        score += dispScore
        score += math.min(float(followBars) * 2.0, 5.0)
        if mssAge > math.round(mssMaxFresh * 0.5)
            float decay = float(mssAge - math.round(mssMaxFresh * 0.5)) / float(mssMaxFresh) * 15.0
            score -= decay
        score := math.max(0.0, math.min(100.0, score))
        // --- Grading ---
        detected := not failed
        if detected
            mssWeak := score < 35.0 or trigSig == 0
            valid := score >= 35.0 and trigSig >= 1
            strong_ := score >= 60.0 and trigSig >= 2 and bodyConf
        if failed
            detected := false
            valid := false
            strong_ := false
            reason := "MSS failed: " + failReason
        else if strong_
            reason := "Strong MSS (" + str.tostring(math.round(score)) + ") — " + trigType
        else if valid
            reason := "Valid MSS (" + str.tostring(math.round(score)) + ") — " + trigType
        else if detected and mssWeak
            reason := "Weak MSS (" + str.tostring(math.round(score)) + ") — " + (trigSig == 0 ? "trivial trigger" : "low quality break")
        else
            reason := na(sweepBar_) ? "No sweep context" : not afterSweep ? "MSS before sweep" : "No MSS detected"
    [detected, mssWeak, valid, strong_, fresh, failed, score, reason, failReason, breakLvl, bodyConf, trigType, trigSig, followBars, breakQScore]

// Mode-dependent MSS pass: maps formal MSS grades to mode thresholds (Chapter 4)
// Returns: [pass, passStrong]
mss_mode_pass(bool detected_, bool valid_, bool strong_, float score_, int trigSig_, string mode) =>
    bool pass = false
    bool passStrong = false
    if mode == "Aggressive"
        pass := detected_ and score_ >= 20.0
        passStrong := valid_ and score_ >= 50.0
    else if mode == "Conservative"
        pass := valid_ and trigSig_ >= 2 and score_ >= 50.0
        passStrong := strong_ and trigSig_ >= 2 and score_ >= 65.0
    else // Balanced
        pass := valid_ and trigSig_ >= 1 and score_ >= 35.0
        passStrong := strong_ or (valid_ and score_ >= 55.0 and trigSig_ >= 2)
    [pass, passStrong]

// Extension filter: blocks chased entries too far from structural anchor.
// Returns: [isExtended, distanceAtr, reason]
compute_extension_block(bool isLong, int mssBar_, float pivotVal, float atrVal, string mode, float reqLevel) =>
    bool isExtended = false
    float distAtr = 0.0
    string reason = ""
    if atrVal > 0
        float anchor = not na(pivotVal) ? pivotVal : reqLevel
        if not na(anchor)
            distAtr := isLong ? (close - anchor) / atrVal : (anchor - close) / atrVal
            float maxExt = mode == "Aggressive" ? 1.5 : mode == "Conservative" ? 0.7 : 1.0
            if distAtr > maxExt
                isExtended := true
                reason := str.tostring(distAtr, "#.##") + " ATR > " + str.tostring(maxExt, "#.#") + " max"
        if not isExtended and not na(mssBar_)
            int barsSince = bar_index - mssBar_
            int maxBars = mode == "Aggressive" ? 15 : mode == "Conservative" ? 8 : 12
            if barsSince > maxBars
                isExtended := true
                reason := str.tostring(barsSince) + " bars since MSS > " + str.tostring(maxBars)
    [isExtended, distAtr, reason]

// MSS quality gate: ensures MSS is meaningful, fresh, and post-sweep.
// Returns: [qualityPass, qualityStrong, reason]
evaluate_mss_quality(int sweepBar_, int mssBar_, float mssDisp_, float atrVal, string mode) =>
    bool qualityPass = false
    bool qualityStrong = false
    string reason = ""
    if not na(mssBar_) and not na(sweepBar_)
        bool afterSweep = mssBar_ >= sweepBar_
        int mssAge = bar_index - mssBar_
        int mssMaxFresh = mode == "Aggressive" ? 30 : mode == "Conservative" ? 15 : 20
        bool isFresh = mssAge <= mssMaxFresh
        float minDisp = mode == "Aggressive" ? 0.4 : mode == "Conservative" ? 1.0 : 0.7
        bool dispOk = not na(mssDisp_) and mssDisp_ >= minDisp
        if not afterSweep
            reason := "MSS before sweep"
        else if not isFresh
            reason := "MSS stale (" + str.tostring(mssAge) + " bars)"
        else if not dispOk
            reason := "Disp " + str.tostring(nz(mssDisp_), "#.##") + " < " + str.tostring(minDisp, "#.#")
        else
            qualityPass := true
            qualityStrong := mssAge <= math.round(mssMaxFresh / 2) and mssDisp_ >= minDisp * 1.5
            reason := "OK" + (qualityStrong ? " [strong]" : "")
    else
        reason := na(mssBar_) ? "No MSS" : "No sweep"
    [qualityPass, qualityStrong, reason]

// Displacement/FVG bridge: compensates for incomplete entry-arming.
// Returns: [bridgePass, bridgeStrong, reason]
evaluate_displacement_bridge(float mssDisp_, int fvgBar_, int fvgGrade_, bool fvgMitigated, bool seqOk, int mssBar_, string mode) =>
    bool bridgePass = false
    bool bridgeStrong = false
    string reason = ""
    float minDisp = mode == "Conservative" ? 1.5 : mode == "Balanced" ? 1.0 : 0.5
    bool dispOk = not na(mssDisp_) and mssDisp_ >= minDisp
    bool hasFreshFvg = not na(fvgBar_) and fvgGrade_ >= 2 and not fvgMitigated
    bool fvgAfterMss = hasFreshFvg and not na(mssBar_) and fvgBar_ >= mssBar_
    int fvgAge = not na(fvgBar_) ? bar_index - fvgBar_ : 999
    bool fvgFresh = fvgAge <= 20
    if mode == "Conservative"
        bridgePass := dispOk and (seqOk or (fvgAfterMss and fvgFresh and fvgGrade_ >= 2))
        bridgeStrong := dispOk and mssDisp_ >= 2.0 and seqOk and hasFreshFvg
    else if mode == "Balanced"
        bridgePass := dispOk and (seqOk or hasFreshFvg or mssDisp_ >= 1.5)
        bridgeStrong := dispOk and mssDisp_ >= 1.5 and (seqOk or (fvgAfterMss and fvgFresh))
    else
        bridgePass := dispOk
        bridgeStrong := not na(mssDisp_) and mssDisp_ >= 1.0
    if bridgePass
        reason := "Bridge OK" + (bridgeStrong ? " [strong]" : "")
    else
        reason := "Bridge fail"
        if not dispOk
            reason := reason + " — disp " + str.tostring(nz(mssDisp_), "#.##") + " < " + str.tostring(minDisp, "#.#")
    [bridgePass, bridgeStrong, reason]

// Pending structural freshness: blocks stale pending setups.
// Returns: [fresh, stale, reason]
// Chapter 4: mssFailed_ added to block on failed MSS
pending_is_structurally_fresh(int signalBar, int mssBar_, int fvgBar_, bool degraded, bool isExtended, string mode, bool mssFailed_) =>
    bool fresh = true
    bool stale = false
    string reason = "Structurally fresh"
    int age = bar_index - signalBar
    int maxFresh = mode == "Aggressive" ? 5 : mode == "Conservative" ? 4 : 5
    if age > maxFresh
        fresh := false
        stale := true
        reason := "Age " + str.tostring(age) + " > " + str.tostring(maxFresh) + " bars"
    if fresh and not na(mssBar_)
        int mssAge = bar_index - mssBar_
        int mssMaxFresh = mode == "Conservative" ? 15 : mode == "Balanced" ? 25 : 35
        if mssAge > mssMaxFresh
            fresh := false
            stale := true
            reason := "MSS aged (" + str.tostring(mssAge) + " bars)"
    if fresh and degraded
        fresh := false
        stale := true
        reason := "Setup degraded"
    if fresh and isExtended
        fresh := false
        stale := true
        reason := "Price too extended"
    if fresh and mssFailed_
        fresh := false
        stale := true
        reason := "MSS failed — structure invalidated"
    [fresh, stale, reason]

// Central mode qualification function (Chapter 2.2 + Chapter 4: MSS-truth-aware).
// Returns: [meetsModeCandidate, meetsModeActivation, blockReason, allowDirectPromotion, activationPath]
evaluate_mode_execution(string mode, int lifecycle, bool swept, float sweepQ, bool hasMss, float mssDisp_, bool hasFvg, int fvgGrade_, bool seqOk, bool expired, bool degraded, bool reclaimPass, float reclaimStr, bool reclaimStrong, bool isExtended, bool mssQualPass, bool mssQualStrong, bool bridgePass, bool bridgeStrong, int score, int mssTrigSig) =>
    int minCandidate = mode_min_lifecycle_for_candidate(mode)
    bool meetsCandidate = lifecycle >= minCandidate and not expired and not degraded
    bool meetsActivation = false
    bool allowDirect = mode_allows_direct_signal_activation(mode)
    string blockReason = ""
    string actPath = ""

    // All modes: reject sweep-only
    if lifecycle <= LC_SWEEP_CONFIRMED
        meetsCandidate := false
        blockReason := "Sweep-only — need structure shift"

    // Extension filter: block candidate for non-Aggressive if too extended
    if meetsCandidate and isExtended and mode != "Aggressive"
        meetsCandidate := false
        blockReason := mode_name_short(mode) + " blocked — entry too extended"

    if not meetsCandidate
        if blockReason == ""
            blockReason := mode_name_short(mode) + " needs " + lifecycle_name(minCandidate)
    else
        // --- Activation qualification (Chapter 2.2: quality-gate driven) ---
        if mode == "Aggressive"
            // AGG: lifecycle >= ENTRY_TRIGGERED or promoted from DISPLACEMENT_CONFIRMED
            bool standardOk = lifecycle >= LC_ENTRY_TRIGGERED and hasMss and reclaimPass
            bool promoOk = lifecycle >= LC_DISPLACEMENT_CONFIRMED and reclaimPass and (not na(mssDisp_) and mssDisp_ >= 0.3)
            if standardOk
                meetsActivation := true
                actPath := "AGG standard"
            else if promoOk
                meetsActivation := true
                actPath := "AGG promo"
            else
                blockReason := "AGG: " + (not hasMss ? "no MSS" : not reclaimPass ? "reclaim " + str.tostring(math.round(reclaimStr)) + " insufficient" : "lifecycle insufficient")

        else if mode == "Balanced"
            // BAL IDEAL: lifecycle >= ENTRY_ARMED + reclaim + MSS quality + not extended
            bool idealOk = lifecycle >= LC_ENTRY_ARMED and reclaimPass and mssQualPass and not isExtended
            // BAL BRIDGE: DISPLACEMENT_CONFIRMED + higher quality
            bool bridgeOk = lifecycle >= LC_DISPLACEMENT_CONFIRMED and lifecycle < LC_ENTRY_ARMED and reclaimStr >= 40.0 and mssQualPass and bridgePass and not isExtended
            if idealOk
                meetsActivation := true
                actPath := "BAL ideal"
            else if bridgeOk
                meetsActivation := true
                actPath := "BAL bridge"
            else
                blockReason := not reclaimPass ? "BAL: reclaim insufficient (" + str.tostring(math.round(reclaimStr)) + ")" : not mssQualPass ? "BAL: MSS quality insufficient" : isExtended ? "BAL: entry too extended" : lifecycle < LC_ENTRY_ARMED and not bridgeOk ? "BAL: bridge conditions not met" : "BAL: activation not met"

        else // Conservative
            // CON IDEAL: lifecycle >= ENTRY_ARMED + strong reclaim + strong MSS + seqOk + protected trigger
            bool idealOk = lifecycle >= LC_ENTRY_ARMED and reclaimPass and reclaimStr >= 50.0 and mssQualStrong and not isExtended and seqOk and mssTrigSig >= 2
            // CON BRIDGE: DISPLACEMENT_CONFIRMED + ALL strong + protected trigger
            bool bridgeOk = lifecycle >= LC_DISPLACEMENT_CONFIRMED and lifecycle < LC_ENTRY_ARMED and reclaimStrong and mssQualStrong and bridgeStrong and not isExtended and (seqOk or (hasFvg and fvgGrade_ >= 2)) and mssTrigSig >= 2
            if idealOk
                meetsActivation := true
                actPath := "CON ideal"
            else if bridgeOk
                meetsActivation := true
                actPath := "CON bridge"
            else
                blockReason := not reclaimStrong and reclaimStr < 50.0 ? "CON: reclaim not strong (" + str.tostring(math.round(reclaimStr)) + ")" : not mssQualStrong ? "CON: MSS quality not strong" : mssTrigSig < 2 ? "CON: protected structure not broken (sig=" + str.tostring(mssTrigSig) + ")" : isExtended ? "CON: entry too extended" : not seqOk and lifecycle >= LC_ENTRY_ARMED ? "CON: requires complete sequence" : "CON: strong bridge not met"

    // Non-aggressive never allow direct signal activation
    if mode != "Aggressive"
        allowDirect := false

    [meetsCandidate, meetsActivation, blockReason, allowDirect, actPath]

// =====================================================================
// --- DELAYED ACTIVATION WINDOW POLICY (Chapter 2.1) ---
// =====================================================================

// Mode-specific pending activation window (bars after signal)
// AGG=2 (fast confirmation), BAL=5 (moderate patience), CON=7 (patience-first)
mode_pending_activation_bars(string mode) =>
    mode == "Aggressive" ? 2 : mode == "Conservative" ? 7 : 5

// Is the pending setup still within its activation window?
pending_setup_is_fresh(int signalBar, int expiryBar) =>
    bar_index >= signalBar and bar_index <= expiryBar

// Has the pending setup's activation window expired?
pending_setup_has_expired(int expiryBar) =>
    bar_index > expiryBar

// Evaluate whether a pending setup qualifies for delayed activation (Chapter 2.2).
// Returns: [canActivateNow, updatedReason, shouldInvalidate]
// Chapter 3: reclaimFailed | Chapter 4: mssFailed/mssFresh added
evaluate_pending_activation(bool isLong, int currentLifecycle, bool reclaimPass, float reclaimStr, bool reclaimStrong, float dispStrength, bool seqOk, bool expired, bool degraded, string mode, int signalBar, int expiryBar, bool isExtended, bool mssQualPass, bool mssQualStrong, bool bridgePass_, bool bridgeStrong_, bool pendingFresh, bool reclaimFailed_, bool mssFailed_, bool mssFresh_) =>
    bool canActivate = false
    string reason = ""
    bool shouldInvalidate = false

    // Chapter 3: failed reclaim invalidates pending setup
    // Chapter 4: failed/stale MSS invalidates pending setup
    if reclaimFailed_
        shouldInvalidate := true
        reason := "Pending invalidated — reclaim failed"
    else if mssFailed_
        shouldInvalidate := true
        reason := "Pending invalidated — MSS failed"
    else if not mssFresh_
        shouldInvalidate := true
        reason := "Pending invalidated — MSS stale"
    else if not pending_setup_is_fresh(signalBar, expiryBar)
        shouldInvalidate := pending_setup_has_expired(expiryBar)
        reason := shouldInvalidate ? "Pending window expired" : "Pending not yet active"
    else if expired or degraded
        shouldInvalidate := true
        reason := expired ? "Setup expired" : "Setup degraded"
    else if not pendingFresh
        shouldInvalidate := true
        reason := "Pending structurally stale"
    else if isExtended
        shouldInvalidate := true
        reason := "Price too extended for pending"
    else
        if mode == "Aggressive"
            bool lifecycleOk = currentLifecycle >= LC_DISPLACEMENT_CONFIRMED
            if lifecycleOk and reclaimPass
                canActivate := true
                reason := "AGG pending confirmed"
            else
                reason := not lifecycleOk ? "Pending: lifecycle insufficient" : "Pending: reclaim lost"
        else if mode == "Balanced"
            bool lifecycleOk = currentLifecycle >= LC_DISPLACEMENT_CONFIRMED
            bool qualityOk = reclaimPass and mssQualPass and bridgePass_
            if lifecycleOk and qualityOk
                canActivate := true
                reason := "BAL pending: quality confirmed"
            else
                reason := not lifecycleOk ? "Pending: lifecycle " + lifecycle_name(currentLifecycle) : not reclaimPass ? "Pending: reclaim insufficient" : not mssQualPass ? "Pending: MSS quality insufficient" : "Pending: bridge insufficient"
        else // Conservative
            bool lifecycleOk = currentLifecycle >= LC_DISPLACEMENT_CONFIRMED
            bool qualityOk = reclaimStrong and mssQualStrong and bridgeStrong_
            bool seqGate = seqOk or (not na(dispStrength) and dispStrength >= 1.5)
            if lifecycleOk and qualityOk and seqGate
                canActivate := true
                reason := "CON pending: strong quality confirmed"
            else
                reason := not lifecycleOk ? "Pending: lifecycle insufficient" : not reclaimStrong ? "Pending: reclaim not strong" : not mssQualStrong ? "Pending: MSS not strong" : not seqGate ? "Pending: sequence insufficient" : "Pending: bridge not strong"

    [canActivate, reason, shouldInvalidate]

// Determine lifecycle stage from raw setup data + eval_side outputs
// Chapter 3: reclaim-aware | Chapter 4: MSS-truth-aware
determine_lifecycle(bool swept, int sweepBar_, int mssBar_, float mssDisp, int fvgBar_, int fvgGrade_, bool fvgMitigated, bool seqOk, bool expired, bool degraded, float reqLevel, float pivotVal, bool isLong, float atrVal, bool reclaimDetected_, bool reclaimValid_, bool reclaimFailed_, bool mssValid_, bool mssStrong_, bool mssFailed_) =>
    int lc = LC_NONE
    string reason = ""
    if expired
        lc := LC_EXPIRED
        reason := "Structure shift expired without progression"
    else if degraded
        lc := LC_INVALIDATED
        reason := "Imbalance zone was filled"
    else if seqOk and mssValid_
        // Chapter 4: full sequence requires validated MSS
        lc := LC_ENTRY_ARMED
        reason := "Full sequence: sweep → MSS → FVG (MSS validated)"
    else if seqOk and not mssValid_ and not mssFailed_
        // Chapter 4: sequence complete but MSS not validated — cap at DISPLACEMENT_CONFIRMED
        lc := not na(mssDisp) and mssDisp > 1.5 ? LC_DISPLACEMENT_CONFIRMED : LC_MSS_CONFIRMED
        reason := "Sequence present but MSS not fully validated"
    else if swept and not na(mssBar_) and not na(sweepBar_) and mssBar_ >= sweepBar_
        if mssValid_ and not na(mssDisp) and mssDisp > 1.5
            lc := LC_DISPLACEMENT_CONFIRMED
            reason := "Strong displacement (" + str.tostring(mssDisp, "#.##") + "x ATR) — MSS validated"
        else if mssValid_
            lc := LC_MSS_CONFIRMED
            reason := "Structure shift confirmed — MSS validated"
        else if mssFailed_
            // Chapter 4: MSS failed — don't promote past sweep
            lc := LC_SWEEP_CONFIRMED
            reason := "MSS failed — awaiting fresh structure shift"
        else
            // Chapter 4: MSS detected but not validated (weak/trivial)
            lc := reclaimDetected_ and not reclaimFailed_ ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
            reason := "MSS detected but not validated — awaiting better structure"
    else if swept and reclaimDetected_ and not reclaimFailed_
        lc := LC_RECLAIM_VISIBLE
        reason := reclaimValid_ ? "Valid reclaim visible — watch for structure shift" : "Early reclaim visible — awaiting confirmation"
    else if swept
        lc := LC_SWEEP_CONFIRMED
        reason := reclaimFailed_ ? "Liquidity swept — reclaim failed, awaiting fresh structure" : "Liquidity swept — awaiting structure shift"
    else if not na(reqLevel) and not na(atrVal) and atrVal > 0
        float proximity = math.abs(close - reqLevel) / atrVal
        if proximity < 3.0
            lc := LC_LIQUIDITY_IDENTIFIED
            reason := (isLong ? "SSL" : "BSL") + " at " + str.tostring(reqLevel, "#.#####") + " (" + str.tostring(proximity, "#.#") + " ATR)"
        else
            reason := "Searching for liquidity"
    else
        reason := "No setup context"
    string lcName = lifecycle_name(lc)
    string nextReq = lifecycle_next_required(lc, isLong, pivotVal, reqLevel)
    bool canActivate = lifecycle_allows_activation(lc)
    [lc, lcName, nextReq, canActivate, reason]

SetupState liveSetup = SetupState.new()

// Evaluate one side (long or short) with quality-weighted, sequence-aware scoring
// Enhanced: uses enriched sweep metadata (source type, external/internal, sweep type)
// Returns [score, phase, missing, sweepGrade, mssGrade, fvgGrade, sequenceOk, triggerLvl, expired, degraded]
eval_side(bool isLong, string bias, string pd, bool kz, bool sb, bool swept, float sweepQ, int sweepBar_, string sweepGradeIn, bool sweepIsExt, int sweepSrcType, int mssBar_, float mssDisp, int fvgBar_, int fvgGrade_, bool fvgMitigated, bool obConf, float pivotVal, float reqLevel, float atrVal, string sessName, int sweepMaxAge_, int mssMaxAge_, int fvgMaxAge_) =>
    float sc = 0.0
    string ph = "Scanning"
    string ms = ""
    string swG = ""
    string msG = ""
    string fgG = ""
    bool seqOk = false
    float trig = na
    bool expired = false
    bool degraded = false

    // --- Context Score (max 18) ---
    string alignedPD = isLong ? "Discount" : "Premium"
    bool biasAligned = (isLong and bias == "Bullish") or (not isLong and bias == "Bearish")
    bool biasCounter = (isLong and bias == "Bearish") or (not isLong and bias == "Bullish")

    if biasAligned
        sc += 5.0
    else if biasCounter
        sc -= 3.0

    if pd == alignedPD
        sc += 5.0
    else if pd != alignedPD and pd != ""
        sc -= 2.0

    // Timing — Silver Bullet > Killzone > No session (max 5)
    if sb
        sc += 5.0
    else if kz
        sc += 3.0

    bool isLondon = str.contains(sessName, "London") and not str.contains(sessName, "Overlap")
    bool isNY = str.contains(sessName, "New York") or str.contains(sessName, "Overlap")

    // --- Sweep Score (max 30) — enriched with source/type awareness ---
    if swept
        // Base sweep score from quality (0-100 → 10-25)
        float sweepScore = 10.0 + math.min(sweepQ, 100.0) * 0.15
        sc += sweepScore
        swG := sweepGradeIn

        // Liquidity source bonuses (v2 enrichment)
        // External liquidity sweep: +3 for reversal setups
        if sweepIsExt
            sc += 3.0
        // HTF level sweep: +2
        if sweepSrcType == SRC_PWH_PWL or sweepSrcType == SRC_PDH_PDL
            sc += 2.0
        // Cluster (EQH/EQL) sweep: +2
        if sweepSrcType == SRC_EQH_EQL
            sc += 2.0
        // Internal-only sweep penalty for reversal context (needs external for conviction)
        if not sweepIsExt and sweepSrcType == SRC_PIVOT_INT
            sc -= 3.0

        string srcLabel = source_phase_tag(sweepSrcType, sweepIsExt)
        ph := "Liquidity swept"

        // Sweep staleness penalty
        if not na(sweepBar_)
            float sweepAge = bar_index - sweepBar_
            float sweepLifeRatio = sweepAge / sweepMaxAge_
            if sweepLifeRatio > 0.7
                sc -= 5.0
                ph := ph + " ⌛"

        // --- MSS Score (max 25) — quality + sequence ---
        if not na(mssBar_)
            bool mssAfterSweep = not na(sweepBar_) and mssBar_ >= sweepBar_
            if mssAfterSweep
                float mssScore = 10.0
                if mssDisp > 1.5
                    mssScore := 25.0
                    msG := "A"
                else if mssDisp > 0.8
                    mssScore := 18.0
                    msG := "B"
                else
                    mssScore := 12.0
                    msG := "C"
                sc += mssScore
                ph := "Structure confirmed"

                float mssAge = bar_index - mssBar_
                float mssLifeRatio = mssAge / mssMaxAge_
                if mssLifeRatio > 0.6
                    sc -= 4.0
                    ph := ph + " ⌛"

                if mssLifeRatio > 0.85 and (na(fvgBar_) or fvgGrade_ == 0)
                    expired := true
                    ph := "Setup expired"
                    ms := "Structure shift expired without imbalance — setup invalid"

                // --- FVG Score (max 25) — grade + sequence ---
                if not expired and not na(fvgBar_) and fvgGrade_ > 0
                    bool fvgAfterMss = fvgBar_ >= mssBar_
                    if fvgAfterMss
                        if fvgMitigated
                            degraded := true
                            sc -= 10.0
                            ph := "Setup degraded"
                            ms := "Imbalance zone was filled — wait for a fresh one"
                        else
                            seqOk := true
                            float fvgScore = fvgGrade_ == 3 ? 25.0 : fvgGrade_ == 2 ? 18.0 : 12.0
                            fgG := fvgGrade_ == 3 ? "A" : fvgGrade_ == 2 ? "B" : "C"
                            sc += fvgScore
                            ph := "Setup ready"
                            ms := "Full sequence complete — monitor entry zone"

                            float fvgAge = bar_index - fvgBar_
                            if fvgAge / fvgMaxAge_ > 0.7
                                ms := ms + " (imbalance aging)"
                    else
                        ph := "Awaiting imbalance"
                        ms := "Imbalance predates structure shift — need a fresh one"
                else if not expired
                    ph := "Awaiting imbalance"
                    ms := "Need fresh " + (isLong ? "bullish" : "bearish") + " imbalance after structure shift"
            else
                ph := "Awaiting structure shift"
                ms := "Structure shift predates sweep — need new " + (isLong ? "bullish" : "bearish") + " confirmation"
                trig := pivotVal
        else
            ph := "Awaiting structure shift"
            trig := pivotVal
            ms := "Need " + (isLong ? "bullish" : "bearish") + " structure shift" + (na(pivotVal) ? "" : " — break " + (isLong ? "above " : "below ") + str.tostring(pivotVal, "#.#####"))
    else
        // No sweep yet — ATR-based proximity check
        if not na(reqLevel) and not na(atrVal)
            float proximity = math.abs(close - reqLevel) / atrVal
            if proximity < 0.5
                ph := "Liquidity imminent"
                sc += 3.0
                ms := (isLong ? "Sell-side" : "Buy-side") + " liquidity at " + str.tostring(reqLevel, "#.#####") + " — very close (" + str.tostring(proximity, "#.#") + " ATR)"
            else if proximity < 1.5
                ph := "Liquidity nearby"
                sc += 1.0
                ms := (isLong ? "Sell-side" : "Buy-side") + " liquidity at " + str.tostring(reqLevel, "#.#####") + " (" + str.tostring(proximity, "#.#") + " ATR away)"
            else if proximity < 3.0
                ph := "Approaching liquidity"
                ms := (isLong ? "Sell-side" : "Buy-side") + " liquidity at " + str.tostring(reqLevel, "#.#####") + " (" + str.tostring(proximity, "#.#") + " ATR away)"
            else
                ms := "Searching for " + (isLong ? "sell-side" : "buy-side") + " liquidity to sweep"
        else
            ms := "No liquidity levels identified"

    // --- Confluence Bonus (max 18) ---
    if obConf and seqOk
        sc += 5.0
        ms := ms + " (order block confluence)"

    // Full sequence + quality bonus
    if seqOk and sweepQ >= 40 and not na(mssDisp) and mssDisp > 0.8 and fvgGrade_ >= 2
        sc += 5.0

    // External + HTF sweep with valid sequence: premium confluence
    if seqOk and sweepIsExt and (sweepSrcType == SRC_PWH_PWL or sweepSrcType == SRC_PDH_PDL)
        sc += 3.0

    // Session alignment (max 3)
    if isLondon and swept
        sc += 2.0
    else if isNY and seqOk
        sc += 3.0
    else if isLondon or isNY
        sc += 1.0

    // Clamp score to 0-100
    int finalScore = math.max(0, math.min(100, math.round(sc)))
    [finalScore, ph, ms, swG, msG, fgG, seqOk, trig, expired, degraded]

// --- Run dual-side evaluation ---
[scoreLong, phaseLong, missingLong, swGradeL, msGradeL, fgGradeL, seqOkL, trigL, expiredL, degradedL] = eval_side(true, marketBias, pdStatus, isKillzone, isSilverBullet, sweptSSL, sweepQualitySSL, bestSweepBarSSL, bestSweepGradeSSL, bestSweepExtSSL, bestSweepSrcSSL, lastMssBullBar, lastMssBullDispStrength, lastBullFvgBar, lastBullFvgGrade, lastBullFvgMitigated, obBullConfluence, lastPHi, reqL, atr, activeSessName, sweepMaxAge, mssMaxAge, fvgMaxAge)
[scoreShort, phaseShort, missingShort, swGradeS, msGradeS, fgGradeS, seqOkS, trigS, expiredS, degradedS] = eval_side(false, marketBias, pdStatus, isKillzone, isSilverBullet, sweptBSL, sweepQualityBSL, bestSweepBarBSL, bestSweepGradeBSL, bestSweepExtBSL, bestSweepSrcBSL, lastMssBearBar, lastMssBearDispStrength, lastBearFvgBar, lastBearFvgGrade, lastBearFvgMitigated, obBearConfluence, lastPLo, reqS, atr, activeSessName, sweepMaxAge, mssMaxAge, fvgMaxAge)

// --- Chapter 3: Reclaim Stage Evaluation (runs each bar) ---
[rclDetL, rclWeakL2, rclValidL2, rclStrongL2, rclFailedL2, rclScoreL2, rclReasonL2, rclAcceptL2, rclThreshL2] = evaluate_reclaim_stage(true, bestSweepBarSSL, bestSweepLevelSSL, bestSweepDepthSSL, atr, _rclAcceptL, _rclFailedL, _rclSweepRefL)
[rclDetS, rclWeakS2, rclValidS2, rclStrongS2, rclFailedS2, rclScoreS2, rclReasonS2, rclAcceptS2, rclThreshS2] = evaluate_reclaim_stage(false, bestSweepBarBSL, bestSweepLevelBSL, bestSweepDepthBSL, atr, _rclAcceptS, _rclFailedS, _rclSweepRefS)

// Update persistent reclaim state
// Reset detection bar on new sweep (must check BEFORE updating sweep ref)
if not na(bestSweepBarSSL) and bestSweepBarSSL != _rclSweepRefL
    _rclDetBarL := na
if not na(bestSweepBarBSL) and bestSweepBarBSL != _rclSweepRefS
    _rclDetBarS := na
_rclAcceptL := rclAcceptL2
_rclAcceptS := rclAcceptS2
_rclFailedL := rclFailedL2
_rclFailedS := rclFailedS2
_rclThreshL := rclThreshL2
_rclThreshS := rclThreshS2
_rclSweepRefL := not na(bestSweepBarSSL) ? bestSweepBarSSL : _rclSweepRefL
_rclSweepRefS := not na(bestSweepBarBSL) ? bestSweepBarBSL : _rclSweepRefS
if rclDetL and na(_rclDetBarL)
    _rclDetBarL := bar_index
if rclDetS and na(_rclDetBarS)
    _rclDetBarS := bar_index

// --- Chapter 4: MSS Stage Evaluation (runs each bar, like reclaim) ---
[mssDetL, mssWeakL2, mssValidL2, mssStrongL2, mssFreshL2, mssFailedL2, mssScoreL2, mssReasonL2, mssFailReasonL2, mssBreakLvlL2, mssBodyConfL2, mssTrigTypeL2, mssTrigSigL2, mssFollowBarsL2, mssBreakQScoreL2] = evaluate_mss_stage(true, bestSweepBarSSL, rclDetL, rclValidL2, lastMssBullBar, lastMssBullDispStrength, lastPHi, lastPHiBar, pivotHiIsExternal, bestSweepLevelSSL, atr, rangeSpan, rangeHigh50, rangeLow50, sensitivityMode, _mssRefBarL, _mssScorePersistL, _mssFailedPersistL, _mssFollowBarsL, _mssBodyConfL, _mssBreakQScoreL)

[mssDetS, mssWeakS2, mssValidS2, mssStrongS2, mssFreshS2, mssFailedS2, mssScoreS2, mssReasonS2, mssFailReasonS2, mssBreakLvlS2, mssBodyConfS2, mssTrigTypeS2, mssTrigSigS2, mssFollowBarsS2, mssBreakQScoreS2] = evaluate_mss_stage(false, bestSweepBarBSL, rclDetS, rclValidS2, lastMssBearBar, lastMssBearDispStrength, lastPLo, lastPLoBar, pivotLoIsExternal, bestSweepLevelBSL, atr, rangeSpan, rangeHigh50, rangeLow50, sensitivityMode, _mssRefBarS, _mssScorePersistS, _mssFailedPersistS, _mssFollowBarsS, _mssBodyConfS, _mssBreakQScoreS)

// Update persistent MSS state
_mssRefBarL := not na(lastMssBullBar) ? lastMssBullBar : _mssRefBarL
_mssRefBarS := not na(lastMssBearBar) ? lastMssBearBar : _mssRefBarS
_mssBreakLvlL := mssBreakLvlL2
_mssBreakLvlS := mssBreakLvlS2
_mssSweepRefL := not na(bestSweepBarSSL) ? bestSweepBarSSL : _mssSweepRefL
_mssSweepRefS := not na(bestSweepBarBSL) ? bestSweepBarBSL : _mssSweepRefS
_mssScorePersistL := mssScoreL2
_mssScorePersistS := mssScoreS2
_mssFailedPersistL := mssFailedL2
_mssFailedPersistS := mssFailedS2
_mssFollowBarsL := mssFollowBarsL2
_mssFollowBarsS := mssFollowBarsS2
_mssBodyConfL := mssBodyConfL2
_mssBodyConfS := mssBodyConfS2
_mssBreakQScoreL := mssBreakQScoreL2
_mssBreakQScoreS := mssBreakQScoreS2

// --- Lifecycle Determination (Chapter 1 + Chapter 3 + Chapter 4: MSS-truth-aware) ---
[lcLong, lcNameLong, lcNextReqLong, lcCanActLong, lcReasonLong] = determine_lifecycle(sweptSSL, bestSweepBarSSL, lastMssBullBar, lastMssBullDispStrength, lastBullFvgBar, lastBullFvgGrade, lastBullFvgMitigated, seqOkL, expiredL, degradedL, reqL, lastPHi, true, atr, rclDetL, rclValidL2, rclFailedL2, mssValidL2, mssStrongL2, mssFailedL2)
[lcShort, lcNameShort, lcNextReqShort, lcCanActShort, lcReasonShort] = determine_lifecycle(sweptBSL, bestSweepBarBSL, lastMssBearBar, lastMssBearDispStrength, lastBearFvgBar, lastBearFvgGrade, lastBearFvgMitigated, seqOkS, expiredS, degradedS, reqS, lastPLo, false, atr, rclDetS, rclValidS2, rclFailedS2, mssValidS2, mssStrongS2, mssFailedS2)

// --- Select dominant side and populate SetupState ---
// Bias acts as tiebreaker multiplier, not gate
float biasMultLong = marketBias == "Bullish" ? 1.15 : marketBias == "Bearish" ? 0.85 : 1.0
float biasMultShort = marketBias == "Bearish" ? 1.15 : marketBias == "Bullish" ? 0.85 : 1.0
float adjScoreLong = scoreLong * biasMultLong
float adjScoreShort = scoreShort * biasMultShort

// Phase 5: Conflicted — both sides have strong valid sequences simultaneously
bool isConflicted = seqOkL and seqOkS and math.abs(adjScoreLong - adjScoreShort) < 15

bool pickLong = adjScoreLong >= adjScoreShort

liveSetup := SetupState.new()
liveSetup.nearestBSL := nearestBSL
liveSetup.nearestSSL := nearestSSL
liveSetup.scoreLong := scoreLong
liveSetup.scoreShort := scoreShort
liveSetup.phaseLong := phaseLong
liveSetup.phaseShort := phaseShort
liveSetup.missingLong := missingLong
liveSetup.missingShort := missingShort

// Dominant side drives the legacy fields for backwards compatibility
liveSetup.score := pickLong ? scoreLong : scoreShort
liveSetup.isPotentialLong := pickLong
liveSetup.isPotentialShort := not pickLong
liveSetup.requiredSweep := pickLong ? reqL : reqS
liveSetup.triggerLevel := pickLong ? trigL : trigS
liveSetup.sequenceValid := pickLong ? seqOkL : seqOkS
liveSetup.sweepGrade := pickLong ? swGradeL : swGradeS
liveSetup.mssGrade := pickLong ? msGradeL : msGradeS
liveSetup.fvgGrade := pickLong ? fgGradeL : fgGradeS
liveSetup.hasOBConfluence := pickLong ? obBullConfluence : obBearConfluence
liveSetup.isExpired := pickLong ? expiredL : expiredS
liveSetup.isDegraded := pickLong ? degradedL : degradedS
liveSetup.isConflicted := isConflicted

// Lifecycle fields
liveSetup.lifecycleLong := lcLong
liveSetup.lifecycleShort := lcShort
liveSetup.lifecycleNameLong := lcNameLong
liveSetup.lifecycleNameShort := lcNameShort
liveSetup.lifecycleReasonLong := lcReasonLong
liveSetup.lifecycleReasonShort := lcReasonShort
liveSetup.lifecycleNextRequiredLong := lcNextReqLong
liveSetup.lifecycleNextRequiredShort := lcNextReqShort
liveSetup.lifecycleCanActivateLong := lcCanActLong
liveSetup.lifecycleCanActivateShort := lcCanActShort
// Dominant lifecycle
liveSetup.lifecycleDominant := pickLong ? lcLong : lcShort
liveSetup.lifecycleNameDominant := pickLong ? lcNameLong : lcNameShort
liveSetup.lifecycleReasonDominant := pickLong ? lcReasonLong : lcReasonShort
liveSetup.lifecycleNextRequiredDominant := pickLong ? lcNextReqLong : lcNextReqShort
liveSetup.lifecycleCanActivateDominant := pickLong ? lcCanActLong : lcCanActShort

// Phase 5: Lifecycle overrides
// Expired/Degraded phases are already set by eval_side — just assign dominant side
liveSetup.phase := pickLong ? phaseLong : phaseShort
liveSetup.missing := pickLong ? missingLong : missingShort

// Conflicted overrides everything — both sides have valid armed sequences
if isConflicted
    liveSetup.phase := "Market conflicted"
    liveSetup.missing := "Both long (" + str.tostring(scoreLong) + ") and short (" + str.tostring(scoreShort) + ") setups active — no clear edge, stand aside"
    liveSetup.score := math.max(scoreLong, scoreShort)
    liveSetup.lifecycleDominant := LC_NONE
    liveSetup.lifecycleNameDominant := "Market conflicted"
    liveSetup.lifecycleNextRequiredDominant := "Both sides active — stand aside"
    liveSetup.lifecycleCanActivateDominant := false

// --- Strategy Detection ---
[ictGateLong, ictGateLongInfo, ictHasValidExternalLong] = ict_liquidity_gate(true, lastMssBullBar, lastMssBullDispStrength)

[ictGateShort, ictGateShortInfo, ictHasValidExternalShort] = ict_liquidity_gate(false, lastMssBearBar, lastMssBearDispStrength)

[sbGateLong, sbGateLongInfo, sbHasSessionSweepLong] = silver_bullet_liquidity_gate(true)

[sbGateShort, sbGateShortInfo, sbHasSessionSweepShort] = silver_bullet_liquidity_gate(false)

bool continuationLiquidityLong = sweptSSL and (bestSweepSrcSSL == SRC_PIVOT_INT or bestSweepExtSSL or bestSweepSrcSSL == SRC_EQH_EQL or bestSweepSrcSSL == SRC_ROUND_NUM or is_htf_liquidity_source(bestSweepSrcSSL))
bool continuationLiquidityShort = sweptBSL and (bestSweepSrcBSL == SRC_PIVOT_INT or bestSweepExtBSL or bestSweepSrcBSL == SRC_EQH_EQL or bestSweepSrcBSL == SRC_ROUND_NUM or is_htf_liquidity_source(bestSweepSrcBSL))

bool sig2022B = mssBull and ictGateLong and enableICT2022
bool sig2022S = mssBear and ictGateShort and enableICT2022
bool inSB = sbLon.isActive or sbAm.isActive
bool sigSBB = inSB and bullFvgAligned and sbGateLong and enableSilverBullet
bool sigSBS = inSB and bearFvgAligned and sbGateShort and enableSilverBullet

if pickLong and enableICT2022 and mssBull and not ictGateLong
    liveSetup.missing := "ICT 2022 blocked: " + ictGateLongInfo
else if not pickLong and enableICT2022 and mssBear and not ictGateShort
    liveSetup.missing := "ICT 2022 blocked: " + ictGateShortInfo
else if pickLong and enableSilverBullet and inSB and bullFvgAligned and not sbGateLong
    liveSetup.missing := "Silver Bullet blocked: " + sbGateLongInfo
else if not pickLong and enableSilverBullet and inSB and bearFvgAligned and not sbGateShort
    liveSetup.missing := "Silver Bullet blocked: " + sbGateShortInfo

bool dominantLiquidityBlocked = pickLong ? ((enableICT2022 and mssBull and not ictGateLong) or (enableSilverBullet and inSB and bullFvgAligned and not sbGateLong)) : ((enableICT2022 and mssBear and not ictGateShort) or (enableSilverBullet and inSB and bearFvgAligned and not sbGateShort))

// Gate-blocked lifecycle update — preserve detailed gate info in next-required
if dominantLiquidityBlocked and liveSetup.lifecycleDominant >= LC_MSS_CONFIRMED
    liveSetup.lifecycleNextRequiredDominant := liveSetup.missing

// --- Alert History Engine ---
var AlertLog[] alertLogs = array.new<AlertLog>()
if (sig2022B or sigSBB or sig2022S or sigSBS)
    string sig = (sig2022B or sigSBB) ? "BUY" : "SELL"
    color c = (sig2022B or sigSBB) ? uiPosColor : uiNegColor
    array.unshift(alertLogs, AlertLog.new(str.format_time(time, "HH:mm", NY_TZ), sig, close, c))
    if array.size(alertLogs) > maxAlertRows
        array.pop(alertLogs)

// --- Trade Management ---
var Stats mainStats = Stats.new()
var Trade activeTrade = na
var box[] historicalBoxes = array.new_box()

// Chapter 2.1: Persistent pending activation state (survives across bars)
var bool   _pendingLongActive = false
var bool   _pendingShortActive = false
var int    _pendingLongSignalBar = 0
var int    _pendingShortSignalBar = 0
var int    _pendingLongExpiryBar = 0
var int    _pendingShortExpiryBar = 0
var string _pendingLongSource = ""
var string _pendingShortSource = ""
var int    _pendingLongInitialLC = 0
var int    _pendingShortInitialLC = 0
var string _pendingLongMode = ""
var string _pendingShortMode = ""
var string _pendingLongReason = ""
var string _pendingShortReason = ""
var bool   _pendingLongCanStillActivate = false
var bool   _pendingShortCanStillActivate = false

method update_stats(Stats s, float rEarned, bool isWin) =>
    s.totalTrades += 1
    s.totalR += rEarned
    s.equityR += rEarned
    if isWin
        s.wins += 1
    else
        s.losses += 1
    s.peakEquityR := math.max(s.peakEquityR, s.equityR)
    s.maxDrawdownR := math.min(s.maxDrawdownR, s.equityR - s.peakEquityR)

bool isSignalB = sig2022B or sigSBB
bool isSignalS = sig2022S or sigSBS

// =====================================================================
// --- MODE QUALIFICATION COMPUTATION (Chapter 2 + 2.2) ---
// =====================================================================

// Chapter 3: Map formal reclaim stage outputs to mode-dependent pass/fail
bool rclPassL = reclaim_mode_pass(rclDetL, rclValidL2, rclStrongL2, rclScoreL2, sensitivityMode)
float rclStrL = rclScoreL2
string rclReasonL = rclReasonL2
bool rclWeakL = rclWeakL2
bool rclStrongL = rclStrongL2
bool rclPassS = reclaim_mode_pass(rclDetS, rclValidS2, rclStrongS2, rclScoreS2, sensitivityMode)
float rclStrS = rclScoreS2
string rclReasonS = rclReasonS2
bool rclWeakS = rclWeakS2
bool rclStrongS = rclStrongS2

[extBlockL, extDistL, extReasonL] = compute_extension_block(true, lastMssBullBar, lastPHi, atr, sensitivityMode, reqL)
[extBlockS, extDistS, extReasonS] = compute_extension_block(false, lastMssBearBar, lastPLo, atr, sensitivityMode, reqS)

// Chapter 4: MSS quality now sourced from formal MSS evaluator via mss_mode_pass
[mssQPassL, mssQStrongL] = mss_mode_pass(mssDetL, mssValidL2, mssStrongL2, mssScoreL2, mssTrigSigL2, sensitivityMode)
string mssQReasonL = mssReasonL2
[mssQPassS, mssQStrongS] = mss_mode_pass(mssDetS, mssValidS2, mssStrongS2, mssScoreS2, mssTrigSigS2, sensitivityMode)
string mssQReasonS = mssReasonS2

[bridgePassL, bridgeStrongL, bridgeReasonL] = evaluate_displacement_bridge(lastMssBullDispStrength, lastBullFvgBar, lastBullFvgGrade, lastBullFvgMitigated, seqOkL, lastMssBullBar, sensitivityMode)
[bridgePassS, bridgeStrongS, bridgeReasonS] = evaluate_displacement_bridge(lastMssBearDispStrength, lastBearFvgBar, lastBearFvgGrade, lastBearFvgMitigated, seqOkS, lastMssBearBar, sensitivityMode)

// Chapter 3: Failed reclaim blocks activation for all modes
// Override reclaim pass if reclaim has failed
if rclFailedL2
    rclPassL := false
if rclFailedS2
    rclPassS := false

// Backward-compatible reclaim proxy aliases (now sourced from Chapter 3 evaluator, post-failure-override)
bool reclaimProxyLong = rclPassL
bool reclaimProxyShort = rclPassS

// Evaluate mode qualification with quality data (Chapter 3+4: reclaim + MSS truth)
[modeCandL, modeActL, modeBlockL, modeDirectL, modePathL] = evaluate_mode_execution(sensitivityMode, liveSetup.lifecycleLong, sweptSSL, sweepQualitySSL, not na(lastMssBullBar), lastMssBullDispStrength, not na(lastBullFvgBar) and lastBullFvgGrade > 0, lastBullFvgGrade, seqOkL, expiredL, degradedL, rclPassL, rclStrL, rclStrongL, extBlockL, mssQPassL, mssQStrongL, bridgePassL, bridgeStrongL, scoreLong, mssTrigSigL2)

[modeCandS, modeActS, modeBlockS, modeDirectS, modePathS] = evaluate_mode_execution(sensitivityMode, liveSetup.lifecycleShort, sweptBSL, sweepQualityBSL, not na(lastMssBearBar), lastMssBearDispStrength, not na(lastBearFvgBar) and lastBearFvgGrade > 0, lastBearFvgGrade, seqOkS, expiredS, degradedS, rclPassS, rclStrS, rclStrongS, extBlockS, mssQPassS, mssQStrongS, bridgePassS, bridgeStrongS, scoreShort, mssTrigSigS2)

// Populate SetupState mode fields
liveSetup.sensitivityModeActive := sensitivityMode
liveSetup.modeMinCandidateLifecycle := mode_min_lifecycle_for_candidate(sensitivityMode)
liveSetup.modeMinActivationLifecycle := mode_min_lifecycle_for_activation(sensitivityMode)
liveSetup.longMeetsModeCandidate := modeCandL
liveSetup.shortMeetsModeCandidate := modeCandS
liveSetup.longMeetsModeActivation := modeActL
liveSetup.shortMeetsModeActivation := modeActS
liveSetup.longModeBlockReason := modeBlockL
liveSetup.shortModeBlockReason := modeBlockS
liveSetup.longHasReclaimProxy := reclaimProxyLong
liveSetup.shortHasReclaimProxy := reclaimProxyShort
// Chapter 2.2: Quality fields (now sourced from Chapter 3 reclaim evaluator)
liveSetup.reclaimStrengthLong := rclStrL
liveSetup.reclaimStrengthShort := rclStrS
liveSetup.reclaimReasonLong := rclReasonL
liveSetup.reclaimReasonShort := rclReasonS
// Chapter 3: Reclaim stage fields
liveSetup.reclaimDetectedLong := rclDetL
liveSetup.reclaimDetectedShort := rclDetS
liveSetup.reclaimValidLong := rclValidL2
liveSetup.reclaimValidShort := rclValidS2
liveSetup.reclaimStrongLong := rclStrongL2
liveSetup.reclaimStrongShort := rclStrongS2
liveSetup.reclaimFailedLong := rclFailedL2
liveSetup.reclaimFailedShort := rclFailedS2
liveSetup.reclaimScoreLong := rclScoreL2
liveSetup.reclaimScoreShort := rclScoreS2
liveSetup.reclaimStageReasonLong := rclReasonL2
liveSetup.reclaimStageReasonShort := rclReasonS2
liveSetup.reclaimAcceptBarsLong := rclAcceptL2
liveSetup.reclaimAcceptBarsShort := rclAcceptS2
liveSetup.extensionBlockedLong := extBlockL
liveSetup.extensionBlockedShort := extBlockS
liveSetup.extensionDistLong := extDistL
liveSetup.extensionDistShort := extDistS
liveSetup.extensionReasonLong := extReasonL
liveSetup.extensionReasonShort := extReasonS
liveSetup.mssQualityPassLong := mssQPassL
liveSetup.mssQualityPassShort := mssQPassS
// Chapter 4: MSS stage fields
liveSetup.mssDetectedLong := mssDetL
liveSetup.mssDetectedShort := mssDetS
liveSetup.mssValidLong := mssValidL2
liveSetup.mssValidShort := mssValidS2
liveSetup.mssStrongLong := mssStrongL2
liveSetup.mssStrongShort := mssStrongS2
liveSetup.mssFreshLong := mssFreshL2
liveSetup.mssFreshShort := mssFreshS2
liveSetup.mssFailedLong := mssFailedL2
liveSetup.mssFailedShort := mssFailedS2
liveSetup.mssScoreLong := mssScoreL2
liveSetup.mssScoreShort := mssScoreS2
liveSetup.mssBreakLevelLong := mssBreakLvlL2
liveSetup.mssBreakLevelShort := mssBreakLvlS2
liveSetup.mssReasonLong := mssReasonL2
liveSetup.mssReasonShort := mssReasonS2
liveSetup.mssTriggerTypeLong := mssTrigTypeL2
liveSetup.mssTriggerTypeShort := mssTrigTypeS2
liveSetup.mssTriggerSigLong := mssTrigSigL2
liveSetup.mssTriggerSigShort := mssTrigSigS2
liveSetup.mssBodyConfirmedLong := mssBodyConfL2
liveSetup.mssBodyConfirmedShort := mssBodyConfS2
liveSetup.mssQualityReasonLong := mssQReasonL
liveSetup.mssQualityReasonShort := mssQReasonS
liveSetup.activationPathDominant := pickLong ? modePathL : modePathS

// Dominant side mode qualification
liveSetup.dominantMeetsModeCandidate := pickLong ? modeCandL : modeCandS
liveSetup.dominantMeetsModeActivation := pickLong ? modeActL : modeActS
liveSetup.dominantBlockedByMode := not (pickLong ? modeActL : modeActS) and liveSetup.lifecycleDominant >= LC_MSS_CONFIRMED
liveSetup.dominantModeBlockReason := pickLong ? modeBlockL : modeBlockS

// --- Signal Lifecycle Promotion (Chapter 1+2: Mode-Aware) ---
// Signal promotion is now gated by sensitivity mode policy.
// Aggressive: may promote from MSS_CONFIRMED+ to ENTRY_TRIGGERED if reclaim+displacement pass
// Balanced: signal may at most confirm displacement; cannot promote to ENTRY_TRIGGERED directly
// Conservative: signal cannot bypass entry-armed requirements
if isSignalB and liveSetup.lifecycleLong >= LC_MSS_CONFIRMED and liveSetup.lifecycleLong < LC_ENTRY_TRIGGERED
    // Aggressive: direct promotion if reclaim proxy + displacement meet thresholds
    bool canPromoteAggL = sensitivityMode == "Aggressive" and reclaimProxyLong and sweptSSL and not na(lastMssBullBar) and (not na(lastMssBullDispStrength) and lastMssBullDispStrength >= 0.3) and not expiredL and not degradedL
    if canPromoteAggL
        liveSetup.lifecycleLong := LC_ENTRY_TRIGGERED
        liveSetup.lifecycleNameLong := lifecycle_name(LC_ENTRY_TRIGGERED)
        liveSetup.lifecycleCanActivateLong := true
        modeActL := true
        modeBlockL := ""
        liveSetup.longMeetsModeActivation := true
        liveSetup.longModeBlockReason := ""
    else if sensitivityMode != "Aggressive" and modeCandL and liveSetup.lifecycleLong < LC_DISPLACEMENT_CONFIRMED and not na(lastMssBullDispStrength) and lastMssBullDispStrength > 0.8
        // Balanced/Conservative: promote at most to DISPLACEMENT_CONFIRMED
        liveSetup.lifecycleLong := LC_DISPLACEMENT_CONFIRMED
        liveSetup.lifecycleNameLong := lifecycle_name(LC_DISPLACEMENT_CONFIRMED)

if isSignalS and liveSetup.lifecycleShort >= LC_MSS_CONFIRMED and liveSetup.lifecycleShort < LC_ENTRY_TRIGGERED
    bool canPromoteAggS = sensitivityMode == "Aggressive" and reclaimProxyShort and sweptBSL and not na(lastMssBearBar) and (not na(lastMssBearDispStrength) and lastMssBearDispStrength >= 0.3) and not expiredS and not degradedS
    if canPromoteAggS
        liveSetup.lifecycleShort := LC_ENTRY_TRIGGERED
        liveSetup.lifecycleNameShort := lifecycle_name(LC_ENTRY_TRIGGERED)
        liveSetup.lifecycleCanActivateShort := true
        modeActS := true
        modeBlockS := ""
        liveSetup.shortMeetsModeActivation := true
        liveSetup.shortModeBlockReason := ""
    else if sensitivityMode != "Aggressive" and modeCandS and liveSetup.lifecycleShort < LC_DISPLACEMENT_CONFIRMED and not na(lastMssBearDispStrength) and lastMssBearDispStrength > 0.8
        liveSetup.lifecycleShort := LC_DISPLACEMENT_CONFIRMED
        liveSetup.lifecycleNameShort := lifecycle_name(LC_DISPLACEMENT_CONFIRMED)

// Update dominant lifecycle after signal promotion
if (isSignalB and pickLong) or (isSignalS and not pickLong)
    liveSetup.lifecycleDominant := pickLong ? liveSetup.lifecycleLong : liveSetup.lifecycleShort
    liveSetup.lifecycleNameDominant := lifecycle_name(liveSetup.lifecycleDominant)
    liveSetup.lifecycleCanActivateDominant := pickLong ? liveSetup.lifecycleCanActivateLong : liveSetup.lifecycleCanActivateShort
    // Re-evaluate dominant mode qualification after promotion
    liveSetup.dominantMeetsModeActivation := pickLong ? modeActL : modeActS
    liveSetup.dominantBlockedByMode := not (pickLong ? modeActL : modeActS) and liveSetup.lifecycleDominant >= LC_MSS_CONFIRMED
    liveSetup.dominantModeBlockReason := pickLong ? modeBlockL : modeBlockS

// --- Trade Activation with Lifecycle + Mode Guard (Chapter 1+2+2.1) ---
// PATH 1: Immediate activation (signal bar, same as before for Aggressive)
bool signalLifecycleOk = (isSignalB and lifecycle_allows_activation(liveSetup.lifecycleLong)) or (isSignalS and lifecycle_allows_activation(liveSetup.lifecycleShort))
bool signalModeOk = (isSignalB and modeActL) or (isSignalS and modeActS)
bool canActivateImmediate = signalLifecycleOk and signalModeOk

// PATH 2: Delayed activation (pending setup from prior bar, no current signal required)
// Evaluate pending long
bool pendingActivatedLong = false
bool pendingActivatedShort = false
string pendingActivationReason = ""

// Chapter 2.2+4: Compute pending freshness before delayed activation evaluation
[pendFreshL, pendStaleL, pendFreshReasonL] = pending_is_structurally_fresh(_pendingLongActive ? _pendingLongSignalBar : bar_index, lastMssBullBar, lastBullFvgBar, degradedL, extBlockL, sensitivityMode, mssFailedL2)
[pendFreshS, pendStaleS, pendFreshReasonS] = pending_is_structurally_fresh(_pendingShortActive ? _pendingShortSignalBar : bar_index, lastMssBearBar, lastBearFvgBar, degradedS, extBlockS, sensitivityMode, mssFailedS2)
liveSetup.pendingStructFreshLong := pendFreshL
liveSetup.pendingStructFreshShort := pendFreshS
liveSetup.freshnessReasonLong := pendFreshReasonL
liveSetup.freshnessReasonShort := pendFreshReasonS

if _pendingLongActive and na(activeTrade)
    [canActPL, reasonPL, shouldInvPL] = evaluate_pending_activation(true, liveSetup.lifecycleLong, rclPassL, rclStrL, rclStrongL, lastMssBullDispStrength, seqOkL, expiredL, degradedL, _pendingLongMode, _pendingLongSignalBar, _pendingLongExpiryBar, extBlockL, mssQPassL, mssQStrongL, bridgePassL, bridgeStrongL, pendFreshL, rclFailedL2, mssFailedL2, mssFreshL2)
    if shouldInvPL
        _pendingLongActive := false
        _pendingLongCanStillActivate := false
        _pendingLongReason := reasonPL
    else if canActPL
        pendingActivatedLong := true
        pendingActivationReason := reasonPL
        _pendingLongCanStillActivate := false
    else
        _pendingLongReason := reasonPL

// Evaluate pending short
if _pendingShortActive and na(activeTrade) and not pendingActivatedLong
    [canActPS, reasonPS, shouldInvPS] = evaluate_pending_activation(false, liveSetup.lifecycleShort, rclPassS, rclStrS, rclStrongS, lastMssBearDispStrength, seqOkS, expiredS, degradedS, _pendingShortMode, _pendingShortSignalBar, _pendingShortExpiryBar, extBlockS, mssQPassS, mssQStrongS, bridgePassS, bridgeStrongS, pendFreshS, rclFailedS2, mssFailedS2, mssFreshS2)
    if shouldInvPS
        _pendingShortActive := false
        _pendingShortCanStillActivate := false
        _pendingShortReason := reasonPS
    else if canActPS
        pendingActivatedShort := true
        pendingActivationReason := reasonPS
        _pendingShortCanStillActivate := false
    else
        _pendingShortReason := reasonPS

bool canActivateDelayed = pendingActivatedLong or pendingActivatedShort
bool canActivateTrade = canActivateImmediate or canActivateDelayed
bool activatingViaDelayed = canActivateDelayed and not canActivateImmediate

// Determine activation direction
bool activateLong = canActivateImmediate ? isSignalB : pendingActivatedLong
bool activateShort = canActivateImmediate ? isSignalS : pendingActivatedShort

// Signal fired but cannot activate — store as pending for delayed activation (Chapter 2.1 Part C)
if (isSignalB or isSignalS) and na(activeTrade) and not canActivateImmediate
    if isSignalB and not _pendingLongActive
        // Signal qualifies for pending if lifecycle is past sweep and mode candidate passes
        bool pendingCandidateL = liveSetup.lifecycleLong >= LC_MSS_CONFIRMED and modeCandL and not expiredL and not degradedL
        if pendingCandidateL
            int windowBars = mode_pending_activation_bars(sensitivityMode)
            _pendingLongActive := true
            _pendingLongSignalBar := bar_index
            _pendingLongExpiryBar := bar_index + windowBars
            _pendingLongSource := sig2022B ? "ICT 2022" : "SB"
            _pendingLongInitialLC := liveSetup.lifecycleLong
            _pendingLongMode := sensitivityMode
            _pendingLongReason := mode_name_short(sensitivityMode) + " pending: awaiting delayed activation (" + str.tostring(windowBars) + " bars)"
            _pendingLongCanStillActivate := true
    if isSignalS and not _pendingShortActive
        bool pendingCandidateS = liveSetup.lifecycleShort >= LC_MSS_CONFIRMED and modeCandS and not expiredS and not degradedS
        if pendingCandidateS
            int windowBarsS = mode_pending_activation_bars(sensitivityMode)
            _pendingShortActive := true
            _pendingShortSignalBar := bar_index
            _pendingShortExpiryBar := bar_index + windowBarsS
            _pendingShortSource := sig2022S ? "ICT 2022" : "SB"
            _pendingShortInitialLC := liveSetup.lifecycleShort
            _pendingShortMode := sensitivityMode
            _pendingShortReason := mode_name_short(sensitivityMode) + " pending: awaiting delayed activation (" + str.tostring(windowBarsS) + " bars)"
            _pendingShortCanStillActivate := true

    // Diagnostic: explain why immediate activation was blocked
    if signalLifecycleOk and not signalModeOk
        liveSetup.dominantBlockedByMode := true
        liveSetup.dominantModeBlockReason := isSignalB ? modeBlockL : modeBlockS
    else if mode_allows_direct_signal_activation(sensitivityMode) and not signalLifecycleOk
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "AGG: signal blocked at " + (isSignalB ? lifecycle_name(liveSetup.lifecycleLong) : lifecycle_name(liveSetup.lifecycleShort))
    else
        liveSetup.dominantBlockedByMode := true
        string modeReason = isSignalB ? modeBlockL : modeBlockS
        if modeReason == ""
            modeReason := mode_name_short(sensitivityMode) + " mode: pending activation stored (" + str.tostring(mode_pending_activation_bars(sensitivityMode)) + " bar window)"
        liveSetup.dominantModeBlockReason := modeReason

// Clear pending state after successful delayed activation
if pendingActivatedLong
    _pendingLongActive := false
if pendingActivatedShort
    _pendingShortActive := false

// Populate SetupState pending fields for dashboard visibility
liveSetup.pendingLongActive := _pendingLongActive
liveSetup.pendingShortActive := _pendingShortActive
liveSetup.pendingLongSignalBar := _pendingLongSignalBar
liveSetup.pendingShortSignalBar := _pendingShortSignalBar
liveSetup.pendingLongExpiryBar := _pendingLongExpiryBar
liveSetup.pendingShortExpiryBar := _pendingShortExpiryBar
liveSetup.pendingLongSource := _pendingLongSource
liveSetup.pendingShortSource := _pendingShortSource
liveSetup.pendingLongInitialLifecycle := _pendingLongInitialLC
liveSetup.pendingShortInitialLifecycle := _pendingShortInitialLC
liveSetup.pendingLongMode := _pendingLongMode
liveSetup.pendingShortMode := _pendingShortMode
liveSetup.pendingLongReason := _pendingLongReason
liveSetup.pendingShortReason := _pendingShortReason
liveSetup.pendingLongCanStillActivate := _pendingLongCanStillActivate
liveSetup.pendingShortCanStillActivate := _pendingShortCanStillActivate
liveSetup.pendingLongActivatedThisBar := pendingActivatedLong
liveSetup.pendingShortActivatedThisBar := pendingActivatedShort

if na(activeTrade) and canActivateTrade
    // Determine trade source name for delayed activations
    string tradeSource = activatingViaDelayed ? (activateLong ? _pendingLongSource : _pendingShortSource) : (sig2022B or sig2022S ? "ICT 2022" : "SB")
    float sl = activateLong ? low[1] - (atr * 0.5) : high[1] + (atr * 0.5)
    float risk = math.abs(close - sl)
    float tp1 = activateLong ? close + risk * 1.0 : close - risk * 1.0
    float tp2 = activateLong ? close + risk * 2.0 : close - risk * 2.0
    box tpB = na
    box slB = na
    if showSetups and showZones
        color tpCol = activateLong ? longTpColor : shortTpColor
        color slCol = activateLong ? longSlColor : shortSlColor
        tpB := box.new(bar_index, activateLong ? tp2 : close, bar_index, activateLong ? close : tp2, bgcolor = color.new(tpCol, activeTransp), border_color = tpCol, border_width = activeBorderWidth)
        slB := box.new(bar_index, activateLong ? close : sl, bar_index, activateLong ? sl : close, bgcolor = color.new(slCol, activeTransp), border_color = slCol, border_width = activeBorderWidth)
    activeTrade := Trade.new(tradeSource, activateLong, close, sl, tp1, tp2, bar_index, true, false, tpB, slB)

if not na(activeTrade)
    bool closed = false
    float r = 0.0
    string outcome = ""
    string sz = markerSizeInput == "Tiny" ? size.tiny : markerSizeInput == "Small" ? size.small : size.normal

    if not na(activeTrade.tpBox)
        box.set_right(activeTrade.tpBox, bar_index + (extendCandidateRight ? activeMinWidth : 0))
        box.set_right(activeTrade.slBox, bar_index + (extendCandidateRight ? activeMinWidth : 0))

    if activeTrade.isLong
        if low <= activeTrade.stopPrice
            r := activeTrade.isTp1Hit ? 0.0 : -1.0
            closed := true
            outcome := r == 0 ? "BE" : "SL"
            if showSlMarkers
                label.new(bar_index, activeTrade.stopPrice, outcome, color = slMarkerColor, textcolor = color.white, style = label.style_label_up, size = sz)
        else if high >= activeTrade.tp2Price
            r := 2.0
            closed := true
            outcome := "TP2"
            if showTpMarkers
                label.new(bar_index, activeTrade.tp2Price, "TP2", color = tpMarkerColor, textcolor = color.white, style = label.style_label_down, size = sz)
        else if high >= activeTrade.tp1Price and not activeTrade.isTp1Hit
            activeTrade.isTp1Hit := true
            if showTpMarkers
                label.new(bar_index, activeTrade.tp1Price, "TP1", color = tpMarkerColor, textcolor = color.white, style = label.style_label_down, size = sz)
    else
        if high >= activeTrade.stopPrice
            r := activeTrade.isTp1Hit ? 0.0 : -1.0
            closed := true
            outcome := r == 0 ? "BE" : "SL"
            if showSlMarkers
                label.new(bar_index, activeTrade.stopPrice, outcome, color = slMarkerColor, textcolor = color.white, style = label.style_label_down, size = sz)
        else if low <= activeTrade.tp2Price
            r := 2.0
            closed := true
            outcome := "TP2"
            if showTpMarkers
                label.new(bar_index, activeTrade.tp2Price, "TP2", color = tpMarkerColor, textcolor = color.white, style = label.style_label_up, size = sz)
        else if low <= activeTrade.tp1Price and not activeTrade.isTp1Hit
            activeTrade.isTp1Hit := true
            if showTpMarkers
                label.new(bar_index, activeTrade.tp1Price, "TP1", color = tpMarkerColor, textcolor = color.white, style = label.style_label_up, size = sz)

    if closed
        mainStats.update_stats(r, r > 0)
        box.set_right(activeTrade.tpBox, bar_index)
        box.set_right(activeTrade.slBox, bar_index)
        box.set_border_width(activeTrade.tpBox, 1)
        box.set_border_width(activeTrade.slBox, 1)
        array.push(historicalBoxes, activeTrade.tpBox)
        array.push(historicalBoxes, activeTrade.slBox)
        if array.size(historicalBoxes) > maxHistory * 2
            box.delete(array.shift(historicalBoxes))
            box.delete(array.shift(historicalBoxes))
        activeTrade := na

// =====================================================================
// --- POST-TRADE LIFECYCLE RECONCILIATION & INVARIANT VALIDATION ---
// (Chapter 1: State Machine Integrity)
// =====================================================================

// If activeTrade exists, lifecycle dominant must be ACTIVE
if not na(activeTrade)
    liveSetup.lifecycleDominant := LC_ACTIVE
    liveSetup.lifecycleNameDominant := lifecycle_name(LC_ACTIVE)
    liveSetup.lifecycleNextRequiredDominant := "Manage active position"
    liveSetup.lifecycleCanActivateDominant := true

// --- Invariant Validation ---
// Detect impossible state combinations and flag as DESYNC

// Invariant 3: Pre-confirmation lifecycle but sequenceValid reports true
if lifecycle_is_preconfirmation(liveSetup.lifecycleLong) and seqOkL
    liveSetup.lifecycleIsDesynced := true
    liveSetup.lifecycleDesyncReason := "Long: pre-confirmation lifecycle (" + lifecycle_name(liveSetup.lifecycleLong) + ") but sequence valid"
    liveSetup.lifecycleDominant := LC_DESYNC
if lifecycle_is_preconfirmation(liveSetup.lifecycleShort) and seqOkS
    liveSetup.lifecycleIsDesynced := true
    liveSetup.lifecycleDesyncReason := "Short: pre-confirmation lifecycle (" + lifecycle_name(liveSetup.lifecycleShort) + ") but sequence valid"
    liveSetup.lifecycleDominant := LC_DESYNC

// Invariant 5: Dominant says can activate but lifecycle below ENTRY_ARMED
if liveSetup.lifecycleCanActivateDominant and liveSetup.lifecycleDominant < LC_ENTRY_ARMED and liveSetup.lifecycleDominant != LC_ACTIVE
    liveSetup.lifecycleIsDesynced := true
    liveSetup.lifecycleDesyncReason := "canActivate=true at lifecycle=" + lifecycle_name(liveSetup.lifecycleDominant)
    liveSetup.lifecycleDominant := LC_DESYNC

// --- Chapter 2 Mode Invariants ---

// Invariant M1: Trade activated this bar while pre-promotion lifecycle below mode minimum
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index
    int modeMinAct = mode_min_lifecycle_for_activation(sensitivityMode)
    int prePromotionLc = pickLong ? lcLong : lcShort
    if prePromotionLc < modeMinAct and prePromotionLc != LC_ACTIVE
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := mode_name_short(sensitivityMode) + ": trade activated at " + lifecycle_name(prePromotionLc) + ", min=" + lifecycle_name(modeMinAct)
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant M2: Signal promoted to ENTRY_TRIGGERED with canActivate in non-Aggressive mode
if not liveSetup.lifecycleIsDesynced and not mode_allows_direct_signal_activation(sensitivityMode)
    bool badPromoL = isSignalB and liveSetup.lifecycleLong == LC_ENTRY_TRIGGERED and liveSetup.lifecycleCanActivateLong
    bool badPromoS = isSignalS and liveSetup.lifecycleShort == LC_ENTRY_TRIGGERED and liveSetup.lifecycleCanActivateShort
    if badPromoL or badPromoS
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := mode_name_short(sensitivityMode) + ": signal promoted to ENTRY_TRIGGERED with canActivate (disallowed)"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant M3: Candidate preview would show while mode candidate qualification fails
// (Enforced at render time; flagged here for debug visibility only — no desync)

// Invariant M4: Lifecycle/action implies readiness while mode block reason exists
// Chapter 2.1: Exempt when a pending activation is stored (mode block is expected on signal bar)
bool hasPendingStored = _pendingLongActive or _pendingShortActive
if not liveSetup.lifecycleIsDesynced and liveSetup.dominantBlockedByMode and liveSetup.lifecycleCanActivateDominant and liveSetup.lifecycleDominant != LC_ACTIVE and not hasPendingStored
    liveSetup.lifecycleIsDesynced := true
    liveSetup.lifecycleDesyncReason := mode_name_short(sensitivityMode) + ": canActivate=true but mode blocks (" + liveSetup.dominantModeBlockReason + ")"
    liveSetup.lifecycleDominant := LC_DESYNC

// --- Chapter 2.1 Pending Activation Invariants ---

// Invariant P1: Delayed activation fired but no activeTrade created
if not liveSetup.lifecycleIsDesynced and (pendingActivatedLong or pendingActivatedShort) and na(activeTrade)
    // This would indicate the activation path was taken but trade creation failed
    liveSetup.lifecycleIsDesynced := true
    liveSetup.lifecycleDesyncReason := "P1: delayed activation succeeded but no trade created"
    liveSetup.lifecycleDominant := LC_DESYNC

// Invariant P2: Pending active for a mode that allows direct signal activation (AGG shouldn't need pending)
if not liveSetup.lifecycleIsDesynced
    if _pendingLongActive and mode_allows_direct_signal_activation(_pendingLongMode)
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P2: pending long stored for AGG mode (should activate immediately)"
        liveSetup.lifecycleDominant := LC_DESYNC
    if not liveSetup.lifecycleIsDesynced and _pendingShortActive and mode_allows_direct_signal_activation(_pendingShortMode)
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P2: pending short stored for AGG mode (should activate immediately)"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant P3: Pending expiry bar is before signal bar (impossible window)
if not liveSetup.lifecycleIsDesynced
    if _pendingLongActive and _pendingLongExpiryBar <= _pendingLongSignalBar
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P3: pending long expiry (" + str.tostring(_pendingLongExpiryBar) + ") <= signal (" + str.tostring(_pendingLongSignalBar) + ")"
        liveSetup.lifecycleDominant := LC_DESYNC
    if not liveSetup.lifecycleIsDesynced and _pendingShortActive and _pendingShortExpiryBar <= _pendingShortSignalBar
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P3: pending short expiry (" + str.tostring(_pendingShortExpiryBar) + ") <= signal (" + str.tostring(_pendingShortSignalBar) + ")"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant P4: Both pending long and short active simultaneously
if not liveSetup.lifecycleIsDesynced and _pendingLongActive and _pendingShortActive
    liveSetup.lifecycleIsDesynced := true
    liveSetup.lifecycleDesyncReason := "P4: both pending long and short active simultaneously"
    liveSetup.lifecycleDominant := LC_DESYNC

// Invariant P5: Delayed activation on same bar as signal (should have been immediate)
if not liveSetup.lifecycleIsDesynced
    if pendingActivatedLong and _pendingLongSignalBar == bar_index
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P5: delayed long activation on signal bar (should be immediate)"
        liveSetup.lifecycleDominant := LC_DESYNC
    if not liveSetup.lifecycleIsDesynced and pendingActivatedShort and _pendingShortSignalBar == bar_index
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P5: delayed short activation on signal bar (should be immediate)"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant P6: Trade activated via delayed path but activeTrade direction mismatch
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and activatingViaDelayed
    if pendingActivatedLong and not activeTrade.isLong
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P6: delayed long activation created short trade"
        liveSetup.lifecycleDominant := LC_DESYNC
    if not liveSetup.lifecycleIsDesynced and pendingActivatedShort and activeTrade.isLong
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P6: delayed short activation created long trade"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant P7: Pending initial lifecycle below MSS_CONFIRMED (shouldn't have been stored)
if not liveSetup.lifecycleIsDesynced
    if _pendingLongActive and _pendingLongInitialLC < LC_MSS_CONFIRMED
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P7: pending long stored at " + lifecycle_name(_pendingLongInitialLC) + " (below MSS_CONFIRMED)"
        liveSetup.lifecycleDominant := LC_DESYNC
    if not liveSetup.lifecycleIsDesynced and _pendingShortActive and _pendingShortInitialLC < LC_MSS_CONFIRMED
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "P7: pending short stored at " + lifecycle_name(_pendingShortInitialLC) + " (below MSS_CONFIRMED)"
        liveSetup.lifecycleDominant := LC_DESYNC

// --- Chapter 2.2 Quality Invariants ---

// Invariant Q1: Balanced activation while extension filter says blocked
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode == "Balanced"
    bool domExt = activeTrade.isLong ? extBlockL : extBlockS
    if domExt
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "Q1: BAL activated while extension filter blocked"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant Q2: Conservative activation without stronger quality than Balanced
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode == "Conservative"
    float domRclStr = activeTrade.isLong ? rclStrL : rclStrS
    bool domMssStrong = activeTrade.isLong ? mssQStrongL : mssQStrongS
    if domRclStr < 50.0 and not domMssStrong
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "Q2: CON activated without strong quality (reclaim=" + str.tostring(math.round(domRclStr)) + ")"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant Q3: Pending setup valid while freshness helper says stale
if not liveSetup.lifecycleIsDesynced
    if _pendingLongActive and _pendingLongCanStillActivate and not pendFreshL
        _pendingLongActive := false
        _pendingLongCanStillActivate := false
        _pendingLongReason := "Q3: pending invalidated — structurally stale"
    if _pendingShortActive and _pendingShortCanStillActivate and not pendFreshS
        _pendingShortActive := false
        _pendingShortCanStillActivate := false
        _pendingShortReason := "Q3: pending invalidated — structurally stale"

// Invariant Q4: Reclaim quality insufficient but activation permitted
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index
    bool domRclPass = activeTrade.isLong ? rclPassL : rclPassS
    if not domRclPass and sensitivityMode != "Aggressive"
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "Q4: " + mode_name_short(sensitivityMode) + " activated without reclaim pass"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant Q5: MSS quality insufficient but activation permitted (non-Aggressive)
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode != "Aggressive"
    bool domMssQPass = activeTrade.isLong ? mssQPassL : mssQPassS
    if not domMssQPass
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "Q5: " + mode_name_short(sensitivityMode) + " activated without MSS quality pass"
        liveSetup.lifecycleDominant := LC_DESYNC

// --- Chapter 3: Reclaim Stage Invariants ---

// Invariant R1: lifecycle = LC_RECLAIM_VISIBLE while reclaimDetected is false
if not liveSetup.lifecycleIsDesynced
    bool rclDesyncL = liveSetup.lifecycleLong == LC_RECLAIM_VISIBLE and not rclDetL
    bool rclDesyncS = liveSetup.lifecycleShort == LC_RECLAIM_VISIBLE and not rclDetS
    if rclDesyncL or rclDesyncS
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "R1: LC_RECLAIM_VISIBLE without reclaim detected (" + (rclDesyncL ? "long" : "short") + ")"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant R2: activation allowed while reclaimFailed is true
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index
    bool domRclFailed_ = activeTrade.isLong ? rclFailedL2 : rclFailedS2
    if domRclFailed_
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "R2: trade activated while reclaim failed"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant R3: Balanced/Conservative activation with reclaim below mode minimum
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode != "Aggressive"
    bool domRclValid_ = activeTrade.isLong ? rclValidL2 : rclValidS2
    bool domRclStrong_ = activeTrade.isLong ? rclStrongL2 : rclStrongS2
    if sensitivityMode == "Conservative" and not domRclStrong_
        float domRclScore_ = activeTrade.isLong ? rclScoreL2 : rclScoreS2
        if domRclScore_ < 55.0
            liveSetup.lifecycleIsDesynced := true
            liveSetup.lifecycleDesyncReason := "R3: CON activated without strong reclaim (" + str.tostring(math.round(domRclScore_)) + ")"
            liveSetup.lifecycleDominant := LC_DESYNC
    else if sensitivityMode == "Balanced" and not domRclValid_
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "R3: BAL activated without valid reclaim"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant R4: pending setup alive while reclaim has clearly failed
if not liveSetup.lifecycleIsDesynced
    if _pendingLongActive and _pendingLongCanStillActivate and rclFailedL2
        _pendingLongActive := false
        _pendingLongCanStillActivate := false
        _pendingLongReason := "R4: pending invalidated — reclaim failed"
    if _pendingShortActive and _pendingShortCanStillActivate and rclFailedS2
        _pendingShortActive := false
        _pendingShortCanStillActivate := false
        _pendingShortReason := "R4: pending invalidated — reclaim failed"

// Invariant R5: lifecycle advanced past sweep without reclaim evidence
if not liveSetup.lifecycleIsDesynced
    bool advLNoRecl = liveSetup.lifecycleLong >= LC_RECLAIM_VISIBLE and liveSetup.lifecycleLong <= LC_MSS_CONFIRMED and not rclDetL and not na(bestSweepBarSSL) and na(lastMssBullBar)
    bool advSNoRecl = liveSetup.lifecycleShort >= LC_RECLAIM_VISIBLE and liveSetup.lifecycleShort <= LC_MSS_CONFIRMED and not rclDetS and not na(bestSweepBarBSL) and na(lastMssBearBar)
    if advLNoRecl or advSNoRecl
        // Downgrade to SWEEP_CONFIRMED instead of desync (soft correction)
        if advLNoRecl
            liveSetup.lifecycleLong := LC_SWEEP_CONFIRMED
            liveSetup.lifecycleNameLong := lifecycle_name(LC_SWEEP_CONFIRMED)
        if advSNoRecl
            liveSetup.lifecycleShort := LC_SWEEP_CONFIRMED
            liveSetup.lifecycleNameShort := lifecycle_name(LC_SWEEP_CONFIRMED)

// --- Chapter 4: MSS Integrity Invariants ---

// Invariant M1: lifecycle = LC_MSS_CONFIRMED while mssValid is false (and not failed)
if not liveSetup.lifecycleIsDesynced
    bool mssLcDesyncL = liveSetup.lifecycleLong == LC_MSS_CONFIRMED and not mssValidL2 and not mssFailedL2 and not na(lastMssBullBar)
    bool mssLcDesyncS = liveSetup.lifecycleShort == LC_MSS_CONFIRMED and not mssValidS2 and not mssFailedS2 and not na(lastMssBearBar)
    if mssLcDesyncL or mssLcDesyncS
        // Soft correction: downgrade to RECLAIM_VISIBLE or SWEEP_CONFIRMED
        if mssLcDesyncL
            liveSetup.lifecycleLong := rclDetL ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
            liveSetup.lifecycleNameLong := lifecycle_name(liveSetup.lifecycleLong)
        if mssLcDesyncS
            liveSetup.lifecycleShort := rclDetS ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
            liveSetup.lifecycleNameShort := lifecycle_name(liveSetup.lifecycleShort)

// Invariant M2: activation allowed while mssFailed is true
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index
    bool domMssFailed2 = activeTrade.isLong ? mssFailedL2 : mssFailedS2
    if domMssFailed2
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "M2: trade activated while MSS failed"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant M3: Balanced/Conservative activation with MSS below mode minimum quality
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode != "Aggressive"
    bool domMssQPass2 = activeTrade.isLong ? mssQPassL : mssQPassS
    int domMssTrigSig2 = activeTrade.isLong ? mssTrigSigL2 : mssTrigSigS2
    if not domMssQPass2
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "M3: " + mode_name_short(sensitivityMode) + " activated without MSS mode pass"
        liveSetup.lifecycleDominant := LC_DESYNC
    else if sensitivityMode == "Conservative" and domMssTrigSig2 < 2
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "M3: CON activated with trigger sig=" + str.tostring(domMssTrigSig2) + " (need >= 2)"
        liveSetup.lifecycleDominant := LC_DESYNC

// Invariant M4: pending setup alive while MSS has clearly failed
if not liveSetup.lifecycleIsDesynced
    if _pendingLongActive and _pendingLongCanStillActivate and mssFailedL2
        _pendingLongActive := false
        _pendingLongCanStillActivate := false
        _pendingLongReason := "M4: pending invalidated — MSS failed"
    if _pendingShortActive and _pendingShortCanStillActivate and mssFailedS2
        _pendingShortActive := false
        _pendingShortCanStillActivate := false
        _pendingShortReason := "M4: pending invalidated — MSS failed"

// Invariant M5: lifecycle advanced past reclaim without valid MSS evidence
if not liveSetup.lifecycleIsDesynced
    bool advLNoMss = liveSetup.lifecycleLong >= LC_MSS_CONFIRMED and not mssValidL2 and not na(lastMssBullBar) and not mssFailedL2
    bool advSNoMss = liveSetup.lifecycleShort >= LC_MSS_CONFIRMED and not mssValidS2 and not na(lastMssBearBar) and not mssFailedS2
    if advLNoMss
        liveSetup.lifecycleLong := rclDetL ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
        liveSetup.lifecycleNameLong := lifecycle_name(liveSetup.lifecycleLong)
    if advSNoMss
        liveSetup.lifecycleShort := rclDetS ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
        liveSetup.lifecycleNameShort := lifecycle_name(liveSetup.lifecycleShort)

// Invariant M6: LC_DISPLACEMENT_CONFIRMED while underlying MSS is invalid or stale
if not liveSetup.lifecycleIsDesynced
    bool dispNoMssL = liveSetup.lifecycleLong == LC_DISPLACEMENT_CONFIRMED and (mssFailedL2 or not mssFreshL2)
    bool dispNoMssS = liveSetup.lifecycleShort == LC_DISPLACEMENT_CONFIRMED and (mssFailedS2 or not mssFreshS2)
    if dispNoMssL
        liveSetup.lifecycleLong := LC_SWEEP_CONFIRMED
        liveSetup.lifecycleNameLong := lifecycle_name(LC_SWEEP_CONFIRMED)
    if dispNoMssS
        liveSetup.lifecycleShort := LC_SWEEP_CONFIRMED
        liveSetup.lifecycleNameShort := lifecycle_name(LC_SWEEP_CONFIRMED)

// Invariant M7: Conservative activates on MSS quality weaker than Balanced
if not liveSetup.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode == "Conservative"
    bool domMssStrong2 = activeTrade.isLong ? mssQStrongL : mssQStrongS
    float domMssScore2 = activeTrade.isLong ? mssScoreL2 : mssScoreS2
    if not domMssStrong2 and domMssScore2 < 50.0
        liveSetup.lifecycleIsDesynced := true
        liveSetup.lifecycleDesyncReason := "M7: CON activated with weak MSS (score=" + str.tostring(math.round(domMssScore2)) + ")"
        liveSetup.lifecycleDominant := LC_DESYNC

// --- Backward-Compatible Field Overrides (lifecycle-authoritative) ---
if liveSetup.lifecycleIsDesynced
    liveSetup.phase := "State desync"
    liveSetup.missing := liveSetup.lifecycleDesyncReason
    liveSetup.sequenceValid := false
    liveSetup.lifecycleNameDominant := lifecycle_name(LC_DESYNC)
else if not liveSetup.isConflicted
    liveSetup.phase := liveSetup.lifecycleNameDominant
    // Chapter 2.1: Show pending status in Next Required when pending is active
    if _pendingLongActive or _pendingShortActive
        bool pendL2 = _pendingLongActive
        int barsRemaining = (pendL2 ? _pendingLongExpiryBar : _pendingShortExpiryBar) - bar_index
        string pendSide = pendL2 ? "Long" : "Short"
        liveSetup.missing := pendSide + " pending activation (" + str.tostring(math.max(0, barsRemaining)) + " bars remaining)"
    else if liveSetup.dominantBlockedByMode and not dominantLiquidityBlocked
        liveSetup.missing := liveSetup.dominantModeBlockReason
    else if not dominantLiquidityBlocked
        liveSetup.missing := liveSetup.lifecycleNextRequiredDominant
    liveSetup.sequenceValid := liveSetup.lifecycleDominant >= LC_ENTRY_ARMED

// --- Level Rendering ---
render_level(float val, bool show, color col, string txt, string mode, int segLen, int offset, string styleStr, int width, bool showLabel) =>
    var line l = na
    var label lbl = na
    style = styleStr == "Solid" ? line.style_solid : styleStr == "Dashed" ? line.style_dashed : line.style_dotted

    if show and not na(val)
        x1 = mode == "Full Width" ? bar_index - 500 : bar_index - segLen + offset
        x2 = bar_index + offset
        if na(l)
            l := line.new(x1, val, x2, val, color = col, style = style, width = width)
            if showLabel
                lbl := label.new(x2, val, txt, color = #00000000, textcolor = col, style = label.style_label_left, size = size.small)
        else
            line.set_xy1(l, x1, val)
            line.set_xy2(l, x2, val)
            line.set_color(l, col)
            line.set_style(l, style)
            line.set_width(l, width)
            if showLabel
                if na(lbl)
                    lbl := label.new(x2, val, txt, color = #00000000, textcolor = col, style = label.style_label_left, size = size.small)
                else
                    label.set_xy(lbl, x2, val)
                    label.set_text(lbl, txt)
                    label.set_textcolor(lbl, col)
            else if not na(lbl)
                label.delete(lbl)
                lbl := na
    else
        if not na(l)
            line.delete(l)
            l := na
        if not na(lbl)
            label.delete(lbl)
            lbl := na
    [l, lbl]

bool eqhSwept = false
bool eqlSwept = false
if array.size(activeSweeps) > 0
    for i = 0 to array.size(activeSweeps) - 1
        LiqSweep s = array.get(activeSweeps, i)
        if s.sourceType == SRC_EQH_EQL
            if s.isSSL
                eqlSwept := true
            else
                eqhSwept := true

if barstate.islast
    render_level(pdh, showPDH, pdhColor, "PDH", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)
    render_level(pdl, showPDL, pdlColor, "PDL", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)
    render_level(pwh, showPWH, pwhColor, "PWH", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)
    render_level(pwl, showPWL, pwlColor, "PWL", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)

    render_level(asia.lastHigh, showAsiaH, asiaHColor, "Asia High", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(asia.lastLow, showAsiaL, asiaLColor, "Asia Low", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(london.lastHigh, showLonH, lonHColor, "London High", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(london.lastLow, showLonL, lonLColor, "London Low", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(ny.isActive ? ny.high : ny.lastHigh, showNYH, nyHColor, "NY High", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    render_level(ny.isActive ? ny.low : ny.lastLow, showNYL, nyLColor, "NY Low", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)

    int eqhTransp = eqhSwept ? 80 : math.max(18, 62 - math.round(eqhScore * 0.4))
    int eqlTransp = eqlSwept ? 80 : math.max(18, 62 - math.round(eqlScore * 0.4))
    int eqhWidth = eqhScore >= 68 ? 2 : 1
    int eqlWidth = eqlScore >= 68 ? 2 : 1
    string eqhText = "EQH" + (eqhCount >= 2 ? "×" + str.tostring(eqhCount) : "") + (eqhSwept ? " ✓" : "")
    string eqlText = "EQL" + (eqlCount >= 2 ? "×" + str.tostring(eqlCount) : "") + (eqlSwept ? " ✓" : "")
    render_level(eqhLevel, showEqClusters and eqhCount >= 2, color.new(eqhColor, eqhTransp), eqhText, "Short Segment", eqClusterSegLen, eqClusterOffset, "Dotted", eqhWidth, eqClusterShowLabels)
    render_level(eqlLevel, showEqClusters and eqlCount >= 2, color.new(eqlColor, eqlTransp), eqlText, "Short Segment", eqClusterSegLen, eqClusterOffset, "Dotted", eqlWidth, eqClusterShowLabels)

// --- Helper: resolve table position ---
resolve_pos(string pos) =>
    pos == "top_right" ? position.top_right : pos == "top_left" ? position.top_left : pos == "bottom_right" ? position.bottom_right : position.bottom_left

// --- Dashboard Helper Functions ---

format_grade_word(string grade) =>
    grade == "A" ? "high quality" : grade == "B" ? "moderate quality" : grade == "C" ? "low quality" : "—"

format_confidence(int score) =>
    score >= 85 ? "High conviction" : score >= 70 ? "Strong" : score >= 50 ? "Good" : score >= 30 ? "Moderate" : "Low"

format_score_bias(int sL, int sS) =>
    int diff = sL - sS
    math.abs(diff) < 5 ? "Neutral" : diff >= 20 ? "Strong long bias" : diff >= 10 ? "Long bias" : diff > 0 ? "Slight long bias" : diff <= -20 ? "Strong short bias" : diff <= -10 ? "Short bias" : "Slight short bias"

// Lifecycle-driven format_action (Chapter 1+2.2: Quality-aware)
format_action(int lcDom, bool isDesynced, bool isConflicted, bool isLong, bool gateBlocked, bool hasActiveTrade, bool modeBlocked, string modeBlockRsn, bool pendingStale) =>
    if isDesynced
        "State error — setup/trade desync"
    else if isConflicted
        "Stand aside — both sides active, no clear edge"
    else if pendingStale
        "Pending setup stale — wait for fresh structure"
    else if modeBlocked and lcDom >= LC_MSS_CONFIRMED
        modeBlockRsn
    else if gateBlocked and lcDom >= LC_MSS_CONFIRMED and lcDom < LC_ENTRY_TRIGGERED
        "Setup blocked — check strategy eligibility"
    else
        lifecycle_action_text(lcDom)

// =====================================================================
// --- DASHBOARD 1: Trading Assistant ---
// =====================================================================
var table readTable = na
if barstate.islast
    if not na(readTable)
        table.delete(readTable)
    readTable := na
if showReadiness and barstate.islast
    bool isTrader = dashMode == "Trader"
    bool isAnalyst = dashMode == "Analyst"
    bool isDebug = dashMode == "Debug"
    bool showContext = isAnalyst or isDebug
    bool showAdvanced = isDebug

    int maxR = isDebug ? 74 : isAnalyst ? 34 : 18
    readTable := table.new(resolve_pos(readinessPos), 2, maxR, bgcolor = uiBg, border_width = 1, border_color = uiBorder)

    float wr = mainStats.totalTrades > 0 ? (float(mainStats.wins) / mainStats.totalTrades) * 100 : 0

    // --- Derived display values ---
    // Direction
    string dirStr = liveSetup.isConflicted ? "◆ BOTH" : liveSetup.isPotentialLong ? "▲ LONG" : "▼ SHORT"
    color dirColor = liveSetup.isConflicted ? color.yellow : liveSetup.isPotentialLong ? uiPosColor : uiNegColor

    // Setup state color — lifecycle-driven (Chapter 1)
    color phaseColor = liveSetup.lifecycleIsDesynced ? color.red : liveSetup.isConflicted ? color.yellow : lifecycle_is_terminal(liveSetup.lifecycleDominant) ? color.gray : liveSetup.lifecycleDominant >= LC_ENTRY_ARMED ? uiPosColor : liveSetup.lifecycleDominant >= LC_MSS_CONFIRMED ? color.orange : uiNeutralColor

    // Trader action — lifecycle-driven (Chapter 1+2.2)
    bool domPendStale = pickLong ? (liveSetup.pendingLongActive and not liveSetup.pendingStructFreshLong) : (liveSetup.pendingShortActive and not liveSetup.pendingStructFreshShort)
    string actionStr = format_action(liveSetup.lifecycleDominant, liveSetup.lifecycleIsDesynced, liveSetup.isConflicted, liveSetup.isPotentialLong, dominantLiquidityBlocked, not na(activeTrade), liveSetup.dominantBlockedByMode, liveSetup.dominantModeBlockReason, domPendStale)
    color actionColor = str.contains(actionStr, "desync") or str.contains(actionStr, "error") ? color.red : str.contains(actionStr, "ready") or str.contains(actionStr, "Trade active") ? uiPosColor : str.contains(actionStr, "No trade") or str.contains(actionStr, "blocked") or str.contains(actionStr, "invalidated") ? uiNegColor : str.contains(actionStr, "Stand aside") ? uiLabelText : str.contains(actionStr, "Wait") or str.contains(actionStr, "Monitor") ? color.orange : uiNeutralColor

    // Confidence
    string confStr = format_confidence(liveSetup.score)
    color confColor = liveSetup.score >= 70 ? uiPosColor : liveSetup.score >= 50 ? color.orange : liveSetup.score >= 30 ? uiNeutralColor : uiLabelText

    // Session
    string sessStr = activeSessName + (isSilverBullet ? " (Silver Bullet)" : isKillzone ? " (Kill Zone)" : "")
    color sessColor = isSilverBullet ? uiPosColor : isKillzone ? color.orange : uiLabelText

    // Price Location
    color pdColor = pdStatus == "Discount" ? uiPosColor : uiNegColor

    // Score bias
    string biasStr = format_score_bias(liveSetup.scoreLong, liveSetup.scoreShort)

    int r = 0

    // ═══════════════════════════════════════════════════════════════
    // PRIMARY DECISION BLOCK — answers: what side, what state, what to do
    // ═══════════════════════════════════════════════════════════════
    table.cell(readTable, 0, r, "Trading Assistant", text_color = uiHeaderText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, dirStr, text_color = dirColor, text_size = size.small)
    r += 1

    table.cell(readTable, 0, r, "Setup State", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, liveSetup.phase, text_color = phaseColor, text_size = size.small)
    r += 1

    table.cell(readTable, 0, r, "Trader Action", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, actionStr, text_color = actionColor, text_size = size.small, text_halign = text.align_left)
    r += 1

    table.cell(readTable, 0, r, "Next Required", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, liveSetup.missing, text_color = uiNeutralColor, text_size = size.small, text_halign = text.align_left)
    r += 1

    table.cell(readTable, 0, r, "Setup Quality", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, confStr + " (" + str.tostring(liveSetup.score) + ")", text_color = confColor, text_size = size.small)
    r += 1

    // Sensitivity Mode row (Chapter 2)
    string modeStr = sensitivityMode
    color modeColor = uiNeutralColor
    if liveSetup.dominantBlockedByMode
        modeStr := sensitivityMode + " — " + liveSetup.dominantModeBlockReason
        modeColor := color.orange
    table.cell(readTable, 0, r, "Sensitivity Mode", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, modeStr, text_color = modeColor, text_size = size.small, text_halign = text.align_left)
    r += 1

    // Chapter 2.1: Pending Activation row (visible when pending is active)
    if liveSetup.pendingLongActive or liveSetup.pendingShortActive
        bool pendL = liveSetup.pendingLongActive
        int pendBar = pendL ? liveSetup.pendingLongSignalBar : liveSetup.pendingShortSignalBar
        int pendExpiry = pendL ? liveSetup.pendingLongExpiryBar : liveSetup.pendingShortExpiryBar
        int barsLeft = pendExpiry - bar_index
        string pendDir = pendL ? "LONG" : "SHORT"
        string pendStr = pendDir + " pending (" + str.tostring(math.max(0, barsLeft)) + " bars left)"
        color pendCol = barsLeft > 2 ? color.orange : barsLeft > 0 ? #e65100 : uiNegColor
        table.cell(readTable, 0, r, "Pending Activation", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, r, pendStr, text_color = pendCol, text_size = size.small, text_halign = text.align_left)
        r += 1

    table.cell(readTable, 0, r, "Session", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, sessStr, text_color = sessColor, text_size = size.small)
    r += 1

    table.cell(readTable, 0, r, "Price Location", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, pdStatus, text_color = pdColor, text_size = size.small)
    r += 1

    // ═══════════════════════════════════════════════════════════════
    // SETUP CONTEXT BLOCK — explains why the setup looks the way it does
    // (Analyst + Debug modes only)
    // ═══════════════════════════════════════════════════════════════
    if showContext
        table.cell(readTable, 0, r, "─── Setup Context ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, "", bgcolor = uiBg)
        r += 1

        // Liquidity Event
        string liqEventStr = "No meaningful liquidity sweep yet"
        color liqEventCol = uiLabelText
        if liveSetup.isPotentialLong and sweptSSL
            liqEventStr := "Sell-side swept: " + bestSweepNameSSL + " (" + format_grade_word(bestSweepGradeSSL) + ")"
            liqEventCol := bestSweepGradeSSL == "A" ? uiPosColor : bestSweepGradeSSL == "B" ? color.orange : uiLabelText
        else if not liveSetup.isPotentialLong and sweptBSL
            liqEventStr := "Buy-side swept: " + bestSweepNameBSL + " (" + format_grade_word(bestSweepGradeBSL) + ")"
            liqEventCol := bestSweepGradeBSL == "A" ? uiPosColor : bestSweepGradeBSL == "B" ? color.orange : uiLabelText
        table.cell(readTable, 0, r, "Liquidity Event", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, liqEventStr, text_color = liqEventCol, text_size = size.tiny)
        r += 1

        // Structure Status (Chapter 4: MSS-truth-aware messaging)
        bool domMssValid_ = pickLong ? liveSetup.mssValidLong : liveSetup.mssValidShort
        bool domMssStrong_ = pickLong ? liveSetup.mssStrongLong : liveSetup.mssStrongShort
        bool domMssFailed_ = pickLong ? liveSetup.mssFailedLong : liveSetup.mssFailedShort
        bool domMssDetected_ = pickLong ? liveSetup.mssDetectedLong : liveSetup.mssDetectedShort
        string structStr = "No structure shift yet"
        color structCol = uiLabelText
        if domMssFailed_
            structStr := "MSS failed — structure shift not confirmed"
            structCol := uiNegColor
        else if domMssStrong_
            structStr := (liveSetup.isPotentialLong ? "Bullish" : "Bearish") + " shift confirmed (strong)"
            structCol := uiPosColor
        else if domMssValid_
            structStr := (liveSetup.isPotentialLong ? "Bullish" : "Bearish") + " shift confirmed (valid)"
            structCol := color.orange
        else if domMssDetected_
            structStr := "Weak break — structure shift not confirmed"
            structCol := uiNeutralColor
        else if liveSetup.mssGrade != ""
            structStr := (liveSetup.isPotentialLong ? "Bullish" : "Bearish") + " shift detected (" + format_grade_word(liveSetup.mssGrade) + ")"
            structCol := liveSetup.mssGrade == "A" ? uiPosColor : color.orange
        table.cell(readTable, 0, r, "Structure", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, structStr, text_color = structCol, text_size = size.tiny)
        r += 1

        // Imbalance Status
        string imbStr = "—"
        color imbCol = uiLabelText
        if liveSetup.isDegraded
            imbStr := "Imbalance zone was filled — setup weakened"
            imbCol := uiNegColor
        else if liveSetup.fvgGrade != ""
            imbStr := "Fresh " + (liveSetup.isPotentialLong ? "bullish" : "bearish") + " imbalance present (" + format_grade_word(liveSetup.fvgGrade) + ")"
            imbCol := liveSetup.fvgGrade == "A" ? uiPosColor : color.orange
        else if liveSetup.mssGrade != ""
            imbStr := "No fresh imbalance yet — waiting"
            imbCol := color.orange
        table.cell(readTable, 0, r, "Imbalance", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, imbStr, text_color = imbCol, text_size = size.tiny)
        r += 1

        // OB Confluence
        bool obConf = liveSetup.hasOBConfluence
        string obStr = obConf ? "Order block confluence present" : "No clean OB confluence"
        color obCol = obConf ? uiPosColor : uiLabelText
        table.cell(readTable, 0, r, "OB Confluence", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, obStr, text_color = obCol, text_size = size.tiny)
        r += 1

        // Chapter 3: Reclaim Status (Analyst-level concise messaging)
        bool domRclFailed = pickLong ? liveSetup.reclaimFailedLong : liveSetup.reclaimFailedShort
        bool domRclValid = pickLong ? liveSetup.reclaimValidLong : liveSetup.reclaimValidShort
        bool domRclStrong = pickLong ? liveSetup.reclaimStrongLong : liveSetup.reclaimStrongShort
        bool domRclDetected = pickLong ? liveSetup.reclaimDetectedLong : liveSetup.reclaimDetectedShort
        bool domSwept = pickLong ? sweptSSL : sweptBSL
        string rclStatusStr = domRclFailed ? "Reclaim failed — setup degraded" : domRclStrong ? "Reclaim visible — watch for structure shift" : domRclValid ? "Reclaim visible — developing" : domRclDetected ? "Early reclaim — needs confirmation" : domSwept ? "Sweep confirmed — waiting for reclaim" : "—"
        color rclStatusCol = domRclFailed ? uiNegColor : domRclStrong ? uiPosColor : domRclValid ? color.orange : domRclDetected ? uiNeutralColor : uiLabelText
        table.cell(readTable, 0, r, "Reclaim", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, rclStatusStr, text_color = rclStatusCol, text_size = size.tiny)
        r += 1

    // Long / Short Score (all modes, detail varies)
    string scoreStr = str.tostring(liveSetup.scoreLong) + " / " + str.tostring(liveSetup.scoreShort)
    if showContext
        scoreStr := scoreStr + "  ·  " + biasStr
    table.cell(readTable, 0, r, "Long / Short Score", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, scoreStr, text_color = phaseColor, text_size = size.small)
    r += 1

    // Nearest Liquidity (all modes)
    table.cell(readTable, 0, r, "Buy-Side Liquidity", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, (na(nearestBSL) ? "—" : str.tostring(nearestBSL, "#.#####") + " (" + nearestBSLName + ")"), text_color = uiNegColor, text_size = size.small)
    r += 1

    table.cell(readTable, 0, r, "Sell-Side Liquidity", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, (na(nearestSSL) ? "—" : str.tostring(nearestSSL, "#.#####") + " (" + nearestSSLName + ")"), text_color = uiPosColor, text_size = size.small)
    r += 1

    // Strategy Eligibility
    if showContext
        // ICT 2022 — detailed per-side
        string ictLongDetail = "Long: " + (ictGateLong ? "Valid" : "Invalid") + " — " + ictGateLongInfo + (ictHasValidExternalLong ? " [ext]" : "")
        string ictShortDetail = "Short: " + (ictGateShort ? "Valid" : "Invalid") + " — " + ictGateShortInfo + (ictHasValidExternalShort ? " [ext]" : "")
        color ictCol = ictGateLong and ictGateShort ? uiPosColor : (ictGateLong or ictGateShort ? color.orange : uiNegColor)
        table.cell(readTable, 0, r, "ICT 2022 Eligibility", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, ictLongDetail + "  |  " + ictShortDetail, text_color = ictCol, text_size = size.tiny)
        r += 1

        // Silver Bullet — detailed per-side
        string sbLongDetail = "Long: " + (sbGateLong ? "Valid" : "Invalid") + " — " + sbGateLongInfo + (sbHasSessionSweepLong ? " [sess]" : "")
        string sbShortDetail = "Short: " + (sbGateShort ? "Valid" : "Invalid") + " — " + sbGateShortInfo + (sbHasSessionSweepShort ? " [sess]" : "")
        color sbCol = sbGateLong and sbGateShort ? uiPosColor : (sbGateLong or sbGateShort ? color.orange : uiNegColor)
        table.cell(readTable, 0, r, "Silver Bullet Eligibility", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, sbLongDetail + "  |  " + sbShortDetail, text_color = sbCol, text_size = size.tiny)
        r += 1

        // Continuation Context
        string contStr = "Long: " + (continuationLiquidityLong ? "Valid" : "None") + "  |  Short: " + (continuationLiquidityShort ? "Valid" : "None")
        table.cell(readTable, 0, r, "Continuation Context", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, contStr, text_color = continuationLiquidityLong or continuationLiquidityShort ? uiNeutralColor : uiLabelText, text_size = size.tiny)
        r += 1
    else
        // Trader mode — compressed strategy summary
        string ictSummary = ictGateLong and ictGateShort ? "Both eligible" : ictGateLong ? "Long eligible" : ictGateShort ? "Short eligible" : "Not eligible"
        string sbSummary = sbGateLong and sbGateShort ? "Both eligible" : sbGateLong ? "Long eligible" : sbGateShort ? "Short eligible" : "Not eligible"
        string stratStr = "ICT 2022: " + ictSummary + "  |  SB: " + sbSummary
        color stratCol = (ictGateLong or ictGateShort or sbGateLong or sbGateShort) ? uiNeutralColor : uiLabelText
        table.cell(readTable, 0, r, "Strategy Status", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, r, stratStr, text_color = stratCol, text_size = size.small)
        r += 1

    // ═══════════════════════════════════════════════════════════════
    // ADVANCED BLOCK — raw engine diagnostics (Debug mode only)
    // ═══════════════════════════════════════════════════════════════
    if showAdvanced
        table.cell(readTable, 0, r, "─── Advanced ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, "", bgcolor = uiBg)
        r += 1

        // Confluence chain: Sweep(A) → MSS(B) → FVG(A) +OB
        string chainStr = ""
        if liveSetup.sweepGrade != ""
            chainStr := "Sweep(" + liveSetup.sweepGrade + ")"
        if liveSetup.mssGrade != ""
            chainStr := chainStr + " → MSS(" + liveSetup.mssGrade + ")"
        if liveSetup.fvgGrade != ""
            chainStr := chainStr + " → FVG(" + liveSetup.fvgGrade + ")"
        if liveSetup.hasOBConfluence
            chainStr := chainStr + " +OB"
        if liveSetup.isDegraded
            chainStr := chainStr + " ✗MIT"
        if liveSetup.isExpired
            chainStr := chainStr + " ✗EXP"
        if chainStr == ""
            chainStr := "—"
        table.cell(readTable, 0, r, "Confluence Chain", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, chainStr, text_color = phaseColor, text_size = size.tiny)
        r += 1

        // Sequence Status
        string seqStr = liveSetup.isConflicted ? "Conflicted" : liveSetup.isExpired ? "Expired" : liveSetup.isDegraded ? "Degraded" : liveSetup.sequenceValid ? "Valid" : "Incomplete"
        color seqColor = liveSetup.isConflicted ? color.yellow : liveSetup.isExpired ? color.gray : liveSetup.isDegraded ? color.orange : liveSetup.sequenceValid ? uiPosColor : uiNegColor
        table.cell(readTable, 0, r, "Sequence Status", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, seqStr, text_color = seqColor, text_size = size.tiny)
        r += 1

        // Best Sell-Side Sweep
        string sslScope = bestSweepSrcSSL == SRC_ROUND_NUM ? "RN" : ((bestSweepExtSSL or is_htf_liquidity_source(bestSweepSrcSSL)) ? "EXT" : "INT")
        string sslInfo = sweptSSL ? bestSweepNameSSL + " " + bestSweepGradeSSL + " [" + bestSweepTypeSSL + " · " + source_category_label(bestSweepSrcSSL, "") + " · " + sslScope + (bestSweepInducementSSL ? " · IND" : "") + "]" : "None"
        color sslInfoCol = sweptSSL ? (bestSweepGradeSSL == "A" ? uiPosColor : bestSweepGradeSSL == "B" ? color.orange : uiLabelText) : uiLabelText
        table.cell(readTable, 0, r, "Best Sell-Side Sweep", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, sslInfo, text_color = sslInfoCol, text_size = size.tiny)
        r += 1

        // Best Buy-Side Sweep
        string bslScope = bestSweepSrcBSL == SRC_ROUND_NUM ? "RN" : ((bestSweepExtBSL or is_htf_liquidity_source(bestSweepSrcBSL)) ? "EXT" : "INT")
        string bslInfo = sweptBSL ? bestSweepNameBSL + " " + bestSweepGradeBSL + " [" + bestSweepTypeBSL + " · " + source_category_label(bestSweepSrcBSL, "") + " · " + bslScope + (bestSweepInducementBSL ? " · IND" : "") + "]" : "None"
        color bslInfoCol = sweptBSL ? (bestSweepGradeBSL == "A" ? uiPosColor : bestSweepGradeBSL == "B" ? color.orange : uiLabelText) : uiLabelText
        table.cell(readTable, 0, r, "Best Buy-Side Sweep", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, bslInfo, text_color = bslInfoCol, text_size = size.tiny)
        r += 1

        // Sweep Quality
        table.cell(readTable, 0, r, "Sweep Quality", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, "SSL: " + str.tostring(math.round(sweepQualitySSL)) + "  |  BSL: " + str.tostring(math.round(sweepQualityBSL)), text_color = uiValueText, text_size = size.tiny)
        r += 1

        // EQ Clusters
        string eqInfo = ""
        if not na(eqhLevel)
            eqInfo := "EQH×" + str.tostring(eqhCount) + " @" + str.tostring(eqhLevel, "#.##") + " [" + str.tostring(math.round(eqhScore)) + "]"
        if not na(eqlLevel)
            eqInfo := eqInfo + (eqInfo != "" ? "  |  " : "") + "EQL×" + str.tostring(eqlCount) + " @" + str.tostring(eqlLevel, "#.##") + " [" + str.tostring(math.round(eqlScore)) + "]"
        if eqInfo == ""
            eqInfo := "—"
        table.cell(readTable, 0, r, "EQ Clusters", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, eqInfo, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Active Sweeps
        table.cell(readTable, 0, r, "Active Sweeps", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, str.tostring(array.size(activeSweeps)), text_color = uiValueText, text_size = size.tiny)
        r += 1

        // Nearest External Liquidity
        string extLiqStr = ""
        if not na(nearestExtBSL)
            extLiqStr := "BSL: " + str.tostring(nearestExtBSL, "#.#####")
        if not na(nearestExtSSL)
            extLiqStr := extLiqStr + (extLiqStr != "" ? "  |  " : "") + "SSL: " + str.tostring(nearestExtSSL, "#.#####")
        if extLiqStr == ""
            extLiqStr := "—"
        table.cell(readTable, 0, r, "Nearest Ext Liq", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, extLiqStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Nearest HTF Liquidity
        string htfLiqStr = ""
        if not na(nearestHTFBSL)
            htfLiqStr := "BSL: " + str.tostring(nearestHTFBSL, "#.#####")
        if not na(nearestHTFSSL)
            htfLiqStr := htfLiqStr + (htfLiqStr != "" ? "  |  " : "") + "SSL: " + str.tostring(nearestHTFSSL, "#.#####")
        if htfLiqStr == ""
            htfLiqStr := "—"
        table.cell(readTable, 0, r, "Nearest HTF Liq", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, htfLiqStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Nearest Round-Number Liquidity
        string rnLiqStr = ""
        if not na(nearestRoundBSL)
            rnLiqStr := "BSL: " + str.tostring(nearestRoundBSL, "#.#####")
        if not na(nearestRoundSSL)
            rnLiqStr := rnLiqStr + (rnLiqStr != "" ? "  |  " : "") + "SSL: " + str.tostring(nearestRoundSSL, "#.#####")
        if rnLiqStr == ""
            rnLiqStr := "—"
        table.cell(readTable, 0, r, "Nearest RN Liq", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, rnLiqStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

    // ═══════════════════════════════════════════════════════════════
    // LIFECYCLE STATE BLOCK — Chapter 1 diagnostics (Debug mode only)
    // ═══════════════════════════════════════════════════════════════
    if showAdvanced
        table.cell(readTable, 0, r, "─── Lifecycle ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, "", bgcolor = uiBg)
        r += 1

        // Lifecycle Stage (dominant)
        string lcStageStr = lifecycle_name(liveSetup.lifecycleDominant) + " (" + str.tostring(liveSetup.lifecycleDominant) + ")"
        color lcStageCol = liveSetup.lifecycleIsDesynced ? color.red : liveSetup.lifecycleDominant >= LC_ENTRY_ARMED ? uiPosColor : liveSetup.lifecycleDominant >= LC_MSS_CONFIRMED ? color.orange : lifecycle_is_terminal(liveSetup.lifecycleDominant) ? color.gray : uiNeutralColor
        table.cell(readTable, 0, r, "Lifecycle Stage", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, lcStageStr, text_color = lcStageCol, text_size = size.tiny)
        r += 1

        // Lifecycle Reason
        table.cell(readTable, 0, r, "Lifecycle Reason", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, liveSetup.lifecycleReasonDominant, text_color = uiValueText, text_size = size.tiny)
        r += 1

        // Both sides lifecycle
        string lcBothStr = "L: " + lifecycle_name(liveSetup.lifecycleLong) + " (" + str.tostring(liveSetup.lifecycleLong) + ")  |  S: " + lifecycle_name(liveSetup.lifecycleShort) + " (" + str.tostring(liveSetup.lifecycleShort) + ")"
        table.cell(readTable, 0, r, "Lifecycle L/S", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, lcBothStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Activation allowed
        string lcActStr = "Can activate: " + (liveSetup.lifecycleCanActivateDominant ? "YES" : "NO")
        color lcActCol = liveSetup.lifecycleCanActivateDominant ? uiPosColor : uiLabelText
        table.cell(readTable, 0, r, "Activation Gate", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, lcActStr, text_color = lcActCol, text_size = size.tiny)
        r += 1

        // Chapter 2: Mode Qualification (Debug only)
        string modeQualStr = "L: " + (liveSetup.longMeetsModeCandidate ? "cand" : "—") + "/" + (liveSetup.longMeetsModeActivation ? "act" : "—") + (liveSetup.longHasReclaimProxy ? "/rcl" : "") + "  |  S: " + (liveSetup.shortMeetsModeCandidate ? "cand" : "—") + "/" + (liveSetup.shortMeetsModeActivation ? "act" : "—") + (liveSetup.shortHasReclaimProxy ? "/rcl" : "")
        color modeQualCol = liveSetup.dominantMeetsModeActivation ? uiPosColor : liveSetup.dominantMeetsModeCandidate ? color.orange : uiLabelText
        table.cell(readTable, 0, r, "Mode Qualification", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, modeQualStr, text_color = modeQualCol, text_size = size.tiny)
        r += 1

        // Mode block reason
        string modeBlkStr = liveSetup.dominantBlockedByMode ? liveSetup.dominantModeBlockReason : "No mode block"
        color modeBlkCol = liveSetup.dominantBlockedByMode ? color.orange : uiPosColor
        table.cell(readTable, 0, r, "Mode Block", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, modeBlkStr, text_color = modeBlkCol, text_size = size.tiny)
        r += 1

        // Chapter 3: Reclaim Stage (replaces old reclaim quality row)
        string rclStageL = liveSetup.reclaimFailedLong ? "FAILED" : liveSetup.reclaimStrongLong ? "STRONG" : liveSetup.reclaimValidLong ? "VALID" : liveSetup.reclaimDetectedLong ? "WEAK" : "NONE"
        string rclStageS = liveSetup.reclaimFailedShort ? "FAILED" : liveSetup.reclaimStrongShort ? "STRONG" : liveSetup.reclaimValidShort ? "VALID" : liveSetup.reclaimDetectedShort ? "WEAK" : "NONE"
        string rclDbgStr = "L: " + rclStageL + " (" + str.tostring(math.round(liveSetup.reclaimScoreLong)) + ") " + str.tostring(liveSetup.reclaimAcceptBarsLong) + "bars  |  S: " + rclStageS + " (" + str.tostring(math.round(liveSetup.reclaimScoreShort)) + ") " + str.tostring(liveSetup.reclaimAcceptBarsShort) + "bars"
        color rclDbgCol = (liveSetup.reclaimFailedLong or liveSetup.reclaimFailedShort) ? uiNegColor : (liveSetup.reclaimValidLong or liveSetup.reclaimValidShort) ? uiPosColor : (liveSetup.reclaimDetectedLong or liveSetup.reclaimDetectedShort) ? color.orange : uiLabelText
        table.cell(readTable, 0, r, "Reclaim Stage", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, rclDbgStr, text_color = rclDbgCol, text_size = size.tiny)
        r += 1

        // Chapter 3: Reclaim reason detail
        string rclReasonDbg = "L: " + liveSetup.reclaimStageReasonLong + "  |  S: " + liveSetup.reclaimStageReasonShort
        table.cell(readTable, 0, r, "Reclaim Detail", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, rclReasonDbg, text_color = rclDbgCol, text_size = size.tiny)
        r += 1

        // Extension filter (Chapter 2.2)
        string extDbgStr = "L: " + (liveSetup.extensionBlockedLong ? "BLOCKED " + liveSetup.extensionReasonLong : "OK") + "  |  S: " + (liveSetup.extensionBlockedShort ? "BLOCKED " + liveSetup.extensionReasonShort : "OK")
        color extDbgCol = (liveSetup.extensionBlockedLong or liveSetup.extensionBlockedShort) ? color.orange : uiPosColor
        table.cell(readTable, 0, r, "Extension Filter", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, extDbgStr, text_color = extDbgCol, text_size = size.tiny)
        r += 1

        // Chapter 4: MSS Stage (replaces old MSS quality row)
        string mssStageL = liveSetup.mssFailedLong ? "FAILED" : liveSetup.mssStrongLong ? "STRONG" : liveSetup.mssValidLong ? "VALID" : liveSetup.mssDetectedLong ? "WEAK" : "NONE"
        string mssStageS = liveSetup.mssFailedShort ? "FAILED" : liveSetup.mssStrongShort ? "STRONG" : liveSetup.mssValidShort ? "VALID" : liveSetup.mssDetectedShort ? "WEAK" : "NONE"
        string mssDbgStr = "L: " + mssStageL + " (" + str.tostring(math.round(liveSetup.mssScoreLong)) + ") sig=" + str.tostring(liveSetup.mssTriggerSigLong) + " " + liveSetup.mssTriggerTypeLong + (liveSetup.mssBodyConfirmedLong ? " body✓" : "") + "  |  S: " + mssStageS + " (" + str.tostring(math.round(liveSetup.mssScoreShort)) + ") sig=" + str.tostring(liveSetup.mssTriggerSigShort) + " " + liveSetup.mssTriggerTypeShort + (liveSetup.mssBodyConfirmedShort ? " body✓" : "")
        color mssDbgCol = (liveSetup.mssFailedLong or liveSetup.mssFailedShort) ? uiNegColor : (liveSetup.mssValidLong or liveSetup.mssValidShort) ? uiPosColor : (liveSetup.mssDetectedLong or liveSetup.mssDetectedShort) ? color.orange : uiLabelText
        table.cell(readTable, 0, r, "MSS Stage", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, mssDbgStr, text_color = mssDbgCol, text_size = size.tiny)
        r += 1

        // Chapter 4: MSS reason detail
        string mssReasonDbg = "L: " + liveSetup.mssReasonLong + "  |  S: " + liveSetup.mssReasonShort
        table.cell(readTable, 0, r, "MSS Detail", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, mssReasonDbg, text_color = mssDbgCol, text_size = size.tiny)
        r += 1

        // Chapter 4: MSS mode pass
        string mssPassDbg = "L: " + (liveSetup.mssQualityPassLong ? "PASS" : "FAIL") + "  |  S: " + (liveSetup.mssQualityPassShort ? "PASS" : "FAIL")
        color mssPassCol = (liveSetup.mssQualityPassLong or liveSetup.mssQualityPassShort) ? uiNeutralColor : uiLabelText
        table.cell(readTable, 0, r, "MSS Mode Pass", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, mssPassDbg, text_color = mssPassCol, text_size = size.tiny)
        r += 1

        // Activation path (Chapter 2.2)
        string actPathStr = liveSetup.activationPathDominant != "" ? liveSetup.activationPathDominant : "blocked"
        color actPathCol = liveSetup.activationPathDominant != "" ? uiPosColor : uiLabelText
        table.cell(readTable, 0, r, "Activation Path", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, actPathStr, text_color = actPathCol, text_size = size.tiny)
        r += 1

        // Pending freshness (Chapter 2.2)
        string freshDbgStr = "L: " + liveSetup.freshnessReasonLong + "  |  S: " + liveSetup.freshnessReasonShort
        table.cell(readTable, 0, r, "Pending Freshness", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, freshDbgStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Mode policy thresholds
        string modeThrStr = "Min cand: " + lifecycle_name(mode_min_lifecycle_for_candidate(sensitivityMode)) + "  |  Min act: " + lifecycle_name(mode_min_lifecycle_for_activation(sensitivityMode))
        table.cell(readTable, 0, r, "Mode Thresholds", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, modeThrStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Chapter 2.1: Pending Activation Debug
        string pendDbgL = _pendingLongActive ? "ACTIVE sig=" + str.tostring(_pendingLongSignalBar) + " exp=" + str.tostring(_pendingLongExpiryBar) + " lc=" + lifecycle_name(_pendingLongInitialLC) + " [" + _pendingLongMode + "]" : "—"
        string pendDbgS = _pendingShortActive ? "ACTIVE sig=" + str.tostring(_pendingShortSignalBar) + " exp=" + str.tostring(_pendingShortExpiryBar) + " lc=" + lifecycle_name(_pendingShortInitialLC) + " [" + _pendingShortMode + "]" : "—"
        table.cell(readTable, 0, r, "Pending Long", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, pendDbgL, text_color = _pendingLongActive ? color.orange : uiLabelText, text_size = size.tiny)
        r += 1

        table.cell(readTable, 0, r, "Pending Short", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, pendDbgS, text_color = _pendingShortActive ? color.orange : uiLabelText, text_size = size.tiny)
        r += 1

        // Pending activation window
        string pendWinStr = "AGG=" + str.tostring(mode_pending_activation_bars("Aggressive")) + "  BAL=" + str.tostring(mode_pending_activation_bars("Balanced")) + "  CON=" + str.tostring(mode_pending_activation_bars("Conservative")) + "  (current: " + str.tostring(mode_pending_activation_bars(sensitivityMode)) + ")"
        table.cell(readTable, 0, r, "Pending Windows", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, pendWinStr, text_color = uiNeutralColor, text_size = size.tiny)
        r += 1

        // Delayed activation status this bar
        string delayActStr = liveSetup.pendingLongActivatedThisBar ? "LONG activated via delayed" : liveSetup.pendingShortActivatedThisBar ? "SHORT activated via delayed" : "No delayed activation"
        color delayActCol = (liveSetup.pendingLongActivatedThisBar or liveSetup.pendingShortActivatedThisBar) ? uiPosColor : uiLabelText
        table.cell(readTable, 0, r, "Delayed Activation", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, delayActStr, text_color = delayActCol, text_size = size.tiny)
        r += 1

        // Desync status
        string desyncStr = liveSetup.lifecycleIsDesynced ? "DESYNC: " + liveSetup.lifecycleDesyncReason : "OK — no invariant violations"
        color desyncCol = liveSetup.lifecycleIsDesynced ? color.red : uiPosColor
        table.cell(readTable, 0, r, "Integrity", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
        table.cell(readTable, 1, r, desyncStr, text_color = desyncCol, text_size = size.tiny)
        r += 1

    // ═══════════════════════════════════════════════════════════════
    // PERFORMANCE SECTION — secondary emphasis, lighter visual weight
    // ═══════════════════════════════════════════════════════════════
    table.cell(readTable, 0, r, "─── Performance ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(readTable, 1, r, "", bgcolor = uiBg)
    r += 1

    table.cell(readTable, 0, r, "Win Rate", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, str.format("{0,number,#.##}%", wr), text_color = wr >= 50 ? uiPosColor : uiNegColor, text_size = size.small)
    r += 1

    if showContext
        table.cell(readTable, 0, r, "Total Trades", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, r, str.tostring(mainStats.totalTrades), text_color = uiValueText, text_size = size.small)
        r += 1

        table.cell(readTable, 0, r, "Wins / Losses", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, r, str.tostring(mainStats.wins) + " / " + str.tostring(mainStats.losses), text_color = uiValueText, text_size = size.small)
        r += 1

    table.cell(readTable, 0, r, "Net R", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, str.format("{0,number,#.##}R", mainStats.totalR), text_color = mainStats.totalR >= 0 ? uiPosColor : uiNegColor, text_size = size.small)
    r += 1

    if showContext
        table.cell(readTable, 0, r, "Equity R", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
        table.cell(readTable, 1, r, str.format("{0,number,#.##}R", mainStats.equityR), text_color = mainStats.equityR >= 0 ? uiPosColor : uiNegColor, text_size = size.small)
        r += 1

    table.cell(readTable, 0, r, "Max Drawdown", text_color = uiLabelText, text_size = size.small, text_halign = text.align_left)
    table.cell(readTable, 1, r, str.format("{0,number,#.##}R", mainStats.maxDrawdownR), text_color = mainStats.maxDrawdownR < 0 ? uiNegColor : uiLabelText, text_size = size.small)

// =====================================================================
// --- DASHBOARD 2: Market Intelligence (MTF Trend + Alerts + OB Scanner) ---
// =====================================================================
int intelRows = 1 + 4 + 1 + 1 + maxAlertRows + 1 + 1 + maxScannerRows
var table marketIntelTable = table.new(resolve_pos(marketIntelPos), 3, intelRows, bgcolor = uiBg, border_width = 1, border_color = uiBorder)
if showMarketIntelDash and barstate.islast
    int row = 0

    // --- Section A: Header ---
    table.cell(marketIntelTable, 0, row, "Market Intelligence", text_color = uiHeaderText, text_size = size.small, text_halign = text.align_left)
    table.merge_cells(marketIntelTable, 0, row, 2, row)
    row += 1

    // --- Section B: MTF Trend ---
    bool htf1Bull = htf1Price > htf1Ema
    bool htf2Bull = htf2Price > htf2Ema
    bool curBull = close > emaBias

    int trendScore = (htf1Bull ? 1 : 0) + (htf2Bull ? 1 : 0) + (curBull ? 1 : 0)
    string alignment = trendScore == 3 ? "Strong Bullish" : trendScore == 0 ? "Strong Bearish" : trendScore == 2 ? "Bullish Alignment" : "Bearish Alignment"
    color alignCol = trendScore >= 2 ? uiPosColor : (trendScore == 0 ? uiNegColor : uiNeutralColor)

    table.cell(marketIntelTable, 0, row, "Alignment", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(marketIntelTable, 1, row, alignment, text_color = alignCol, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "", bgcolor = uiBg)
    row += 1

    table.cell(marketIntelTable, 0, row, "HTF 2 (" + trendHTF2 + ")", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(marketIntelTable, 1, row, htf2Bull ? "BULL" : "BEAR", text_color = htf2Bull ? uiPosColor : uiNegColor, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "", bgcolor = uiBg)
    row += 1

    table.cell(marketIntelTable, 0, row, "HTF 1 (" + trendHTF1 + ")", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(marketIntelTable, 1, row, htf1Bull ? "BULL" : "BEAR", text_color = htf1Bull ? uiPosColor : uiNegColor, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "", bgcolor = uiBg)
    row += 1

    table.cell(marketIntelTable, 0, row, "Current (" + timeframe.period + ")", text_color = uiLabelText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(marketIntelTable, 1, row, curBull ? "BULL" : "BEAR", text_color = curBull ? uiPosColor : uiNegColor, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "", bgcolor = uiBg)
    row += 1

    // --- Section C: Alert History ---
    table.cell(marketIntelTable, 0, row, "─── Alert History ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
    table.merge_cells(marketIntelTable, 0, row, 2, row)
    row += 1

    table.cell(marketIntelTable, 0, row, "Time (NY)", text_color = uiLabelText, text_size = size.tiny)
    table.cell(marketIntelTable, 1, row, "Signal", text_color = uiLabelText, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "Price", text_color = uiLabelText, text_size = size.tiny)
    row += 1

    if array.size(alertLogs) > 0
        for i = 0 to math.min(array.size(alertLogs) - 1, maxAlertRows - 1)
            AlertLog al = array.get(alertLogs, i)
            table.cell(marketIntelTable, 0, row, al.timeStr, text_color = uiLabelText, text_size = size.tiny)
            table.cell(marketIntelTable, 1, row, al.signalType, text_color = al.col, text_size = size.tiny)
            table.cell(marketIntelTable, 2, row, str.tostring(al.price, "#.#####"), text_color = uiValueText, text_size = size.tiny)
            row += 1
    else
        table.cell(marketIntelTable, 0, row, "No signals yet", text_color = uiLabelText, text_size = size.tiny)
        table.merge_cells(marketIntelTable, 0, row, 2, row)
        row += 1

    // --- Section D: Active Order Blocks ---
    table.cell(marketIntelTable, 0, row, "─── Active OBs ───", text_color = uiHeaderText, text_size = size.tiny, text_halign = text.align_left)
    table.merge_cells(marketIntelTable, 0, row, 2, row)
    row += 1

    table.cell(marketIntelTable, 0, row, "Type", text_color = uiLabelText, text_size = size.tiny)
    table.cell(marketIntelTable, 1, row, "Range", text_color = uiLabelText, text_size = size.tiny)
    table.cell(marketIntelTable, 2, row, "Age", text_color = uiLabelText, text_size = size.tiny)
    row += 1

    int obCount = 0
    if array.size(obArray) > 0
        for i = array.size(obArray) - 1 to 0
            SmartZone szOb = array.get(obArray, i)
            if not szOb.mitigated and obCount < maxScannerRows
                color c = szOb.isBull ? uiPosColor : uiNegColor
                string t = szOb.isBull ? "BULL" : "BEAR"
                string p = str.format("{0,number,#.##}-{1,number,#.##}", szOb.bottom, szOb.top)
                string a = str.tostring(bar_index - szOb.startBar) + " bars"
                table.cell(marketIntelTable, 0, row, t, text_color = c, text_size = size.tiny)
                table.cell(marketIntelTable, 1, row, p, text_color = uiValueText, text_size = size.tiny)
                table.cell(marketIntelTable, 2, row, a, text_color = uiLabelText, text_size = size.tiny)
                row += 1
                obCount += 1

    if obCount == 0
        table.cell(marketIntelTable, 0, row, "No active OBs", text_color = uiLabelText, text_size = size.tiny)
        table.merge_cells(marketIntelTable, 0, row, 2, row)

// --- Candidate Preview ---
var box candTp = na
var box candSl = na
var label candLbl = na

if barstate.islast
    // Chapter 2.1+2.2+3: Candidate preview with quality + reclaim gating
    bool hasPendingCandidate = (liveSetup.pendingLongActive and liveSetup.pendingLongCanStillActivate) or (liveSetup.pendingShortActive and liveSetup.pendingShortCanStillActivate)
    // Chapter 2.2: Block preview for stale or overextended setups
    bool domExtended = pickLong ? liveSetup.extensionBlockedLong : liveSetup.extensionBlockedShort
    bool domPendingStale = pickLong ? (liveSetup.pendingLongActive and not liveSetup.pendingStructFreshLong) : (liveSetup.pendingShortActive and not liveSetup.pendingStructFreshShort)
    // Chapter 3: Block preview if reclaim has failed on dominant side
    bool domReclaimFailed = pickLong ? liveSetup.reclaimFailedLong : liveSetup.reclaimFailedShort
    // Chapter 4: Block preview if MSS has failed or is stale on dominant side
    bool domMssFailed = pickLong ? liveSetup.mssFailedLong : liveSetup.mssFailedShort
    bool domMssStale = pickLong ? (not liveSetup.mssFreshLong) : (not liveSetup.mssFreshShort)
    bool qualityPreviewOk = not domExtended and not domPendingStale and not domReclaimFailed and not domMssFailed and not domMssStale
    if showSetups and showCandidatePreview and (liveSetup.dominantMeetsModeCandidate or hasPendingCandidate) and qualityPreviewOk and na(activeTrade) and not liveSetup.isExpired and not liveSetup.isConflicted and not liveSetup.isDegraded and not dominantLiquidityBlocked and not liveSetup.lifecycleIsDesynced
        float projRisk = atr * 1.5
        float entry = close
        bool isLongCandidate = liveSetup.isPotentialLong
        float sl = isLongCandidate ? entry - projRisk : entry + projRisk
        float tp = isLongCandidate ? entry + projRisk * 2.0 : entry - projRisk * 2.0
        int width = activeSetupSize == "Large" ? activeMinWidth * 2 : activeSetupSize == "Normal" ? activeMinWidth : 10
        color candTpCol = isLongCandidate ? longTpColor : shortTpColor
        color candSlCol = isLongCandidate ? longSlColor : shortSlColor

        // Chapter 2.1: Pending suffix for candidate label
        string pendSuffix = hasPendingCandidate and not liveSetup.dominantMeetsModeCandidate ? " [PENDING]" : ""

        if na(candTp)
            candTp := box.new(bar_index, isLongCandidate ? tp : entry, bar_index + width, isLongCandidate ? entry : tp, bgcolor = color.new(candTpCol, activeTransp + 5), border_color = candTpCol, border_width = activeBorderWidth)
            candSl := box.new(bar_index, isLongCandidate ? entry : sl, bar_index + width, isLongCandidate ? sl : entry, bgcolor = color.new(candSlCol, activeTransp + 5), border_color = candSlCol, border_width = activeBorderWidth)
            string candDir = isLongCandidate ? "▲ " : "▼ "
            candLbl := label.new(bar_index + width, entry, candDir + "Candidate (" + str.tostring(liveSetup.score) + "%" + (liveSetup.sequenceValid ? " ✓" : "") + ")" + pendSuffix, color = #00000000, textcolor = setupLabelColor, style = label.style_label_left, size = size.small)
        else
            box.set_lefttop(candTp, bar_index, isLongCandidate ? tp : entry)
            box.set_rightbottom(candTp, bar_index + width, isLongCandidate ? entry : tp)
            box.set_bgcolor(candTp, color.new(candTpCol, activeTransp + 5))
            box.set_border_color(candTp, candTpCol)
            box.set_lefttop(candSl, bar_index, isLongCandidate ? entry : sl)
            box.set_rightbottom(candSl, bar_index + width, isLongCandidate ? sl : entry)
            box.set_bgcolor(candSl, color.new(candSlCol, activeTransp + 5))
            box.set_border_color(candSl, candSlCol)
            label.set_xy(candLbl, bar_index + width, entry)
            string candDir2 = isLongCandidate ? "▲ " : "▼ "
            label.set_text(candLbl, candDir2 + "Candidate (" + str.tostring(liveSetup.score) + "%" + (liveSetup.sequenceValid ? " ✓" : "") + ")" + pendSuffix)
            label.set_textcolor(candLbl, setupLabelColor)
    else
        if not na(candTp)
            box.delete(candTp)
            box.delete(candSl)
            label.delete(candLbl)
            candTp := na
            candSl := na
            candLbl := na

// --- Alerts ---
bool alertBuy = sig2022B or sigSBB
bool alertSell = sig2022S or sigSBS
alertcondition(alertBuy, "Buy Signal", "ICT/SMC Buy Setup Confirmed")
alertcondition(alertSell, "Sell Signal", "ICT/SMC Sell Setup Confirmed")

// --- Visual Shapes ---
plotshape(showLabels and isSignalB, "Buy Signal", shape.labelup, location.belowbar, BULL_COLOR, text="BUY", textcolor=color.white, size = size.small)
plotshape(showLabels and isSignalS, "Sell Signal", shape.labeldown, location.abovebar, BEAR_COLOR, text="SELL", textcolor=color.white, size = size.small)
