indicator("SMC & ICT Multi-Strategy [Pro Visuals]", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// --- Constants ---
string NY_TZ = "America/New_York"
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color NEUTRAL_COLOR = #5b9cf6

// --- User Defined Types ---
type Trade
    string  strategyName
    bool    isLong
    float   entryPrice
    float   stopPrice
    float   tp1Price
    float   tp2Price
    int     entryBar
    bool    isActive = false
    bool    isTp1Hit = false
    box     tpBox    = na
    box     slBox    = na

type AlertLog
    string  timeStr
    string  signalType
    float   price
    color   col

type Stats
    int     totalTrades = 0
    int     wins = 0
    int     losses = 0
    float   totalR = 0.0
    float   equityR = 0.0
    float   maxDrawdownR = 0.0
    float   peakEquityR = 0.0

type SessionData
    string name
    string timeRange
    bool   isActive = false
    float  high = na
    float  low = na
    float  lastHigh = na
    float  lastLow = na

type SetupState
    string  phase = "Monitoring"
    int     score = 0
    string  missing = "Searching for context..."
    float   nearestBSL = na
    float   nearestSSL = na
    float   requiredSweep = na
    float   triggerLevel = na
    float   invalidationLevel = na
    bool    isPotentialLong = false
    bool    isPotentialShort = false
    // Phase 1+2: Quality & sequence tracking
    int     scoreLong = 0
    int     scoreShort = 0
    string  phaseLong = "Monitoring"
    string  phaseShort = "Monitoring"
    string  missingLong = ""
    string  missingShort = ""
    string  sweepGrade = ""
    string  mssGrade = ""
    string  fvgGrade = ""
    bool    sequenceValid = false
    bool    hasOBConfluence = false
    // Phase 5: Lifecycle
    bool    isExpired = false
    bool    isConflicted = false
    bool    isDegraded = false
    // Chapter 1: Setup Lifecycle
    int     lifecycleLong = 0
    int     lifecycleShort = 0
    int     lifecycleDominant = 0
    string  lifecycleNameLong = ""
    string  lifecycleNameShort = ""
    string  lifecycleNameDominant = ""
    string  lifecycleReasonLong = ""
    string  lifecycleReasonShort = ""
    string  lifecycleReasonDominant = ""
    string  lifecycleNextRequiredLong = ""
    string  lifecycleNextRequiredShort = ""
    string  lifecycleNextRequiredDominant = ""
    bool    lifecycleCanActivateLong = false
    bool    lifecycleCanActivateShort = false
    bool    lifecycleCanActivateDominant = false
    bool    lifecycleIsDesynced = false
    string  lifecycleDesyncReason = ""
    // Chapter 2: Sensitivity Mode Execution Policy
    string  sensitivityModeActive = ""
    int     modeMinCandidateLifecycle = 0
    int     modeMinActivationLifecycle = 0
    bool    dominantMeetsModeCandidate = false
    bool    dominantMeetsModeActivation = false
    bool    dominantBlockedByMode = false
    string  dominantModeBlockReason = ""
    bool    longMeetsModeCandidate = false
    bool    shortMeetsModeCandidate = false
    bool    longMeetsModeActivation = false
    bool    shortMeetsModeActivation = false
    string  longModeBlockReason = ""
    string  shortModeBlockReason = ""
    bool    longHasReclaimProxy = false
    bool    shortHasReclaimProxy = false
    // Chapter 2.1: Pending Activation State
    bool    pendingLongActive = false
    bool    pendingShortActive = false
    int     pendingLongSignalBar = 0
    int     pendingShortSignalBar = 0
    int     pendingLongExpiryBar = 0
    int     pendingShortExpiryBar = 0
    string  pendingLongSource = ""
    string  pendingShortSource = ""
    int     pendingLongInitialLifecycle = 0
    int     pendingShortInitialLifecycle = 0
    string  pendingLongMode = ""
    string  pendingShortMode = ""
    string  pendingLongReason = ""
    string  pendingShortReason = ""
    bool    pendingLongCanStillActivate = false
    bool    pendingShortCanStillActivate = false
    bool    pendingLongActivatedThisBar = false
    bool    pendingShortActivatedThisBar = false
    // Chapter 2.2: Quality Recovery Patch
    float   reclaimStrengthLong = 0.0
    float   reclaimStrengthShort = 0.0
    string  reclaimReasonLong = ""
    string  reclaimReasonShort = ""
    bool    extensionBlockedLong = false
    bool    extensionBlockedShort = false
    float   extensionDistLong = 0.0
    float   extensionDistShort = 0.0
    string  extensionReasonLong = ""
    string  extensionReasonShort = ""
    bool    mssQualityPassLong = false
    bool    mssQualityPassShort = false
    string  mssQualityReasonLong = ""
    string  mssQualityReasonShort = ""
    bool    pendingStructFreshLong = true
    bool    pendingStructFreshShort = true
    string  freshnessReasonLong = ""
    string  freshnessReasonShort = ""
    string  activationPathDominant = ""
    // Chapter 3: Reclaim Stage
    bool    reclaimDetectedLong = false
    bool    reclaimDetectedShort = false
    bool    reclaimValidLong = false
    bool    reclaimValidShort = false
    bool    reclaimStrongLong = false
    bool    reclaimStrongShort = false
    bool    reclaimFailedLong = false
    bool    reclaimFailedShort = false
    float   reclaimScoreLong = 0.0
    float   reclaimScoreShort = 0.0
    string  reclaimStageReasonLong = ""
    string  reclaimStageReasonShort = ""
    int     reclaimAcceptBarsLong = 0
    int     reclaimAcceptBarsShort = 0
    // Chapter 4: MSS / Structure Shift Validation
    bool    mssDetectedLong = false
    bool    mssDetectedShort = false
    bool    mssValidLong = false
    bool    mssValidShort = false
    bool    mssStrongLong = false
    bool    mssStrongShort = false
    bool    mssFreshLong = true
    bool    mssFreshShort = true
    bool    mssFailedLong = false
    bool    mssFailedShort = false
    float   mssScoreLong = 0.0
    float   mssScoreShort = 0.0
    float   mssBreakLevelLong = na
    float   mssBreakLevelShort = na
    string  mssReasonLong = ""
    string  mssReasonShort = ""
    string  mssTriggerTypeLong = ""
    string  mssTriggerTypeShort = ""
    int     mssTriggerSigLong = 0
    int     mssTriggerSigShort = 0
    bool    mssBodyConfirmedLong = false
    bool    mssBodyConfirmedShort = false

type SmartZone
    box   boxId
    float top
    float bottom
    bool  isBull
    bool  mitigated = false
    bool  isInverted = false
    int   startBar
    float ce = na
    bool  ceRespected = false
    bool  ceBroken = false
    int   touchCount = 0
    float gapSize = na

// --- Liquidity Source Constants ---
// Source types (int enum for Pine efficiency)
int SRC_SESSION     = 1   // Asia/London/NY high or low
int SRC_PDH_PDL     = 2   // Previous day high/low
int SRC_PWH_PWL     = 3   // Previous week high/low
int SRC_PIVOT_EXT   = 4   // External structure pivot
int SRC_PIVOT_INT   = 5   // Internal structure pivot
int SRC_EQH_EQL     = 6   // Equal highs / equal lows cluster
int SRC_DEVELOPING  = 7   // Developing session level (lower trust)
int SRC_PIVOT_HTF_1 = 8   // Configured HTF pivot tier 1
int SRC_PIVOT_HTF_2 = 9   // Configured HTF pivot tier 2
int SRC_PIVOT_HTF_3 = 10  // Optional configured HTF pivot tier 3
int SRC_ROUND_NUM   = 11  // Psychological / round-number liquidity

// Source priority scores (higher = more important)
int PRI_PWH_PWL     = 100
int PRI_PDH_PDL     = 80
int PRI_EQH_EQL     = 70
int PRI_SESSION     = 60
int PRI_PIVOT_EXT   = 50
int PRI_PIVOT_INT   = 25
int PRI_DEVELOPING  = 15
int PRI_PIVOT_HTF_1 = 68
int PRI_PIVOT_HTF_2 = 78
int PRI_PIVOT_HTF_3 = 88
int PRI_ROUND_NUM   = 35

// Sweep type classification
int SWEEP_SHALLOW        = 1   // Tiny penetration, low confidence
int SWEEP_CLEAN_RAID     = 2   // Good penetration + rejection
int SWEEP_DEEP_STOP_RUN  = 3   // Very deep, exhaustion risk
int SWEEP_EXT_LIQ_GRAB   = 4   // Major external level swept
int SWEEP_INT_LIQ_SWEEP  = 5   // Internal level swept
int SWEEP_SESSION        = 6   // Session extreme swept
int SWEEP_HTF            = 7   // PDH/PDL/PWH/PWL swept
int SWEEP_INDUCEMENT     = 8   // Small level taken before bigger target

// Sweep lifecycle states
int LIFE_DETECTED        = 1
int LIFE_ACTIVE          = 2
int LIFE_CONFIRMED       = 3   // Validated by rejection/displacement
int LIFE_CONSUMED        = 4   // Used by MSS/setup
int LIFE_STALE           = 5
int LIFE_INVALIDATED     = 6

// --- Setup Lifecycle Constants (Chapter 1: State Machine Integrity) ---
int LC_NONE                    = 0   // No meaningful setup context
int LC_LIQUIDITY_IDENTIFIED    = 1   // Liquidity nearby but not swept
int LC_SWEEP_CONFIRMED         = 2   // Liquidity swept, no structure shift yet
int LC_RECLAIM_VISIBLE         = 3   // Post-sweep recovery visible, MSS not confirmed
int LC_MSS_CONFIRMED           = 4   // MSS confirmed after sweep
int LC_DISPLACEMENT_CONFIRMED  = 5   // MSS + strong displacement confirmed
int LC_ENTRY_ARMED             = 6   // Full sequence complete (sweep→MSS→FVG), entry zone exists
int LC_ENTRY_TRIGGERED         = 7   // Entry criteria triggered, trade can activate
int LC_ACTIVE                  = 8   // Valid active trade
int LC_EXPIRED                 = 9   // Setup aged out
int LC_INVALIDATED             = 10  // Setup structurally negated
int LC_DESYNC                  = 11  // Contradictory state detected

// --- Liquidity Level Type ---
// Represents a monitored liquidity source with classification metadata
type LiqLevel
    string  name           // Human-readable name
    float   price          // Level price
    int     sourceType     // SRC_* constant
    int     priority       // PRI_* score
    bool    isExternal     // External vs internal liquidity
    bool    isSSL          // true = sell-side (below), false = buy-side (above)
    bool    isHTF          // Weekly/Daily = true
    bool    isSession      // Session-derived level
    bool    isCluster      // Part of EQH/EQL cluster
    int     clusterCount   // Number of touches in cluster (0 if not cluster)
    int     createdBar     // Bar when level was registered

// --- Liquidity Sweep Type (expanded) ---
type LiqSweep
    // Identity
    string  levelName
    float   levelPrice
    int     sourceType      // SRC_* constant
    int     sourcePriority  // PRI_* score
    bool    isExternal      // External vs internal
    bool    isSSL           // Sell-side vs buy-side
    // Sweep metrics
    float   sweepDepth
    float   sweepDepthAtr
    float   wickPenetrationRatio   // wick beyond level / total range
    float   rejectionStrength      // body reclaim ratio (0-1)
    bool    hasRejection
    bool    hasDisplacement
    // Classification
    int     sweepType       // SWEEP_* constant
    string  sweepTypeStr    // Human-readable sweep type
    string  grade           // "A" / "B" / "C" / "Reject"
    float   qualityScore    // Composite 0-100
    // Lifecycle
    int     sweepBar
    int     lifecycleState  // LIFE_* constant
    bool    isActionable    // Still usable for setup
    bool    isConsumed      // Used by MSS/setup
    // Context
    bool    isHTF           // Weekly/Daily level sweep
    bool    isSessionSweep  // Session extreme sweep
    bool    isClusterSweep  // EQH/EQL cluster sweep
    int     clusterCount    // Persist cluster significance through lifecycle updates
    bool    isInducementLike
    bool    inKillzone      // Swept during killzone
    bool    inSilverBullet  // Swept during SB window
    string  sessionAtSweep  // Session name when swept

