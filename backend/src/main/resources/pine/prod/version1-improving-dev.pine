int activeBorderWidth = input.int(2, "Active Border Thickness", minval = 1, maxval = 5, group = G_ACTIVE_VIS)
int activeTransp = input.int(85, "Active Setup Transparency", minval = 0, maxval = 100, group = G_ACTIVE_VIS)

var string G_OUTCOME_VIS = "Outcome Markers"
bool showTpMarkers = input.bool(true, "Show TP/TP1 Hit Markers", group = G_OUTCOME_VIS)
bool showSlMarkers = input.bool(true, "Show SL/BE Hit Markers", group = G_OUTCOME_VIS)
string markerSizeInput = input.string("Small", "Marker Size", options = ["Tiny", "Small", "Normal"], group = G_OUTCOME_VIS)
color tpMarkerColor = input.color(BULL_COLOR, "TP Marker Color", group = G_OUTCOME_VIS)
color slMarkerColor = input.color(BEAR_COLOR, "SL Marker Color", group = G_OUTCOME_VIS)

var string G_STYLE = "Dashboard Colors & UI Theme"
color uiBg = input.color(color.new(#131722, 10), "Dashboard Background", group = G_STYLE)
color uiBorder = input.color(#363a45, "Dashboard Border", group = G_STYLE)
color uiHeaderText = input.color(color.white, "Header Text", group = G_STYLE)
color uiLabelText = input.color(color.gray, "Label Text", group = G_STYLE)
color uiValueText = input.color(color.white, "Value Text", group = G_STYLE)
color uiPosColor = input.color(BULL_COLOR, "Positive Color", group = G_STYLE)
color uiNegColor = input.color(BEAR_COLOR, "Negative Color", group = G_STYLE)
color uiNeutralColor = input.color(NEUTRAL_COLOR, "Neutral/Accent Color", group = G_STYLE)

// --- Sensitivity Logic ---
float sensAtrMult = sensitivityMode == "Aggressive" ? 1.0 : sensitivityMode == "Conservative" ? 2.5 : 1.5
int sensPivotLen = sensitivityMode == "Aggressive" ? 2 : sensitivityMode == "Conservative" ? 5 : 3

// --- Session Engine ---
var asia    = T.SessionData.new("Asia", "2000-0000")
var london  = T.SessionData.new("London", "0200-1100")
var ny      = T.SessionData.new("New York", "0800-1700")
var overlap = T.SessionData.new("London/NY Overlap", "0800-1100")
var sbLon   = T.SessionData.new("SB London", "0300-0400")
var sbAm    = T.SessionData.new("SB AM", "1000-1100")

update_session(T.SessionData s) =>
    inSess = not na(time(timeframe.period, s.timeRange, NY_TZ))
    if inSess
        if not s.isActive
            s.high := high
            s.low := low
        else
            s.high := math.max(high, s.high)
            s.low := math.min(low, s.low)
    else if s.isActive
        s.lastHigh := s.high
        s.lastLow := s.low
    s.isActive := inSess

update_session(asia)
update_session(london)
update_session(ny)
update_session(overlap)
update_session(sbLon)
update_session(sbAm)

string activeSessName = overlap.isActive ? overlap.name : ny.isActive ? ny.name : london.isActive ? london.name : asia.isActive ? asia.name : "Inter-Session"
bool isKillzone = sbLon.isActive or sbAm.isActive or overlap.isActive
bool isSilverBullet = sbLon.isActive or sbAm.isActive

// --- HTF Liquidity ---
float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
float pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
float pwl = request.security(syminfo.tickerid, "W", low[1], lookahead = barmerge.lookahead_on)

get_last_confirmed_pivot_high(string tf, int leftLen, int rightLen) =>
    request.security(
         syminfo.tickerid,
         tf,
         ta.valuewhen(not na(ta.pivothigh(high, leftLen, rightLen)), ta.pivothigh(high, leftLen, rightLen), 0),
         lookahead = barmerge.lookahead_off)

get_last_confirmed_pivot_low(string tf, int leftLen, int rightLen) =>
    request.security(
         syminfo.tickerid,
         tf,
         ta.valuewhen(not na(ta.pivotlow(low, leftLen, rightLen)), ta.pivotlow(low, leftLen, rightLen), 0),
         lookahead = barmerge.lookahead_off)

// --- Core Data & Primitives ---
int atrLen = input.int(14, "ATR Length", minval = 1, group = G_SENS)
float atr = ta.atr(atrLen)
float bodySize = math.abs(close - open)
float rangeSize = high - low
float volSma = ta.sma(volume, 20)
bool volOk = na(volume) or volume > volSma * 1.2

// --- Reclaim Proxy Primitives (Chapter 2) ---
float recentHigh5 = ta.highest(high, 5)
float recentLow5 = ta.lowest(low, 5)
float recentMid5 = (recentHigh5 + recentLow5) / 2.0

// --- Chapter 3: Reclaim Stage Persistent State ---
var int    _rclSweepRefL = na       // sweep bar this reclaim tracks (reset on new sweep)
var int    _rclSweepRefS = na
var float  _rclThreshL = na         // current reclaim threshold
var float  _rclThreshS = na
var int    _rclAcceptL = 0          // acceptance bar count
var int    _rclAcceptS = 0
var bool   _rclFailedL = false      // reclaim has failed
var bool   _rclFailedS = false
var int    _rclDetBarL = na         // bar when first detected
var int    _rclDetBarS = na

// --- Chapter 4: MSS / Structure Shift Persistent State ---
var int    _mssRefBarL = na          // bar of the MSS event being tracked (long side)
var int    _mssRefBarS = na
var float  _mssBreakLvlL = na        // the trigger level that was broken
var float  _mssBreakLvlS = na
var int    _mssSweepRefL = na        // sweep bar this MSS tracks
var int    _mssSweepRefS = na
var float  _mssScorePersistL = 0.0   // persisted composite score
var float  _mssScorePersistS = 0.0
var bool   _mssFailedPersistL = false
var bool   _mssFailedPersistS = false
var int    _mssFollowBarsL = 0       // bars of follow-through after break
var int    _mssFollowBarsS = 0
var bool   _mssBodyConfL = false     // persisted body confirmation
var bool   _mssBodyConfS = false
var float  _mssBreakQScoreL = 0.0    // persisted break quality score
var float  _mssBreakQScoreS = 0.0

// --- Chapter 5: Displacement Quality Persistent State ---
var int    _dispRefBarL = na          // bar of the displacement event being tracked (long side)
var int    _dispRefBarS = na
var float  _dispScorePersistL = 0.0   // persisted composite displacement score
var float  _dispScorePersistS = 0.0
var bool   _dispFailedPersistL = false
var bool   _dispFailedPersistS = false
var int    _dispFollowBarsL = 0       // bars of follow-through after displacement
var int    _dispFollowBarsS = 0
var float  _dispOriginL = na          // displacement origin price for snapback detection
var float  _dispOriginS = na
var float  _dispExtremeL = na         // displacement extreme price
var float  _dispExtremeS = na
var int    _dispMssRefL = na          // the MSS bar this displacement tracks
var int    _dispMssRefS = na

bool isDispBull = bodySize > (atr * sensAtrMult * 0.6) and rangeSize > (atr * sensAtrMult) and close > open and volOk
bool isDispBear = bodySize > (atr * sensAtrMult * 0.6) and rangeSize > (atr * sensAtrMult) and close < open and volOk
bool isDisplacement = isDispBull or isDispBear

float emaBias = ta.ema(close, 200)
float emaSlope = emaBias - emaBias[10]
float emaBuffer = atr * 0.3
string marketBias = close > emaBias + emaBuffer and emaSlope > 0 ? "Bullish"
     : close < emaBias - emaBuffer and emaSlope < 0 ? "Bearish"
     : "Neutral"


// MTF Trend Data (BUG FIX: htf2Ema and htf2Price now use trendHTF2)
float htf1Ema = request.security(syminfo.tickerid, trendHTF1, ta.ema(close, 200))
float htf2Ema = request.security(syminfo.tickerid, trendHTF2, ta.ema(close, 200))
float htf1Price = request.security(syminfo.tickerid, trendHTF1, close)
float htf2Price = request.security(syminfo.tickerid, trendHTF2, close)

// --- Sensitivity Logic (updated) ---
int sensLeftLen = sensitivityMode == "Aggressive" ? 3 : sensitivityMode == "Conservative" ? 7 : 5
int sensRightLen = sensitivityMode == "Aggressive" ? 1 : sensitivityMode == "Conservative" ? 3 : 2
int pivotMaxAge = sensitivityMode == "Aggressive" ? 100 : sensitivityMode == "Conservative" ? 200 : 150

// --- Market Structure Shift (MSS) ---
float pHi = ta.pivothigh(sensLeftLen, sensRightLen)
float pLo = ta.pivotlow(sensLeftLen, sensRightLen)

var float lastPHi = na
var float prevPHi = na
var int lastPHiBar = na
var float lastPLo = na
var float prevPLo = na
var int lastPLoBar = na

float minSwingDepth = atr * 0.5

if not na(pHi) and (na(lastPLo) or (pHi - lastPLo) > minSwingDepth)
    prevPHi := lastPHi
    lastPHi := pHi
    lastPHiBar := bar_index - sensRightLen

if not na(pLo) and (na(lastPHi) or (lastPHi - pLo) > minSwingDepth)
    prevPLo := lastPLo
    lastPLo := pLo
    lastPLoBar := bar_index - sensRightLen

// Expire stale pivots
if not na(lastPHiBar) and (bar_index - lastPHiBar) > pivotMaxAge
    lastPHi := na
    lastPHiBar := na
if not na(lastPLoBar) and (bar_index - lastPLoBar) > pivotMaxAge
    lastPLo := na
    lastPLoBar := na

float htfPivot1High = enableHtfPivot1 ? get_last_confirmed_pivot_high(liqPivotTf1, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot1Low = enableHtfPivot1 ? get_last_confirmed_pivot_low(liqPivotTf1, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot2High = enableHtfPivot2 ? get_last_confirmed_pivot_high(liqPivotTf2, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot2Low = enableHtfPivot2 ? get_last_confirmed_pivot_low(liqPivotTf2, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot3High = enableHtfPivot3 ? get_last_confirmed_pivot_high(liqPivotTf3, htfPivotLeftLen, htfPivotRightLen) : na
float htfPivot3Low = enableHtfPivot3 ? get_last_confirmed_pivot_low(liqPivotTf3, htfPivotLeftLen, htfPivotRightLen) : na

// BOS (continuation) vs MSS (reversal)
bool bosBull = ta.crossover(close, lastPHi) and isDispBull
bool bosBear = ta.crossunder(close, lastPLo) and isDispBear
bool mssBull = ta.crossover(close, lastPHi) and isDispBull and not na(prevPLo) and low[1] < prevPLo
bool mssBear = ta.crossunder(close, lastPLo) and isDispBear and not na(prevPHi) and high[1] > prevPHi

// --- Sequence Tracking: persistent bar timestamps for Sweep → MSS → FVG ordering ---
var int lastMssBullBar = na
var int lastMssBearBar = na
var float lastMssBullDispStrength = na
var float lastMssBearDispStrength = na

if mssBull
    lastMssBullBar := bar_index
    lastMssBullDispStrength := math.abs(close - open) / atr
if mssBear
    lastMssBearBar := bar_index
    lastMssBearDispStrength := math.abs(close - open) / atr

// Expire stale MSS (same age logic as sweeps)
int mssMaxAge = sensitivityMode == "Aggressive" ? 50 : sensitivityMode == "Conservative" ? 120 : 80
if not na(lastMssBullBar) and (bar_index - lastMssBullBar) > mssMaxAge
    lastMssBullBar := na
    lastMssBullDispStrength := na
if not na(lastMssBearBar) and (bar_index - lastMssBearBar) > mssMaxAge
    lastMssBearBar := na
    lastMssBearDispStrength := na

// --- SMC Elements (FVG & OB) ---
var T.SmartZone[] fvgArray = array.new<T.SmartZone>()
var T.SmartZone[] obArray = array.new<T.SmartZone>()

// =====================================================================
// FVG ENGINE — Clean-room reimplementation of Lux-style detection behavior
// Original behavioral reference: Fair Value Gap [LuxAlgo] (CC BY-NC-SA 4.0)
// This is an independent reimplementation adapted to this indicator's
// SmartZone architecture, scoring pipeline, and setup lifecycle.
// =====================================================================

// FVG detection function — evaluated in source timeframe context via request.security.
// Returns: [bullDetected, bearDetected, zoneTop, zoneBot, sourceTimestamp]
//
// Detection rules (clean-room reimplementation of Lux-style behavior):
//   Bullish: low > high[2]  AND  close[1] > high[2]  AND  gapRatio > threshold
//   Bearish: high < low[2]  AND  close[1] < low[2]   AND  gapRatio > threshold
//
// Threshold modes:
//   Auto:   cumulative average of (range / low) across all bars — adapts to instrument & TF
//   Manual: user-supplied percentage converted to ratio
detect_fvg() =>
    // Threshold: adaptive cumulative average, or manual percentage
    float thresh = fvgAutoThreshold ? ta.cum((high - low) / low) / bar_index : fvgThresholdPct / 100.0

    // Bullish FVG: 3-candle upward imbalance with close commitment
    //   candle[0].low above candle[2].high = price gap up
    //   candle[1].close above candle[2].high = middle candle confirms bullish intent
    //   gap ratio = (gap size) / (reference price) must exceed threshold
    bool bull = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > thresh

    // Bearish FVG: mirror — 3-candle downward imbalance
    //   candle[0].high below candle[2].low = price gap down
    //   candle[1].close below candle[2].low = middle candle confirms bearish intent
    bool bear = high < low[2] and close[1] < low[2] and (low[2] - high) / high > thresh

    // Zone bounds (absolute price levels, TF-native)
    float zTop = bull ? low : bear ? low[2] : na
    float zBot = bull ? high[2] : bear ? high : na

    // Source-bar timestamp for MTF deduplication
    int zTime = time

    [bull, bear, zTop, zBot, zTime]

// Execute detection via request.security for optional MTF support.
// When fvgTimeframe is "" (default), evaluates on the chart timeframe.
// No lookahead — only confirmed source-bar data is used.
[fvgBullRaw, fvgBearRaw, fvgTopRaw, fvgBotRaw, fvgSourceTime] = request.security(syminfo.tickerid, fvgTimeframe, detect_fvg())

// MTF deduplication: one FVG registration per source-timeframe detection event.
// When using a higher TF, the same detection fires on every chart bar until the
// next HTF bar closes. The timestamp check prevents repeated insertions.
var int lastFvgRegisteredTime = 0
bool bullFVG = fvgBullRaw and fvgSourceTime != lastFvgRegisteredTime
bool bearFVG = fvgBearRaw and fvgSourceTime != lastFvgRegisteredTime

if bullFVG or bearFVG
    lastFvgRegisteredTime := fvgSourceTime

// Gap size from returned zone bounds (works for both local and MTF detection)
float fvgGapSize = not na(fvgTopRaw) and not na(fvgBotRaw) ? fvgTopRaw - fvgBotRaw : 0.0
float maxFvgSize = atr * 3.0

// Quality grading (for confluence scoring, not detection filtering)
// Grading uses chart-TF displacement and ATR — a large HTF gap relative to
// chart ATR naturally scores higher, which is the correct behavior.
// Grade A: strong displacement on middle candle + large gap (> 0.5 ATR)
bool bullFVG_A = bullFVG and isDispBull[1] and fvgGapSize > atr * 0.5 and fvgGapSize < maxFvgSize
bool bearFVG_A = bearFVG and isDispBear[1] and fvgGapSize > atr * 0.5 and fvgGapSize < maxFvgSize
// Grade B: displacement OR moderate gap (> 0.3 ATR), not already Grade A
bool bullFVG_B = bullFVG and (isDispBull[1] or fvgGapSize > atr * 0.3) and not bullFVG_A and fvgGapSize < maxFvgSize
bool bearFVG_B = bearFVG and (isDispBear[1] or fvgGapSize > atr * 0.3) and not bearFVG_A and fvgGapSize < maxFvgSize
// Grade C: basic valid FVG (passed Lux-style threshold + close confirmation)
bool bullFVG_C = bullFVG and not bullFVG_A and not bullFVG_B
bool bearFVG_C = bearFVG and not bearFVG_A and not bearFVG_B

// Bias-aligned variants for strategy triggers (Silver Bullet etc.)
bool bullFvgAligned = bullFVG and (marketBias != "Bearish")
bool bearFvgAligned = bearFVG and (marketBias != "Bullish")

// --- FVG Tracking State ---
// Persistent tracking for sequence validation (Sweep → MSS → FVG) and mitigation
var int   lastBullFvgBar = na
var int   lastBearFvgBar = na
var int   lastBullFvgGrade = 0
var int   lastBearFvgGrade = 0
var float lastBullFvgTop = na
var float lastBullFvgBot = na
var float lastBearFvgTop = na
var float lastBearFvgBot = na
var bool  lastBullFvgMitigated = false
var bool  lastBearFvgMitigated = false

if bullFVG
    lastBullFvgBar := bar_index
    lastBullFvgGrade := bullFVG_A ? 3 : bullFVG_B ? 2 : 1
    lastBullFvgTop := fvgTopRaw
    lastBullFvgBot := fvgBotRaw
    lastBullFvgMitigated := false
if bearFVG
    lastBearFvgBar := bar_index
    lastBearFvgGrade := bearFVG_A ? 3 : bearFVG_B ? 2 : 1
    lastBearFvgTop := fvgTopRaw
    lastBearFvgBot := fvgBotRaw
    lastBearFvgMitigated := false

// --- FVG Lifecycle: Close-Based Mitigation ---
// Bull FVG mitigated when close moves below its lower boundary (bottom of gap)
// Bear FVG mitigated when close moves above its upper boundary (top of gap)
// This is close-based, not wick-based — consistent with the reference behavior.
if not na(lastBullFvgBar) and not lastBullFvgMitigated and close < lastBullFvgBot
    lastBullFvgMitigated := true
if not na(lastBearFvgBar) and not lastBearFvgMitigated and close > lastBearFvgTop
    lastBearFvgMitigated := true

// --- FVG Expiry ---
int fvgMaxAge = sensitivityMode == "Aggressive" ? 40 : sensitivityMode == "Conservative" ? 100 : 60
if not na(lastBullFvgBar) and (bar_index - lastBullFvgBar) > fvgMaxAge
    lastBullFvgBar := na
    lastBullFvgGrade := 0
    lastBullFvgMitigated := false
if not na(lastBearFvgBar) and (bar_index - lastBearFvgBar) > fvgMaxAge
    lastBearFvgBar := na
    lastBearFvgGrade := 0
    lastBearFvgMitigated := false

// Returns: 0 = no overlap, 1 = merge (expand existing), 2 = near-duplicate (skip)
check_fvg_overlap(T.SmartZone[] arr, float newTop, float newBottom, bool newIsBull) =>
    int result = 0
    int mergeIdx = -1
    float newSize = newTop - newBottom
    if array.size(arr) > 0 and newSize > 0
        int startIdx = math.max(0, array.size(arr) - 8)
        for i = array.size(arr) - 1 to startIdx
            T.SmartZone existing = array.get(arr, i)
            if existing.isBull == newIsBull and not existing.mitigated
                float exSize = existing.top - existing.bottom
                if exSize > 0
                    float overlapTop = math.min(existing.top, newTop)
                    float overlapBot = math.max(existing.bottom, newBottom)
                    if overlapTop > overlapBot
                        float overlapSize = overlapTop - overlapBot
                        float smallerZone = math.min(exSize, newSize)
                        float overlapPct = overlapSize / smallerZone
                        if overlapPct > 0.8
                            result := 2
                            break
                        else if overlapPct > 0.3
                            result := 1
                            mergeIdx := i
                            break
    [result, mergeIdx]


// Merge: expand existing zone to encompass both
merge_fvg(T.SmartZone[] arr, int idx, float newTop, float newBottom, color bgCol) =>
    T.SmartZone existing = array.get(arr, idx)
    float mergedTop = math.max(existing.top, newTop)
    float mergedBot = math.min(existing.bottom, newBottom)
    existing.top := mergedTop
    existing.bottom := mergedBot
    existing.ce := (mergedTop + mergedBot) / 2.0
    box.set_top(existing.boxId, mergedTop)
    box.set_bottom(existing.boxId, mergedBot)
    box.set_border_width(existing.boxId, 2)
    box.set_bgcolor(existing.boxId, color.new(bgCol, 75))



// FVG Visual Rendering — uses zone bounds from the detection engine (fvgTopRaw/fvgBotRaw)
// so that MTF-detected FVGs render at the correct price levels.
// Overlap merge logic is preserved: same-direction nearby FVGs are merged to reduce clutter.
//
// RENDERING COORDINATE POLICY — HISTORICAL ANCHORED ZONES:
//   FVG boxes use xloc.bar_time (time-based x coordinates) so they are immune
//   to bar_index shifts when the chart loads more history or re-executes.
//   Left anchor = event time (time[2], where the gap originates).
//   Right anchor = left + (fvgExtendBars + 2) * timeframe_ms (fixed at creation).
//   No continuous right-extension. Geometry is frozen at creation.
int _tfMs = timeframe.in_seconds(timeframe.period) * 1000
if showFVG
    if bullFVG
        float fvgTop = fvgTopRaw
        float fvgBot = fvgBotRaw
        [overlapResult, mergeIdx] = check_fvg_overlap(fvgArray, fvgTop, fvgBot, true)
        if overlapResult == 0
            float fvgCE = (fvgTop + fvgBot) / 2.0
            int fvgLeftTime = time[2]
            int fvgRightTime = fvgLeftTime + (fvgExtendBars + 2) * _tfMs
            box b = box.new(fvgLeftTime, fvgTop, fvgRightTime, fvgBot, bgcolor = bullFvgColor, border_color = color.new(bullFvgColor, 50), border_style = line.style_dotted, xloc = xloc.bar_time)
            array.push(fvgArray, T.SmartZone.new(b, fvgTop, fvgBot, true, false, false, bar_index - 2, fvgCE, false, false, 0, fvgGapSize, fvgLeftTime, fvgRightTime))
        else if overlapResult == 1
            merge_fvg(fvgArray, mergeIdx, fvgTop, fvgBot, bullFvgColor)

    if bearFVG
        float fvgTop = fvgTopRaw
        float fvgBot = fvgBotRaw
        [overlapResult, mergeIdx] = check_fvg_overlap(fvgArray, fvgTop, fvgBot, false)
        if overlapResult == 0
            float fvgCE = (fvgTop + fvgBot) / 2.0
            int fvgLeftTime = time[2]
            int fvgRightTime = fvgLeftTime + (fvgExtendBars + 2) * _tfMs
            box b = box.new(fvgLeftTime, fvgTop, fvgRightTime, fvgBot, bgcolor = bearFvgColor, border_color = color.new(bearFvgColor, 50), border_style = line.style_dotted, xloc = xloc.bar_time)
            array.push(fvgArray, T.SmartZone.new(b, fvgTop, fvgBot, false, false, false, bar_index - 2, fvgCE, false, false, 0, fvgGapSize, fvgLeftTime, fvgRightTime))
        else if overlapResult == 1
            merge_fvg(fvgArray, mergeIdx, fvgTop, fvgBot, bearFvgColor)



// OB Detection (Last opposite candle before MSS)
// RENDERING COORDINATE POLICY — HISTORICAL ANCHORED ZONES:
//   OB boxes use xloc.bar_time (time-based x coordinates) so they are immune
//   to bar_index shifts. Left = OB candle open time, Right = left + fvgExtendBars * tfMs.
//   Geometry is frozen at creation.
if showOB
    if mssBull
        int obBar = na
        for i = 1 to 20
            if close[i] < open[i]
                obBar := bar_index - i
                break
        if not na(obBar)
            int obLookback = bar_index - obBar
            float t = high[obLookback]
            float b_ = low[obLookback]
            int obLeftTime = time[obLookback]
            int obRightTime = obLeftTime + fvgExtendBars * _tfMs
            box bx = box.new(obLeftTime, t, obRightTime, b_, bgcolor = bullObColor, border_color = color.new(bullObColor, 50), xloc = xloc.bar_time)
            array.push(obArray, T.SmartZone.new(bx, t, b_, true, false, false, obBar, na, false, false, 0, na, obLeftTime, obRightTime))

    if mssBear
        int obBar = na
        for i = 1 to 20
            if close[i] > open[i]
                obBar := bar_index - i
                break
        if not na(obBar)
            int obLookback = bar_index - obBar
            float t = high[obLookback]
            float b_ = low[obLookback]
            int obLeftTime = time[obLookback]
            int obRightTime = obLeftTime + fvgExtendBars * _tfMs
            box bx = box.new(obLeftTime, t, obRightTime, b_, bgcolor = bearObColor, border_color = color.new(bearObColor, 50), xloc = xloc.bar_time)
            array.push(obArray, T.SmartZone.new(bx, t, b_, false, false, false, obBar, na, false, false, 0, na, obLeftTime, obRightTime))

// Mitigation & Inversion Logic (LuxAlgo-inspired: close-based mitigation for FVGs)
// =====================================================================
// RENDERING POLICY — ZONE LIFECYCLE:
//   FVG / OB boxes are HISTORICAL ANCHORED zones using xloc.bar_time.
//   Their geometry is fixed at creation time and never changes
//   (except color/style on inversion). On mitigation, boxes are deleted.
//
//   Time-based anchoring ensures zones do NOT drift when:
//   - The chart loads more historical bars (bar_index shift)
//   - The script re-executes on new bars
//   - The chart is panned or zoomed
//
//   Left anchor: event time (stored in SmartZone.startTime)
//   Right anchor: computed at creation (stored in SmartZone.endTime)
//
//   Live/projected visuals (candidate preview, active trade SL/TP boxes)
//   remain xloc.bar_index and DO update their right edge every bar.
// =====================================================================
update_zones(T.SmartZone[] arr, int maxCount, bool isFVG) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            T.SmartZone sz= array.get(arr, i)
            if not sz.mitigated
                // Historical anchored: right edge is frozen at creation. No set_right here.

                bool justMitigated = false

                if not sz.isInverted
                    if sz.isBull
                        // Track CE touch (price enters the FVG)
                        if isFVG and not na(sz.ce) and low <= sz.ce and not sz.ceRespected
                            sz.ceRespected := true
                            sz.touchCount += 1
                        // Check for inversion: close fully through bottom
                        if isFVG and showIFVG and close < sz.bottom
                            sz.isInverted := true
                            box.set_bgcolor(sz.boxId, bearIfvgColor)
                            box.set_border_style(sz.boxId, line.style_solid)
                        // FVG mitigation: CLOSE below bottom (LuxAlgo style — not just wick touch)
                        // OB mitigation: wick touch (unchanged — OBs are demand/supply zones)
                        else if isFVG and close < sz.bottom
                            justMitigated := true
                        else if not isFVG and low < sz.bottom
                            justMitigated := true
                    else
                        // Track CE touch
                        if isFVG and not na(sz.ce) and high >= sz.ce and not sz.ceRespected
                            sz.ceRespected := true
                            sz.touchCount += 1
                        // Check for inversion: close fully through top
                        if isFVG and showIFVG and close > sz.top
                            sz.isInverted := true
                            box.set_bgcolor(sz.boxId, bullIfvgColor)
                            box.set_border_style(sz.boxId, line.style_solid)
                        // FVG mitigation: CLOSE above top (LuxAlgo style)
                        else if isFVG and close > sz.top
                            justMitigated := true
                        else if not isFVG and high > sz.top
                            justMitigated := true
                else
                    // Mitigation for Inverted Zones (close-based for FVGs, touch for OBs)
                    if sz.isBull // Was originally Bullish, now Bearish IFVG (Resistance)
                        if (isFVG and close > sz.top) or (not isFVG and high > sz.top)
                            justMitigated := true
                    else // Was originally Bearish, now Bullish IFVG (Support)
                        if (isFVG and close < sz.bottom) or (not isFVG and low < sz.bottom)
                            justMitigated := true

                // On mitigation: delete the box entirely (no ghost lines)
                if justMitigated
                    sz.mitigated := true
                    box.delete(sz.boxId)

        if array.size(arr) > maxCount
            T.SmartZone old = array.shift(arr)
            box.delete(old.boxId)

update_zones(fvgArray, maxZones, true)
update_zones(obArray, maxZones, false)

// =====================================================================
// --- LIQUIDITY ENGINE v2 — Hierarchical Detection, Classification & Scoring ---
// =====================================================================

// --- Internal vs External Pivot Classification ---
// External: defines the active dealing range boundary (outermost swings)
// Internal: intermediate pullback pivots within the range
float rangeHigh50 = ta.highest(high, 50)
float rangeLow50  = ta.lowest(low, 50)
float rangeSpan   = rangeHigh50 - rangeLow50
float extThreshold = rangeSpan * 0.15  // Within 15% of range boundary = external

bool pivotHiIsExternal = not na(lastPHi) and (lastPHi > rangeHigh50 - extThreshold)
bool pivotLoIsExternal = not na(lastPLo) and (lastPLo < rangeLow50 + extThreshold)

// Previous pivot (for inducement detection)
bool prevPivotHiIsInternal = not na(prevPHi) and not (prevPHi > rangeHigh50 - extThreshold)
bool prevPivotLoIsInternal = not na(prevPLo) and not (prevPLo < rangeLow50 + extThreshold)

// --- Equal Highs / Equal Lows Detection ---
// Tracks recent swing highs/lows, scores clusters by recency/touches/context,
// and prefers local structure unless an older structural cluster is materially better.
float eqhTolerance = atr * 0.15
int eqPivotStore = math.max(eqLocalLookback, eqStructuralLookback)

var float[] recentSwingHighs = array.new_float()
var float[] recentSwingLows  = array.new_float()
var int[]   recentSwingHighBars = array.new_int()
var int[]   recentSwingLowBars  = array.new_int()

if not na(pHi)
    array.push(recentSwingHighs, pHi)
    array.push(recentSwingHighBars, bar_index - sensRightLen)
    if array.size(recentSwingHighs) > eqPivotStore
        array.shift(recentSwingHighs)
        array.shift(recentSwingHighBars)

if not na(pLo)
    array.push(recentSwingLows, pLo)
    array.push(recentSwingLowBars, bar_index - sensRightLen)
    if array.size(recentSwingLows) > eqPivotStore
        array.shift(recentSwingLows)
        array.shift(recentSwingLowBars)

// liq.level_is_near() moved to tv_liquidity_engine library (liq.*)

cluster_context_bonus(float price_, bool isSSL_) =>
    float bonus = 0.0
    float tol = eqhTolerance * 1.5
    if isSSL_
        if liq.level_is_near(price_, pdl, tol)
            bonus += 5.0
        if liq.level_is_near(price_, pwl, tol)
            bonus += 6.0
        if liq.level_is_near(price_, htfPivot1Low, tol)
            bonus += 3.0
        if liq.level_is_near(price_, htfPivot2Low, tol)
            bonus += 4.0
        if liq.level_is_near(price_, htfPivot3Low, tol)
            bonus += 5.0
        if liq.level_is_near(price_, asia.lastLow, tol) or liq.level_is_near(price_, london.lastLow, tol) or liq.level_is_near(price_, ny.lastLow, tol)
            bonus += 3.0
        if liq.level_is_near(price_, rangeLow50, tol * 2.0)
            bonus += 4.0
    else
        if liq.level_is_near(price_, pdh, tol)
            bonus += 5.0
        if liq.level_is_near(price_, pwh, tol)
            bonus += 6.0
        if liq.level_is_near(price_, htfPivot1High, tol)
            bonus += 3.0
        if liq.level_is_near(price_, htfPivot2High, tol)
            bonus += 4.0
        if liq.level_is_near(price_, htfPivot3High, tol)
            bonus += 5.0
        if liq.level_is_near(price_, asia.lastHigh, tol) or liq.level_is_near(price_, london.lastHigh, tol) or liq.level_is_near(price_, ny.lastHigh, tol)
            bonus += 3.0
        if liq.level_is_near(price_, rangeHigh50, tol * 2.0)
            bonus += 4.0
    bonus

find_eq_cluster(float[] priceArr, int[] barArr, int lookbackN, bool isSSL_) =>
    float bestPrice = na
    int bestCount = 0
    int bestLastBar = na
    float bestScore = 0.0
    int available = array.size(priceArr)
    if available >= 2
        int startIdx = math.max(0, available - lookbackN)
        int localStartIdx = math.max(0, available - eqLocalLookback)
        for i = available - 1 to startIdx
            float refPrice = array.get(priceArr, i)
            int matchCount = 0
            int localTouches = 0
            float sumPrice = 0.0
            int lastTouchBar = na
            for j = startIdx to available - 1
                float cmpPrice = array.get(priceArr, j)
                int cmpBar = array.get(barArr, j)
                if math.abs(cmpPrice - refPrice) <= eqhTolerance
                    matchCount += 1
                    sumPrice += cmpPrice
                    if j >= localStartIdx
                        localTouches += 1
                    lastTouchBar := na(lastTouchBar) ? cmpBar : math.max(lastTouchBar, cmpBar)
            if matchCount >= 2 and not na(lastTouchBar)
                int ageBars = bar_index - lastTouchBar
                if ageBars <= eqClusterMaxAge
                    float avgPrice = sumPrice / matchCount
                    float recencyScore = math.max(0.0, 1.0 - float(ageBars) / eqClusterMaxAge)
                    float distAtr = atr > 0 ? math.abs(avgPrice - close) / atr : 0.0
                    float score = matchCount * 16.0 + localTouches * 5.0 + recencyScore * 20.0 + cluster_context_bonus(avgPrice, isSSL_) - math.min(math.max(distAtr - 6.0, 0.0) * 1.5, 12.0)
                    if score > bestScore or (score == bestScore and (na(bestLastBar) or lastTouchBar > bestLastBar))
                        bestPrice := avgPrice
                        bestCount := matchCount
                        bestLastBar := lastTouchBar
                        bestScore := score
    [bestPrice, bestCount, bestLastBar, bestScore]

select_cluster(float localPrice, int localCount, int localBar, float localScore, float structuralPrice, int structuralCount, int structuralBar, float structuralScore) =>
    float chosenPrice = na
    int chosenCount = 0
    int chosenBar = na
    float chosenScore = 0.0
    if not na(localPrice) or not na(structuralPrice)
        bool useStructural = false
        if na(localPrice)
            useStructural := true
        else if not na(structuralPrice)
            useStructural := structuralScore > localScore + 4.0 or (structuralCount > localCount and structuralScore >= localScore)
        chosenPrice := useStructural ? structuralPrice : localPrice
        chosenCount := useStructural ? structuralCount : localCount
        chosenBar := useStructural ? structuralBar : localBar
        chosenScore := useStructural ? structuralScore : localScore
    [chosenPrice, chosenCount, chosenBar, chosenScore]

cluster_priority_from_score(int clusterCount_, int lastTouchBar_, float clusterScore_) =>
    int pri = PRI_EQH_EQL
    if clusterCount_ >= 3
        pri += 4
    if clusterCount_ >= 4
        pri += 4
    if clusterScore_ >= 60
        pri += 4
    if clusterScore_ >= 75
        pri += 4
    if not na(lastTouchBar_)
        int ageBars = bar_index - lastTouchBar_
        if ageBars > math.round(eqClusterMaxAge * 0.6)
            pri -= 12
        else if ageBars > math.round(eqClusterMaxAge * 0.35)
            pri -= 6
    math.max(42, math.min(84, pri))

[eqhLocalLevel, eqhLocalCount, eqhLocalBar, eqhLocalScore] = find_eq_cluster(recentSwingHighs, recentSwingHighBars, eqLocalLookback, false)

[eqhStructLevel, eqhStructCount, eqhStructBar, eqhStructScore] = find_eq_cluster(recentSwingHighs, recentSwingHighBars, eqStructuralLookback, false)

[eqhLevel, eqhCount, eqhLastBar, eqhScore] = select_cluster(eqhLocalLevel, eqhLocalCount, eqhLocalBar, eqhLocalScore, eqhStructLevel, eqhStructCount, eqhStructBar, eqhStructScore)
int eqhPriority = not na(eqhLevel) ? cluster_priority_from_score(eqhCount, eqhLastBar, eqhScore) : PRI_EQH_EQL

[eqlLocalLevel, eqlLocalCount, eqlLocalBar, eqlLocalScore] = find_eq_cluster(recentSwingLows, recentSwingLowBars, eqLocalLookback, true)

[eqlStructLevel, eqlStructCount, eqlStructBar, eqlStructScore] = find_eq_cluster(recentSwingLows, recentSwingLowBars, eqStructuralLookback, true)

[eqlLevel, eqlCount, eqlLastBar, eqlScore] = select_cluster(eqlLocalLevel, eqlLocalCount, eqlLocalBar, eqlLocalScore, eqlStructLevel, eqlStructCount, eqlStructBar, eqlStructScore)
int eqlPriority = not na(eqlLevel) ? cluster_priority_from_score(eqlCount, eqlLastBar, eqlScore) : PRI_EQH_EQL

// --- Build Liquidity Level Registry ---
// Constructs LiqLevel objects for all monitored sources each bar
var T.LiqLevel[] liqLevels = array.new<T.LiqLevel>()
array.clear(liqLevels)

// Liquidity source helpers moved to tv_liquidity_engine library (liq.*)

round_grid_base(float price_, float step_) =>
    step_ > 0 ? math.floor(price_ / step_) * step_ : na

float roundMainBase = enableRoundNumbers and roundStep > 0 ? round_grid_base(close, roundStep) : na
float roundMainBelow = roundMainBase
float roundMainAbove = not na(roundMainBase) ? roundMainBase + roundStep : na
bool hasRoundSubStep = enableRoundNumbers and roundSubStep > 0 and roundSubStep < roundStep
float roundSubBase = hasRoundSubStep ? round_grid_base(close, roundSubStep) : na
float roundSubBelow = roundSubBase
float roundSubAbove = not na(roundSubBase) ? roundSubBase + roundSubStep : na

// Helper: add level if valid
add_liq_level(T.LiqLevel[] arr, string name_, float price_, int srcType, int pri, bool ext, bool ssl, bool htf, bool sess, bool cluster, int clusterN) =>
    if not na(price_)
        array.push(arr, T.LiqLevel.new(name_, price_, srcType, pri, ext, ssl, htf, sess, cluster, clusterN, bar_index))


// --- Build Liquidity Level Registry (extracted to function) ---
build_liquidity_registry(T.LiqLevel[] arr) =>
    // Session levels (only completed sessions — no developing)
    add_liq_level(arr, "Asia High",   asia.isActive ? na : asia.lastHigh,     SRC_SESSION, PRI_SESSION, true, false, false, true, false, 0)
    add_liq_level(arr, "Asia Low",    asia.isActive ? na : asia.lastLow,      SRC_SESSION, PRI_SESSION, true, true,  false, true, false, 0)
    add_liq_level(arr, "London High", london.isActive ? na : london.lastHigh, SRC_SESSION, PRI_SESSION + 5, true, false, false, true, false, 0)
    add_liq_level(arr, "London Low",  london.isActive ? na : london.lastLow,  SRC_SESSION, PRI_SESSION + 5, true, true,  false, true, false, 0)
    add_liq_level(arr, "NY High",     ny.isActive ? na : ny.lastHigh,         SRC_SESSION, PRI_SESSION + 10, true, false, false, true, false, 0)
    add_liq_level(arr, "NY Low",      ny.isActive ? na : ny.lastLow,          SRC_SESSION, PRI_SESSION + 10, true, true,  false, true, false, 0)

    // HTF levels
    add_liq_level(arr, "PDH", pdh, SRC_PDH_PDL, PRI_PDH_PDL, true, false, true, false, false, 0)
    add_liq_level(arr, "PDL", pdl, SRC_PDH_PDL, PRI_PDH_PDL, true, true,  true, false, false, 0)
    add_liq_level(arr, "PWH", pwh, SRC_PWH_PWL, PRI_PWH_PWL, true, false, true, false, false, 0)
    add_liq_level(arr, "PWL", pwl, SRC_PWH_PWL, PRI_PWH_PWL, true, true,  true, false, false, 0)
    add_liq_level(arr, "HTF " + liqPivotTf1 + " High", htfPivot1High, SRC_PIVOT_HTF_1, PRI_PIVOT_HTF_1, true, false, true, false, false, 0)
    add_liq_level(arr, "HTF " + liqPivotTf1 + " Low", htfPivot1Low, SRC_PIVOT_HTF_1, PRI_PIVOT_HTF_1, true, true,  true, false, false, 0)
    add_liq_level(arr, "HTF " + liqPivotTf2 + " High", htfPivot2High, SRC_PIVOT_HTF_2, PRI_PIVOT_HTF_2, true, false, true, false, false, 0)
    add_liq_level(arr, "HTF " + liqPivotTf2 + " Low", htfPivot2Low, SRC_PIVOT_HTF_2, PRI_PIVOT_HTF_2, true, true,  true, false, false, 0)
    add_liq_level(arr, "HTF " + liqPivotTf3 + " High", enableHtfPivot3 ? htfPivot3High : na, SRC_PIVOT_HTF_3, PRI_PIVOT_HTF_3, true, false, true, false, false, 0)
    add_liq_level(arr, "HTF " + liqPivotTf3 + " Low", enableHtfPivot3 ? htfPivot3Low : na, SRC_PIVOT_HTF_3, PRI_PIVOT_HTF_3, true, true,  true, false, false, 0)

    // Structural pivots (classified by internal/external)
    add_liq_level(arr, "Pivot High", lastPHi, pivotHiIsExternal ? SRC_PIVOT_EXT : SRC_PIVOT_INT, pivotHiIsExternal ? PRI_PIVOT_EXT : PRI_PIVOT_INT, pivotHiIsExternal, false, false, false, false, 0)
    add_liq_level(arr, "Pivot Low",  lastPLo, pivotLoIsExternal ? SRC_PIVOT_EXT : SRC_PIVOT_INT, pivotLoIsExternal ? PRI_PIVOT_EXT : PRI_PIVOT_INT, pivotLoIsExternal, true,  false, false, false, 0)

    // Equal highs/lows clusters
    add_liq_level(arr, "EQH", eqhLevel, SRC_EQH_EQL, eqhPriority, true, false, false, false, true, eqhCount)
    add_liq_level(arr, "EQL", eqlLevel, SRC_EQH_EQL, eqlPriority, true, true,  false, false, true, eqlCount)

    // Optional psychological levels
    add_liq_level(arr, "RN " + str.tostring(roundMainAbove, "#.#####"), enableRoundNumbers ? roundMainAbove : na, SRC_ROUND_NUM, PRI_ROUND_NUM, false, false, false, false, false, 0)
    add_liq_level(arr, "RN " + str.tostring(roundMainBelow, "#.#####"), enableRoundNumbers ? roundMainBelow : na, SRC_ROUND_NUM, PRI_ROUND_NUM, false, true,  false, false, false, 0)
    add_liq_level(arr, "RN sub " + str.tostring(roundSubAbove, "#.#####"), hasRoundSubStep ? roundSubAbove : na, SRC_ROUND_NUM, PRI_ROUND_NUM - 5, false, false, false, false, false, 0)
    add_liq_level(arr, "RN sub " + str.tostring(roundSubBelow, "#.#####"), hasRoundSubStep ? roundSubBelow : na, SRC_ROUND_NUM, PRI_ROUND_NUM - 5, false, true,  false, false, false, 0)

build_liquidity_registry(liqLevels)

// --- Session Timing Weight ---
// Returns multiplier for sweep significance based on when it happens
get_session_weight() =>
    float w = 1.0
    if overlap.isActive
        w := 1.3
    else if ny.isActive
        w := 1.2
    else if london.isActive
        w := 1.15
    else if asia.isActive
        w := 0.85
    else
        w := 0.7   // Inter-session dead time
    w

float sessionWeight = get_session_weight()

// --- Sweep Detection Engine v2 ---
var T.LiqSweep[] activeSweeps = array.new<T.LiqSweep>()
int sweepMaxAge = sensitivityMode == "Aggressive" ? 30 : sensitivityMode == "Conservative" ? 70 : 50
int sweepMaxCount = 8

// Sweep classification, scoring, and summary functions moved to tv_liquidity_engine library (liq.*)

// Check sweep against a LiqLevel
check_sweep_level(T.LiqLevel lvl) =>
    T.LiqSweep result = na
    if not na(lvl) and not na(lvl.price)
        bool isSSL_ = lvl.isSSL
        float level = lvl.price
        bool swept = false
        float depth = 0.0

        if isSSL_ and level < close[1] and low <= level and close > level
            depth := level - low
            swept := true
        else if not isSSL_ and level > close[1] and high >= level and close < level
            depth := high - level
            swept := true

        if swept and depth > 0
            float depthAtr = depth / atr
            float rng = high - low
            float wickPen = rng > 0 ? depth / rng : 0.0
            // Rejection: body reclaim ratio — how much of the range is body closing back
            float bodyRatio = rng > 0 ? bodySize / rng : 0.0
            bool rejection = isSSL_ ? close > open : close < open
            float rejStr = rejection ? bodyRatio : 0.0
            bool disp = isSSL_ ? isDispBull : isDispBear

            [sType, sStr] = liq.classify_sweep_type(depthAtr, lvl.isExternal, lvl.isHTF, lvl.isSession, lvl.isCluster, lvl.sourceType)
            float freshness = 1.0
            float q = liq.compute_sweep_quality(depthAtr, wickPen, rejStr, rejection, disp, lvl.priority, lvl.isExternal, lvl.isHTF, lvl.isCluster, lvl.clusterCount, isKillzone, isSilverBullet, sessionWeight, freshness, sType)
            string grade = liq.get_sweep_grade(q)

            result := T.LiqSweep.new(
                 lvl.name, level, lvl.sourceType, lvl.priority,
                 lvl.isExternal, isSSL_,
                 depth, depthAtr, wickPen, rejStr, rejection, disp,
                 sType, sStr, grade, q,
                 bar_index, LIFE_DETECTED, grade != "Reject", false,
                 lvl.isHTF, lvl.isSession, lvl.isCluster, lvl.clusterCount, false,
                 isKillzone, isSilverBullet, activeSessName)
    result

// --- Run sweep checks against all registered levels ---

// --- Sweep Detection + Lifecycle Engine (extracted to function) ---
update_sweep_engine(T.LiqSweep[] sweeps, T.LiqLevel[] levels, int maxAge, int maxCount_) =>
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            T.LiqLevel lvl = array.get(levels, i)
            T.LiqSweep sw = check_sweep_level(lvl)
            if not na(sw) and sw.isActionable
                // --- Advanced Deduplication ---
                // Check for near-duplicate: same side, similar price, recent
                bool duplicate = false
                int replaceIdx = -1
                if array.size(sweeps) > 0
                    for j = array.size(sweeps) - 1 to math.max(0, array.size(sweeps) - 8)
                        T.LiqSweep existing = array.get(sweeps, j)
                        bool sameSide = existing.isSSL == sw.isSSL
                        bool sameName = existing.levelName == sw.levelName
                        bool nearPrice = math.abs(existing.levelPrice - sw.levelPrice) < atr * 0.3
                        bool recentBar = (bar_index - existing.sweepBar) < 5
                        if sameSide and (sameName or nearPrice) and recentBar
                            duplicate := true
                            // Replace if new sweep is stronger
                            if sw.qualityScore > existing.qualityScore
                                replaceIdx := j
                            break
                if not duplicate
                    // Lifecycle: promote to ACTIVE if rejection or displacement present
                    if sw.hasRejection or sw.hasDisplacement
                        sw.lifecycleState := LIFE_CONFIRMED
                    else
                        sw.lifecycleState := LIFE_ACTIVE
                    array.push(sweeps, sw)
                else if replaceIdx >= 0
                    // Stronger sweep replaces weaker on same level
                    T.LiqSweep old = array.get(sweeps, replaceIdx)
                    sw.lifecycleState := old.lifecycleState == LIFE_CONFIRMED ? LIFE_CONFIRMED : (sw.hasRejection or sw.hasDisplacement ? LIFE_CONFIRMED : LIFE_ACTIVE)
                    array.set(sweeps, replaceIdx, sw)

    // --- Inducement Detection (deterministic only) ---
    // Tag a smaller internal sweep only after a larger same-side external/HTF/session event
    // is actually taken shortly after it. This keeps inducement as metadata, not prophecy.
    if enableInducementTag and array.size(sweeps) > 1
        int inducementWindow = sensitivityMode == "Aggressive" ? 6 : sensitivityMode == "Conservative" ? 10 : 8
        for i = 0 to array.size(sweeps) - 1
            T.LiqSweep major = array.get(sweeps, i)
            bool majorSweep = (major.isExternal or liq.is_htf_liquidity_source(major.sourceType) or major.sourceType == SRC_SESSION) and major.qualityScore >= 40
            if majorSweep
                for j = 0 to array.size(sweeps) - 1
                    if i != j
                        T.LiqSweep minor = array.get(sweeps, j)
                        bool sameSide = minor.isSSL == major.isSSL
                        bool minorInternal = minor.sourceType == SRC_PIVOT_INT or (not minor.isExternal and minor.sourcePriority < major.sourcePriority)
                        bool shortLead = minor.sweepBar <= major.sweepBar and (major.sweepBar - minor.sweepBar) <= inducementWindow
                        bool lowerSig = minor.qualityScore < major.qualityScore and minor.sourcePriority < major.sourcePriority
                        if sameSide and minorInternal and shortLead and lowerSig and not minor.isInducementLike
                            minor.isInducementLike := true
                            minor.sweepType := SWEEP_INDUCEMENT
                            minor.sweepTypeStr := "Inducement"
                            minor.qualityScore := math.max(0.0, minor.qualityScore - 8.0)
                            minor.grade := liq.get_sweep_grade(minor.qualityScore)
                            array.set(sweeps, j, minor)

    // --- Lifecycle Management ---
    // Expire stale sweeps, cap count, manage states
    if array.size(sweeps) > 0
        for i = array.size(sweeps) - 1 to 0
            T.LiqSweep s= array.get(sweeps, i)
            int age = bar_index - s.sweepBar
            // Stale detection
            if age > maxAge
                array.remove(sweeps, i)
                continue
            // Degrade lifecycle as sweep ages
            if age > math.round(maxAge * 0.7) and s.lifecycleState == LIFE_ACTIVE
                s.lifecycleState := LIFE_STALE
                s.isActionable := false
            // Recalculate quality with updated freshness
            float freshness = 1.0 - (float(age) / maxAge)
            float updatedQ = liq.compute_sweep_quality(s.sweepDepthAtr, s.wickPenetrationRatio, s.rejectionStrength, s.hasRejection, s.hasDisplacement, s.sourcePriority, s.isExternal, s.isHTF, s.isClusterSweep, s.clusterCount, s.inKillzone, s.inSilverBullet, 1.0, freshness, s.sweepType)
            s.qualityScore := updatedQ
            s.grade := liq.get_sweep_grade(updatedQ)
            if updatedQ < 15.0
                s.isActionable := false
            array.set(sweeps, i, s)

    // Cap sweep count — keep best by quality
    while array.size(sweeps) > maxCount_
        // Find and remove lowest quality
        int worstIdx = 0
        float worstQ = 999.0
        for i = 0 to array.size(sweeps) - 1
            T.LiqSweep s= array.get(sweeps, i)
            if s.qualityScore < worstQ
                worstQ := s.qualityScore
                worstIdx := i
        array.remove(sweeps, worstIdx)

    // --- Consume sweeps on MSS (lifecycle transition) ---
    if mssBull
        if array.size(sweeps) > 0
            for i = array.size(sweeps) - 1 to 0
                T.LiqSweep s= array.get(sweeps, i)
                if s.isSSL and s.lifecycleState != LIFE_CONSUMED
                    s.lifecycleState := LIFE_CONSUMED
                    s.isConsumed := true
                    array.set(sweeps, i, s)
    if mssBear
        if array.size(sweeps) > 0
            for i = array.size(sweeps) - 1 to 0
                T.LiqSweep s= array.get(sweeps, i)
                if not s.isSSL and s.lifecycleState != LIFE_CONSUMED
                    s.lifecycleState := LIFE_CONSUMED
                    s.isConsumed := true
                    array.set(sweeps, i, s)

update_sweep_engine(activeSweeps, liqLevels, sweepMaxAge, sweepMaxCount)

[sweptSSL, sweptBSL, sweepQualitySSL, sweepQualityBSL, bestSweepBarSSL, bestSweepBarBSL,
 bestSweepTypeSSL, bestSweepGradeSSL, bestSweepNameSSL, bestSweepExtSSL, bestSweepSrcSSL, bestSweepInducementSSL,
 bestSweepTypeBSL, bestSweepGradeBSL, bestSweepNameBSL, bestSweepExtBSL, bestSweepSrcBSL, bestSweepInducementBSL,
 bestSweepLevelSSL, bestSweepLevelBSL, bestSweepDepthSSL, bestSweepDepthBSL] = liq.summarize_active_sweeps(activeSweeps)
// Premium / Discount
int rangeLookback = 50
float pdArray = (ta.highest(rangeLookback) + ta.lowest(rangeLookback)) / 2
string pdStatus = close > pdArray ? "Premium" : "Discount"


[nearestBSL, nearestSSL, nearestExtBSL, nearestExtSSL, nearestIntBSL, nearestIntSSL,
 nearestSessBSL, nearestSessSSL, nearestHTFBSL, nearestHTFSSL,
 nearestClusterBSL, nearestClusterSSL, nearestRoundBSL, nearestRoundSSL,
 nearestBSLName, nearestSSLName] = liq.summarize_liquidity_map(liqLevels)
// reqL/reqS: backward-compatible required sweep levels
float reqL = nearestSSL
float reqS = nearestBSL

// ICT and Silver Bullet liquidity gates moved to tv_signal_gate_engine library (sg.*)

// --- OB Confluence Check: is price near an unmitigated OB? ---
bool obBullConfluence = false
bool obBearConfluence = false
if array.size(obArray) > 0
    for i = 0 to array.size(obArray) - 1
        T.SmartZone ob= array.get(obArray, i)
        if not ob.mitigated
            if ob.isBull and low <= ob.top and close >= ob.bottom
                obBullConfluence := true
            if not ob.isBull and high >= ob.bottom and close <= ob.top
                obBearConfluence := true

// --- Setup Readiness Evaluation ---
// =====================================================================
// --- SETUP LIFECYCLE HELPERS (Chapter 1: State Machine Integrity) ---
// =====================================================================

// Lifecycle helpers and mode policy functions moved to tv_lifecycle_mode library (lm.*)

// =====================================================================
// --- CHAPTER 2.2: QUALITY RECOVERY PATCH — Transitional Quality Helpers ---
// =====================================================================

// se.evaluate_reclaim_stage() and se.reclaim_mode_pass() moved to tv_structure_engine library (se.*)

// MSS evaluation functions moved to tv_structure_engine library (se.*)

// Displacement evaluation functions moved to tv_structure_engine library (se.*)

// Pending trade evaluation functions moved to tv_pending_trade_state library (pts.*)

// Pending activation window helpers moved to tv_lifecycle_mode library (lm.*)


// Determine lifecycle stage from raw setup data + eval_side outputs
// Chapter 3: reclaim-aware | Chapter 4: MSS-truth-aware | Chapter 5: displacement-truth-aware
determine_lifecycle(bool swept, int sweepBar_, int mssBar_, float mssDisp, int fvgBar_, int fvgGrade_, bool fvgMitigated, bool seqOk, bool expired, bool degraded, float reqLevel, float pivotVal, bool isLong, float atrVal, bool reclaimDetected_, bool reclaimValid_, bool reclaimFailed_, bool mssValid_, bool mssStrong_, bool mssFailed_, bool dispValid_, bool dispStrong_, bool dispFailed_) =>
    int lc = LC_NONE
    string reason = ""
    if expired
        lc := LC_EXPIRED
        reason := "Structure shift expired without progression"
    else if degraded
        lc := LC_INVALIDATED
        reason := "Imbalance zone was filled"
    else if seqOk and mssValid_
        // Chapter 4+5: full sequence requires validated MSS
        lc := LC_ENTRY_ARMED
        reason := "Full sequence: sweep → MSS → FVG (MSS validated)"
    else if seqOk and not mssValid_ and not mssFailed_
        // Chapter 5: sequence complete but MSS not validated — use displacement truth
        lc := dispValid_ and not dispFailed_ ? LC_DISPLACEMENT_CONFIRMED : LC_MSS_CONFIRMED
        reason := "Sequence present but MSS not fully validated"
    else if swept and not na(mssBar_) and not na(sweepBar_) and mssBar_ >= sweepBar_
        if mssValid_ and dispStrong_ and not dispFailed_
            // Chapter 5: strong displacement with validated MSS
            lc := LC_DISPLACEMENT_CONFIRMED
            reason := "Strong displacement — MSS validated"
        else if mssValid_ and dispValid_ and not dispFailed_
            // Chapter 5: valid displacement with validated MSS
            lc := LC_DISPLACEMENT_CONFIRMED
            reason := "Valid displacement — MSS validated"
        else if mssValid_ and not dispValid_ and not dispFailed_
            // Chapter 5: MSS valid but displacement not yet confirmed
            lc := LC_MSS_CONFIRMED
            reason := "Structure shift confirmed — awaiting displacement"
        else if mssValid_
            lc := LC_MSS_CONFIRMED
            reason := "Structure shift confirmed — MSS validated"
        else if mssFailed_
            // Chapter 4: MSS failed — don't promote past sweep
            lc := LC_SWEEP_CONFIRMED
            reason := "MSS failed — awaiting fresh structure shift"
        else
            // Chapter 4: MSS detected but not validated (weak/trivial)
            lc := reclaimDetected_ and not reclaimFailed_ ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
            reason := "MSS detected but not validated — awaiting better structure"
    else if swept and reclaimDetected_ and not reclaimFailed_
        lc := LC_RECLAIM_VISIBLE
        reason := reclaimValid_ ? "Valid reclaim visible — watch for structure shift" : "Early reclaim visible — awaiting confirmation"
    else if swept
        lc := LC_SWEEP_CONFIRMED
        reason := reclaimFailed_ ? "Liquidity swept — reclaim failed, awaiting fresh structure" : "Liquidity swept — awaiting structure shift"
    else if not na(reqLevel) and not na(atrVal) and atrVal > 0
        float proximity = math.abs(close - reqLevel) / atrVal
        if proximity < 3.0
            lc := LC_LIQUIDITY_IDENTIFIED
            reason := (isLong ? "SSL" : "BSL") + " at " + str.tostring(reqLevel, "#.#####") + " (" + str.tostring(proximity, "#.#") + " ATR)"
        else
            reason := "Searching for liquidity"
    else
        reason := "No setup context"
    string lcName = lm.lifecycle_name(lc)
    string nextReq = lm.lifecycle_next_required(lc, isLong, pivotVal, reqLevel)
    bool canActivate = lm.lifecycle_allows_activation(lc)
    [lc, lcName, nextReq, canActivate, reason]

SetupState liveSetup = new_setup_state()

// Evaluate one side (long or short) with quality-weighted, sequence-aware scoring
// Enhanced: uses enriched sweep metadata (source type, external/internal, sweep type)
// Returns [score, phase, missing, sweepGrade, mssGrade, fvgGrade, sequenceOk, triggerLvl, expired, degraded]
eval_side(bool isLong, string bias, string pd, bool kz, bool sb, bool swept, float sweepQ, int sweepBar_, string sweepGradeIn, bool sweepIsExt, int sweepSrcType, int mssBar_, float mssDisp, int fvgBar_, int fvgGrade_, bool fvgMitigated, bool obConf, float pivotVal, float reqLevel, float atrVal, string sessName, int sweepMaxAge_, int mssMaxAge_, int fvgMaxAge_) =>
    float sc = 0.0
    string ph = "Scanning"
    string ms = ""
    string swG = ""
    string msG = ""
    string fgG = ""
    bool seqOk = false
    float trig = na
    bool expired = false
    bool degraded = false

    // --- Context Score (max 18) ---
    string alignedPD = isLong ? "Discount" : "Premium"
    bool biasAligned = (isLong and bias == "Bullish") or (not isLong and bias == "Bearish")
    bool biasCounter = (isLong and bias == "Bearish") or (not isLong and bias == "Bullish")

    if biasAligned
        sc += 5.0
    else if biasCounter
        sc -= 3.0

    if pd == alignedPD
        sc += 5.0
    else if pd != alignedPD and pd != ""
        sc -= 2.0

    // Timing — Silver Bullet > Killzone > No session (max 5)
    if sb
        sc += 5.0
    else if kz
        sc += 3.0

    bool isLondon = str.contains(sessName, "London") and not str.contains(sessName, "Overlap")
    bool isNY = str.contains(sessName, "New York") or str.contains(sessName, "Overlap")

    // --- Sweep Score (max 30) — enriched with source/type awareness ---
    if swept
        // Base sweep score from quality (0-100 → 10-25)
        float sweepScore = 10.0 + math.min(sweepQ, 100.0) * 0.15
        sc += sweepScore
        swG := sweepGradeIn

        // Liquidity source bonuses (v2 enrichment)
        // External liquidity sweep: +3 for reversal setups
        if sweepIsExt
            sc += 3.0
        // HTF level sweep: +2
        if sweepSrcType == SRC_PWH_PWL or sweepSrcType == SRC_PDH_PDL
            sc += 2.0
        // Cluster (EQH/EQL) sweep: +2
        if sweepSrcType == SRC_EQH_EQL
            sc += 2.0
        // Internal-only sweep penalty for reversal context (needs external for conviction)
        if not sweepIsExt and sweepSrcType == SRC_PIVOT_INT
            sc -= 3.0

        string srcLabel = liq.source_phase_tag(sweepSrcType, sweepIsExt)
        ph := "Liquidity swept"

        // Sweep staleness penalty
        if not na(sweepBar_)
            float sweepAge = bar_index - sweepBar_
            float sweepLifeRatio = sweepAge / sweepMaxAge_
            if sweepLifeRatio > 0.7
                sc -= 5.0
                ph := ph + " ⌛"

        // --- MSS Score (max 25) — quality + sequence ---
        if not na(mssBar_)
            bool mssAfterSweep = not na(sweepBar_) and mssBar_ >= sweepBar_
            if mssAfterSweep
                float mssScore = 10.0
                if mssDisp > 1.5
                    mssScore := 25.0
                    msG := "A"
                else if mssDisp > 0.8
                    mssScore := 18.0
                    msG := "B"
                else
                    mssScore := 12.0
                    msG := "C"
                sc += mssScore
                ph := "Structure confirmed"

                float mssAge = bar_index - mssBar_
                float mssLifeRatio = mssAge / mssMaxAge_
                if mssLifeRatio > 0.6
                    sc -= 4.0
                    ph := ph + " ⌛"

                if mssLifeRatio > 0.85 and (na(fvgBar_) or fvgGrade_ == 0)
                    expired := true
                    ph := "Setup expired"
                    ms := "Structure shift expired without imbalance — setup invalid"

                // --- FVG Score (max 25) — grade + sequence ---
                if not expired and not na(fvgBar_) and fvgGrade_ > 0
                    bool fvgAfterMss = fvgBar_ >= mssBar_
                    if fvgAfterMss
                        if fvgMitigated
                            degraded := true
                            sc -= 10.0
                            ph := "Setup degraded"
                            ms := "Imbalance zone was filled — wait for a fresh one"
                        else
                            seqOk := true
                            float fvgScore = fvgGrade_ == 3 ? 25.0 : fvgGrade_ == 2 ? 18.0 : 12.0
                            fgG := fvgGrade_ == 3 ? "A" : fvgGrade_ == 2 ? "B" : "C"
                            sc += fvgScore
                            ph := "Setup ready"
                            ms := "Full sequence complete — monitor entry zone"

                            float fvgAge = bar_index - fvgBar_
                            if fvgAge / fvgMaxAge_ > 0.7
                                ms := ms + " (imbalance aging)"
                    else
                        ph := "Awaiting imbalance"
                        ms := "Imbalance predates structure shift — need a fresh one"
                else if not expired
                    ph := "Awaiting imbalance"
                    ms := "Need fresh " + (isLong ? "bullish" : "bearish") + " imbalance after structure shift"
            else
                ph := "Awaiting structure shift"
                ms := "Structure shift predates sweep — need new " + (isLong ? "bullish" : "bearish") + " confirmation"
                trig := pivotVal
        else
            ph := "Awaiting structure shift"
            trig := pivotVal
            ms := "Need " + (isLong ? "bullish" : "bearish") + " structure shift" + (na(pivotVal) ? "" : " — break " + (isLong ? "above " : "below ") + str.tostring(pivotVal, "#.#####"))
    else
        // No sweep yet — ATR-based proximity check
        if not na(reqLevel) and not na(atrVal)
            float proximity = math.abs(close - reqLevel) / atrVal
            if proximity < 0.5
                ph := "Liquidity imminent"
                sc += 3.0
                ms := (isLong ? "Sell-side" : "Buy-side") + " liquidity at " + str.tostring(reqLevel, "#.#####") + " — very close (" + str.tostring(proximity, "#.#") + " ATR)"
            else if proximity < 1.5
                ph := "Liquidity nearby"
                sc += 1.0
                ms := (isLong ? "Sell-side" : "Buy-side") + " liquidity at " + str.tostring(reqLevel, "#.#####") + " (" + str.tostring(proximity, "#.#") + " ATR away)"
            else if proximity < 3.0
                ph := "Approaching liquidity"
                ms := (isLong ? "Sell-side" : "Buy-side") + " liquidity at " + str.tostring(reqLevel, "#.#####") + " (" + str.tostring(proximity, "#.#") + " ATR away)"
            else
                ms := "Searching for " + (isLong ? "sell-side" : "buy-side") + " liquidity to sweep"
        else
            ms := "No liquidity levels identified"

    // --- Confluence Bonus (max 18) ---
    if obConf and seqOk
        sc += 5.0
        ms := ms + " (order block confluence)"

    // Full sequence + quality bonus
    if seqOk and sweepQ >= 40 and not na(mssDisp) and mssDisp > 0.8 and fvgGrade_ >= 2
        sc += 5.0

    // External + HTF sweep with valid sequence: premium confluence
    if seqOk and sweepIsExt and (sweepSrcType == SRC_PWH_PWL or sweepSrcType == SRC_PDH_PDL)
        sc += 3.0

    // Session alignment (max 3)
    if isLondon and swept
        sc += 2.0
    else if isNY and seqOk
        sc += 3.0
    else if isLondon or isNY
        sc += 1.0

    // Clamp score to 0-100
    int finalScore = math.max(0, math.min(100, math.round(sc)))
    [finalScore, ph, ms, swG, msG, fgG, seqOk, trig, expired, degraded]

// --- Run dual-side evaluation ---
[scoreLong, phaseLong, missingLong, swGradeL, msGradeL, fgGradeL, seqOkL, trigL, expiredL, degradedL] = eval_side(true, marketBias, pdStatus, isKillzone, isSilverBullet, sweptSSL, sweepQualitySSL, bestSweepBarSSL, bestSweepGradeSSL, bestSweepExtSSL, bestSweepSrcSSL, lastMssBullBar, lastMssBullDispStrength, lastBullFvgBar, lastBullFvgGrade, lastBullFvgMitigated, obBullConfluence, lastPHi, reqL, atr, activeSessName, sweepMaxAge, mssMaxAge, fvgMaxAge)
[scoreShort, phaseShort, missingShort, swGradeS, msGradeS, fgGradeS, seqOkS, trigS, expiredS, degradedS] = eval_side(false, marketBias, pdStatus, isKillzone, isSilverBullet, sweptBSL, sweepQualityBSL, bestSweepBarBSL, bestSweepGradeBSL, bestSweepExtBSL, bestSweepSrcBSL, lastMssBearBar, lastMssBearDispStrength, lastBearFvgBar, lastBearFvgGrade, lastBearFvgMitigated, obBearConfluence, lastPLo, reqS, atr, activeSessName, sweepMaxAge, mssMaxAge, fvgMaxAge)

// --- Chapter 3: Reclaim Stage Evaluation (runs each bar) ---
[rclDetL, rclWeakL2, rclValidL2, rclStrongL2, rclFailedL2, rclScoreL2, rclReasonL2, rclAcceptL2, rclThreshL2] = se.evaluate_reclaim_stage(true, bestSweepBarSSL, bestSweepLevelSSL, bestSweepDepthSSL, atr, _rclAcceptL, _rclFailedL, _rclSweepRefL)
[rclDetS, rclWeakS2, rclValidS2, rclStrongS2, rclFailedS2, rclScoreS2, rclReasonS2, rclAcceptS2, rclThreshS2] = se.evaluate_reclaim_stage(false, bestSweepBarBSL, bestSweepLevelBSL, bestSweepDepthBSL, atr, _rclAcceptS, _rclFailedS, _rclSweepRefS)

// Update persistent reclaim state
// Reset detection bar on new sweep (must check BEFORE updating sweep ref)
if not na(bestSweepBarSSL) and bestSweepBarSSL != _rclSweepRefL
    _rclDetBarL := na
if not na(bestSweepBarBSL) and bestSweepBarBSL != _rclSweepRefS
    _rclDetBarS := na
_rclAcceptL := rclAcceptL2
_rclAcceptS := rclAcceptS2
_rclFailedL := rclFailedL2
_rclFailedS := rclFailedS2
_rclThreshL := rclThreshL2
_rclThreshS := rclThreshS2
_rclSweepRefL := not na(bestSweepBarSSL) ? bestSweepBarSSL : _rclSweepRefL
_rclSweepRefS := not na(bestSweepBarBSL) ? bestSweepBarBSL : _rclSweepRefS
if rclDetL and na(_rclDetBarL)
    _rclDetBarL := bar_index
if rclDetS and na(_rclDetBarS)
    _rclDetBarS := bar_index

// --- Chapter 4: MSS Stage Evaluation (runs each bar, like reclaim) ---
[mssDetL, mssWeakL2, mssValidL2, mssStrongL2, mssFreshL2, mssFailedL2, mssScoreL2, mssReasonL2, mssFailReasonL2, mssBreakLvlL2, mssBodyConfL2, mssTrigTypeL2, mssTrigSigL2, mssFollowBarsL2, mssBreakQScoreL2] = se.evaluate_mss_stage(true, bestSweepBarSSL, rclDetL, rclValidL2, lastMssBullBar, lastMssBullDispStrength, lastPHi, lastPHiBar, pivotHiIsExternal, bestSweepLevelSSL, atr, rangeSpan, rangeHigh50, rangeLow50, sensitivityMode, _mssRefBarL, _mssScorePersistL, _mssFailedPersistL, _mssFollowBarsL, _mssBodyConfL, _mssBreakQScoreL)

[mssDetS, mssWeakS2, mssValidS2, mssStrongS2, mssFreshS2, mssFailedS2, mssScoreS2, mssReasonS2, mssFailReasonS2, mssBreakLvlS2, mssBodyConfS2, mssTrigTypeS2, mssTrigSigS2, mssFollowBarsS2, mssBreakQScoreS2] = se.evaluate_mss_stage(false, bestSweepBarBSL, rclDetS, rclValidS2, lastMssBearBar, lastMssBearDispStrength, lastPLo, lastPLoBar, pivotLoIsExternal, bestSweepLevelBSL, atr, rangeSpan, rangeHigh50, rangeLow50, sensitivityMode, _mssRefBarS, _mssScorePersistS, _mssFailedPersistS, _mssFollowBarsS, _mssBodyConfS, _mssBreakQScoreS)

// Update persistent MSS state
_mssRefBarL := not na(lastMssBullBar) ? lastMssBullBar : _mssRefBarL
_mssRefBarS := not na(lastMssBearBar) ? lastMssBearBar : _mssRefBarS
_mssBreakLvlL := mssBreakLvlL2
_mssBreakLvlS := mssBreakLvlS2
_mssSweepRefL := not na(bestSweepBarSSL) ? bestSweepBarSSL : _mssSweepRefL
_mssSweepRefS := not na(bestSweepBarBSL) ? bestSweepBarBSL : _mssSweepRefS
_mssScorePersistL := mssScoreL2
_mssScorePersistS := mssScoreS2
_mssFailedPersistL := mssFailedL2
_mssFailedPersistS := mssFailedS2
_mssFollowBarsL := mssFollowBarsL2
_mssFollowBarsS := mssFollowBarsS2
_mssBodyConfL := mssBodyConfL2
_mssBodyConfS := mssBodyConfS2
_mssBreakQScoreL := mssBreakQScoreL2
_mssBreakQScoreS := mssBreakQScoreS2

// --- Chapter 5: Displacement Stage Evaluation (runs each bar, after MSS) ---
[dispDetL2, dispWeakL2, dispValidL2, dispStrongL2, dispFreshL2, dispFailedL2, dispScoreL2, dispReasonL2, dispFailReasonL2, dispBarL2, dispRangeAtrL2, dispBodyDomL2, dispCloseQualL2, dispFollowBarsL2, dispHasImbL2, dispFvgGradeL2, dispRetainedL2, dispOriginL2, dispExtremeL2] = se.evaluate_displacement_stage(true, lastMssBullBar, lastMssBullDispStrength, mssBreakLvlL2, mssValidL2, mssFailedL2, lastBullFvgBar, lastBullFvgGrade, lastBullFvgMitigated, atr, sensitivityMode, _dispRefBarL, _dispScorePersistL, _dispFailedPersistL, _dispFollowBarsL, _dispOriginL, _dispExtremeL, _dispMssRefL)

[dispDetS2, dispWeakS2, dispValidS2, dispStrongS2, dispFreshS2, dispFailedS2, dispScoreS2, dispReasonS2, dispFailReasonS2, dispBarS2, dispRangeAtrS2, dispBodyDomS2, dispCloseQualS2, dispFollowBarsS2, dispHasImbS2, dispFvgGradeS2, dispRetainedS2, dispOriginS2, dispExtremeS2] = se.evaluate_displacement_stage(false, lastMssBearBar, lastMssBearDispStrength, mssBreakLvlS2, mssValidS2, mssFailedS2, lastBearFvgBar, lastBearFvgGrade, lastBearFvgMitigated, atr, sensitivityMode, _dispRefBarS, _dispScorePersistS, _dispFailedPersistS, _dispFollowBarsS, _dispOriginS, _dispExtremeS, _dispMssRefS)

// Update persistent displacement state
_dispMssRefL := not na(lastMssBullBar) ? lastMssBullBar : _dispMssRefL
_dispMssRefS := not na(lastMssBearBar) ? lastMssBearBar : _dispMssRefS
_dispRefBarL := not na(dispBarL2) ? dispBarL2 : _dispRefBarL
_dispRefBarS := not na(dispBarS2) ? dispBarS2 : _dispRefBarS
_dispScorePersistL := dispScoreL2
_dispScorePersistS := dispScoreS2
_dispFailedPersistL := dispFailedL2
_dispFailedPersistS := dispFailedS2
_dispFollowBarsL := dispFollowBarsL2
_dispFollowBarsS := dispFollowBarsS2
_dispOriginL := dispOriginL2
_dispOriginS := dispOriginS2
_dispExtremeL := dispExtremeL2
_dispExtremeS := dispExtremeS2

// Chapter 5: Displacement mode pass (for mode qualification and bridge)
[dispPassL, dispPassStrongL] = se.displacement_mode_pass(dispDetL2, dispValidL2, dispStrongL2, dispScoreL2, dispFailedL2, sensitivityMode)
[dispPassS, dispPassStrongS] = se.displacement_mode_pass(dispDetS2, dispValidS2, dispStrongS2, dispScoreS2, dispFailedS2, sensitivityMode)

// --- Lifecycle Determination (Chapter 1 + Chapter 3 + Chapter 4 + Chapter 5: displacement-truth-aware) ---
[lcLong, lcNameLong, lcNextReqLong, lcCanActLong, lcReasonLong] = determine_lifecycle(sweptSSL, bestSweepBarSSL, lastMssBullBar, lastMssBullDispStrength, lastBullFvgBar, lastBullFvgGrade, lastBullFvgMitigated, seqOkL, expiredL, degradedL, reqL, lastPHi, true, atr, rclDetL, rclValidL2, rclFailedL2, mssValidL2, mssStrongL2, mssFailedL2, dispValidL2, dispStrongL2, dispFailedL2)
[lcShort, lcNameShort, lcNextReqShort, lcCanActShort, lcReasonShort] = determine_lifecycle(sweptBSL, bestSweepBarBSL, lastMssBearBar, lastMssBearDispStrength, lastBearFvgBar, lastBearFvgGrade, lastBearFvgMitigated, seqOkS, expiredS, degradedS, reqS, lastPLo, false, atr, rclDetS, rclValidS2, rclFailedS2, mssValidS2, mssStrongS2, mssFailedS2, dispValidS2, dispStrongS2, dispFailedS2)

// --- Setup State Population (inlined to avoid external element limit) ---
liveSetup := new_setup_state()
float biasMultLong = marketBias == "Bullish" ? 1.15 : marketBias == "Bearish" ? 0.85 : 1.0
float biasMultShort = marketBias == "Bearish" ? 1.15 : marketBias == "Bullish" ? 0.85 : 1.0
float adjScoreLong = scoreLong * biasMultLong
float adjScoreShort = scoreShort * biasMultShort
bool isConflicted = seqOkL and seqOkS and math.abs(adjScoreLong - adjScoreShort) < 15
bool pickLong = adjScoreLong >= adjScoreShort

liveSetup.nearestBSL := nearestBSL
liveSetup.nearestSSL := nearestSSL
liveSetup.scoreLong := scoreLong
liveSetup.scoreShort := scoreShort
liveSetup.phaseLong := phaseLong
liveSetup.phaseShort := phaseShort
liveSetup.missingLong := missingLong
liveSetup.missingShort := missingShort

liveSetup.score := pickLong ? scoreLong : scoreShort
liveSetup.isPotentialLong := pickLong
liveSetup.isPotentialShort := not pickLong
liveSetup.requiredSweep := pickLong ? reqL : reqS
liveSetup.triggerLevel := pickLong ? trigL : trigS
liveSetup.sequenceValid := pickLong ? seqOkL : seqOkS
liveSetup.sweepGrade := pickLong ? swGradeL : swGradeS
liveSetup.mssGrade := pickLong ? msGradeL : msGradeS
liveSetup.fvgGrade := pickLong ? fgGradeL : fgGradeS
liveSetup.hasOBConfluence := pickLong ? obBullConfluence : obBearConfluence
liveSetup.isExpired := pickLong ? expiredL : expiredS
liveSetup.isDegraded := pickLong ? degradedL : degradedS
liveSetup.isConflicted := isConflicted

liveSetup.lifecycleLong := lcLong
liveSetup.lifecycleShort := lcShort
liveSetup.lifecycleNameLong := lcNameLong
liveSetup.lifecycleNameShort := lcNameShort
liveSetup.lifecycleReasonLong := lcReasonLong
liveSetup.lifecycleReasonShort := lcReasonShort
liveSetup.lifecycleNextRequiredLong := lcNextReqLong
liveSetup.lifecycleNextRequiredShort := lcNextReqShort
liveSetup.lifecycleCanActivateLong := lcCanActLong
liveSetup.lifecycleCanActivateShort := lcCanActShort
liveSetup.lifecycleDominant := pickLong ? lcLong : lcShort
liveSetup.lifecycleNameDominant := pickLong ? lcNameLong : lcNameShort
liveSetup.lifecycleReasonDominant := pickLong ? lcReasonLong : lcReasonShort
liveSetup.lifecycleNextRequiredDominant := pickLong ? lcNextReqLong : lcNextReqShort
liveSetup.lifecycleCanActivateDominant := pickLong ? lcCanActLong : lcCanActShort

liveSetup.phase := pickLong ? phaseLong : phaseShort
liveSetup.missing := pickLong ? missingLong : missingShort

if isConflicted
    liveSetup.phase := "Market conflicted"
    liveSetup.missing := "Both long (" + str.tostring(scoreLong) + ") and short (" + str.tostring(scoreShort) + ") setups active — no clear edge, stand aside"
    liveSetup.score := math.max(scoreLong, scoreShort)
    liveSetup.lifecycleDominant := LC_NONE
    liveSetup.lifecycleNameDominant := "Market conflicted"
    liveSetup.lifecycleNextRequiredDominant := "Both sides active — stand aside"
    liveSetup.lifecycleCanActivateDominant := false
// --- Strategy Detection ---
[ictGateLong, ictGateLongInfo, ictHasValidExternalLong] = sg.ict_liquidity_gate(true, lastMssBullBar, lastMssBullDispStrength, activeSweeps, sensitivityMode)

[ictGateShort, ictGateShortInfo, ictHasValidExternalShort] = sg.ict_liquidity_gate(false, lastMssBearBar, lastMssBearDispStrength, activeSweeps, sensitivityMode)

[sbGateLong, sbGateLongInfo, sbHasSessionSweepLong] = sg.silver_bullet_liquidity_gate(true, activeSweeps)

[sbGateShort, sbGateShortInfo, sbHasSessionSweepShort] = sg.silver_bullet_liquidity_gate(false, activeSweeps)

bool continuationLiquidityLong = sweptSSL and (bestSweepSrcSSL == SRC_PIVOT_INT or bestSweepExtSSL or bestSweepSrcSSL == SRC_EQH_EQL or bestSweepSrcSSL == SRC_ROUND_NUM or liq.is_htf_liquidity_source(bestSweepSrcSSL))
bool continuationLiquidityShort = sweptBSL and (bestSweepSrcBSL == SRC_PIVOT_INT or bestSweepExtBSL or bestSweepSrcBSL == SRC_EQH_EQL or bestSweepSrcBSL == SRC_ROUND_NUM or liq.is_htf_liquidity_source(bestSweepSrcBSL))

bool sig2022B = mssBull and ictGateLong and enableICT2022
bool sig2022S = mssBear and ictGateShort and enableICT2022
bool inSB = sbLon.isActive or sbAm.isActive
bool sigSBB = inSB and bullFvgAligned and sbGateLong and enableSilverBullet
bool sigSBS = inSB and bearFvgAligned and sbGateShort and enableSilverBullet

if pickLong and enableICT2022 and mssBull and not ictGateLong
    liveSetup.missing := "ICT 2022 blocked: " + ictGateLongInfo
else if not pickLong and enableICT2022 and mssBear and not ictGateShort
    liveSetup.missing := "ICT 2022 blocked: " + ictGateShortInfo
else if pickLong and enableSilverBullet and inSB and bullFvgAligned and not sbGateLong
    liveSetup.missing := "Silver Bullet blocked: " + sbGateLongInfo
else if not pickLong and enableSilverBullet and inSB and bearFvgAligned and not sbGateShort
    liveSetup.missing := "Silver Bullet blocked: " + sbGateShortInfo

bool dominantLiquidityBlocked = pickLong ? ((enableICT2022 and mssBull and not ictGateLong) or (enableSilverBullet and inSB and bullFvgAligned and not sbGateLong)) : ((enableICT2022 and mssBear and not ictGateShort) or (enableSilverBullet and inSB and bearFvgAligned and not sbGateShort))

// Gate-blocked lifecycle update — preserve detailed gate info in next-required
if dominantLiquidityBlocked and liveSetup.lifecycleDominant >= LC_MSS_CONFIRMED
    liveSetup.lifecycleNextRequiredDominant := liveSetup.missing

// --- Alert History Engine ---
var T.AlertLog[] alertLogs = array.new<T.AlertLog>()
if (sig2022B or sigSBB or sig2022S or sigSBS)
    string sig = (sig2022B or sigSBB) ? "BUY" : "SELL"
    color c = (sig2022B or sigSBB) ? uiPosColor : uiNegColor
    array.unshift(alertLogs, T.AlertLog.new(str.format_time(time, "HH:mm", NY_TZ), sig, close, c))
    if array.size(alertLogs) > maxAlertRows
        array.pop(alertLogs)

// --- Trade Management ---
var T.Stats mainStats = T.Stats.new()
var T.Trade activeTrade = na
var box[] historicalBoxes = array.new_box()

// Chapter 2.1: Persistent pending activation state (survives across bars)
var bool   _pendingLongActive = false
var bool   _pendingShortActive = false
var int    _pendingLongSignalBar = 0
var int    _pendingShortSignalBar = 0
var int    _pendingLongExpiryBar = 0
var int    _pendingShortExpiryBar = 0
var string _pendingLongSource = ""
var string _pendingShortSource = ""
var int    _pendingLongInitialLC = 0
var int    _pendingShortInitialLC = 0
var string _pendingLongMode = ""
var string _pendingShortMode = ""
var string _pendingLongReason = ""
var string _pendingShortReason = ""
var bool   _pendingLongCanStillActivate = false
var bool   _pendingShortCanStillActivate = false

// Stats.update_stats() method moved to tv_pending_trade_state library (pts.*)

bool isSignalB = sig2022B or sigSBB
bool isSignalS = sig2022S or sigSBS

// =====================================================================
// --- MODE QUALIFICATION COMPUTATION (Chapter 2 + 2.2) ---
// =====================================================================

// Chapter 3: Map formal reclaim stage outputs to mode-dependent pass/fail
bool rclPassL = se.reclaim_mode_pass(rclDetL, rclValidL2, rclStrongL2, rclScoreL2, sensitivityMode)
float rclStrL = rclScoreL2
string rclReasonL = rclReasonL2
bool rclWeakL = rclWeakL2
bool rclStrongL = rclStrongL2
bool rclPassS = se.reclaim_mode_pass(rclDetS, rclValidS2, rclStrongS2, rclScoreS2, sensitivityMode)
float rclStrS = rclScoreS2
string rclReasonS = rclReasonS2
bool rclWeakS = rclWeakS2
bool rclStrongS = rclStrongS2

[extBlockL, extDistL, extReasonL] = se.compute_extension_block(true, lastMssBullBar, lastPHi, atr, sensitivityMode, reqL)
[extBlockS, extDistS, extReasonS] = se.compute_extension_block(false, lastMssBearBar, lastPLo, atr, sensitivityMode, reqS)

// Chapter 4: MSS quality now sourced from formal MSS evaluator via mss_mode_pass
[mssQPassL, mssQStrongL] = se.mss_mode_pass(mssDetL, mssValidL2, mssStrongL2, mssScoreL2, mssTrigSigL2, sensitivityMode)
string mssQReasonL = mssReasonL2
[mssQPassS, mssQStrongS] = se.mss_mode_pass(mssDetS, mssValidS2, mssStrongS2, mssScoreS2, mssTrigSigS2, sensitivityMode)
string mssQReasonS = mssReasonS2

// Chapter 5: Bridge now wraps formal displacement evaluator
[bridgePassL, bridgeStrongL, bridgeReasonL] = se.evaluate_displacement_bridge(lastMssBullDispStrength, lastBullFvgBar, lastBullFvgGrade, lastBullFvgMitigated, seqOkL, lastMssBullBar, sensitivityMode, dispValidL2, dispStrongL2, dispFailedL2, dispScoreL2)
[bridgePassS, bridgeStrongS, bridgeReasonS] = se.evaluate_displacement_bridge(lastMssBearDispStrength, lastBearFvgBar, lastBearFvgGrade, lastBearFvgMitigated, seqOkS, lastMssBearBar, sensitivityMode, dispValidS2, dispStrongS2, dispFailedS2, dispScoreS2)

// Chapter 3: Failed reclaim blocks activation for all modes
// Override reclaim pass if reclaim has failed
if rclFailedL2
    rclPassL := false
if rclFailedS2
    rclPassS := false

// Backward-compatible reclaim proxy aliases (now sourced from Chapter 3 evaluator, post-failure-override)
bool reclaimProxyLong = rclPassL
bool reclaimProxyShort = rclPassS

// Evaluate mode qualification with quality data (Chapter 3+4: reclaim + MSS truth)
// Chapter 5: evaluate_mode_execution now receives formal displacement truth
[modeCandL, modeActL, modeBlockL, modeDirectL, modePathL] = pts.evaluate_mode_execution(sensitivityMode, liveSetup.lifecycleLong, sweptSSL, sweepQualitySSL, not na(lastMssBullBar), lastMssBullDispStrength, not na(lastBullFvgBar) and lastBullFvgGrade > 0, lastBullFvgGrade, seqOkL, expiredL, degradedL, rclPassL, rclStrL, rclStrongL, extBlockL, mssQPassL, mssQStrongL, bridgePassL, bridgeStrongL, scoreLong, mssTrigSigL2, dispPassL, dispPassStrongL, dispFailedL2, dispScoreL2)

[modeCandS, modeActS, modeBlockS, modeDirectS, modePathS] = pts.evaluate_mode_execution(sensitivityMode, liveSetup.lifecycleShort, sweptBSL, sweepQualityBSL, not na(lastMssBearBar), lastMssBearDispStrength, not na(lastBearFvgBar) and lastBearFvgGrade > 0, lastBearFvgGrade, seqOkS, expiredS, degradedS, rclPassS, rclStrS, rclStrongS, extBlockS, mssQPassS, mssQStrongS, bridgePassS, bridgeStrongS, scoreShort, mssTrigSigS2, dispPassS, dispPassStrongS, dispFailedS2, dispScoreS2)

// Populate SetupState mode fields
liveSetup.sensitivityModeActive := sensitivityMode
liveSetup.modeMinCandidateLifecycle := lm.mode_min_lifecycle_for_candidate(sensitivityMode)
liveSetup.modeMinActivationLifecycle := lm.mode_min_lifecycle_for_activation(sensitivityMode)
liveSetup.longMeetsModeCandidate := modeCandL
liveSetup.shortMeetsModeCandidate := modeCandS
liveSetup.longMeetsModeActivation := modeActL
liveSetup.shortMeetsModeActivation := modeActS
liveSetup.longModeBlockReason := modeBlockL
liveSetup.shortModeBlockReason := modeBlockS
liveSetup.longHasReclaimProxy := reclaimProxyLong
liveSetup.shortHasReclaimProxy := reclaimProxyShort
// Chapter 2.2: Quality fields (now sourced from Chapter 3 reclaim evaluator)
liveSetup.reclaimStrengthLong := rclStrL
liveSetup.reclaimStrengthShort := rclStrS
liveSetup.reclaimReasonLong := rclReasonL
liveSetup.reclaimReasonShort := rclReasonS
// Chapter 3: Reclaim stage fields
liveSetup.reclaimDetectedLong := rclDetL
liveSetup.reclaimDetectedShort := rclDetS
liveSetup.reclaimValidLong := rclValidL2
liveSetup.reclaimValidShort := rclValidS2
liveSetup.reclaimStrongLong := rclStrongL2
liveSetup.reclaimStrongShort := rclStrongS2
liveSetup.reclaimFailedLong := rclFailedL2
liveSetup.reclaimFailedShort := rclFailedS2
liveSetup.reclaimScoreLong := rclScoreL2
liveSetup.reclaimScoreShort := rclScoreS2
liveSetup.reclaimStageReasonLong := rclReasonL2
liveSetup.reclaimStageReasonShort := rclReasonS2
liveSetup.reclaimAcceptBarsLong := rclAcceptL2
liveSetup.reclaimAcceptBarsShort := rclAcceptS2
liveSetup.extensionBlockedLong := extBlockL
liveSetup.extensionBlockedShort := extBlockS
liveSetup.extensionDistLong := extDistL
liveSetup.extensionDistShort := extDistS
liveSetup.extensionReasonLong := extReasonL
liveSetup.extensionReasonShort := extReasonS
liveSetup.mssQualityPassLong := mssQPassL
liveSetup.mssQualityPassShort := mssQPassS
// Chapter 4: MSS stage fields
liveSetup.mssDetectedLong := mssDetL
liveSetup.mssDetectedShort := mssDetS
liveSetup.mssValidLong := mssValidL2
liveSetup.mssValidShort := mssValidS2
liveSetup.mssStrongLong := mssStrongL2
liveSetup.mssStrongShort := mssStrongS2
liveSetup.mssFreshLong := mssFreshL2
liveSetup.mssFreshShort := mssFreshS2
liveSetup.mssFailedLong := mssFailedL2
liveSetup.mssFailedShort := mssFailedS2
liveSetup.mssScoreLong := mssScoreL2
liveSetup.mssScoreShort := mssScoreS2
liveSetup.mssBreakLevelLong := mssBreakLvlL2
liveSetup.mssBreakLevelShort := mssBreakLvlS2
liveSetup.mssReasonLong := mssReasonL2
liveSetup.mssReasonShort := mssReasonS2
liveSetup.mssTriggerTypeLong := mssTrigTypeL2
liveSetup.mssTriggerTypeShort := mssTrigTypeS2
liveSetup.mssTriggerSigLong := mssTrigSigL2
liveSetup.mssTriggerSigShort := mssTrigSigS2
liveSetup.mssBodyConfirmedLong := mssBodyConfL2
liveSetup.mssBodyConfirmedShort := mssBodyConfS2
liveSetup.mssQualityReasonLong := mssQReasonL
liveSetup.mssQualityReasonShort := mssQReasonS
// Chapter 5: Displacement stage fields
liveSetup.disp.detectedLong := dispDetL2
liveSetup.disp.detectedShort := dispDetS2
liveSetup.disp.weakLong := dispWeakL2
liveSetup.disp.weakShort := dispWeakS2
liveSetup.disp.validLong := dispValidL2
liveSetup.disp.validShort := dispValidS2
liveSetup.disp.strongLong := dispStrongL2
liveSetup.disp.strongShort := dispStrongS2
liveSetup.disp.freshLong := dispFreshL2
liveSetup.disp.freshShort := dispFreshS2
liveSetup.disp.failedLong := dispFailedL2
liveSetup.disp.failedShort := dispFailedS2
liveSetup.disp.scoreLong := dispScoreL2
liveSetup.disp.scoreShort := dispScoreS2
liveSetup.disp.reasonLong := dispReasonL2
liveSetup.disp.reasonShort := dispReasonS2
liveSetup.disp.failReasonLong := dispFailReasonL2
liveSetup.disp.failReasonShort := dispFailReasonS2
liveSetup.disp.rangeAtrLong := dispRangeAtrL2
liveSetup.disp.rangeAtrShort := dispRangeAtrS2
liveSetup.disp.bodyDomLong := dispBodyDomL2
liveSetup.disp.bodyDomShort := dispBodyDomS2
liveSetup.disp.hasImbalanceLong := dispHasImbL2
liveSetup.disp.hasImbalanceShort := dispHasImbS2
liveSetup.disp.fvgGradeLong := dispFvgGradeL2
liveSetup.disp.fvgGradeShort := dispFvgGradeS2
liveSetup.disp.retainedLong := dispRetainedL2
liveSetup.disp.retainedShort := dispRetainedS2
liveSetup.activationPathDominant := pickLong ? modePathL : modePathS

// Dominant side mode qualification
liveSetup.dominantMeetsModeCandidate := pickLong ? modeCandL : modeCandS
liveSetup.dominantMeetsModeActivation := pickLong ? modeActL : modeActS
liveSetup.dominantBlockedByMode := not (pickLong ? modeActL : modeActS) and liveSetup.lifecycleDominant >= LC_MSS_CONFIRMED
liveSetup.dominantModeBlockReason := pickLong ? modeBlockL : modeBlockS

// --- Signal Lifecycle Promotion (Chapter 1+2+5: Mode-Aware + Displacement-Truth) ---
// Signal promotion is now gated by sensitivity mode policy AND formal displacement truth.
// Aggressive: may promote from MSS_CONFIRMED+ to ENTRY_TRIGGERED if reclaim+displacement pass
// Balanced: signal may at most confirm displacement; cannot promote to ENTRY_TRIGGERED directly
// Conservative: signal cannot bypass entry-armed requirements
if isSignalB and liveSetup.lifecycleLong >= LC_MSS_CONFIRMED and liveSetup.lifecycleLong < LC_ENTRY_TRIGGERED
    // Chapter 5: AGG now requires formal displacement pass instead of raw mssDisp threshold
    bool canPromoteAggL = sensitivityMode == "Aggressive" and reclaimProxyLong and sweptSSL and not na(lastMssBullBar) and dispPassL and not dispFailedL2 and not expiredL and not degradedL
    if canPromoteAggL
        liveSetup.lifecycleLong := LC_ENTRY_TRIGGERED
        liveSetup.lifecycleNameLong := lm.lifecycle_name(LC_ENTRY_TRIGGERED)
        liveSetup.lifecycleCanActivateLong := true
        modeActL := true
        modeBlockL := ""
        liveSetup.longMeetsModeActivation := true
        liveSetup.longModeBlockReason := ""
    // Chapter 5: Balanced/Conservative promote to DISPLACEMENT_CONFIRMED only with formal displacement validity
    else if sensitivityMode != "Aggressive" and modeCandL and liveSetup.lifecycleLong < LC_DISPLACEMENT_CONFIRMED and dispValidL2 and not dispFailedL2
        liveSetup.lifecycleLong := LC_DISPLACEMENT_CONFIRMED
        liveSetup.lifecycleNameLong := lm.lifecycle_name(LC_DISPLACEMENT_CONFIRMED)

if isSignalS and liveSetup.lifecycleShort >= LC_MSS_CONFIRMED and liveSetup.lifecycleShort < LC_ENTRY_TRIGGERED
    bool canPromoteAggS = sensitivityMode == "Aggressive" and reclaimProxyShort and sweptBSL and not na(lastMssBearBar) and dispPassS and not dispFailedS2 and not expiredS and not degradedS
    if canPromoteAggS
        liveSetup.lifecycleShort := LC_ENTRY_TRIGGERED
        liveSetup.lifecycleNameShort := lm.lifecycle_name(LC_ENTRY_TRIGGERED)
        liveSetup.lifecycleCanActivateShort := true
        modeActS := true
        modeBlockS := ""
        liveSetup.shortMeetsModeActivation := true
        liveSetup.shortModeBlockReason := ""
    else if sensitivityMode != "Aggressive" and modeCandS and liveSetup.lifecycleShort < LC_DISPLACEMENT_CONFIRMED and dispValidS2 and not dispFailedS2
        liveSetup.lifecycleShort := LC_DISPLACEMENT_CONFIRMED
        liveSetup.lifecycleNameShort := lm.lifecycle_name(LC_DISPLACEMENT_CONFIRMED)

// Update dominant lifecycle after signal promotion
if (isSignalB and pickLong) or (isSignalS and not pickLong)
    liveSetup.lifecycleDominant := pickLong ? liveSetup.lifecycleLong : liveSetup.lifecycleShort
    liveSetup.lifecycleNameDominant := lm.lifecycle_name(liveSetup.lifecycleDominant)
    liveSetup.lifecycleCanActivateDominant := pickLong ? liveSetup.lifecycleCanActivateLong : liveSetup.lifecycleCanActivateShort
    // Re-evaluate dominant mode qualification after promotion
    liveSetup.dominantMeetsModeActivation := pickLong ? modeActL : modeActS
    liveSetup.dominantBlockedByMode := not (pickLong ? modeActL : modeActS) and liveSetup.lifecycleDominant >= LC_MSS_CONFIRMED
    liveSetup.dominantModeBlockReason := pickLong ? modeBlockL : modeBlockS

// =====================================================================
// --- CHAPTER 6: ENTRY AUTHORITY EVALUATION ---
// =====================================================================
// Compute pending freshness first (needed by entry authority)
[pendFreshL, pendStaleL, pendFreshReasonL] = pts.pending_is_structurally_fresh(_pendingLongActive ? _pendingLongSignalBar : bar_index, lastMssBullBar, lastBullFvgBar, degradedL, extBlockL, sensitivityMode, mssFailedL2, dispFailedL2)
[pendFreshS, pendStaleS, pendFreshReasonS] = pts.pending_is_structurally_fresh(_pendingShortActive ? _pendingShortSignalBar : bar_index, lastMssBearBar, lastBearFvgBar, degradedS, extBlockS, sensitivityMode, mssFailedS2, dispFailedS2)
liveSetup.pendingStructFreshLong := pendFreshL
liveSetup.pendingStructFreshShort := pendFreshS
liveSetup.freshnessReasonLong := pendFreshReasonL
liveSetup.freshnessReasonShort := pendFreshReasonS

// Gate blocked status per side
bool gateLongBlocked = pickLong and ((enableICT2022 and mssBull and not ictGateLong) or (enableSilverBullet and inSB and bullFvgAligned and not sbGateLong))
bool gateShortBlocked = not pickLong and ((enableICT2022 and mssBear and not ictGateShort) or (enableSilverBullet and inSB and bearFvgAligned and not sbGateShort))
string gateLongReason = gateLongBlocked ? (enableICT2022 and mssBull and not ictGateLong ? ictGateLongInfo : sbGateLongInfo) : ""
string gateShortReason = gateShortBlocked ? (enableICT2022 and mssBear and not ictGateShort ? ictGateShortInfo : sbGateShortInfo) : ""

// Pending activation evaluation (needed before EA evaluation)
bool pendingActivatedLong = false
bool pendingActivatedShort = false
string pendingActivationReason = ""
bool pendingExpiredL = _pendingLongActive and lm.pending_setup_has_expired(_pendingLongExpiryBar)
bool pendingExpiredS = _pendingShortActive and lm.pending_setup_has_expired(_pendingShortExpiryBar)

if _pendingLongActive and na(activeTrade)
    [canActPL, reasonPL, shouldInvPL] = pts.evaluate_pending_activation(true, liveSetup.lifecycleLong, rclPassL, rclStrL, rclStrongL, lastMssBullDispStrength, seqOkL, expiredL, degradedL, _pendingLongMode, _pendingLongSignalBar, _pendingLongExpiryBar, extBlockL, mssQPassL, mssQStrongL, bridgePassL, bridgeStrongL, pendFreshL, rclFailedL2, mssFailedL2, mssFreshL2, dispPassL, dispFreshL2, dispFailedL2)
    if shouldInvPL
        _pendingLongActive := false
        _pendingLongCanStillActivate := false
        _pendingLongReason := reasonPL
    else if canActPL
        pendingActivatedLong := true
        pendingActivationReason := reasonPL
        _pendingLongCanStillActivate := false
    else
        _pendingLongReason := reasonPL

// Evaluate pending short
if _pendingShortActive and na(activeTrade) and not pendingActivatedLong
    [canActPS, reasonPS, shouldInvPS] = pts.evaluate_pending_activation(false, liveSetup.lifecycleShort, rclPassS, rclStrS, rclStrongS, lastMssBearDispStrength, seqOkS, expiredS, degradedS, _pendingShortMode, _pendingShortSignalBar, _pendingShortExpiryBar, extBlockS, mssQPassS, mssQStrongS, bridgePassS, bridgeStrongS, pendFreshS, rclFailedS2, mssFailedS2, mssFreshS2, dispPassS, dispFreshS2, dispFailedS2)
    if shouldInvPS
        _pendingShortActive := false
        _pendingShortCanStillActivate := false
        _pendingShortReason := reasonPS
    else if canActPS
        pendingActivatedShort := true
        pendingActivationReason := reasonPS
        _pendingShortCanStillActivate := false
    else
        _pendingShortReason := reasonPS

bool canActivateDelayed = pendingActivatedLong or pendingActivatedShort

// --- Chapter 6: Evaluate Entry Authority for both sides ---
// Long side entry authority
[eaLong, epLong, ebLong, eaReasonL, eaStructValidL] = ea.evaluate_entry_authority(
     liveSetup.lifecycleLong, seqOkL, sweptSSL,
     mssValidL2, mssFailedL2, mssFreshL2,
     rclFailedL2, rclPassL,
     dispValidL2, dispFailedL2, dispFreshL2,
     expiredL, degradedL,
     sensitivityMode, modeCandL, modeActL, modeBlockL,
     lm.mode_allows_direct_signal_activation(sensitivityMode),
     gateLongBlocked, gateLongReason,
     extBlockL, pendFreshL,
     isSignalB, isConflicted,
     _pendingLongActive, pendingActivatedLong, pendingExpiredL,
     not na(activeTrade))

// Short side entry authority
[eaShort, epShort, ebShort, eaReasonS, eaStructValidS] = ea.evaluate_entry_authority(
     liveSetup.lifecycleShort, seqOkS, sweptBSL,
     mssValidS2, mssFailedS2, mssFreshS2,
     rclFailedS2, rclPassS,
     dispValidS2, dispFailedS2, dispFreshS2,
     expiredS, degradedS,
     sensitivityMode, modeCandS, modeActS, modeBlockS,
     lm.mode_allows_direct_signal_activation(sensitivityMode),
     gateShortBlocked, gateShortReason,
     extBlockS, pendFreshS,
     isSignalS, isConflicted,
     _pendingShortActive, pendingActivatedShort, pendingExpiredS,
     not na(activeTrade))

// Populate SetupState entry authority fields
liveSetup.entryAuthorityLong := eaLong
liveSetup.entryAuthorityShort := eaShort
liveSetup.entryAuthorityDominant := pickLong ? eaLong : eaShort
liveSetup.entryPathLong := epLong
liveSetup.entryPathShort := epShort
liveSetup.entryPathDominant := pickLong ? epLong : epShort
liveSetup.blockCategoryLong := ebLong
liveSetup.blockCategoryShort := ebShort
liveSetup.blockCategoryDominant := pickLong ? ebLong : ebShort
liveSetup.entryReasonLong := eaReasonL
liveSetup.entryReasonShort := eaReasonS
liveSetup.entryReasonDominant := pickLong ? eaReasonL : eaReasonS
liveSetup.structurallyValidLong := eaStructValidL
liveSetup.structurallyValidShort := eaStructValidS
liveSetup.structurallyValidDominant := pickLong ? eaStructValidL : eaStructValidS

// --- Chapter 6: Invalidate pending when EA is terminal for that side ---
// If entry authority evaluates to EXPIRED or INVALIDATED, the pending setup
// for that side is no longer structurally coherent and must be cleared.
if _pendingLongActive and ea.ea_is_terminal(eaLong)
    _pendingLongActive := false
    _pendingLongCanStillActivate := false
    _pendingLongReason := "EA: " + ea.ea_name(eaLong) + " — " + eaReasonL
if _pendingShortActive and ea.ea_is_terminal(eaShort)
    _pendingShortActive := false
    _pendingShortCanStillActivate := false
    _pendingShortReason := "EA: " + ea.ea_name(eaShort) + " — " + eaReasonS
// Also invalidate pending when EA says BLOCKED with structural failure categories
if _pendingLongActive and eaLong == EA_BLOCKED and (ebLong == EB_RECLAIM_FAILED or ebLong == EB_MSS_FAILED or ebLong == EB_DISP_FAILED or ebLong == EB_CONFLICTED)
    _pendingLongActive := false
    _pendingLongCanStillActivate := false
    _pendingLongReason := "EA blocked: " + ea.eb_name(ebLong)
if _pendingShortActive and eaShort == EA_BLOCKED and (ebShort == EB_RECLAIM_FAILED or ebShort == EB_MSS_FAILED or ebShort == EB_DISP_FAILED or ebShort == EB_CONFLICTED)
    _pendingShortActive := false
    _pendingShortCanStillActivate := false
    _pendingShortReason := "EA blocked: " + ea.eb_name(ebShort)

// --- Chapter 6: Derive activation decisions from entry authority ---
// Entry authority is the canonical and sole activation gate.
// Immediate: EA must say TRIGGERABLE with IMMEDIATE path for the signal side.
bool canActivateImmediate = (isSignalB and eaLong == EA_TRIGGERABLE and epLong == EP_IMMEDIATE) or (isSignalS and eaShort == EA_TRIGGERABLE and epShort == EP_IMMEDIATE)
// Delayed: EA must say TRIGGERABLE with RETRACE path for the pending side.
bool eaAllowsDelayed = (pendingActivatedLong and eaLong == EA_TRIGGERABLE and epLong == EP_RETRACE) or (pendingActivatedShort and eaShort == EA_TRIGGERABLE and epShort == EP_RETRACE)
canActivateDelayed := canActivateDelayed and eaAllowsDelayed

bool canActivateTrade = canActivateImmediate or canActivateDelayed
bool activatingViaDelayed = canActivateDelayed and not canActivateImmediate

// Determine activation direction
bool activateLong = canActivateImmediate ? isSignalB : pendingActivatedLong
bool activateShort = canActivateImmediate ? isSignalS : pendingActivatedShort

// Signal fired but cannot activate — store as pending for delayed activation (Chapter 2.1 Part C)
// Chapter 6: Use entry authority state to decide pending storage eligibility
if (isSignalB or isSignalS) and na(activeTrade) and not canActivateImmediate
    if isSignalB and not _pendingLongActive
        // Chapter 6: Entry authority states that allow pending storage.
        // ea_allows_pending covers PENDING_RETRACE, PENDING_CONFIRMATION, ARMED, READY.
        // Also allow when blocked by mode quality (setup is real but mode says wait)
        // or when structurally valid (mode candidate passes, setup progressing).
        bool pendingCandidateL = ea.ea_allows_pending(eaLong) or (eaLong == EA_BLOCKED and ebLong == EB_MODE_QUALITY) or (eaLong == EA_STRUCT_VALID and modeCandL)
        if pendingCandidateL
            int windowBars = lm.mode_pending_activation_bars(sensitivityMode)
            _pendingLongActive := true
            _pendingLongSignalBar := bar_index
            _pendingLongExpiryBar := bar_index + windowBars
            _pendingLongSource := sig2022B ? "ICT 2022" : "SB"
            _pendingLongInitialLC := liveSetup.lifecycleLong
            _pendingLongMode := sensitivityMode
            _pendingLongReason := lm.mode_name_short(sensitivityMode) + " pending: " + eaReasonL + " (" + str.tostring(windowBars) + " bars)"
            _pendingLongCanStillActivate := true
    if isSignalS and not _pendingShortActive
        // Chapter 6: Same EA-driven pending eligibility for short side
        bool pendingCandidateS = ea.ea_allows_pending(eaShort) or (eaShort == EA_BLOCKED and ebShort == EB_MODE_QUALITY) or (eaShort == EA_STRUCT_VALID and modeCandS)
        if pendingCandidateS
            int windowBarsS = lm.mode_pending_activation_bars(sensitivityMode)
            _pendingShortActive := true
            _pendingShortSignalBar := bar_index
            _pendingShortExpiryBar := bar_index + windowBarsS
            _pendingShortSource := sig2022S ? "ICT 2022" : "SB"
            _pendingShortInitialLC := liveSetup.lifecycleShort
            _pendingShortMode := sensitivityMode
            _pendingShortReason := lm.mode_name_short(sensitivityMode) + " pending: " + eaReasonS + " (" + str.tostring(windowBarsS) + " bars)"
            _pendingShortCanStillActivate := true

    // Diagnostic: explain why immediate activation was blocked (Chapter 6: use entry authority reason)
    int sigEA = isSignalB ? eaLong : eaShort
    string sigEAReason = isSignalB ? eaReasonL : eaReasonS
    if ea.ea_is_terminal(sigEA) or sigEA == EA_BLOCKED or sigEA == EA_LATE
        liveSetup.dominantBlockedByMode := true
        liveSetup.dominantModeBlockReason := sigEAReason
    else if sigEA == EA_PENDING_RETRACE or sigEA == EA_PENDING_CONFIRMATION
        liveSetup.dominantBlockedByMode := true
        liveSetup.dominantModeBlockReason := lm.mode_name_short(sensitivityMode) + " mode: pending activation stored (" + str.tostring(lm.mode_pending_activation_bars(sensitivityMode)) + " bar window)"
    else if sigEA == EA_STRUCT_VALID or sigEA == EA_FORMING
        liveSetup.dominantBlockedByMode := true
        liveSetup.dominantModeBlockReason := sigEAReason

// Clear pending state after successful delayed activation
if pendingActivatedLong
    _pendingLongActive := false
if pendingActivatedShort
    _pendingShortActive := false

// Populate SetupState pending fields for dashboard visibility
liveSetup.pendingLongActive := _pendingLongActive
liveSetup.pendingShortActive := _pendingShortActive
liveSetup.pendingLongSignalBar := _pendingLongSignalBar
liveSetup.pendingShortSignalBar := _pendingShortSignalBar
liveSetup.pendingLongExpiryBar := _pendingLongExpiryBar
liveSetup.pendingShortExpiryBar := _pendingShortExpiryBar
liveSetup.pendingLongSource := _pendingLongSource
liveSetup.pendingShortSource := _pendingShortSource
liveSetup.pendingLongInitialLifecycle := _pendingLongInitialLC
liveSetup.pendingShortInitialLifecycle := _pendingShortInitialLC
liveSetup.pendingLongMode := _pendingLongMode
liveSetup.pendingShortMode := _pendingShortMode
liveSetup.pendingLongReason := _pendingLongReason
liveSetup.pendingShortReason := _pendingShortReason
liveSetup.pendingLongCanStillActivate := _pendingLongCanStillActivate
liveSetup.pendingShortCanStillActivate := _pendingShortCanStillActivate
liveSetup.pendingLongActivatedThisBar := pendingActivatedLong
liveSetup.pendingShortActivatedThisBar := pendingActivatedShort

// =====================================================================
// --- CHAPTER 7: OPPORTUNITY STATE EVALUATION ---
// =====================================================================
// Evaluate opportunity state for both sides after entry authority and pending state are known.
// This provides timing quality classification that complements entry authority's execution gate.

// Track whether a trade was previously closed from the current setup context
// (used to classify OPP_COMPLETE — a setup that produced a trade which is now closed)
var bool _tradeClosedFromSetupL = false
var bool _tradeClosedFromSetupS = false

[oppLong, oppReasonL, chaseOkL] = pts.evaluate_opportunity_state(
     eaLong, ebLong, eaStructValidL,
     _pendingLongActive, _pendingLongSignalBar, _pendingLongExpiryBar,
     pendFreshL, _pendingLongCanStillActivate,
     mssFreshL2, dispFreshL2,
     extBlockL, mssFailedL2, rclFailedL2, dispFailedL2,
     expiredL, degradedL,
     sensitivityMode, liveSetup.lifecycleLong,
     lastMssBullBar, _pendingLongSignalBar,
     not na(activeTrade), _tradeClosedFromSetupL)

[oppShort, oppReasonS, chaseOkS] = pts.evaluate_opportunity_state(
     eaShort, ebShort, eaStructValidS,
     _pendingShortActive, _pendingShortSignalBar, _pendingShortExpiryBar,
     pendFreshS, _pendingShortCanStillActivate,
     mssFreshS2, dispFreshS2,
     extBlockS, mssFailedS2, rclFailedS2, dispFailedS2,
     expiredS, degradedS,
     sensitivityMode, liveSetup.lifecycleShort,
     lastMssBearBar, _pendingShortSignalBar,
     not na(activeTrade), _tradeClosedFromSetupS)

// Populate SetupState Chapter 7 fields
liveSetup.opp.stateLong := oppLong
liveSetup.opp.stateShort := oppShort
liveSetup.opp.reasonLong := oppReasonL
liveSetup.opp.reasonShort := oppReasonS
liveSetup.opp.chaseLong := chaseOkL
liveSetup.opp.chaseShort := chaseOkS

// Chapter 7: Opportunity-aware pending invalidation
// If opportunity evaluator says this pending is missed/stale, invalidate it
// even if the old pending window hasn't technically expired yet.
if _pendingLongActive and pts.opp_should_invalidate_pending(oppLong)
    _pendingLongActive := false
    _pendingLongCanStillActivate := false
    _pendingLongReason := "Ch7: " + pts.opp_name(oppLong) + " — " + oppReasonL
if _pendingShortActive and pts.opp_should_invalidate_pending(oppShort)
    _pendingShortActive := false
    _pendingShortCanStillActivate := false
    _pendingShortReason := "Ch7: " + pts.opp_name(oppShort) + " — " + oppReasonS

// Chapter 7: Prevent delayed activation when opportunity is no longer chase-worthy.
// Uses opp_is_chase_forbidden to cover ALL non-chaseable states:
// MISSED, STALE, EXPIRED, INVALIDATED, LATE_RISKY, BLOCKED, COMPLETE.
if canActivateDelayed and pts.opp_is_chase_forbidden(pickLong ? oppLong : oppShort)
    canActivateDelayed := false
    canActivateTrade := canActivateImmediate

// Chapter 7: Re-populate pending fields after opportunity-aware invalidation
liveSetup.pendingLongActive := _pendingLongActive
liveSetup.pendingShortActive := _pendingShortActive
liveSetup.pendingLongReason := _pendingLongReason
liveSetup.pendingShortReason := _pendingShortReason
liveSetup.pendingLongCanStillActivate := _pendingLongCanStillActivate
liveSetup.pendingShortCanStillActivate := _pendingShortCanStillActivate

// Chapter 6: Trade creation gated by entry authority promotion guard
if na(activeTrade) and canActivateTrade and ea.can_promote_to_active(pickLong ? eaLong : eaShort, pickLong ? epLong : epShort, not na(activeTrade))
    // Determine trade source name for delayed activations
    string tradeSource = activatingViaDelayed ? (activateLong ? _pendingLongSource : _pendingShortSource) : (sig2022B or sig2022S ? "ICT 2022" : "SB")
    float sl = activateLong ? low[1] - (atr * 0.5) : high[1] + (atr * 0.5)
    float risk = math.abs(close - sl)
    float tp1 = activateLong ? close + risk * 1.0 : close - risk * 1.0
    float tp2 = activateLong ? close + risk * 2.0 : close - risk * 2.0
    box tpB = na
    box slB = na
    if showSetups and showZones
        color tpCol = activateLong ? longTpColor : shortTpColor
        color slCol = activateLong ? longSlColor : shortSlColor
        tpB := box.new(bar_index, activateLong ? tp2 : close, bar_index, activateLong ? close : tp2, bgcolor = color.new(tpCol, activeTransp), border_color = tpCol, border_width = activeBorderWidth)
        slB := box.new(bar_index, activateLong ? close : sl, bar_index, activateLong ? sl : close, bgcolor = color.new(slCol, activeTransp), border_color = slCol, border_width = activeBorderWidth)
    activeTrade := T.Trade.new(tradeSource, activateLong, close, sl, tp1, tp2, bar_index, true, false, tpB, slB)

if not na(activeTrade)
    bool closed = false
    float r = 0.0
    string outcome = ""
    string sz = markerSizeInput == "Tiny" ? size.tiny : markerSizeInput == "Small" ? size.small : size.normal

    // LIVE PROJECTED: Active trade SL/TP boxes extend right every bar (intentional).
    if not na(activeTrade.tpBox)
        box.set_right(activeTrade.tpBox, bar_index + (extendCandidateRight ? activeMinWidth : 0))
        box.set_right(activeTrade.slBox, bar_index + (extendCandidateRight ? activeMinWidth : 0))

    if activeTrade.isLong
        if low <= activeTrade.stopPrice
            r := activeTrade.isTp1Hit ? 0.0 : -1.0
            closed := true
            outcome := r == 0 ? "BE" : "SL"
            if showSlMarkers
                label.new(bar_index, activeTrade.stopPrice, outcome, color = slMarkerColor, textcolor = color.white, style = label.style_label_up, size = sz)
        else if high >= activeTrade.tp2Price
            r := 2.0
            closed := true
            outcome := "TP2"
            if showTpMarkers
                label.new(bar_index, activeTrade.tp2Price, "TP2", color = tpMarkerColor, textcolor = color.white, style = label.style_label_down, size = sz)
        else if high >= activeTrade.tp1Price and not activeTrade.isTp1Hit
            activeTrade.isTp1Hit := true
            if showTpMarkers
                label.new(bar_index, activeTrade.tp1Price, "TP1", color = tpMarkerColor, textcolor = color.white, style = label.style_label_down, size = sz)
    else
        if high >= activeTrade.stopPrice
            r := activeTrade.isTp1Hit ? 0.0 : -1.0
            closed := true
            outcome := r == 0 ? "BE" : "SL"
            if showSlMarkers
                label.new(bar_index, activeTrade.stopPrice, outcome, color = slMarkerColor, textcolor = color.white, style = label.style_label_down, size = sz)
        else if low <= activeTrade.tp2Price
            r := 2.0
            closed := true
            outcome := "TP2"
            if showTpMarkers
                label.new(bar_index, activeTrade.tp2Price, "TP2", color = tpMarkerColor, textcolor = color.white, style = label.style_label_up, size = sz)
        else if low <= activeTrade.tp1Price and not activeTrade.isTp1Hit
            activeTrade.isTp1Hit := true
            if showTpMarkers
                label.new(bar_index, activeTrade.tp1Price, "TP1", color = tpMarkerColor, textcolor = color.white, style = label.style_label_up, size = sz)

    if closed
        pts.update_stats(mainStats, r, r > 0)
        // HISTORICAL ANCHORED: Finalize trade boxes at close bar. After this,
        // these boxes are stored in historicalBoxes and never updated again.
        box.set_right(activeTrade.tpBox, bar_index)
        box.set_right(activeTrade.slBox, bar_index)
        box.set_border_width(activeTrade.tpBox, 1)
        box.set_border_width(activeTrade.slBox, 1)
        array.push(historicalBoxes, activeTrade.tpBox)
        array.push(historicalBoxes, activeTrade.slBox)
        if array.size(historicalBoxes) > maxHistory * 2
            box.delete(array.shift(historicalBoxes))
            box.delete(array.shift(historicalBoxes))
        // Chapter 7: Track that a trade was completed from this setup context
        if activeTrade.isLong
            _tradeClosedFromSetupL := true
        else
            _tradeClosedFromSetupS := true
        activeTrade := na

// Reset trade-closed flags when a new setup context begins (new MSS = fresh setup)
if mssBull
    _tradeClosedFromSetupL := false
if mssBear
    _tradeClosedFromSetupS := false

// --- Post-Trade Lifecycle Reconciliation & Invariant Validation (extracted to function) ---
validate_invariants(SetupState s, T.Trade activeTrade, bool pickLong,
     bool seqOkL, bool seqOkS, int lcLong, int lcShort,
     string sensitivityMode, bool isSignalB, bool isSignalS,
     bool pendingActivatedLong, bool pendingActivatedShort, bool activatingViaDelayed,
     bool extBlockL, bool extBlockS,
     bool rclPassL, bool rclPassS, float rclStrL, float rclStrS,
     bool mssQPassL, bool mssQPassS, bool mssQStrongL, bool mssQStrongS,
     bool dispPassL, bool dispPassS, bool dispPassStrongL, bool dispPassStrongS,
     bool dominantLiquidityBlocked,
     bool rclDetL, bool rclDetS,
     bool rclFailedL2, bool rclFailedS2, bool rclValidL2, bool rclValidS2,
     bool rclStrongL2, bool rclStrongS2, float rclScoreL2, float rclScoreS2,
     bool mssValidL2, bool mssValidS2, bool mssFailedL2, bool mssFailedS2,
     int mssTrigSigL2, int mssTrigSigS2, bool mssFreshL2, bool mssFreshS2,
     float mssScoreL2, float mssScoreS2,
     bool dispValidL2, bool dispValidS2, bool dispFailedL2, bool dispFailedS2,
     float dispScoreL2, float dispScoreS2,
     bool pendFreshL, bool pendFreshS,
     int bestSweepBarSSL, int bestSweepBarBSL,
     int lastMssBullBar, int lastMssBearBar,
     bool pndLongActive, bool pndLongCanStillAct, int pndLongExpiryBar, int pndLongSignalBar, int pndLongInitialLC, string pndLongMode, string pndLongReason,
     bool pndShortActive, bool pndShortCanStillAct, int pndShortExpiryBar, int pndShortSignalBar, int pndShortInitialLC, string pndShortMode, string pndShortReason) =>

    // Local copies of pending state (will be returned)
    bool _pLA = pndLongActive
    bool _pLCA = pndLongCanStillAct
    string _pLR = pndLongReason
    bool _pSA = pndShortActive
    bool _pSCA = pndShortCanStillAct
    string _pSR = pndShortReason

    // =====================================================================
    // --- POST-TRADE LIFECYCLE RECONCILIATION & INVARIANT VALIDATION ---
    // (Chapter 1: State Machine Integrity)
    // =====================================================================

    // If activeTrade exists, lifecycle dominant must be ACTIVE
    if not na(activeTrade)
        s.lifecycleDominant := LC_ACTIVE
        s.lifecycleNameDominant := lm.lifecycle_name(LC_ACTIVE)
        s.lifecycleNextRequiredDominant := "Manage active position"
        s.lifecycleCanActivateDominant := true

    // --- Invariant Validation ---
    // Detect impossible state combinations and flag as DESYNC

    // Invariant 3: Pre-confirmation lifecycle but sequenceValid reports true
    if lm.lifecycle_is_preconfirmation(s.lifecycleLong) and seqOkL
        s.lifecycleIsDesynced := true
        s.lifecycleDesyncReason := "Long: pre-confirmation lifecycle (" + lm.lifecycle_name(s.lifecycleLong) + ") but sequence valid"
        s.lifecycleDominant := LC_DESYNC
    if lm.lifecycle_is_preconfirmation(s.lifecycleShort) and seqOkS
        s.lifecycleIsDesynced := true
        s.lifecycleDesyncReason := "Short: pre-confirmation lifecycle (" + lm.lifecycle_name(s.lifecycleShort) + ") but sequence valid"
        s.lifecycleDominant := LC_DESYNC

    // Invariant 5: Dominant says can activate but lifecycle below ENTRY_ARMED
    if s.lifecycleCanActivateDominant and s.lifecycleDominant < LC_ENTRY_ARMED and s.lifecycleDominant != LC_ACTIVE
        s.lifecycleIsDesynced := true
        s.lifecycleDesyncReason := "canActivate=true at lifecycle=" + lm.lifecycle_name(s.lifecycleDominant)
        s.lifecycleDominant := LC_DESYNC

    // --- Chapter 2 Mode Invariants ---

    // Invariant M1: Trade activated this bar while pre-promotion lifecycle below mode minimum
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index
        int modeMinAct = lm.mode_min_lifecycle_for_activation(sensitivityMode)
        int prePromotionLc = pickLong ? lcLong : lcShort
        if prePromotionLc < modeMinAct and prePromotionLc != LC_ACTIVE
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := lm.mode_name_short(sensitivityMode) + ": trade activated at " + lm.lifecycle_name(prePromotionLc) + ", min=" + lm.lifecycle_name(modeMinAct)
            s.lifecycleDominant := LC_DESYNC

    // Invariant M2: Signal promoted to ENTRY_TRIGGERED with canActivate in non-Aggressive mode
    if not s.lifecycleIsDesynced and not lm.mode_allows_direct_signal_activation(sensitivityMode)
        bool badPromoL = isSignalB and s.lifecycleLong == LC_ENTRY_TRIGGERED and s.lifecycleCanActivateLong
        bool badPromoS = isSignalS and s.lifecycleShort == LC_ENTRY_TRIGGERED and s.lifecycleCanActivateShort
        if badPromoL or badPromoS
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := lm.mode_name_short(sensitivityMode) + ": signal promoted to ENTRY_TRIGGERED with canActivate (disallowed)"
            s.lifecycleDominant := LC_DESYNC

    // Invariant M3: Candidate preview would show while mode candidate qualification fails
    // (Enforced at render time; flagged here for debug visibility only — no desync)

    // Invariant M4: Lifecycle/action implies readiness while mode block reason exists
    // Chapter 2.1: Exempt when a pending activation is stored (mode block is expected on signal bar)
    bool hasPendingStored = _pLA or _pSA
    if not s.lifecycleIsDesynced and s.dominantBlockedByMode and s.lifecycleCanActivateDominant and s.lifecycleDominant != LC_ACTIVE and not hasPendingStored
        s.lifecycleIsDesynced := true
        s.lifecycleDesyncReason := lm.mode_name_short(sensitivityMode) + ": canActivate=true but mode blocks (" + s.dominantModeBlockReason + ")"
        s.lifecycleDominant := LC_DESYNC

    // --- Chapter 2.1 Pending Activation Invariants ---

    // Invariant P1: Delayed activation fired but no activeTrade created
    if not s.lifecycleIsDesynced and (pendingActivatedLong or pendingActivatedShort) and na(activeTrade)
        // This would indicate the activation path was taken but trade creation failed
        s.lifecycleIsDesynced := true
        s.lifecycleDesyncReason := "P1: delayed activation succeeded but no trade created"
        s.lifecycleDominant := LC_DESYNC

    // Invariant P2: Pending active for a mode that allows direct signal activation (AGG shouldn't need pending)
    if not s.lifecycleIsDesynced
        if _pLA and lm.mode_allows_direct_signal_activation(pndLongMode)
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P2: pending long stored for AGG mode (should activate immediately)"
            s.lifecycleDominant := LC_DESYNC
        if not s.lifecycleIsDesynced and _pSA and lm.mode_allows_direct_signal_activation(pndShortMode)
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P2: pending short stored for AGG mode (should activate immediately)"
            s.lifecycleDominant := LC_DESYNC

    // Invariant P3: Pending expiry bar is before signal bar (impossible window)
    if not s.lifecycleIsDesynced
        if _pLA and pndLongExpiryBar <= pndLongSignalBar
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P3: pending long expiry (" + str.tostring(pndLongExpiryBar) + ") <= signal (" + str.tostring(pndLongSignalBar) + ")"
            s.lifecycleDominant := LC_DESYNC
        if not s.lifecycleIsDesynced and _pSA and pndShortExpiryBar <= pndShortSignalBar
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P3: pending short expiry (" + str.tostring(pndShortExpiryBar) + ") <= signal (" + str.tostring(pndShortSignalBar) + ")"
            s.lifecycleDominant := LC_DESYNC

    // Invariant P4: Both pending long and short active simultaneously
    if not s.lifecycleIsDesynced and _pLA and _pSA
        s.lifecycleIsDesynced := true
        s.lifecycleDesyncReason := "P4: both pending long and short active simultaneously"
        s.lifecycleDominant := LC_DESYNC

    // Invariant P5: Delayed activation on same bar as signal (should have been immediate)
    if not s.lifecycleIsDesynced
        if pendingActivatedLong and pndLongSignalBar == bar_index
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P5: delayed long activation on signal bar (should be immediate)"
            s.lifecycleDominant := LC_DESYNC
        if not s.lifecycleIsDesynced and pendingActivatedShort and pndShortSignalBar == bar_index
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P5: delayed short activation on signal bar (should be immediate)"
            s.lifecycleDominant := LC_DESYNC

    // Invariant P6: Trade activated via delayed path but activeTrade direction mismatch
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and activatingViaDelayed
        if pendingActivatedLong and not activeTrade.isLong
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P6: delayed long activation created short trade"
            s.lifecycleDominant := LC_DESYNC
        if not s.lifecycleIsDesynced and pendingActivatedShort and activeTrade.isLong
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P6: delayed short activation created long trade"
            s.lifecycleDominant := LC_DESYNC

    // Invariant P7: Pending initial lifecycle below MSS_CONFIRMED (shouldn't have been stored)
    if not s.lifecycleIsDesynced
        if _pLA and pndLongInitialLC < LC_MSS_CONFIRMED
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P7: pending long stored at " + lm.lifecycle_name(pndLongInitialLC) + " (below MSS_CONFIRMED)"
            s.lifecycleDominant := LC_DESYNC
        if not s.lifecycleIsDesynced and _pSA and pndShortInitialLC < LC_MSS_CONFIRMED
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "P7: pending short stored at " + lm.lifecycle_name(pndShortInitialLC) + " (below MSS_CONFIRMED)"
            s.lifecycleDominant := LC_DESYNC

    // --- Chapter 2.2 Quality Invariants ---

    // Invariant Q1: Balanced activation while extension filter says blocked
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode == "Balanced"
        bool domExt = activeTrade.isLong ? extBlockL : extBlockS
        if domExt
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "Q1: BAL activated while extension filter blocked"
            s.lifecycleDominant := LC_DESYNC

    // Invariant Q2: Conservative activation without stronger quality than Balanced
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode == "Conservative"
        float domRclStr = activeTrade.isLong ? rclStrL : rclStrS
        bool domMssStrong = activeTrade.isLong ? mssQStrongL : mssQStrongS
        if domRclStr < 50.0 and not domMssStrong
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "Q2: CON activated without strong quality (reclaim=" + str.tostring(math.round(domRclStr)) + ")"
            s.lifecycleDominant := LC_DESYNC

    // Invariant Q3: Pending setup valid while freshness helper says stale
    if not s.lifecycleIsDesynced
        if _pLA and _pLCA and not pendFreshL
            _pLA := false
            _pLCA := false
            _pLR := "Q3: pending invalidated — structurally stale"
        if _pSA and _pSCA and not pendFreshS
            _pSA := false
            _pSCA := false
            _pSR := "Q3: pending invalidated — structurally stale"

    // Invariant Q4: Reclaim quality insufficient but activation permitted
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index
        bool domRclPass = activeTrade.isLong ? rclPassL : rclPassS
        if not domRclPass and sensitivityMode != "Aggressive"
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "Q4: " + lm.mode_name_short(sensitivityMode) + " activated without reclaim pass"
            s.lifecycleDominant := LC_DESYNC

    // Invariant Q5: MSS quality insufficient but activation permitted (non-Aggressive)
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode != "Aggressive"
        bool domMssQPass = activeTrade.isLong ? mssQPassL : mssQPassS
        if not domMssQPass
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "Q5: " + lm.mode_name_short(sensitivityMode) + " activated without MSS quality pass"
            s.lifecycleDominant := LC_DESYNC

    // --- Chapter 3: Reclaim Stage Invariants ---

    // Invariant R1: lifecycle = LC_RECLAIM_VISIBLE while reclaimDetected is false
    if not s.lifecycleIsDesynced
        bool rclDesyncL = s.lifecycleLong == LC_RECLAIM_VISIBLE and not rclDetL
        bool rclDesyncS = s.lifecycleShort == LC_RECLAIM_VISIBLE and not rclDetS
        if rclDesyncL or rclDesyncS
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "R1: LC_RECLAIM_VISIBLE without reclaim detected (" + (rclDesyncL ? "long" : "short") + ")"
            s.lifecycleDominant := LC_DESYNC

    // Invariant R2: activation allowed while reclaimFailed is true
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index
        bool domRclFailed_ = activeTrade.isLong ? rclFailedL2 : rclFailedS2
        if domRclFailed_
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "R2: trade activated while reclaim failed"
            s.lifecycleDominant := LC_DESYNC

    // Invariant R3: Balanced/Conservative activation with reclaim below mode minimum
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode != "Aggressive"
        bool domRclValid_ = activeTrade.isLong ? rclValidL2 : rclValidS2
        bool domRclStrong_ = activeTrade.isLong ? rclStrongL2 : rclStrongS2
        if sensitivityMode == "Conservative" and not domRclStrong_
            float domRclScore_ = activeTrade.isLong ? rclScoreL2 : rclScoreS2
            if domRclScore_ < 55.0
                s.lifecycleIsDesynced := true
                s.lifecycleDesyncReason := "R3: CON activated without strong reclaim (" + str.tostring(math.round(domRclScore_)) + ")"
                s.lifecycleDominant := LC_DESYNC
        else if sensitivityMode == "Balanced" and not domRclValid_
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "R3: BAL activated without valid reclaim"
            s.lifecycleDominant := LC_DESYNC

    // Invariant R4: pending setup alive while reclaim has clearly failed
    if not s.lifecycleIsDesynced
        if _pLA and _pLCA and rclFailedL2
            _pLA := false
            _pLCA := false
            _pLR := "R4: pending invalidated — reclaim failed"
        if _pSA and _pSCA and rclFailedS2
            _pSA := false
            _pSCA := false
            _pSR := "R4: pending invalidated — reclaim failed"

    // Invariant R5: lifecycle advanced past sweep without reclaim evidence
    if not s.lifecycleIsDesynced
        bool advLNoRecl = s.lifecycleLong >= LC_RECLAIM_VISIBLE and s.lifecycleLong <= LC_MSS_CONFIRMED and not rclDetL and not na(bestSweepBarSSL) and na(lastMssBullBar)
        bool advSNoRecl = s.lifecycleShort >= LC_RECLAIM_VISIBLE and s.lifecycleShort <= LC_MSS_CONFIRMED and not rclDetS and not na(bestSweepBarBSL) and na(lastMssBearBar)
        if advLNoRecl or advSNoRecl
            // Downgrade to SWEEP_CONFIRMED instead of desync (soft correction)
            if advLNoRecl
                s.lifecycleLong := LC_SWEEP_CONFIRMED
                s.lifecycleNameLong := lm.lifecycle_name(LC_SWEEP_CONFIRMED)
            if advSNoRecl
                s.lifecycleShort := LC_SWEEP_CONFIRMED
                s.lifecycleNameShort := lm.lifecycle_name(LC_SWEEP_CONFIRMED)

    // --- Chapter 4: MSS Integrity Invariants ---

    // Invariant M1: lifecycle = LC_MSS_CONFIRMED while mssValid is false (and not failed)
    if not s.lifecycleIsDesynced
        bool mssLcDesyncL = s.lifecycleLong == LC_MSS_CONFIRMED and not mssValidL2 and not mssFailedL2 and not na(lastMssBullBar)
        bool mssLcDesyncS = s.lifecycleShort == LC_MSS_CONFIRMED and not mssValidS2 and not mssFailedS2 and not na(lastMssBearBar)
        if mssLcDesyncL or mssLcDesyncS
            // Soft correction: downgrade to RECLAIM_VISIBLE or SWEEP_CONFIRMED
            if mssLcDesyncL
                s.lifecycleLong := rclDetL ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
                s.lifecycleNameLong := lm.lifecycle_name(s.lifecycleLong)
            if mssLcDesyncS
                s.lifecycleShort := rclDetS ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
                s.lifecycleNameShort := lm.lifecycle_name(s.lifecycleShort)

    // Invariant M2: activation allowed while mssFailed is true
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index
        bool domMssFailed2 = activeTrade.isLong ? mssFailedL2 : mssFailedS2
        if domMssFailed2
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "M2: trade activated while MSS failed"
            s.lifecycleDominant := LC_DESYNC

    // Invariant M3: Balanced/Conservative activation with MSS below mode minimum quality
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode != "Aggressive"
        bool domMssQPass2 = activeTrade.isLong ? mssQPassL : mssQPassS
        int domMssTrigSig2 = activeTrade.isLong ? mssTrigSigL2 : mssTrigSigS2
        if not domMssQPass2
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "M3: " + lm.mode_name_short(sensitivityMode) + " activated without MSS mode pass"
            s.lifecycleDominant := LC_DESYNC
        else if sensitivityMode == "Conservative" and domMssTrigSig2 < 2
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "M3: CON activated with trigger sig=" + str.tostring(domMssTrigSig2) + " (need >= 2)"
            s.lifecycleDominant := LC_DESYNC

    // Invariant M4: pending setup alive while MSS has clearly failed
    if not s.lifecycleIsDesynced
        if _pLA and _pLCA and mssFailedL2
            _pLA := false
            _pLCA := false
            _pLR := "M4: pending invalidated — MSS failed"
        if _pSA and _pSCA and mssFailedS2
            _pSA := false
            _pSCA := false
            _pSR := "M4: pending invalidated — MSS failed"

    // Invariant M5: lifecycle advanced past reclaim without valid MSS evidence
    if not s.lifecycleIsDesynced
        bool advLNoMss = s.lifecycleLong >= LC_MSS_CONFIRMED and not mssValidL2 and not na(lastMssBullBar) and not mssFailedL2
        bool advSNoMss = s.lifecycleShort >= LC_MSS_CONFIRMED and not mssValidS2 and not na(lastMssBearBar) and not mssFailedS2
        if advLNoMss
            s.lifecycleLong := rclDetL ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
            s.lifecycleNameLong := lm.lifecycle_name(s.lifecycleLong)
        if advSNoMss
            s.lifecycleShort := rclDetS ? LC_RECLAIM_VISIBLE : LC_SWEEP_CONFIRMED
            s.lifecycleNameShort := lm.lifecycle_name(s.lifecycleShort)

    // Invariant M6: LC_DISPLACEMENT_CONFIRMED while underlying MSS is invalid or stale
    if not s.lifecycleIsDesynced
        bool dispNoMssL = s.lifecycleLong == LC_DISPLACEMENT_CONFIRMED and (mssFailedL2 or not mssFreshL2)
        bool dispNoMssS = s.lifecycleShort == LC_DISPLACEMENT_CONFIRMED and (mssFailedS2 or not mssFreshS2)
        if dispNoMssL
            s.lifecycleLong := LC_SWEEP_CONFIRMED
            s.lifecycleNameLong := lm.lifecycle_name(LC_SWEEP_CONFIRMED)
        if dispNoMssS
            s.lifecycleShort := LC_SWEEP_CONFIRMED
            s.lifecycleNameShort := lm.lifecycle_name(LC_SWEEP_CONFIRMED)

    // Invariant M7: Conservative activates on MSS quality weaker than Balanced
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode == "Conservative"
        bool domMssStrong2 = activeTrade.isLong ? mssQStrongL : mssQStrongS
        float domMssScore2 = activeTrade.isLong ? mssScoreL2 : mssScoreS2
        if not domMssStrong2 and domMssScore2 < 50.0
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "M7: CON activated with weak MSS (score=" + str.tostring(math.round(domMssScore2)) + ")"
            s.lifecycleDominant := LC_DESYNC

    // --- Chapter 5: Displacement Integrity Invariants ---

    // Invariant D1: lifecycle = LC_DISPLACEMENT_CONFIRMED while dispValid is false
    if not s.lifecycleIsDesynced
        bool dispLcDesyncL = s.lifecycleLong == LC_DISPLACEMENT_CONFIRMED and not dispValidL2 and not dispFailedL2
        bool dispLcDesyncS = s.lifecycleShort == LC_DISPLACEMENT_CONFIRMED and not dispValidS2 and not dispFailedS2
        if dispLcDesyncL
            // Soft correction: downgrade to MSS_CONFIRMED
            s.lifecycleLong := LC_MSS_CONFIRMED
            s.lifecycleNameLong := lm.lifecycle_name(LC_MSS_CONFIRMED)
        if dispLcDesyncS
            s.lifecycleShort := LC_MSS_CONFIRMED
            s.lifecycleNameShort := lm.lifecycle_name(LC_MSS_CONFIRMED)

    // Invariant D2: activation allowed while dispFailed is true
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index
        bool domDispFailed3 = activeTrade.isLong ? dispFailedL2 : dispFailedS2
        if domDispFailed3
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "D2: trade activated while displacement failed"
            s.lifecycleDominant := LC_DESYNC

    // Invariant D3: Balanced/Conservative activation with displacement below mode minimum quality
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode != "Aggressive"
        bool domDispPass3 = activeTrade.isLong ? dispPassL : dispPassS
        if not domDispPass3
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "D3: " + lm.mode_name_short(sensitivityMode) + " activated without displacement mode pass"
            s.lifecycleDominant := LC_DESYNC

    // Invariant D4: pending setup alive while displacement has failed
    if not s.lifecycleIsDesynced
        if _pLA and _pLCA and dispFailedL2
            _pLA := false
            _pLCA := false
            _pLR := "D4: pending invalidated — displacement failed"
        if _pSA and _pSCA and dispFailedS2
            _pSA := false
            _pSCA := false
            _pSR := "D4: pending invalidated — displacement failed"

    // Invariant D5: lifecycle advanced past MSS without valid displacement evidence
    // (LC_DISPLACEMENT_CONFIRMED requires dispValid)
    if not s.lifecycleIsDesynced
        bool advDispLNoEvidence = s.lifecycleLong == LC_DISPLACEMENT_CONFIRMED and not dispValidL2 and dispFailedL2
        bool advDispSNoEvidence = s.lifecycleShort == LC_DISPLACEMENT_CONFIRMED and not dispValidS2 and dispFailedS2
        if advDispLNoEvidence
            s.lifecycleLong := LC_MSS_CONFIRMED
            s.lifecycleNameLong := lm.lifecycle_name(LC_MSS_CONFIRMED)
        if advDispSNoEvidence
            s.lifecycleShort := LC_MSS_CONFIRMED
            s.lifecycleNameShort := lm.lifecycle_name(LC_MSS_CONFIRMED)

    // Invariant D6: Conservative activates on displacement quality weaker than Balanced
    if not s.lifecycleIsDesynced and not na(activeTrade) and activeTrade.entryBar == bar_index and sensitivityMode == "Conservative"
        bool domDispStrong3 = activeTrade.isLong ? dispPassStrongL : dispPassStrongS
        float domDispScore3 = activeTrade.isLong ? dispScoreL2 : dispScoreS2
        if not domDispStrong3 and domDispScore3 < 50.0
            s.lifecycleIsDesynced := true
            s.lifecycleDesyncReason := "D6: CON activated with weak displacement (score=" + str.tostring(math.round(domDispScore3)) + ")"
            s.lifecycleDominant := LC_DESYNC

    // Invariant D7: LC_ENTRY_ARMED while underlying displacement is invalid/stale/failed
    if not s.lifecycleIsDesynced
        bool entryArmedBadDispL = s.lifecycleLong == LC_ENTRY_ARMED and dispFailedL2
        bool entryArmedBadDispS = s.lifecycleShort == LC_ENTRY_ARMED and dispFailedS2
        if entryArmedBadDispL
            s.lifecycleLong := LC_MSS_CONFIRMED
            s.lifecycleNameLong := lm.lifecycle_name(LC_MSS_CONFIRMED)
        if entryArmedBadDispS
            s.lifecycleShort := LC_MSS_CONFIRMED
            s.lifecycleNameShort := lm.lifecycle_name(LC_MSS_CONFIRMED)

    // Invariant D8: LC_DISPLACEMENT_CONFIRMED while underlying MSS is invalid (extends M6 with displacement)
    // Already handled by existing M6 invariant — no additional logic needed here.

    // --- Chapter 6: Entry Authority Invariants ---
    // EA1: validate entry authority state consistency
    int domEA = pickLong ? s.entryAuthorityLong : s.entryAuthorityShort
    int domEP = pickLong ? s.entryPathLong : s.entryPathShort
    int domEB = pickLong ? s.blockCategoryLong : s.blockCategoryShort
    bool domMssF_ = pickLong ? mssFailedL2 : mssFailedS2
    bool domRclF_ = pickLong ? rclFailedL2 : rclFailedS2
    bool domDispF_ = pickLong ? dispFailedL2 : dispFailedS2
    bool domModeAct_ = pickLong ? (s.longMeetsModeActivation) : (s.shortMeetsModeActivation)
    bool domModeCand_ = pickLong ? (s.longMeetsModeCandidate) : (s.shortMeetsModeCandidate)
    bool domExpired_ = s.isExpired

    [eaValid, eaDesyncReason] = ea.validate_entry_authority(domEA, domEP, domEB, s.lifecycleDominant, not na(activeTrade), domModeAct_, domModeCand_, domMssF_, domRclF_, domDispF_, domExpired_, s.isConflicted)
    if not s.lifecycleIsDesynced and not eaValid
        s.lifecycleIsDesynced := true
        s.lifecycleDesyncReason := eaDesyncReason
        s.lifecycleDominant := LC_DESYNC

    // EA2: Pending active while entry authority is terminal or structurally-blocked (defensive)
    if not s.lifecycleIsDesynced
        if _pLA and (ea.ea_is_terminal(s.entryAuthorityLong) or (s.entryAuthorityLong == EA_BLOCKED and (s.blockCategoryLong == EB_MSS_FAILED or s.blockCategoryLong == EB_RECLAIM_FAILED or s.blockCategoryLong == EB_DISP_FAILED)))
            _pLA := false
            _pLCA := false
            _pLR := "EA2: pending invalidated — EA=" + ea.ea_name(s.entryAuthorityLong)
        if _pSA and (ea.ea_is_terminal(s.entryAuthorityShort) or (s.entryAuthorityShort == EA_BLOCKED and (s.blockCategoryShort == EB_MSS_FAILED or s.blockCategoryShort == EB_RECLAIM_FAILED or s.blockCategoryShort == EB_DISP_FAILED)))
            _pSA := false
            _pSCA := false
            _pSR := "EA2: pending invalidated — EA=" + ea.ea_name(s.entryAuthorityShort)

    // EA3: Lifecycle says armed/triggered but EA says blocked/expired/invalidated (lifecycle must yield)
    if not s.lifecycleIsDesynced
        if s.lifecycleLong >= LC_ENTRY_ARMED and s.lifecycleLong <= LC_ENTRY_TRIGGERED and ea.ea_is_terminal(s.entryAuthorityLong)
            s.lifecycleLong := s.entryAuthorityLong == EA_EXPIRED ? LC_EXPIRED : LC_INVALIDATED
            s.lifecycleNameLong := lm.lifecycle_name(s.lifecycleLong)
        if s.lifecycleShort >= LC_ENTRY_ARMED and s.lifecycleShort <= LC_ENTRY_TRIGGERED and ea.ea_is_terminal(s.entryAuthorityShort)
            s.lifecycleShort := s.entryAuthorityShort == EA_EXPIRED ? LC_EXPIRED : LC_INVALIDATED
            s.lifecycleNameShort := lm.lifecycle_name(s.lifecycleShort)

    // =====================================================================
    // --- Chapter 7: Opportunity State Invariants ---
    // All invariants validate BOTH sides (long and short), not just dominant.
    // This ensures non-dominant side opportunity state remains coherent.
    // =====================================================================

    // OPP-I1: Opportunity says fresh/ready but entry authority is terminal
    // Both sides checked independently.
    if not s.lifecycleIsDesynced
        if (s.opp.stateLong == OPP_FRESH or s.opp.stateLong == OPP_READY or s.opp.stateLong == OPP_PENDING_FRESH) and ea.ea_is_terminal(s.entryAuthorityLong)
            s.opp.stateLong := s.entryAuthorityLong == EA_EXPIRED ? OPP_EXPIRED : OPP_INVALIDATED
            s.opp.reasonLong := "OPP-I1: opportunity " + pts.opp_name(OPP_FRESH) + " contradicts EA=" + ea.ea_name(s.entryAuthorityLong)
            s.opp.chaseLong := false
        if (s.opp.stateShort == OPP_FRESH or s.opp.stateShort == OPP_READY or s.opp.stateShort == OPP_PENDING_FRESH) and ea.ea_is_terminal(s.entryAuthorityShort)
            s.opp.stateShort := s.entryAuthorityShort == EA_EXPIRED ? OPP_EXPIRED : OPP_INVALIDATED
            s.opp.reasonShort := "OPP-I1: opportunity contradicts EA=" + ea.ea_name(s.entryAuthorityShort)
            s.opp.chaseShort := false

    // OPP-I2: Opportunity says missed/expired/stale but pending remains active and executable
    // Both sides checked independently.
    if not s.lifecycleIsDesynced
        if _pLA and _pLCA and (s.opp.stateLong == OPP_MISSED or s.opp.stateLong == OPP_EXPIRED or s.opp.stateLong == OPP_STALE)
            _pLA := false
            _pLCA := false
            _pLR := "OPP-I2: pending invalidated — opportunity=" + pts.opp_name(s.opp.stateLong)
        if _pSA and _pSCA and (s.opp.stateShort == OPP_MISSED or s.opp.stateShort == OPP_EXPIRED or s.opp.stateShort == OPP_STALE)
            _pSA := false
            _pSCA := false
            _pSR := "OPP-I2: pending invalidated — opportunity=" + pts.opp_name(s.opp.stateShort)

    // OPP-I3: Active trade exists while opportunity says missed/expired instead of active
    // Corrects the dominant side to OPP_ACTIVE when a trade is live.
    if not s.lifecycleIsDesynced and not na(activeTrade)
        if activeTrade.isLong
            if s.opp.stateLong == OPP_MISSED or s.opp.stateLong == OPP_EXPIRED or s.opp.stateLong == OPP_STALE
                s.opp.stateLong := OPP_ACTIVE
                s.opp.reasonLong := "OPP-I3: corrected — trade active"
        else
            if s.opp.stateShort == OPP_MISSED or s.opp.stateShort == OPP_EXPIRED or s.opp.stateShort == OPP_STALE
                s.opp.stateShort := OPP_ACTIVE
                s.opp.reasonShort := "OPP-I3: corrected — trade active"

    // OPP-I4: Opportunity says chase forbidden while delayed activation still allowed
    // Main-body suppression at canActivateDelayed uses opp_is_chase_forbidden.
    // Formal enforcement via dominant pending invalidation is in the canonical block below.

    // OPP-I5: Structurally invalidated setup still classified as merely late
    // Both sides checked independently.
    if not s.lifecycleIsDesynced
        if (mssFailedL2 or rclFailedL2 or dispFailedL2) and (s.opp.stateLong == OPP_LATE_ACCEPTABLE or s.opp.stateLong == OPP_LATE_RISKY)
            s.opp.stateLong := OPP_INVALIDATED
            s.opp.reasonLong := "OPP-I5: structural failure overrides late classification"
            s.opp.chaseLong := false
        if (mssFailedS2 or rclFailedS2 or dispFailedS2) and (s.opp.stateShort == OPP_LATE_ACCEPTABLE or s.opp.stateShort == OPP_LATE_RISKY)
            s.opp.stateShort := OPP_INVALIDATED
            s.opp.reasonShort := "OPP-I5: structural failure overrides late classification"
            s.opp.chaseShort := false

    // OPP-I6: Chase allowed but opportunity state is chase-forbidden
    // Ensures chaseAllowed flag is always coherent with opportunity classification.
    if not s.lifecycleIsDesynced
        if s.opp.chaseLong and pts.opp_is_chase_forbidden(s.opp.stateLong)
            s.opp.chaseLong := false
        if s.opp.chaseShort and pts.opp_is_chase_forbidden(s.opp.stateShort)
            s.opp.chaseShort := false

    // =====================================================================
    // Chapter 7: Canonical dominant-side opportunity state
    // Populated AFTER all invariant corrections so dominant state is truthful.
    // Downstream code should use these instead of ad-hoc pickLong derivation.
    // =====================================================================
    s.opp.stateDom := pickLong ? s.opp.stateLong : s.opp.stateShort
    s.opp.reasonDom := pickLong ? s.opp.reasonLong : s.opp.reasonShort
    s.opp.chaseDom := pickLong ? s.opp.chaseLong : s.opp.chaseShort
    s.opp.missedDom := s.opp.stateDom == OPP_MISSED or s.opp.stateDom == OPP_STALE or s.opp.stateDom == OPP_EXPIRED
    s.opp.timingDom := s.opp.stateDom == OPP_FRESH or s.opp.stateDom == OPP_READY ? "fresh"
         : s.opp.stateDom == OPP_PENDING_FRESH ? "fresh"
         : s.opp.stateDom == OPP_PENDING_DELAYED ? "delayed"
         : s.opp.stateDom == OPP_LATE_ACCEPTABLE ? "late"
         : s.opp.stateDom == OPP_LATE_RISKY ? "late-risky"
         : s.opp.stateDom == OPP_MISSED ? "missed"
         : s.opp.stateDom == OPP_STALE ? "stale"
         : s.opp.stateDom == OPP_EXPIRED ? "expired"
         : s.opp.stateDom == OPP_INVALIDATED ? "invalidated"
         : s.opp.stateDom == OPP_BLOCKED ? "blocked"
         : s.opp.stateDom == OPP_ACTIVE ? "active"
         : s.opp.stateDom == OPP_COMPLETE ? "complete"
         : s.opp.stateDom == OPP_FORMING ? "forming"
         : "none"

    // OPP-I4: Chase-forbidden dominant opportunity while delayed activation survived
    // (Formal invariant — defensive enforcement of the main-body suppression above.)
    // If delayed activation was not caught in the main body, catch it here.
    // Note: this modifies liveSetup but cannot modify canActivateDelayed directly
    // since it's a local in the caller. The main-body suppression handles the runtime
    // effect; this invariant ensures the canonical state is coherent for messaging.
    if not s.lifecycleIsDesynced and s.opp.missedDom
        if _pLA and _pLCA and pickLong
            _pLA := false
            _pLCA := false
            _pLR := "OPP-I4: pending invalidated — dominant opportunity=" + pts.opp_name(s.opp.stateDom)
        if _pSA and _pSCA and not pickLong
            _pSA := false
            _pSCA := false
            _pSR := "OPP-I4: pending invalidated — dominant opportunity=" + pts.opp_name(s.opp.stateDom)

    // --- Entry Authority Authoritative Field Overrides ---
    if s.lifecycleIsDesynced
        s.phase := "State desync"
        s.missing := s.lifecycleDesyncReason
        s.sequenceValid := false
        s.lifecycleNameDominant := lm.lifecycle_name(LC_DESYNC)
    else if not s.isConflicted
        // Chapter 6: Entry authority is the canonical phase display source.
        // EA_STRUCT_VALID and above are meaningful Chapter 6 states.
        // NONE and FORMING fall back to lifecycle name (they agree).
        if domEA >= EA_STRUCT_VALID
            s.phase := ea.ea_name(domEA)
        else if domEA == EA_FORMING
            s.phase := ea.ea_name(domEA)
        else
            s.phase := s.lifecycleNameDominant

        // Chapter 6+7: Entry authority reason is the canonical "missing/next" guidance.
        // Chapter 7 opportunity state qualifies pending messaging via canonical dominant fields.
        string domEAReason = pickLong ? s.entryReasonLong : s.entryReasonShort
        int domOppInv = s.opp.stateDom
        if _pLA or _pSA
            bool pendL2 = _pLA
            int barsRemaining = (pendL2 ? pndLongExpiryBar : pndShortExpiryBar) - bar_index
            string pendSide = pendL2 ? "Long" : "Short"
            // Chapter 7: Qualify pending guidance with opportunity timing
            string oppSuffix = domOppInv == OPP_PENDING_FRESH ? " — timing fresh"
                 : domOppInv == OPP_PENDING_DELAYED ? " — delayed but acceptable"
                 : domOppInv == OPP_LATE_ACCEPTABLE ? " — late, reduced conviction"
                 : domOppInv == OPP_LATE_RISKY ? " — late, do not chase"
                 : ""
            s.missing := pendSide + " pending activation (" + str.tostring(math.max(0, barsRemaining)) + " bars remaining)" + oppSuffix
        else if pts.opp_is_terminal(domOppInv) and domOppInv != OPP_COMPLETE
            // Chapter 7: Terminal opportunity states override EA messaging
            s.missing := pickLong ? s.opp.reasonLong : s.opp.reasonShort
        else if domEA >= EA_STRUCT_VALID
            // EA reason is authoritative for all structurally-aware states
            s.missing := domEAReason
        else if dominantLiquidityBlocked
            // Liquidity blocked states retain their own messaging
            s.missing := s.missing
        else if domEA == EA_FORMING and domEAReason != ""
            s.missing := domEAReason
        else
            s.missing := s.lifecycleNextRequiredDominant
        s.sequenceValid := s.lifecycleDominant >= LC_ENTRY_ARMED

    [_pLA, _pLCA, _pLR, _pSA, _pSCA, _pSR]

[_invPLA, _invPLCA, _invPLR, _invPSA, _invPSCA, _invPSR] = validate_invariants(liveSetup, activeTrade, pickLong,
     seqOkL, seqOkS, lcLong, lcShort,
     sensitivityMode, isSignalB, isSignalS,
     pendingActivatedLong, pendingActivatedShort, activatingViaDelayed,
     extBlockL, extBlockS,
     rclPassL, rclPassS, rclStrL, rclStrS,
     mssQPassL, mssQPassS, mssQStrongL, mssQStrongS,
     dispPassL, dispPassS, dispPassStrongL, dispPassStrongS,
     dominantLiquidityBlocked,
     rclDetL, rclDetS,
     rclFailedL2, rclFailedS2, rclValidL2, rclValidS2,
     rclStrongL2, rclStrongS2, rclScoreL2, rclScoreS2,
     mssValidL2, mssValidS2, mssFailedL2, mssFailedS2,
     mssTrigSigL2, mssTrigSigS2, mssFreshL2, mssFreshS2,
     mssScoreL2, mssScoreS2,
     dispValidL2, dispValidS2, dispFailedL2, dispFailedS2,
     dispScoreL2, dispScoreS2,
     pendFreshL, pendFreshS,
     bestSweepBarSSL, bestSweepBarBSL,
     lastMssBullBar, lastMssBearBar,
     _pendingLongActive, _pendingLongCanStillActivate, _pendingLongExpiryBar, _pendingLongSignalBar, _pendingLongInitialLC, _pendingLongMode, _pendingLongReason,
     _pendingShortActive, _pendingShortCanStillActivate, _pendingShortExpiryBar, _pendingShortSignalBar, _pendingShortInitialLC, _pendingShortMode, _pendingShortReason)
// Apply pending state changes from invariant validation
_pendingLongActive := _invPLA
_pendingLongCanStillActivate := _invPLCA
_pendingLongReason := _invPLR
_pendingShortActive := _invPSA
_pendingShortCanStillActivate := _invPSCA
_pendingShortReason := _invPSR

bool eqhSwept = false
bool eqlSwept = false
if array.size(activeSweeps) > 0
    for i = 0 to array.size(activeSweeps) - 1
        T.LiqSweep s= array.get(activeSweeps, i)
        if s.sourceType == SRC_EQH_EQL
            if s.isSSL
                eqlSwept := true
            else
                eqhSwept := true

if barstate.islast
    ren.render_level(pdh, showPDH, pdhColor, "PDH", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)
    ren.render_level(pdl, showPDL, pdlColor, "PDL", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)
    ren.render_level(pwh, showPWH, pwhColor, "PWH", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)
    ren.render_level(pwl, showPWL, pwlColor, "PWL", htfDisplayMode, htfSegLen, htfSegOffset, htfLineStyleInput, htfLineWidth, htfShowLabels)

    ren.render_level(asia.lastHigh, showAsiaH, asiaHColor, "Asia High", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    ren.render_level(asia.lastLow, showAsiaL, asiaLColor, "Asia Low", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    ren.render_level(london.lastHigh, showLonH, lonHColor, "London High", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    ren.render_level(london.lastLow, showLonL, lonLColor, "London Low", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    ren.render_level(ny.isActive ? ny.high : ny.lastHigh, showNYH, nyHColor, "NY High", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)
    ren.render_level(ny.isActive ? ny.low : ny.lastLow, showNYL, nyLColor, "NY Low", sessDisplayMode, sessSegLen, 0, sessLineStyleInput, 1, true)

    int eqhTransp = eqhSwept ? 80 : math.max(18, 62 - math.round(eqhScore * 0.4))
    int eqlTransp = eqlSwept ? 80 : math.max(18, 62 - math.round(eqlScore * 0.4))
    int eqhWidth = eqhScore >= 68 ? 2 : 1
    int eqlWidth = eqlScore >= 68 ? 2 : 1
    string eqhText = "EQH" + (eqhCount >= 2 ? "×" + str.tostring(eqhCount) : "") + (eqhSwept ? " ✓" : "")
    string eqlText = "EQL" + (eqlCount >= 2 ? "×" + str.tostring(eqlCount) : "") + (eqlSwept ? " ✓" : "")
    ren.render_level(eqhLevel, showEqClusters and eqhCount >= 2, color.new(eqhColor, eqhTransp), eqhText, "Short Segment", eqClusterSegLen, eqClusterOffset, "Dotted", eqhWidth, eqClusterShowLabels)
    ren.render_level(eqlLevel, showEqClusters and eqlCount >= 2, color.new(eqlColor, eqlTransp), eqlText, "Short Segment", eqClusterSegLen, eqClusterOffset, "Dotted", eqlWidth, eqClusterShowLabels)

// lm.format_action() moved to tv_lifecycle_mode library (lm.*)

// =====================================================================
// --- DASHBOARD 1: Trading Assistant ---
// =====================================================================
var table readTable = na
if barstate.islast
    if not na(readTable)
        table.delete(readTable)
    readTable := na

// --- Dashboard 1: Readiness Dashboard (DTO precomputation + library render) ---

if showReadiness and barstate.islast
    bool isTrader = dashMode == "Trader"
    bool isAnalyst = dashMode == "Analyst"
    bool isDebug = dashMode == "Debug"
    bool showContext = isAnalyst or isDebug
    bool showAdvanced = isDebug

    int maxR = isDebug ? 96 : isAnalyst ? 36 : 18
    readTable := table.new(fmt.resolve_pos(readinessPos), 2, maxR, bgcolor = uiBg, border_width = 1, border_color = uiBorder)

    // === PRECOMPUTE PRIMARY DISPLAY VALUES (Chapter 6: entry authority drives phase + action) ===
    string dirStr = liveSetup.isConflicted ? "◆ BOTH" : liveSetup.isPotentialLong ? "▲ LONG" : "▼ SHORT"
    color dirColor = liveSetup.isConflicted ? color.yellow : liveSetup.isPotentialLong ? uiPosColor : uiNegColor
    // Chapter 6: Phase color derives from entry authority state
    int domEADash = liveSetup.entryAuthorityDominant
    color phaseColor = liveSetup.lifecycleIsDesynced ? color.red
         : liveSetup.isConflicted ? color.yellow
         : ea.ea_is_terminal(domEADash) ? color.gray
         : domEADash == EA_ACTIVE ? uiPosColor
         : domEADash == EA_TRIGGERABLE or domEADash == EA_ARMED ? uiPosColor
         : domEADash == EA_READY ? color.orange
         : domEADash == EA_BLOCKED or domEADash == EA_LATE ? uiNegColor
         : domEADash >= EA_STRUCT_VALID ? uiNeutralColor
         : domEADash == EA_FORMING ? uiNeutralColor
         : uiLabelText
    bool domPendStale = pickLong ? (liveSetup.pendingLongActive and not liveSetup.pendingStructFreshLong) : (liveSetup.pendingShortActive and not liveSetup.pendingStructFreshShort)
    // Chapter 6: Entry authority drives action text for all states.
    // Desync and conflict override EA since they represent system-level faults.
    string actionStr = ""
    if liveSetup.lifecycleIsDesynced
        actionStr := "System desync — check diagnostics"
    else if liveSetup.isConflicted
        actionStr := "Both sides active — stand aside"
    else
        actionStr := ea.ea_action_text(domEADash, liveSetup.isPotentialLong)
    color actionColor = str.contains(actionStr, "desync") or str.contains(actionStr, "error") ? color.red : str.contains(actionStr, "triggerable") or str.contains(actionStr, "armed") or str.contains(actionStr, "Trade active") ? uiPosColor : str.contains(actionStr, "No trade") or str.contains(actionStr, "blocked") or str.contains(actionStr, "invalidated") or str.contains(actionStr, "Blocked") ? uiNegColor : str.contains(actionStr, "Stand aside") ? uiLabelText : str.contains(actionStr, "Wait") or str.contains(actionStr, "Monitor") or str.contains(actionStr, "Await") or str.contains(actionStr, "ready") ? color.orange : uiNeutralColor
    string confStr = fmt.format_confidence(liveSetup.score) + " (" + str.tostring(liveSetup.score) + ")"
    color confColor = liveSetup.score >= 70 ? uiPosColor : liveSetup.score >= 50 ? color.orange : liveSetup.score >= 30 ? uiNeutralColor : uiLabelText
    string sessStr = activeSessName + (isSilverBullet ? " (Silver Bullet)" : isKillzone ? " (Kill Zone)" : "")
    color sessColor = isSilverBullet ? uiPosColor : isKillzone ? color.orange : uiLabelText
    color pdColor = pdStatus == "Discount" ? uiPosColor : uiNegColor
    string biasStr = fmt.format_score_bias(liveSetup.scoreLong, liveSetup.scoreShort)
    string scoreStr = str.tostring(liveSetup.scoreLong) + " / " + str.tostring(liveSetup.scoreShort)
    if showContext
        scoreStr := scoreStr + "  ·  " + biasStr

    // Mode string
    string modeStr = sensitivityMode
    color modeColor = uiNeutralColor
    if liveSetup.dominantBlockedByMode
        modeStr := sensitivityMode + " — " + liveSetup.dominantModeBlockReason
        modeColor := color.orange

    // Pending — Chapter 7: opportunity-aware pending display
    bool hasPending = liveSetup.pendingLongActive or liveSetup.pendingShortActive
    string pendingStr = ""
    color pendingColor = uiLabelText
    if hasPending
        bool pendL = liveSetup.pendingLongActive
        int pendExpiry = pendL ? liveSetup.pendingLongExpiryBar : liveSetup.pendingShortExpiryBar
        int barsLeft = pendExpiry - bar_index
        string pendDir = pendL ? "LONG" : "SHORT"
        // Chapter 7: Use opportunity state to qualify pending display
        int pendOpp = pendL ? liveSetup.opp.stateLong : liveSetup.opp.stateShort
        string oppQual = pendOpp == OPP_PENDING_FRESH ? " [fresh]"
             : pendOpp == OPP_PENDING_DELAYED ? " [delayed]"
             : pendOpp == OPP_LATE_ACCEPTABLE ? " [late]"
             : pendOpp == OPP_LATE_RISKY ? " [risky]"
             : pendOpp == OPP_MISSED ? " [missed]"
             : pendOpp == OPP_STALE ? " [stale]"
             : pendOpp == OPP_BLOCKED ? " [blocked]"
             : ""
        pendingStr := pendDir + " pending (" + str.tostring(math.max(0, barsLeft)) + " bars left)" + oppQual
        pendingColor := pendOpp == OPP_PENDING_FRESH ? color.orange
             : pendOpp == OPP_PENDING_DELAYED ? #e65100
             : pendOpp == OPP_LATE_ACCEPTABLE ? #e65100
             : pendOpp == OPP_LATE_RISKY or pendOpp == OPP_MISSED or pendOpp == OPP_STALE or pendOpp == OPP_BLOCKED ? uiNegColor
             : barsLeft > 2 ? color.orange : barsLeft > 0 ? #e65100 : uiNegColor

    // Build PrimaryDisplay DTO
    rdash.PrimaryDisplay prim = rdash.PrimaryDisplay.new(
         dirStr, dirColor, liveSetup.phase, phaseColor,
         actionStr, actionColor, liveSetup.missing, uiNeutralColor,
         confStr, confColor, modeStr, modeColor,
         hasPending, pendingStr, pendingColor,
         sessStr, sessColor, pdStatus, pdColor,
         scoreStr, phaseColor,
         na(nearestBSL) ? "—" : str.tostring(nearestBSL, "#.#####") + " (" + nearestBSLName + ")", uiNegColor,
         na(nearestSSL) ? "—" : str.tostring(nearestSSL, "#.#####") + " (" + nearestSSLName + ")", uiPosColor)

    int r = rdash.render_primary(readTable, 0, prim, uiHeaderText, uiLabelText, uiNeutralColor)

    // === PRECOMPUTE CONTEXT DISPLAY VALUES ===
    bool domMssValid_ = pickLong ? liveSetup.mssValidLong : liveSetup.mssValidShort
    bool domMssStrong_ = pickLong ? liveSetup.mssStrongLong : liveSetup.mssStrongShort
    bool domMssFailed_ = pickLong ? liveSetup.mssFailedLong : liveSetup.mssFailedShort
    bool domMssDetected_ = pickLong ? liveSetup.mssDetectedLong : liveSetup.mssDetectedShort

    string liqEventStr = "No meaningful liquidity sweep yet"
    color liqEventCol = uiLabelText
    if liveSetup.isPotentialLong and sweptSSL
        liqEventStr := "Sell-side swept: " + bestSweepNameSSL + " (" + fmt.format_grade_word(bestSweepGradeSSL) + ")"
        liqEventCol := bestSweepGradeSSL == "A" ? uiPosColor : bestSweepGradeSSL == "B" ? color.orange : uiLabelText
    else if not liveSetup.isPotentialLong and sweptBSL
        liqEventStr := "Buy-side swept: " + bestSweepNameBSL + " (" + fmt.format_grade_word(bestSweepGradeBSL) + ")"
        liqEventCol := bestSweepGradeBSL == "A" ? uiPosColor : bestSweepGradeBSL == "B" ? color.orange : uiLabelText

    string structStr = "No structure shift yet"
    color structCol = uiLabelText
    if domMssFailed_
        structStr := "MSS failed — structure shift not confirmed"
        structCol := uiNegColor
    else if domMssStrong_
        structStr := (liveSetup.isPotentialLong ? "Bullish" : "Bearish") + " shift confirmed (strong)"
        structCol := uiPosColor
    else if domMssValid_
        structStr := (liveSetup.isPotentialLong ? "Bullish" : "Bearish") + " shift confirmed (valid)"
        structCol := color.orange
    else if domMssDetected_
        structStr := "Weak break — structure shift not confirmed"
        structCol := uiNeutralColor
    else if liveSetup.mssGrade != ""
        structStr := (liveSetup.isPotentialLong ? "Bullish" : "Bearish") + " shift detected (" + fmt.format_grade_word(liveSetup.mssGrade) + ")"
        structCol := liveSetup.mssGrade == "A" ? uiPosColor : color.orange

    string imbStr = "—"
    color imbCol = uiLabelText
    if liveSetup.isDegraded
        imbStr := "Imbalance zone was filled — setup weakened"
        imbCol := uiNegColor
    else if liveSetup.fvgGrade != ""
        imbStr := "Fresh " + (liveSetup.isPotentialLong ? "bullish" : "bearish") + " imbalance present (" + fmt.format_grade_word(liveSetup.fvgGrade) + ")"
        imbCol := liveSetup.fvgGrade == "A" ? uiPosColor : color.orange
    else if liveSetup.mssGrade != ""
        imbStr := "No fresh imbalance yet — waiting"
        imbCol := color.orange

    bool obConf = liveSetup.hasOBConfluence
    string obStr = obConf ? "Order block confluence present" : "No clean OB confluence"
    color obCol = obConf ? uiPosColor : uiLabelText

    bool domRclFailed = pickLong ? liveSetup.reclaimFailedLong : liveSetup.reclaimFailedShort
    bool domRclValid = pickLong ? liveSetup.reclaimValidLong : liveSetup.reclaimValidShort
    bool domRclStrong = pickLong ? liveSetup.reclaimStrongLong : liveSetup.reclaimStrongShort
    bool domRclDetected = pickLong ? liveSetup.reclaimDetectedLong : liveSetup.reclaimDetectedShort
    bool domSwept = pickLong ? sweptSSL : sweptBSL
    string rclStatusStr = domRclFailed ? "Reclaim failed — setup degraded" : domRclStrong ? "Reclaim visible — watch for structure shift" : domRclValid ? "Reclaim visible — developing" : domRclDetected ? "Early reclaim — needs confirmation" : domSwept ? "Sweep confirmed — waiting for reclaim" : "—"
    color rclStatusCol = domRclFailed ? uiNegColor : domRclStrong ? uiPosColor : domRclValid ? color.orange : domRclDetected ? uiNeutralColor : uiLabelText

    bool domDispFailed2 = pickLong ? liveSetup.disp.failedLong : liveSetup.disp.failedShort
    bool domDispStrong2 = pickLong ? liveSetup.disp.strongLong : liveSetup.disp.strongShort
    bool domDispValid2 = pickLong ? liveSetup.disp.validLong : liveSetup.disp.validShort
    bool domDispWeak2 = pickLong ? liveSetup.disp.weakLong : liveSetup.disp.weakShort
    bool domDispDetected2 = pickLong ? liveSetup.disp.detectedLong : liveSetup.disp.detectedShort
    string dispStatusStr = domDispFailed2 ? "Displacement failed — setup degraded" : domDispStrong2 ? "Strong displacement confirmed" : domDispValid2 ? "Displacement confirmed — developing" : domDispWeak2 ? "Weak push — displacement not confirmed" : domDispDetected2 ? "Push detected — awaiting confirmation" : domMssValid_ ? "MSS confirmed — waiting for displacement" : "—"
    color dispStatusCol = domDispFailed2 ? uiNegColor : domDispStrong2 ? uiPosColor : domDispValid2 ? color.orange : domDispWeak2 ? uiNeutralColor : uiLabelText

    // Strategy eligibility precomputation
    string ictLongDetail = "Long: " + (ictGateLong ? "Valid" : "Invalid") + " — " + ictGateLongInfo + (ictHasValidExternalLong ? " [ext]" : "")
    string ictShortDetail = "Short: " + (ictGateShort ? "Valid" : "Invalid") + " — " + ictGateShortInfo + (ictHasValidExternalShort ? " [ext]" : "")
    color ictCol = ictGateLong and ictGateShort ? uiPosColor : (ictGateLong or ictGateShort ? color.orange : uiNegColor)
    string sbLongDetail = "Long: " + (sbGateLong ? "Valid" : "Invalid") + " — " + sbGateLongInfo + (sbHasSessionSweepLong ? " [sess]" : "")
    string sbShortDetail = "Short: " + (sbGateShort ? "Valid" : "Invalid") + " — " + sbGateShortInfo + (sbHasSessionSweepShort ? " [sess]" : "")
    color sbCol = sbGateLong and sbGateShort ? uiPosColor : (sbGateLong or sbGateShort ? color.orange : uiNegColor)
    string contStr = "Long: " + (continuationLiquidityLong ? "Valid" : "None") + "  |  Short: " + (continuationLiquidityShort ? "Valid" : "None")
    color contCol = continuationLiquidityLong or continuationLiquidityShort ? uiNeutralColor : uiLabelText

    // Trader-mode compressed strategy
    string ictSummary = ictGateLong and ictGateShort ? "Both eligible" : ictGateLong ? "Long eligible" : ictGateShort ? "Short eligible" : "Not eligible"
    string sbSummary = sbGateLong and sbGateShort ? "Both eligible" : sbGateLong ? "Long eligible" : sbGateShort ? "Short eligible" : "Not eligible"
    string stratStr = "ICT 2022: " + ictSummary + "  |  SB: " + sbSummary
    color stratCol = (ictGateLong or ictGateShort or sbGateLong or sbGateShort) ? uiNeutralColor : uiLabelText

    rdash.ContextDisplay ctx = rdash.ContextDisplay.new(
         liqEventStr, liqEventCol, structStr, structCol, imbStr, imbCol,
         obStr, obCol, rclStatusStr, rclStatusCol, dispStatusStr, dispStatusCol,
         ictLongDetail, ictShortDetail, ictCol, sbLongDetail, sbShortDetail, sbCol,
         contStr, contCol, stratStr, stratCol)

    r := rdash.render_context(readTable, r, ctx, isTrader, uiHeaderText, uiLabelText, uiBg)
    r := rdash.render_scores(readTable, r, prim, uiLabelText, uiNegColor, uiPosColor)
    r := rdash.render_strategy(readTable, r, ctx, isTrader, uiLabelText)

    // === PRECOMPUTE ADVANCED DISPLAY (Debug only) ===
    if showAdvanced
        // --- Confluence Chain ---
        string chainStr = ""
        if liveSetup.sweepGrade != ""
            chainStr := "Sweep(" + liveSetup.sweepGrade + ")"
        if liveSetup.mssGrade != ""
            chainStr := chainStr + " → MSS(" + liveSetup.mssGrade + ")"
        if liveSetup.fvgGrade != ""
            chainStr := chainStr + " → FVG(" + liveSetup.fvgGrade + ")"
        if liveSetup.hasOBConfluence
            chainStr := chainStr + " +OB"
        if liveSetup.isDegraded
            chainStr := chainStr + " ✗MIT"
        if liveSetup.isExpired
            chainStr := chainStr + " ✗EXP"
        if chainStr == ""
            chainStr := "—"

        // --- Sequence Status ---
        string seqStr = liveSetup.isConflicted ? "Conflicted" : liveSetup.isExpired ? "Expired" : liveSetup.isDegraded ? "Degraded" : liveSetup.sequenceValid ? "Valid" : "Incomplete"
        color seqColor = liveSetup.isConflicted ? color.yellow : liveSetup.isExpired ? color.gray : liveSetup.isDegraded ? color.orange : liveSetup.sequenceValid ? uiPosColor : uiNegColor

        // --- Best Sell-Side Sweep ---
        string sslScope = bestSweepSrcSSL == SRC_ROUND_NUM ? "RN" : ((bestSweepExtSSL or liq.is_htf_liquidity_source(bestSweepSrcSSL)) ? "EXT" : "INT")
        string sslInfo = sweptSSL ? bestSweepNameSSL + " " + bestSweepGradeSSL + " [" + bestSweepTypeSSL + " · " + liq.source_category_label(bestSweepSrcSSL, "") + " · " + sslScope + (bestSweepInducementSSL ? " · IND" : "") + "]" : "None"
        color sslInfoCol = sweptSSL ? (bestSweepGradeSSL == "A" ? uiPosColor : bestSweepGradeSSL == "B" ? color.orange : uiLabelText) : uiLabelText

        // --- Best Buy-Side Sweep ---
        string bslScope = bestSweepSrcBSL == SRC_ROUND_NUM ? "RN" : ((bestSweepExtBSL or liq.is_htf_liquidity_source(bestSweepSrcBSL)) ? "EXT" : "INT")
        string bslInfo = sweptBSL ? bestSweepNameBSL + " " + bestSweepGradeBSL + " [" + bestSweepTypeBSL + " · " + liq.source_category_label(bestSweepSrcBSL, "") + " · " + bslScope + (bestSweepInducementBSL ? " · IND" : "") + "]" : "None"
        color bslInfoCol = sweptBSL ? (bestSweepGradeBSL == "A" ? uiPosColor : bestSweepGradeBSL == "B" ? color.orange : uiLabelText) : uiLabelText

        // --- Sweep Quality ---
        string sweepQualStr = "SSL: " + str.tostring(math.round(sweepQualitySSL)) + "  |  BSL: " + str.tostring(math.round(sweepQualityBSL))

        // --- EQ Clusters ---
        string eqInfo = ""
        if not na(eqhLevel)
            eqInfo := "EQH×" + str.tostring(eqhCount) + " @" + str.tostring(eqhLevel, "#.##") + " [" + str.tostring(math.round(eqhScore)) + "]"
        if not na(eqlLevel)
            eqInfo := eqInfo + (eqInfo != "" ? "  |  " : "") + "EQL×" + str.tostring(eqlCount) + " @" + str.tostring(eqlLevel, "#.##") + " [" + str.tostring(math.round(eqlScore)) + "]"
        if eqInfo == ""
            eqInfo := "—"

        // --- Ext / HTF / RN Liquidity ---
        string extLiqStr = ""
        if not na(nearestExtBSL)
            extLiqStr := "BSL: " + str.tostring(nearestExtBSL, "#.#####")
        if not na(nearestExtSSL)
            extLiqStr := extLiqStr + (extLiqStr != "" ? "  |  " : "") + "SSL: " + str.tostring(nearestExtSSL, "#.#####")
        if extLiqStr == ""
            extLiqStr := "—"

        string htfLiqStr = ""
        if not na(nearestHTFBSL)
            htfLiqStr := "BSL: " + str.tostring(nearestHTFBSL, "#.#####")
        if not na(nearestHTFSSL)
            htfLiqStr := htfLiqStr + (htfLiqStr != "" ? "  |  " : "") + "SSL: " + str.tostring(nearestHTFSSL, "#.#####")
        if htfLiqStr == ""
            htfLiqStr := "—"

        string rnLiqStr = ""
        if not na(nearestRoundBSL)
            rnLiqStr := "BSL: " + str.tostring(nearestRoundBSL, "#.#####")
        if not na(nearestRoundSSL)
            rnLiqStr := rnLiqStr + (rnLiqStr != "" ? "  |  " : "") + "SSL: " + str.tostring(nearestRoundSSL, "#.#####")
        if rnLiqStr == ""
            rnLiqStr := "—"

        rdash.AdvancedDisplay adv = rdash.AdvancedDisplay.new(
             chainStr, phaseColor,
             seqStr, seqColor,
             sslInfo, sslInfoCol,
             bslInfo, bslInfoCol,
             sweepQualStr, eqInfo,
             str.tostring(array.size(activeSweeps)),
             extLiqStr, htfLiqStr, rnLiqStr,
             uiNeutralColor)

        r := rdash.render_advanced(readTable, r, adv, uiHeaderText, uiLabelText, uiBg)

        // === PRECOMPUTE LIFECYCLE DISPLAY (Debug only) ===
        string lcStageStr = lm.lifecycle_name(liveSetup.lifecycleDominant) + " (" + str.tostring(liveSetup.lifecycleDominant) + ")"
        color lcStageCol = liveSetup.lifecycleIsDesynced ? color.red : liveSetup.lifecycleDominant >= LC_ENTRY_ARMED ? uiPosColor : liveSetup.lifecycleDominant >= LC_MSS_CONFIRMED ? color.orange : lm.lifecycle_is_terminal(liveSetup.lifecycleDominant) ? color.gray : uiNeutralColor

        string lcBothStr = "L: " + lm.lifecycle_name(liveSetup.lifecycleLong) + " (" + str.tostring(liveSetup.lifecycleLong) + ")  |  S: " + lm.lifecycle_name(liveSetup.lifecycleShort) + " (" + str.tostring(liveSetup.lifecycleShort) + ")"

        string lcActStr = "Can activate: " + (liveSetup.lifecycleCanActivateDominant ? "YES" : "NO")
        color lcActCol = liveSetup.lifecycleCanActivateDominant ? uiPosColor : uiLabelText

        string modeQualStr = "L: " + (liveSetup.longMeetsModeCandidate ? "cand" : "—") + "/" + (liveSetup.longMeetsModeActivation ? "act" : "—") + (liveSetup.longHasReclaimProxy ? "/rcl" : "") + "  |  S: " + (liveSetup.shortMeetsModeCandidate ? "cand" : "—") + "/" + (liveSetup.shortMeetsModeActivation ? "act" : "—") + (liveSetup.shortHasReclaimProxy ? "/rcl" : "")
        color modeQualCol = liveSetup.dominantMeetsModeActivation ? uiPosColor : liveSetup.dominantMeetsModeCandidate ? color.orange : uiLabelText

        string modeBlkStr = liveSetup.dominantBlockedByMode ? liveSetup.dominantModeBlockReason : "No mode block"
        color modeBlkCol = liveSetup.dominantBlockedByMode ? color.orange : uiPosColor

        string rclStageL = liveSetup.reclaimFailedLong ? "FAILED" : liveSetup.reclaimStrongLong ? "STRONG" : liveSetup.reclaimValidLong ? "VALID" : liveSetup.reclaimDetectedLong ? "WEAK" : "NONE"
        string rclStageS = liveSetup.reclaimFailedShort ? "FAILED" : liveSetup.reclaimStrongShort ? "STRONG" : liveSetup.reclaimValidShort ? "VALID" : liveSetup.reclaimDetectedShort ? "WEAK" : "NONE"
        string rclDbgStr = "L: " + rclStageL + " (" + str.tostring(math.round(liveSetup.reclaimScoreLong)) + ") " + str.tostring(liveSetup.reclaimAcceptBarsLong) + "bars  |  S: " + rclStageS + " (" + str.tostring(math.round(liveSetup.reclaimScoreShort)) + ") " + str.tostring(liveSetup.reclaimAcceptBarsShort) + "bars"
        color rclDbgCol = (liveSetup.reclaimFailedLong or liveSetup.reclaimFailedShort) ? uiNegColor : (liveSetup.reclaimValidLong or liveSetup.reclaimValidShort) ? uiPosColor : (liveSetup.reclaimDetectedLong or liveSetup.reclaimDetectedShort) ? color.orange : uiLabelText

        string rclReasonDbg = "L: " + liveSetup.reclaimStageReasonLong + "  |  S: " + liveSetup.reclaimStageReasonShort

        string extDbgStr = "L: " + (liveSetup.extensionBlockedLong ? "BLOCKED " + liveSetup.extensionReasonLong : "OK") + "  |  S: " + (liveSetup.extensionBlockedShort ? "BLOCKED " + liveSetup.extensionReasonShort : "OK")
        color extDbgCol = (liveSetup.extensionBlockedLong or liveSetup.extensionBlockedShort) ? color.orange : uiPosColor

        string mssStageL = liveSetup.mssFailedLong ? "FAILED" : liveSetup.mssStrongLong ? "STRONG" : liveSetup.mssValidLong ? "VALID" : liveSetup.mssDetectedLong ? "WEAK" : "NONE"
        string mssStageS = liveSetup.mssFailedShort ? "FAILED" : liveSetup.mssStrongShort ? "STRONG" : liveSetup.mssValidShort ? "VALID" : liveSetup.mssDetectedShort ? "WEAK" : "NONE"
        string mssDbgStr = "L: " + mssStageL + " (" + str.tostring(math.round(liveSetup.mssScoreLong)) + ") sig=" + str.tostring(liveSetup.mssTriggerSigLong) + " " + liveSetup.mssTriggerTypeLong + (liveSetup.mssBodyConfirmedLong ? " body✓" : "") + "  |  S: " + mssStageS + " (" + str.tostring(math.round(liveSetup.mssScoreShort)) + ") sig=" + str.tostring(liveSetup.mssTriggerSigShort) + " " + liveSetup.mssTriggerTypeShort + (liveSetup.mssBodyConfirmedShort ? " body✓" : "")
        color mssDbgCol = (liveSetup.mssFailedLong or liveSetup.mssFailedShort) ? uiNegColor : (liveSetup.mssValidLong or liveSetup.mssValidShort) ? uiPosColor : (liveSetup.mssDetectedLong or liveSetup.mssDetectedShort) ? color.orange : uiLabelText

        string mssReasonDbg = "L: " + liveSetup.mssReasonLong + "  |  S: " + liveSetup.mssReasonShort
        string mssPassDbg = "L: " + (liveSetup.mssQualityPassLong ? "PASS" : "FAIL") + "  |  S: " + (liveSetup.mssQualityPassShort ? "PASS" : "FAIL")
        color mssPassCol = (liveSetup.mssQualityPassLong or liveSetup.mssQualityPassShort) ? uiNeutralColor : uiLabelText

        string dispStageL = liveSetup.disp.failedLong ? "FAILED" : liveSetup.disp.strongLong ? "STRONG" : liveSetup.disp.validLong ? "VALID" : liveSetup.disp.weakLong ? "WEAK" : liveSetup.disp.detectedLong ? "DET" : "NONE"
        string dispStageS = liveSetup.disp.failedShort ? "FAILED" : liveSetup.disp.strongShort ? "STRONG" : liveSetup.disp.validShort ? "VALID" : liveSetup.disp.weakShort ? "WEAK" : liveSetup.disp.detectedShort ? "DET" : "NONE"
        string dispDbgStr = "L: " + dispStageL + " (" + str.tostring(math.round(liveSetup.disp.scoreLong)) + ") " + str.tostring(liveSetup.disp.rangeAtrLong, "#.#") + "×ATR body=" + str.tostring(math.round(liveSetup.disp.bodyDomLong * 100)) + "%" + (liveSetup.disp.hasImbalanceLong ? " FVG" : "") + (liveSetup.disp.retainedLong ? " ✓ret" : "") + "  |  S: " + dispStageS + " (" + str.tostring(math.round(liveSetup.disp.scoreShort)) + ") " + str.tostring(liveSetup.disp.rangeAtrShort, "#.#") + "×ATR body=" + str.tostring(math.round(liveSetup.disp.bodyDomShort * 100)) + "%" + (liveSetup.disp.hasImbalanceShort ? " FVG" : "") + (liveSetup.disp.retainedShort ? " ✓ret" : "")
        color dispDbgCol = (liveSetup.disp.failedLong or liveSetup.disp.failedShort) ? uiNegColor : (liveSetup.disp.validLong or liveSetup.disp.validShort) ? uiPosColor : (liveSetup.disp.detectedLong or liveSetup.disp.detectedShort) ? color.orange : uiLabelText

        string dispReasonDbg = "L: " + liveSetup.disp.reasonLong + "  |  S: " + liveSetup.disp.reasonShort
        string dispPassDbg = "L: " + (dispPassL ? "PASS" : "FAIL") + (dispPassStrongL ? " [strong]" : "") + "  |  S: " + (dispPassS ? "PASS" : "FAIL") + (dispPassStrongS ? " [strong]" : "")
        color dispPassCol = (dispPassL or dispPassS) ? uiNeutralColor : uiLabelText

        // Chapter 6: Activation path now driven by entry authority path with mode path fallback
        string actPathStr = liveSetup.entryPathDominant != EP_NONE ? ea.ep_name(liveSetup.entryPathDominant) + " (" + liveSetup.activationPathDominant + ")" : liveSetup.activationPathDominant != "" ? liveSetup.activationPathDominant : "blocked"
        color actPathCol = liveSetup.entryPathDominant == EP_IMMEDIATE ? uiPosColor : liveSetup.entryPathDominant == EP_RETRACE or liveSetup.entryPathDominant == EP_PENDING ? color.orange : liveSetup.activationPathDominant != "" ? uiNeutralColor : uiLabelText

        string freshDbgStr = "L: " + liveSetup.freshnessReasonLong + "  |  S: " + liveSetup.freshnessReasonShort
        string modeThrStr = "Min cand: " + lm.lifecycle_name(lm.mode_min_lifecycle_for_candidate(sensitivityMode)) + "  |  Min act: " + lm.lifecycle_name(lm.mode_min_lifecycle_for_activation(sensitivityMode))

        string pendDbgL = _pendingLongActive ? "ACTIVE sig=" + str.tostring(_pendingLongSignalBar) + " exp=" + str.tostring(_pendingLongExpiryBar) + " lc=" + lm.lifecycle_name(_pendingLongInitialLC) + " [" + _pendingLongMode + "]" : "—"
        string pendDbgS = _pendingShortActive ? "ACTIVE sig=" + str.tostring(_pendingShortSignalBar) + " exp=" + str.tostring(_pendingShortExpiryBar) + " lc=" + lm.lifecycle_name(_pendingShortInitialLC) + " [" + _pendingShortMode + "]" : "—"
        color pendDbgLCol = _pendingLongActive ? color.orange : uiLabelText
        color pendDbgSCol = _pendingShortActive ? color.orange : uiLabelText

        string pendWinStr = "AGG=" + str.tostring(lm.mode_pending_activation_bars("Aggressive")) + "  BAL=" + str.tostring(lm.mode_pending_activation_bars("Balanced")) + "  CON=" + str.tostring(lm.mode_pending_activation_bars("Conservative")) + "  (current: " + str.tostring(lm.mode_pending_activation_bars(sensitivityMode)) + ")"

        string delayActStr = liveSetup.pendingLongActivatedThisBar ? "LONG activated via delayed" : liveSetup.pendingShortActivatedThisBar ? "SHORT activated via delayed" : "No delayed activation"
        color delayActCol = (liveSetup.pendingLongActivatedThisBar or liveSetup.pendingShortActivatedThisBar) ? uiPosColor : uiLabelText

        string desyncStr = liveSetup.lifecycleIsDesynced ? "DESYNC: " + liveSetup.lifecycleDesyncReason : "OK — no invariant violations"
        color desyncCol = liveSetup.lifecycleIsDesynced ? color.red : uiPosColor

        // --- Rejection Cause ---
        string rejCause = "none"
        bool domSide = pickLong
        int domLc = domSide ? liveSetup.lifecycleLong : liveSetup.lifecycleShort
        if domLc >= LC_MSS_CONFIRMED and not (domSide ? modeActL : modeActS)
            bool rclBlk = not (domSide ? rclPassL : rclPassS)
            bool mssBlk = not (domSide ? mssQPassL : mssQPassS)
            bool dispBlk = not (domSide ? dispPassL : dispPassS)
            bool extBlk = domSide ? extBlockL : extBlockS
            bool dispFailBlk = domSide ? dispFailedL2 : dispFailedS2
            if rclBlk
                rejCause := "reclaim"
            else if mssBlk
                rejCause := "MSS quality"
            else if dispFailBlk
                rejCause := "disp failed"
            else if dispBlk
                rejCause := "disp quality"
            else if extBlk
                rejCause := "extension"
            else
                rejCause := "lifecycle/bridge"
        else if domLc < LC_MSS_CONFIRMED
            rejCause := domLc <= LC_SWEEP_CONFIRMED ? "pre-MSS" : "min lifecycle"
        color rejCol = rejCause == "none" ? uiPosColor : color.orange

        // Chapter 6: Entry Authority debug precomputation
        string eaStateDbg = ea.ea_name(liveSetup.entryAuthorityDominant) + " (" + str.tostring(liveSetup.entryAuthorityDominant) + ")"
        color eaStateDbgCol = liveSetup.entryAuthorityDominant == EA_TRIGGERABLE or liveSetup.entryAuthorityDominant == EA_ARMED ? uiPosColor : liveSetup.entryAuthorityDominant == EA_ACTIVE ? uiPosColor : liveSetup.entryAuthorityDominant == EA_READY ? color.orange : liveSetup.entryAuthorityDominant == EA_BLOCKED or liveSetup.entryAuthorityDominant == EA_LATE ? uiNegColor : ea.ea_is_terminal(liveSetup.entryAuthorityDominant) ? color.gray : uiNeutralColor
        string eaBothDbg = "L: " + ea.ea_name(liveSetup.entryAuthorityLong) + " (" + str.tostring(liveSetup.entryAuthorityLong) + ")  |  S: " + ea.ea_name(liveSetup.entryAuthorityShort) + " (" + str.tostring(liveSetup.entryAuthorityShort) + ")"
        string eaPathDbg = ea.ep_name(liveSetup.entryPathDominant)
        color eaPathDbgCol = liveSetup.entryPathDominant == EP_IMMEDIATE ? uiPosColor : liveSetup.entryPathDominant == EP_RETRACE ? color.orange : liveSetup.entryPathDominant == EP_PENDING ? uiNeutralColor : uiLabelText
        string eaBlockDbg = liveSetup.blockCategoryDominant != EB_NONE ? ea.eb_name(liveSetup.blockCategoryDominant) : "None"
        color eaBlockDbgCol = liveSetup.blockCategoryDominant != EB_NONE ? color.orange : uiPosColor
        string eaReasonDbg = liveSetup.entryReasonDominant
        string eaStructDbg = "L: " + (liveSetup.structurallyValidLong ? "VALID" : "—") + "  |  S: " + (liveSetup.structurallyValidShort ? "VALID" : "—")
        color eaStructDbgCol = (liveSetup.structurallyValidLong or liveSetup.structurallyValidShort) ? uiPosColor : uiLabelText

        // Chapter 7: Opportunity State debug precomputation (uses canonical dominant fields)
        int domOppDbg = liveSetup.opp.stateDom
        string oppStateDbg = pts.opp_name(domOppDbg) + " (" + str.tostring(domOppDbg) + ")" + " [" + liveSetup.opp.timingDom + "]"
        color oppStateDbgCol = domOppDbg == OPP_READY or domOppDbg == OPP_FRESH ? uiPosColor
             : domOppDbg == OPP_ACTIVE ? uiPosColor
             : domOppDbg == OPP_PENDING_FRESH ? color.orange
             : domOppDbg == OPP_PENDING_DELAYED ? color.orange
             : domOppDbg == OPP_LATE_ACCEPTABLE ? #e65100
             : domOppDbg == OPP_LATE_RISKY or domOppDbg == OPP_MISSED ? uiNegColor
             : domOppDbg == OPP_STALE or domOppDbg == OPP_EXPIRED or domOppDbg == OPP_INVALIDATED ? color.gray
             : domOppDbg == OPP_BLOCKED ? uiNegColor
             : domOppDbg == OPP_COMPLETE ? uiLabelText
             : uiNeutralColor
        string oppBothDbg = "L: " + pts.opp_name(liveSetup.opp.stateLong) + " (" + str.tostring(liveSetup.opp.stateLong) + ")  |  S: " + pts.opp_name(liveSetup.opp.stateShort) + " (" + str.tostring(liveSetup.opp.stateShort) + ")"
        string oppReasonDbg = liveSetup.opp.reasonDom
        string oppChaseDbg = "L: " + (liveSetup.opp.chaseLong ? "YES" : "NO") + "  |  S: " + (liveSetup.opp.chaseShort ? "YES" : "NO") + "  |  Dom: " + (liveSetup.opp.chaseDom ? "YES" : "NO")
        color oppChaseDbgCol = liveSetup.opp.chaseDom ? uiPosColor : uiNegColor

        rdash.LifecycleDisplay lcDisp = rdash.LifecycleDisplay.new(
             lcStageStr, lcStageCol,
             liveSetup.lifecycleReasonDominant,
             lcBothStr, lcActStr, lcActCol,
             modeQualStr, modeQualCol,
             modeBlkStr, modeBlkCol,
             rclDbgStr, rclDbgCol, rclReasonDbg,
             extDbgStr, extDbgCol,
             mssDbgStr, mssDbgCol, mssReasonDbg,
             mssPassDbg, mssPassCol,
             dispDbgStr, dispDbgCol, dispReasonDbg,
             dispPassDbg, dispPassCol,
             actPathStr, actPathCol,
             freshDbgStr, modeThrStr,
             pendDbgL, pendDbgLCol,
             pendDbgS, pendDbgSCol,
             pendWinStr,
             delayActStr, delayActCol,
             desyncStr, desyncCol,
             rejCause, rejCol,
             eaStateDbg, eaStateDbgCol,
             eaBothDbg,
             eaPathDbg, eaPathDbgCol,
             eaBlockDbg, eaBlockDbgCol,
             eaReasonDbg,
             eaStructDbg, eaStructDbgCol,
             oppStateDbg, oppStateDbgCol,
             oppBothDbg, oppReasonDbg,
             oppChaseDbg, oppChaseDbgCol,
             uiValueText, uiNeutralColor)

        r := rdash.render_lifecycle(readTable, r, lcDisp, uiHeaderText, uiLabelText, uiBg)

    // === PERFORMANCE SECTION ===
    float wr = mainStats.totalTrades > 0 ? (float(mainStats.wins) / mainStats.totalTrades) * 100 : 0
    rdash.PerfDisplay perf = rdash.PerfDisplay.new(
         str.format("{0,number,#.##}%", wr), wr >= 50 ? uiPosColor : uiNegColor,
         str.tostring(mainStats.totalTrades),
         str.tostring(mainStats.wins) + " / " + str.tostring(mainStats.losses),
         str.format("{0,number,#.##}R", mainStats.totalR), mainStats.totalR >= 0 ? uiPosColor : uiNegColor,
         str.format("{0,number,#.##}R", mainStats.equityR), mainStats.equityR >= 0 ? uiPosColor : uiNegColor,
         str.format("{0,number,#.##}R", mainStats.maxDrawdownR), mainStats.maxDrawdownR < 0 ? uiNegColor : uiLabelText,
         uiValueText, uiLabelText)

    r := rdash.render_performance(readTable, r, perf, showContext, uiHeaderText, uiBg)

// =====================================================================
// --- DASHBOARD 2: Market Intelligence (MTF Trend + Alerts + OB Scanner) ---
// =====================================================================
int intelRows = 1 + 4 + 1 + 1 + maxAlertRows + 1 + 1 + maxScannerRows
var table marketIntelTable = table.new(fmt.resolve_pos(marketIntelPos), 3, intelRows, bgcolor = uiBg, border_width = 1, border_color = uiBorder)

if showMarketIntelDash and barstate.islast
    // Precompute trend data
    bool htf1Bull = htf1Price > htf1Ema
    bool htf2Bull = htf2Price > htf2Ema
    bool curBull = close > emaBias
    int trendScore = (htf1Bull ? 1 : 0) + (htf2Bull ? 1 : 0) + (curBull ? 1 : 0)
    string alignment = trendScore == 3 ? "Strong Bullish" : trendScore == 0 ? "Strong Bearish" : trendScore == 2 ? "Bullish Alignment" : "Bearish Alignment"
    color alignCol = trendScore >= 2 ? uiPosColor : (trendScore == 0 ? uiNegColor : uiNeutralColor)

    // Build AlertEntry array from alertLogs
    intel.AlertEntry[] alertEntries = array.new<intel.AlertEntry>()
    if array.size(alertLogs) > 0
        for i = 0 to array.size(alertLogs) - 1
            T.AlertLog al =array.get(alertLogs, i)
            array.push(alertEntries, intel.AlertEntry.new(al.timeStr, al.signalType, al.price, al.col))

    // Build OBEntry array from obArray
    intel.OBEntry[] obEntries = array.new<intel.OBEntry>()
    if array.size(obArray) > 0
        for i = array.size(obArray) - 1 to 0
            T.SmartZone szOb = array.get(obArray, i)
            if not szOb.mitigated
                color c = szOb.isBull ? uiPosColor : uiNegColor
                string t = szOb.isBull ? "BULL" : "BEAR"
                string p = str.format("{0,number,#.##}-{1,number,#.##}", szOb.bottom, szOb.top)
                string a = str.tostring(bar_index - szOb.startBar) + " bars"
                array.push(obEntries, intel.OBEntry.new(t, c, p, a))

    intel.render_market_intel(marketIntelTable,
         uiHeaderText, uiLabelText, uiValueText, uiBg,
         uiPosColor, uiNegColor,
         alignment, alignCol,
         trendHTF2, htf2Bull, trendHTF1, htf1Bull,
         timeframe.period, curBull,
         alertEntries, maxAlertRows,
         obEntries, maxScannerRows)

// --- Candidate Preview ---
var box candTp = na
var box candSl = na
var label candLbl = na


// --- Candidate Preview (split: gating in main, rendering via library) ---
update_candidate_preview(SetupState s, bool pickLong, bool dominantLiquidityBlocked, box cTpIn, box cSlIn, label cLblIn) =>
    box cTp = cTpIn
    box cSl = cSlIn
    label cLbl = cLblIn

    // === GATING LOGIC (proprietary — stays in main) ===
    bool hasPendingCandidate = (s.pendingLongActive and s.pendingLongCanStillActivate) or (s.pendingShortActive and s.pendingShortCanStillActivate)
    bool domExtended = pickLong ? s.extensionBlockedLong : s.extensionBlockedShort
    bool domPendingStale = pickLong ? (s.pendingLongActive and not s.pendingStructFreshLong) : (s.pendingShortActive and not s.pendingStructFreshShort)
    bool domReclaimFailed = pickLong ? s.reclaimFailedLong : s.reclaimFailedShort
    bool domMssFailed = pickLong ? s.mssFailedLong : s.mssFailedShort
    bool domMssStale = pickLong ? (not s.mssFreshLong) : (not s.mssFreshShort)
    bool domDispFailed = pickLong ? s.disp.failedLong : s.disp.failedShort
    bool domDispWeak = pickLong ? s.disp.weakLong : s.disp.weakShort
    bool domDispStale = pickLong ? (not s.disp.freshLong) : (not s.disp.freshShort)
    bool qualityPreviewOk = not domExtended and not domPendingStale and not domReclaimFailed and not domMssFailed and not domMssStale and not domDispFailed and not domDispStale

    // Chapter 6: Entry authority must permit preview — terminal, blocked (structural), or NONE/FORMING states suppress it
    int domEAPreview = s.entryAuthorityDominant
    bool eaPermitsPreview = not ea.ea_is_terminal(domEAPreview) and domEAPreview != EA_NONE and domEAPreview != EA_BLOCKED

    // Chapter 7: Suppress preview when opportunity is clearly gone or blocked
    // Uses canonical dominant opportunity state (set after invariant corrections).
    bool oppPermitsPreview = not pts.opp_is_chase_forbidden(s.opp.stateDom) and s.opp.stateDom != OPP_COMPLETE

    bool showPreview = showSetups and showCandidatePreview and (s.dominantMeetsModeCandidate or hasPendingCandidate) and qualityPreviewOk and eaPermitsPreview and oppPermitsPreview and na(activeTrade) and not s.isConflicted and not dominantLiquidityBlocked and not s.lifecycleIsDesynced

    if showPreview
        // === COMPUTE RENDERING PARAMETERS (proprietary decisions) ===
        float projRisk = atr * 1.5
        float entry = close
        bool isLongCandidate = s.isPotentialLong
        float sl = isLongCandidate ? entry - projRisk : entry + projRisk
        float tp = isLongCandidate ? entry + projRisk * 2.0 : entry - projRisk * 2.0
        int width = activeSetupSize == "Large" ? activeMinWidth * 2 : activeSetupSize == "Normal" ? activeMinWidth : 10
        color candTpCol = isLongCandidate ? longTpColor : shortTpColor
        color candSlCol = isLongCandidate ? longSlColor : shortSlColor
        string pendSuffix = hasPendingCandidate and not s.dominantMeetsModeCandidate ? " [PENDING]" : ""

        // === RENDERING (delegated to library) ===
        [cTp2, cSl2, cLbl2] = ren.draw_preview(cTp, cSl, cLbl, isLongCandidate, entry, sl, tp, width, s.score, s.sequenceValid, pendSuffix, candTpCol, candSlCol, setupLabelColor, activeTransp, activeBorderWidth)
        cTp := cTp2
        cSl := cSl2
        cLbl := cLbl2
    else
        // === CLEAR (delegated to library) ===
        [cTp2, cSl2, cLbl2] = ren.clear_preview(cTp, cSl, cLbl)
        cTp := cTp2
        cSl := cSl2
        cLbl := cLbl2
    [cTp, cSl, cLbl]

if barstate.islast
    [candTp2, candSl2, candLbl2] = update_candidate_preview(liveSetup, pickLong, dominantLiquidityBlocked, candTp, candSl, candLbl)
    candTp := candTp2
    candSl := candSl2
    candLbl := candLbl2
// --- Alerts ---
bool alertBuy = sig2022B or sigSBB
bool alertSell = sig2022S or sigSBS
alertcondition(alertBuy, "Buy Signal", "ICT/SMC Buy Setup Confirmed")
alertcondition(alertSell, "Sell Signal", "ICT/SMC Sell Setup Confirmed")

// --- Visual Shapes ---
plotshape(showLabels and isSignalB, "Buy Signal", shape.labelup, location.belowbar, BULL_COLOR, text="BUY", textcolor=color.white, size = size.small)
plotshape(showLabels and isSignalS, "Sell Signal", shape.labeldown, location.abovebar, BEAR_COLOR, text="SELL", textcolor=color.white, size = size.small)
