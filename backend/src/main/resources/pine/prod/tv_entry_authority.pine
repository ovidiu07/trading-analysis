//@version=6
// @description Entry Authority Model (Chapter 6): pure evaluator that classifies setup tradability.
// Separates structural validity from execution readiness from actual entry authorization.
// All functions are pure — they use only parameters, no persistent state.
library("tv_entry_authority", overlay = true)

import Devtailor/tv_core_types/4 as T

// --- Constants: Lifecycle ---
int LC_NONE                   = T.LC_NONE()
int LC_LIQUIDITY_IDENTIFIED   = T.LC_LIQUIDITY_IDENTIFIED()
int LC_SWEEP_CONFIRMED        = T.LC_SWEEP_CONFIRMED()
int LC_RECLAIM_VISIBLE        = T.LC_RECLAIM_VISIBLE()
int LC_MSS_CONFIRMED          = T.LC_MSS_CONFIRMED()
int LC_DISPLACEMENT_CONFIRMED = T.LC_DISPLACEMENT_CONFIRMED()
int LC_ENTRY_ARMED            = T.LC_ENTRY_ARMED()
int LC_ENTRY_TRIGGERED        = T.LC_ENTRY_TRIGGERED()
int LC_ACTIVE                 = T.LC_ACTIVE()
int LC_EXPIRED                = T.LC_EXPIRED()
int LC_INVALIDATED            = T.LC_INVALIDATED()
int LC_DESYNC                 = T.LC_DESYNC()

// --- Constants: Entry Authority (EA) ---
int EA_NONE                   = 0
int EA_FORMING                = 1
int EA_STRUCT_VALID           = 2
int EA_READY                  = 3
int EA_ARMED                  = 4
int EA_TRIGGERABLE            = 5
int EA_PENDING_RETRACE        = 6
int EA_PENDING_CONFIRMATION   = 7
int EA_BLOCKED                = 8
int EA_LATE                   = 9
int EA_EXPIRED                = 10
int EA_INVALIDATED            = 11
int EA_ACTIVE                 = 12

// --- Constants: Entry Path (EP) ---
int EP_NONE                   = 0
int EP_IMMEDIATE              = 1
int EP_RETRACE                = 2
int EP_PENDING                = 3

// --- Constants: Entry Block (EB) ---
int EB_NONE                   = 0
int EB_MODE_QUALITY           = 1
int EB_GATE_STRATEGY          = 2
int EB_EXTENSION              = 3
int EB_FRESHNESS              = 4
int EB_RECLAIM_FAILED         = 5
int EB_MSS_FAILED             = 6
int EB_DISP_FAILED            = 7
int EB_CONFLICTED             = 8
int EB_ACTIVE_TRADE           = 9

// =====================================================================
// NAME LOOKUPS
// =====================================================================

// Human-readable name for an entry authority state.
export ea_name(int ea) =>
    ea == EA_NONE ? "No setup"
     : ea == EA_FORMING ? "Setup forming"
     : ea == EA_STRUCT_VALID ? "Structurally valid"
     : ea == EA_READY ? "Execution ready"
     : ea == EA_ARMED ? "Entry armed"
     : ea == EA_TRIGGERABLE ? "Entry triggerable"
     : ea == EA_PENDING_RETRACE ? "Pending retrace"
     : ea == EA_PENDING_CONFIRMATION ? "Pending confirmation"
     : ea == EA_BLOCKED ? "Blocked"
     : ea == EA_LATE ? "Late / degraded"
     : ea == EA_EXPIRED ? "Expired"
     : ea == EA_INVALIDATED ? "Invalidated"
     : ea == EA_ACTIVE ? "Trade active"
     : "Unknown"

// Human-readable name for an entry path type.
export ep_name(int ep) =>
    ep == EP_NONE ? "None"
     : ep == EP_IMMEDIATE ? "Immediate"
     : ep == EP_RETRACE ? "Retrace"
     : ep == EP_PENDING ? "Pending"
     : "Unknown"

// Human-readable name for a block category.
export eb_name(int eb) =>
    eb == EB_NONE ? "None"
     : eb == EB_MODE_QUALITY ? "Mode quality"
     : eb == EB_GATE_STRATEGY ? "Strategy gate"
     : eb == EB_EXTENSION ? "Extended"
     : eb == EB_FRESHNESS ? "Stale"
     : eb == EB_RECLAIM_FAILED ? "Reclaim failed"
     : eb == EB_MSS_FAILED ? "MSS failed"
     : eb == EB_DISP_FAILED ? "Displacement failed"
     : eb == EB_CONFLICTED ? "Conflicted"
     : eb == EB_ACTIVE_TRADE ? "Active trade"
     : "Unknown"

// Action guidance derived from entry authority state.
export ea_action_text(int ea, bool isLong) =>
    string side = isLong ? "long" : "short"
    ea == EA_NONE ? "Stand aside — no setup"
     : ea == EA_FORMING ? "Monitor — setup forming"
     : ea == EA_STRUCT_VALID ? "Setup valid — not yet execution-ready"
     : ea == EA_READY ? "Execution ready — monitor for trigger"
     : ea == EA_ARMED ? "Entry armed — watch trigger zone"
     : ea == EA_TRIGGERABLE ? "Entry triggerable — validate " + side + " activation"
     : ea == EA_PENDING_RETRACE ? "Await retrace entry for " + side
     : ea == EA_PENDING_CONFIRMATION ? "Await confirmation for " + side
     : ea == EA_BLOCKED ? "Setup blocked — check eligibility"
     : ea == EA_LATE ? "Setup late — reduced conviction"
     : ea == EA_EXPIRED ? "No trade — setup expired"
     : ea == EA_INVALIDATED ? "No trade — setup invalidated"
     : ea == EA_ACTIVE ? "Trade active — manage " + side + " position"
     : "Unknown state"

// =====================================================================
// HELPERS
// =====================================================================

export ea_allows_activation(int ea) =>
    ea == EA_TRIGGERABLE or ea == EA_ACTIVE

export ea_allows_pending(int ea) =>
    ea == EA_PENDING_RETRACE or ea == EA_PENDING_CONFIRMATION or ea == EA_ARMED or ea == EA_READY

export ea_is_structurally_valid(int ea) =>
    ea >= EA_STRUCT_VALID and ea <= EA_LATE

export ea_is_terminal(int ea) =>
    ea == EA_EXPIRED or ea == EA_INVALIDATED

// =====================================================================
// INTERNAL EVALUATOR PHASES
// =====================================================================

// Phase 1: Overrides & Terminal Constraints
_eval_phase_overrides(bool hasActiveTrade, bool isConflicted, int lifecycle) =>
    int ea = EA_NONE
    int eb = EB_NONE
    string res = ""
    bool active = false

    if hasActiveTrade
        ea := EA_ACTIVE
        eb := EB_NONE
        res := "Trade active"
        active := true
    else if isConflicted
        ea := EA_BLOCKED
        eb := EB_CONFLICTED
        res := "Both sides active — conflicted"
        active := true
    else if lifecycle == LC_DESYNC
        ea := EA_INVALIDATED
        eb := EB_NONE
        res := "State desync — authority suspended"
        active := true

    [ea, eb, res, active]

// Phase 2: Structural Failures & Expiry
_eval_phase_failures(bool expired, bool degraded, bool mssFailed, bool reclaimFailed, bool dispFailed) =>
    int ea = EA_NONE
    int eb = EB_NONE
    string res = ""
    bool active = false

    if expired
        ea := EA_EXPIRED
        res := "Setup expired"
        active := true
    else if degraded
        ea := EA_INVALIDATED
        res := "Setup degraded — imbalance filled"
        active := true
    else if mssFailed
        ea := EA_INVALIDATED
        eb := EB_MSS_FAILED
        res := "MSS failed — structure lost"
        active := true
    else if reclaimFailed
        ea := EA_INVALIDATED
        eb := EB_RECLAIM_FAILED
        res := "Reclaim failed — recovery lost"
        active := true
    else if dispFailed
        ea := EA_INVALIDATED
        eb := EB_DISP_FAILED
        res := "Displacement failed — commitment lost"
        active := true

    [ea, eb, res, active]

// Phase 3: Readiness & Blocked States
_eval_phase_readiness(int lifecycle, bool mssValid, string mode, bool modeCandidate, bool modeActivation, string modeBlockReason,
     bool gateBlocked, string gateBlockReason, bool isExtended, bool mssFresh, bool dispFresh, bool reclaimPass, bool dispValid) =>
    int ea = EA_NONE
    int eb = EB_NONE
    string res = ""
    bool active = false

    // Forming states (early lifecycle)
    if lifecycle <= LC_LIQUIDITY_IDENTIFIED
        ea := (lifecycle == LC_NONE ? EA_NONE : EA_FORMING)
        res := (lifecycle == LC_NONE ? "No setup context" : "Liquidity identified, awaiting sweep")
        active := true
    else if (lifecycle == LC_SWEEP_CONFIRMED or lifecycle == LC_RECLAIM_VISIBLE) and not mssValid
        ea := EA_FORMING
        res := "Awaiting structure shift"
        active := true

    // Readiness blocks
    else if not mssFresh
        ea := EA_LATE
        eb := EB_FRESHNESS
        res := "MSS stale — structure aged out"
        active := true
    else if not dispFresh and (lifecycle >= LC_DISPLACEMENT_CONFIRMED or dispValid)
        ea := EA_LATE
        eb := EB_FRESHNESS
        res := "Displacement stale — commitment aged out"
        active := true
    else if isExtended and mode != "Aggressive"
        ea := EA_BLOCKED
        eb := EB_EXTENSION
        res := "Price too extended from anchor"
        active := true
    else if gateBlocked and not modeActivation
        ea := EA_BLOCKED
        eb := EB_GATE_STRATEGY
        res := "Strategy gate: " + gateBlockReason
        active := true
    else if not reclaimPass
        ea := EA_BLOCKED
        eb := EB_MODE_QUALITY
        res := "Reclaim quality insufficient"
        active := true
    else if not modeCandidate
        ea := EA_STRUCT_VALID
        res := mode + " mode: minimum lifecycle not met"
        active := true
    else if not modeActivation
        if lifecycle >= LC_DISPLACEMENT_CONFIRMED or dispValid
            ea := EA_BLOCKED
            eb := EB_MODE_QUALITY
            res := (modeBlockReason != "" ? modeBlockReason : mode + " quality not met")
            active := true
        else
            ea := EA_STRUCT_VALID
            res := "Awaiting structural progression"
            active := true

    [ea, eb, res, active]

// Phase 4: Activation & Classification
_eval_phase_activation(bool hasSignalThisBar, bool modeAllowsDirect, int lifecycle, bool modeActivation,
     bool hasPendingStored, bool pendingCanActivate, bool pendingFresh, bool pendingExpired,
     bool seqOk, bool swept, bool mssValid, bool modeCandidate, string mode, bool isExtended, bool dispValid) =>
    int ea = EA_FORMING
    int ep = EP_NONE
    int eb = EB_NONE
    string res = "Setup developing"

    if hasSignalThisBar and modeAllowsDirect and (lifecycle >= LC_ENTRY_TRIGGERED or modeActivation)
        ea := EA_TRIGGERABLE
        ep := EP_IMMEDIATE
        res := "Entry triggerable — immediate"
    else if hasPendingStored and pendingCanActivate
        ea := EA_TRIGGERABLE
        ep := EP_RETRACE
        res := "Entry triggerable — delayed"
    else if hasSignalThisBar and not modeAllowsDirect
        ep := EP_PENDING
        if modeActivation
            ea := EA_PENDING_RETRACE
            res := mode + ": signal stored, awaiting retrace"
        else
            ea := EA_PENDING_CONFIRMATION
            res := mode + ": signal stored, awaiting confirmation"
    else if hasPendingStored and not pendingExpired
        if pendingFresh
            ea := EA_PENDING_RETRACE
            ep := EP_PENDING
            res := "Pending active — awaiting retrace"
        else
            ea := EA_LATE
            ep := EP_PENDING
            eb := EB_FRESHNESS
            res := "Pending structurally stale"
    else if hasPendingStored and pendingExpired
        ea := EA_EXPIRED
        res := "Pending window expired"
    else if seqOk and swept and mssValid and lifecycle >= LC_ENTRY_ARMED
        ea := EA_ARMED
        ep := (modeAllowsDirect ? EP_IMMEDIATE : EP_RETRACE)
        res := "Entry armed — monitor trigger"
    else if modeActivation and (lifecycle >= LC_DISPLACEMENT_CONFIRMED or dispValid)
        ea := EA_READY
        ep := (modeAllowsDirect ? EP_IMMEDIATE : EP_RETRACE)
        res := "Execution ready — awaiting zone"
    else if modeCandidate
        ea := EA_STRUCT_VALID
        res := "Structurally valid — awaiting readiness"

    // Late/Extended check for non-blocked aggressive setups
    if ea >= EA_READY and ea <= EA_ARMED and isExtended and mode == "Aggressive"
        ea := EA_LATE
        eb := EB_EXTENSION
        res := "AGG: extended but structurally valid"

    [ea, ep, eb, res]

// =====================================================================
// EXPORTED EVALUATORS
// =====================================================================

// Layer A: Structural Validity Assessment
export assess_structural_validity(int lifecycle, bool seqOk, bool swept, bool mssValid_,
     bool mssFailed_, bool reclaimDetected_, bool reclaimFailed_,
     bool dispValid_, bool dispFailed_, bool expired_, bool degraded_) =>
    bool valid = false
    string reason = ""
    if lifecycle == LC_DESYNC
        reason := "State desync"
    else if expired_
        reason := "Setup expired"
    else if degraded_
        reason := "Setup degraded"
    else if mssFailed_
        reason := "MSS failed"
    else if reclaimFailed_
        reason := "Reclaim failed"
    else if dispFailed_
        reason := "Displacement failed"
    else if seqOk and mssValid_
        valid := true
        reason := "Full sequence valid"
    else if swept and mssValid_ and dispValid_
        valid := true
        reason := "Chain valid"
    else if swept and mssValid_
        valid := true
        reason := "Partial: Sweep → MSS confirmed"
    else if swept and reclaimDetected_ and not reclaimFailed_
        reason := "Developing: Sweep → Reclaim visible"
    else if swept
        reason := "Sweep confirmed, awaiting structure"
    else if lifecycle == LC_LIQUIDITY_IDENTIFIED
        reason := "Liquidity identified"
    else
        reason := "No structural context"
    [valid, reason]

// Layer B: Execution Readiness Assessment
export assess_execution_readiness(bool structValid, string mode,
     bool modeCandidate, bool modeActivation,
     bool reclaimPass_, bool mssFresh_, bool dispFresh_,
     bool isExtended_, bool pendingFresh_,
     bool gateBlocked_, string gateBlockReason_) =>
    bool ready = false
    string reason = ""
    if not structValid
        reason := "Not structurally valid"
    else if gateBlocked_
        reason := "Gate blocked: " + gateBlockReason_
    else if isExtended_
        reason := "Price too extended"
    else if not mssFresh_
        reason := "MSS stale"
    else if not dispFresh_
        reason := "Displacement stale"
    else if not reclaimPass_
        reason := "Reclaim quality low"
    else if not modeCandidate
        reason := mode + " candidate reqs not met"
    else if not modeActivation
        reason := mode + " activation reqs not met"
    else if not pendingFresh_
        reason := "Pending stale"
    else
        ready := true
        reason := "Execution ready"
    [ready, reason]

// Layer C: Central Evaluator (Orchestrator)
export evaluate_entry_authority(
     int lifecycle, bool seqOk, bool swept,
     bool mssValid_, bool mssFailed_, bool mssFresh_,
     bool reclaimFailed_, bool reclaimPass_,
     bool dispValid_, bool dispFailed_, bool dispFresh_,
     bool expired_, bool degraded_,
     string mode, bool modeCandidate, bool modeActivation, string modeBlockReason_,
     bool modeAllowsDirect,
     bool gateBlocked_, string gateBlockReason_,
     bool isExtended_, bool pendingFresh_,
     bool hasSignalThisBar, bool isConflicted_,
     bool hasPendingStored, bool pendingCanActivate, bool pendingExpired_,
     bool hasActiveTrade) =>

    // Result placeholders
    int finalEA = EA_NONE
    int finalEP = EP_NONE
    int finalEB = EB_NONE
    string finalRes = ""
    bool finalSV = false

    // Phase 1: Overrides
    [ea1, eb1, res1, active1] = _eval_phase_overrides(hasActiveTrade, isConflicted_, lifecycle)
    if active1
        finalEA := ea1, finalEP := EP_NONE, finalEB := eb1, finalRes := res1, finalSV := false
    else
        // Phase 2: Structural Failures
        [ea2, eb2, res2, active2] = _eval_phase_failures(expired_, degraded_, mssFailed_, reclaimFailed_, dispFailed_)
        if active2
            finalEA := ea2, finalEP := EP_NONE, finalEB := eb2, finalRes := res2, finalSV := false
        else
            // Phase 3: Readiness & Blocks
            [ea3, eb3, res3, active3] = _eval_phase_readiness(lifecycle, mssValid_, mode, modeCandidate, modeActivation, modeBlockReason_,
                                         gateBlocked_, gateBlockReason_, isExtended_, mssFresh_, dispFresh_, reclaimPass_, dispValid_)
            if active3
                finalEA := ea3, finalEP := EP_NONE, finalEB := eb3, finalRes := res3, finalSV := true
            else
                // Phase 4: Activation Logic
                [ea4, ep4, eb4, res4] = _eval_phase_activation(hasSignalThisBar, modeAllowsDirect, lifecycle, modeActivation,
                                             hasPendingStored, pendingCanActivate, pendingFresh_, pendingExpired_,
                                             seqOk, swept, mssValid_, modeCandidate, mode, isExtended_, dispValid_)
                finalEA := ea4, finalEP := ep4, finalEB := eb4, finalRes := res4, finalSV := true

    [finalEA, finalEP, finalEB, finalRes, finalSV]

// Layer D: Active Trade Promotion Guard
export can_promote_to_active(int entryState, int entryPath, bool hasActiveTrade) =>
    not hasActiveTrade and entryState == EA_TRIGGERABLE and (entryPath == EP_IMMEDIATE or entryPath == EP_RETRACE)

// =====================================================================
// INVARIANT VALIDATION
// =====================================================================

export validate_entry_authority(int ea, int ep, int eb, int lifecycle,
     bool hasActiveTrade, bool modeActivation, bool modeCandidate,
     bool mssFailed_, bool reclaimFailed_, bool dispFailed_,
     bool expired_, bool isConflicted_) =>
    bool valid = true
    string reason = ""

    // 1. Trade Sync
    if ea == EA_ACTIVE and not hasActiveTrade
        valid := false
        reason := "EA_ACTIVE without active trade"
    else if hasActiveTrade and ea != EA_ACTIVE
        valid := false
        reason := "Trade active but EA=" + ea_name(ea)

    // 2. Path Integrity & Capability
    else if (ea == EA_PENDING_RETRACE or ea == EA_PENDING_CONFIRMATION) and ep == EP_NONE
        valid := false
        reason := "Pending state requires valid EP"
    else if (ea == EA_READY or ea == EA_ARMED) and ep == EP_NONE
        valid := false
        reason := "Execution-ready state requires valid EP"
    else if ea == EA_TRIGGERABLE and (ep != EP_IMMEDIATE and ep != EP_RETRACE)
        valid := false
        reason := "EA_TRIGGERABLE requires activation path"

    // 3. Activation Guard for Blocks/Expiries
    else if (ea == EA_BLOCKED or ea == EA_LATE or ea == EA_EXPIRED or ea == EA_INVALIDATED) and (ep == EP_IMMEDIATE or ep == EP_RETRACE)
        valid := false
        reason := "Blocked/Terminal state cannot be activation-capable"

    // 4. Structural Logic
    else if ea >= EA_READY and ea <= EA_TRIGGERABLE
        if mssFailed_ or reclaimFailed_ or dispFailed_ or expired_
            valid := false
            reason := "Valid EA with structural failure"
        else if not modeCandidate
            valid := false
            reason := "Valid EA without candidacy"
        else if not modeActivation
            valid := false
            reason := "Valid EA without mode activation"
        else if lifecycle < LC_MSS_CONFIRMED
            valid := false
            reason := "Readiness requires MSS_CONFIRMED"

    // 5. Category/Conflict
    else if ea == EA_BLOCKED and eb == EB_NONE
        valid := false
        reason := "EA_BLOCKED requires category"
    else if isConflicted_ and not hasActiveTrade and (ea != EA_BLOCKED or eb != EB_CONFLICTED)
        valid := false
        reason := "Conflict mismatch"

    [valid, reason]
