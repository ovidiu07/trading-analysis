// @description Pending trade evaluation, mode execution qualification, and Stats method.
library("tv_pending_trade_state", overlay = true)

import Devtailor/tv_core_types/4 as T
import Devtailor/tv_lifecycle_mode/1 as lm

// --- Constants: Lifecycle ---
int LC_NONE                   = T.LC_NONE()
int LC_SWEEP_CONFIRMED        = T.LC_SWEEP_CONFIRMED()
int LC_MSS_CONFIRMED          = T.LC_MSS_CONFIRMED()
int LC_DISPLACEMENT_CONFIRMED = T.LC_DISPLACEMENT_CONFIRMED()
int LC_ENTRY_ARMED            = T.LC_ENTRY_ARMED()
int LC_ENTRY_TRIGGERED        = T.LC_ENTRY_TRIGGERED()

// --- Constants: Opportunity States (Chapter 7) ---
int OPP_NONE             = T.OPP_NONE()
int OPP_FORMING          = T.OPP_FORMING()
int OPP_FRESH            = T.OPP_FRESH()
int OPP_PENDING_FRESH    = T.OPP_PENDING_FRESH()
int OPP_PENDING_DELAYED  = T.OPP_PENDING_DELAYED()
int OPP_READY            = T.OPP_READY()
int OPP_LATE_ACCEPTABLE  = T.OPP_LATE_ACCEPTABLE()
int OPP_LATE_RISKY       = T.OPP_LATE_RISKY()
int OPP_MISSED           = T.OPP_MISSED()
int OPP_STALE            = T.OPP_STALE()
int OPP_EXPIRED          = T.OPP_EXPIRED()
int OPP_INVALIDATED      = T.OPP_INVALIDATED()
int OPP_BLOCKED          = T.OPP_BLOCKED()
int OPP_ACTIVE           = T.OPP_ACTIVE()
int OPP_COMPLETE         = T.OPP_COMPLETE()

// --- Constants: Entry Authority ---
int EA_NONE                = T.EA_NONE()
int EA_FORMING             = T.EA_FORMING()
int EA_STRUCT_VALID        = T.EA_STRUCT_VALID()
int EA_READY               = T.EA_READY()
int EA_ARMED               = T.EA_ARMED()
int EA_TRIGGERABLE         = T.EA_TRIGGERABLE()
int EA_PENDING_RETRACE     = T.EA_PENDING_RETRACE()
int EA_PENDING_CONFIRMATION = T.EA_PENDING_CONFIRMATION()
int EA_BLOCKED             = T.EA_BLOCKED()
int EA_LATE                = T.EA_LATE()
int EA_EXPIRED             = T.EA_EXPIRED()
int EA_INVALIDATED         = T.EA_INVALIDATED()
int EA_ACTIVE              = T.EA_ACTIVE()

// --- Constants: Block Categories ---
int EB_EXTENSION           = T.EB_EXTENSION()
int EB_FRESHNESS           = T.EB_FRESHNESS()
int EB_RECLAIM_FAILED      = T.EB_RECLAIM_FAILED()
int EB_MSS_FAILED          = T.EB_MSS_FAILED()
int EB_DISP_FAILED         = T.EB_DISP_FAILED()
int EB_CONFLICTED          = T.EB_CONFLICTED()

// =====================================================================
// INTERNAL HELPERS: TIMING & PENALTY LOGIC
// =====================================================================

// Calculates mode-based lateness thresholds
_get_mode_thresholds(string mode) =>
    float late   = mode == "Aggressive" ? 0.6 : mode == "Conservative" ? 0.4 : 0.5
    float missed = mode == "Aggressive" ? 1.0 : mode == "Conservative" ? 0.7 : 0.85
    [late, missed]

// Calculates progress through the pending window with penalties for extension or inability to activate
_calculate_effective_progress(int signalBar, int expiryBar, bool isExtended, bool canActivate) =>
    int age = signalBar > 0 ? bar_index - signalBar : 0
    int window = expiryBar > 0 and signalBar > 0 ? expiryBar - signalBar : 5
    float rawProgress = window > 0 ? float(age) / float(window) : 1.0

    float extensionPenalty  = isExtended ? 0.2 : 0.0
    float activationPenalty = canActivate ? 0.0 : 0.3
    float effectiveProgress = rawProgress + extensionPenalty + activationPenalty
    [age, effectiveProgress]

// =====================================================================
// INTERNAL HELPERS: STATE CLASSIFICATION
// =====================================================================

// Classifies the state when a pending setup is active
_classify_pending_state(string mode, bool isExtended, bool fresh, bool canActivate, bool mssFresh, bool dispFresh, int age, float effectiveProgress, float lateThreshold, float missedThreshold) =>
    int opp = OPP_NONE
    string reason = ""
    bool chaseOk = false

    if not fresh
        opp := OPP_STALE
        reason := "Pending structurally stale — no longer professional entry"
    else if not canActivate
        opp := OPP_MISSED
        reason := "Pending can no longer activate — opportunity passed"
    else if not mssFresh or not dispFresh
        opp := OPP_STALE
        reason := (not mssFresh ? "MSS" : "Displacement") + " aged out — opportunity stale"
    else if effectiveProgress >= missedThreshold
        opp := OPP_MISSED
        reason := "Optimal entry window passed" + (isExtended ? " (extended)" : "") + " — do not chase"
    else if effectiveProgress >= lateThreshold
        if isExtended and mode != "Aggressive"
            opp := OPP_LATE_RISKY
            reason := "Late + extended — chase risk high"
        else if mode == "Conservative"
            opp := OPP_LATE_RISKY
            reason := "Late for conservative — reduced conviction"
        else
            opp := OPP_LATE_ACCEPTABLE
            reason := "Late but within tolerance — reduced conviction"
            chaseOk := mode == "Aggressive"
    else if age <= 1
        opp := OPP_PENDING_FRESH
        reason := "Pending fresh — ideal retrace window"
        chaseOk := true
    else
        opp := OPP_PENDING_DELAYED
        reason := "Pending delayed — still acceptable"
        chaseOk := true

    [opp, reason, chaseOk]

// Classifies the state when EA reports LATE
_classify_late_state(int blockCat, bool mssFresh, bool dispFresh, bool isExtended, string mode) =>
    int opp = OPP_NONE
    string reason = ""
    bool chaseOk = false

    if blockCat == EB_FRESHNESS
        if not mssFresh or not dispFresh
            opp := OPP_STALE
            reason := not mssFresh ? "MSS aged out — opportunity stale" : "Displacement aged out — opportunity stale"
        else
            opp := OPP_LATE_RISKY
            reason := "Structurally valid but timing degraded"
    else if blockCat == EB_EXTENSION
        if mode == "Aggressive"
            opp := OPP_LATE_ACCEPTABLE
            reason := "Extended but aggressive may still participate"
            chaseOk := true
        else
            opp := OPP_LATE_RISKY
            reason := "Price extended — chase risk high for " + mode
    else
        if isExtended and mode != "Aggressive"
            opp := OPP_MISSED
            reason := "Late + extended — optimal entry gone"
        else
            opp := OPP_LATE_ACCEPTABLE
            reason := "Setup late — reduced conviction"
            chaseOk := mode == "Aggressive"

    [opp, reason, chaseOk]

// Classifies the state when EA reports BLOCKED
_classify_blocked_state(int blockCat, string mode) =>
    int opp = OPP_BLOCKED
    string reason = ""

    if blockCat == EB_RECLAIM_FAILED or blockCat == EB_MSS_FAILED or blockCat == EB_DISP_FAILED
        opp := OPP_INVALIDATED
        reason := "Blocked by structural failure"
    else if blockCat == EB_CONFLICTED
        reason := "Both sides active — no clear edge"
    else if blockCat == EB_EXTENSION
        reason := "Price too extended — blocked for " + mode
    else
        reason := "Execution blocked — mode/gate requirements not met"

    [opp, reason]

// Classifies the state when EA reports STRUCT_VALID
_classify_struct_valid_state(string mode, int lifecycle, int mssBar, int signalBar, bool structValid) =>
    int opp = OPP_FORMING
    string reason = "Structurally valid — awaiting execution readiness"

    bool hasMssRef = not na(mssBar) and mssBar > 0
    int mssAge = hasMssRef ? bar_index - mssBar : 0
    int mssLateAge = mode == "Aggressive" ? 25 : mode == "Conservative" ? 10 : 18

    bool hasSigRef = not na(signalBar) and signalBar > 0
    int sigAge = hasSigRef ? bar_index - signalBar : 0
    bool sigAging = hasSigRef and sigAge > mssLateAge

    bool lifecycleAdvanced = lifecycle >= LC_DISPLACEMENT_CONFIRMED

    if hasMssRef and mssAge > mssLateAge and structValid
        if lifecycleAdvanced
            opp := sigAging ? OPP_LATE_RISKY : OPP_LATE_ACCEPTABLE
            reason := sigAging ? "Structure valid but both MSS and signal aging — risky"
                 : "Structurally valid but timing aging — monitor only"
        else
            opp := OPP_LATE_ACCEPTABLE
            reason := "Structurally valid but timing aging — lifecycle not advanced"

    [opp, reason]

// =====================================================================
// EXPORTED CORE FUNCTIONS
// =====================================================================

// Pending structural freshness: blocks stale pending setups.
export pending_is_structurally_fresh(int signalBar, int mssBar_, int fvgBar_, bool degraded, bool isExtended, string mode, bool mssFailed_, bool dispFailed_) =>
    bool fresh = true
    bool stale = false
    string reason = "Structurally fresh"
    int age = bar_index - signalBar
    int maxFresh = mode == "Aggressive" ? 5 : mode == "Conservative" ? 4 : 5
    if age > maxFresh
        fresh := false
        stale := true
        reason := "Age " + str.tostring(age) + " > " + str.tostring(maxFresh) + " bars"
    if fresh and not na(mssBar_)
        int mssAge = bar_index - mssBar_
        int mssMaxFresh = mode == "Conservative" ? 15 : mode == "Balanced" ? 25 : 35
        if mssAge > mssMaxFresh
            fresh := false
            stale := true
            reason := "MSS aged (" + str.tostring(mssAge) + " bars)"
    if fresh and not na(fvgBar_)
        int fvgAge = bar_index - fvgBar_
        int fvgMaxFresh = mode == "Conservative" ? 12 : mode == "Balanced" ? 20 : 30
        if fvgAge > fvgMaxFresh
            fresh := false
            stale := true
            reason := "FVG aged (" + str.tostring(fvgAge) + " bars)"
    if fresh and degraded
        fresh := false
        stale := true
        reason := "Setup degraded"
    if fresh and isExtended
        fresh := false
        stale := true
        reason := "Price too extended"
    if fresh and mssFailed_
        fresh := false
        stale := true
        reason := "MSS failed — structure invalidated"
    if fresh and dispFailed_
        fresh := false
        stale := true
        reason := "Displacement failed — setup invalidated"
    [fresh, stale, reason]

// Central mode qualification function (Chapter 2.2 + Chapter 4 + Chapter 5).
export evaluate_mode_execution(string mode, int lifecycle, bool swept, float sweepQ, bool hasMss, float mssDisp_, bool hasFvg, int fvgGrade_, bool seqOk, bool expired, bool degraded, bool reclaimPass, float reclaimStr, bool reclaimStrong, bool isExtended, bool mssQualPass, bool mssQualStrong, bool bridgePass, bool bridgeStrong, int score, int mssTrigSig, bool dispPass_, bool dispStrong_, bool dispFailed_, float dispScore_) =>
    int minCandidate = lm.mode_min_lifecycle_for_candidate(mode)
    bool meetsCandidate = lifecycle >= minCandidate and not expired and not degraded
    bool meetsActivation = false
    bool allowDirect = lm.mode_allows_direct_signal_activation(mode)
    string blockReason = ""
    string actPath = ""

    if lifecycle <= LC_SWEEP_CONFIRMED
        meetsCandidate := false
        blockReason := swept and sweepQ > 0 ? "Sweep-only (Q=" + str.tostring(math.round(sweepQ)) + ") — need structure shift" : "Sweep-only — need structure shift"

    if meetsCandidate and isExtended and mode != "Aggressive"
        meetsCandidate := false
        blockReason := lm.mode_name_short(mode) + " blocked — entry too extended"

    if not meetsCandidate
        if blockReason == ""
            blockReason := lm.mode_name_short(mode) + " needs " + lm.lifecycle_name(minCandidate)
    else
        if mode == "Aggressive"
            bool standardOk = lifecycle >= LC_ENTRY_TRIGGERED and hasMss and reclaimPass
            bool promoOk = lifecycle >= LC_DISPLACEMENT_CONFIRMED and reclaimPass and dispPass_ and not dispFailed_
            if standardOk
                meetsActivation := true
                actPath := "AGG standard (score=" + str.tostring(score) + ", mssDisp=" + str.tostring(math.round(mssDisp_ * 100) / 100) + ")"
            else if promoOk
                meetsActivation := true
                actPath := "AGG promo (disp=" + str.tostring(math.round(dispScore_)) + ")"
            else
                blockReason := "AGG: " + (not hasMss ? "no MSS" : not reclaimPass ? "reclaim " + str.tostring(math.round(reclaimStr)) + " insufficient" : dispFailed_ ? "displacement failed" : not dispPass_ ? "displacement insufficient (score=" + str.tostring(math.round(dispScore_)) + ")" : "lifecycle insufficient")

        else if mode == "Balanced"
            bool idealOk = lifecycle >= LC_ENTRY_ARMED and reclaimPass and mssQualPass and not isExtended and dispPass_ and not dispFailed_
            bool bridgeOk = lifecycle >= LC_DISPLACEMENT_CONFIRMED and lifecycle < LC_ENTRY_ARMED and reclaimStr >= 40.0 and mssQualPass and bridgePass and not isExtended and dispPass_ and not dispFailed_
            if idealOk
                meetsActivation := true
                actPath := "BAL ideal (disp=" + str.tostring(math.round(dispScore_)) + ")"
            else if bridgeOk
                meetsActivation := true
                actPath := "BAL bridge (disp=" + str.tostring(math.round(dispScore_)) + ")"
            else
                blockReason := not reclaimPass ? "BAL: reclaim insufficient (" + str.tostring(math.round(reclaimStr)) + ")" : not mssQualPass ? "BAL: MSS quality insufficient" : dispFailed_ ? "BAL: displacement failed" : not dispPass_ ? "BAL: displacement quality insufficient (score=" + str.tostring(math.round(dispScore_)) + ")" : isExtended ? "BAL: entry too extended" : lifecycle < LC_ENTRY_ARMED and not bridgeOk ? "BAL: bridge conditions not met" : "BAL: activation not met"

        else // Conservative
            bool idealOk = lifecycle >= LC_ENTRY_ARMED and reclaimPass and reclaimStr >= 50.0 and mssQualStrong and not isExtended and seqOk and mssTrigSig >= 2 and dispStrong_ and not dispFailed_
            bool bridgeOk = lifecycle >= LC_DISPLACEMENT_CONFIRMED and lifecycle < LC_ENTRY_ARMED and reclaimStrong and mssQualStrong and bridgeStrong and not isExtended and (seqOk or (hasFvg and fvgGrade_ >= 2)) and mssTrigSig >= 2 and dispStrong_ and not dispFailed_
            bool fallbackOk = not idealOk and not bridgeOk and lifecycle >= LC_ENTRY_ARMED and reclaimStrong and mssQualStrong and not isExtended and seqOk and mssTrigSig >= 2 and dispPass_ and dispScore_ >= 50.0 and not dispFailed_
            if idealOk
                meetsActivation := true
                actPath := "CON ideal (disp=" + str.tostring(math.round(dispScore_)) + ")"
            else if bridgeOk
                meetsActivation := true
                actPath := "CON bridge (disp=" + str.tostring(math.round(dispScore_)) + ")"
            else if fallbackOk
                meetsActivation := true
                actPath := "CON fallback (disp=" + str.tostring(math.round(dispScore_)) + ")"
            else
                blockReason := not reclaimStrong and reclaimStr < 50.0 ? "CON: reclaim not strong (" + str.tostring(math.round(reclaimStr)) + ")" : not mssQualStrong ? "CON: MSS quality not strong" : mssTrigSig < 2 ? "CON: protected structure not broken (sig=" + str.tostring(mssTrigSig) + ")" : dispFailed_ ? "CON: displacement failed" : not dispStrong_ and dispScore_ < 50.0 ? "CON: displacement not strong (score=" + str.tostring(math.round(dispScore_)) + ")" : isExtended ? "CON: entry too extended" : not seqOk and lifecycle >= LC_ENTRY_ARMED ? "CON: requires complete sequence" : "CON: strong bridge not met"

    if mode != "Aggressive"
        allowDirect := false

    [meetsCandidate, meetsActivation, blockReason, allowDirect, actPath]

// Evaluate whether a pending setup qualifies for delayed activation (Chapter 2.2).
export evaluate_pending_activation(bool isLong, int currentLifecycle, bool reclaimPass, float reclaimStr, bool reclaimStrong, float dispStrength, bool seqOk, bool expired, bool degraded, string mode, int signalBar, int expiryBar, bool isExtended, bool mssQualPass, bool mssQualStrong, bool bridgePass_, bool bridgeStrong_, bool pendingFresh, bool reclaimFailed_, bool mssFailed_, bool mssFresh_, bool dispPass_, bool dispFresh_, bool dispFailed_) =>
    bool canActivate = false
    string reason = ""
    bool shouldInvalidate = false

    if reclaimFailed_
        shouldInvalidate := true
        reason := "Pending invalidated — reclaim failed (str=" + str.tostring(math.round(reclaimStr)) + ")"
    else if mssFailed_
        shouldInvalidate := true
        reason := "Pending invalidated — MSS failed"
    else if not mssFresh_
        shouldInvalidate := true
        reason := "Pending invalidated — MSS stale"
    else if dispFailed_
        shouldInvalidate := true
        reason := "Pending invalidated — displacement failed"
    else if not dispFresh_
        shouldInvalidate := true
        reason := "Pending invalidated — displacement stale"
    else if not lm.pending_setup_is_fresh(signalBar, expiryBar)
        shouldInvalidate := lm.pending_setup_has_expired(expiryBar)
        reason := shouldInvalidate ? "Pending window expired" : "Pending not yet active"
    else if expired or degraded
        shouldInvalidate := true
        reason := expired ? "Setup expired" : "Setup degraded"
    else if not pendingFresh
        shouldInvalidate := true
        reason := "Pending structurally stale"
    else if isExtended
        shouldInvalidate := true
        reason := "Price too extended for pending"
    else
        string side = isLong ? "long" : "short"
        if mode == "Aggressive"
            bool lifecycleOk = currentLifecycle >= LC_DISPLACEMENT_CONFIRMED
            if lifecycleOk and reclaimPass and dispPass_
                canActivate := true
                reason := "AGG pending " + side + " confirmed"
            else
                reason := not lifecycleOk ? "Pending: lifecycle insufficient" : not reclaimPass ? "Pending: reclaim lost (" + str.tostring(math.round(reclaimStr)) + ")" : "Pending: displacement insufficient"
        else if mode == "Balanced"
            bool lifecycleOk = currentLifecycle >= LC_DISPLACEMENT_CONFIRMED
            bool qualityOk = reclaimPass and mssQualPass and bridgePass_ and dispPass_
            if lifecycleOk and qualityOk
                canActivate := true
                reason := "BAL pending " + side + ": quality confirmed"
            else
                reason := not lifecycleOk ? "Pending: lifecycle " + lm.lifecycle_name(currentLifecycle) : not reclaimPass ? "Pending: reclaim insufficient (" + str.tostring(math.round(reclaimStr)) + ")" : not mssQualPass ? "Pending: MSS quality insufficient" : not dispPass_ ? "Pending: displacement insufficient" : "Pending: bridge insufficient"
        else // Conservative
            bool lifecycleOk = currentLifecycle >= LC_DISPLACEMENT_CONFIRMED
            bool qualityOk = reclaimStrong and mssQualStrong and bridgeStrong_ and dispPass_
            bool seqGate = seqOk or (not na(dispStrength) and dispStrength >= 1.5)
            if lifecycleOk and qualityOk and seqGate
                canActivate := true
                reason := "CON pending " + side + ": strong quality confirmed"
            else
                reason := not lifecycleOk ? "Pending: lifecycle insufficient" : not reclaimStrong ? "Pending: reclaim not strong" : not mssQualStrong ? "Pending: MSS not strong" : not dispPass_ ? "Pending: displacement not strong" : not seqGate ? "Pending: sequence insufficient" : "Pending: bridge not strong"

    [canActivate, reason, shouldInvalidate]

// Stats update method
export method update_stats(T.Stats s, float rEarned, bool isWin) =>
    s.totalTrades += 1
    s.totalR += rEarned
    s.equityR += rEarned
    if isWin
        s.wins += 1
    else
        s.losses += 1
    s.peakEquityR := math.max(s.peakEquityR, s.equityR)
    s.maxDrawdownR := math.min(s.maxDrawdownR, s.equityR - s.peakEquityR)

// =====================================================================
// CHAPTER 7: OPPORTUNITY STATE MODEL
// =====================================================================

// Human-readable name for an opportunity state.
export opp_name(int opp) =>
    opp == OPP_NONE ? "No opportunity"
     : opp == OPP_FORMING ? "Forming"
     : opp == OPP_FRESH ? "Fresh"
     : opp == OPP_PENDING_FRESH ? "Pending fresh"
     : opp == OPP_PENDING_DELAYED ? "Pending delayed"
     : opp == OPP_READY ? "Ready"
     : opp == OPP_LATE_ACCEPTABLE ? "Late (acceptable)"
     : opp == OPP_LATE_RISKY ? "Late (risky)"
     : opp == OPP_MISSED ? "Missed"
     : opp == OPP_STALE ? "Stale"
     : opp == OPP_EXPIRED ? "Expired"
     : opp == OPP_INVALIDATED ? "Invalidated"
     : opp == OPP_BLOCKED ? "Blocked"
     : opp == OPP_ACTIVE ? "Active"
     : opp == OPP_COMPLETE ? "Complete"
     : "Unknown"

// Whether this opportunity state allows professional entry.
export opp_allows_entry(int opp) =>
    opp == OPP_FRESH or opp == OPP_PENDING_FRESH or opp == OPP_PENDING_DELAYED or opp == OPP_READY or opp == OPP_LATE_ACCEPTABLE

// Whether this opportunity state is terminal.
export opp_is_terminal(int opp) =>
    opp == OPP_MISSED or opp == OPP_STALE or opp == OPP_EXPIRED or opp == OPP_INVALIDATED or opp == OPP_COMPLETE

// Whether this opportunity should suppress pending activation.
export opp_should_invalidate_pending(int opp) =>
    opp == OPP_MISSED or opp == OPP_STALE or opp == OPP_EXPIRED or opp == OPP_INVALIDATED

// Whether this opportunity state explicitly forbids chasing.
export opp_is_chase_forbidden(int opp) =>
    opp == OPP_MISSED or opp == OPP_STALE or opp == OPP_EXPIRED or opp == OPP_INVALIDATED or opp == OPP_LATE_RISKY or opp == OPP_BLOCKED or opp == OPP_COMPLETE

// =====================================================================
// CHAPTER 7: CORE EVALUATOR (REFACTORED)
// =====================================================================

// Evaluates opportunity state for one side (long or short).
export evaluate_opportunity_state(
     int entryAuth, int blockCat, bool structValid,
     bool pendingActive, int pendingSignalBar, int pendingExpiryBar,
     bool pendingFresh, bool pendingCanActivate,
     bool mssFresh_, bool dispFresh_,
     bool isExtended_, bool mssFailed_, bool reclaimFailed_, bool dispFailed_,
     bool expired_, bool degraded_,
     string mode, int lifecycle,
     int mssBar_, int signalBar_,
     bool hasActiveTrade, bool tradeClosedThisSetup) =>

    int opp = OPP_NONE
    string reason = ""
    bool chaseOk = false

    // --- Priority 1: Active/Completed Trade ---
    if hasActiveTrade
        opp := OPP_ACTIVE
        reason := "Trade active — opportunity being realized"
    else if tradeClosedThisSetup
        opp := OPP_COMPLETE
        reason := "Trade completed — opportunity concluded"

    // --- Priority 2: Invalidation / Expiration (Terminal) ---
    else if entryAuth == EA_INVALIDATED
        opp := OPP_INVALIDATED
        reason := mssFailed_ ? "MSS failed — structure destroyed"
             : reclaimFailed_ ? "Reclaim failed — recovery lost"
             : dispFailed_ ? "Displacement failed — commitment lost"
             : degraded_ ? "Setup degraded — imbalance filled"
             : "Setup structurally invalidated"
    else if entryAuth == EA_EXPIRED
        opp := OPP_EXPIRED
        reason := expired_ ? "Setup aged out completely"
             : pendingActive and pendingExpiryBar > 0 and bar_index > pendingExpiryBar ? "Pending window expired"
             : "Timing window elapsed"

    // --- Priority 3: No Setup / Forming ---
    else if entryAuth == EA_NONE
        opp := OPP_NONE
        reason := "No setup context"
    else if entryAuth == EA_FORMING
        opp := OPP_FORMING
        reason := "Setup developing — opportunity not yet real"

    // --- Priority 4: Triggerable ---
    else if entryAuth == EA_TRIGGERABLE
        opp := OPP_READY
        reason := lifecycle >= LC_ENTRY_TRIGGERED ? "Execution triggered — take the trade"
             : lifecycle >= LC_ENTRY_ARMED ? "Execution authorized — opportunity ready"
             : "Execution authorized — setup mature"
        chaseOk := true

    // --- Priority 5: Active Pending States ---
    else if pendingActive
        [lateThresh, missedThresh] = _get_mode_thresholds(mode)
        [age, effectiveProgress]   = _calculate_effective_progress(pendingSignalBar, pendingExpiryBar, isExtended_, pendingCanActivate)
        [pOpp, pReason, pChase]    = _classify_pending_state(mode, isExtended_, pendingFresh, pendingCanActivate, mssFresh_, dispFresh_, age, effectiveProgress, lateThresh, missedThresh)
        opp := pOpp, reason := pReason, chaseOk := pChase

    // --- Priority 6: Late Authority ---
    else if entryAuth == EA_LATE
        [lOpp, lReason, lChase] = _classify_late_state(blockCat, mssFresh_, dispFresh_, isExtended_, mode)
        opp := lOpp, reason := lReason, chaseOk := lChase

    // --- Priority 7: Blocked Authority ---
    else if entryAuth == EA_BLOCKED
        [bOpp, bReason] = _classify_blocked_state(blockCat, mode)
        opp := bOpp, reason := bReason

    // --- Priority 8: Awaiting Retrace/Confirmation ---
    else if entryAuth == EA_PENDING_RETRACE or entryAuth == EA_PENDING_CONFIRMATION
        opp := OPP_PENDING_FRESH
        reason := "Awaiting retrace/confirmation — fresh opportunity"
        chaseOk := true

    // --- Priority 9: Ready / Armed / Struct Valid ---
    else if entryAuth == EA_ARMED
        opp := OPP_READY
        reason := "Entry armed — trigger zone reachable"
        chaseOk := true
    else if entryAuth == EA_READY
        opp := OPP_FRESH
        reason := lifecycle >= LC_ENTRY_TRIGGERED ? "Execution ready and triggered — high conviction"
             : "Execution ready — fresh opportunity"
        chaseOk := true
    else if entryAuth == EA_STRUCT_VALID
        [sOpp, sReason] = _classify_struct_valid_state(mode, lifecycle, mssBar_, signalBar_, structValid)
        opp := sOpp, reason := sReason

    else
        opp := OPP_NONE
        reason := "No classifiable opportunity"

    [opp, reason, chaseOk]
