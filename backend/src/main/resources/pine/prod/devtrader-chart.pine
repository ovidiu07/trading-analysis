// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Devtrader - Chart analysis", shorttitle="Devtrader - Chart analysis", overlay=true, max_bars_back=5000, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// --- Groups ---
G_KZ    = "Killzones & Sessions"
G_VP    = "Volume Profile (Daily)"
G_FVG   = "Fair Value Gaps (SMC)"
G_PROJ  = "SD Projections & Targets"
G_STATS = "Trade Statistics Settings"
G_SMC   = "SMC Engine"
G_LIQ   = "Liquidity Swing Engine"
G_DASH  = "Dashboard Settings"
G_LVLS  = "Important Market Levels"
G_RZ    = "High-Prob Reaction Zones"

// --- Constants ---
COLOR_BULL = #08ffd6
COLOR_BEAR = #ff0015
COLOR_NEUT = #5b9cf6

// --- Types ---
type fvg_data
    float max
    float min
    bool  isBull
    int   startTime
    int   startBar

type reaction_zone
    string side          // "Long" or "Short"
    string zoneType      // "FVG", "OB", "SWEEP", "INT", "EXT", "SESS"
    float  top
    float  bottom
    float  ce
    int    sourceBar
    int    priorityRank  // 1 to 6 (1 is highest)
    float  score
    bool   isMitigated
    bool   isInvalidated
    string narrative     // description for label

type liq_pool
    string side          // "BSL" or "SSL"
    string poolType      // "EXTERNAL", "INTERNAL", "SESSION", "DEV_SESSION", "PERIOD", "EQ"
    string baseType      // "SWING", "SESSION", "DEV_SESSION", "PERIOD", "EQ"
    float  price
    int    sourceBar
    bool   isSwept
    string poolLabel
    string baseLabel
    int    touchCount
    int    clusterSize
    int    lastTouchBar
    int    lastRefreshBar
    int    pendingSweepBar
    float  pendingSweepExtreme
    int    pendingSweepExtremeBar
    float  pendingWickRatio
    int    takenBar
    int    lastFailureBar
    int    creationTime
    string sourceTF
    float  structuralRank
    int    timesTagged
    float  cleanlinessScore
    string sessionContext
    bool   isInducementCandidate
    string state         // "FRESH", "TAGGED", "SWEPT", "CONSUMED"

type liq_render_row
    string side
    float  price
    int    sourceBar
    bool   isMajor
    string primaryText
    float  priority
    int    mergedCount
    string state

// --- Inputs ---
showAsia     = input.bool(true, "Asia Session Box", group=G_KZ)
asiaSession  = input.session("0000-0900:1234567", "Asia Session", group=G_KZ)
colorAsia    = input.color(color.new(#5b9cf6, 85), "Asia Color", group=G_KZ)
showDevelopingSessionLevels = input.bool(false, "Show Developing Session H/L", group=G_KZ, tooltip="Plots the current session high/low as developing references. These are informational only and are not treated as confirmed liquidity.")

showLondon   = input.bool(true, "London Killzone", group=G_KZ)
londonSess   = input.session("0700-1000:1234567", "London Session", group=G_KZ)
colorLon     = input.color(color.new(#089981, 93), "London Color", group=G_KZ)

showNY       = input.bool(true, "NY Killzone", group=G_KZ)
nySess       = input.session("1200-1500:1234567", "NY Session", group=G_KZ)
colorNYK     = input.color(color.new(#f23645, 93), "NY Color", group=G_KZ)

showVP       = input.bool(true, "Show Daily Reference", group=G_VP)
colorPOC     = input.color(color.orange, "Reference Color", group=G_VP)

showFVG      = input.bool(true, "Detect Fair Value Gaps", group=G_FVG)
fvgThreshold = input.float(0, "Threshold %", minval=0, maxval=100, step=0.1, group=G_FVG)
fvgAuto      = input.bool(false, "Auto Threshold", group=G_FVG)
fvgExtend    = input.int(20, "Extend Bars", minval=0, group=G_FVG)
showLastFVG  = input.int(0, "Show Only Last X Unmitigated", minval=0, group=G_FVG)
mitigationL  = input.bool(true, "Show Mitigation Levels", group=G_FVG)
bullFVGColor = input.color(color.new(#089981, 80), "Bullish FVG", group=G_FVG)
bearFVGColor = input.color(color.new(#f23645, 80), "Bearish FVG", group=G_FVG)

showProj     = input.bool(true, "Show SD Targets", group=G_PROJ)
colorProj    = input.color(color.new(#5b9cf6, 30), "Projection Color", group=G_PROJ)

showStatsTbl = input.bool(true, "Show Stats Table", group=G_STATS)
stopModel    = input.string("Sweep Extreme", "Stop Model", options=["Sweep Extreme", "MSS Candle Extreme"], group=G_STATS)

showSMC      = input.bool(true, "SFP & MSS Detection", group=G_SMC)
majorSweeps  = input.bool(true, "External Liquidity Only", group=G_SMC, tooltip="Only detect sweeps on external liquidity (major, EQ, session, or HTF levels). Ignores minor internal structure.")
wickThresh   = input.float(0.70, "Min. Rejection Wick %", minval=0.4, maxval=1.0, step=0.05, group=G_SMC, tooltip="Minimum wick percentage relative to candle range.")
reclaimLvl   = input.float(0.15, "Reclaim Threshold %", minval=0.0, step=0.05, group=G_SMC, tooltip="How far back inside the level the price must close (relative to range). Higher = Stronger Reclaim.")
sweepMaxDepth = input.float(0.8, "Max Sweep Depth (ATR)", minval=0.1, step=0.1, group=G_SMC, tooltip="Limit how far price can pierce the level before it's considered a failed breakout attempt rather than a sweep.")
ageExpiry    = input.int(800, "Level Expiry (Bars)", minval=100, group=G_SMC, tooltip="Levels older than this are considered 'fragile/stale' for sweeps.")
kzBoost      = input.bool(true, "Killzone Priority", group=G_SMC, tooltip="Increases sweep score if it occurs in London/NY sessions.")
volConfirm   = input.bool(true, "Require Volume Confirmation", group=G_SMC)
useMajorMSS  = input.bool(true, "Major Structure MSS Only", group=G_SMC, tooltip="Require MSS to break a Major pivot rather than a minor internal one.")
dispMult     = input.float(1.4, "Disp. Multiplier", step=0.1, group=G_SMC)
swingLen     = input.int(3, "Swing Strength", minval=1, group=G_SMC)
breakoutBullColor = input.color(COLOR_BULL, "Breakout Bull Color", group=G_SMC)
breakoutBearColor = input.color(COLOR_BEAR, "Breakout Bear Color", group=G_SMC)
breakoutLabelSize = input.string("Tiny", "Breakout Label Size", options=["Tiny", "Small", "Normal"], group=G_SMC)
raidBullColor = input.color(COLOR_BULL, "Raid Bull Color", group=G_SMC)
raidBearColor = input.color(COLOR_BEAR, "Raid Bear Color", group=G_SMC)
raidLabelSize = input.string("Tiny", "Raid Label Size", options=["Tiny", "Small", "Normal"], group=G_SMC)
sweepMssTimeoutBars = input.int(6, "Sweep To MSS Timeout (Bars)", minval=1, group=G_SMC, tooltip="Hide sweep reclaim entry zones if no MSS confirms within this many bars.")
showSweepTimeoutNote = input.bool(false, "Show Sweep Timeout Note", group=G_SMC, tooltip="If enabled, prints one small note when a sweep reclaim setup expires without MSS confirmation.")
breakoutCooldownBars = input.int(8, "Breakout Cooldown (Bars)", minval=1, group=G_SMC, tooltip="Suppress repeated breakout labels on the same liquidity cluster for this many bars.")

liqPivotLen      = input.int(14, "Base Pivot Lookback", minval=1, group=G_LIQ)
autoLiqPivot     = input.bool(true, "Auto-Optimize Lookback", group=G_LIQ, tooltip="Adjusts the pivot lookback based on current ATR volatility. High volatility increases lookback to filter noise; low volatility decreases it to catch tighter pivots.")
liqRangeLookback = input.int(50, "Structural Range Lookback", minval=20, group=G_LIQ, tooltip="Range used to classify swing liquidity as external or internal.")
liqExtBoundaryPct = input.float(0.15, "External Boundary %", minval=0.05, maxval=0.40, step=0.01, group=G_LIQ, tooltip="A swing is external only when it sits near the active dealing-range boundary.")

showEQ           = input.bool(true, "Show Liquidity Clusters", group=G_LIQ, tooltip="Promote equal-high / equal-low groupings into directional BSL / SSL cluster labels.")
eqThreshold      = input.float(0.1, "EQ Threshold %", minval=0, step=0.01, group=G_LIQ)
eqLocalLookback  = input.int(12, "EQ Local Lookback", minval=6, maxval=40, group=G_LIQ)
eqStructuralLookback = input.int(32, "EQ Structural Lookback", minval=10, maxval=80, group=G_LIQ)
eqClusterMaxAge  = input.int(220, "EQ Max Age (Bars)", minval=40, maxval=1000, group=G_LIQ)
liqMaxLevelsPerSide = input.int(2, "Active Levels Per Side", minval=1, maxval=5, group=G_LIQ, tooltip="Maximum number of liquidity levels shown above and below price in trader mode.")
showSweptLiquidity = input.bool(false, "Show Recent Swept Context", group=G_LIQ, tooltip="Keep at most one recent swept level per side when it still matters for the active narrative.")
liqContextAtr = input.float(1.5, "Swept Context Distance (ATR)", minval=0.5, step=0.25, group=G_LIQ, tooltip="Hide swept context levels that are too far away from current price.")
liqShowDebugMetrics = input.bool(false, "Show Label Metrics", group=G_LIQ, tooltip="Append touch/state diagnostics to liquidity labels. Disable for clean trader view.")
showLiquidityLabels = input.bool(true, "Show Liquidity Labels", group=G_LIQ)
liqMajorColor    = input.color(color.new(#ff0015, 30), "Major Liquidity", group=G_LIQ)
liqMinorColor    = input.color(color.new(#5b9cf6, 50), "Minor Liquidity", group=G_LIQ)
liqLabelSize     = input.string("Tiny", "Labels Size", options=["Tiny", "Small", "Normal"], group=G_LIQ)

showDash     = input.bool(true, "Show Bias Dashboard", group=G_DASH)
dashPos      = input.string("Top Right", "Position", options=["Top Right", "Bottom Right", "Top Left"], group=G_DASH)

showPDH  = input.bool(true, "PDH (Prev Day High)", group=G_LVLS)
showPDL  = input.bool(true, "PDL (Prev Day Low)", group=G_LVLS)
showPDC  = input.bool(false, "PDC (Prev Day Close)", group=G_LVLS)
showDO   = input.bool(true, "DO (Daily Open)", group=G_LVLS)
showPWH  = input.bool(false, "PWH (Prev Week High)", group=G_LVLS)
showPWL  = input.bool(false, "PWL (Prev Week Low)", group=G_LVLS)
showPMH  = input.bool(false, "PMH (Prev Month High)", group=G_LVLS)
showPML  = input.bool(false, "PML (Prev Month Low)", group=G_LVLS)
showNYMid = input.bool(true, "NY Midnight Open", group=G_LVLS)

colorPDLvl = input.color(color.new(color.gray, 30), "Daily Levels Color", group=G_LVLS)
colorPWLvl = input.color(color.new(#5b9cf6, 30), "Weekly Levels Color", group=G_LVLS)
colorPMLvl = input.color(color.new(#ff9800, 30), "Monthly Levels Color", group=G_LVLS)
colorNYMid = input.color(color.gray, "NY Midnight Color", group=G_LVLS)

showRZ           = input.bool(true, "Show Reaction Zones", group=G_RZ)
rzProximityMult = input.float(3.0, "Actionable Proximity (ATR Mult)", minval=0.5, step=0.5, group=G_RZ, tooltip="Only show zones within this ATR distance from current price.")
rzMergeZones    = input.bool(true, "Merge Overlapping Zones", group=G_RZ)
showRZLabels    = input.bool(true, "Show Zone Labels", group=G_RZ)
showRZCE        = input.bool(true, "Show Equilibrium (CE)", group=G_RZ)
showRZDebug     = input.bool(false, "Show Selection Debug", group=G_RZ)
rzEntryColor    = input.color(color.new(#08ffd6, 60), "Entry Zone Color", group=G_RZ)
rzTargetColor   = input.color(color.new(#5b9cf6, 80), "Target Zone Color", group=G_RZ)
rzBearColor     = input.color(color.new(#ff0015, 60), "Bearish Zone Color", group=G_RZ)

// --- HTF Settings ---
G_HTF        = "Higher Timeframe Structure"
showHTF      = input.bool(true, "Show HTF Structure", group=G_HTF)
htf1Tf       = input.timeframe("60", "HTF 1 Timeframe", group=G_HTF)
htf1SwingLen = input.int(5, "HTF 1 Swing Strength", group=G_HTF)
htf2Tf       = input.timeframe("240", "HTF 2 Timeframe", group=G_HTF)
htf2SwingLen = input.int(5, "HTF 2 Swing Strength", group=G_HTF)
htfColor1    = input.color(color.new(#5b9cf6, 30), "HTF 1 Level Color", group=G_HTF)
htfColor2    = input.color(color.new(#ff9800, 30), "HTF 2 Level Color", group=G_HTF)

// --- Calculations ---
// Liquidity pools keep historical source bars and later reuse them as drawing anchors.
// Reserve a deeper buffer so line/label rendering from old pools does not exceed Pine's inferred history.
max_bars_back(time, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)
isNewDay = ta.change(time("D")) != 0
isNewWeek = ta.change(time("W")) != 0
isNewMonth = ta.change(time("M")) != 0
avgVol   = ta.sma(volume, 20)
highVol  = volume > avgVol

[pdh, pdl, pdc, dO] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], open[0]], lookahead=barmerge.lookahead_on)
[pwh, pwl, wO] = request.security(syminfo.tickerid, "W", [high[1], low[1], open[0]], lookahead=barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)

isNewDayNY = hour(time, "America/New_York") == 0 and minute(time, "America/New_York") == 0
var float nyMidnight = na
if isNewDayNY
    nyMidnight := open

inAsia   = not na(time(timeframe.period, asiaSession, "UTC"))
inLondon = not na(time(timeframe.period, londonSess, "UTC"))
inNY     = not na(time(timeframe.period, nySess, "UTC"))

bgcolor(showLondon and inLondon ? colorLon : na)
bgcolor(showNY and inNY ? colorNYK : na)

// --- HTF Structure Logic ---
f_getHtfSwings(len) =>
    [ta.pivothigh(high, len, len), ta.pivotlow(low, len, len)]

[htf1PH, htf1PL] = request.security(syminfo.tickerid, htf1Tf, f_getHtfSwings(htf1SwingLen), lookahead=barmerge.lookahead_on)
[htf2PH, htf2PL] = request.security(syminfo.tickerid, htf2Tf, f_getHtfSwings(htf2SwingLen), lookahead=barmerge.lookahead_on)

var float lastHtf1PH = na
var float lastHtf1PL = na
var float lastHtf2PH = na
var float lastHtf2PL = na

if not na(htf1PH)
    lastHtf1PH := htf1PH
if not na(htf1PL)
    lastHtf1PL := htf1PL
if not na(htf2PH)
    lastHtf2PH := htf2PH
if not na(htf2PL)
    lastHtf2PL := htf2PL

// HTF Bias Calculation
htf1Bias = close > lastHtf1PH ? "BULL" : close < lastHtf1PL ? "BEAR" : "NEUT"
htf2Bias = close > lastHtf2PH ? "BULL" : close < lastHtf2PL ? "BEAR" : "NEUT"

plot(showHTF ? lastHtf1PH : na, "HTF 1 High", htfColor1, 1, plot.style_linebr)
plot(showHTF ? lastHtf1PL : na, "HTF 1 Low", htfColor1, 1, plot.style_linebr)
plot(showHTF ? lastHtf2PH : na, "HTF 2 High", htfColor2, 1, plot.style_linebr)
plot(showHTF ? lastHtf2PL : na, "HTF 2 Low", htfColor2, 1, plot.style_linebr)

var float asiaH = na
var float asiaL = na
var box asiaBox = na
var int asiaStartBar = na
if inAsia and not inAsia[1]
    asiaH := high
    asiaL := low
    asiaStartBar := bar_index
    if showAsia
        asiaBox := box.new(bar_index, asiaH, bar_index, asiaL, border_color=colorAsia, bgcolor=color.new(colorAsia, 90))
else if inAsia
    asiaH := math.max(high, nz(asiaH, high))
    asiaL := math.min(low, nz(asiaL, low))
    if showAsia and not na(asiaBox)
        box.set_top(asiaBox, asiaH)
        box.set_bottom(asiaBox, asiaL)
        box.set_right(asiaBox, bar_index)

var float londonH = na
var float londonL = na
var int londonStartBar = na
if inLondon and not inLondon[1]
    londonH := high
    londonL := low
    londonStartBar := bar_index
else if inLondon
    londonH := math.max(high, nz(londonH, high))
    londonL := math.min(low, nz(londonL, low))

var float nySessH = na
var float nySessL = na
var int nySessStartBar = na
if inNY and not inNY[1]
    nySessH := high
    nySessL := low
    nySessStartBar := bar_index
else if inNY
    nySessH := math.max(high, nz(nySessH, high))
    nySessL := math.min(low, nz(nySessL, low))

var float dPOC = na
if isNewDay or highVol
    dPOC := hl2

plot(showVP ? dPOC : na, "Daily Reference", colorPOC, 2, plot.style_linebr)

var bool pdhConsumed = false
var bool pdlConsumed = false
var bool pwhConsumed = false
var bool pwlConsumed = false
var bool pmhConsumed = false
var bool pmlConsumed = false

if isNewDay
    pdhConsumed := false
    pdlConsumed := false
if isNewWeek
    pwhConsumed := false
    pwlConsumed := false
if isNewMonth
    pmhConsumed := false
    pmlConsumed := false

if not na(pdh) and high >= pdh
    pdhConsumed := true
if not na(pdl) and low <= pdl
    pdlConsumed := true
if not na(pwh) and high >= pwh
    pwhConsumed := true
if not na(pwl) and low <= pwl
    pwlConsumed := true
if not na(pmh) and high >= pmh
    pmhConsumed := true
if not na(pml) and low <= pml
    pmlConsumed := true

f_liqLabelSize() =>
    liqLabelSize == "Tiny" ? size.tiny : liqLabelSize == "Small" ? size.small : size.normal

f_breakoutLabelSize() =>
    breakoutLabelSize == "Tiny" ? size.tiny : breakoutLabelSize == "Small" ? size.small : size.normal

f_raidLabelSize() =>
    raidLabelSize == "Tiny" ? size.tiny : raidLabelSize == "Small" ? size.small : size.normal

f_updateLevel(bool show, float val, string txt, color clr, line l, label lb, int width) =>
    if show and not na(val)
        levelLeft = math.max(bar_index - 50, 0)
        levelRight = bar_index + 10
        line.set_xy1(l, levelLeft, val)
        line.set_xy2(l, levelRight, val)
        line.set_color(l, clr)
        line.set_width(l, width)
        label.set_xy(lb, levelRight, val)
        label.set_textcolor(lb, clr)
        label.set_text(lb, txt + " (" + str.tostring(val, format.mintick) + ")")
    else
        line.set_y1(l, na)
        line.set_y2(l, na)
        label.set_y(lb, na)
        label.set_text(lb, "")

var line lnPDH = line.new(na, na, na, na)
var label lbPDH = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var line lnPDL = line.new(na, na, na, na)
var label lbPDL = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var line lnPDC = line.new(na, na, na, na)
var label lbPDC = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var line lnDO = line.new(na, na, na, na)
var label lbDO = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var line lnPWH = line.new(na, na, na, na)
var label lbPWH = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var line lnPWL = line.new(na, na, na, na)
var label lbPWL = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var line lnPMH = line.new(na, na, na, na)
var label lbPMH = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var line lnPML = line.new(na, na, na, na)
var label lbPML = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var line lnNYMid = line.new(na, na, na, na)
var label lbNYMid = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)

if barstate.islast
    f_updateLevel(showPDH and not pdhConsumed, pdh, "PDH", colorPDLvl, lnPDH, lbPDH, 1)
    f_updateLevel(showPDL and not pdlConsumed, pdl, "PDL", colorPDLvl, lnPDL, lbPDL, 1)
    f_updateLevel(showPDC, pdc, "PDC", colorPDLvl, lnPDC, lbPDC, 1)
    f_updateLevel(showDO, dO, "DO", colorPDLvl, lnDO, lbDO, 1)
    f_updateLevel(showPWH and not pwhConsumed, pwh, "PWH", colorPWLvl, lnPWH, lbPWH, 2)
    f_updateLevel(showPWL and not pwlConsumed, pwl, "PWL", colorPWLvl, lnPWL, lbPWL, 2)
    f_updateLevel(showPMH and not pmhConsumed, pmh, "PMH", colorPMLvl, lnPMH, lbPMH, 2)
    f_updateLevel(showPML and not pmlConsumed, pml, "PML", colorPMLvl, lnPML, lbPML, 2)
    f_updateLevel(showNYMid, nyMidnight, "NY-Mid", colorNYMid, lnNYMid, lbNYMid, 1)

// --- Advanced Liquidity Engine ---
var liq_pools = array.new<liq_pool>(0)
var liq_render_lines = array.new_line(0)
var liq_render_labels = array.new_label(0)
var recentSwingHighs = array.new_float(0)
var recentSwingHighBars = array.new_int(0)
var recentSwingLows = array.new_float(0)
var recentSwingLowBars = array.new_int(0)

// Volatility-Based Auto Optimization
atrVal = ta.atr(14)
max_bars_back(atrVal, 1000)
volScale = atrVal / nz(ta.sma(atrVal, 200), atrVal)
dynLen = autoLiqPivot ? math.max(5, math.min(40, math.round(liqPivotLen * volScale))) : liqPivotLen
float chartTfSec = math.max(float(timeframe.in_seconds(timeframe.period)), 60.0)
float liqRangeHigh = ta.highest(high, liqRangeLookback)
float liqRangeLow = ta.lowest(low, liqRangeLookback)
float liqRangeSpan = math.max(liqRangeHigh - liqRangeLow, syminfo.mintick * 20)
float liqExtThreshold = liqRangeSpan * liqExtBoundaryPct

f_liqCurrentSessionContext() =>
    inLondon ? "London" : inNY ? "New York" : inAsia ? "Asia" : "Off Session"

f_liqIsDevelopingSession(liq_pool pool) =>
    pool.baseType == "DEV_SESSION"

f_liqIsEventEligible(liq_pool pool) =>
    not f_liqIsDevelopingSession(pool)

f_liqIsExternal(string poolType) =>
    poolType == "EXTERNAL" or poolType == "SESSION" or poolType == "PERIOD" or poolType == "EQ"

f_liqClusterTolerance(float price) =>
    math.max(syminfo.mintick * 4, math.min(atrVal * 0.10, price * 0.0025))

f_liqTouchTolerance(float price) =>
    math.max(syminfo.mintick * 2, math.min(atrVal * 0.04, price * 0.0010))

f_liqSourceSeconds(liq_pool pool) =>
    pool.baseType == "PERIOD" ? (pool.sourceTF == "M" ? 2592000.0 : pool.sourceTF == "W" ? 604800.0 : 86400.0) : (pool.baseType == "SESSION" or pool.baseType == "DEV_SESSION") ? 21600.0 : pool.baseType == "EQ" ? chartTfSec * 6.0 : chartTfSec

f_liqAgeUnits(liq_pool pool) =>
    float ageSec = math.max(float(time - pool.creationTime) / 1000.0, 0.0)
    float sourceSec = math.max(f_liqSourceSeconds(pool), 60.0)
    float eventPenalty = math.max(pool.timesTagged - 1, 0) * 0.35 + (pool.isSwept ? 0.75 : 0.0) + (pool.state == "CONSUMED" ? 0.75 : pool.state == "SWEPT" ? 0.35 : 0.0)
    ageSec / sourceSec + eventPenalty

f_liqExpiryUnits(liq_pool pool) =>
    float baseUnits = pool.poolType == "PERIOD" ? (pool.sourceTF == "M" ? 10.0 : pool.sourceTF == "W" ? 6.0 : 3.0) : pool.poolType == "SESSION" ? 2.0 : pool.poolType == "DEV_SESSION" ? 0.75 : pool.poolType == "EQ" ? 4.0 : pool.poolType == "EXTERNAL" ? 5.0 : 2.5
    float scale = math.max(ageExpiry / 400.0, 0.5)
    baseUnits * scale

f_liqIsExpired(liq_pool pool) =>
    f_liqAgeUnits(pool) > f_liqExpiryUnits(pool)

f_liqCalculatedCleanliness(liq_pool pool) =>
    float score = 72.0
    score += math.min(pool.clusterSize - 1, 3) * 7.0
    score -= math.max(pool.timesTagged - 1, 0) * 8.0
    score -= math.max(f_liqAgeUnits(pool) - 1.0, 0.0) * 6.0
    score -= pool.poolType == "INTERNAL" ? 8.0 : 0.0
    score -= pool.state == "CONSUMED" ? 30.0 : pool.state == "SWEPT" ? 12.0 : pool.state == "TAGGED" ? 5.0 : 0.0
    math.max(0.0, math.min(100.0, score))

f_liqFreshnessScore(liq_pool pool) =>
    float score = pool.structuralRank
    score += pool.poolType == "EQ" ? 10.0 : 0.0
    score += math.min(pool.clusterSize - 1, 3) * 4.0
    score -= f_liqAgeUnits(pool) * 12.0
    score -= math.max(pool.timesTagged - 1, 0) * 6.0
    score -= pool.state == "CONSUMED" ? 25.0 : pool.state == "SWEPT" ? 10.0 : 0.0
    math.max(0.0, math.min(100.0, score))

f_liqRetentionScore(liq_pool pool) =>
    pool.structuralRank + f_liqFreshnessScore(pool) * 0.60 + f_liqCalculatedCleanliness(pool) * 0.40

f_liqCompactBaseLabel(liq_pool pool) =>
    string txt = pool.baseLabel
    if pool.baseType == "SWING"
        txt := pool.poolType == "EXTERNAL" ? (pool.side == "BSL" ? "Ext BSL" : "Ext SSL") : (pool.side == "BSL" ? "Int BSL" : "Int SSL")
    else if pool.baseType == "EQ"
        txt := pool.side == "BSL" ? "EQH" : "EQL"
    else if pool.baseLabel == "DEV LONDON H"
        txt := "Dev London H"
    else if pool.baseLabel == "DEV LONDON L"
        txt := "Dev London L"
    else if pool.baseLabel == "DEV NY H"
        txt := "Dev NY H"
    else if pool.baseLabel == "DEV NY L"
        txt := "Dev NY L"
    else if pool.baseLabel == "DEV ASIA H"
        txt := "Dev Asia H"
    else if pool.baseLabel == "DEV ASIA L"
        txt := "Dev Asia L"
    else if pool.baseLabel == "LONDON H"
        txt := inLondon ? "Prev London H" : "London H"
    else if pool.baseLabel == "LONDON L"
        txt := inLondon ? "Prev London L" : "London L"
    else if pool.baseLabel == "NY H"
        txt := inNY ? "Prev NY H" : "NY H"
    else if pool.baseLabel == "NY L"
        txt := inNY ? "Prev NY L" : "NY L"
    else if pool.baseLabel == "ASIA H"
        txt := inAsia ? "Prev Asia H" : "Asia H"
    else if pool.baseLabel == "ASIA L"
        txt := inAsia ? "Prev Asia L" : "Asia L"
    txt

f_liqDisplayLabel(liq_pool pool) =>
    txt = f_liqCompactBaseLabel(pool)
    if liqShowDebugMetrics
        bool isClusterLabel = pool.poolType == "EQ"
        if pool.clusterSize > 1 and not isClusterLabel
            txt += " x" + str.tostring(pool.clusterSize)
        if pool.timesTagged > 0
            txt += " T" + str.tostring(pool.timesTagged)
        if pool.isInducementCandidate
            txt += " IND"
        if pool.state == "TAGGED"
            txt += " [TAG]"
        else if pool.state == "SWEPT"
            txt += " [SWP]"
        else if pool.state == "CONSUMED"
            txt += " [CON]"
    txt

f_liqLabelSpacing() =>
    math.max(syminfo.mintick * 16, atrVal * 0.06)

f_liqRenderMergeTolerance(float price) =>
    math.max(syminfo.mintick * 8, math.min(atrVal * 0.02, price * 0.0004))

f_liqRenderPriority(liq_pool pool) =>
    score = pool.structuralRank
    score += f_liqFreshnessScore(pool) * 0.35
    score += f_liqCalculatedCleanliness(pool) * 0.15
    score

f_liqDistanceAtr(liq_pool pool) =>
    atrVal > 0 ? math.abs(pool.price - close) / atrVal : 999.0

f_liqIsRenderableActive(liq_pool pool) =>
    bool activeState = pool.state == "FRESH" or pool.state == "TAGGED"
    bool importantType = pool.poolType == "PERIOD" or pool.poolType == "SESSION" or pool.poolType == "EQ" or pool.poolType == "EXTERNAL"
    bool developingSessionVisible = pool.poolType == "DEV_SESSION" and showDevelopingSessionLevels
    bool internalActionable = pool.poolType == "INTERNAL" and pool.isInducementCandidate and f_liqDistanceAtr(pool) <= 1.0
    activeState and (importantType or internalActionable or developingSessionVisible)

f_liqIsRenderableSwept(liq_pool pool) =>
    showSweptLiquidity and pool.state == "SWEPT" and (bar_index - nz(pool.lastRefreshBar, pool.sourceBar)) <= sweepMssTimeoutBars and f_liqDistanceAtr(pool) <= liqContextAtr

f_liqShouldRenderPool(liq_pool pool) =>
    pool.state != "CONSUMED" and (f_liqIsRenderableActive(pool) or f_liqIsRenderableSwept(pool))

f_liqVisualScore(liq_pool pool) =>
    float distAtr = f_liqDistanceAtr(pool)
    float score = f_liqRenderPriority(pool)
    score += math.max(0.0, 18.0 - distAtr * 5.0)
    score += pool.poolType == "DEV_SESSION" ? -12.0 : 0.0
    score += pool.state == "TAGGED" ? 5.0 : pool.state == "SWEPT" ? -8.0 : 0.0
    score

f_liqHasDedicatedOverlay(liq_pool pool) =>
    (pool.baseLabel == "PDH" and showPDH) or
     (pool.baseLabel == "PDL" and showPDL) or
     (pool.baseLabel == "PWH" and showPWH) or
     (pool.baseLabel == "PWL" and showPWL) or
     (pool.baseLabel == "PMH" and showPMH) or
     (pool.baseLabel == "PML" and showPML)

f_newLiqPool(string side, string poolType, string baseType, float price, int sourceBar, int creationTime, string label, string baseLabel, string sourceTF, float structuralRank, string sessionContext, float cleanlinessScore, bool isInducementCandidate) =>
    liq_pool.new(side, poolType, baseType, price, sourceBar, false, label, baseLabel, 0, 1, int(na), sourceBar, int(na), na, int(na), na, int(na), int(na), creationTime, sourceTF, structuralRank, 0, cleanlinessScore, sessionContext, isInducementCandidate, "FRESH")

f_liqRemoveNamedPool(string label) =>
    if liq_pools.size() > 0
        for i = liq_pools.size() - 1 to 0
            pool = liq_pools.get(i)
            if pool.baseLabel == label
                liq_pools.remove(i)
    true

f_liqUpsertNamedPool(string side, string poolType, string baseType, float price, int sourceBar, string label, string sourceTF, float structuralRank, string sessionContext, float cleanlinessScore, bool isInducementCandidate, bool preserveState) =>
    if not na(price)
        int existingIdx = na
        if liq_pools.size() > 0
            for i = 0 to liq_pools.size() - 1
                pool = liq_pools.get(i)
                if pool.baseLabel == label
                    existingIdx := i
                    break
        if preserveState and not na(existingIdx)
            pool = liq_pools.get(existingIdx)
            bool sameNarrativeLevel = math.abs(pool.price - price) <= f_liqClusterTolerance(price)
            if sameNarrativeLevel
                pool.side := side
                pool.poolType := poolType
                pool.baseType := baseType
                pool.price := price
                pool.sourceBar := sourceBar
                pool.poolLabel := label
                pool.baseLabel := label
                pool.sourceTF := sourceTF
                pool.structuralRank := structuralRank
                pool.sessionContext := sessionContext
                pool.cleanlinessScore := cleanlinessScore
                pool.isInducementCandidate := isInducementCandidate
            else
                liq_pools.remove(existingIdx)
                liq_pools.push(f_newLiqPool(side, poolType, baseType, price, sourceBar, time, label, label, sourceTF, structuralRank, sessionContext, cleanlinessScore, isInducementCandidate))
        else
            f_liqRemoveNamedPool(label)
            liq_pools.push(f_newLiqPool(side, poolType, baseType, price, sourceBar, time, label, label, sourceTF, structuralRank, sessionContext, cleanlinessScore, isInducementCandidate))
    true

f_liqUpsertSwingPool(string side, float price, int sourceBar, float seedRank, bool externalSeed) =>
    if not na(price)
        bool merged = false
        int bestIdx = na
        float bestDist = 10e10
        float tol = f_liqClusterTolerance(price)
        if liq_pools.size() > 0
            for i = 0 to liq_pools.size() - 1
                pool = liq_pools.get(i)
                if pool.baseType == "SWING" and pool.side == side and pool.state != "CONSUMED"
                    dist = math.abs(pool.price - price)
                    if dist <= tol and dist < bestDist
                        bestIdx := i
                        bestDist := dist
        if not na(bestIdx)
            pool = liq_pools.get(bestIdx)
            pool.price := side == "BSL" ? math.max(pool.price, price) : math.min(pool.price, price)
            pool.clusterSize += 1
            pool.lastRefreshBar := sourceBar
            pool.structuralRank := math.max(pool.structuralRank, seedRank)
            pool.sessionContext := f_liqCurrentSessionContext()
            pool.cleanlinessScore := math.min(pool.cleanlinessScore + 6.0, 100.0)
            merged := true
        if not merged
            string startingType = externalSeed ? "EXTERNAL" : "INTERNAL"
            string startingLabel = startingType + " " + side
            liq_pools.push(f_newLiqPool(side, startingType, "SWING", price, sourceBar, time, startingLabel, "SWING " + side, timeframe.period, seedRank, f_liqCurrentSessionContext(), 72.0, false))
    true

f_pushRecentSwing(float[] priceArr, int[] barArr, float price, int swingBar) =>
    if not na(price)
        array.push(priceArr, price)
        array.push(barArr, swingBar)
        int maxKeep = math.max(eqStructuralLookback * 3, 40)
        while array.size(priceArr) > maxKeep
            array.shift(priceArr)
            array.shift(barArr)
    true

f_eqTolerance(float refPrice) =>
    math.max(f_liqTouchTolerance(refPrice), refPrice * (eqThreshold / 100.0))

find_eq_cluster(float[] priceArr, int[] barArr, int lookbackN) =>
    float bestPrice = na
    int bestCount = 0
    int bestLastBar = na
    float bestScore = 0.0
    int available = array.size(priceArr)
    if available >= 2
        int startIdx = math.max(0, available - lookbackN)
        int localStartIdx = math.max(0, available - eqLocalLookback)
        for i = available - 1 to startIdx
            float refPrice = array.get(priceArr, i)
            float tol = f_eqTolerance(refPrice)
            int matchCount = 0
            int localTouches = 0
            float sumPrice = 0.0
            float minMatch = na
            float maxMatch = na
            int firstTouchBar = na
            int lastTouchBar = na
            for j = startIdx to available - 1
                float cmpPrice = array.get(priceArr, j)
                int cmpBar = array.get(barArr, j)
                if math.abs(cmpPrice - refPrice) <= tol
                    matchCount += 1
                    sumPrice += cmpPrice
                    minMatch := na(minMatch) ? cmpPrice : math.min(minMatch, cmpPrice)
                    maxMatch := na(maxMatch) ? cmpPrice : math.max(maxMatch, cmpPrice)
                    if j >= localStartIdx
                        localTouches += 1
                    firstTouchBar := na(firstTouchBar) ? cmpBar : math.min(firstTouchBar, cmpBar)
                    lastTouchBar := na(lastTouchBar) ? cmpBar : math.max(lastTouchBar, cmpBar)
            if matchCount >= 2 and not na(lastTouchBar) and not na(firstTouchBar)
                int ageBars = bar_index - lastTouchBar
                int spanBars = lastTouchBar - firstTouchBar
                if ageBars <= eqClusterMaxAge and spanBars <= eqClusterMaxAge
                    float avgPrice = sumPrice / matchCount
                    float dispersionPct = avgPrice != 0 ? (nz(maxMatch, avgPrice) - nz(minMatch, avgPrice)) / avgPrice * 100.0 : 0.0
                    float recencyScore = math.max(0.0, 20.0 * (1.0 - float(ageBars) / eqClusterMaxAge))
                    float similarityScore = math.max(0.0, 20.0 - (dispersionPct / math.max(eqThreshold, 0.01)) * 8.0)
                    float repeatScore = matchCount * 14.0 + localTouches * 6.0
                    float spanPenalty = math.max(0.0, float(spanBars - eqLocalLookback) * 0.15)
                    float distAtr = atrVal > 0 ? math.abs(avgPrice - close) / atrVal : 0.0
                    float locationScore = math.max(0.0, 10.0 - math.max(distAtr - 4.0, 0.0) * 2.0)
                    float score = repeatScore + recencyScore + similarityScore + locationScore - spanPenalty
                    if score > bestScore or (score == bestScore and (na(bestLastBar) or lastTouchBar > bestLastBar))
                        bestPrice := avgPrice
                        bestCount := matchCount
                        bestLastBar := lastTouchBar
                        bestScore := score
    [bestPrice, bestCount, bestLastBar, bestScore]

select_cluster(float localPrice, int localCount, int localBar, float localScore, float structuralPrice, int structuralCount, int structuralBar, float structuralScore) =>
    float chosenPrice = na
    int chosenCount = 0
    int chosenBar = na
    float chosenScore = 0.0
    if not na(localPrice) or not na(structuralPrice)
        bool useStructural = false
        if na(localPrice)
            useStructural := true
        else if not na(structuralPrice)
            useStructural := structuralScore > localScore + 4.0 or (structuralCount > localCount and structuralScore >= localScore)
        chosenPrice := useStructural ? structuralPrice : localPrice
        chosenCount := useStructural ? structuralCount : localCount
        chosenBar := useStructural ? structuralBar : localBar
        chosenScore := useStructural ? structuralScore : localScore
    [chosenPrice, chosenCount, chosenBar, chosenScore]

majPH = ta.pivothigh(high, dynLen * 2, dynLen * 2)
majPL = ta.pivotlow(low, dynLen * 2, dynLen * 2)
minPH = ta.pivothigh(high, dynLen, dynLen)
minPL = ta.pivotlow(low, dynLen, dynLen)

if barstate.isconfirmed
    if not na(majPH)
        int majorHighBar = bar_index - dynLen * 2
        bool majorHighExternal = majPH >= (liqRangeHigh - liqExtThreshold)
        f_liqUpsertSwingPool("BSL", majPH, majorHighBar, majorHighExternal ? 82.0 : 60.0, majorHighExternal)
        f_pushRecentSwing(recentSwingHighs, recentSwingHighBars, majPH, majorHighBar)
    if not na(majPL)
        int majorLowBar = bar_index - dynLen * 2
        bool majorLowExternal = majPL <= (liqRangeLow + liqExtThreshold)
        f_liqUpsertSwingPool("SSL", majPL, majorLowBar, majorLowExternal ? 82.0 : 60.0, majorLowExternal)
        f_pushRecentSwing(recentSwingLows, recentSwingLowBars, majPL, majorLowBar)
    if not na(minPH) and na(majPH)
        int minorHighBar = bar_index - dynLen
        bool minorHighExternal = minPH >= (liqRangeHigh - liqExtThreshold)
        f_liqUpsertSwingPool("BSL", minPH, minorHighBar, minorHighExternal ? 72.0 : 42.0, minorHighExternal)
        f_pushRecentSwing(recentSwingHighs, recentSwingHighBars, minPH, minorHighBar)
    if not na(minPL) and na(majPL)
        int minorLowBar = bar_index - dynLen
        bool minorLowExternal = minPL <= (liqRangeLow + liqExtThreshold)
        f_liqUpsertSwingPool("SSL", minPL, minorLowBar, minorLowExternal ? 72.0 : 42.0, minorLowExternal)
        f_pushRecentSwing(recentSwingLows, recentSwingLowBars, minPL, minorLowBar)

if showDevelopingSessionLevels and inAsia and not na(asiaH) and not na(asiaL)
    f_liqUpsertNamedPool("BSL", "DEV_SESSION", "DEV_SESSION", asiaH, nz(asiaStartBar, bar_index), "DEV ASIA H", timeframe.period, 52.0, "Asia", 66.0, false, true)
    f_liqUpsertNamedPool("SSL", "DEV_SESSION", "DEV_SESSION", asiaL, nz(asiaStartBar, bar_index), "DEV ASIA L", timeframe.period, 52.0, "Asia", 66.0, false, true)
else
    f_liqRemoveNamedPool("DEV ASIA H")
    f_liqRemoveNamedPool("DEV ASIA L")

if showDevelopingSessionLevels and inLondon and not na(londonH) and not na(londonL)
    f_liqUpsertNamedPool("BSL", "DEV_SESSION", "DEV_SESSION", londonH, nz(londonStartBar, bar_index), "DEV LONDON H", timeframe.period, 56.0, "London", 68.0, false, true)
    f_liqUpsertNamedPool("SSL", "DEV_SESSION", "DEV_SESSION", londonL, nz(londonStartBar, bar_index), "DEV LONDON L", timeframe.period, 56.0, "London", 68.0, false, true)
else
    f_liqRemoveNamedPool("DEV LONDON H")
    f_liqRemoveNamedPool("DEV LONDON L")

if showDevelopingSessionLevels and inNY and not na(nySessH) and not na(nySessL)
    f_liqUpsertNamedPool("BSL", "DEV_SESSION", "DEV_SESSION", nySessH, nz(nySessStartBar, bar_index), "DEV NY H", timeframe.period, 58.0, "New York", 70.0, false, true)
    f_liqUpsertNamedPool("SSL", "DEV_SESSION", "DEV_SESSION", nySessL, nz(nySessStartBar, bar_index), "DEV NY L", timeframe.period, 58.0, "New York", 70.0, false, true)
else
    f_liqRemoveNamedPool("DEV NY H")
    f_liqRemoveNamedPool("DEV NY L")

if not inAsia and inAsia[1] and not na(asiaH) and not na(asiaL)
    f_liqUpsertNamedPool("BSL", "SESSION", "SESSION", asiaH, bar_index - 1, "ASIA H", timeframe.period, 68.0, "Asia", 78.0, false, false)
    f_liqUpsertNamedPool("SSL", "SESSION", "SESSION", asiaL, bar_index - 1, "ASIA L", timeframe.period, 68.0, "Asia", 78.0, false, false)
if not inLondon and inLondon[1] and not na(londonH) and not na(londonL)
    f_liqUpsertNamedPool("BSL", "SESSION", "SESSION", londonH, bar_index - 1, "LONDON H", timeframe.period, 74.0, "London", 82.0, false, false)
    f_liqUpsertNamedPool("SSL", "SESSION", "SESSION", londonL, bar_index - 1, "LONDON L", timeframe.period, 74.0, "London", 82.0, false, false)
if not inNY and inNY[1] and not na(nySessH) and not na(nySessL)
    f_liqUpsertNamedPool("BSL", "SESSION", "SESSION", nySessH, bar_index - 1, "NY H", timeframe.period, 78.0, "New York", 84.0, false, false)
    f_liqUpsertNamedPool("SSL", "SESSION", "SESSION", nySessL, bar_index - 1, "NY L", timeframe.period, 78.0, "New York", 84.0, false, false)
if isNewDay and not na(pdh) and not na(pdl)
    f_liqUpsertNamedPool("BSL", "PERIOD", "PERIOD", pdh, bar_index, "PDH", "D", 86.0, "Prev Day", 84.0, false, false)
    f_liqUpsertNamedPool("SSL", "PERIOD", "PERIOD", pdl, bar_index, "PDL", "D", 86.0, "Prev Day", 84.0, false, false)
if isNewWeek and not na(pwh) and not na(pwl)
    f_liqUpsertNamedPool("BSL", "PERIOD", "PERIOD", pwh, bar_index, "PWH", "W", 92.0, "Prev Week", 88.0, false, false)
    f_liqUpsertNamedPool("SSL", "PERIOD", "PERIOD", pwl, bar_index, "PWL", "W", 92.0, "Prev Week", 88.0, false, false)
if isNewMonth and not na(pmh) and not na(pml)
    f_liqUpsertNamedPool("BSL", "PERIOD", "PERIOD", pmh, bar_index, "PMH", "M", 98.0, "Prev Month", 92.0, false, false)
    f_liqUpsertNamedPool("SSL", "PERIOD", "PERIOD", pml, bar_index, "PML", "M", 98.0, "Prev Month", 92.0, false, false)

[eqhLocalLevel, eqhLocalCount, eqhLocalBar, eqhLocalScore] = find_eq_cluster(recentSwingHighs, recentSwingHighBars, eqLocalLookback)
[eqhStructLevel, eqhStructCount, eqhStructBar, eqhStructScore] = find_eq_cluster(recentSwingHighs, recentSwingHighBars, eqStructuralLookback)
[eqhLevel, eqhCount, eqhLastBar, eqhScore] = select_cluster(eqhLocalLevel, eqhLocalCount, eqhLocalBar, eqhLocalScore, eqhStructLevel, eqhStructCount, eqhStructBar, eqhStructScore)
[eqlLocalLevel, eqlLocalCount, eqlLocalBar, eqlLocalScore] = find_eq_cluster(recentSwingLows, recentSwingLowBars, eqLocalLookback)
[eqlStructLevel, eqlStructCount, eqlStructBar, eqlStructScore] = find_eq_cluster(recentSwingLows, recentSwingLowBars, eqStructuralLookback)
[eqlLevel, eqlCount, eqlLastBar, eqlScore] = select_cluster(eqlLocalLevel, eqlLocalCount, eqlLocalBar, eqlLocalScore, eqlStructLevel, eqlStructCount, eqlStructBar, eqlStructScore)

if showEQ and not na(eqhLevel)
    float eqhRank = math.min(96.0, 70.0 + math.min(eqhCount, 4) * 4.0 + math.min(eqhScore, 40.0) * 0.25)
    f_liqUpsertNamedPool("BSL", "EQ", "EQ", eqhLevel, nz(eqhLastBar, bar_index), "EQH", timeframe.period, eqhRank, "Cluster", math.min(eqhScore, 100.0), false, true)
else
    f_liqRemoveNamedPool("EQH")
if showEQ and not na(eqlLevel)
    float eqlRank = math.min(96.0, 70.0 + math.min(eqlCount, 4) * 4.0 + math.min(eqlScore, 40.0) * 0.25)
    f_liqUpsertNamedPool("SSL", "EQ", "EQ", eqlLevel, nz(eqlLastBar, bar_index), "EQL", timeframe.period, eqlRank, "Cluster", math.min(eqlScore, 100.0), false, true)
else
    f_liqRemoveNamedPool("EQL")

if liq_pools.size() > 0
    for i = 0 to liq_pools.size() - 1
        pool = liq_pools.get(i)
        if pool.baseType == "SWING"
            bool boundaryPool = pool.side == "BSL" ? pool.price >= (liqRangeHigh - liqExtThreshold) : pool.price <= (liqRangeLow + liqExtThreshold)
            pool.poolType := boundaryPool ? "EXTERNAL" : "INTERNAL"
            pool.poolLabel := (boundaryPool ? "EXTERNAL " : "INTERNAL ") + pool.side
            pool.structuralRank := boundaryPool ? math.max(pool.structuralRank, 72.0) : math.min(pool.structuralRank, 58.0)
            if liqRangeSpan > 0
                float relPos = (pool.price - liqRangeLow) / liqRangeSpan
                pool.isInducementCandidate := pool.poolType == "INTERNAL" and ((pool.side == "BSL" and relPos > 0.55 and relPos < 0.95) or (pool.side == "SSL" and relPos < 0.45 and relPos > 0.05))
        else if pool.baseType == "SESSION"
            pool.poolType := "SESSION"
            pool.poolLabel := pool.baseLabel
            pool.structuralRank := str.contains(pool.baseLabel, "NY") ? 78.0 : str.contains(pool.baseLabel, "LONDON") ? 74.0 : 68.0
            pool.isInducementCandidate := false
        else if pool.baseType == "DEV_SESSION"
            pool.poolType := "DEV_SESSION"
            pool.poolLabel := pool.baseLabel
            pool.structuralRank := str.contains(pool.baseLabel, "DEV NY") ? 58.0 : str.contains(pool.baseLabel, "DEV LONDON") ? 56.0 : 52.0
            pool.isInducementCandidate := false
        else if pool.baseType == "PERIOD"
            pool.poolType := "PERIOD"
            pool.poolLabel := pool.baseLabel
            pool.structuralRank := pool.sourceTF == "M" ? 98.0 : pool.sourceTF == "W" ? 92.0 : 86.0
            pool.isInducementCandidate := false
        else if pool.baseType == "EQ"
            pool.poolType := "EQ"
            pool.poolLabel := pool.baseLabel
            pool.isInducementCandidate := false
        pool.cleanlinessScore := f_liqCalculatedCleanliness(pool)

    for i = 0 to liq_pools.size() - 1
        pool = liq_pools.get(i)
        if f_liqIsDevelopingSession(pool)
            pool.isSwept := false
            pool.state := "FRESH"
            pool.lastRefreshBar := bar_index
            pool.pendingSweepBar := int(na)
            pool.pendingSweepExtreme := na
            pool.pendingSweepExtremeBar := int(na)
            pool.pendingWickRatio := na
            pool.lastTouchBar := int(na)
            pool.takenBar := int(na)
            pool.timesTagged := 0
            pool.touchCount := 0
        else
            touchTol = f_liqTouchTolerance(pool.price)
            isTouch = (pool.side == "BSL" and high >= pool.price - touchTol and high <= pool.price) or (pool.side == "SSL" and low <= pool.price + touchTol and low >= pool.price)
            isTaken = (pool.side == "BSL" and high >= pool.price) or (pool.side == "SSL" and low <= pool.price)
            closeInside = (pool.side == "BSL" and close < pool.price) or (pool.side == "SSL" and close > pool.price)
            closeOutside = (pool.side == "BSL" and close > pool.price) or (pool.side == "SSL" and close < pool.price)
            acceptedOutside = closeOutside and ((pool.side == "BSL" and (close - pool.price) >= touchTol) or (pool.side == "SSL" and (pool.price - close) >= touchTol))
            if (isTouch or isTaken) and (na(pool.lastTouchBar) or pool.lastTouchBar != bar_index)
                pool.timesTagged += 1
                pool.touchCount := pool.timesTagged
                pool.lastTouchBar := bar_index
                pool.lastRefreshBar := bar_index
            if isTaken and na(pool.takenBar)
                pool.takenBar := bar_index
            if isTaken
                pool.state := closeInside ? "SWEPT" : acceptedOutside ? "CONSUMED" : "TAGGED"
            else if isTouch and pool.state == "FRESH"
                pool.state := "TAGGED"
        pool.cleanlinessScore := f_liqCalculatedCleanliness(pool)

while liq_pools.size() > 80
    int dropIdx = 0
    float dropScore = f_liqRetentionScore(liq_pools.get(0))
    for i = 1 to liq_pools.size() - 1
        score = f_liqRetentionScore(liq_pools.get(i))
        if score < dropScore
            dropIdx := i
            dropScore := score
    liq_pools.remove(dropIdx)

if barstate.islast
    if liq_render_lines.size() > 0
        for i = liq_render_lines.size() - 1 to 0
            line.delete(liq_render_lines.get(i))
        array.clear(liq_render_lines)
    if liq_render_labels.size() > 0
        for i = liq_render_labels.size() - 1 to 0
            label.delete(liq_render_labels.get(i))
        array.clear(liq_render_labels)

    renderRows = array.new<liq_render_row>(0)
    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            p = liq_pools.get(i)
            if f_liqShouldRenderPool(p) and not f_liqHasDedicatedOverlay(p)
                int rowIdx = na
                mergeTol = f_liqRenderMergeTolerance(p.price)
                rowPriority = f_liqVisualScore(p)
                if renderRows.size() > 0
                    for j = 0 to renderRows.size() - 1
                        row = renderRows.get(j)
                        if row.side == p.side and math.abs(row.price - p.price) <= mergeTol
                            rowIdx := j
                            break
                if na(rowIdx)
                    array.push(renderRows, liq_render_row.new(p.side, p.price, p.sourceBar, f_liqIsExternal(p.poolType), f_liqDisplayLabel(p), rowPriority, 1, p.state))
                else
                    row = renderRows.get(rowIdx)
                    row.sourceBar := math.min(row.sourceBar, p.sourceBar)
                    row.isMajor := row.isMajor or f_liqIsExternal(p.poolType)
                    row.mergedCount += 1
                    if rowPriority > row.priority
                        row.priority := rowPriority
                        row.price := p.price
                        row.primaryText := f_liqDisplayLabel(p)
                        row.state := p.state

    if renderRows.size() > 1
        for i = 0 to renderRows.size() - 2
            for j = i + 1 to renderRows.size() - 1
                r1 = renderRows.get(i)
                r2 = renderRows.get(j)
                if r1.priority < r2.priority
                    renderRows.set(i, r2)
                    renderRows.set(j, r1)

    selectedRows = array.new<liq_render_row>(0)
    int selectedBSL = 0
    int selectedSSL = 0
    int selectedSweptBSL = 0
    int selectedSweptSSL = 0
    if renderRows.size() > 0
        for i = 0 to renderRows.size() - 1
            row = renderRows.get(i)
            bool isSweptRow = row.state == "SWEPT"
            bool sideHasRoom = row.side == "BSL" ? selectedBSL < liqMaxLevelsPerSide : selectedSSL < liqMaxLevelsPerSide
            bool sweptHasRoom = not isSweptRow or (row.side == "BSL" ? selectedSweptBSL == 0 : selectedSweptSSL == 0)
            if sideHasRoom and sweptHasRoom
                array.push(selectedRows, row)
                if row.side == "BSL"
                    selectedBSL += 1
                    if isSweptRow
                        selectedSweptBSL += 1
                else
                    selectedSSL += 1
                    if isSweptRow
                        selectedSweptSSL += 1

    if selectedRows.size() > 1
        for i = 0 to selectedRows.size() - 2
            for j = i + 1 to selectedRows.size() - 1
                r1 = selectedRows.get(i)
                r2 = selectedRows.get(j)
                if r1.price < r2.price
                    selectedRows.set(i, r2)
                    selectedRows.set(j, r1)

    float prevRowPrice = na
    int stackedOffset = 0
    float spacing = f_liqLabelSpacing()
    if selectedRows.size() > 0
        for i = 0 to selectedRows.size() - 1
            row = selectedRows.get(i)
            displayText = row.primaryText
            clr = row.isMajor ? liqMajorColor : liqMinorColor
            clr := row.state == "CONSUMED" ? color.new(clr, 65) : row.state == "SWEPT" ? color.new(clr, 40) : row.state == "TAGGED" ? color.new(clr, 20) : clr
            lineStyle = row.state == "CONSUMED" ? line.style_dotted : row.state == "SWEPT" ? line.style_dashed : row.isMajor ? line.style_solid : line.style_dashed
            array.push(liq_render_lines, line.new(row.sourceBar, row.price, bar_index + 5, row.price, color=clr, style=lineStyle))
            if showLiquidityLabels
                isNearPrev = not na(prevRowPrice) and math.abs(prevRowPrice - row.price) <= spacing
                stackedOffset := isNearPrev ? stackedOffset + 2 : 0
                prevRowPrice := row.price
                array.push(liq_render_labels, label.new(bar_index + 5 + stackedOffset, row.price, displayText, color=#00000000, textcolor=clr, style=label.style_label_left, size=f_liqLabelSize()))

// --- FVG Engine ---
var fvg_records = array.new<fvg_data>(0)
var fvg_boxes   = array.new<box>(0)
var line latestBullMitigationLine = line.new(na, na, na, na)
var line latestBearMitigationLine = line.new(na, na, na, na)
var int latestBullMitigationBar = na
var int latestBearMitigationBar = na
int mitigationDisplayBars = 12

fvgAutoThreshold = ta.cum((high - low) / low) / (bar_index + 1)
fvgThresholdVal = fvgAuto ? fvgAutoThreshold : fvgThreshold / 100

if showFVG
    bool isBullFVG = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > fvgThresholdVal
    bool isBearFVG = high < low[2] and close[1] < low[2] and (low[2] - high) / high > fvgThresholdVal

    if isBullFVG
        fvg_records.unshift(fvg_data.new(low, high[2], true, time, bar_index))
        fvg_boxes.unshift(box.new(bar_index-2, low, bar_index + fvgExtend, high[2], border_color=na, bgcolor=bullFVGColor))

    if isBearFVG
        fvg_records.unshift(fvg_data.new(low[2], high, false, time, bar_index))
        fvg_boxes.unshift(box.new(bar_index-2, low[2], bar_index + fvgExtend, high, border_color=na, bgcolor=bearFVGColor))

    if fvg_records.size() > 0
        for i = fvg_records.size() - 1 to 0
            get_fvg = fvg_records.get(i)
            mitigated = false
            if get_fvg.isBull
                if close < get_fvg.min
                    mitigated := true
                    if mitigationL
                        line.set_xy1(latestBullMitigationLine, bar_index - 5, get_fvg.min)
                        line.set_xy2(latestBullMitigationLine, bar_index + 8, get_fvg.min)
                        line.set_color(latestBullMitigationLine, bullFVGColor)
                        line.set_style(latestBullMitigationLine, line.style_dashed)
                        latestBullMitigationBar := bar_index
            else
                if close > get_fvg.max
                    mitigated := true
                    if mitigationL
                        line.set_xy1(latestBearMitigationLine, bar_index - 5, get_fvg.max)
                        line.set_xy2(latestBearMitigationLine, bar_index + 8, get_fvg.max)
                        line.set_color(latestBearMitigationLine, bearFVGColor)
                        line.set_style(latestBearMitigationLine, line.style_dashed)
                        latestBearMitigationBar := bar_index
            if mitigated
                fvg_records.remove(i)
                box.delete(fvg_boxes.remove(i))

if not mitigationL or (not na(latestBullMitigationBar) and (bar_index - latestBullMitigationBar) > mitigationDisplayBars)
    line.set_xy1(latestBullMitigationLine, na, na)
    line.set_xy2(latestBullMitigationLine, na, na)
if not mitigationL or (not na(latestBearMitigationBar) and (bar_index - latestBearMitigationBar) > mitigationDisplayBars)
    line.set_xy1(latestBearMitigationLine, na, na)
    line.set_xy2(latestBearMitigationLine, na, na)

// --- SMC & SD Stats ---
var bool waitS = false
var bool waitL = false
var float sExtH = na
var float sExtL = na
var float lSwh = na
var float lSwl = na
var float majSwh = na
var float majSwl = na
var float anchorMSS_L = na
var float anchorMSS_S = na
var int waitStartBarL = na
var int waitStartBarS = na
var float waitSweepLevelL = na
var float waitSweepLevelS = na
var float waitSweepTolL = na
var float waitSweepTolS = na
var string waitRaidTextL = ""
var string waitRaidTextS = ""
var label waitRaidLabelL = na
var label waitRaidLabelS = na
var int lastBreakoutBarBSL = na
var int lastBreakoutBarSSL = na
var float lastBreakoutPriceBSL = na
var float lastBreakoutPriceSSL = na
var float lastBreakoutTolBSL = na
var float lastBreakoutTolSSL = na
var label lastBreakoutLabelBSL = na
var label lastBreakoutLabelSSL = na
var string structureStatus = "Neutral"
var int tSetups = 0
var int w10 = 0
var int l10 = 0
var bool active = false
var bool bull = false
var float tSL = na
var float t10 = na
var int activeProjStartBar = na
var line activeProjLine = line.new(na, na, na, na)

avgBody = ta.sma(math.abs(close - open), 20)
disp    = math.abs(close - open) > (avgBody * dispMult)

swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)
majH = ta.pivothigh(high, swingLen * 3, swingLen * 3)
majL = ta.pivotlow(low, swingLen * 3, swingLen * 3)

if not na(swH)
    lSwh := swH
if not na(swL)
    lSwl := swL
if not na(majH)
    majSwh := majH
if not na(majL)
    majSwl := majL
// --- High-Fidelity Sweep Engine ---
bool swpBSL = false
bool swpSSL = false
string swpTxt = ""
float sweepGrade = 0.0
float sweepExtreme = na
float bestSweepPrice = na
float bestSweepTol = na
string bestSweepSide = ""
int bestSweepIdx = na
int sweepLabelBar = na
float sweepLabelPrice = na
int sweepConfirmBars = 2
float minSweepGrade = majorSweeps ? 40.0 : 20.0
float maxBreakoutDepth = atrVal * (sweepMaxDepth * 1.25)
float breakoutGrade = 0.0
float bestBreakoutPrice = na
float bestBreakoutTol = na
string bestBreakoutSide = ""
int bestBreakoutIdx = na
int breakoutLabelBar = na
float breakoutLabelPrice = na
string brkTxt = ""
float minBreakoutGrade = majorSweeps ? 55.0 : 35.0

if liq_pools.size() > 0
    for i = 0 to liq_pools.size() - 1
        p_s = liq_pools.get(i)

        // 1. Expiry & Type Check
        isExpired = f_liqIsExpired(p_s)
        isExternal = f_liqIsExternal(p_s.poolType)
        isEventEligible = f_liqIsEventEligible(p_s)

        if not p_s.isSwept and not isExpired and isEventEligible
            if not majorSweeps or isExternal
                isBSLPool = p_s.side == "BSL"
                raidNow = isBSLPool ? high >= p_s.price : low <= p_s.price
                closeInsideNow = isBSLPool ? close < p_s.price : close > p_s.price
                closeOutsideNow = isBSLPool ? close > p_s.price : close < p_s.price
                raidExtremeNow = isBSLPool ? high : low
                candleRange = high - low
                safeRange = candleRange > 0 ? candleRange : 1.0
                depthNow = isBSLPool ? math.max(high - p_s.price, 0) : math.max(p_s.price - low, 0)
                reclaimNow = isBSLPool ? (p_s.price - close) : (close - p_s.price)
                wickRatioNow = isBSLPool ? (high - close) / safeRange : (close - low) / safeRange

                hadPending = not na(p_s.pendingSweepBar)
                int pendingAge = hadPending ? bar_index - p_s.pendingSweepBar : na
                pendingActive = hadPending and pendingAge <= sweepConfirmBars

                if hadPending and not pendingActive and not closeOutsideNow
                    p_s.isSwept := true
                    p_s.state := "SWEPT"
                    p_s.pendingSweepBar := int(na)
                    p_s.pendingSweepExtreme := na
                    p_s.pendingSweepExtremeBar := int(na)
                    p_s.pendingWickRatio := na
                    p_s.lastRefreshBar := bar_index
                else
                    combinedExtreme = pendingActive ? nz(p_s.pendingSweepExtreme, p_s.price) : p_s.price
                    combinedExtremeBar = pendingActive ? nz(p_s.pendingSweepExtremeBar, p_s.pendingSweepBar) : bar_index
                    combinedWick = pendingActive ? nz(p_s.pendingWickRatio, 0.0) : 0.0
                    if raidNow
                        priorExtreme = pendingActive ? nz(p_s.pendingSweepExtreme, p_s.price) : p_s.price
                        combinedExtreme := isBSLPool ? math.max(combinedExtreme, raidExtremeNow) : math.min(combinedExtreme, raidExtremeNow)
                        moreExtremeNow = isBSLPool ? raidExtremeNow >= priorExtreme : raidExtremeNow <= priorExtreme
                        if moreExtremeNow
                            combinedExtremeBar := bar_index
                        combinedWick := math.max(combinedWick, wickRatioNow)

                    effectiveDepth = isBSLPool ? math.max(combinedExtreme - p_s.price, 0) : math.max(p_s.price - combinedExtreme, 0)
                    clusterTol = f_liqClusterTolerance(p_s.price)
                    edgeTol = f_liqTouchTolerance(p_s.price)
                    int clusterCount = 0
                    int sweptClusterCount = 0
                    float clusterEdgePrice = p_s.price
                    int clusterEdgeIdx = i
                    float clusterEdgeRank = f_liqRetentionScore(p_s)
                    if liq_pools.size() > 0 and (raidNow or pendingActive or hadPending)
                        for j = 0 to liq_pools.size() - 1
                            p_c = liq_pools.get(j)
                            cExpired = f_liqIsExpired(p_c)
                            cPending = not na(p_c.pendingSweepBar) and (bar_index - p_c.pendingSweepBar) <= sweepConfirmBars
                            cHadPending = not na(p_c.pendingSweepBar)
                            cExpiredPending = cHadPending and not cPending
                            cRaided = p_c.side == "BSL" ? high >= p_c.price : low <= p_c.price
                            cEligible = p_c.state != "CONSUMED" or cPending or cExpiredPending or cRaided
                            if not p_c.isSwept and not cExpired and cEligible and f_liqIsEventEligible(p_c) and p_c.side == p_s.side and math.abs(p_c.price - p_s.price) <= clusterTol
                                clusterCount += 1
                                cRank = f_liqRetentionScore(p_c)
                                moreExtreme = isBSLPool ? p_c.price > (clusterEdgePrice + edgeTol) : p_c.price < (clusterEdgePrice - edgeTol)
                                sameExtreme = math.abs(p_c.price - clusterEdgePrice) <= edgeTol
                                if moreExtreme or (sameExtreme and cRank > clusterEdgeRank)
                                    clusterEdgePrice := p_c.price
                                    clusterEdgeIdx := j
                                    clusterEdgeRank := cRank
                                if cRaided or cPending or cExpiredPending
                                    sweptClusterCount += 1
                    atClusterEdge = isBSLPool ? combinedExtreme >= (clusterEdgePrice - edgeTol) : combinedExtreme <= (clusterEdgePrice + edgeTol)
                    clusterRep = liq_pools.get(clusterEdgeIdx)
                    depthValid = effectiveDepth <= (atrVal * sweepMaxDepth)
                    reclaimValid = closeInsideNow and (reclaimNow / safeRange) >= reclaimLvl
                    wickValid = combinedWick >= wickThresh
                    confirmNow = closeInsideNow and (raidNow or pendingActive)
                    breakoutDispNow = (isBSLPool ? close > open : close < open) and math.abs(close - open) > (avgBody * dispMult)
                    breakoutAcceptance = isBSLPool ? math.max(close - clusterEdgePrice, 0) : math.max(clusterEdgePrice - close, 0)
                    breakoutAcceptanceValid = breakoutAcceptance >= math.max(edgeTol, atrVal * 0.03)
                    breakoutMeaningful = f_liqIsExternal(clusterRep.poolType) or clusterRep.structuralRank >= 70.0 or clusterRep.timesTagged > 0 or clusterRep.clusterSize > 1 or sweptClusterCount > 1
                    breakoutCandidate = closeOutsideNow and atClusterEdge and breakoutAcceptanceValid and breakoutMeaningful and ((hadPending and not pendingActive) or (effectiveDepth > maxBreakoutDepth and breakoutDispNow))

                    if confirmNow and depthValid and reclaimValid and wickValid
                        if atClusterEdge
                            grade = isExternal ? 40.0 : 20.0
                            grade += (kzBoost and (inLondon or inNY)) ? 20.0 : 0.0
                            grade += (volConfirm and highVol) ? 20.0 : 0.0
                            grade += math.min(clusterRep.touchCount, 3) * 5.0
                            grade += math.min(clusterRep.clusterSize - 1, 3) * 5.0
                            grade += math.min(sweptClusterCount - 1, 4) * 10.0

                            if grade >= minSweepGrade and grade > sweepGrade
                                sweepGrade := grade
                                sweepExtreme := combinedExtreme
                                bestSweepPrice := clusterEdgePrice
                                bestSweepTol := clusterTol
                                bestSweepSide := p_s.side
                                bestSweepIdx := clusterEdgeIdx
                                sweepLabelBar := combinedExtremeBar
                                sweepLabelPrice := combinedExtreme
                                swpTxt := f_liqDisplayLabel(clusterRep)
                        else if raidNow or pendingActive
                            p_s.pendingSweepBar := na(p_s.pendingSweepBar) ? bar_index : p_s.pendingSweepBar
                            p_s.pendingSweepExtreme := combinedExtreme
                            p_s.pendingSweepExtremeBar := combinedExtremeBar
                            p_s.pendingWickRatio := combinedWick
                    else if breakoutCandidate
                        brkGrade = isExternal ? 45.0 : 20.0
                        brkGrade += (kzBoost and (inLondon or inNY)) ? 10.0 : 0.0
                        brkGrade += (volConfirm and highVol) ? 10.0 : 0.0
                        brkGrade += breakoutDispNow ? 20.0 : 0.0
                        brkGrade += math.min(clusterRep.touchCount, 3) * 5.0
                        brkGrade += math.min(clusterRep.clusterSize - 1, 3) * 5.0
                        brkGrade += math.min(sweptClusterCount - 1, 3) * 8.0
                        brkGrade += (hadPending and not pendingActive) ? 15.0 : 0.0
                        if brkGrade >= minBreakoutGrade and brkGrade > breakoutGrade
                            breakoutGrade := brkGrade
                            bestBreakoutPrice := clusterEdgePrice
                            bestBreakoutTol := clusterTol
                            bestBreakoutSide := p_s.side
                            bestBreakoutIdx := clusterEdgeIdx
                            breakoutLabelBar := bar_index
                            breakoutLabelPrice := clusterEdgePrice
                            brkTxt := f_liqDisplayLabel(clusterRep)
                        else
                            p_s.isSwept := true
                            p_s.state := "CONSUMED"
                            p_s.pendingSweepBar := int(na)
                            p_s.pendingSweepExtreme := na
                            p_s.pendingSweepExtremeBar := int(na)
                            p_s.pendingWickRatio := na
                            p_s.lastFailureBar := bar_index
                            p_s.lastRefreshBar := bar_index
                    else
                        if raidNow and effectiveDepth > maxBreakoutDepth
                            p_s.isSwept := true
                            p_s.state := "CONSUMED"
                            p_s.pendingSweepBar := int(na)
                            p_s.pendingSweepExtreme := na
                            p_s.pendingSweepExtremeBar := int(na)
                            p_s.pendingWickRatio := na
                            p_s.lastRefreshBar := bar_index
                        else if raidNow or pendingActive
                            p_s.pendingSweepBar := na(p_s.pendingSweepBar) ? bar_index : p_s.pendingSweepBar
                            p_s.pendingSweepExtreme := combinedExtreme
                            p_s.pendingSweepExtremeBar := combinedExtremeBar
                            p_s.pendingWickRatio := combinedWick

if not na(bestSweepIdx)
    if bestSweepSide == "BSL"
        swpBSL := true
        anchorMSS_S := useMajorMSS ? majSwl : lSwl
    else
        swpSSL := true
        anchorMSS_L := useMajorMSS ? majSwh : lSwh

    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            p_m = liq_pools.get(i)
            mPending = not na(p_m.pendingSweepBar) and (bar_index - p_m.pendingSweepBar) <= sweepConfirmBars
            mRaided = p_m.side == "BSL" ? high >= p_m.price : low <= p_m.price
            sameCluster = f_liqIsEventEligible(p_m) and not p_m.isSwept and p_m.side == bestSweepSide and math.abs(p_m.price - bestSweepPrice) <= bestSweepTol
            if sameCluster and (mRaided or mPending)
                p_m.isSwept := true
                p_m.state := "SWEPT"
                p_m.pendingSweepBar := int(na)
                p_m.pendingSweepExtreme := na
                p_m.pendingSweepExtremeBar := int(na)
                p_m.pendingWickRatio := na
                p_m.lastRefreshBar := bar_index

if not na(bestBreakoutIdx)
    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            p_b = liq_pools.get(i)
            sameCluster = f_liqIsEventEligible(p_b) and not p_b.isSwept and p_b.side == bestBreakoutSide and math.abs(p_b.price - bestBreakoutPrice) <= bestBreakoutTol
            if sameCluster
                p_b.isSwept := true
                p_b.state := "CONSUMED"
                p_b.pendingSweepBar := int(na)
                p_b.pendingSweepExtreme := na
                p_b.pendingSweepExtremeBar := int(na)
                p_b.pendingWickRatio := na
                p_b.lastFailureBar := bar_index
                p_b.lastRefreshBar := bar_index

    if bestBreakoutSide == "BSL" and waitS and not na(waitSweepLevelS) and math.abs(bestBreakoutPrice - waitSweepLevelS) <= math.max(bestBreakoutTol, nz(waitSweepTolS, bestBreakoutTol))
        if not na(waitRaidLabelS)
            label.delete(waitRaidLabelS)
        waitS := false
        waitStartBarS := int(na)
        waitSweepLevelS := na
        waitSweepTolS := na
        waitRaidTextS := ""
        waitRaidLabelS := na
        anchorMSS_S := na
        sExtH := na
    if bestBreakoutSide == "SSL" and waitL and not na(waitSweepLevelL) and math.abs(bestBreakoutPrice - waitSweepLevelL) <= math.max(bestBreakoutTol, nz(waitSweepTolL, bestBreakoutTol))
        if not na(waitRaidLabelL)
            label.delete(waitRaidLabelL)
        waitL := false
        waitStartBarL := int(na)
        waitSweepLevelL := na
        waitSweepTolL := na
        waitRaidTextL := ""
        waitRaidLabelL := na
        anchorMSS_L := na
        sExtL := na

    breakoutIsBSL = bestBreakoutSide == "BSL"
    recentBreakout = breakoutIsBSL ? (not na(lastBreakoutBarBSL) and (bar_index - lastBreakoutBarBSL) <= breakoutCooldownBars) : (not na(lastBreakoutBarSSL) and (bar_index - lastBreakoutBarSSL) <= breakoutCooldownBars)
    moreExtremeBreakout = breakoutIsBSL ? (na(lastBreakoutPriceBSL) or bestBreakoutPrice >= lastBreakoutPriceBSL) : (na(lastBreakoutPriceSSL) or bestBreakoutPrice <= lastBreakoutPriceSSL)
    if showSMC and (not recentBreakout or moreExtremeBreakout)
        if breakoutIsBSL and recentBreakout and not na(lastBreakoutLabelBSL)
            label.delete(lastBreakoutLabelBSL)
        if not breakoutIsBSL and recentBreakout and not na(lastBreakoutLabelSSL)
            label.delete(lastBreakoutLabelSSL)
        label newBreakoutLabel = label.new(breakoutLabelBar, breakoutLabelPrice, "BREAKOUT: " + brkTxt, color=#00000000, textcolor=breakoutIsBSL ? breakoutBullColor : breakoutBearColor, style=breakoutIsBSL ? label.style_label_up : label.style_label_down, size=f_breakoutLabelSize())
        if breakoutIsBSL
            lastBreakoutBarBSL := bar_index
            lastBreakoutPriceBSL := bestBreakoutPrice
            lastBreakoutTolBSL := bestBreakoutTol
            lastBreakoutLabelBSL := newBreakoutLabel
        else
            lastBreakoutBarSSL := bar_index
            lastBreakoutPriceSSL := bestBreakoutPrice
            lastBreakoutTolSSL := bestBreakoutTol
            lastBreakoutLabelSSL := newBreakoutLabel

bearSweep = showSMC and swpBSL
bullSweep = showSMC and swpSSL
if bearSweep and not active and not waitS
    waitRaidLabelS := label.new(sweepLabelBar, nz(sweepLabelPrice, sweepExtreme), "RAID: " + swpTxt, color=#00000000, textcolor=raidBearColor, style=label.style_label_down, size=f_raidLabelSize())
    waitRaidTextS := swpTxt
    waitSweepLevelS := bestSweepPrice
    waitSweepTolS := bestSweepTol
    waitS := true, waitL := false, sExtH := sweepExtreme, waitStartBarS := bar_index, waitStartBarL := int(na), waitSweepLevelL := na, waitSweepTolL := na, waitRaidTextL := "", waitRaidLabelL := na, anchorMSS_L := na
if bullSweep and not active and not waitL
    waitRaidLabelL := label.new(sweepLabelBar, nz(sweepLabelPrice, sweepExtreme), "RAID: " + swpTxt, color=#00000000, textcolor=raidBullColor, style=label.style_label_up, size=f_raidLabelSize())
    waitRaidTextL := swpTxt
    waitSweepLevelL := bestSweepPrice
    waitSweepTolL := bestSweepTol
    waitL := true, waitS := false, sExtL := sweepExtreme, waitStartBarL := bar_index, waitStartBarS := int(na), waitSweepLevelS := na, waitSweepTolS := na, waitRaidTextS := "", waitRaidLabelS := na, anchorMSS_S := na

bearRaidRange = high - low
bearRaidSafeRange = bearRaidRange > 0 ? bearRaidRange : 1.0
bearRaidReclaim = nz(waitSweepLevelS, high) - close
bearRaidWick = (high - close) / bearRaidSafeRange
bool bearRaidUpgrade = waitS and not active and not na(waitSweepLevelS) and high >= waitSweepLevelS and high > nz(sExtH, waitSweepLevelS) and close < waitSweepLevelS and math.max(high - waitSweepLevelS, 0) <= (atrVal * sweepMaxDepth) and (bearRaidReclaim / bearRaidSafeRange) >= reclaimLvl and bearRaidWick >= wickThresh
if bearRaidUpgrade
    if not na(waitRaidLabelS)
        label.delete(waitRaidLabelS)
    waitRaidLabelS := label.new(bar_index, high, "RAID: " + waitRaidTextS, color=#00000000, textcolor=raidBearColor, style=label.style_label_down, size=f_raidLabelSize())
    sExtH := high
    waitStartBarS := bar_index
    anchorMSS_S := useMajorMSS ? majSwl : lSwl

bullRaidRange = high - low
bullRaidSafeRange = bullRaidRange > 0 ? bullRaidRange : 1.0
bullRaidReclaim = close - nz(waitSweepLevelL, low)
bullRaidWick = (close - low) / bullRaidSafeRange
bool bullRaidUpgrade = waitL and not active and not na(waitSweepLevelL) and low <= waitSweepLevelL and low < nz(sExtL, waitSweepLevelL) and close > waitSweepLevelL and math.max(waitSweepLevelL - low, 0) <= (atrVal * sweepMaxDepth) and (bullRaidReclaim / bullRaidSafeRange) >= reclaimLvl and bullRaidWick >= wickThresh
if bullRaidUpgrade
    if not na(waitRaidLabelL)
        label.delete(waitRaidLabelL)
    waitRaidLabelL := label.new(bar_index, low, "RAID: " + waitRaidTextL, color=#00000000, textcolor=raidBullColor, style=label.style_label_up, size=f_raidLabelSize())
    sExtL := low
    waitStartBarL := bar_index
    anchorMSS_L := useMajorMSS ? majSwh : lSwh

bool sweepWaitExpiredS = waitS and not na(waitStartBarS) and (bar_index - waitStartBarS) > sweepMssTimeoutBars
bool sweepWaitExpiredL = waitL and not na(waitStartBarL) and (bar_index - waitStartBarL) > sweepMssTimeoutBars
if sweepWaitExpiredS
    if showSweepTimeoutNote
        label.new(bar_index, sExtH, "SWEEP EXPIRED", color=#00000000, textcolor=color.silver, style=label.style_label_down, size=size.tiny)
    waitS := false
    waitStartBarS := int(na)
    waitSweepLevelS := na
    waitSweepTolS := na
    waitRaidTextS := ""
    waitRaidLabelS := na
    anchorMSS_S := na
    sExtH := na
if sweepWaitExpiredL
    if showSweepTimeoutNote
        label.new(bar_index, sExtL, "SWEEP EXPIRED", color=#00000000, textcolor=color.silver, style=label.style_label_up, size=size.tiny)
    waitL := false
    waitStartBarL := int(na)
    waitSweepLevelL := na
    waitSweepTolL := na
    waitRaidTextL := ""
    waitRaidLabelL := na
    anchorMSS_L := na
    sExtL := na

bool mssS = showSMC and waitS and not na(anchorMSS_S) and close < anchorMSS_S and disp
bool mssL = showSMC and waitL and not na(anchorMSS_L) and close > anchorMSS_L and disp

string shiftType = ""
if mssS
    shiftType := structureStatus == "Bullish" ? "CHOCH ↘" : "BOS ↘"
if mssL
    shiftType := structureStatus == "Bearish" ? "CHOCH ↗" : "BOS ↗"

// --- Stats Logic ---
if mssS and not active
    active := true, bull := false, tSetups += 1
    tSL := (stopModel == "Sweep Extreme") ? sExtH : high
    t10 := anchorMSS_S - (sExtH - anchorMSS_S)
    activeProjStartBar := bar_index
    waitS := false, waitStartBarS := int(na), waitSweepLevelS := na, waitSweepTolS := na, waitRaidTextS := "", waitRaidLabelS := na, structureStatus := "Bearish"
    label.new(bar_index, low, "ENTRY [" + shiftType + "]", color=COLOR_BEAR, textcolor=color.white, style=label.style_label_down, size=size.small)

if mssL and not active
    active := true, bull := true, tSetups += 1
    tSL := (stopModel == "Sweep Extreme") ? sExtL : low
    t10 := anchorMSS_L + (anchorMSS_L - sExtL)
    activeProjStartBar := bar_index
    waitL := false, waitStartBarL := int(na), waitSweepLevelL := na, waitSweepTolL := na, waitRaidTextL := "", waitRaidLabelL := na, structureStatus := "Bullish"
    label.new(bar_index, high, "ENTRY [" + shiftType + "]", color=COLOR_BULL, textcolor=color.white, style=label.style_label_up, size=size.small)

if mssL and not active
    active := true, bull := true, tSetups += 1
    tSL := (stopModel == "Sweep Extreme") ? sExtL : low
    t10 := lSwh + (lSwh - sExtL)
    activeProjStartBar := bar_index
    waitL := false, waitStartBarL := int(na), waitSweepLevelL := na, waitSweepTolL := na, waitRaidTextL := "", waitRaidLabelL := na, structureStatus := "Bullish"
    label.new(bar_index, high, "INST. ENTRY ↗", color=COLOR_BULL, textcolor=color.white, style=label.style_label_up, size=size.small)

if active and showProj and not na(t10) and not na(activeProjStartBar)
    line.set_xy1(activeProjLine, activeProjStartBar, t10)
    line.set_xy2(activeProjLine, bar_index + 15, t10)
    line.set_color(activeProjLine, bull ? COLOR_BULL : COLOR_BEAR)
    line.set_style(activeProjLine, line.style_dashed)
else
    line.set_xy1(activeProjLine, na, na)
    line.set_xy2(activeProjLine, na, na)

if active
    if bull
        if low < tSL
            active := false, activeProjStartBar := int(na), l10 += 1
        else if high > t10
            w10 += 1, active := false, activeProjStartBar := int(na)
    else
        if high > tSL
            active := false, activeProjStartBar := int(na), l10 += 1
        else if low < t10
            w10 += 1, active := false, activeProjStartBar := int(na)

if not active or not showProj
    line.set_xy1(activeProjLine, na, na)
    line.set_xy2(activeProjLine, na, na)

// --- Reaction Zone Narrative Engine ---
var int lastMssBarL = 0
var int lastMssBarS = 0
if mssL
    lastMssBarL := bar_index
if mssS
    lastMssBarS := bar_index

var rz_candidates = array.new<reaction_zone>(0)
rzAtr = ta.atr(14)

if showRZ
    array.clear(rz_candidates)

    // Check if narrative is active (Recent MSS within 60 bars)
    isNarrativeL = lastMssBarL > (bar_index - 60)
    isNarrativeS = lastMssBarS > (bar_index - 60)

    // 1. Fresh post-shift FVGs (Priority 1)
    if fvg_records.size() > 0
        for i = 0 to fvg_records.size() - 1
            f_dat = fvg_records.get(i)
            isLinkedL = isNarrativeL and f_dat.startBar >= lastMssBarL - 5 and f_dat.startBar <= lastMssBarL + 8
            isLinkedS = isNarrativeS and f_dat.startBar >= lastMssBarS - 5 and f_dat.startBar <= lastMssBarS + 8

            if f_dat.isBull and isLinkedL
                rz_candidates.push(reaction_zone.new("Long", "FVG", f_dat.max, f_dat.min, (f_dat.max+f_dat.min)/2, f_dat.startBar, 1, 100.0, false, false, "BULL FVG"))
            else if not f_dat.isBull and isLinkedS
                rz_candidates.push(reaction_zone.new("Short", "FVG", f_dat.max, f_dat.min, (f_dat.max+f_dat.min)/2, f_dat.startBar, 1, 100.0, false, false, "BEAR FVG"))

    // 2. Structural OB (Priority 2)
    if isNarrativeL and not na(lSwh)
        rz_candidates.push(reaction_zone.new("Long", "OB", lSwh, lSwh - (high[1]-low[1]), lSwh, lastMssBarL, 2, 90.0, false, false, "BULL OB"))
    if isNarrativeS and not na(lSwl)
        rz_candidates.push(reaction_zone.new("Short", "OB", lSwl + (high[1]-low[1]), lSwl, lSwl, lastMssBarS, 2, 90.0, false, false, "BEAR OB"))

    // 3. Sweep Reclaim (Priority 3)
    if waitL and not na(sExtL)
        rz_candidates.push(reaction_zone.new("Long", "SWEEP", sExtL + syminfo.mintick*10, sExtL, sExtL + syminfo.mintick*5, nz(waitStartBarL, bar_index), 3, 80.0, false, false, "SWEEP RECLAIM (AGGR)"))
    if waitS and not na(sExtH)
        rz_candidates.push(reaction_zone.new("Short", "SWEEP", sExtH, sExtH - syminfo.mintick*10, sExtH - syminfo.mintick*5, nz(waitStartBarS, bar_index), 3, 80.0, false, false, "SWEEP RECLAIM (AGGR)"))

    // 4. Target / HTF Levels (Priority 4)
    if not na(lastHtf2PH) and high < lastHtf2PH
        rz_candidates.push(reaction_zone.new("Short", "EXT", lastHtf2PH + syminfo.mintick*5, lastHtf2PH - syminfo.mintick*5, lastHtf2PH, bar_index, 4, 70.0, false, false, "HTF TARGET"))
    if not na(lastHtf2PL) and low > lastHtf2PL
        rz_candidates.push(reaction_zone.new("Long", "EXT", lastHtf2PL + syminfo.mintick*5, lastHtf2PL - syminfo.mintick*5, lastHtf2PL, bar_index, 4, 70.0, false, false, "HTF TARGET"))

    // --- Filter: Proximity (ATR) ---
    if rz_candidates.size() > 0
        for i = rz_candidates.size() - 1 to 0
            z_p = rz_candidates.get(i)
            if math.abs(z_p.ce - close) > (rzAtr * rzProximityMult)
                rz_candidates.remove(i)

    // --- Logic: Merge Overlapping Zones ---
    if rzMergeZones and rz_candidates.size() > 1
        for i = 0 to math.min(20, rz_candidates.size() - 2)
            z1 = rz_candidates.get(i)
            for j = i + 1 to rz_candidates.size() - 1
                z2 = rz_candidates.get(j)
                if z1.side == z2.side
                    isOverlap = math.max(z1.bottom, z2.bottom) <= math.min(z1.top, z2.top)
                    if isOverlap
                        newT = math.max(z1.top, z2.top)
                        newB = math.min(z1.bottom, z2.bottom)
                        rz_candidates.set(i, reaction_zone.new(z1.side, "CONFLUENCE", newT, newB, (newT+newB)/2, z1.sourceBar, 1, 110.0, false, false, "CONFLUENCE"))
                        rz_candidates.remove(j)
                        break

// Filter Top 1 per side
f_getTopZone(side) =>
    reaction_zone best = na
    int bestRank = 99
    float bestScore = -1.0
    if rz_candidates.size() > 0
        for i = 0 to rz_candidates.size() - 1
            z_c = rz_candidates.get(i)
            if z_c.side == side
                if z_c.priorityRank < bestRank or (z_c.priorityRank == bestRank and z_c.score > bestScore)
                    best := z_c
                    bestRank := z_c.priorityRank
                    bestScore := z_c.score
    best

reaction_zone topLong  = f_getTopZone("Long")
reaction_zone topShort = f_getTopZone("Short")

// Visual Rendering Logic
update_rz_vis(reaction_zone z, string side, box b, line l, label lb) =>
    if not na(z)
        isEntry = (z.zoneType == "FVG" or z.zoneType == "OB" or z.zoneType == "SWEEP" or z.zoneType == "CONFLUENCE")
        baseClr = side == "Long" ? rzEntryColor : rzBearColor
        if not isEntry
            baseClr := rzTargetColor

        box.set_lefttop(b, bar_index - 15, z.top)
        box.set_rightbottom(b, bar_index + 8, z.bottom)
        box.set_bgcolor(b, color.new(baseClr, isEntry ? 70 : 85))
        box.set_border_color(b, color.new(baseClr, isEntry ? 30 : 60))
        box.set_border_style(b, isEntry ? line.style_solid : line.style_dotted)

        if showRZCE
            line.set_xy1(l, bar_index - 15, z.ce)
            line.set_xy2(l, bar_index + 8, z.ce)
            line.set_color(l, color.new(baseClr, 40))
            line.set_style(l, line.style_dashed)
        else
            line.set_xy1(l, na, na)

        if showRZLabels
            label.set_xy(lb, bar_index + 8, z.ce)
            label.set_text(lb, z.narrative + (isEntry ? " [ENTRY]" : " [TARGET]"))
            label.set_textcolor(lb, baseClr)
            label.set_style(lb, label.style_label_left)
        else
            label.set_text(lb, "")
    else
        box.set_bgcolor(b, na)
        box.set_border_color(b, na)
        line.set_xy1(l, na, na)
        label.set_text(lb, "")

var box bLong = box.new(na, na, na, na, border_color=na)
var line lLong = line.new(na, na, na, na)
var label lbLong = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)

var box bShort = box.new(na, na, na, na, border_color=na)
var line lShort = line.new(na, na, na, na)
var label lbShort = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)

if barstate.islast
    update_rz_vis(topLong, "Long", bLong, lLong, lbLong)
    update_rz_vis(topShort, "Short", bShort, lShort, lbShort)

// --- Dashboard ---
if showDash and barstate.islast
    pos_tbl = (dashPos == "Top Right") ? position.top_right : (dashPos == "Top Left") ? position.top_left : position.bottom_right
    var table tb = table.new(pos_tbl, 2, 10, bgcolor=#1e222d, border_color=#373a46, border_width=1)
    table.cell(tb, 0, 0, "HTF / SMC BIAS", bgcolor=chart.fg_color, text_color=chart.bg_color, text_size=size.small)
    table.cell(tb, 1, 0, "STATUS", bgcolor=chart.fg_color, text_color=chart.bg_color, text_size=size.small)

    bT1 = close > dO ? "ABOVE" : "BELOW"
    bC1 = close > dO ? COLOR_BULL : COLOR_BEAR
    table.cell(tb, 0, 1, "Daily Open", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(tb, 1, 1, bT1, text_color=color.white, bgcolor=bC1, text_size=size.small)

    bT2 = close > wO ? "ABOVE" : "BELOW"
    bC2 = close > wO ? COLOR_BULL : COLOR_BEAR
    table.cell(tb, 0, 2, "Weekly Open", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(tb, 1, 2, bT2, text_color=color.white, bgcolor=bC2, text_size=size.small)

    bT3 = na(nyMidnight) ? "N/A" : close > nyMidnight ? "ABOVE" : "BELOW"
    bC3 = na(nyMidnight) ? COLOR_NEUT : close > nyMidnight ? COLOR_BULL : COLOR_BEAR
    table.cell(tb, 0, 3, "NY Midnight", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(tb, 1, 3, bT3, text_color=color.white, bgcolor=bC3, text_size=size.small)

    h1C = htf1Bias == "BULL" ? COLOR_BULL : htf1Bias == "BEAR" ? COLOR_BEAR : COLOR_NEUT
    table.cell(tb, 0, 4, "HTF 1 (" + htf1Tf + ")", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(tb, 1, 4, htf1Bias, text_color=color.white, bgcolor=h1C, text_size=size.small)

    h2C = htf2Bias == "BULL" ? COLOR_BULL : htf2Bias == "BEAR" ? COLOR_BEAR : COLOR_NEUT
    table.cell(tb, 0, 5, "HTF 2 (" + htf2Tf + ")", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(tb, 1, 5, htf2Bias, text_color=color.white, bgcolor=h2C, text_size=size.small)

    msC = structureStatus == "Bullish" ? COLOR_BULL : structureStatus == "Bearish" ? COLOR_BEAR : #787b86
    table.cell(tb, 0, 6, "LTF Structure", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(tb, 1, 6, structureStatus, text_color=color.white, bgcolor=msC, text_size=size.small)

    overAll = (close > dO and structureStatus == "Bullish" and htf2Bias == "BULL") ? "BULL CONTEXT" : (close < dO and structureStatus == "Bearish" and htf2Bias == "BEAR") ? "BEAR CONTEXT" : "MIXED"
    overC = (close > dO and structureStatus == "Bullish" and htf2Bias == "BULL") ? COLOR_BULL : (close < dO and structureStatus == "Bearish" and htf2Bias == "BEAR") ? COLOR_BEAR : COLOR_NEUT
    table.cell(tb, 0, 7, "Overall Context", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(tb, 1, 7, overAll, text_color=color.white, bgcolor=overC, text_size=size.small)

    table.cell(tb, 0, 8, "Total Setups", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(tb, 1, 8, str.tostring(tSetups), text_color=color.white, bgcolor=#1e222d, text_size=size.small)

    tot = w10 + l10
    winrate = tot == 0 ? "0%" : str.tostring(math.round(w10 / tot * 100)) + "%"
    table.cell(tb, 0, 9, "Winrate", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(tb, 1, 9, winrate, text_color=COLOR_BULL, bgcolor=#1e222d, text_size=size.small)
