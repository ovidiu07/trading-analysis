var float protectedHigh = na
var float protectedLow = na
var int protectedHighBar = na
var int protectedLowBar = na
var int activeDealingLeg = 0
var array<float> minorHighPivotPrices = array.new_float(0)
var array<int> minorHighPivotBars = array.new_int(0)
var array<float> minorLowPivotPrices = array.new_float(0)
var array<int> minorLowPivotBars = array.new_int(0)
var array<float> majorHighPivotPrices = array.new_float(0)
var array<int> majorHighPivotBars = array.new_int(0)
var array<float> majorLowPivotPrices = array.new_float(0)
var array<int> majorLowPivotBars = array.new_int(0)

f_pushStructurePivot(array<float> priceArr, array<int> barArr, float pivotPrice, int pivotBar, int maxItems) =>
    if not na(pivotPrice) and not na(pivotBar)
        int arrSize = array.size(barArr)
        bool isDuplicate = arrSize > 0 and array.get(barArr, arrSize - 1) == pivotBar
        if not isDuplicate
            array.push(priceArr, pivotPrice)
            array.push(barArr, pivotBar)
            while array.size(priceArr) > maxItems
                array.shift(priceArr)
                array.shift(barArr)
    true

f_getLatestPivotBefore(array<float> priceArr, array<int> barArr, int refBar) =>
    float foundPrice = na
    int foundBar = na
    if not na(refBar) and array.size(barArr) > 0
        for i = array.size(barArr) - 1 to 0
            int pivotBar = array.get(barArr, i)
            if pivotBar <= refBar
                foundPrice := array.get(priceArr, i)
                foundBar := pivotBar
                break
    [foundPrice, foundBar]

f_structureBaseStatus(int trend) =>
    trend == 1 ? "Bullish (Protected)" : trend == -1 ? "Bearish (Protected)" : "Neutral"

f_resolveBearStructureRefs(int narrativeRefBar, int sweepBar, float protectedLowRef, int protectedLowRefBar) =>
    int primaryBar = na(narrativeRefBar) ? sweepBar : narrativeRefBar
    int fallbackBar = na(sweepBar) ? primaryBar : sweepBar
    [minorRef, minorRefBar] = f_getLatestPivotBefore(minorLowPivotPrices, minorLowPivotBars, primaryBar)
    if na(minorRef)
        [minorRef, minorRefBar] = f_getLatestPivotBefore(minorLowPivotPrices, minorLowPivotBars, fallbackBar)
    [majorRef, majorRefBar] = f_getLatestPivotBefore(majorLowPivotPrices, majorLowPivotBars, primaryBar)
    if na(majorRef)
        [majorRef, majorRefBar] = f_getLatestPivotBefore(majorLowPivotPrices, majorLowPivotBars, fallbackBar)
    int protectedLimitBar = math.max(primaryBar, fallbackBar)
    if not na(protectedLowRef) and not na(protectedLowRefBar) and protectedLowRefBar <= protectedLimitBar
        if na(majorRefBar) or protectedLowRefBar >= majorRefBar
            majorRef := protectedLowRef
            majorRefBar := protectedLowRefBar
    [minorRef, minorRefBar, majorRef, majorRefBar]

f_resolveBullStructureRefs(int narrativeRefBar, int sweepBar, float protectedHighRef, int protectedHighRefBar) =>
    int primaryBar = na(narrativeRefBar) ? sweepBar : narrativeRefBar
    int fallbackBar = na(sweepBar) ? primaryBar : sweepBar
    [minorRef, minorRefBar] = f_getLatestPivotBefore(minorHighPivotPrices, minorHighPivotBars, primaryBar)
    if na(minorRef)
        [minorRef, minorRefBar] = f_getLatestPivotBefore(minorHighPivotPrices, minorHighPivotBars, fallbackBar)
    [majorRef, majorRefBar] = f_getLatestPivotBefore(majorHighPivotPrices, majorHighPivotBars, primaryBar)
    if na(majorRef)
        [majorRef, majorRefBar] = f_getLatestPivotBefore(majorHighPivotPrices, majorHighPivotBars, fallbackBar)
    int protectedLimitBar = math.max(primaryBar, fallbackBar)
    if not na(protectedHighRef) and not na(protectedHighRefBar) and protectedHighRefBar <= protectedLimitBar
        if na(majorRefBar) or protectedHighRefBar >= majorRefBar
            majorRef := protectedHighRef
            majorRefBar := protectedHighRefBar
    [minorRef, minorRefBar, majorRef, majorRefBar]

avgBody = ta.sma(math.abs(close - open), 20)
disp    = math.abs(close - open) > (avgBody * dispMult)

swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)
majH = ta.pivothigh(high, swingLen * 3, swingLen * 3)
majL = ta.pivotlow(low, swingLen * 3, swingLen * 3)

if not na(swH)
    lSwh := swH
    lSwhBar := bar_index - swingLen
    f_pushStructurePivot(minorHighPivotPrices, minorHighPivotBars, lSwh, lSwhBar, 80)
if not na(swL)
    lSwl := swL
    lSwlBar := bar_index - swingLen
    f_pushStructurePivot(minorLowPivotPrices, minorLowPivotBars, lSwl, lSwlBar, 80)
if not na(majH)
    majSwh := majH
    majSwhBar := bar_index - swingLen * 3
    f_pushStructurePivot(majorHighPivotPrices, majorHighPivotBars, majSwh, majSwhBar, 50)
    protectedHigh := majSwh
    protectedHighBar := majSwhBar
    if not na(majSwl) and majSwlBar < majSwhBar
        protectedLow := majSwl
        protectedLowBar := majSwlBar
        activeDealingLeg := 1
if not na(majL)
    majSwl := majL
    majSwlBar := bar_index - swingLen * 3
    f_pushStructurePivot(majorLowPivotPrices, majorLowPivotBars, majSwl, majSwlBar, 50)
    protectedLow := majSwl
    protectedLowBar := majSwlBar
    if not na(majSwh) and majSwhBar < majSwlBar
        protectedHigh := majSwh
        protectedHighBar := majSwhBar
        activeDealingLeg := -1
// --- High-Fidelity Sweep Engine ---
bool swpBSL = false
bool swpSSL = false
string swpTxt = ""
string sweepClass = ""
float sweepGrade = 0.0
float sweepExtreme = na
float bestSweepPrice = na
float bestSweepTol = na
string bestSweepSide = ""
int bestSweepIdx = na
int bestSweepSourceBar = na
string bestSweepBaseType = ""
int sweepLabelBar = na
float sweepLabelPrice = na
int sweepConfirmBars = sweepReclaimBars
float maxBreakoutDepth = atrVal * (sweepMaxDepth * 1.25)
float breakoutGrade = 0.0
float bestBreakoutPrice = na
float bestBreakoutTol = na
string bestBreakoutSide = ""
int bestBreakoutIdx = na
int breakoutLabelBar = na
float breakoutLabelPrice = na
string brkTxt = ""
string breakoutClass = ""
float minSweepGrade = majorSweeps ? 58.0 : 46.0
float minBreakoutGrade = majorSweeps ? 52.0 : 40.0

if liq_pools.size() > 0
    for i = 0 to liq_pools.size() - 1
        p_s = liq_pools.get(i)

        bool isExpired = f_liqIsExpired(p_s)
        bool isExternal = f_liqIsExternal(p_s.poolType)
        bool isEventEligible = f_liqIsEventEligible(p_s)

        if not p_s.isSwept and not isExpired and isEventEligible
            if not majorSweeps or isExternal
                bool isBSLPool = p_s.side == "BSL"
                float clusterTol = f_liqClusterTolerance(p_s.price)
                float edgeTol = f_liqTouchTolerance(p_s.price)
                bool raidNow = isBSLPool ? high >= p_s.price : low <= p_s.price
                bool closeInsideNow = isBSLPool ? close < p_s.price : close > p_s.price
                bool closeOutsideNow = isBSLPool ? close > p_s.price : close < p_s.price
                float raidExtremeNow = isBSLPool ? high : low
                float candleRange = high - low
                float safeRange = candleRange > 0 ? candleRange : syminfo.mintick
                float body = math.abs(close - open)
                float upperWick = high - math.max(open, close)
                float lowerWick = math.min(open, close) - low
                float wickBeyondBody = isBSLPool ? upperWick : lowerWick
                float wickBodyRatio = wickBeyondBody / math.max(body, syminfo.mintick)
                bool newsBar = atrVal > 0 and candleRange >= atrVal * newsRangeAtrMult and volume >= nz(avgVol, volume) * newsVolMult

                bool hadPending = not na(p_s.pendingSweepBar)
                int pendingAge = hadPending ? bar_index - p_s.pendingSweepBar : na
                bool pendingActive = hadPending and pendingAge <= sweepConfirmBars
                bool pendingExpired = hadPending and not pendingActive

                float combinedExtreme = pendingActive ? nz(p_s.pendingSweepExtreme, p_s.price) : p_s.price
                int combinedExtremeBar = pendingActive ? nz(p_s.pendingSweepExtremeBar, p_s.pendingSweepBar) : bar_index
                float combinedWick = pendingActive ? nz(p_s.pendingWickRatio, 0.0) : 0.0
                if raidNow
                    float priorExtreme = pendingActive ? nz(p_s.pendingSweepExtreme, p_s.price) : p_s.price
                    combinedExtreme := isBSLPool ? math.max(combinedExtreme, raidExtremeNow) : math.min(combinedExtreme, raidExtremeNow)
                    bool moreExtremeNow = isBSLPool ? raidExtremeNow >= priorExtreme : raidExtremeNow <= priorExtreme
                    if moreExtremeNow
                        combinedExtremeBar := bar_index
                    combinedWick := math.max(combinedWick, wickBodyRatio)

                float effectiveDepth = isBSLPool ? math.max(combinedExtreme - p_s.price, 0) : math.max(p_s.price - combinedExtreme, 0)
                float depthAtr = atrVal > 0 ? effectiveDepth / atrVal : 0.0
                float clusterEdgePrice = p_s.price
                float clusterEdgeRank = f_liqRetentionScore(p_s)
                int clusterEdgeIdx = i
                int clusterCount = 0
                int sweptClusterCount = 0
                float clusterSumPrice = 0.0
                int clusterEligibleCount = 0

                if liq_pools.size() > 0 and (raidNow or pendingActive or hadPending)
                    for j = 0 to liq_pools.size() - 1
                        p_c = liq_pools.get(j)
                        bool cExpired = f_liqIsExpired(p_c)
                        bool cPending = not na(p_c.pendingSweepBar) and (bar_index - p_c.pendingSweepBar) <= sweepConfirmBars
                        bool cHadPending = not na(p_c.pendingSweepBar)
                        bool cExpiredPending = cHadPending and not cPending
                        bool cRaided = p_c.side == "BSL" ? high >= p_c.price : low <= p_c.price
                        bool cEligible = p_c.state != "CONSUMED" or cPending or cExpiredPending or cRaided
                        if not p_c.isSwept and not cExpired and cEligible and f_liqIsEventEligible(p_c) and p_c.side == p_s.side and math.abs(p_c.price - p_s.price) <= clusterTol
                            clusterCount += 1
                            clusterEligibleCount += 1
                            clusterSumPrice += p_c.price
                            float cRank = f_liqRetentionScore(p_c)
                            bool moreExtreme = isBSLPool ? p_c.price > (clusterEdgePrice + edgeTol) : p_c.price < (clusterEdgePrice - edgeTol)
                            bool sameExtreme = math.abs(p_c.price - clusterEdgePrice) <= edgeTol
                            if moreExtreme or (sameExtreme and cRank > clusterEdgeRank)
                                clusterEdgePrice := p_c.price
                                clusterEdgeIdx := j
                                clusterEdgeRank := cRank
                            if cRaided or cPending or cExpiredPending
                                sweptClusterCount += 1

                float clusterMeanPrice = clusterEligibleCount > 0 ? clusterSumPrice / clusterEligibleCount : p_s.price
                bool atClusterEdge = isBSLPool ? combinedExtreme >= (clusterEdgePrice - edgeTol) : combinedExtreme <= (clusterEdgePrice + edgeTol)
                clusterRep = liq_pools.get(clusterEdgeIdx)
                float breakoutAcceptance = isBSLPool ? math.max(close - clusterEdgePrice, 0) : math.max(clusterEdgePrice - close, 0)
                bool breakoutAcceptanceValid = breakoutAcceptance >= math.max(edgeTol, atrVal * 0.03)
                int barsBeyondPool = pendingActive ? pendingAge : 0
                if hadPending and closeOutsideNow
                    barsBeyondPool += 1
                float reclaimToEdge = isBSLPool ? math.max(clusterEdgePrice - close, 0) : math.max(close - clusterEdgePrice, 0)
                float reclaimToMean = isBSLPool ? math.max(clusterMeanPrice - close, 0) : math.max(close - clusterMeanPrice, 0)
                bool clusterMeanRecovered = isBSLPool ? close <= (clusterMeanPrice + edgeTol * 0.15) : close >= (clusterMeanPrice - edgeTol * 0.15)
                float reclaimNorm = closeInsideNow ? math.max(reclaimToEdge, clusterMeanRecovered ? reclaimToMean : 0.0) / math.max(effectiveDepth, edgeTol) : 0.0
                bool orderlyReclaim = closeInsideNow and reclaimNorm >= reclaimLvl and combinedWick >= wickThresh
                bool lowQualityRetap = clusterRep.timesTagged >= 4 or (clusterRep.state == "TAGGED" and clusterRep.timesTagged >= 3)
                bool grindThrough = (pendingExpired and closeOutsideNow) or barsBeyondPool > sweepConfirmBars or (closeOutsideNow and body / safeRange < 0.35 and effectiveDepth > edgeTol)
                bool disorderlyNews = newsBar and not orderlyReclaim
                bool depthValid = effectiveDepth <= (atrVal * sweepMaxDepth)
                bool confirmNow = closeInsideNow and (raidNow or pendingActive)
                bool breakoutDispNow = (isBSLPool ? close > open : close < open) and body > (avgBody * dispMult)
                bool breakoutMeaningful = f_liqIsExternal(clusterRep.poolType) or clusterRep.structuralRank >= 70.0 or clusterRep.timesTagged > 0 or clusterRep.clusterSize > 1 or sweptClusterCount > 1
                bool continuationBreak = closeOutsideNow and atClusterEdge and breakoutAcceptanceValid and breakoutMeaningful and ((hadPending and pendingExpired) or (effectiveDepth > maxBreakoutDepth) or breakoutDispNow)
                bool coherentWindow = not pendingExpired or continuationBreak
                bool clusterSweepValid = confirmNow and atClusterEdge and depthValid and coherentWindow and not lowQualityRetap and not grindThrough and not disorderlyNews

                float penetrationScore = f_sweepPenetrationScore(depthAtr)
                float timeScore = f_sweepTimeScore(barsBeyondPool)
                float closeScore = closeInsideNow ? (clusterMeanRecovered ? 18.0 : 10.0) : -20.0
                float rejectionScore = f_clamp(combinedWick, 0.0, 3.0) * 6.0
                float pdScore = f_sweepPdScore(isBSLPool, clusterEdgePrice)
                float sessionScore = (kzBoost ? f_sweepSessionScore(clusterRep) : 0.0)
                float liquidityScore = f_sweepLiquidityScore(clusterRep)
                float htfSweepNarrativeBias = isBSLPool ? -htfCompositeBias : htfCompositeBias
                float htfAlignmentScore = math.max(-14.0, math.min(14.0, htfSweepNarrativeBias * 0.12))
                float volumeScore = (volConfirm and highVol) ? 4.0 : 0.0
                float retapPenalty = lowQualityRetap ? -18.0 : math.max(clusterRep.timesTagged - 1, 0) * -4.0
                float coherencePenalty = coherentWindow ? 0.0 : -22.0
                float rawSweepScore = penetrationScore + timeScore + closeScore + rejectionScore + pdScore + sessionScore + liquidityScore + htfAlignmentScore + volumeScore + retapPenalty + coherencePenalty
                rawSweepScore += f_sweepSessionIsLogical(clusterRep) ? 0.0 : -10.0
                rawSweepScore += disorderlyNews ? -18.0 : 0.0
                rawSweepScore := f_clamp(rawSweepScore, 0.0, 100.0)

                string candidateSweepClass = ""
                if clusterSweepValid
                    if newsBar and orderlyReclaim and clusterMeanRecovered
                        candidateSweepClass := "NEWS DISPLACEMENT RAID"
                    else if depthAtr < 0.06 or rawSweepScore < (minSweepGrade - 8.0)
                        candidateSweepClass := "MINOR PROBE"
                    else if depthAtr > (sweepMaxDepth * 0.55) or reclaimNorm > 1.10 or sweptClusterCount > 1
                        candidateSweepClass := "AGGRESSIVE STOP RUN"
                    else
                        candidateSweepClass := "CLEAN SWEEP"

                float breakoutScore = 0.0
                if continuationBreak and not lowQualityRetap and not disorderlyNews
                    float htfBreakoutBias = isBSLPool ? htfCompositeBias : -htfCompositeBias
                    float htfBreakoutScore = math.max(-12.0, math.min(12.0, htfBreakoutBias * 0.10))
                    breakoutScore := liquidityScore + sessionScore + htfBreakoutScore + (breakoutDispNow ? 18.0 : 8.0) + math.min(math.max(body / safeRange, 0.0), 1.0) * 12.0 + math.min(depthAtr, 1.5) * 10.0 + (pendingExpired ? 10.0 : 0.0)
                    breakoutScore += f_sweepSessionIsLogical(clusterRep) ? 0.0 : -6.0
                    breakoutScore += clusterRep.timesTagged >= 3 ? -6.0 : 0.0
                    breakoutScore := f_clamp(breakoutScore, 0.0, 100.0)

                if clusterSweepValid and candidateSweepClass != "MINOR PROBE"
                    if rawSweepScore >= minSweepGrade and rawSweepScore > sweepGrade
                        sweepGrade := rawSweepScore
                        sweepClass := candidateSweepClass
                        sweepExtreme := combinedExtreme
                        bestSweepPrice := clusterEdgePrice
                        bestSweepTol := clusterTol
                        bestSweepSide := p_s.side
                        bestSweepIdx := clusterEdgeIdx
                        bestSweepSourceBar := clusterRep.sourceBar
                        bestSweepBaseType := clusterRep.baseType
                        sweepLabelBar := combinedExtremeBar
                        sweepLabelPrice := combinedExtreme
                        swpTxt := f_sweepDisplayLabel(candidateSweepClass, f_liqDisplayLabel(clusterRep))
                else if continuationBreak
                    if breakoutScore >= minBreakoutGrade and breakoutScore > breakoutGrade
                        breakoutGrade := breakoutScore
                        breakoutClass := "CONTINUATION BREAK"
                        bestBreakoutPrice := clusterEdgePrice
                        bestBreakoutTol := clusterTol
                        bestBreakoutSide := p_s.side
                        bestBreakoutIdx := clusterEdgeIdx
                        breakoutLabelBar := bar_index
                        breakoutLabelPrice := clusterEdgePrice
                        brkTxt := f_sweepDisplayLabel(breakoutClass, f_liqDisplayLabel(clusterRep))
                    else
                        p_s.isSwept := true
                        p_s.state := "CONSUMED"
                        p_s.pendingSweepBar := int(na)
                        p_s.pendingSweepExtreme := na
                        p_s.pendingSweepExtremeBar := int(na)
                        p_s.pendingWickRatio := na
                        p_s.lastFailureBar := bar_index
                        p_s.lastRefreshBar := bar_index
                else if raidNow or pendingActive
                    bool pendingAllowed = not lowQualityRetap and not disorderlyNews and barsBeyondPool <= sweepConfirmBars and effectiveDepth <= math.max(atrVal * sweepMaxDepth, edgeTol)
                    if pendingAllowed
                        p_s.pendingSweepBar := na(p_s.pendingSweepBar) ? bar_index : p_s.pendingSweepBar
                        p_s.pendingSweepExtreme := combinedExtreme
                        p_s.pendingSweepExtremeBar := combinedExtremeBar
                        p_s.pendingWickRatio := combinedWick
                    else if raidNow and (effectiveDepth > maxBreakoutDepth or grindThrough)
                        p_s.isSwept := true
                        p_s.state := "CONSUMED"
                        p_s.pendingSweepBar := int(na)
                        p_s.pendingSweepExtreme := na
                        p_s.pendingSweepExtremeBar := int(na)
                        p_s.pendingWickRatio := na
                        p_s.lastRefreshBar := bar_index

if not na(bestSweepIdx)
    int narrativeRefBar = (bestSweepBaseType == "SWING" or bestSweepBaseType == "EQ") ? bestSweepSourceBar : nz(sweepLabelBar, bar_index)
    int sweepContextBar = nz(sweepLabelBar, bar_index)
    if bestSweepSide == "BSL"
        swpBSL := true
        [resolvedInternalS, resolvedInternalBarS, resolvedExternalS, resolvedExternalBarS] = f_resolveBearStructureRefs(narrativeRefBar, sweepContextBar, protectedLow, protectedLowBar)
        internalRefS := resolvedInternalS
        internalRefBarS := resolvedInternalBarS
        externalRefS := resolvedExternalS
        externalRefBarS := resolvedExternalBarS
        trendAtSweepS := structureTrend
        internalShiftDoneS := false
        externalShiftDoneS := false
        localPivotDoneS := false
        anchorMSS_S := internalRefS
    else
        swpSSL := true
        [resolvedInternalL, resolvedInternalBarL, resolvedExternalL, resolvedExternalBarL] = f_resolveBullStructureRefs(narrativeRefBar, sweepContextBar, protectedHigh, protectedHighBar)
        internalRefL := resolvedInternalL
        internalRefBarL := resolvedInternalBarL
        externalRefL := resolvedExternalL
        externalRefBarL := resolvedExternalBarL
        trendAtSweepL := structureTrend
        internalShiftDoneL := false
        externalShiftDoneL := false
        localPivotDoneL := false
        anchorMSS_L := internalRefL

    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            p_m = liq_pools.get(i)
            mPending = not na(p_m.pendingSweepBar) and (bar_index - p_m.pendingSweepBar) <= sweepConfirmBars
            mRaided = p_m.side == "BSL" ? high >= p_m.price : low <= p_m.price
            sameCluster = f_liqIsEventEligible(p_m) and not p_m.isSwept and p_m.side == bestSweepSide and math.abs(p_m.price - bestSweepPrice) <= bestSweepTol
            if sameCluster and (mRaided or mPending)
                p_m.isSwept := true
                p_m.state := "SWEPT"
                p_m.pendingSweepBar := int(na)
                p_m.pendingSweepExtreme := na
                p_m.pendingSweepExtremeBar := int(na)
                p_m.pendingWickRatio := na
                p_m.lastRefreshBar := bar_index

if not na(bestBreakoutIdx)
    if liq_pools.size() > 0
        for i = 0 to liq_pools.size() - 1
            p_b = liq_pools.get(i)
            sameCluster = f_liqIsEventEligible(p_b) and not p_b.isSwept and p_b.side == bestBreakoutSide and math.abs(p_b.price - bestBreakoutPrice) <= bestBreakoutTol
            if sameCluster
                p_b.isSwept := true
                p_b.state := "CONSUMED"
                p_b.pendingSweepBar := int(na)
                p_b.pendingSweepExtreme := na
                p_b.pendingSweepExtremeBar := int(na)
                p_b.pendingWickRatio := na
                p_b.lastFailureBar := bar_index
                p_b.lastRefreshBar := bar_index

    if bestBreakoutSide == "BSL" and waitS and not na(waitSweepLevelS) and math.abs(bestBreakoutPrice - waitSweepLevelS) <= math.max(bestBreakoutTol, nz(waitSweepTolS, bestBreakoutTol))
        if not na(waitRaidLabelS)
            label.delete(waitRaidLabelS)
        waitS := false
        waitStartBarS := int(na)
        waitSweepLevelS := na
        waitSweepTolS := na
        waitRaidTextS := ""
        waitRaidLabelS := na
        anchorMSS_S := na
        internalRefS := na
        internalRefBarS := na
        externalRefS := na
        externalRefBarS := na
        internalShiftDoneS := false
        externalShiftDoneS := false
        localPivotDoneS := false
        sExtH := na
        structureStatus := f_structureBaseStatus(structureTrend)
    if bestBreakoutSide == "SSL" and waitL and not na(waitSweepLevelL) and math.abs(bestBreakoutPrice - waitSweepLevelL) <= math.max(bestBreakoutTol, nz(waitSweepTolL, bestBreakoutTol))
        if not na(waitRaidLabelL)
            label.delete(waitRaidLabelL)
        waitL := false
        waitStartBarL := int(na)
        waitSweepLevelL := na
        waitSweepTolL := na
        waitRaidTextL := ""
        waitRaidLabelL := na
        anchorMSS_L := na
        internalRefL := na
        internalRefBarL := na
        externalRefL := na
        externalRefBarL := na
        internalShiftDoneL := false
        externalShiftDoneL := false
        localPivotDoneL := false
        sExtL := na
        structureStatus := f_structureBaseStatus(structureTrend)

    breakoutIsBSL = bestBreakoutSide == "BSL"
    recentBreakout = breakoutIsBSL ? (not na(lastBreakoutBarBSL) and (bar_index - lastBreakoutBarBSL) <= breakoutCooldownBars) : (not na(lastBreakoutBarSSL) and (bar_index - lastBreakoutBarSSL) <= breakoutCooldownBars)
    moreExtremeBreakout = breakoutIsBSL ? (na(lastBreakoutPriceBSL) or bestBreakoutPrice >= lastBreakoutPriceBSL) : (na(lastBreakoutPriceSSL) or bestBreakoutPrice <= lastBreakoutPriceSSL)
    if showSMC and (not recentBreakout or moreExtremeBreakout)
        if breakoutIsBSL and recentBreakout and not na(lastBreakoutLabelBSL)
            label.delete(lastBreakoutLabelBSL)
        if not breakoutIsBSL and recentBreakout and not na(lastBreakoutLabelSSL)
            label.delete(lastBreakoutLabelSSL)
        label newBreakoutLabel = label.new(breakoutLabelBar, breakoutLabelPrice, "BREAKOUT: " + brkTxt, color=#00000000, textcolor=breakoutIsBSL ? breakoutBullColor : breakoutBearColor, style=breakoutIsBSL ? label.style_label_up : label.style_label_down, size=f_breakoutLabelSize())
        if breakoutIsBSL
            lastBreakoutBarBSL := bar_index
            lastBreakoutPriceBSL := bestBreakoutPrice
            lastBreakoutTolBSL := bestBreakoutTol
            lastBreakoutLabelBSL := newBreakoutLabel
        else
