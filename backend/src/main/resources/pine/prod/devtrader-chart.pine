    waitSweepTolS := bestSweepTol
    waitS := true, waitL := false, sExtH := sweepExtreme, waitStartBarS := bar_index, waitStartBarL := int(na), waitSweepLevelL := na, waitSweepTolL := na, waitRaidTextL := "", waitRaidLabelL := na, anchorMSS_L := na, internalRefL := na, internalRefBarL := na, externalRefL := na, externalRefBarL := na, internalShiftDoneL := false, externalShiftDoneL := false, localPivotDoneL := false
    structureStatus := "Awaiting Bearish Internal Shift"
if bullSweep and not active and not waitL
    waitRaidLabelL := label.new(sweepLabelBar, nz(sweepLabelPrice, sweepExtreme), "RAID: " + swpTxt, color=#00000000, textcolor=raidBullColor, style=label.style_label_up, size=f_raidLabelSize())
    waitRaidTextL := swpTxt
    waitSweepLevelL := bestSweepPrice
    waitSweepTolL := bestSweepTol
    waitL := true, waitS := false, sExtL := sweepExtreme, waitStartBarL := bar_index, waitStartBarS := int(na), waitSweepLevelS := na, waitSweepTolS := na, waitRaidTextS := "", waitRaidLabelS := na, anchorMSS_S := na, internalRefS := na, internalRefBarS := na, externalRefS := na, externalRefBarS := na, internalShiftDoneS := false, externalShiftDoneS := false, localPivotDoneS := false
    structureStatus := "Awaiting Bullish Internal Shift"

bearRaidRange = high - low
bearRaidSafeRange = bearRaidRange > 0 ? bearRaidRange : 1.0
bearRaidReclaim = nz(waitSweepLevelS, high) - close
bearRaidWick = (high - close) / bearRaidSafeRange
bool bearRaidUpgrade = waitS and not active and not internalShiftDoneS and not na(waitSweepLevelS) and high >= waitSweepLevelS and high > nz(sExtH, waitSweepLevelS) and close < waitSweepLevelS and math.max(high - waitSweepLevelS, 0) <= (atrVal * sweepMaxDepth) and (bearRaidReclaim / bearRaidSafeRange) >= reclaimLvl and bearRaidWick >= wickThresh
if bearRaidUpgrade
    if not na(waitRaidLabelS)
        label.delete(waitRaidLabelS)
    waitRaidLabelS := label.new(bar_index, high, "RAID: " + waitRaidTextS, color=#00000000, textcolor=raidBearColor, style=label.style_label_down, size=f_raidLabelSize())
    sExtH := high
    waitStartBarS := bar_index

bullRaidRange = high - low
bullRaidSafeRange = bullRaidRange > 0 ? bullRaidRange : 1.0
bullRaidReclaim = close - nz(waitSweepLevelL, low)
bullRaidWick = (close - low) / bullRaidSafeRange
bool bullRaidUpgrade = waitL and not active and not internalShiftDoneL and not na(waitSweepLevelL) and low <= waitSweepLevelL and low < nz(sExtL, waitSweepLevelL) and close > waitSweepLevelL and math.max(waitSweepLevelL - low, 0) <= (atrVal * sweepMaxDepth) and (bullRaidReclaim / bullRaidSafeRange) >= reclaimLvl and bullRaidWick >= wickThresh
if bullRaidUpgrade
    if not na(waitRaidLabelL)
        label.delete(waitRaidLabelL)
    waitRaidLabelL := label.new(bar_index, low, "RAID: " + waitRaidTextL, color=#00000000, textcolor=raidBullColor, style=label.style_label_up, size=f_raidLabelSize())
    sExtL := low
    waitStartBarL := bar_index

bool sweepWaitExpiredS = waitS and not na(waitStartBarS) and (bar_index - waitStartBarS) > sweepMssTimeoutBars
bool sweepWaitExpiredL = waitL and not na(waitStartBarL) and (bar_index - waitStartBarL) > sweepMssTimeoutBars
if sweepWaitExpiredS
    if showSweepTimeoutNote
        label.new(bar_index, sExtH, "SWEEP EXPIRED", color=#00000000, textcolor=color.silver, style=label.style_label_down, size=size.tiny)
    waitS := false
    waitStartBarS := int(na)
    waitSweepLevelS := na
    waitSweepTolS := na
    waitRaidTextS := ""
    waitRaidLabelS := na
    anchorMSS_S := na
    internalRefS := na
    internalRefBarS := na
    externalRefS := na
    externalRefBarS := na
    internalShiftDoneS := false
    externalShiftDoneS := false
    localPivotDoneS := false
    sExtH := na
    structureStatus := f_structureBaseStatus(structureTrend)
if sweepWaitExpiredL
    if showSweepTimeoutNote
        label.new(bar_index, sExtL, "SWEEP EXPIRED", color=#00000000, textcolor=color.silver, style=label.style_label_up, size=size.tiny)
    waitL := false
    waitStartBarL := int(na)
    waitSweepLevelL := na
    waitSweepTolL := na
    waitRaidTextL := ""
    waitRaidLabelL := na
    anchorMSS_L := na
    internalRefL := na
    internalRefBarL := na
    externalRefL := na
    externalRefBarL := na
    internalShiftDoneL := false
    externalShiftDoneL := false
    localPivotDoneL := false
    sExtL := na
    structureStatus := f_structureBaseStatus(structureTrend)

float structureRange = high - low
float structureSafeRange = structureRange > 0 ? structureRange : 1.0
float bodyEff = math.abs(close - open) / structureSafeRange
bool bearImbalanceCreated = high < low[2]
bool bullImbalanceCreated = low > high[2]
bool bearObviousRepricing = atrVal > 0 and structureRange >= atrVal * 0.85 and bodyEff > 0.62
bool bullObviousRepricing = atrVal > 0 and structureRange >= atrVal * 0.85 and bodyEff > 0.62
bool bearStructureImpulse = showSMC and close < open and disp and ((close - low) / structureSafeRange) <= 0.25 and (bearImbalanceCreated or bearObviousRepricing)
bool bullStructureImpulse = showSMC and close > open and disp and ((high - close) / structureSafeRange) <= 0.25 and (bullImbalanceCreated or bullObviousRepricing)
float internalBreakTolS = not na(internalRefS) ? math.max(f_liqTouchTolerance(internalRefS) * 0.35, atrVal * 0.05) : atrVal * 0.05
float internalBreakTolL = not na(internalRefL) ? math.max(f_liqTouchTolerance(internalRefL) * 0.35, atrVal * 0.05) : atrVal * 0.05
float externalBreakTolS = not na(externalRefS) ? math.max(f_liqTouchTolerance(externalRefS) * 0.35, atrVal * 0.05) : atrVal * 0.05
float externalBreakTolL = not na(externalRefL) ? math.max(f_liqTouchTolerance(externalRefL) * 0.35, atrVal * 0.05) : atrVal * 0.05

bool localPivotBreakS = showSMC and waitS and not internalShiftDoneS and not na(lSwl) and not na(internalRefS) and not na(lSwlBar) and lSwlBar > nz(waitStartBarS, -1) and lSwl > internalRefS and close < (lSwl - internalBreakTolS) and close >= (internalRefS - internalBreakTolS) and bearStructureImpulse
bool localPivotBreakL = showSMC and waitL and not internalShiftDoneL and not na(lSwh) and not na(internalRefL) and not na(lSwhBar) and lSwhBar > nz(waitStartBarL, -1) and lSwh < internalRefL and close > (lSwh + internalBreakTolL) and close <= (internalRefL + internalBreakTolL) and bullStructureImpulse

bool internalBreakS = showSMC and waitS and not internalShiftDoneS and not na(internalRefS) and close < (internalRefS - internalBreakTolS) and bearStructureImpulse
bool internalBreakL = showSMC and waitL and not internalShiftDoneL and not na(internalRefL) and close > (internalRefL + internalBreakTolL) and bullStructureImpulse

bool externalBreakS = showSMC and waitS and (internalShiftDoneS or internalBreakS) and not externalShiftDoneS and not na(externalRefS) and close < (externalRefS - externalBreakTolS) and bearStructureImpulse
bool externalBreakL = showSMC and waitL and (internalShiftDoneL or internalBreakL) and not externalShiftDoneL and not na(externalRefL) and close > (externalRefL + externalBreakTolL) and bullStructureImpulse

if localPivotBreakS and not localPivotDoneS
    localPivotDoneS := true
    structureStatus := "Bearish (Local Break)"
    label.new(bar_index, high, "LOCAL PIVOT BREAK ↘", color=#00000000, textcolor=color.silver, style=label.style_label_down, size=size.tiny)
if localPivotBreakL and not localPivotDoneL
    localPivotDoneL := true
    structureStatus := "Bullish (Local Break)"
    label.new(bar_index, low, "LOCAL PIVOT BREAK ↗", color=#00000000, textcolor=color.silver, style=label.style_label_up, size=size.tiny)

if internalBreakS
    internalShiftDoneS := true
    anchorMSS_S := internalRefS
    structureStatus := "Bearish (Internal)"
    if not externalBreakS
        label.new(bar_index, high, "INTERNAL SHIFT ↘", color=#00000000, textcolor=breakoutBearColor, style=label.style_label_down, size=f_breakoutLabelSize())
if internalBreakL
    internalShiftDoneL := true
    anchorMSS_L := internalRefL
    structureStatus := "Bullish (Internal)"
    if not externalBreakL
        label.new(bar_index, low, "INTERNAL SHIFT ↗", color=#00000000, textcolor=breakoutBullColor, style=label.style_label_up, size=f_breakoutLabelSize())

if externalBreakS
    externalShiftDoneS := true
    structureTrend := -1
    structureStatus := trendAtSweepS == -1 ? "Bearish (BOS)" : "Bearish (External)"
    label.new(bar_index, high, trendAtSweepS == -1 ? "CONTINUATION BOS ↘" : "EXTERNAL SHIFT ↘", color=#00000000, textcolor=breakoutBearColor, style=label.style_label_down, size=f_breakoutLabelSize())
if externalBreakL
    externalShiftDoneL := true
    structureTrend := 1
    structureStatus := trendAtSweepL == 1 ? "Bullish (BOS)" : "Bullish (External)"
    label.new(bar_index, low, trendAtSweepL == 1 ? "CONTINUATION BOS ↗" : "EXTERNAL SHIFT ↗", color=#00000000, textcolor=breakoutBullColor, style=label.style_label_up, size=f_breakoutLabelSize())

bool mssS = showSMC and (useMajorMSS ? externalBreakS : internalBreakS)
bool mssL = showSMC and (useMajorMSS ? externalBreakL : internalBreakL)

string shiftType = ""
if mssS
    shiftType := useMajorMSS ? (trendAtSweepS == -1 ? "CONTINUATION BOS ↘" : "EXTERNAL SHIFT ↘") : "INTERNAL SHIFT ↘"
if mssL
    shiftType := useMajorMSS ? (trendAtSweepL == 1 ? "CONTINUATION BOS ↗" : "EXTERNAL SHIFT ↗") : "INTERNAL SHIFT ↗"

// --- Stats Logic ---
if mssS and not active and not blockShortEntry
    active := true, bull := false, tSetups += 1
    tSL := (stopModel == "Sweep Extreme") ? sExtH : high
    float entryRefS = useMajorMSS ? externalRefS : internalRefS
    t10 := entryRefS - (sExtH - entryRefS)
    activeProjStartBar := bar_index
    waitS := false, waitStartBarS := int(na), waitSweepLevelS := na, waitSweepTolS := na, waitRaidTextS := "", waitRaidLabelS := na, anchorMSS_S := na, internalRefS := na, internalRefBarS := na, externalRefS := na, externalRefBarS := na, internalShiftDoneS := false, externalShiftDoneS := false, localPivotDoneS := false
    label.new(bar_index, low, "ENTRY [" + shiftType + "]", color=COLOR_BEAR, textcolor=color.white, style=label.style_label_down, size=size.small)
else if mssS and not active and blockShortEntry
    structureStatus := "Bearish MSS (HTF Blocked)"
    label.new(bar_index, low, "ENTRY BLOCKED [HTF: " + htfCompositeState + "]", color=#00000000, textcolor=color.silver, style=label.style_label_down, size=size.tiny)

if mssL and not active and not blockLongEntry
    active := true, bull := true, tSetups += 1
    tSL := (stopModel == "Sweep Extreme") ? sExtL : low
    float entryRefL = useMajorMSS ? externalRefL : internalRefL
    t10 := entryRefL + (entryRefL - sExtL)
    activeProjStartBar := bar_index
    waitL := false, waitStartBarL := int(na), waitSweepLevelL := na, waitSweepTolL := na, waitRaidTextL := "", waitRaidLabelL := na, anchorMSS_L := na, internalRefL := na, internalRefBarL := na, externalRefL := na, externalRefBarL := na, internalShiftDoneL := false, externalShiftDoneL := false, localPivotDoneL := false
    label.new(bar_index, high, "ENTRY [" + shiftType + "]", color=COLOR_BULL, textcolor=color.white, style=label.style_label_up, size=size.small)
else if mssL and not active and blockLongEntry
    structureStatus := "Bullish MSS (HTF Blocked)"
    label.new(bar_index, high, "ENTRY BLOCKED [HTF: " + htfCompositeState + "]", color=#00000000, textcolor=color.silver, style=label.style_label_up, size=size.tiny)

if active and showProj and not na(t10) and not na(activeProjStartBar)
    line.set_xy1(activeProjLine, activeProjStartBar, t10)
    line.set_xy2(activeProjLine, bar_index + 15, t10)
    line.set_color(activeProjLine, bull ? COLOR_BULL : COLOR_BEAR)
    line.set_style(activeProjLine, line.style_dashed)
else
    line.set_xy1(activeProjLine, na, na)
    line.set_xy2(activeProjLine, na, na)

if active
    if bull
        if low < tSL
            active := false, activeProjStartBar := int(na), l10 += 1
        else if high > t10
            w10 += 1, active := false, activeProjStartBar := int(na)
    else
        if high > tSL
            active := false, activeProjStartBar := int(na), l10 += 1
        else if low < t10
            w10 += 1, active := false, activeProjStartBar := int(na)

if not active or not showProj
    line.set_xy1(activeProjLine, na, na)
    line.set_xy2(activeProjLine, na, na)

// --- Reaction Zone Narrative Engine ---
f_findActiveLiquidityBeyond(string liqSide, float anchorPrice, float maxWindowAtr) =>
    bool found = false
    float bestPrice = na
    string bestLabel = ""
    float bestScore = -100000.0
    if not na(anchorPrice) and atrVal > 0 and liq_pools.size() > 0
        float anchorTol = f_liqTouchTolerance(anchorPrice)
        for i = 0 to liq_pools.size() - 1
            pool = liq_pools.get(i)
            bool sameSide = pool.side == liqSide
            bool stillActive = f_liqIsEventEligible(pool) and not pool.isSwept and pool.state != "CONSUMED"
            bool meaningful = f_liqIsExternal(pool.poolType) or pool.poolType == "EQ" or pool.structuralRank >= 70.0
            if sameSide and stillActive and meaningful
                float beyondDist = liqSide == "SSL" ? anchorPrice - pool.price : pool.price - anchorPrice
                bool beyondAnchor = beyondDist > (anchorTol * 0.35)
                bool insideWindow = beyondDist <= (atrVal * maxWindowAtr)
                if beyondAnchor and insideWindow
                    float score = f_liqRetentionScore(pool) - (beyondDist / atrVal) * 8.0 + (pool.poolType == "EQ" ? 6.0 : 0.0)
                    if score > bestScore
                        bestScore := score
                        bestPrice := pool.price
                        bestLabel := f_liqCompactBaseLabel(pool)
                        found := true
    [found, bestPrice, bestLabel]

var int lastMssBarL = 0
var int lastMssBarS = 0
if mssL
    lastMssBarL := bar_index
if mssS
    lastMssBarS := bar_index

var rz_candidates = array.new<reaction_zone>(0)
rzAtr = ta.atr(14)

if showRZ
    array.clear(rz_candidates)

    // Check if narrative is active (Recent MSS within 60 bars)
    isNarrativeL = lastMssBarL > (bar_index - 60)
    isNarrativeS = lastMssBarS > (bar_index - 60)

    // 1. Fresh post-shift FVGs (Priority 1)
    if fvg_records.size() > 0
        for i = 0 to fvg_records.size() - 1
            f_dat = fvg_records.get(i)
            isLinkedL = isNarrativeL and f_dat.startBar >= lastMssBarL - 5 and f_dat.startBar <= lastMssBarL + 8
            isLinkedS = isNarrativeS and f_dat.startBar >= lastMssBarS - 5 and f_dat.startBar <= lastMssBarS + 8

            if f_dat.isBull and isLinkedL
                rz_candidates.push(reaction_zone.new("Long", "FVG", f_dat.max, f_dat.min, (f_dat.max+f_dat.min)/2, f_dat.startBar, 1, 100.0, false, false, "BULL FVG"))
            else if not f_dat.isBull and isLinkedS
                rz_candidates.push(reaction_zone.new("Short", "FVG", f_dat.max, f_dat.min, (f_dat.max+f_dat.min)/2, f_dat.startBar, 1, 100.0, false, false, "BEAR FVG"))

    // 2. Structural OB (Priority 2)
    if isNarrativeL and not na(lSwh)
        rz_candidates.push(reaction_zone.new("Long", "OB", lSwh, lSwh - (high[1]-low[1]), lSwh, lastMssBarL, 2, 90.0, false, false, "BULL OB"))
    if isNarrativeS and not na(lSwl)
        rz_candidates.push(reaction_zone.new("Short", "OB", lSwl + (high[1]-low[1]), lSwl, lSwl, lastMssBarS, 2, 90.0, false, false, "BEAR OB"))

    // 3. Sweep Reclaim (Priority 3)
    if waitL and not na(sExtL)
        [longDeeperActive, longDeeperPrice, longDeeperLabel] = f_findActiveLiquidityBeyond("SSL", sExtL, rzIncompleteSweepWindowAtr)
        bool longSweepIncomplete = rzDowngradeIncompleteSweep and longDeeperActive
        string longSweepNarrative = longSweepIncomplete ? "INTERMEDIATE SWEEP | Deeper " + longDeeperLabel + " active" : "SWEEP RECLAIM (AGGR)"
        string longSweepType = longSweepIncomplete ? "SWEEP_CTX" : "SWEEP"
        int longSweepPriority = 3
        float longSweepScore = longSweepIncomplete ? 68.0 : 80.0
        rz_candidates.push(reaction_zone.new("Long", longSweepType, sExtL + syminfo.mintick*10, sExtL, sExtL + syminfo.mintick*5, nz(waitStartBarL, bar_index), longSweepPriority, longSweepScore, false, false, longSweepNarrative))
    if waitS and not na(sExtH)
        [shortDeeperActive, shortDeeperPrice, shortDeeperLabel] = f_findActiveLiquidityBeyond("BSL", sExtH, rzIncompleteSweepWindowAtr)
        bool shortSweepIncomplete = rzDowngradeIncompleteSweep and shortDeeperActive
        string shortSweepNarrative = shortSweepIncomplete ? "INTERMEDIATE SWEEP | Higher " + shortDeeperLabel + " active" : "SWEEP RECLAIM (AGGR)"
        string shortSweepType = shortSweepIncomplete ? "SWEEP_CTX" : "SWEEP"
        int shortSweepPriority = 3
        float shortSweepScore = shortSweepIncomplete ? 68.0 : 80.0
        rz_candidates.push(reaction_zone.new("Short", shortSweepType, sExtH, sExtH - syminfo.mintick*10, sExtH - syminfo.mintick*5, nz(waitStartBarS, bar_index), shortSweepPriority, shortSweepScore, false, false, shortSweepNarrative))

    // 4. Target / HTF Levels (Priority 4)
    if not na(lastHtf2PH) and high < lastHtf2PH
        rz_candidates.push(reaction_zone.new("Short", "EXT", lastHtf2PH + syminfo.mintick*5, lastHtf2PH - syminfo.mintick*5, lastHtf2PH, bar_index, 4, 70.0, false, false, "HTF TARGET"))
    if not na(lastHtf2PL) and low > lastHtf2PL
        rz_candidates.push(reaction_zone.new("Long", "EXT", lastHtf2PL + syminfo.mintick*5, lastHtf2PL - syminfo.mintick*5, lastHtf2PL, bar_index, 4, 70.0, false, false, "HTF TARGET"))

    // --- Filter: Proximity (ATR) ---
    if rz_candidates.size() > 0
        for i = rz_candidates.size() - 1 to 0
            z_p = rz_candidates.get(i)
            if math.abs(z_p.ce - close) > (rzAtr * rzProximityMult)
                rz_candidates.remove(i)

    // --- Logic: Merge Overlapping Zones ---
    if rzMergeZones and rz_candidates.size() > 1
        for i = 0 to math.min(20, rz_candidates.size() - 2)
            z1 = rz_candidates.get(i)
            for j = i + 1 to rz_candidates.size() - 1
                z2 = rz_candidates.get(j)
                if z1.side == z2.side
                    isOverlap = math.max(z1.bottom, z2.bottom) <= math.min(z1.top, z2.top)
                    if isOverlap
                        newT = math.max(z1.top, z2.top)
                        newB = math.min(z1.bottom, z2.bottom)
                        rz_candidates.set(i, reaction_zone.new(z1.side, "CONFLUENCE", newT, newB, (newT+newB)/2, z1.sourceBar, 1, 110.0, false, false, "CONFLUENCE"))
                        rz_candidates.remove(j)
                        break

// Filter Top 1 per side
f_getTopZone(side) =>
    reaction_zone best = na
    int bestRank = 99
    float bestScore = -1.0
    if rz_candidates.size() > 0
        for i = 0 to rz_candidates.size() - 1
            z_c = rz_candidates.get(i)
            if z_c.side == side
                if z_c.priorityRank < bestRank or (z_c.priorityRank == bestRank and z_c.score > bestScore)
                    best := z_c
                    bestRank := z_c.priorityRank
                    bestScore := z_c.score
    best

reaction_zone topLong  = f_getTopZone("Long")
reaction_zone topShort = f_getTopZone("Short")

// Visual Rendering Logic
update_rz_vis(reaction_zone z, string side, box b, line l, label lb) =>
    if not na(z)
        isEntry = (z.zoneType == "FVG" or z.zoneType == "OB" or z.zoneType == "SWEEP" or z.zoneType == "CONFLUENCE")
        isWatch = z.zoneType == "SWEEP_CTX"
        baseClr = side == "Long" ? rzEntryColor : rzBearColor
        if isWatch
            baseClr := rzTargetColor
        else if not isEntry
            baseClr := rzTargetColor

        box.set_lefttop(b, bar_index - 15, z.top)
        box.set_rightbottom(b, bar_index + 8, z.bottom)
        box.set_bgcolor(b, color.new(baseClr, isEntry ? 70 : isWatch ? 82 : 85))
        box.set_border_color(b, color.new(baseClr, isEntry ? 30 : isWatch ? 45 : 60))
        box.set_border_style(b, isEntry ? line.style_solid : line.style_dotted)

        if showRZCE
            line.set_xy1(l, bar_index - 15, z.ce)
            line.set_xy2(l, bar_index + 8, z.ce)
            line.set_color(l, color.new(baseClr, 40))
            line.set_style(l, line.style_dashed)
        else
            line.set_xy1(l, na, na)

        if showRZLabels
            label.set_xy(lb, bar_index + 8, z.ce)
            label.set_text(lb, z.narrative + (isEntry ? " [ENTRY]" : isWatch ? " [WATCH]" : " [TARGET]"))
            label.set_textcolor(lb, baseClr)
            label.set_style(lb, label.style_label_left)
        else
            label.set_text(lb, "")
    else
        box.set_bgcolor(b, na)
        box.set_border_color(b, na)
        line.set_xy1(l, na, na)
        label.set_text(lb, "")

var box bLong = box.new(na, na, na, na, border_color=na)
var line lLong = line.new(na, na, na, na)
var label lbLong = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)

var box bShort = box.new(na, na, na, na, border_color=na)
var line lShort = line.new(na, na, na, na)
var label lbShort = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)

if barstate.islast
    update_rz_vis(topLong, "Long", bLong, lLong, lbLong)
    update_rz_vis(topShort, "Short", bShort, lShort, lbShort)

// --- Big Move / Spike Memory Engine ---
var bigMoveEvents = array.new<big_move_event>(0)
var bigMoveBoxes = array.new_box(0)
var bigMoveCeLines = array.new_line(0)
var bigMoveLabels = array.new_label(0)
var label bigMoveHintLabel = label.new(na, na, "", color=#00000000, style=label.style_label_left, size=size.small)
var bool bigMoveClusterActive = false
var string bigMoveClusterType = ""
var string bigMoveClusterDirection = ""
var int bigMoveClusterStartBar = na
var int bigMoveClusterEndBar = na
var int bigMoveClusterBestBar = na
var int bigMoveClusterTime = na
var float bigMoveClusterHigh = na
var float bigMoveClusterLow = na
var float bigMoveClusterRangeAtr = 0.0
var float bigMoveClusterBodyPct = 0.0
var float bigMoveClusterWickPct = 0.0
var float bigMoveClusterRelVol = 0.0
var float bigMoveClusterBestScore = 0.0
var string bigMoveClusterSession = ""
var string bigMoveClusterKillzone = ""
var string bigMoveClusterPhase = ""
var bool bigMoveClusterLiq = false
var bool bigMoveClusterFvg = false
var bool bigMoveClusterSweep = false
var string bigMoveClusterNarrative = ""
var big_move_timing_snapshot bigMoveSnapshot = big_move_timing_snapshot.new("—", "—", "—", "—", "—", "LOW PROBABILITY", "—", 0.0, 0, 0.0, 0.0, false)

f_bigMoveTablePos() =>
    bigMoveTimingTablePos == "Top Right" ? position.top_right : bigMoveTimingTablePos == "Top Left" ? position.top_left : bigMoveTimingTablePos == "Bottom Right" ? position.bottom_right : position.bottom_left

f_bigMovePad2(int val) =>
    val < 10 ? "0" + str.tostring(val) : str.tostring(val)

f_bigMoveBucketName(int idx) =>
    int bucket = int(math.max(0, math.min(95, idx)))
    int hh = int(math.floor(bucket / 4))
    int mm = (bucket % 4) * 15
    f_bigMovePad2(hh) + ":" + f_bigMovePad2(mm) + " UTC"

f_bigMoveTrimSessionString(string sess) =>
    int colonIdx = str.pos(sess, ":")
    colonIdx >= 0 ? str.substring(sess, 0, colonIdx) : sess

f_bigMoveMinuteFromPart(string hhmm) =>
    int hh = int(str.tonumber(str.substring(hhmm, 0, 2)))
    int mm = int(str.tonumber(str.substring(hhmm, 2, 4)))
    hh * 60 + mm

f_bigMoveResolveSessionPhase(string sess, string tz, bool isActive) =>
    string phase = "OFF"
    if isActive
        string cleanSess = f_bigMoveTrimSessionString(sess)
        int startMin = f_bigMoveMinuteFromPart(str.substring(cleanSess, 0, 4))
        int endMin = f_bigMoveMinuteFromPart(str.substring(cleanSess, 5, 9))
        int curMin = hour(time, tz) * 60 + minute(time, tz)
        int span = endMin >= startMin ? endMin - startMin : 1440 - startMin + endMin
        int elapsed = curMin >= startMin ? curMin - startMin : 1440 - startMin + curMin
        float progress = span > 0 ? float(math.min(math.max(elapsed, 0), span)) / float(span) : 0.5
        phase := progress < 0.33 ? "OPEN" : progress > 0.66 ? "CLOSE" : "MID"
    phase

f_bigMoveSessionName() =>
    inLondon ? "London" : inNY ? "New York" : inAsia ? "Asia" : "Inter-Session"

f_bigMoveKillzoneName() =>
    inLondonSweepWindow ? "London Sweep" : inNYSweepWindow ? "NY Sweep" : inLondon ? "London" : inNY ? "New York" : inAsia ? "Asia" : "Inter-Session"

f_bigMoveCurrentSessionPhase() =>
    inLondon ? f_bigMoveResolveSessionPhase(londonSess, "UTC", true) : inNY ? f_bigMoveResolveSessionPhase(nySess, "UTC", true) : inAsia ? f_bigMoveResolveSessionPhase(asiaSession, "UTC", true) : inLondonSweepWindow ? f_bigMoveResolveSessionPhase("0700-1100:1234567", "Europe/London", true) : inNYSweepWindow ? f_bigMoveResolveSessionPhase("0830-1100:1234567", "America/New_York", true) : "OFF"

f_bigMoveHourBucket(int ts) =>
    hour(ts, "UTC")

f_bigMoveQuarterBucket(int ts) =>
    hour(ts, "UTC") * 4 + int(math.floor(minute(ts, "UTC") / 15))

f_bigMoveKillzoneIndex(string name) =>
    name == "London Sweep" ? 0 : name == "NY Sweep" ? 1 : name == "London" ? 2 : name == "New York" ? 3 : name == "Asia" ? 4 : 5

f_bigMoveKillzoneLabel(int idx) =>
    idx == 0 ? "London Sweep" : idx == 1 ? "NY Sweep" : idx == 2 ? "London" : idx == 3 ? "New York" : idx == 4 ? "Asia" : "Inter-Session"

f_bigMovePhaseIndex(string phase) =>
    phase == "OPEN" ? 0 : phase == "MID" ? 1 : phase == "CLOSE" ? 2 : 3

f_bigMovePhaseLabel(int idx) =>
    idx == 0 ? "Open" : idx == 1 ? "Mid" : idx == 2 ? "Close" : "Off"

f_bigMoveBuildEvent(int startBar, int endBar, int eventBar, int eventTime, string eventType, string direction, float highPrice, float lowPrice, float rangeAtr, float bodyPct, float wickPct, float relVolume, float score, string sessionName, string killzoneName, string sessionPhase, bool hadLiquidityConfluence, bool hadFvgConfluence, bool hadSweepConfluence, string narrative) =>
    big_move_event.new(startBar, endBar, eventBar, eventTime, eventType, direction, highPrice, lowPrice, (highPrice + lowPrice) * 0.5, rangeAtr, bodyPct, wickPct, relVolume, score, sessionName, killzoneName, sessionPhase, f_bigMoveHourBucket(eventTime), f_bigMoveQuarterBucket(eventTime), hadLiquidityConfluence, hadFvgConfluence, hadSweepConfluence, narrative)

f_bigMoveNarrative(string eventType, string direction, string killzoneName, string sessionName, string sessionPhase, string liqLabel, string fvgLabel, bool sweepFound) =>
    string ctx = killzoneName != "Inter-Session" ? killzoneName : sessionName
    string txt = eventType + " | " + ctx
    if sessionPhase != "OFF"
        txt += " " + sessionPhase
    txt += " | " + direction
    if str.length(liqLabel) > 0
        txt += " | " + liqLabel
    if str.length(fvgLabel) > 0
        txt += " | " + fvgLabel
    if sweepFound
        txt += " | SWEEP"
    txt

f_bigMoveLiquidityConfluence(float zoneHigh, float zoneLow, string direction) =>
    bool found = false
    float bestBoost = 0.0
    string bestLabel = ""
    if liq_pools.size() > 0 and atrVal > 0
        for i = 0 to liq_pools.size() - 1
            pool = liq_pools.get(i)
            bool actionable = f_liqIsEventEligible(pool) and not f_liqIsExpired(pool)
            bool stateRelevant = pool.state != "CONSUMED" or nz(pool.lastTouchBar, -1) == bar_index or nz(pool.takenBar, -1) == bar_index
            if actionable and stateRelevant
                float tol = math.max(f_liqTouchTolerance(pool.price) * 1.5, atrVal * 0.12)
                bool overlaps = zoneLow <= (pool.price + tol) and zoneHigh >= (pool.price - tol)
                bool directionalPool = direction == "BULL" ? (pool.side == "SSL" or pool.price <= zoneLow + tol) : (pool.side == "BSL" or pool.price >= zoneHigh - tol)
                if overlaps and directionalPool
                    float boost = math.min(18.0, 5.0 + f_liqRetentionScore(pool) * 0.11 + (f_liqIsExternal(pool.poolType) ? 3.0 : 0.0) + (pool.poolType == "EQ" ? 2.0 : 0.0))
                    if boost > bestBoost
                        bestBoost := boost
                        bestLabel := f_liqCompactBaseLabel(pool)
                        found := true
    [found, bestBoost, bestLabel]

f_bigMoveNearImportantLiquidity() =>
    bool near = false
    string bestLabel = ""
    float bestDist = 10e10
    if liq_pools.size() > 0 and atrVal > 0
        for i = 0 to liq_pools.size() - 1
            pool = liq_pools.get(i)
            bool meaningful = f_liqIsEventEligible(pool) and not f_liqIsExpired(pool) and pool.state != "CONSUMED" and (f_liqIsExternal(pool.poolType) or pool.poolType == "EQ" or pool.structuralRank >= 74.0)
            if meaningful
                float dist = math.abs(pool.price - close)
                if dist <= atrVal * 0.35 and dist < bestDist
                    bestDist := dist
                    bestLabel := f_liqCompactBaseLabel(pool)
                    near := true
    [near, bestLabel]

f_bigMoveFvgConfluence(float zoneHigh, float zoneLow, string direction) =>
    bool found = false
    float boost = 0.0
    string label = ""
    bool createdImbalance = direction == "BULL" ? low > high[2] : high < low[2]
    if createdImbalance
        found := true
        boost := 8.0
        label := "New imbalance"
    if fvg_records.size() > 0 and atrVal > 0
        int maxScan = int(math.min(fvg_records.size(), 10))
        for i = 0 to maxScan - 1
            f_dat = fvg_records.get(i)
            bool sameDir = direction == "BULL" ? f_dat.isBull : not f_dat.isBull
            bool recent = bar_index - f_dat.startBar <= 30
            bool overlap = zoneLow <= f_dat.max and zoneHigh >= f_dat.min
            bool nearLaunch = math.abs(((zoneHigh + zoneLow) * 0.5) - ((f_dat.max + f_dat.min) * 0.5)) <= atrVal * 0.75
            if sameDir and recent and (overlap or nearLaunch)
                found := true
                float candidateBoost = createdImbalance ? 12.0 : 7.0
                if candidateBoost > boost
                    boost := candidateBoost
                    label := createdImbalance ? "Fresh imbalance + FVG" : "Fresh FVG"
                break
    [found, boost, label]

f_bigMoveSweepConfluence(string direction) =>
    direction == "BULL" ? (swpSSL or waitL or mssL) : (swpBSL or waitS or mssS)

f_bigMoveTimeRepeatabilityBonus(int minuteBucket, string killzoneName) =>
    int bucketHits = 0
    int killzoneHits = 0
    if bigMoveEvents.size() > 0
        for i = 0 to bigMoveEvents.size() - 1
            evt = bigMoveEvents.get(i)
            if bar_index - evt.eventBar <= bigMoveLookback and evt.score >= bigMoveMinScore
                if evt.minuteBucket == minuteBucket
                    bucketHits += 1
                if evt.killzoneName == killzoneName
                    killzoneHits += 1
    math.min(8.0, bucketHits * 1.25 + killzoneHits * 0.5)

f_bigMoveScore(string eventType, float rangeAtr, float bodyPct, float wickPct, float closeExtremePct, float relVol, string sessionName, string killzoneName, float liquidityBoost, float fvgBoost, bool sweepConfluence, float repeatBonus, int clusterCount) =>
    float rangeScore = math.min(28.0, math.max(0.0, (rangeAtr - bigMoveMinRangeAtr) / math.max(bigMoveMinRangeAtr, 0.1) * 18.0 + 10.0))
    float impulseScore = eventType == "EXPANSION" ? math.min(24.0, bodyPct * 24.0 + math.max(0.0, 0.28 - closeExtremePct) * 18.0) : math.min(14.0, (1.0 - bodyPct) * 8.0 + math.max(0.0, 0.60 - closeExtremePct) * 10.0)
    float wickScore = eventType == "SPIKE" ? math.min(18.0, math.max(0.0, wickPct - spikeMinWickPct) * 28.0 + 6.0) : math.max(0.0, 8.0 - wickPct * 10.0)
    float volScore = relVol >= bigMoveVolMult ? math.min(14.0, 6.0 + (relVol - bigMoveVolMult) * 8.0) : math.max(-10.0, (relVol / math.max(bigMoveVolMult, 1.0) - 1.0) * 18.0)
    float sessionScore = 0.0
    if bigMoveUseKillzoneBoost
        sessionScore := killzoneName == "London Sweep" or killzoneName == "NY Sweep" ? 12.0 : sessionName == "London" or sessionName == "New York" ? 7.0 : sessionName == "Asia" ? 3.0 : -5.0
    float sweepScore = sweepConfluence ? 7.0 : 0.0
    float clusterScore = math.min(6.0, math.max(clusterCount - 1, 0) * 2.5)
    float noisePenalty = eventType == "EXPANSION" and wickPct > 0.40 ? -8.0 : eventType == "SPIKE" and bodyPct > 0.68 ? -6.0 : 0.0
    float score = rangeScore + impulseScore + wickScore + volScore + sessionScore + liquidityBoost + fvgBoost + sweepScore + repeatBonus + clusterScore + noisePenalty
    math.max(0.0, math.min(100.0, score))

f_bigMoveStoreEvent(big_move_event evt) =>
    if evt.score >= bigMoveMinScore
        bool merged = false
        if bigMoveEvents.size() > 0
            lastEvt = bigMoveEvents.get(0)
            float mergeTol = atrVal > 0 ? atrVal * 0.35 : syminfo.mintick * 25
            bool sameNarrative = lastEvt.direction == evt.direction and lastEvt.eventType == evt.eventType and math.abs(lastEvt.cePrice - evt.cePrice) <= mergeTol and math.abs(lastEvt.eventBar - evt.eventBar) <= bigMoveClusterBars
            if sameNarrative
                if evt.score >= lastEvt.score
                    bigMoveEvents.set(0, evt)
                merged := true
        if not merged
            bigMoveEvents.unshift(evt)
    true

f_bigMovePruneEvents() =>
    if bigMoveEvents.size() > 0
        for i = bigMoveEvents.size() - 1 to 0
            evt = bigMoveEvents.get(i)
            if bar_index - evt.eventBar > bigMoveLookback
                bigMoveEvents.remove(i)
    while bigMoveEvents.size() > bigMoveMaxStored
        int dropIdx = 0
        float lowestRetention = 10e10
        for i = 0 to bigMoveEvents.size() - 1
            evt = bigMoveEvents.get(i)
            float retention = evt.score - float(bar_index - evt.eventBar) * 0.15 + (evt.hadLiquidityConfluence ? 6.0 : 0.0) + (evt.hadFvgConfluence ? 3.0 : 0.0)
            if retention < lowestRetention
                lowestRetention := retention
                dropIdx := i
        bigMoveEvents.remove(dropIdx)
    true

f_bigMoveEventPriority(big_move_event evt) =>
    evt.score + (evt.hadLiquidityConfluence ? 6.0 : 0.0) + (evt.hadFvgConfluence ? 3.0 : 0.0) + (evt.hadSweepConfluence ? 2.0 : 0.0) - float(bar_index - evt.eventBar) * 0.08

f_bigMoveEventColor(big_move_event evt) =>
    evt.eventType == "SPIKE" ? (evt.direction == "BULL" ? COLOR_NEUT : color.orange) : (evt.direction == "BULL" ? COLOR_BULL : COLOR_BEAR)

f_bigMoveHintColor(string state) =>
    state == "HIGH EXPANSION WINDOW" ? COLOR_BULL : state == "HIGH SPIKE RISK WINDOW" ? color.orange : state == "WATCH" ? COLOR_NEUT : color.silver

f_bigMoveAggregateTimingStats(bool nearLiquidity, float currentRelVol) =>
    kzCounts = array.new_int(6, 0)
    kzHighCounts = array.new_int(6, 0)
    kzBullCounts = array.new_int(6, 0)
    kzBearCounts = array.new_int(6, 0)
    kzSpikeCounts = array.new_int(6, 0)
    kzExpansionCounts = array.new_int(6, 0)
    kzScoreSums = array.new_float(6, 0.0)
    phaseCounts = array.new_int(4, 0)
    phaseScoreSums = array.new_float(4, 0.0)
    bucketCounts = array.new_int(96, 0)
    bucketHighCounts = array.new_int(96, 0)
    bucketSpikeCounts = array.new_int(96, 0)
    bucketExpansionCounts = array.new_int(96, 0)
    bucketScoreSums = array.new_float(96, 0.0)
    int eventCount = 0
    int bullCount = 0
    int bearCount = 0
    int expansionCount = 0
    int spikeCount = 0
    float totalScore = 0.0
    float totalRelVol = 0.0
    if bigMoveEvents.size() > 0
        for i = 0 to bigMoveEvents.size() - 1
            evt = bigMoveEvents.get(i)
            if bar_index - evt.eventBar <= bigMoveLookback
                eventCount += 1
                totalScore += evt.score
                totalRelVol += evt.relVolume
                if evt.direction == "BULL"
                    bullCount += 1
                else
                    bearCount += 1
                if evt.eventType == "EXPANSION"
                    expansionCount += 1
                else
                    spikeCount += 1
                int kzIdx = f_bigMoveKillzoneIndex(evt.killzoneName)
                array.set(kzCounts, kzIdx, array.get(kzCounts, kzIdx) + 1)
                array.set(kzScoreSums, kzIdx, array.get(kzScoreSums, kzIdx) + evt.score)
                if evt.score >= bigMoveMinScore
                    array.set(kzHighCounts, kzIdx, array.get(kzHighCounts, kzIdx) + 1)
                if evt.direction == "BULL"
                    array.set(kzBullCounts, kzIdx, array.get(kzBullCounts, kzIdx) + 1)
                else
                    array.set(kzBearCounts, kzIdx, array.get(kzBearCounts, kzIdx) + 1)
                if evt.eventType == "EXPANSION"
                    array.set(kzExpansionCounts, kzIdx, array.get(kzExpansionCounts, kzIdx) + 1)
                else
                    array.set(kzSpikeCounts, kzIdx, array.get(kzSpikeCounts, kzIdx) + 1)
                int phaseIdx = f_bigMovePhaseIndex(evt.sessionPhase)
                array.set(phaseCounts, phaseIdx, array.get(phaseCounts, phaseIdx) + 1)
                array.set(phaseScoreSums, phaseIdx, array.get(phaseScoreSums, phaseIdx) + evt.score)
                int bucketIdx = int(math.max(0, math.min(95, evt.minuteBucket)))
                array.set(bucketCounts, bucketIdx, array.get(bucketCounts, bucketIdx) + 1)
                array.set(bucketScoreSums, bucketIdx, array.get(bucketScoreSums, bucketIdx) + evt.score)
                if evt.score >= bigMoveMinScore
                    array.set(bucketHighCounts, bucketIdx, array.get(bucketHighCounts, bucketIdx) + 1)
                if evt.eventType == "EXPANSION"
                    array.set(bucketExpansionCounts, bucketIdx, array.get(bucketExpansionCounts, bucketIdx) + 1)
                else
                    array.set(bucketSpikeCounts, bucketIdx, array.get(bucketSpikeCounts, bucketIdx) + 1)
    string topKillzone = "—"
    string bestAvgKillzone = "—"
    int topKillCount = 0
    float bestKillAvg = -1.0
    int topPhaseIdx = na
    int topPhaseCount = 0
    float topPhaseAvg = -1.0
    for i = 0 to 5
        int kzCount = array.get(kzCounts, i)
        float kzAvg = kzCount > 0 ? array.get(kzScoreSums, i) / kzCount : 0.0
        if kzCount > topKillCount
            topKillCount := kzCount
            topKillzone := f_bigMoveKillzoneLabel(i)
        if kzCount > 0 and kzAvg > bestKillAvg
            bestKillAvg := kzAvg
            bestAvgKillzone := f_bigMoveKillzoneLabel(i)
    for i = 0 to 3
        int phaseCount = array.get(phaseCounts, i)
        float phaseAvg = phaseCount > 0 ? array.get(phaseScoreSums, i) / phaseCount : 0.0
        if phaseCount > topPhaseCount or (phaseCount == topPhaseCount and phaseAvg > topPhaseAvg)
            topPhaseCount := phaseCount
            topPhaseAvg := phaseAvg
            topPhaseIdx := i
    int topBucketIdx = na
    int topBucketHigh = 0
    float topBucketAvg = -1.0
    for i = 0 to 95
        int bucketCount = array.get(bucketCounts, i)
        int bucketHigh = array.get(bucketHighCounts, i)
        float bucketAvg = bucketCount > 0 ? array.get(bucketScoreSums, i) / bucketCount : 0.0
        if bucketHigh > topBucketHigh or (bucketHigh == topBucketHigh and bucketAvg > topBucketAvg)
            topBucketHigh := bucketHigh
            topBucketAvg := bucketAvg
            topBucketIdx := i
    string topWindow = topKillCount > 0 ? topKillzone + (not na(topPhaseIdx) and topPhaseIdx < 3 ? " " + f_bigMovePhaseLabel(topPhaseIdx) : "") : not na(topBucketIdx) ? f_bigMoveBucketName(topBucketIdx) : "—"
    string dominantType = expansionCount == spikeCount ? "Mixed" : expansionCount > spikeCount ? "Expansion" : "Spike"
    string bias = bullCount == bearCount ? "Balanced" : bullCount > bearCount ? "Bullish" : "Bearish"
    float avgScore = eventCount > 0 ? totalScore / eventCount : 0.0
    float avgRelVol = eventCount > 0 ? totalRelVol / eventCount : 0.0
    int curBucketIdx = f_bigMoveQuarterBucket(time)
    int curBucketCount = array.get(bucketCounts, curBucketIdx)
    int curBucketHigh = array.get(bucketHighCounts, curBucketIdx)
    float curBucketAvg = curBucketCount > 0 ? array.get(bucketScoreSums, curBucketIdx) / curBucketCount : 0.0
    int curBucketSpike = array.get(bucketSpikeCounts, curBucketIdx)
    int curBucketExpansion = array.get(bucketExpansionCounts, curBucketIdx)
    int curKillIdx = f_bigMoveKillzoneIndex(f_bigMoveKillzoneName())
    int curKillCount = array.get(kzCounts, curKillIdx)
    float curKillAvg = curKillCount > 0 ? array.get(kzScoreSums, curKillIdx) / curKillCount : 0.0
    int curPhaseIdx = f_bigMovePhaseIndex(f_bigMoveCurrentSessionPhase())
    int curPhaseCount = array.get(phaseCounts, curPhaseIdx)
    float curPhaseAvg = curPhaseCount > 0 ? array.get(phaseScoreSums, curPhaseIdx) / curPhaseCount : 0.0
    int freqThreshold = eventCount >= 30 ? 3 : eventCount >= 12 ? 2 : 1
    bool strongBucket = curBucketHigh >= freqThreshold or (curBucketCount >= 2 and curBucketAvg >= bigMoveMinScore + 6.0)
    bool strongKillzone = curKillCount >= 1 and curKillAvg >= bigMoveMinScore and f_bigMoveKillzoneName() != "Inter-Session"
    bool strongPhase = curPhaseCount >= freqThreshold or (curPhaseCount >= 1 and curPhaseAvg >= bigMoveMinScore + 4.0 and curPhaseIdx < 3)
    bool volReady = currentRelVol >= 0.9
    bool liqReady = not bigMoveUseLiquidityBoost or nearLiquidity
    bool spikeDominantNow = curBucketSpike > curBucketExpansion
    string currentState = "LOW PROBABILITY"
    if strongBucket and strongKillzone and strongPhase and volReady and liqReady
        currentState := spikeDominantNow ? "HIGH SPIKE RISK WINDOW" : "HIGH EXPANSION WINDOW"
    else if (curBucketHigh >= 1 and volReady) or (strongKillzone and nearLiquidity) or (curPhaseIdx < 3 and curPhaseCount >= 1 and curPhaseAvg >= bigMoveMinScore) or (curBucketCount >= 1 and curBucketAvg >= bigMoveMinScore)
        currentState := "WATCH"
    float hitRate = curBucketCount > 0 ? float(curBucketHigh) / curBucketCount * 100.0 : 0.0
    big_move_timing_snapshot.new(topWindow, topKillzone, bestAvgKillzone, dominantType, bias, currentState, f_bigMoveBucketName(curBucketIdx), hitRate, eventCount, avgRelVol, avgScore, spikeDominantNow)

if enableBigMoveMemory and barstate.isconfirmed and atrVal > 0 and bar_index > 5
    f_bigMovePruneEvents()

    float bigMoveRange = high - low
    float bigMoveSafeRange = bigMoveRange > 0 ? bigMoveRange : syminfo.mintick
    float bigMoveBody = math.abs(close - open)
    float bigMoveBodyPctVal = bigMoveBody / bigMoveSafeRange
    float bigMoveUpperWickPct = (high - math.max(open, close)) / bigMoveSafeRange
    float bigMoveLowerWickPct = (math.min(open, close) - low) / bigMoveSafeRange
    float bigMoveRangeAtrVal = atrVal > 0 ? bigMoveRange / atrVal : 0.0
    float bigMoveRelVolVal = na(volume) or na(avgVol) or avgVol <= 0 ? 1.0 : volume / avgVol
    float bigMoveBullCloseExtreme = (high - close) / bigMoveSafeRange
    float bigMoveBearCloseExtreme = (close - low) / bigMoveSafeRange
    string bigMoveSessionName = f_bigMoveSessionName()
    string bigMoveKillzoneName = f_bigMoveKillzoneName()
    string bigMoveSessionPhase = f_bigMoveCurrentSessionPhase()
    int bigMoveMinuteBucket = f_bigMoveQuarterBucket(time)
    float bigMoveRepeatBonus = f_bigMoveTimeRepeatabilityBonus(bigMoveMinuteBucket, bigMoveKillzoneName)

    bool bullExpansionBase = bigMoveRangeAtrVal >= bigMoveMinRangeAtr and bigMoveBodyPctVal >= bigMoveMinBodyPct and close > open and bigMoveBullCloseExtreme <= 0.25 and (disp or bullStructureImpulse or bullImbalanceCreated or close > high[1])
    bool bearExpansionBase = bigMoveRangeAtrVal >= bigMoveMinRangeAtr and bigMoveBodyPctVal >= bigMoveMinBodyPct and close < open and bigMoveBearCloseExtreme <= 0.25 and (disp or bearStructureImpulse or bearImbalanceCreated or close < low[1])
    bool bullSpikeBase = bigMoveRangeAtrVal >= bigMoveMinRangeAtr * 0.85 and bigMoveLowerWickPct >= spikeMinWickPct and close >= (low + bigMoveRange * 0.55) and (bigMoveRelVolVal >= bigMoveVolMult * 0.85 or inLondonSweepWindow or inNYSweepWindow)
    bool bearSpikeBase = bigMoveRangeAtrVal >= bigMoveMinRangeAtr * 0.85 and bigMoveUpperWickPct >= spikeMinWickPct and close <= (high - bigMoveRange * 0.55) and (bigMoveRelVolVal >= bigMoveVolMult * 0.85 or inLondonSweepWindow or inNYSweepWindow)

    bool bullNeedContext = bullExpansionBase or bullSpikeBase
    bool bearNeedContext = bearExpansionBase or bearSpikeBase
    bool bullLiqFound = false
    float bullLiqBoost = 0.0
    string bullLiqLabel = ""
    bool bearLiqFound = false
    float bearLiqBoost = 0.0
    string bearLiqLabel = ""
    bool bullFvgFound = false
    float bullFvgBoost = 0.0
    string bullFvgLabel = ""
    bool bearFvgFound = false
    float bearFvgBoost = 0.0
    string bearFvgLabel = ""
    if bullNeedContext and bigMoveUseLiquidityBoost
        [bullLiqFound, bullLiqBoost, bullLiqLabel] = f_bigMoveLiquidityConfluence(high, low, "BULL")
    if bearNeedContext and bigMoveUseLiquidityBoost
        [bearLiqFound, bearLiqBoost, bearLiqLabel] = f_bigMoveLiquidityConfluence(high, low, "BEAR")
    if bullNeedContext and bigMoveUseFvgBoost
        [bullFvgFound, bullFvgBoost, bullFvgLabel] = f_bigMoveFvgConfluence(high, low, "BULL")
    if bearNeedContext and bigMoveUseFvgBoost
        [bearFvgFound, bearFvgBoost, bearFvgLabel] = f_bigMoveFvgConfluence(high, low, "BEAR")
    bool bullSweepFound = bullNeedContext ? f_bigMoveSweepConfluence("BULL") : false
    bool bearSweepFound = bearNeedContext ? f_bigMoveSweepConfluence("BEAR") : false

    string candidateType = ""
    string candidateDirection = ""
    float candidateScore = -1.0
    float candidateRangeAtr = 0.0
    float candidateBodyPct = 0.0
    float candidateWickPct = 0.0
    float candidateRelVol = 0.0
    string candidateSession = ""
    string candidateKillzone = ""
    string candidatePhase = ""
    bool candidateLiq = false
    bool candidateFvg = false
    bool candidateSweep = false
    string candidateNarrative = ""

    if bullExpansionBase
        float bullExpansionScore = f_bigMoveScore("EXPANSION", bigMoveRangeAtrVal, bigMoveBodyPctVal, math.max(bigMoveUpperWickPct, bigMoveLowerWickPct), bigMoveBullCloseExtreme, bigMoveRelVolVal, bigMoveSessionName, bigMoveKillzoneName, bullLiqBoost, bullFvgBoost, bullSweepFound, bigMoveRepeatBonus, 1)
        bool bullExpansionMeaningful = bullExpansionScore >= (bigMoveMinScore - 8.0) and (bigMoveKillzoneName != "Inter-Session" or bullLiqFound or bullFvgFound or bullSweepFound or bigMoveRelVolVal >= bigMoveVolMult * 1.15)
        if bullExpansionMeaningful and bullExpansionScore > candidateScore
            candidateType := "EXPANSION"
            candidateDirection := "BULL"
            candidateScore := bullExpansionScore
            candidateRangeAtr := bigMoveRangeAtrVal
            candidateBodyPct := bigMoveBodyPctVal
            candidateWickPct := math.max(bigMoveUpperWickPct, bigMoveLowerWickPct)
            candidateRelVol := bigMoveRelVolVal
            candidateSession := bigMoveSessionName
            candidateKillzone := bigMoveKillzoneName
            candidatePhase := bigMoveSessionPhase
            candidateLiq := bullLiqFound
            candidateFvg := bullFvgFound
            candidateSweep := bullSweepFound
            candidateNarrative := f_bigMoveNarrative(candidateType, candidateDirection, candidateKillzone, candidateSession, candidatePhase, bullLiqLabel, bullFvgLabel, bullSweepFound)

    if bearExpansionBase
        float bearExpansionScore = f_bigMoveScore("EXPANSION", bigMoveRangeAtrVal, bigMoveBodyPctVal, math.max(bigMoveUpperWickPct, bigMoveLowerWickPct), bigMoveBearCloseExtreme, bigMoveRelVolVal, bigMoveSessionName, bigMoveKillzoneName, bearLiqBoost, bearFvgBoost, bearSweepFound, bigMoveRepeatBonus, 1)
        bool bearExpansionMeaningful = bearExpansionScore >= (bigMoveMinScore - 8.0) and (bigMoveKillzoneName != "Inter-Session" or bearLiqFound or bearFvgFound or bearSweepFound or bigMoveRelVolVal >= bigMoveVolMult * 1.15)
        if bearExpansionMeaningful and bearExpansionScore > candidateScore
            candidateType := "EXPANSION"
            candidateDirection := "BEAR"
            candidateScore := bearExpansionScore
            candidateRangeAtr := bigMoveRangeAtrVal
            candidateBodyPct := bigMoveBodyPctVal
            candidateWickPct := math.max(bigMoveUpperWickPct, bigMoveLowerWickPct)
            candidateRelVol := bigMoveRelVolVal
            candidateSession := bigMoveSessionName
            candidateKillzone := bigMoveKillzoneName
            candidatePhase := bigMoveSessionPhase
            candidateLiq := bearLiqFound
            candidateFvg := bearFvgFound
            candidateSweep := bearSweepFound
            candidateNarrative := f_bigMoveNarrative(candidateType, candidateDirection, candidateKillzone, candidateSession, candidatePhase, bearLiqLabel, bearFvgLabel, bearSweepFound)

    if bullSpikeBase
        float bullSpikeScore = f_bigMoveScore("SPIKE", bigMoveRangeAtrVal, bigMoveBodyPctVal, bigMoveLowerWickPct, bigMoveBullCloseExtreme, bigMoveRelVolVal, bigMoveSessionName, bigMoveKillzoneName, bullLiqBoost, bullFvgBoost, bullSweepFound, bigMoveRepeatBonus, 1)
        bool bullSpikeMeaningful = bullSpikeScore >= (bigMoveMinScore - 10.0) and (bullLiqFound or bullSweepFound or bigMoveKillzoneName != "Inter-Session" or bigMoveRelVolVal >= bigMoveVolMult)
        if bullSpikeMeaningful and bullSpikeScore > candidateScore
            candidateType := "SPIKE"
            candidateDirection := "BULL"
            candidateScore := bullSpikeScore
            candidateRangeAtr := bigMoveRangeAtrVal
            candidateBodyPct := bigMoveBodyPctVal
            candidateWickPct := bigMoveLowerWickPct
            candidateRelVol := bigMoveRelVolVal
            candidateSession := bigMoveSessionName
            candidateKillzone := bigMoveKillzoneName
            candidatePhase := bigMoveSessionPhase
            candidateLiq := bullLiqFound
            candidateFvg := bullFvgFound
            candidateSweep := bullSweepFound
            candidateNarrative := f_bigMoveNarrative(candidateType, candidateDirection, candidateKillzone, candidateSession, candidatePhase, bullLiqLabel, bullFvgLabel, bullSweepFound)

    if bearSpikeBase
        float bearSpikeScore = f_bigMoveScore("SPIKE", bigMoveRangeAtrVal, bigMoveBodyPctVal, bigMoveUpperWickPct, bigMoveBearCloseExtreme, bigMoveRelVolVal, bigMoveSessionName, bigMoveKillzoneName, bearLiqBoost, bearFvgBoost, bearSweepFound, bigMoveRepeatBonus, 1)
        bool bearSpikeMeaningful = bearSpikeScore >= (bigMoveMinScore - 10.0) and (bearLiqFound or bearSweepFound or bigMoveKillzoneName != "Inter-Session" or bigMoveRelVolVal >= bigMoveVolMult)
        if bearSpikeMeaningful and bearSpikeScore > candidateScore
            candidateType := "SPIKE"
            candidateDirection := "BEAR"
            candidateScore := bearSpikeScore
            candidateRangeAtr := bigMoveRangeAtrVal
            candidateBodyPct := bigMoveBodyPctVal
            candidateWickPct := bigMoveUpperWickPct
            candidateRelVol := bigMoveRelVolVal
            candidateSession := bigMoveSessionName
            candidateKillzone := bigMoveKillzoneName
            candidatePhase := bigMoveSessionPhase
            candidateLiq := bearLiqFound
            candidateFvg := bearFvgFound
            candidateSweep := bearSweepFound
            candidateNarrative := f_bigMoveNarrative(candidateType, candidateDirection, candidateKillzone, candidateSession, candidatePhase, bearLiqLabel, bearFvgLabel, bearSweepFound)

    bool hasCandidate = candidateScore >= 0
    if hasCandidate
        bool clusterCompatible = bigMoveClusterActive and candidateDirection == bigMoveClusterDirection and (bar_index - bigMoveClusterEndBar) <= 1 and (bar_index - bigMoveClusterStartBar + 1) <= bigMoveClusterBars and (candidateType == bigMoveClusterType or candidateScore >= bigMoveClusterBestScore - 8.0)
        if clusterCompatible
            bigMoveClusterEndBar := bar_index
            bigMoveClusterHigh := math.max(bigMoveClusterHigh, high)
            bigMoveClusterLow := math.min(bigMoveClusterLow, low)
            float clusterSpanAtr = atrVal > 0 ? (bigMoveClusterHigh - bigMoveClusterLow) / atrVal : candidateRangeAtr
            bigMoveClusterRangeAtr := math.max(bigMoveClusterRangeAtr, math.max(candidateRangeAtr, clusterSpanAtr))
            bigMoveClusterLiq := bigMoveClusterLiq or candidateLiq
            bigMoveClusterFvg := bigMoveClusterFvg or candidateFvg
            bigMoveClusterSweep := bigMoveClusterSweep or candidateSweep
            if candidateScore >= bigMoveClusterBestScore
                bigMoveClusterType := candidateType
                bigMoveClusterBestScore := candidateScore
                bigMoveClusterBestBar := bar_index
                bigMoveClusterTime := time
                bigMoveClusterBodyPct := candidateBodyPct
                bigMoveClusterWickPct := candidateWickPct
                bigMoveClusterRelVol := candidateRelVol
                bigMoveClusterSession := candidateSession
                bigMoveClusterKillzone := candidateKillzone
                bigMoveClusterPhase := candidatePhase
                bigMoveClusterNarrative := candidateNarrative
        else
            if bigMoveClusterActive
                int clusterBarsCount = math.max(bigMoveClusterEndBar - bigMoveClusterStartBar + 1, 1)
                float clusterSpanAtr = atrVal > 0 ? (bigMoveClusterHigh - bigMoveClusterLow) / atrVal : bigMoveClusterRangeAtr
                float finalRangeAtr = math.max(bigMoveClusterRangeAtr, clusterSpanAtr)
                float finalScore = math.min(100.0, bigMoveClusterBestScore + math.min(6.0, float(clusterBarsCount - 1) * 2.0) + math.max(0.0, finalRangeAtr - bigMoveClusterRangeAtr) * 4.0)
                big_move_event committed = f_bigMoveBuildEvent(bigMoveClusterStartBar, bigMoveClusterEndBar, bigMoveClusterBestBar, bigMoveClusterTime, bigMoveClusterType, bigMoveClusterDirection, bigMoveClusterHigh, bigMoveClusterLow, finalRangeAtr, bigMoveClusterBodyPct, bigMoveClusterWickPct, bigMoveClusterRelVol, finalScore, bigMoveClusterSession, bigMoveClusterKillzone, bigMoveClusterPhase, bigMoveClusterLiq, bigMoveClusterFvg, bigMoveClusterSweep, bigMoveClusterNarrative)
                f_bigMoveStoreEvent(committed)
            bigMoveClusterActive := true
            bigMoveClusterType := candidateType
            bigMoveClusterDirection := candidateDirection
            bigMoveClusterStartBar := bar_index
            bigMoveClusterEndBar := bar_index
            bigMoveClusterBestBar := bar_index
            bigMoveClusterTime := time
            bigMoveClusterHigh := high
            bigMoveClusterLow := low
            bigMoveClusterRangeAtr := candidateRangeAtr
            bigMoveClusterBodyPct := candidateBodyPct
            bigMoveClusterWickPct := candidateWickPct
            bigMoveClusterRelVol := candidateRelVol
            bigMoveClusterBestScore := candidateScore
            bigMoveClusterSession := candidateSession
            bigMoveClusterKillzone := candidateKillzone
            bigMoveClusterPhase := candidatePhase
            bigMoveClusterLiq := candidateLiq
            bigMoveClusterFvg := candidateFvg
            bigMoveClusterSweep := candidateSweep
            bigMoveClusterNarrative := candidateNarrative
    else if bigMoveClusterActive and bar_index > bigMoveClusterEndBar
        int clusterBarsCount = math.max(bigMoveClusterEndBar - bigMoveClusterStartBar + 1, 1)
        float clusterSpanAtr = atrVal > 0 ? (bigMoveClusterHigh - bigMoveClusterLow) / atrVal : bigMoveClusterRangeAtr
        float finalRangeAtr = math.max(bigMoveClusterRangeAtr, clusterSpanAtr)
        float finalScore = math.min(100.0, bigMoveClusterBestScore + math.min(6.0, float(clusterBarsCount - 1) * 2.0) + math.max(0.0, finalRangeAtr - bigMoveClusterRangeAtr) * 4.0)
        big_move_event committed = f_bigMoveBuildEvent(bigMoveClusterStartBar, bigMoveClusterEndBar, bigMoveClusterBestBar, bigMoveClusterTime, bigMoveClusterType, bigMoveClusterDirection, bigMoveClusterHigh, bigMoveClusterLow, finalRangeAtr, bigMoveClusterBodyPct, bigMoveClusterWickPct, bigMoveClusterRelVol, finalScore, bigMoveClusterSession, bigMoveClusterKillzone, bigMoveClusterPhase, bigMoveClusterLiq, bigMoveClusterFvg, bigMoveClusterSweep, bigMoveClusterNarrative)
        f_bigMoveStoreEvent(committed)
        bigMoveClusterActive := false
        bigMoveClusterType := ""
        bigMoveClusterDirection := ""
        bigMoveClusterStartBar := na
        bigMoveClusterEndBar := na
        bigMoveClusterBestBar := na
        bigMoveClusterTime := na
        bigMoveClusterHigh := na
        bigMoveClusterLow := na
        bigMoveClusterRangeAtr := 0.0
        bigMoveClusterBodyPct := 0.0
        bigMoveClusterWickPct := 0.0
        bigMoveClusterRelVol := 0.0
        bigMoveClusterBestScore := 0.0
        bigMoveClusterSession := ""
        bigMoveClusterKillzone := ""
        bigMoveClusterPhase := ""
        bigMoveClusterLiq := false
        bigMoveClusterFvg := false
        bigMoveClusterSweep := false
        bigMoveClusterNarrative := ""

    f_bigMovePruneEvents()

if enableBigMoveMemory and barstate.islast and barstate.isconfirmed and bigMoveClusterActive and bigMoveClusterEndBar == bar_index
    int clusterBarsCount = math.max(bigMoveClusterEndBar - bigMoveClusterStartBar + 1, 1)
    float clusterSpanAtr = atrVal > 0 ? (bigMoveClusterHigh - bigMoveClusterLow) / atrVal : bigMoveClusterRangeAtr
    float finalRangeAtr = math.max(bigMoveClusterRangeAtr, clusterSpanAtr)
    float finalScore = math.min(100.0, bigMoveClusterBestScore + math.min(6.0, float(clusterBarsCount - 1) * 2.0) + math.max(0.0, finalRangeAtr - bigMoveClusterRangeAtr) * 4.0)
    big_move_event committed = f_bigMoveBuildEvent(bigMoveClusterStartBar, bigMoveClusterEndBar, bigMoveClusterBestBar, bigMoveClusterTime, bigMoveClusterType, bigMoveClusterDirection, bigMoveClusterHigh, bigMoveClusterLow, finalRangeAtr, bigMoveClusterBodyPct, bigMoveClusterWickPct, bigMoveClusterRelVol, finalScore, bigMoveClusterSession, bigMoveClusterKillzone, bigMoveClusterPhase, bigMoveClusterLiq, bigMoveClusterFvg, bigMoveClusterSweep, bigMoveClusterNarrative)
    f_bigMoveStoreEvent(committed)
    f_bigMovePruneEvents()
    bigMoveClusterActive := false
    bigMoveClusterType := ""
    bigMoveClusterDirection := ""
    bigMoveClusterStartBar := na
    bigMoveClusterEndBar := na
    bigMoveClusterBestBar := na
    bigMoveClusterTime := na
    bigMoveClusterHigh := na
    bigMoveClusterLow := na
    bigMoveClusterRangeAtr := 0.0
    bigMoveClusterBodyPct := 0.0
    bigMoveClusterWickPct := 0.0
    bigMoveClusterRelVol := 0.0
    bigMoveClusterBestScore := 0.0
    bigMoveClusterSession := ""
    bigMoveClusterKillzone := ""
    bigMoveClusterPhase := ""
    bigMoveClusterLiq := false
    bigMoveClusterFvg := false
    bigMoveClusterSweep := false
    bigMoveClusterNarrative := ""

if barstate.islast
    float bigMoveCurrentRelVol = na(volume) or na(avgVol) or avgVol <= 0 ? 1.0 : volume / avgVol
    [bigMoveNearLiquidity, bigMoveNearLiquidityLabel] = f_bigMoveNearImportantLiquidity()
    if enableBigMoveMemory
        bigMoveSnapshot := f_bigMoveAggregateTimingStats(bigMoveNearLiquidity, bigMoveCurrentRelVol)
    else
        bigMoveSnapshot := big_move_timing_snapshot.new("—", "—", "—", "—", "—", "LOW PROBABILITY", "—", 0.0, 0, 0.0, 0.0, false)

    if bigMoveBoxes.size() > 0
        for i = bigMoveBoxes.size() - 1 to 0
            box.delete(bigMoveBoxes.get(i))
        array.clear(bigMoveBoxes)
    if bigMoveCeLines.size() > 0
        for i = bigMoveCeLines.size() - 1 to 0
            line.delete(bigMoveCeLines.get(i))
        array.clear(bigMoveCeLines)
    if bigMoveLabels.size() > 0
        for i = bigMoveLabels.size() - 1 to 0
            label.delete(bigMoveLabels.get(i))
        array.clear(bigMoveLabels)

    if enableBigMoveMemory and (showBigMoveZones or showBigMoveLabels) and bigMoveEvents.size() > 0
        selectedIdx = array.new_int(0)
        int availableEvents = bigMoveEvents.size()
        int maxSelections = int(math.min(bigMoveShowTopN, availableEvents))
        if maxSelections > 0
            for slot = 0 to maxSelections - 1
                int bestIdx = na
                float bestPriority = -100000.0
                for i = 0 to availableEvents - 1
                    bool alreadySelected = false
                    if selectedIdx.size() > 0
                        for j = 0 to selectedIdx.size() - 1
                            if selectedIdx.get(j) == i
                                alreadySelected := true
                                break
                    if not alreadySelected
                        evt = bigMoveEvents.get(i)
                        if bar_index - evt.eventBar <= bigMoveLookback and evt.score >= bigMoveMinScore
                            float priority = f_bigMoveEventPriority(evt)
                            if priority > bestPriority
                                bestPriority := priority
                                bestIdx := i
                if not na(bestIdx)
                    selectedIdx.push(bestIdx)

        if selectedIdx.size() > 0
            for i = 0 to selectedIdx.size() - 1
                evt = bigMoveEvents.get(selectedIdx.get(i))
                float ageRatio = bigMoveLookback > 0 ? float(bar_index - evt.eventBar) / bigMoveLookback : 0.0
                int fade = bigMoveFadeOldEvents ? int(math.min(55.0, math.round(ageRatio * 55.0))) : 0
                color baseClr = f_bigMoveEventColor(evt)
                color fillClr = color.new(baseClr, math.min(95, (evt.eventType == "EXPANSION" ? 78 : 84) + fade))
                color borderClr = color.new(baseClr, math.min(90, 26 + fade))
                color ceClr = color.new(baseClr, math.min(88, 38 + fade))
                color textClr = color.new(baseClr, math.min(75, fade * 2))
                string ctxLabel = evt.killzoneName != "Inter-Session" ? evt.killzoneName : evt.sessionName
                string labelText = evt.eventType + " " + str.tostring(math.round(evt.score)) + " | " + ctxLabel + " | " + evt.direction
                if showBigMoveZones
                    bigMoveBoxes.push(box.new(evt.startBar, evt.highPrice, evt.endBar, evt.lowPrice, bgcolor=fillClr, border_color=borderClr))
                    bigMoveCeLines.push(line.new(evt.startBar, evt.cePrice, evt.endBar, evt.cePrice, color=ceClr, style=line.style_dashed))
                if showBigMoveLabels
                    bigMoveLabels.push(label.new(evt.endBar, evt.cePrice, labelText, color=#00000000, textcolor=textClr, style=label.style_label_left, size=size.tiny))

    if enableBigMoveMemory and showFutureTimingHints
        color hintClr = f_bigMoveHintColor(bigMoveSnapshot.currentState)
        float hintY = high + math.max(atrVal, syminfo.mintick * 20) * 1.6
        string hintText = "BIG MOVE MEMORY: " + bigMoveSnapshot.currentState + " | " + bigMoveSnapshot.currentBucketName + " | " + str.tostring(math.round(bigMoveSnapshot.currentBucketHitRate)) + "%"
        if bigMoveNearLiquidity and str.length(bigMoveNearLiquidityLabel) > 0
            hintText += " | " + bigMoveNearLiquidityLabel
        label.set_xy(bigMoveHintLabel, bar_index + 2, hintY)
        label.set_text(bigMoveHintLabel, hintText)
        label.set_textcolor(bigMoveHintLabel, hintClr)
        label.set_style(bigMoveHintLabel, label.style_label_left)
    else
        label.set_xy(bigMoveHintLabel, na, na)
        label.set_text(bigMoveHintLabel, "")

var table bigMoveTable = table.new(f_bigMoveTablePos(), 2, 10, bgcolor=#1e222d, border_color=#373a46, border_width=1)
if showBigMoveTimingTable and enableBigMoveMemory and barstate.islast
    color stateClr = f_bigMoveHintColor(bigMoveSnapshot.currentState)
    table.cell(bigMoveTable, 0, 0, "Big Move Memory", bgcolor=chart.fg_color, text_color=chart.bg_color, text_size=size.small)
    table.cell(bigMoveTable, 1, 0, "Timing", bgcolor=chart.fg_color, text_color=chart.bg_color, text_size=size.small)
    table.cell(bigMoveTable, 0, 1, "Top Window", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 1, 1, bigMoveSnapshot.topWindow, text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 0, 2, "Top Killzone", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 1, 2, bigMoveSnapshot.topKillzone, text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 0, 3, "Best Avg KZ", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 1, 3, bigMoveSnapshot.bestAvgKillzone, text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 0, 4, "Avg Event Score", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 1, 4, str.tostring(bigMoveSnapshot.avgScore, "#.0"), text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 0, 5, "Dominant Type", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 1, 5, bigMoveSnapshot.dominantType, text_color=bigMoveSnapshot.dominantType == "Spike" ? color.orange : bigMoveSnapshot.dominantType == "Expansion" ? COLOR_BULL : COLOR_NEUT, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 0, 6, "Bull/Bear Bias", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 1, 6, bigMoveSnapshot.bias, text_color=bigMoveSnapshot.bias == "Bullish" ? COLOR_BULL : bigMoveSnapshot.bias == "Bearish" ? COLOR_BEAR : COLOR_NEUT, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 0, 7, "Current State", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 1, 7, bigMoveSnapshot.currentState, text_color=color.white, bgcolor=stateClr, text_size=size.small)
    table.cell(bigMoveTable, 0, 8, "Bucket Hit Rate", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 1, 8, str.tostring(math.round(bigMoveSnapshot.currentBucketHitRate)) + "% @ " + bigMoveSnapshot.currentBucketName, text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 0, 9, "Events / Avg RV", text_color=color.white, bgcolor=#1e222d, text_size=size.small)
    table.cell(bigMoveTable, 1, 9, str.tostring(bigMoveSnapshot.qualifyingEvents) + " | " + str.tostring(bigMoveSnapshot.avgRelVolume, "#.##") + "x", text_color=color.white, bgcolor=#1e222d, text_size=size.small)

// --- Dashboard ---
if showDash and barstate.islast
    pos_tbl = (dashPos == "Top Right") ? position.top_right : (dashPos == "Top Left") ? position.top_left : position.bottom_right
    var table tb = table.new(pos_tbl, 2, 10, bgcolor=#1e222d, border_color=#373a46, border_width=1)
    color dashCellBg = chart.fg_color
    color dashCellText = chart.bg_color
    table.cell(tb, 0, 0, "HTF / SMC BIAS", bgcolor=dashCellBg, text_color=dashCellText, text_size=size.small)
    table.cell(tb, 1, 0, "TRADER READ", bgcolor=dashCellBg, text_color=dashCellText, text_size=size.small)

    bT1 = close > dO ? "ABOVE" : "BELOW"
    table.cell(tb, 0, 1, "Daily Open", text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
    table.cell(tb, 1, 1, bT1, text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)

    bT2 = close > wO ? "ABOVE" : "BELOW"
    table.cell(tb, 0, 2, "Weekly Open", text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
    table.cell(tb, 1, 2, bT2, text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)

    bT3 = na(nyMidnight) ? "N/A" : close > nyMidnight ? "ABOVE" : "BELOW"
    table.cell(tb, 0, 3, "NY Midnight", text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
    table.cell(tb, 1, 3, bT3, text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)

    table.cell(tb, 0, 4, "HTF 1 (" + htf1Tf + ")", text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
    table.cell(tb, 1, 4, htf1Display, text_color=dashCellText, bgcolor=dashCellBg, text_size=size.tiny)

    table.cell(tb, 0, 5, "HTF 2 (" + htf2Tf + ")", text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
    table.cell(tb, 1, 5, htf2Display, text_color=dashCellText, bgcolor=dashCellBg, text_size=size.tiny)

    bool structureBull = structureTrend == 1
    bool structureBear = structureTrend == -1
    table.cell(tb, 0, 6, "LTF Structure", text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
    table.cell(tb, 1, 6, structureStatus, text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)

    overAll = close > dO and structureBull and htfLongStrong ? "Stack: daily + LTF + HTF bullish\nBias: Bullish aligned\nFilter: longs allowed; fade weak shorts" : close < dO and structureBear and htfShortStrong ? "Stack: daily + LTF + HTF bearish\nBias: Bearish aligned\nFilter: shorts allowed; fade weak longs" : htfCompositeDashboard
    table.cell(tb, 0, 7, "Overall Context", text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
    table.cell(tb, 1, 7, overAll, text_color=dashCellText, bgcolor=dashCellBg, text_size=size.tiny)

    table.cell(tb, 0, 8, "Total Setups", text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
    table.cell(tb, 1, 8, str.tostring(tSetups), text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)

    tot = w10 + l10
    winrate = tot == 0 ? "0%" : str.tostring(math.round(w10 / tot * 100)) + "%"
    table.cell(tb, 0, 9, "Winrate", text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
    table.cell(tb, 1, 9, winrate, text_color=dashCellText, bgcolor=dashCellBg, text_size=size.small)
