# Core backend settings
DB_PASS=change-me
JWT_SECRET=change-me
FRONTEND_URL=https://tradejaudit.com

# S3 storage settings
STORAGE_S3_ENABLED=true
STORAGE_S3_BUCKET=tradejaudit
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ACCESS_KEY_FILE=
STORAGE_S3_SECRET_KEY_FILE=

# Alternative AWS-compatible credentials (optional)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID_FILE=
AWS_SECRET_ACCESS_KEY_FILE=

# S3-compatible endpoint tuning (MinIO/Spaces)
STORAGE_S3_PATH_STYLE=false
STORAGE_S3_PATH_STYLE_ACCESS=false
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_USE_IAM_ROLE=false
STORAGE_S3_PROFILE_NAME=

# Optional public and presigned URL behavior
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_S3_PRESIGN_ENABLED=false
STORAGE_S3_PRESIGN_EXPIRATION_MINUTES=60
